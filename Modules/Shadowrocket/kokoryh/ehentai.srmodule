[URL Rewrite]
^https:\/\/exhentai\.org https://e-hentai.org 307

[Script]
ehentai = type=http-response, pattern=^https:\/\/e-hentai\.org\/g\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/ehentai/kokoryh_webpage.ehentai.js, requires-body=true, max-size=-1

[MITM]
hostname = %APPEND% e-hentai.org, exhentai.org

