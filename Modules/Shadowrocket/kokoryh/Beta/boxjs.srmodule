#!name=BoxJs
#!desc=https://boxjs.com
#!author=chavyleung[https://github.com/chavyleung/scripts]
#!icon=icon not found
#!category=kokoryh

[General]
force-http-engine-hosts = %APPEND% boxjs.com

[Script]
boxjs = type=http-request, pattern=https?:\/\/boxjs\.com, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/boxjs/chavyleung_chavy.boxjs.js, requires-body=true, timeout=120

[MITM]
hostname = %APPEND% boxjs.com

