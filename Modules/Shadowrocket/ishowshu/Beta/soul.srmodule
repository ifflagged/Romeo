#!name=Soul
#!desc=移除广告，需要卸载重装生效
#!author=树先生，怎么肥事, 奶思
#!icon=icon not found
#!category=ishowshu
#!date=2026-09-19

[Rule]
IP-CIDR,13.127.149.196/32,DIRECT,no-resolve
IP-CIDR,52.194.158.59/32,DIRECT,no-resolve
IP-CIDR,47.56.131.76/32,DIRECT,no-resolve
IP-CIDR,47.75.72.47/32,DIRECT,no-resolve
IP-CIDR,3.0.163.78/32,DIRECT,no-resolve
DOMAIN,ssp.soulapp.cn,REJECT
DOMAIN,soul-ad.soulapp.cn,REJECT
DOMAIN,ad-r.soulapp.cn,REJECT
DOMAIN,ssp.1rtb.com,REJECT
DOMAIN,impdsp.meituan.com,REJECT
DOMAIN,ssp.maplehaze.cn,REJECT

[URL Rewrite]
^https:\/\/ssp\.soulapp\.cn\/api - reject-dict
^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain - reject-dict
^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card - reject-dict
^https:\/\/api-account\.soulapp\.cn\/teenager\/config - reject-dict
^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module - reject-dict
^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content - reject-dict
^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter - reject
^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList - reject
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon - reject
^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger - reject
^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord - reject
^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend - reject
^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url - reject
^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu - reject
^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck - reject-dict
^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback - reject-dict
^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms - reject-dict
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings - reject-dict
^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList - reject-dict
^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc - reject-dict
^https:\/\/post\.soulapp\.cn\/v1\/post\/homepage\/ai\/assistant\/guide - reject-dict
^https:\/\/api-chat\.soulapp\.cn\/chatList\/limitAvatar\/entrance - reject-dict
^https:\/\/api-chat\.soulapp\.cn\/chatList\/top\/recommendList - reject-dict
^https:\/\/activity\.soulapp\.cn\/commercial\/room\/resources - reject-dict
^https:\/\/chat-live\.soulapp\.cn\/official\/scene\/module - reject-dict
^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/match\/game\/configList - reject-dict
^https:\/\/chat-live\.soulapp\.cn\/square\/getSkinConfig - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/chat-live\.soulapp\.cn\/live\/queryFollowRoomList '.data.recUserFeedList = []'
http-response-jq ^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList '.data.userDTOList = []'
http-response-jq ^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config '.data.showRedMind = false | .data.showLuckyBag = false | .data.coreCards |= map(select(.type != 27))'
http-response-jq ^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList '.data.positionContentRespList = []'
http-response-jq ^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 '.data.selectedTagPool = {} | .data.headTabDTOList |= map(select(.tabCode != "STAR_TRAILS"))'
http-response-jq ^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo '.data.res |= map(.iconConfig = null)'

[Script]
soul_qx = type=http-response, pattern=^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/soul/ishowshu_soul_qx.js, requires-body=true, max-size=-1, timeout=60

soul_qx = type=http-response, pattern=^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/soul/ishowshu_soul_qx.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, activity.soulapp.cn, 47.110.187.87, 47.75.72.47, 47.96.7.91, 47.96.11.46, 47.96.20.45, 47.97.215.55, 47.98.54.106, 47.98.137.249, 47.99.42.29, 114.215.255.94, 116.62.28.7, 116.62.47.28, 118.31.7.235, 118.31.112.221, 120.27.235.201, 120.55.55.115, 120.55.62.124, 121.196.197.147, 121.196.203.183

