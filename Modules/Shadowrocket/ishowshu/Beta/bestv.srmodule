#!name=看东方
#!desc=移除广告
#!author=树先生, baby
#!icon=icon not found
#!category=ishowshu

[URL Rewrite]
^https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/free\/open\/advertisingV2 - reject-dict
^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/advertise\/popup\/scene$ - reject
^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/open\/advertisingV2 - reject

[Script]
bestv = type=http-response, pattern=^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/userCenter, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/ishowshu_bestv.js, requires-body=true, max-size=-1, timeout=60

video-parser = type=http-response, pattern=https:\/\/bp-api\.bestv\.(?:com\.cn|cn)\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/Yu9191_video-parser.js, requires-body=true, max-size=-1, timeout=60

video-parser = type=http-response, pattern=^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/Yu9191_video-parser.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% bp-api.bestv.com.cn, bp-api.bestv.cn, 360.com

