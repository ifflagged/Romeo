amap = type=http-response, pattern=^https:\/\/m5-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/amap-feature/ishowshu_amap.js, requires-body=true, max-size=-1, timeout=60

