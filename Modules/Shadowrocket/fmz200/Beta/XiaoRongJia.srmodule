[URL Rewrite]
^https?:\/\/myusmile\.online\/user\/version\/requestFirmwareUpdate\/ - reject
^https?:\/\/www\.myusmile\.online\/user\/userTagRecord\/popup - reject

[Map Local]
^https?:\/\/myusmile\.online\/user\/version\/requestAppUpdate data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/wemallh5\.usmile\.com\/api\/sp-portal\/store\/usmile\/activity\/dayCheck\?pop data-type=text data="{}" header="Content-Type:application/json"

[Script]
usmile = type=http-response, pattern=^https?:\/\/www\.myusmile\.online\/user\/plaqueTopic\/selectByType, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/XiaoRongJia/zirawell_usmile.js

[MITM]
hostname = %APPEND% myusmile.online, wemallh5.usmile.com, www.myusmile.online

