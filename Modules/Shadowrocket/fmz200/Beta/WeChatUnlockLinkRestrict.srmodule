[Script]
UnblockURLinWeChat-解除微信链接限制 = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/WeChatUnlockLinkRestrict/zZPiglet_UnblockURLinWeChat.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% weixin110.qq.com, security.wechat.com

