#!name=自动[加入/监控]TestFlight
#!desc=1、自动加入TF使用前先获取账号令牌和填写应用ID[自己手动添加主机名testflight.apple.com]，一旦有新的名额即刻加入；2、监控TF位置不需要令牌也无需MITM
#!author=奶思[https://github.com/fmz200], DecoAri[https://github.com/DecoAri], xream[https://github.com/xream]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://apps.apple.com/app/id899247664
#!category=定时任务
#!loon_version=3.2.4(787)
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/Auto_Join_TF.plugin
#!tg-channel=https://t.me/inaisi
#!date=2025-09-21 01:17:08
#!arguments=CaptureAccountToken:#,RunTask:#,RunMonitor:#,TaskCron:"0 0/3 * * * ?",TaskMonitor:"0 * * * * ?"
#!arguments-desc=CaptureAccountToken: 捕获账号令牌\n此开关控制插件是否捕获账户令牌\n\nRunTask: 运行自动加入TF\n此开关控制是否启动定时任务\n\nRunMonitor: 运行监控TF位置\n此开关控制是否启动定时任务\n\nTaskCron: 加入TF定时参数\n这里需要输入符合CRON表达式的参数\n\nTaskMonitor: 监控TF定时参数\n这里需要输入符合CRON表达式的参数

[Rule]
DOMAIN,testflight.apple.com,PROXY

[Script]
{{{CaptureAccountToken}}}获取账号令牌 = type=http-request, pattern=^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Auto_Join_TF/fmz200_AutoJoinTFKeys.js

# http-request ^https?:\/\/testflight\.apple\.com\/join\/(.*) script-path = https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Auto_Join_TF/fmz200_AutoJoinTFKeys.js, tag = 应用ID捕获(可能抓不到), enable = {CaptureAppID}
{{{RunTask}}}自动加入TF = type=cron, cronexp="{{{TaskCron}}}", script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Auto_Join_TF/fmz200_AutoJoinTF.js, timeout=600

{{{RunMonitor}}}监控TF位置 = type=cron, cronexp="{{{TaskMonitor}}}", script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Auto_Join_TF/fmz200_AutoMonitorTF.js, timeout=30

