[Rule]
# 请求本地
DOMAIN-SUFFIX,local,DIRECT

[Script]
# BoxJS
Gist备份 = type=cron, cronexp=0 0/6 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/QuanX/dompling_backup.js, timeout=120, wake-system=1

Gist恢复 = type=cron, cronexp=5 10 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/QuanX/dompling_restore.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% -www.google.com

