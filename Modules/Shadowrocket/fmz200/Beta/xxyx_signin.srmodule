[Script]
get_cookie = type=http-response, pattern=^https:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/my, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/xxyx_signin/fmz200_get_cookie.js, requires-body=true, max-size=-1, timeout=60

晓晓优选每日任务 = type=cron, cronexp=* 16 7 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/xxyx_signin/fmz200_xxyx_signin.js, timeout=120, wake-system=1

