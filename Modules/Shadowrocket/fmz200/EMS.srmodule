[URL Rewrite]
#############################################
^https?:\/\/ec\.ems\.com\.cn\/mailAd$ - reject
^https?:\/\/ec\.ems\.com\.cn\/ecr-exp-web\/advert - reject
^https?:\/\/ump\.ems\.com\.cn\/mailAd$ - reject

[Script]
wechatApplet = type=http-response, pattern=^https?:\/\/ec\.ems\.com\.cn\/ecr-qry-web\/redis\/pageInfoByChannel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js, requires-body=true, max-size=-1, timeout=60

wechatApplet = type=http-response, pattern=^https?:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% ec.ems.com.cn, ump.ems.com.cn

