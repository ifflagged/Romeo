[Script]
get_cookie = type=http-request, pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/PingMeSignin/fmz200_get_cookie.js, timeout=60

PingMe签到 = type=cron, cronexp="30 8,20 * * *", script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/PingMeSignin/fmz200_PingMeSignin.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% api.pingmeapp.net

