[Script]
iOS15美标空气质量 = type=http-response, pattern=https://weather-data.apple.com/v2/weather/[\w-]+/-?[0-9]+\.[0-9]+/-?[0-9]+\.[0-9]+\?, script-path=path/to/iOS15_Weather_AQI_US.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% weather-data.apple.com

