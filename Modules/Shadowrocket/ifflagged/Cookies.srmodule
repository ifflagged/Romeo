[Script]
JD Cookies = type=http-request,pattern=https:\/\/api\.m\.jd\.com\/client\.action.*functionId=signBean,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Cookies/NobyDa_JD_DailyBonus.js
iQIYI Cookie = type=http-request,pattern=^https?:\/\/iface(\d)?\.iqiyi\.com\/,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Cookies/NobyDa_iQIYI.js
Weibo Cookies = type=http-request,pattern=^https:\/\/m\.weibo\.cn\/feed\/,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Cookies/zZPiglet_Weibo.js
Atour Cookies = type=http-request,pattern=^https:\/\/miniapp\.yaduo\.com\/atourlife\/signIn\/signIn.+,requires-body=0,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Cookies/Sliverkiss_adjd.js
