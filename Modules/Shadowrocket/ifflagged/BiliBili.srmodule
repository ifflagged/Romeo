#!name= 🧰 BiliBili
#!desc= 神秘代码
#!category=Jacob

[Script]
精简首页顶部标签 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/BiliBili/ifflagged_BiliBili.js, requires-body=true

BiliBili Mystery Code = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/account\/(?:mine|myinfo), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/BiliBili/ifflagged_BiliBili.js, requires-body=true
