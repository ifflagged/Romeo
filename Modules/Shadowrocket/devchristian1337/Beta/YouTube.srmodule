#!name=YouTube
#!desc=Removes ads from the YouTube app, enables background playback and translates existing subtitle tracks (target language zh-CN or en-US, videos without subtitles cannot be translated). Logging captures media response headers only by default, full sampling may add delay. Requires MITM with a trusted certificate.
#!author=devchristian1337
#!icon=icon not found
#!category=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!category=YouTube, AdBlock
#!loon_version=3.5.1(983)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-10-07
#!arguments=background_playback:false,playback_region:"original",translation_enabled:#,translation_target:"zh-CN",hide_home_shorts:false,blocked_channels:"",blocked_channels_url:"",log_enabled:#,quality_research:false,media_capture_mode:"headers",log_level:"info",capture_budget:"32"
#!arguments-desc=background_playback: Background playback\nKeeps audio playing for regular videos after switching app or locking the screen. Live streams and restricted content are still decided by YouTube\n\nplayback_region: Playback request region\noriginal keeps the current region. Only changes the client gl parameter, the exit IP is unchanged. Ad-blocking effect still to be verified\n可选值: original, CN, HK, TW, US, JP, KR, SG, GB, DE, RU\n\ntranslation_enabled: Subtitle translation\nTranslates existing subtitles into the selected target language. When off, the original subtitle request is kept\n可选值: 留空启用, # 禁用\n\ntranslation_target: Subtitle target language\nOnly converts existing subtitle tracks (Simplified Chinese zh-CN or US English en-US). Videos without subtitles cannot be translated. Audio track, title and description are unchanged\n可选值: zh-CN, en-US\n\nhide_home_shorts: Hide Home Shorts\nRemoves the Shorts shelf from the Home feed. The bottom Shorts tab and other pages are kept\n\nblocked_channels: Blocked channels\nChannel IDs, @handles or full channel names separated by spaces. Prefer channel IDs, use handle or ID for names containing spaces. Leave empty to disable. Only hides videos whose owner can be identified\n\nblocked_channels_url: Remote blocked channels URL\nPublic HTTPS plain-text direct link (e.g. GitHub Raw). Local cache refreshes hourly, or run the update script. Merged with the manual list. Leave empty to disable\n\nlog_enabled: Logging tool\nStarts automatically on the first matched request and notifies the log entry point. When turned off, the next API hit clears the log and stops sampling, download it first if you need it. Full sampling may add delay\n可选值: 留空启用, # 禁用\n\nquality_research: Quality research sampling\nOnly active when the logging tool is on. Records recognizable quality and format parameters and reads small media POST requests for comparison. Does not switch quality automatically\n\nmedia_capture_mode: Media sampling mode\nOnly active when the logging tool is on, disabled automatically when logging is off. headers records response headers only. full reads the whole response for development and may add delay\n可选值: headers, full\n\nlog_level: Log level\ninfo keeps the full redacted trace. error keeps errors only. debug keeps debug level. warn keeps warnings and errors\n可选值: info, debug, warn, error\n\ncapture_budget: Log capacity (MB)\nRecording stops when the limit is reached, existing samples are kept. Clear after exporting\n可选值: 32, 16, 64

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Header Rewrite]
http-response ^https://(?:[\w-]+\.)*googlevideo\.com(?::443)?/ header-replace 'Alt-Svc' 'clear'

[Script]
YouTube scheduled blocked channels update = type=cron, cronexp=0 * * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument=blocked_channels_url="{{{blocked_channels_url}}}"

{{{translation_enabled}}}YouTube subtitle target language = type=http-request, pattern=^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument=translation_enabled="{{{translation_enabled}}}"&translation_target="{{{translation_target}}}"

{{{log_enabled}}}YouTube logging and export = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&background_playback="{{{background_playback}}}"&media_capture_mode="{{{media_capture_mode}}}"&quality_research="{{{quality_research}}}"

YouTube config request handling = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&playback_region="{{{playback_region}}}"

{{{log_enabled}}}YouTube media response logging = type=http-response, pattern=^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"

YouTube Onesie config cache = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"

YouTube playback request and ad config handling = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&playback_region="{{{playback_region}}}"

YouTube feed ads and Home Shorts handling = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&hide_home_shorts="{{{hide_home_shorts}}}"&blocked_channels="{{{blocked_channels}}}"&blocked_channels_url="{{{blocked_channels_url}}}"

YouTube playback response and background playback = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&background_playback="{{{background_playback}}}"&quality_research="{{{quality_research}}}"

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com

