#!name=SoundCloud
#!desc=Unlocks SoundCloud Go+ features. Hiding the Upgrade tab and the "listen without ads" badge is optional.
#!author=devchristian1337
#!icon=icon not found
#!category=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!tag=SoundCloud, Premium
#!system=iOS,iPadOS,macOS
#!loon_version=3.3.4(898)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-11-01
#!arguments=hide_upsells:true

[Script]
SoundCloud Go+ = type=http-response, pattern=https://api-mobile.soundcloud.com/configuration/ios, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud.js, requires-body=true, timeout=10, argument=[{{{hide_upsells}}}]

SoundCloud Upsells = type=http-response, pattern=https://graph.soundcloud.com/graphql, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud-upsells.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api-mobile.soundcloud.com, graph.soundcloud.com

