#!arguments=HomeBasicClean:true,HideTopFamily:false,HideTopAge:false,HideTopPhone:false,HideTopNearby:false,HideTopAI:false,HideTopEnterprise:false,MineClean:true,HideMyCheckIn:false,HideMyMarketing:false,HideMyServices:false,HideMyFamilyCube:false,HideMyDevicesCube:false,HideMyMiniProgram:false,HideMyDigitalHuman:false,HideMySelections:false,HideMyGroup:false,HideMyRingtone:false,HideMyCloudDrive:false,HideMyToolbox:false,HideMyLifeServices:false

[URL Rewrite]
^https?:\/\/(client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(explorePage\/getAdverList|init\/startInit|emotionMarket) - reject-200

[Script]
[中国移动]页面净化 = type=http-response, pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ChinaMobile/loon.103516.xyz_ChinaMobile.js, requires-body=true, timeout=10, argument="[{{{HomeBasicClean}}},{{{HideTopFamily}}},{{{HideTopAge}}},{{{HideTopPhone}}},{{{HideTopNearby}}},{{{HideTopAI}}},{{{HideTopEnterprise}}},{{{MineClean}}},{{{HideMyCheckIn}}},{{{HideMyMarketing}}},{{{HideMyServices}}},{{{HideMyFamilyCube}}},{{{HideMyDevicesCube}}},{{{HideMyMiniProgram}}},{{{HideMyDigitalHuman}}},{{{HideMySelections}}},{{{HideMyGroup}}},{{{HideMyRingtone}}},{{{HideMyCloudDrive}}},{{{HideMyToolbox}}},{{{HideMyLifeServices}}}]"

[中国移动]消息与卡券净化 = type=http-response, pattern=^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ChinaMobile/loon.103516.xyz_ChinaMobile.js, requires-body=true, timeout=10

[中国移动]充值横幅净化 = type=http-response, pattern=^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ChinaMobile/loon.103516.xyz_ChinaMobile.js, requires-body=true, timeout=10

[中国移动]充值内容净化 = type=http-response, pattern=^https:\/\/touch\.10086\.cn\/i\/v1\/(?:cust\/(?:aiMainQry|iopBatchQry)|pay\/popWindowQry)\/[^?]+(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ChinaMobile/loon.103516.xyz_ChinaMobile.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn

