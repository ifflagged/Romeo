[Script]
[UAPI]热榜聚合 = type=cron, cronexp={{{uapi_cron}}}, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/UAPI-HotBoard/loon.103516.xyz_uapi-hotboard.js, timeout=60, argument="[{{{uapi_type}}},{{{uapi_top}}},{{{uapi_api}}}]"

