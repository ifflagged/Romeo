#!name=YouTube (Music)
#!desc=过滤YouTube (Music)广告，增加画中画、字幕翻译、歌词翻译功能，支持后台播放。需要启用QUIC回退保护。不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile], RuCu6[https://github.com/RuCu6]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://apps.apple.com/app/id544007664
#!tag=去广告, 功能增强
#!system_version=15
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-07-12 09:00
#!arguments=blockUpload:true,blockShorts:true,blockImmersive:true,captionLang:"zh-Hans",lyricLang:"zh-Hans",debug:false

[URL Rewrite]
# youtube 短链移除追踪参数
(^https:\/\/youtu\.be\/[\w-]+)(?:\?si=\w+) $1 302

[Script]
[YouTube]request_init = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.request.js, requires-body=true, binary-body-mode=true

[YouTube]request_log_event = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.request.js, requires-body=true, binary-body-mode=true

[YouTube]response_init = type=http-response, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.ump.js, requires-body=true, binary-body-mode=true

[YouTube]response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, argument="[{{{blockImmersive}}},{{{blockShorts}}},{{{blockUpload}}},{{{debug}}},{{{captionLang}}},{{{lyricLang}}}]"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

