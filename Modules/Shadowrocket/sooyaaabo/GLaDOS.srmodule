#!name=GLaDOS
#!desc=GLaDOS每日签到，访问网页登录账号进入账户页面自动获取保存Cookie。
#!author=curtinp118[https://github.com/curtinp118]
#!icon=icon not found
#!category=sooyaaabo
#!openUrl=https://glados.cloud/
#!tag=定时任务
#!loon_version=3.5.1(998)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-09-23 00:00
#!arguments=Cookie-GLaDOS:true,Task-GLaDOS:true,Cron-GLaDOS:"0 0 9 * * *"

[Rule]
DOMAIN-SUFFIX,glados.cloud,PROXY
DOMAIN-SUFFIX,glados.network,PROXY
DOMAIN-SUFFIX,glados.one,PROXY
DOMAIN-SUFFIX,glados.space,PROXY
DOMAIN-SUFFIX,glados.vip,PROXY

[MITM]
hostname = %APPEND% glados.network, glados.vip, glados.one, glados.space, glados.cloud

