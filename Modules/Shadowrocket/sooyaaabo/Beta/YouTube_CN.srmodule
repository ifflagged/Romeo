#!name=YouTube
#!desc=移除YouTube应用广告、启用后台播放，并翻译现有字幕轨道（目标语言为zh-CN或en-US；没有字幕的视频无法翻译）。默认仅记录媒体响应头；完整采样可能增加延迟。\n该插件基于devchristian1337的YouTube插件汉化。
#!author=devchristian1337[https://github.com/devchristian1337]
#!icon=icon not found
#!category=sooyaaabo
#!openUrl=https://apps.apple.com/app/id544007664
#!category=去广告, 功能增强
#!system_version=15
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-10 16:00
#!arguments=background_playback:true,playback_region:"original",translation_enabled:"",translation_target:"zh-CN",hide_home_shorts:true,blocked_channels:"",blocked_channels_url:"",log_enabled:#,quality_research:false,media_capture_mode:"headers",log_level:"info",capture_budget:"32"
#!arguments-desc=background_playback: 后台播放\n切换应用或锁定屏幕后，保持普通视频继续播放音频。直播和受限内容仍由YouTube自身决定是否允许后台播放。\n可选值: true, false\n\nplayback_region: 播放请求地区\noriginal表示保持当前地区。仅修改客户端gl参数，不改变出口IP。是否有助于拦截广告仍需验证。\n可选值: original, CN, HK, TW, US, JP, KR, SG, GB, DE, RU\n\ntranslation_enabled: 字幕翻译\n将现有字幕翻译为所选目标语言。关闭时保留原始字幕请求。\n可选值: 留空启用, # 禁用\n\ntranslation_target: 字幕目标语言\n仅转换现有字幕轨道，支持简体中文zh-CN或美式英语en-US。没有字幕的视频无法翻译。不会修改音轨、标题和视频简介。\n可选值: zh-CN, en-US\n\nhide_home_shorts: 隐藏首页 Shorts\n移除首页信息流中的Shorts推荐栏。底部Shorts标签和其他页面不受影响。\n可选值: true, false\n\nblocked_channels: 屏蔽频道\n频道ID、@用户名或完整频道名称，多个条目用空格分隔。建议优先使用频道ID；频道名称包含空格时请使用用户名或ID。留空则禁用。仅隐藏能够识别出所属频道的视频。\n\nblocked_channels_url: 远程屏蔽频道列表\n公开的HTTPS纯文本直链（例如GitHub Raw）。本地缓存每小时刷新一次，也可以手动运行更新脚本。远程列表与手动列表合并。留空则禁用。\n\nlog_enabled: 日志工具\n首次匹配到请求时自动启动，并通知日志入口。关闭后，下一次API请求会清除日志并停止采样；如需保留记录，请先下载。完整采样可能增加延迟。\n可选值: 留空启用, # 禁用\n\nquality_research: 画质研究采样\n仅在日志工具开启时生效。记录可识别的画质与格式参数，并读取较小的媒体POST请求以供比较。不会自动切换画质。\n可选值: false, true\n\nmedia_capture_mode: 媒体采样模式\n仅在日志工具开启时生效；关闭日志时会自动停用。headers仅记录响应头；full读取完整响应内容用于开发调试，可能增加延迟。\n可选值: headers, full\n\nlog_level: 日志级别\ninfo保留完整的脱敏跟踪记录；debug保留调试信息；warn保留警告和错误；error仅保留错误。\n可选值: info, debug, warn, error\n\ncapture_budget: 日志容量（MB）\n达到容量上限后停止录制，并保留已有采样记录。导出后可清理。\n可选值: 32, 16, 64

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Header Rewrite]
http-response (?i)^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\/ header-del "Alt-Svc"
http-response (?i)^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\/ header-add "Alt-Svc" "clear"

[Script]
YouTube 定时更新屏蔽频道列表 = type=cron, cronexp=0 * * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js, timeout=10, argument=blocked_channels_url="{{{blocked_channels_url}}}"

{{{translation_enabled}}}YouTube 字幕目标语言 = type=http-request, pattern=(?i)^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js, timeout=10, argument=translation_enabled="{{{translation_enabled}}}"&translation_target="{{{translation_target}}}"

{{{log_enabled}}}YouTube 日志与导出 = type=http-request, pattern=(?i)^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&background_playback="{{{background_playback}}}"&media_capture_mode="{{{media_capture_mode}}}"&quality_research="{{{quality_research}}}"

{{{log_enabled}}}YouTube 媒体响应日志 = type=http-response, pattern=(?i)^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"

YouTube Onesie 配置缓存 = type=http-response, pattern=(?i)^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"

YouTube 播放请求与广告配置处理 = type=http-request, pattern=(?i)^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js, requires-body=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&playback_region="{{{playback_region}}}"

YouTube 信息流广告与首页 Shorts 处理 = type=http-response, pattern=(?i)^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&hide_home_shorts="{{{hide_home_shorts}}}"&blocked_channels="{{{blocked_channels}}}"&blocked_channels_url="{{{blocked_channels_url}}}"

YouTube 播放响应与后台播放 = type=http-response, pattern=(?i)^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument=log_enabled="{{{log_enabled}}}"&log_level="{{{log_level}}}"&capture_budget="{{{capture_budget}}}"&background_playback="{{{background_playback}}}"&quality_research="{{{quality_research}}}"

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com

