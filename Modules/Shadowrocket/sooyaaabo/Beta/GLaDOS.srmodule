#!name=GLaDOS
#!desc=GLaDOS每日签到，访问网页登录账号进入账户页面自动获取保存Cookie。
#!author=curtinp118[https://github.com/curtinp118]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://glados.cloud/
#!category=定时任务
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-06-26 12:00
#!arguments=Cookie-GLaDOS:,Task-GLaDOS:,Cron-GLaDOS:"0 0 9 * * *"
#!arguments-desc=Cookie-GLaDOS: [GLaDOS]每日签到Cookie\n获取[GLaDOS]每日签到Cookie\n\nTask-GLaDOS: [GLaDOS]每日签到Task\n定时运行[GLaDOS]每日签到Task\n\nCron-GLaDOS: [GLaDOS]定时参数Cron\n输入Cron表达式来定时运行[GLaDOS]每日签到Task

[Rule]
DOMAIN-SUFFIX,glados.cloud,PROXY
DOMAIN-SUFFIX,glados.network,PROXY
DOMAIN-SUFFIX,glados.one,PROXY
DOMAIN-SUFFIX,glados.space,PROXY
DOMAIN-SUFFIX,glados.vip,PROXY

[Script]
{{{Cookie-GLaDOS}}}[GLaDOS]每日签到Cookie = type=http-request, pattern=^https:\/\/glados\.(?:network|cloud|vip|one|space|io)\/console\/account$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GLaDOS/loon.103516.xyz_glados_checkin.js, timeout=10

{{{Task-GLaDOS}}}[GLaDOS]每日签到Task = type=cron, cronexp="{{{Cron-GLaDOS}}}", script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GLaDOS/loon.103516.xyz_glados_checkin.js, timeout=60

[MITM]
hostname = %APPEND% glados.network, glados.vip, glados.one, glados.space, glados.cloud

