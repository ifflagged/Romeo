#!name=GitHub
#!desc=解决GitHub 429请求频繁问题
#!author=Yuheng0101[https://github.com/Yuheng0101], sooyaaabo[https://github.com/sooyaaabo]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://github.com/
#!category=功能增强
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-07-09 18:00

[Header Rewrite]
# 解决GitHub速率限制返回429问题
http-request ^https:\/\/.*\.githubusercontent\.com\/ header-replace 'Accept-Language' 'en-us'
http-request ^https:\/\/github\.com\/ header-replace 'Accept-Language' 'en-us'

[Script]
[GitHub]将Raw请求自动重定向到CDN = type=http-request, pattern=^https?:\/\/raw\.githubusercontent\.com/.+, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GitHub/loon.103516.xyz_GitRawAutoCDN.js, timeout=5

[MITM]
hostname = %APPEND% github.com, *.githubusercontent.com

