# 打车权益
(?i)^https:\/\/web\.xinyifm\.cn\/oss\/xc-app-assets\/configs\/common\/index_activity\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 大牌活动
(?i)^https:\/\/web2\.realtech-inc\.com\/oss\/xc-app-assets\/configs\/common\/links\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 开屏广告
