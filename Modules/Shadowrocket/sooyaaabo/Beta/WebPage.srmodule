[Rule]
DOMAIN-SUFFIX,creative.myavlive.com,REJECT
DOMAIN-SUFFIX,trackwilltrk.com,REJECT
DOMAIN-SUFFIX,tsyndicate.com,REJECT
DOMAIN-SUFFIX,jads.co,REJECT
DOMAIN-SUFFIX,juicyads.com,REJECT
DOMAIN-SUFFIX,mnaspm.com,REJECT

[URL Rewrite]
^https:\/\/exhentai\.org https://e-hentai.org 307
^https?:\/\/(www.)?(g|google)\.cn https://www.google.com 307
^https?:\/\/translate\.google\.cn https://translate.google.com 307
^https:\/\/(?:cn|www)\.pornhub\.com\/_xa\/ads(_batch)?\? - reject
^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js - reject

[Script]
[WebPage]Hanime = type=http-response, pattern=^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load)), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/kokoryh_webpage.hanime.js, requires-body=true

[WebPage]E-Hentai = type=http-response, pattern=^https:\/\/e-hentai\.org\/g\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/kokoryh_webpage.ehentai.js, requires-body=true

[WebPage]百度防跳转 = type=http-request, pattern=^https:\/\/boxer\.baidu\.com\/scheme\?scheme, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduNoRedirect.js

[WebPage]百度首页 = type=http-response, pattern=^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduIndex.js, requires-body=true

[WebPage]百度知道 = type=http-response, pattern=^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduZhidao.js, requires-body=true

[WebPage]JavDB = type=http-response, pattern=^https:\/\/javdb\.com\/(?!over18\?), script-path=https://loon.103516.xyz/Script/WebPage/JavDB.js, requires-body=true

[WebPage]草榴社区 = type=http-response, pattern=^https:\/\/2023\.redircdn\.com\/web\/mob_post\.js\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_MyBlockAds.js, requires-body=true

[WebPage]在线之家 = type=http-response, pattern=^https?:\/\/www\.zxzjhd\.com\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_adguard.js, requires-body=true

[WebPage]FreeOk = type=http-response, pattern=^https?:\/\/www\.freeok\.(vip|pro)(\/$|\/[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_adguard.js, requires-body=true

[WebPage]哔嘀影视 = type=http-response, pattern=^https?:\/\/.*bdys.*com\/($|([a-z]+)\/(play\/)?\d+.*$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_bdys.js, requires-body=true

[WebPage]PornHub = type=http-response, pattern=^https?:/\/(cn|www)\.pornhub\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_pornhub.ads.js, requires-body=true

[WebPage]Bimi = type=http-response, pattern=^https?:/\/.*bimi.*net\/($|(vodshow|bangumi|type)\/[0-9a-z-\/]+\/$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_bimi.js, requires-body=true

[WebPage]禁漫天堂 = type=http-response, pattern=^https?:\/\/.*18comic\.org\/($|(album|photo).*$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_18comic.js, requires-body=true

[WebPage]剧迷 = type=http-response, pattern=^https?:\/\/.*gimy.*\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_gimytv.js, requires-body=true

[WebPage]厂长电影 = type=http-response, pattern=^https?:\/\/.*czzy.*\/($|\?btwaf=\w+$|[0-9a-zA-Z=_/-]+\.html), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_qianoo.js, requires-body=true

[WebPage]茶杯狐 = type=http-response, pattern=^https?:/\/.*cupfox\.*\/($|[\u4E00-\u9FFFa-zA-Z0-9%=_/-]+$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_cupbox.js, requires-body=true

[WebPage]Cokemv = type=http-response, pattern=^https?:/\/cokemv\.me\/($|vod.*$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_cokemv.js, requires-body=true

[WebPage]555影视 = type=http-response, pattern=^https?:\/\/.*5y.*\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_555.js, requires-body=true

[WebPage]泥巴影视 = type=http-response, pattern=^https?:\/\/.*nivod.*\/($|[0-9a-zA-Z=_/-]+\.html), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_nivod.js, requires-body=true

[WebPage]奈飞鸭 = type=http-response, pattern=^https?:\/\/.*netflix.*\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_netflix.js, requires-body=true

[WebPage]LeZhu = type=http-response, pattern=^https?:/\/.*lezhutv\.com\/($|(type|detail|play|index).*$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_lezhu.js, requires-body=true

[WebPage]天空影视 = type=http-response, pattern=^https?:\/\/.*tkznp.*com\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_tkys.js, requires-body=true

[WebPage]真不卡 = type=http-response, pattern=^https?:\/\/.*ikandy.*fun\/($|(vod|top).*$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_zhenbuka.js, requires-body=true

[WebPage]Libvio = type=http-response, pattern=^https?:\/\/.*libvio.*me\/($|[0-9a-zA-Z=_/-]+\.html$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_libvio.js, requires-body=true

[MITM]
hostname = %APPEND% e-hentai.org, exhentai.org, hanime1.me, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, *.google.cn, asserts.avple.tv, javdb.com, 2023.redircdn.com, *.pornhub.com, www.zxzjhd.com, m.nivod4.tv, *.freeok.*, *netflix*, *bdys*, *cupfox*, *cokemv*, *pornhub.com, *lezhutv*, *bimi*, 18comic.org, *5y*, *gimy*, *tkznp*, *czzy*, *ikandy*, *libvio*

