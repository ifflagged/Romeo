#!name= iRingo: 🗺️ Maps
#!desc=自定义 Maps app\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Maps
#!homepage=https://NSRingo.github.io/guide/GeoServices/maps
#!date=2026-04-04 20:55:24
#!version=4.6.1

[Rule]
# 🗺️ Amap
DOMAIN-SUFFIX,is.autonavi.com,DIRECT
# 🗺️ Maps
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT

[Script]
# 🗺️ Network Defaults
request.bundle = type=http-request, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_request.bundle.js, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🗺️ Announcements
request.bundle = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_request.bundle.js, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🗺️ Resource Manifest
request.bundle = type=http-request, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_request.bundle.js, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Maps/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% configuration.ls.apple.com, gspe35-ssl.ls.apple.com

