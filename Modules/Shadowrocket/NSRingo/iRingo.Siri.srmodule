#!name= iRingo: ⭕ Siri
#!desc=iOS 18⬆️ & macOS 15⬆️\n全面自定义「Siri 请求」功能。\n⚠️ 不含自定义「Siri 建议」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Siri
#!homepage=https://NSRingo.github.io/guide/Siri/siri
#!date=2024-12-24 04:25:06
#!version=4.2.7

[Script]
# ⭕ Siri.Search.request
request.bundle = type=http-request, pattern=^https?:\/\/(api-siri|api2|api-.+)\.smoot\.apple\.com\/search, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, timeout=60

# ⭕ Siri.SiriSearch.request
request.bundle = type=http-request, pattern=^https?:\/\/(guzzoni|api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.siri\.v2alpha\.SiriSearch\/SiriSearch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 Safari.SafariSearch.request
request.bundle = type=http-request, pattern=^https?:\/\/api-safari(-.+)?\.smoot\.apple\.com\/apple\.parsec\.safari\.v1alpha\.SafariSearch\/SafariSearch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 Lookup.LookupSearch.request
request.bundle = type=http-request, pattern=^https?:\/\/api-lookup(-.+)?\.smoot\.apple\.com\/apple\.parsec\.lookup\.v1alpha\.LookupSearch\/LookupSearch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 Visualsearch.VisualSearch.request
request.bundle = type=http-request, pattern=^https?:\/\/(api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.visualsearch\.v2\.VisualSearch\/VisualSearch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 ResponseFramework.Engagement.EngagementSearch.request
request.bundle = type=http-request, pattern=^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.responseframework\.engagement\.v1alpha\.EngagementSearch\/EngagementSearch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 Spotlight.ZkwSuggestService.request
request.bundle = type=http-request, pattern=^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.spotlight\.v1alpha\.ZkwSuggestService\/Suggest, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% guzzoni.smoot.apple.com, api2.smoot.apple.com, api-*.smoot.apple.com

