#!name= iRingo: 📍 LocationService
#!desc=自定义定位服务内容\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.LocationService
#!homepage=https://NSRingo.github.io/guide/GeoServices/location-service
#!date=2025-10-24 08:48:41
#!version=1.0.1

[Rule]
# 📍 Country Code
DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
# 📍 Amap Dispatcher
DOMAIN,dispatcher.is.autonavi.com,DIRECT

[Script]
# 📍 Country Code
request.bundle = type=http-response, pattern=^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 📍 Dispatcher
request.bundle = type=http-request, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% gspe1-ssl.ls.apple.com, dispatcher.is.autonavi.com

