[URL Rewrite]
#广告
xhlld.*\.shop\/view\/(adList|getVideoInfoAdList) - reject

[Script]
xiaohuli = type=http-response, pattern=xhlld.*\.shop\/view\/getVideoInfo\/\d+, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/xiaohuli/ios151_xiaohuli.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.xhlld076.shop, *.xhlsc006.shop

