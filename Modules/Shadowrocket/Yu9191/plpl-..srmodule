[Script]
plpl = type=http-response, pattern=https:\/\/(?:\S+\/video\/info\/.*\?token=\S+), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/plpl-./ios151_plpl.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% apiaws.*.com, apiaws.*.cn, *apiaws*

