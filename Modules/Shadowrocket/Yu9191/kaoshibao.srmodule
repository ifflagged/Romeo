[URL Rewrite]
^https:\/\/api\.ankianki\.com\/banner\/get$ - reject

[Script]
kaoshibao = type=http-response, pattern=^https:\/\/(api\.ankianki\.com|search-api\.yisouti\.com)\/(user\/userInfo\/get|search\/(getOcrStatus|ocr2|mixPaper)|kaoShi\/.*|paper\/(home|topErrors)|user\/coupon\/getExpireInfo|mockExam\/config|document\/file|questions\/fetch), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/kaoshibao/ios151_kaoshibao.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.ankianki.com, search-api.yisouti.com

