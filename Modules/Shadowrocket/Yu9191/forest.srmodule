[Script]
forest = type=http-response, pattern=^https:\/\/forest-api\.upwardsware\.com\/user\/users\/\d+\/service-levels\/status\?.*$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/forest.js, requires-body=true, max-size=-1, timeout=60

