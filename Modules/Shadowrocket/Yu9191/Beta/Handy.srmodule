[Script]
Handy = type=http-response, pattern=^https:\/\/parseapi\.handyapp\.(cn|io)\/parse\/classes\/(Theme|Discover|ExploreBanner|StandbyPromote), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Handy.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% parseapi.handyapp.*

