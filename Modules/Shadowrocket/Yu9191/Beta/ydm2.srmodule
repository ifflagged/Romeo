#!name=ydm
#!desc=小火箭专用模块
#!icon=icon not found
#!category=Yu9191

[URL Rewrite]
^https://(?:[a-zA-Z0-9-]+\.cloudfront\.net|snerbnew\.pxyzjmspfl\.work)(?::\d+)?/api/?(?:sys/partner/list|activity/indexActs|sys/advertisement/list|sys/getImgAndVideoCdnList|aibox/entranceConfig)?$ - reject

[Script]
ydm2 = type=http-request, pattern=https:\/\/[^\/]+\.cloudfront\.net\/api\/m3u8\/decode\/authPath, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm2/ios151_ydm2.js, timeout=60

ydm2 = type=http-request, pattern=^https:\/\/snerbnew\.pxyzjmspfl\.work(?::\d+)?\/api\/m3u8\/decode\/authPath, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm2/ios151_ydm2.js, timeout=60

[MITM]
hostname = %APPEND% *.cloudfront.net, snerbnew.pxyzjmspfl.work, snerbnew.pxyzjmspfl.work:51999

