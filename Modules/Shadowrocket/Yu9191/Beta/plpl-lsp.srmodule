#!name=plpl-lsp
#!desc=plpl-lsp
#!icon=icon not found
#!category=Yu9191

[Script]
plpl = type=http-response, pattern=https:\/\/(?:\S+\/video\/info\/.*\?token=\S+), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/lsp/plpl.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% apiaws.*.com, apiaws.*.cn, *apiaws*

