[Script]
fi11-req = type=http-request, pattern=^https?:\/\/a74d\.uwegu\.com\/(videos\/v2\/getUrl|visitor\/add), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/fi11/ios151_fi11.js, requires-body=true, max-size=0, timeout=30, argument=logLevel={{{日志级别}}}

fi11-resp = type=http-response, pattern=^https?:\/\/a74d\.uwegu\.com\/(videos\/(getInfo|getList|getRecommendListByVideoId|getFeatured|getHot)|gather\/(getDetail|getListByVideoId)|visitor\/getOrderInfo|user\/(getUserHome|getInfo|detail|info)|home\/(getAds|getMoreAds|getMoreAdsList)), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/fi11/ios151_fi11.js, requires-body=true, max-size=0, timeout=30, argument=logLevel={{{日志级别}}}

[MITM]
hostname = %APPEND% a74d.uwegu.com

