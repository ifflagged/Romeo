[Script]
zimuquan = type=http-response, pattern=^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\/, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/zimuquan.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com

