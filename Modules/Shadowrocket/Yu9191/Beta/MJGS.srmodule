#!name=面具公社
#!desc=18+
#!icon=icon not found
#!category=Yu9191

[URL Rewrite]
^https:\/\/(mfjk|gnjk|buyaoda).+\.com\/request_game\/v3\/game\/list - reject-dict

[Script]
mjgsad = type=http-response, pattern=https:\/\/(mfjk|gnjk|buyaoda).+\.com\/(playerinfo|api\/home\/popup|api\/get_advert), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MJGS/ios151_mjgsad.js, requires-body=true, max-size=-1, timeout=60

mjgshd = type=http-request, pattern=https?:\/\/(mfjk|gnjk|buyaoda).+\.com\/api\/(comic|video|short_movie_info|novel|gallery|vip|index), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MJGS/ios151_mjgshd.js, timeout=60

[MITM]
hostname = %APPEND% gnjk.*.com, mfjk.*.com, buyaoda.*.com

