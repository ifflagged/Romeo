#!arguments-desc=去广告与完整视频解锁默认常开，无需设置。\n日志级别: off / error / warn / info(默认) / debug / all\n播放器: lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / Safari\n自定义scheme: 填写后覆盖播放器，例如 myplayer://play?url= ；留默认 none 表示不启用\nURL编码: yes / no / default(默认)\n播放器跳转: yes / no(默认)
#!arguments=日志级别:info,播放器:lenna,自定义scheme:none,URL编码:default,播放器跳转:no

[Script]
luolita API = type=http-response, pattern=^https?:\/\/api2\.vhmqswjb\.cc\/api\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/luolita/ios151_luolita.js, requires-body=true, max-size=-1, timeout=20, argument=logLevel={{{日志级别}}}&player={{{播放器}}}&scheme={{{自定义scheme}}}&encode={{{URL编码}}}&jump={{{播放器跳转}}}

[MITM]
hostname = %APPEND% api2.vhmqswjb.cc

