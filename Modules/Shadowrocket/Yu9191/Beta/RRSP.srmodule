#!name=人人视频
#!desc=频道获取每日最新Token..UMID
#!author=@Jsforbaby
#!icon=icon not found
#!category=Yu9191
#!arguments-desc=播放器名称支持: SenPlayer, Infuse, Fileball, VidHub, Alook, VLC, Safari
#!arguments=Token:请填写,UMID:请填写,播放器名称:SenPlayer,自定义Scheme:xxx

[Script]
RRTV_4K = type=http-request, pattern=^https?:\/\/api\.rrmj\.plus\/m-station\/drama\/(?:page|play), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/RRSP.js, requires-body=true, timeout=60, argument=token={{{Token}}}&umid={{{UMID}}}&player={{{播放器名称}}}&scheme={{{自定义Scheme}}}

[MITM]
hostname = %APPEND% api.rrmj.plus

