[Script]
msb = type=http-response, pattern=https:\/\/gateway\.mashibing\.com\/edu-course\/(coursePackage\/app\/1|app\/systemCourse|courseWeb), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/msb/ios151_msb.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% gateway.mashibing.com

