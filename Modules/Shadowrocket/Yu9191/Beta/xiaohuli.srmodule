[URL Rewrite]
xhlld.*\.shop\/view\/(adList|getVideoInfoAdList) - reject

[Script]
xiaohuli = type=http-response, pattern=xhlld.*\.shop\/view\/getVideoInfo\/\d+, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/xiaohuli.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.xhlld076.shop, *.xhlsc006.shop

