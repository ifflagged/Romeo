[Script]
含羞草_广告 = type=http-response, pattern=^https?:\/\/[a-z0-9]+\.wt33k\.com\/(home\/getAds|base\/getBulletin|panel\/(list|get)), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Hanxiucao/6lpu5.response.js, requires-body=true, max-size=262144, timeout=15

含羞草_视频 = type=http-response, pattern=^https?:\/\/www\.6lpu5\.com\/play\/video\/, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Hanxiucao/6lpu5.response.js, requires-body=true, max-size=0, timeout=15

[MITM]
hostname = %APPEND% *.wt33k.com, www.6lpu5.com

