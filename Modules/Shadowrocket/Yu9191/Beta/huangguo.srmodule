#!name=黄果短剧去广告
#!desc=去广告（播放跳转/轮播/横幅/贴片）
#!author=Yu9191 Rewrite
#!icon=icon not found
#!category=Yu9191
#!homepage=https://github.com/Yu9191/Rewrite
#!date=2026-09-02

[Rule]
URL-REGEX,"^https?://[^/]*adsdk[12]\.cc",REJECT

[Script]
黄果短剧 = type=http-response, pattern=^https?://huangguoai\.com, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/huangguoduanju/dist/huangguo.js, requires-body=true, max-size=-1, timeout=30

[MITM]
hostname = %APPEND% huangguoai.com, *.huangguoai.com, *.adsdk1.cc, *.adsdk2.cc

