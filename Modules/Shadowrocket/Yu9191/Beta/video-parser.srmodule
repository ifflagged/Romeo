[Script]
video-parser = type=http-response, pattern=https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js, requires-body=true, max-size=-1, timeout=60

video-parser = type=http-response, pattern=^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% 360.com, bp-api.bestv.com.cn

