#!name=Revenuecat
#!desc=Revenuecat
#!icon=icon not found
#!category=Yu9191

[URL Rewrite]
https://api.lianjiu.fun/app/api/v1/profile - reject

[Script]
Revenuecat = type=http-response, pattern=^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Revenuecat.js, requires-body=true, max-size=-1, timeout=60

Revenuecat = type=http-request, pattern=^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Revenuecat.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.lianjiu.fun

