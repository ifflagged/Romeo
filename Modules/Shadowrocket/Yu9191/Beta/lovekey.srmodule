#!name=Lovekey键盘
#!desc=无限制使用 更新2026-10-11
#!icon=icon not found
#!category=Yu9191

[Script]
Lovekey-聊天 = type=http-request, pattern=^https://sea\.api\.lovekeyboard\.com/\S*(?:-(?:ow|stream)-msg|stream_super_msg), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/lovekey/ios151_lovekey.js, timeout=60

Lovekey-账号 = type=http-response, pattern=^https://sea\.api\.lovekeyboard\.com/v2/account, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/lovekey/ios151_lovekey.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% sea.api.lovekeyboard.com

