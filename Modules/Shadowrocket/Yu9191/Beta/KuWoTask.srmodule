#!name=酷我音乐签到
#!desc=酷我音乐自动签到、领金币、抽奖等任务
#!author=bb
#!icon=icon not found
#!category=Yu9191
#!homepage=https://360.com/kuwo
#!date=2025-12-18
#!arguments=phone:"",ocr:"",notify:true
#!arguments-desc=phone: 手机号\n用于Web登录的手机号(可留空)\n\nocr: OCR密钥\n验证码识别API密钥(可留空)\n\nnotify: 每次通知\n关闭后仅在23点发送汇总通知

[Script]
酷我音乐签到 = type=cron, cronexp=15 7-23/1 * * *, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/kuwotask.js, timeout=120, argument=phone="{{{phone}}}"&ocr="{{{ocr}}}"&notify="{{{notify}}}"

酷我助手面板 = type=http-request, pattern=^https?:\/\/360\.com\/kuwo, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/kuwotask.js, requires-body=true, timeout=60, argument=phone="{{{phone}}}"&ocr="{{{ocr}}}"&notify="{{{notify}}}"

[MITM]
hostname = %APPEND% 360.com

