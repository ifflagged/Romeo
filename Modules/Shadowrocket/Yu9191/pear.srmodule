#!name=Pear视频解析
#!desc=会员视频解析，支持选择播放器（支持BoxJS配置）
#!author=@Jsforbaby
#!icon=icon not found
#!category=Yu9191
#!arguments-desc=播放器支持: lenna, SenPlayer, SenPlayer-dl, Infuse, Fileball, VidHub, Alook, VLC, KMPlayer, IINA, NPlayer, Safari\n自定义Scheme优先级最高，例如: myplayer://play?url=\nURL编码: auto(自动), yes(强制编码), no(不编码)\n\n推荐使用BoxJS配置，无需填写参数！\nBoxJS订阅: https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.boxjs.json\n\nSenPlayer: 直接播放\nSenPlayer-dl: 下载模式，自动添加文件名.mp4
#!arguments=播放器名称:lenna,自定义Scheme:完整的URLscheme,URL编码:auto

[Map Local]
^https?:\/\/[^\/]+\/api\/movie\/ShopProduct data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/[^\/]+\/api\/adv\/index data-type=text data="{}" header="Content-Type:application/json"

[Script]
Pear视频解析 = type=http-request, pattern=^https?:\/\/[^\/]+\/api\/(movie\/(LikeUserLikeMovie|DetailInfo)|anime\/DetailRecommend), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.js, max-size=0, timeout=60, argument=player={{{播放器名称}}}&scheme={{{自定义Scheme}}}&encode={{{URL编码}}}

Pear短视频解析 = type=http-request, pattern=^https?:\/\/[^\/]+\/api\/video\/(watch|Detail), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.js, requires-body=true, max-size=0, timeout=60, argument=player={{{播放器名称}}}&scheme={{{自定义Scheme}}}&encode={{{URL编码}}}

Pear磁力下载 = type=http-request, pattern=^https?:\/\/[^\/]+\/api\/download\/MovieWithTorrentInfo, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.js, max-size=0, timeout=60, argument=player={{{播放器名称}}}&scheme={{{自定义Scheme}}}&encode={{{URL编码}}}

PearVIP伪装 = type=http-response, pattern=^https?:\/\/[^\/]+\/api\/(account\/(IndexDetail|IsVip)|cartoon\/VipInfo|download\/CheckDownloadTorrent), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.js, requires-body=true, max-size=0, timeout=60

Pear种子详情 = type=http-request, pattern=^https?:\/\/[^\/]+\/api\/Search\/TorrentDetail\/, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.js, max-size=0, timeout=60, argument=player={{{播放器名称}}}&scheme={{{自定义Scheme}}}&encode={{{URL编码}}}

[MITM]
hostname = %APPEND% *.baidu.com2.club, *.pearkin.com, *.pearhot.com, lite.pearhot.com, souhu.mett.me, *.supdogth.com

