[Script]
# 避免和其他脚本冲突
xvideos = type=http-response, pattern=^https?:\/\/(d28mt\.com|(dpa1uunqzg4g8|dlqrowpypqqsg|d2d03hqzmqybra)\.cloudfront\.net)\/api\/app\/(?:mine\/info|ping\/domain\/h5), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/xvideos.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.cloudfront.net, d28mt.com

