[Rule]
DOMAIN,imc.abchina.com.cn,REJECT,extended-matching
DOMAIN,apm.abchina.com.cn,REJECT,extended-matching
DOMAIN,msmp.abchina.com.cn,REJECT,extended-matching
DOMAIN,firefly.abchina.com.cn,REJECT,extended-matching

[Map Local]
# ⚠️域名[mobilepaas.abchina.com.cn]已无法MITM，可能会导致App端部分功能无法使用，请自行选择是否需要
^https?:\/\/mall\.abchina\.com\.cn\/pips\/EbizccmClientServer\/PIPSPopupAdvertisement data-type=json data="{}"

[MITM]
hostname = %APPEND% mall.abchina.com.cn

