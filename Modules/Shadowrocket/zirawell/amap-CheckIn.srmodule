#!name=amap-CheckIn
#!desc=amap-CheckIn
#!icon=icon not found
#!category=zirawell

[Script]
高德打车-Cookie = type=http-response, pattern=^^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-CheckIn/zirawell_amap.js

高德打车-签到 = type=cron, cronexp=1 0 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-CheckIn/zirawell_amap.js, wake-system=1

# 高德打车-Cookie
amap = type=http-response, pattern=^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-CheckIn/zirawell_amap.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.amap.com

