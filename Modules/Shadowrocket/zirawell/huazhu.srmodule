huazhu = type=http-request, pattern=^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/huazhu/zirawell_huazhu.js, timeout=60

