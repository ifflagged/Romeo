#!name=flyert-CheckIn
#!desc=flyert-CheckIn
#!icon=icon not found
#!category=zirawell

[Script]
飞客-Cookie = type=http-request, pattern=^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js

飞客-签到 = type=cron, cronexp=10 0 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js, wake-system=1

flyert = type=http-request, pattern=^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js, timeout=60

[MITM]
hostname = %APPEND% www.flyert.com.cn

