#!name=bilibili
#!desc=bilibili
#!icon=icon not found
#!category=zirawell

[Rule]
DOMAIN,adtrack.qianwen.com,REJECT
DOMAIN,ad-api.morefreegame.com,REJECT
DOMAIN-SUFFIX,ad.bilibili.com,REJECT
DOMAIN-SUFFIX,adcommon.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.game.bilibili.com,REJECT
DOMAIN-SUFFIX,track.biligame.bilibili.com,REJECT
DOMAIN-KEYWORD,api.sobot.com,REJECT

[URL Rewrite]
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\? - reject-dict
^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v\d\.Search\/DefaultWords - reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? - reject-dict
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v\d\/resource\? - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp - reject-dict
^https?:\/\/app\.bilibili\.com\/x\/resource\/ip - reject-dict

[Script]
bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v\d\.Dynamic\/DynAll, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v\d\.Teenagers\/ModeStatus, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(?>view|viewunite)\.v\d\.View\/View, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.community\.service\.dm\.v\d\.DM\/DmView, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.main\.community\.reply\.v\d\.Reply\/MainList, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliProtoA = type=http-response, pattern=^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.polymer\.app\.search\.v\d\.Search\/SearchAll, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/api\.bilibili\.com\/pgc\/page\/(?>bangumi|cinema\/tab\?), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v\d\/index\/getInfoByRoom\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v\d\/(?>feed\/index(\/story)?|search\/square)\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/(?>top\/activity|show\/tab\/v\d)\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v\d\/splash\/(?>brand\/list|event\/list2|list|show)\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v\d\/account\/(?>mine(\/ipad)?|myinfo)\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

bilibiliJson = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net, api.bilibili.com, api.live.bilibili.com, upos-sz-static.bilivideo.com

