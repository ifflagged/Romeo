#!name=飞客 - FLYERT
#!desc=飞客-五星级轻奢旅行
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!category=zirawell
#!openUrl=https://apps.apple.com/app/id547560608
#!bundleId=com.flyguest.flyertea
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!date=2026-05-09

[URL Rewrite]
^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=advis - reject-dict
^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=basicdata&type=appinfo - reject-dict

[Script]
replaceBody = type=http-response, pattern=^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=basicdata&type=forumlist, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/Script-Hub-Org_replace-body.js, requires-body=true, max-size=-1, timeout=30, argument=adv-%3Eadv0

replaceBody = type=http-response, pattern=^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=threadpost, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/Script-Hub-Org_replace-body.js, requires-body=true, max-size=-1, timeout=30, argument=relatedrecommend-%3Erelatedrecommend0

flyert = type=http-response, pattern=^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*plugin, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/zirawell_flyert.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% www.flyert.com, www.flyert.com.cn, www.flyertrip.com, www.flyertrip.com.cn

