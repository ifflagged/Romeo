[Script]
建行生活-Cookie = type=http-request, pattern=^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js, requires-body=true, max-size=0

建行生活-签到 = type=cron, cronexp=17 7 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js, script-update-interval=0, timeout=60

# 建行生活-Cookie
ccblife = type=http-request, pattern=^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js, requires-body=true, max-size=-1, timeout=60

