[Rule]
DOMAIN,union.chinalifeonline.com.cn,REJECT,extended-matching

[Map Local]
^https?:\/\/static\.95508\.com\/mmg\/ciop\/sysabbr\/cmep\/images\/(app)?popupads data-type=json data="{}"

^https?:\/\/static\.95508\.com\/mmg\/ciop\/202402\/button\/.*\.gif$ data-type=tiny-gif

^https?:\/\/wap\.cgbchina\.com\.cn\/mdpNativeApi\/cawp\/h5-wealth-app\/noSessionServlet\/cawp\/base\/getPersonalizedRecommendations data-type=json data="{}"

[Script]
cgbcc = type=http-response, pattern=^https?:\/\/8\.95508\.com\/creditbank\/mgs\/mgw\.htm$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/cgbcc/zirawell_mgw.js, max-size=0

[MITM]
hostname = %APPEND% static.95508.com, 8.95508.com, wap.cgbchina.com.cn

