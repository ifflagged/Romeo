#!name=🍿️ DualSubs: 🎵 Spotify
#!desc=Spotify 增强及双语歌词
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=DualSubs
#!openUrl=http://boxjs.com/#/app/DualSubs.Spotify
#!homepage=https://DualSubs.github.io/guide/spotify
#!date=2025-10-25 04:40:57
#!version=1.9.12

[Script]
# 🍿️ DualSubs.Spotify.Tracks.response
response.bundle = type=http-response, pattern=^https?:\/\/api\.spotify\.com\/v1\/tracks\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

# 🍿️ DualSubs.Spotify.Lyrics.request
request.bundle = type=http-request, pattern=^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_request.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

# 🍿️ DualSubs.Spotify.Translate.Lyrics.response
Translate.response.bundle = type=http-response, pattern=^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=Translate, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_Translate.response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🍿️ DualSubs.Spotify.External.Lyrics.response
External.Lyrics.response.bundle = type=http-response, pattern=^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=External, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_External.Lyrics.response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.spotify.com, spclient.wg.spotify.com, *-spclient.spotify.com

