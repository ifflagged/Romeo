#!name = 🍿️ DualSubs: 🇳 Netflix
#!desc = Netflix 增强及双语字幕
#!openUrl = https://dualsubs.github.io/preferences/
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://DualSubs.github.io/guide/netflix
#!icon = https://github.com/DualSubs/Netflix/raw/main/src/assets/icon_rounded.png
#!category = 🍿️ DualSubs
#!date = 2026-10-16 01:54:54
#!version = 0.6.0

[Script]
PreferencePanes.API = type=http-request, pattern=^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$, requires-body=1, max-size=65536, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/download/v1.3.1/api.js
📺 DualSubs.Netflix.Config = type=http-request, pattern=^https:\/\/dualsubs\.github\.io\/api\/Netflix(?:\?.*)?$, script-path=https://github.com/DualSubs/Netflix/releases/download/v0.6.0/config.bundle.js
🍿️ DualSubs.Netflix.Translate.Subtitles.response = type=http-response, pattern=^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+, requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js

[MITM]
hostname = %APPEND% dualsubs.github.io, *.oca.nflxvideo.net
tcp-connection = true
