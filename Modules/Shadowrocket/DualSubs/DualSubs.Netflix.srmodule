#!version = 0.6.0

[Script]
📺 DualSubs.Netflix.Config = type=http-request, pattern=^https:\/\/dualsubs\.github\.io\/api\/Netflix(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_config.bundle.js
🍿️ DualSubs.Netflix.Translate.Subtitles.response = type=http-response, pattern=^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+, requires-body=1, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_Translate.response.bundle.js

[MITM]
hostname = %APPEND% dualsubs.github.io, *.oca.nflxvideo.net
tcp-connection = true
