#!name=🍿️ DualSubs: ➕ AddOn (Microsoft Translate)
#!desc=DualSubs 额外插件\n切换为微软翻译并自动刷新Token
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=Jacob
#!openUrl=http://boxjs.com/#/app/DualSubs.AddOn
#!homepage=https://DualSubs.github.io/guide/addon
#!date=2024-12-10 08:54:52
#!version=1.0.8
#!arguments-desc=cronexp: * * * * * *\n                │  │  │  │  │ └── 星期几 (0 - 6, 星期天 = 0)\n                │  │  │  │ └──── 月份 (1 - 12)\n                │  │  │ └────── 天数 (1 - 31)\n                │  │ └──────── 小时 (0 - 23)\n                │ └────────── 分钟 (0 - 59)\n               └──────────── [可选] 秒 (0 - 59)
#!arguments=cronexp:*/10 * * * *

[Script]
🍿️ DualSubs.AddOn.Microsoft.Translate = type=cron, cronexp={{{cronexp}}}, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.AddOn.MicrosoftTranslate/DualSubs_Microsoft.Translate.bundle.js, timeout=60

