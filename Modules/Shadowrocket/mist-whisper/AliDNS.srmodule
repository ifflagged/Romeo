#!name=Ali DNS
#!desc=适配阿里 DoH JSON API
#!author=Maasea[https://github.com/Maasea]
#!icon=icon not found
#!category=mist-whisper
#!date=2024-08-03 12:40:57
#!arguments-desc=相关参数说明查阅 阿里云DoH JSON API 文档
#!arguments=阿里DNS:223.5.5.5,请求域名:*,请求类型:1,Device ID:IOS

[Script]
Alidns = type=dns, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/AliDNS/resource_Alidns.js, argument="{"HOST":"{{{阿里DNS}}}","UID":"{Account ID}","ID":"{AccessKey ID}","SECRET":"{AccessKey Secret}","DID":"{{{Device ID}}}","TYPE":"{{{请求类型}}}"}"

