#!name=Telegram跳转第三方客户端
#!desc=Telegram外链直接跳转至第三方客户端，自行选择跳转至Swiftgram还是Turrit。
#!author=秦城二院彭医生[https://github.com/dcpengx],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!category=mist-whisper
#!date=2025-03-26
#!arguments-desc=jump: 指定跳转客户端 - 选择跳转到哪个第三方tg (选项: Swiftgram, Turrit)
#!arguments=jump:Swiftgram

[Script]
telegram-redirect = type=http-response, pattern=(https:\/\/)?t\.me\/(.+), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Tg_url_redirect/dcpengx_tg-redirect.js, timeout=10, argument=jump="{{{jump}}}"

[MITM]
hostname = %APPEND% t.me

