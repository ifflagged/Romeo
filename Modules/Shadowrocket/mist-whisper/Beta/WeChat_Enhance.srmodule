[Script]
微信外部链接解锁 = type=http-response, pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_Weixin_external_links_unlock.js, requires-body=true

EMS中国邮政物流速递去广告 = type=http-response, pattern=^https:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_EMS.js, requires-body=true

全家微会员去广告 = type=http-response, pattern=^https:\/\/minifm\.maxxipoint\.com\/banner\/list, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_FamilyMart.js, requires-body=true

罗森点点去广告 = type=http-response, pattern=^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/home, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_LAWSON.js, requires-body=true

茶颜悦色去广告 = type=http-response, pattern=^https:\/\/miniapp\.sexytea2013\.com\/cms\/slot\/queryByCodes\?codes=INDEX_TOP_BANNER, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_Chayanyuese.js, requires-body=true

COCO点单去广告 = type=http-response, pattern=^https:\/\/coco-com\.e\.verystar\.net\/v1\/home\/info, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_CoCo.js, requires-body=true

滴滴青桔去广告 = type=http-response, pattern=^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm\.fa\.homeConfig, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_Qingju.js, requires-body=true

一点点+去广告 = type=http-response, pattern=^https:\/\/cappapi\.alittle-tea\.com\/open\?method=catering\.set\.ad, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_AlittleTea_T3.js, requires-body=true

M Stand去广告 = type=http-response, pattern=^https:\/\/api\.prod\.dj\.mstand\.cn\/scrm\/mini\/app\/index\/info, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_MStand.js, requires-body=true

T3出行去广告 = type=http-response, pattern=^https:\/\/passenger\.t3go\.cn\/(solution\-|common\-)?(passenger\-)?(activity\-|app\-)?api\/notoken\/(trip\/)?api\/(home\/|common\/)?(v[1-3]\/)?(ad\/getNegativescreen|solution\/passenger\/open\/getHomeMenu|leftmenu|getHomeInfoGlobal), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_AlittleTea_T3.js, requires-body=true

古茗去广告 = type=http-response, pattern=^https:\/\/newton\.gumingnc\.com\/newton-buyer\/newton\/buyer\/(ump|touch|external\/front), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_Guming.js, requires-body=true

美团小程序tap优化 = type=http-response, pattern=^https:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/WeChat_Enhance/resource_MeiTuan.js, requires-body=true, timeout=60

