#!name=Trakt 增强
#!desc=Trakt App 各页面从英文改为简体中文，支持中文标题、简介和海报；历史页面剧集类别的已观看记录按电视剧合并；Trakt 和 SofaTime 的影片详情页添加 Forward、Infuse、Rex 跳转按钮；部分兼容其它使用了 Trakt API 的应用。
#!author=DemoJameson[https://github.com/DemoJameson]
#!icon=icon not found
#!category=mist-whisper
#!category=去广告
#!system=iOS iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!date=2026-09-23 17:40:27
#!arguments=fakeVipEnabled:true,posterImageMode:"原片语言",historyEpisodesMergedByShow:true,translationEngine:"谷歌翻译",characterTranslationEnabled:true,forwardButtonOrder:"2",infuseButtonOrder:"3",rexButtonOrder:"4",backendBaseUrl:"https://proxy-modules.demojameson.de5.net",debugMode:"关闭"
#!arguments-desc=fakeVipEnabled: 伪装成 VIP\n启用后伪装为 Trakt VIP 会员，移除 App 中的广告\n\nposterImageMode: 海报语言\n原片语言使用 TMDb 影片原始语言图片；中文使用 TMDb 中文图片；原图保留 Trakt 原图\n可选值: 原片语言, 中文, 原图\n\nhistoryEpisodesMergedByShow: 历史剧集按电视剧合并\n启用后会将历史页面电视剧类别的观看记录按电视剧合并\n\ntranslationEngine: 翻译部分文本\n选择翻译引擎：谷歌翻译（快，需翻墙）、DeepLX（慢，可直连）、关闭\n可选值: 谷歌翻译, DeepLX, 关闭\n\ncharacterTranslationEnabled: 用豆瓣翻译角色名\n启用后会用豆瓣翻译角色名\n\nforwardButtonOrder: Forward 跳转按钮\n序号代表在 Trakt 中的排序位置，0 不显示，默认 2\n可选值: 2, 1, 3, 4, 0\n\ninfuseButtonOrder: Infuse 跳转按钮\n序号代表在 Trakt 中的排序位置，0 不显示，默认 3\n可选值: 3, 1, 2, 4, 0\n\nrexButtonOrder: Rex 跳转按钮\n序号代表在 Trakt 中的排序位置，0 不显示，默认 4\n可选值: 4, 1, 2, 3, 0\n\nbackendBaseUrl: 翻译缓存接口\n用于批量获取 Trakt 的中文翻译，一般留空即可\n\ndebugMode: 调试模式\n禁用本地缓存：不读写持久化存储；禁用远端缓存：不请求后端缓存接口；禁用所有缓存：两者皆禁用\n可选值: 关闭, 禁用本地缓存, 禁用远端缓存, 禁用所有缓存

[Script]
Direct Redirect = type=http-request, pattern=^https:\/\/loon-plugins\.demojameson\.de5\.net\/api\/redirect\?.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

TMDB Logo Redirect = type=http-request, pattern=^https:\/\/image\.tmdb\.org\/t\/p\/w342\/[a-z0-9_-]+_logo\.webp(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

Trakt Sync History Episodes Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/sync\/history\/episodes\/?(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

Trakt History Episodes Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/users\/[^\/]+?\/history\/episodes\/?(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

Trakt Current Season Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/shows\/[^\/]+\/seasons\/\d+(?:\/.*|\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

Trakt Response Router = type=http-response, pattern=^https:\/\/apiz?\.trakt\.tv\/.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

TMDB Provider Catalog = type=http-response, pattern=^https:\/\/api\.themoviedb\.org\/3\/watch\/providers\/(?:movie|tv)(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

TMDB Detail Watch Providers = type=http-response, pattern=^https:\/\/api\.themoviedb\.org\/3\/(?:tv|movie)\/\d+\?.*watch(?:%2F|\/)providers.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument=fakeVipEnabled="{{{fakeVipEnabled}}}"&posterImageMode="{{{posterImageMode}}}"&historyEpisodesMergedByShow="{{{historyEpisodesMergedByShow}}}"&translationEngine="{{{translationEngine}}}"&characterTranslationEnabled="{{{characterTranslationEnabled}}}"&forwardButtonOrder="{{{forwardButtonOrder}}}"&infuseButtonOrder="{{{infuseButtonOrder}}}"&rexButtonOrder="{{{rexButtonOrder}}}"&backendBaseUrl="{{{backendBaseUrl}}}"&debugMode="{{{debugMode}}}"

[MITM]
hostname = %APPEND% apiz.trakt.tv, api.trakt.tv, api.themoviedb.org, image.tmdb.org, loon-plugins.demojameson.de5.net

