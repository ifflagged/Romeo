#!name=Trakt 增强
#!desc=Trakt App 各页面从英文改为简体中文，支持中文标题、简介和海报；历史页面剧集类别的已观看记录按电视剧合并；Trakt 和 SofaTime 的影片详情页添加 Forward、Infuse、Rex 跳转按钮；部分兼容其它使用了 Trakt API 的应用。
#!author=DemoJameson[https://github.com/DemoJameson]
#!icon=icon not found
#!category=mist-whisper
#!tag=去广告
#!system=iOS iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!date=2026-09-23 17:40:27
#!arguments=fakeVipEnabled:"true",posterImageMode:"原片语言",historyEpisodesMergedByShow:"true",translationEngine:"谷歌翻译",characterTranslationEnabled:"true",forwardButtonOrder:"2",infuseButtonOrder:"3",rexButtonOrder:"4",backendBaseUrl:"https://proxy-modules.demojameson.de5.net",debugMode:"关闭"

[Script]
# 处理播放器 DeepLink 跳转
Direct Redirect = type=http-request, pattern=^https:\/\/loon-plugins\.demojameson\.de5\.net\/api\/redirect\?.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# SofaTime 中自定义播放器 Logo
TMDB Logo Redirect = type=http-request, pattern=^https:\/\/image\.tmdb\.org\/t\/p\/w342\/[a-z0-9_-]+_logo\.webp(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 拦截 sync/history/episodes 请求，放大 limit
Trakt Sync History Episodes Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/sync\/history\/episodes\/?(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 拦截 history/episodes 请求，放大 limit
Trakt History Episodes Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/users\/[^\/]+?\/history\/episodes\/?(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 拦截带季号的请求，记录当前浏览季
Trakt Current Season Request = type=http-request, pattern=^https:\/\/apiz?\.trakt\.tv\/shows\/[^\/]+\/seasons\/\d+(?:\/.*|\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, timeout=10, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 统一拦截 Trakt 响应，由脚本内部分流处理
Trakt Response Router = type=http-response, pattern=^https:\/\/apiz?\.trakt\.tv\/.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 仅拦截 SofaTime 的 TMDB provider 列表，注入播放器
TMDB Provider Catalog = type=http-response, pattern=^https:\/\/api\.themoviedb\.org\/3\/watch\/providers\/(?:movie|tv)(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

# 仅拦截 SofaTime 的 TMDB 详情请求（append_to_response 含 watch/providers），清除原有观看来源并注入排序 1 播放器
TMDB Detail Watch Providers = type=http-response, pattern=^https:\/\/api\.themoviedb\.org\/3\/(?:tv|movie)\/\d+\?.*watch(?:%2F|\/)providers.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Trakt_Enhance/DemoJameson_trakt_simplified_chinese.js, requires-body=true, timeout=60, argument="[{{{fakeVipEnabled}}},{{{posterImageMode}}},{{{historyEpisodesMergedByShow}}},{{{translationEngine}}},{{{characterTranslationEnabled}}},{{{forwardButtonOrder}}},{{{infuseButtonOrder}}},{{{rexButtonOrder}}},{{{backendBaseUrl}}},{{{debugMode}}}]"

[MITM]
hostname = %APPEND% apiz.trakt.tv, api.trakt.tv, api.themoviedb.org, image.tmdb.org, loon-plugins.demojameson.de5.net

