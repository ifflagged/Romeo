[URL Rewrite]
^https?:\/\/(?:api|da|tk|adx)\.anythinktech\.com\/ - reject
^https?:\/\/api\.toponadss\.com\/ - reject
^https?:\/\/mobads(?:-logs)?\.baidu\.com\/ - reject
^https?:\/\/mobads-pre-config\.(?:bj|cdn)\.bcebos\.com\/ - reject
^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\/ - reject
^https?:\/\/stage2\.chelaile\.net\.cn\/sdk - reject
^https?:\/\/ad\.xhey\.top\/next\/(?:app\/adx\/|promote\/operation\/appstart\/adx\/|ad\/event\/track\/).* - reject
^https?:\/\/39\.108\.85\.131\/next\/(?:ios\/config\/cache|promote\/operation\/config\/get\/cache)(?:\?.*)?$ - reject
^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config\/v2a|req_ad)(?:\?.*)?$ - reject
^https?:\/\/adx-strategy-api-cn\.statisticslinks\.com\/sdk\/pl_strategy(?:\?.*)?$ - reject
^https?:\/\/adx-micro\.statisticslinks\.com\/http_bid(?:\?.*)?$ - reject
^https?:\/\/da\.statisticslinks\.com\/v1\/open\/da(?:\?.*)?$ - reject
^https?:\/\/tk\.statisticslinks\.com\/v2\/open\/a_tk(?:\?.*)?$ - reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch(?:\?.*)?$ - reject
^https?:\/\/als\.baidu\.com\/clog\/glog(?:\?.*)?$ - reject

[Script]
xhey-ad-clean = type=http-response, pattern=^https?:\/\/abtest-tx-beijing-01\.saas\.sensorsdata\.cn\/api\/v2\/abtest\/online\/results\?(?:[^#?&]+&)*project-key=(?:0E6053C30A799D63EFA48959776B2EE2EDC81359|EE39C73914ED208E6EBE24A7333CAF5C3FE2E89D), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xhey-ad-clean/ZenmoFeiShi_xhey-ad-clean.js, requires-body=true, max-size=-1, timeout=60

xhey-ad-clean = type=http-response, pattern=^https?:\/\/jt-sdk-ios\.oss-cn-beijing\.aliyuncs\.com\/iOSConfig\.txt(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xhey-ad-clean/ZenmoFeiShi_xhey-ad-clean.js, requires-body=true, max-size=-1, timeout=60

