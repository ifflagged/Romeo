#!name=SLY
#!desc=SLY
#!icon=icon not found
#!category=Jacob

[Script]
SLY = type=http-request, pattern=^https:\/\/m\.suileyoo\.com\/api\/user\/profile, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/SLY/ZenmoFeiShi_SLY.js, timeout=60

随乐游 = type=cron, cronexp=1 0 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/SLY/ZenmoFeiShi_SLY.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% m.suileyoo.com

