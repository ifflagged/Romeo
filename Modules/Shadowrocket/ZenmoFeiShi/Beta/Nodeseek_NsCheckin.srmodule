[Script]
Nodeseek_NsCheckin = type=http-request, pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/\d+\?readme=1$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Nodeseek_NsCheckin/ZenmoFeiShi_Nodeseek_NsCheckin.js, timeout=60

NS🍗签到 = type=cron, cronexp=1 0 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Nodeseek_NsCheckin/ZenmoFeiShi_Nodeseek_NsCheckin.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% www.nodeseek.com

