[URL Rewrite]
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","startup_ad_switch"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","startup_ad_timeout"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","startup_ad_day_max"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","app_bar_guide_width"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","app_bar_guide_height"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","app_bar_guide_url"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","app_bar_guide_time"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","home_tab_event_tag"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","home_tab_event_tag_ext"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","home_tab_player_tag"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","home_tab_player_tag_ext"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","task_center_entrance"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","store_go"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'delpaths([["data","function_configs","wall_closed"]])'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ 'delpaths([["data","float_advertise"]])'
http-response-jq ^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ 'delpaths([["data","placeholder"]])'

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com

