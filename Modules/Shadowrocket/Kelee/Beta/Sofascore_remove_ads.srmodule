[URL Rewrite]
^https:\/\/api\.sofascore\.com\/api\/v\d\/dsp\/country\/[A-Z]{2}$ - reject-dict

[Map Local]
^https:\/\/api\.sofascore\.com\/api\/v\d\/trending\/grid\/tiles\/[A-Z]{2}$ data-type=text data="{"tiles":[]}" header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.sofascore.com

