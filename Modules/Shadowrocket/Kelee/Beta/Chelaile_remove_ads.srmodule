#!name=车来了去广告
#!desc=清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!category=Kelee
#!openUrl=https://apps.apple.com/app/id667831823
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN,ad.chelaile.net.cn,REJECT

[Map Local]
(?i)^https:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html\? data-type=text data="" status-code=404

(?i)^https:\/\/image3\.chelaile\.net\.cn\/hw6u6LYY\.png$ data-type=tiny-gif status-code=200

[Script]
清洗配置 = type=http-response, pattern=(?i)^https:\/\/api\.chelaile\.net\.cn\/bus-side\/appToggle\/getStatus\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Chelaile_remove_ads/kelee_Chelaile_remove_ads.js, requires-body=true

[MITM]
hostname = %APPEND% api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, image3.chelaile.net.cn

