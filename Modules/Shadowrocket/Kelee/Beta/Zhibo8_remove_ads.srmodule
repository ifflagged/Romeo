[URL Rewrite]
^https:\/\/rn\.qiumibao\.com\/news\/relation\.php$ - reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/notice$ - reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/pop$ - reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/ep\/pop$ - reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/banner$ - reject-dict
^https:\/\/search\.qiumibao\.com\/hot\/word_list$ - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/headline\.qiumibao\.com\/recommend\/list\? '.news|=map(select(.model=="news" or .model=="video"))'
http-response-jq ^https:\/\/a\.qiumibao\.com\/found\/\? 'map(select(.is_game != true))'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["skin"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["advert"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["advert_config"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["mall"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["httpdns"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["reward"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["pgame"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["corner_mark"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["liveshop"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["theme"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["pop"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? 'delpaths([["live_activity_push"]])'
http-response-jq ^https:\/\/a\.qiumibao\.com\/ios\/config\/\? '.all_sections.match_sections.labels |= (if . then (.blacks_disable |= if . then map(select(. != "游戏")) else . end) | (.show |= if . then map(select(. != "游戏")) else . end) else . end)'
http-response-jq ^https:\/\/guess\.qiumibao\.com\/api\/n\/rcd$ 'delpaths([["data","banner"]])'
http-response-jq ^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? 'delpaths([["'del(","data"]])'
http-response-jq ^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? 'delpaths([["|"]])'
http-response-jq ^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? 'delpaths([["select(","type"]])'
http-response-jq ^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? 'delpaths([["=="]])'
http-response-jq ^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? 'delpaths([["\"guide\"))'"]])'
http-response-jq ^https:\/\/guess\.qiumibao\.com\/api\/c\/menu$ 'delpaths([["data","banner"]])'
http-response-jq ^https:\/\/s\.qiumibao\.com\/m\/ios\/json\/zhibo\/zuqiu\/\d+\/match\d+vl\.htm\? 'delpaths([["ep_v2"]])'
http-response-jq ^https:\/\/s\.qiumibao\.com\/m\/ios\/json\/zhibo\/zuqiu\/\d+\/match\d+vl\.htm\? 'delpaths([["ep_live"]])'

