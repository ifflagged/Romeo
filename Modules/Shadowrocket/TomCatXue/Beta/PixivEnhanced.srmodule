#!name=Pixiv · 全局增强翻译 (Pixiverse Enhanced)
#!desc=适配 8.9.2 等版本：全页面日文深度汉化 · AI 视觉多模态漫翻 · 仿 Pix-Scripting/Biliverse 内置设置中心。\n• 拦截首页Home/推荐/榜单/详情/评论/画师主页全量汉化\n• 内置 2500+ 高频 Pixiv Tag 离线字典，0ms 极速秒翻且副标题自动净空\n• 小说沉浸式排版：支持苹方/宋体/楷体/圆体，自动净化免责声明规约\n• 智能豁免纯中文内容，不消耗 API 与加载时间\n• 悬浮按钮像素级对齐喜欢按钮上方，100% 灵敏响应，绝无拖拽失灵\n• 劫持帮助中心直达 PreferencePanes 设置中心，实时同步配置。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=Pixiv,翻译,AI漫翻,去广告,增强
#!system=iOS,iPadOS,macOS
#!date=2026-09-29 16:30
#!version=4.1.1

[URL Rewrite]
# 1. 劫持 Pixiv App 内「帮助中心」与「服务条款」，一键直达增强设置中心
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302

[Script]
# 设置中心与 API 交互 (配置读取、保存、实时测速、清空缓存，全脱机 0 网络依赖)
Pixiv.Enhanced.SettingsAPI = type=http-request, pattern=^https:\/\/app-api\.pixiv\.net\/(settings\/Enhanced|api\/(?:get|set|delete|test_ai|clear_cache|cache_stats)), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

# 全页面 REST API 响应体汉化拦截器（全覆盖首页home/推荐/榜单/详情/评论v3/画师主页/特辑/漫画/小说）
Pixiv.Enhanced.ApiTranslate = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/v[1-3]\/(illust|manga|novel|user|search|trending-tags|spotlight|home), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

# 小说阅读器 & 页面注入 iOS SF Symbols「文/A」悬浮按钮与排版引擎
Pixiv.Enhanced.WebviewInject = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

# 翻译中转网关与 AI 视觉漫翻端点
Pixiv.Enhanced.Proxy = type=http-request, pattern=^https:\/\/app-api\.pixiv\.net\/pxtrans, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

[MITM]
hostname = %APPEND% app-api.pixiv.net, app.pixiv.help, policies.pixiv.net

