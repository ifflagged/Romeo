#!name=Pixiv · 全局增强翻译
#!desc=适配 8.9.2 等版本：全页面日文深度汉化 · AI 视觉多模态漫翻 · 内置设置中心。\n• 出版级双语小说阅读：原文在上一一对应，渐进式渲染与失败重试\n• 统一 Apple SF Symbols 单色矢量图标系统与 Grouped 规范设计\n• 悬浮按钮纯粹总开关控制，自动避开原生控件且滚动不跳跃\n• 真实可管理本地缓存统计（字节级大小、条目数、最近时间、清理反馈）\n• 首页/榜单/详情/评论/画师主页全量汉化，彻底消除查看更多弹窗\n• 内置 2500+ 高频 Pixiv Tag 离线字典，0ms 极速秒翻且副标题自动净空。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=Pixiv,翻译,AI漫翻,去广告,增强
#!system=iOS,iPadOS,macOS
#!date=2026-10-02 08:30
#!version=4.4.6

[URL Rewrite]
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302

[Header Rewrite]
http-response (?i)^https:\/\/app-api\.pixiv\.net\/settings\/Enhanced(?:\?[^#]*)?$ header-add "Cache-Control" "no-store"

[Map Local]
(?i)^https:\/\/app-api\.pixiv\.net\/settings\/Enhanced(?:\?[^#]*)?$ data-type=file data="https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_settings.js" status-code=200 header="Content-Type:text/html"

[Script]
Pixiv.Enhanced.SettingsAPI = type=http-request, pattern=^https:\/\/(app-api|www)\.pixiv\.net\/(settings\/Enhanced|manga\/viewer|api\/), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

Pixiv.Enhanced.ApiTranslate = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/v[1-3]\/(illust|manga|novel|user|search|trending-tags|spotlight|home), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

Pixiv.Enhanced.WebviewInject = type=http-response, pattern=^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

Pixiv.Enhanced.Proxy = type=http-request, pattern=^https:\/\/(app-api|www)\.pixiv\.net\/pxtrans, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivEnhanced/TomCatXue_pixiv_enhanced.js, requires-body=true

[MITM]
hostname = %APPEND% app-api.pixiv.net, app.pixiv.help, policies.pixiv.net, www.pixiv.net

