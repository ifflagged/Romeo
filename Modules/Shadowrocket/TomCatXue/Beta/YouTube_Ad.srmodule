#!name=YouTube去广告
#!desc=移除广告/短片按钮/智能助手/商品/竖屏直播，解锁高码率画质/精彩跳转/通勤模式，内置画中画与后台播放，支持外语字幕智能识别中英机翻与QUIC防穿透。
#!author=Maasea, gholts, RuCu6, devchristian1337
#!icon=icon not found
#!category=TomCatXue
#!date=2026-11-04 17:15
#!version=1.1.1
#!loon_version=3.5.1(983)
#!arguments=autoHd:#,jumpAhead:false,onTheGo:false,translation_enabled:false,translation_target:"zh-CN",blockAi:false,blockGames:false,blockShorts:false,blockStore:false,blockUpload:false,blockVerticalLive:false
#!arguments-desc=autoHd: 自动最高画质\n自动选择 YouTube 最高画质（需根据当前网速与流量开启）\n可选值: 留空启用, # 禁用\n\njumpAhead: 启用精彩跳转\n启用 YouTube Premium Jump Ahead 按钮（一键跳过枯燥片段）\n可选值: false, true\n\nonTheGo: 启用通勤模式\n启用 YouTube Premium On-the-go 通勤极简播放模式\n可选值: false, true\n\ntranslation_enabled: 启用字幕机翻\n将外语视频字幕自动机翻为目标语言（需原视频本身带有字幕轨）\n可选值: false, true\n\ntranslation_target: 字幕目标语言\n自动机翻的目标语言（简体中文 zh-CN 或美式英文 en-US）\n可选值: zh-CN, zh-CN, en-US\n\nblockAi: 隐藏智能助手\n用于隐藏 YouTube 界面中的 AI 智能助手按钮\n可选值: false, true\n\nblockGames: 隐藏游戏中心\n用于隐藏 YouTube 界面中的 Playables 游戏中心\n可选值: false, true\n\nblockShorts: 隐藏短片按钮\n用于隐藏 YouTube 底部导航栏的短片（Shorts）按钮\n可选值: false, true\n\nblockStore: 隐藏商品推荐\n用于隐藏视频下方以及 YouTuber 主页中的商品橱窗与推广\n可选值: false, true\n\nblockUpload: 隐藏上传按钮\n用于隐藏 YouTube 底部导航栏正中央的上传（+）按钮\n可选值: false, true\n\nblockVerticalLive: 隐藏竖屏直播\n用于隐藏 YouTube 首页信息流中穿插的竖屏直播卡片\n可选值: false, true

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Header Rewrite]
http-response ^https://(?:[\w-]+\.)*googlevideo\.com(?::443)?/ header-replace 'Alt-Svc' 'clear'

[Map Local]
(?i)^https:\/\/s\.youtube\.com\/api\/stats\/ads data-type=text data="" status-code=404

(?i)^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ data-type=text data="" status-code=404

[Script]
[YouTube]广告切片拦截 = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_request.js, requires-body=true, binary-body-mode=true

[YouTube]初始化播放请求 = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_request.js, requires-body=true, binary-body-mode=true

{{{autoHd}}}[YouTube]画质协商 = type=http-request, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_request.js, requires-body=true, binary-body-mode=true, argument=autoHd="{{{autoHd}}}"

[YouTube]日志过滤 = type=http-request, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_request.js, requires-body=true, binary-body-mode=true

[YouTube]页面与播放净化 = type=http-response, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_response.js, requires-body=true, binary-body-mode=true, argument=autoHd="{{{autoHd}}}"&blockAi="{{{blockAi}}}"&blockGames="{{{blockGames}}}"&blockShorts="{{{blockShorts}}}"&blockStore="{{{blockStore}}}"&blockUpload="{{{blockUpload}}}"&blockVerticalLive="{{{blockVerticalLive}}}"&jumpAhead="{{{jumpAhead}}}"&onTheGo="{{{onTheGo}}}"&translation_enabled="{{{translation_enabled}}}"&translation_target="{{{translation_target}}}"

[YouTube]密钥提取 = type=http-response, pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_key.js, requires-body=true, binary-body-mode=true

[YouTube]分块流媒体清洗 = type=http-response, pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/YouTube_Ad/TomCatXue_youtube_ump.js, requires-body=true, binary-body-mode=true, argument=autoHd="{{{autoHd}}}"&blockAi="{{{blockAi}}}"&blockGames="{{{blockGames}}}"&blockStore="{{{blockStore}}}"&blockVerticalLive="{{{blockVerticalLive}}}"&jumpAhead="{{{jumpAhead}}}"&onTheGo="{{{onTheGo}}}"

[MITM]
hostname = %APPEND% rr*.googlevideo.com, *.googlevideo.com, s.youtube.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, youtubei.googleapis.com, youtubei-att.googleapis.com

