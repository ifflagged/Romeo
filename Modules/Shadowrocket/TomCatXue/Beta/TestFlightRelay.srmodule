[Script]
TestFlight-Relay = type=http-request, pattern=(?i)^http:\/\/tf-relay\.test(?::8799)?\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TestFlightRelay/ScriptingApp_TestFlight-Relay.js, requires-body=true, timeout=30

TestFlight-Relay-Refresh = type=cron, cronexp=0 */5 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TestFlightRelay/ScriptingApp_TestFlight-Relay.js, timeout=300

