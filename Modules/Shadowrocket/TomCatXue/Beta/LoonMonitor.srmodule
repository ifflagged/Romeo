#!name=LoonMonitor · 小组件数据提供与状态服务
#!desc=专为 iOS 哑巴面板 (MutePanel) 小组件打造的 Loon 本地监控数据服务。实时提供当前运行模式、策略组数量、活跃节点、VPN 出口 IP/归属地、延迟与订阅流量统计。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=Loon, 监控, 小组件, VPN
#!version=1.4.4
#!date=2026-10-13 14:30
#!arguments=sub_url:""
#!arguments-desc=sub_url: 机场订阅链接\n配置机场节点订阅链接（URL），插件将自动定时同步上下行与剩余流量

[Rule]
DOMAIN,loon.box,PROXY
DOMAIN,api.loon.box,PROXY
DOMAIN,loon.local,PROXY
IP-CIDR,198.18.0.1/32,PROXY,no-resolve
DOMAIN-SUFFIX,jsdelivr.net,PROXY
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,ip.sb,PROXY

[Host]
loon.box = 198.18.0.1
api.loon.box = 198.18.0.1
loon.local = 198.18.0.1

[Script]
Loon监控·小组件数据服务 = type=http-request, pattern=^https?:\/\/((api\.)?loon\.(box|local)|198\.18\.0\.1)(:\d+)?\/.*, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js, timeout=10, argument="{{{sub_url}}}"

Loon监控·订阅流量捕获 = type=http-response, pattern=\/(subscription|subscribe)|[?&]token=, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js, timeout=10

Loon监控·定时同步 = type=cron, cronexp=0 */2 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js, timeout=20, argument="{{{sub_url}}}"

[MITM]
hostname = %APPEND% loon.box, api.loon.box, loon.local

