#!name=QQ空间广告屏蔽
#!desc=广告退散，空间清净
#!author=zqzess / TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=QQ空间,广告屏蔽,清净浏览
#!version=1.1.0
#!date=2026-09-19 12:00

[Rule]
DOMAIN,d3g.qq.com,REJECT
DOMAIN,bsrv.qq.com,REJECT
DOMAIN,sq.bls.mdt.qq.com,REJECT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,xj-landing.gdtimg.com,REJECT

[Map Local]
(?i)^https?:\/\/c\.gdt\.qq\.com\/gdt_clickwap\.fcg\?viewid data-type=text data="" status-code=404

(?i)^https?:\/\/pgdt\.gtimg\.cn\/gdt\/0\/.*\.jpg data-type=text data="" status-code=404

(?i)^https?:\/\/v\.gdt\.qq\.com\/gdt_stats\.fcg\?viewid data-type=text data="" status-code=404

(?i)^https?:\/\/rpt\.gdt\.qq\.com\/creative_view\?viewid data-type=text data="" status-code=404

(?i)^https?:\/\/pgdt\.gtimg\.cn\/gdt\/.*\.png data-type=text data="" status-code=404

(?i)^https?:\/\/pgdt\.gtimg\.cn\/gdt\/.*\.jpg data-type=text data="" status-code=404

(?i)^https?:\/\/pgdt\.gtimg\.cn\/.*\/snscosdownload\/SH\/reserved\/.* data-type=text data="" status-code=404

