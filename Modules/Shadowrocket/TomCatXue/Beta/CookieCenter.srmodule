#!name=呆呆面板 · 凭据捕获与自动同步
#!desc=聚合应用凭据静默捕获与呆呆面板 (Dumb-Panel) 自动同步。各应用配备独立业务开关（开启即代表捕获并自动同步至呆呆面板环境变量）；支持一键手动全量同步与每日自动巡检。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=签到, Cookie, 凭据捕获, 呆呆面板, Dumb-Panel
#!version=5.6.0
#!date=2026-10-21 01:30
#!arguments=weread:"",cmcc_mark:"",camscanner:"",telecom_draw:"",telecom_rights:"",telecom_benefit:"",daidai_url:"",daidai_key:"",daidai_secret:""
#!arguments-desc=weread: 微信读书\n打开微信读书 App 进「我」或「翻牌/限免」自动触发抓取并同步至呆呆面板 WEREAD_AUTH\n可选值: 留空启用, # 禁用\n\ncmcc_mark: 移动·每日签到\n在中国移动 App 内打开「每日签到」活动页触发，自动抓取长期 app_token 并同步至呆呆面板 CMCC_AUTH\n可选值: 留空启用, # 禁用\n\ncamscanner: 扫描全能王\n打开扫描全能王 App 进个人中心触发静默抓取并同步至呆呆面板 camscanner_data\n可选值: 留空启用, # 禁用\n\ntelecom_draw: 电信·会员抽奖\n打开微信小程序「中国电信营业厅」进「签到有礼」或「会员日抽奖」页面触发抓取 SessionKey\n可选值: 留空启用, # 禁用\n\ntelecom_rights: 电信·等级权益\n打开电信营业厅 App 进「我的签到」或「等级权益」页面触发抓取\n可选值: 留空启用, # 禁用\n\ntelecom_benefit: 电信·山西福利\n打开山西电信体验AI领福利活动页面触发抓取最新批次凭证\n可选值: 留空启用, # 禁用\n\ndaidai_url: 呆呆面板地址(可选)\n填入例如 http://192.168.1.10:5700，若在 BoxJS 已配置则此项可留空\n\ndaidai_key: 呆呆面板AppKey(可选)\n填入 Open API App Key，若在 BoxJS 已配置则此项可留空\n\ndaidai_secret: 呆呆面板AppSecret(可选)\n填入 Open API App Secret，若在 BoxJS 已配置则此项可留空

[Script]
{{{weread}}}微信读书·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{weread}}}微信读书·登录请求 = type=http-request, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{weread}}}微信读书·登录响应 = type=http-response, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{cmcc_mark}}}移动·长期 app_token 捕获 = type=http-request, pattern=(?i)^https?:\/\/wx\.10086\.cn\/qwhdsso\/appTokenLogin, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_cmcc_cookie.js, requires-body=true, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{cmcc_mark}}}移动·签到接口票据 = type=http-request, pattern=(?i)^https?:\/\/wx\.10086\.cn\/qwhdhub\/api\/mark\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_cmcc_cookie.js, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{cmcc_mark}}}移动·登录页票据回填 = type=http-response, pattern=(?i)^https?:\/\/wx\.10086\.cn\/qwhdhub\/(qwhdmark|qwhdsso)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_cmcc_cookie.js, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{camscanner}}}扫描全能王 Cookie = type=http-request, pattern=(?i)^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_camscanner.cookie.js, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

{{{telecom_draw}}}电信·会员配置捕获 = type=http-request, pattern=(?i)^https?:\/\/cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js

{{{telecom_draw}}}电信·小程序登录捕获 = type=http-request, pattern=(?i)^https?:\/\/mapi-h5\.bestpay\.com\.cn\/gapi\/handyservice\/miniprogram\/checkParam, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js, requires-body=true

{{{telecom_draw}}}电信·MGS网关捕获 = type=http-request, pattern=(?i)^https?:\/\/spanner\.bestpay\.com\.cn:10081, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js

{{{telecom_rights}}}电信·等级权益凭证捕获 = type=http-request, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js

{{{telecom_rights}}}电信·等级权益会话回填 = type=http-response, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js, requires-body=true

{{{telecom_benefit}}}电信·山西活动凭据捕获 = type=http-request, pattern=(?i)^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_benefit.js

呆呆面板·每日兜底同步 = type=cron, cronexp=9 3 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_sync.js, timeout=60, argument="daidai_url=${{{daidai_url}}}&daidai_key=${{{daidai_key}}}&daidai_secret=${{{daidai_secret}}}"

[MITM]
hostname = %APPEND% weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn, api-cs.intsig.net, wx.10086.cn, qwhdcdn.cmcc-cs.cn

