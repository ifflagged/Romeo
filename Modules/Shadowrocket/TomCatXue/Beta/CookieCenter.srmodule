#!name=CookieCenter · 统一凭据捕获与签到中心
#!desc=一站式中心：整合「微信读书」与「中国电信」全系业务（周三会员日双抽奖、权益商城幸运抽奖、营业厅等级话费秒杀、山西领福利）。代码层抓取与执行彻底分离，支持进小程序即时全自动秒领与后台定时唤醒，数据存入 Loon 原生持久化（BoxJS 亦可可视化查看与修改）。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=签到, Cookie, 凭据捕获, 定时任务, 中国电信, 微信读书
#!version=4.0.0
#!date=2026-09-19 12:30
#!arguments=weread:,telecom:
#!arguments-desc=weread: 微信读书\n包含全量凭据捕获、每日签到、周二翻牌抽奖、周五限免好书入架\n\ntelecom: 中国电信\n包含5G会员进小程序自动秒领周三双抽奖/幸运抽奖、每日0点等级话费秒杀、月初山西福利监控

[Script]
# 1. 抓取层：专职凭据捕获 (无执行代码，捕获存入 Loon 持久化)
{{{{{weread}}}}}微信读书·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie_1.js

{{{{{weread}}}}}微信读书·登录请求 = type=http-request, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true

{{{{{weread}}}}}微信读书·登录响应 = type=http-response, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true

# 2. 执行层：后台定时任务调度 (纯执行单体，只读持久化，401 自动脱机换票更新)
{{{{{weread}}}}}微信读书·每日阅读奖励 = type=cron, cronexp=0 23 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_claim.js

{{{{{weread}}}}}微信读书·周二翻牌抽奖 = type=cron, cronexp=0 20 * * 2, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_flip.js

{{{{{weread}}}}}微信读书·每周限免入架 = type=cron, cronexp=0 10 * * 5, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_free.js

# [周三会员日与幸运抽奖] 微信小程序打开电信5G会员/权益商城，自动静默提取 SessionKey 与手机号
{{{{{telecom}}}}}电信·会员配置捕获 = type=http-request, pattern=(?i)^https?:\/\/cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_draw.js

{{{{{telecom}}}}}电信·小程序登录捕获 = type=http-response, pattern=(?i)^https?:\/\/mapi\.bestpay\.com\.cn\/mapi\/miniProgrameLoginEnc, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_draw.js, requires-body=true

{{{{{telecom}}}}}电信·MGS网关捕获 = type=http-request, pattern=(?i)^https?:\/\/spanner\.bestpay\.com\.cn:10081, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_draw.js

# [等级权益秒杀] 电信营业厅 App 签到/等级权益页凭据捕获与会话回填
{{{{{telecom}}}}}电信·等级权益凭证捕获 = type=http-request, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js

{{{{{telecom}}}}}电信·等级权益会话回填 = type=http-response, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js, requires-body=true

# [山西电信领福利] 活动凭据捕获
{{{{{telecom}}}}}电信·山西活动凭证捕获 = type=http-request, pattern=(?i)^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_benefit.js

# [周三会员抽奖] 每周三上午 09:00:00 自动执行周三双抽奖与幸运抽奖（进小程序亦可即时秒领）
{{{{{telecom}}}}}电信·周三会员抽奖 = type=cron, cronexp=0 9 * * 3, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_draw.js

# [等级话费秒杀] 每日 23:59:00 提前唤醒，23:59:59.750 毫秒级偷跑抢兑等级话费券
{{{{{telecom}}}}}电信·零点抢兑话费 = type=cron, cronexp=59 23 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js, timeout=90

# [山西福利监控] 每月 1~8 号定时放水探针监控
{{{{{telecom}}}}}电信·山西放水监控 = type=cron, cronexp=*/20 8-19 1-8 * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_benefit.js

[MITM]
hostname = %APPEND% weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn

