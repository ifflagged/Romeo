#!name=Pixiv 小说翻译
#!desc=在 Pixiv 小说阅读页注入翻译按钮，支持 Google 免费 / 微软翻译 / 百度翻译 / DeepSeek AI 翻译
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=Pixiv,小说,翻译,Google,微软,百度,DeepSeek,AI
#!version=2.2.0
#!date=2026-09-19 12:30
#!arguments=pixiv_novel_translate:#,translator:google,target:zh-CN,ms_key,baidu_appid,baidu_secret,deepseek_api_url:https://api.deepseek.com/v1/chat/completions,deepseek_api_key,deepseek_model:deepseek-v4-flash,google_proxy_url,google_proxy_token,chunk
#!arguments-desc=pixiv_novel_translate: 小说翻译\n在 Pixiv 小说阅读页注入翻译按钮\n可选值: 留空启用, # 禁用\n\ntranslator: 默认翻译源\ngoogle=Google免费 microsoft=微软翻译 baidu=百度翻译 deepseek=DeepSeek AI\n\ntarget: 目标语言\nzh-CN简体 zh-TW繁体 en英文 ja日文 ko韩文\n\nms_key: 微软翻译Key\nOcp-Apim-Subscription-Key（不填则面板中该翻译源标记为未配置）\n\nbaidu_appid: 百度AppID\n百度开放平台应用 ID（不填则面板中该翻译源标记为未配置）\n\nbaidu_secret: 百度密钥\n百度开放平台密钥（需与 AppID 同时填写）\n\ndeepseek_api_url: DeepSeek接口地址\n兼容 OpenAI 格式即可\n\ndeepseek_api_key: DeepSeek API Key\nDeepSeek 开放平台 API Key（不填则面板中该翻译源标记为未配置）\n\ndeepseek_model: DeepSeek模型\ndeepseek-v4-flash 快速便宜 deepseek-v4-pro 更强更贵\n\ngoogle_proxy_url: Google代理地址\nCloudflare Worker 地址（如 https://xxx.workers.dev，插件自动补全 /translate），不填则直连 Google\n\ngoogle_proxy_token: Google代理Token\nWorker 鉴权 Token（部署 Worker 时设置的 WORKER_TOKEN）\n\nchunk: 单批字符数\n越大每批能装越多内容、请求次数越少；越小越细粒度、边翻边显示更顺滑

[Script]
Google代理地址 = type=cron, cronexp="google_proxy_url = input,,tag=Google代理地址,desc=Cloudflare Worker 地址（如", script-path=https://xxx.workers.dev，插件自动补全 /translate），不填则直连 Google, timeout=120, wake-system=1

{{{pixiv_novel_translate}}}Pixiv 小说翻译-页面注入 = type=http-response, pattern=(?i)^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivNovelTranslate/TomCatXue_pixiv_novel_translate.js, requires-body=true, timeout=30, argument=translator="{{{translator}}}"&target="{{{target}}}"&chunk="{{{chunk}}}"&ms_key="{{{ms_key}}}"&baidu_appid="{{{baidu_appid}}}"&baidu_secret="{{{baidu_secret}}}"&deepseek_api_url="{{{deepseek_api_url}}}"&deepseek_api_key="{{{deepseek_api_key}}}"&deepseek_model="{{{deepseek_model}}}"&google_proxy_url="{{{google_proxy_url}}}"&google_proxy_token="{{{google_proxy_token}}}"

{{{pixiv_novel_translate}}}Pixiv 小说翻译-翻译中转 = type=http-request, pattern=(?i)^https:\/\/app-api\.pixiv\.net\/pxtrans, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/PixivNovelTranslate/TomCatXue_pixiv_novel_translate.js, requires-body=true, timeout=120, argument=translator="{{{translator}}}"&target="{{{target}}}"&chunk="{{{chunk}}}"&ms_key="{{{ms_key}}}"&baidu_appid="{{{baidu_appid}}}"&baidu_secret="{{{baidu_secret}}}"&deepseek_api_url="{{{deepseek_api_url}}}"&deepseek_api_key="{{{deepseek_api_key}}}"&deepseek_model="{{{deepseek_model}}}"&google_proxy_url="{{{google_proxy_url}}}"&google_proxy_token="{{{google_proxy_token}}}"

[MITM]
hostname = %APPEND% app-api.pixiv.net

