#!name=呆呆面板
#!desc=捕获微信读书、中国移动、扫描全能王和中国电信凭据并同步。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=签到, Cookie, 凭据捕获, 呆呆面板, Dumb-Panel
#!version=1.0.6
#!date=2026-10-24 14:43
#!arguments=weread:"",cmcc_mark:"",camscanner:"",telecom:"",daidai_url:"",daidai_key:"",daidai_secret:""
#!arguments-desc=weread: 微信读书\n打开微信读书 App 进「我」或「翻牌/限免」自动触发抓取并就地同步至呆呆面板 WEREAD_AUTH\n可选值: 留空启用, # 禁用\n\ncmcc_mark: 中国移动\n在中国移动 App 打开「每日签到」活动页触发，自动抓取长期 app_token 并就地同步至呆呆面板 CMCC_AUTH\n可选值: 留空启用, # 禁用\n\ncamscanner: 扫描全能王\n打开扫描全能王 App 进个人中心触发静默抓取并就地同步至呆呆面板 camscanner_data\n可选值: 留空启用, # 禁用\n\ntelecom: 中国电信\n打开电信营业厅或小程序，自动捕获 5G会员 SessionKey、等级权益 sign 与活动福利凭据\n可选值: 留空启用, # 禁用\n\ndaidai_url: 呆呆面板地址(可选)\n例如 http://192.168.1.10:5700，若在 BoxJS 已配置则此项留空\n\ndaidai_key: 呆呆面板AppKey(可选)\n填入 Open API App Key，若在 BoxJS 已配置则此项留空\n\ndaidai_secret: 呆呆面板AppSecret(可选)\n填入 Open API App Secret，若在 BoxJS 已配置则此项留空

[Script]
{{{weread}}}微信读书·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify|login), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_weread_cookie.js, requires-body=true

{{{weread}}}微信读书·登录回填 = type=http-response, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_weread_cookie.js, requires-body=true

{{{cmcc_mark}}}中国移动·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(wx\.10086\.cn\/(qwhdsso\/appTokenLogin|qwhdhub\/api\/mark\/)|dev\.coc\.10086\.cn\/(coc3\/|gr\/login\/)|sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_cmcc_cookie.js, requires-body=true

{{{cmcc_mark}}}中国移动·会话回填 = type=http-response, pattern=(?i)^https?:\/\/(wx\.10086\.cn\/qwhdhub\/(qwhdmark|qwhdsso)\/|sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/(tokenLogin\/login|qinCoin\/)), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_cmcc_cookie.js, requires-body=true

{{{cmcc_mark}}}中国移动·云盘leadeon token注入 = type=http-response, pattern=(?i)^https?:\/\/(?:mrp\.mcloud\.139\.com|m\.mcloud\.139\.com|caiyun\.feixin\.10086\.cn|vip\.caiyun\.feixin\.10086\.cn)\/portal\/, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/leadeon_idmp_capture.js?v=2026102301, requires-body=true, timeout=10

{{{cmcc_mark}}}中国移动·云盘leadeon token回传捕获 = type=http-request, pattern=(?i)^https?:\/\/sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/__idmp_capture, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_cmcc_cookie.js, requires-body=true

{{{camscanner}}}扫描全能王·凭据捕获 = type=http-request, pattern=(?i)^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_camscanner.cookie.js

{{{telecom}}}中国电信·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json|mapi-h5\.bestpay\.com\.cn\/gapi\/handyservice\/miniprogram\/checkParam|spanner\.bestpay\.com\.cn:10081|(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)|wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_telecom_cookie.js, requires-body=true

{{{telecom}}}中国电信·会话回填 = type=http-response, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_telecom_cookie.js, requires-body=true

[MITM]
hostname = %APPEND% weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn, api-cs.intsig.net, wx.10086.cn, qwhdcdn.cmcc-cs.cn, dev.coc.10086.cn, sn.clientaccess.10086.cn, mrp.mcloud.139.com, m.mcloud.139.com, caiyun.feixin.10086.cn, vip.caiyun.feixin.10086.cn

