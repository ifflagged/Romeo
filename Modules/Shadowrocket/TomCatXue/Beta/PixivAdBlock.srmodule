#!name=Pixiv去广告
#!desc=去除Pixiv应用内广告，小说推荐页广告过滤，并解锁高级会员属性。
#!author=chaoscard (原作) / TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!openUrl=https://apps.apple.com/app/id337248563
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=Pixiv,去广告,会员解锁
#!version=1.0.1
#!date=2026-11-01 13:10

[Rule]
DOMAIN-SUFFIX,ads-pixiv.net,REJECT
DOMAIN,pixiv.org,REJECT
DOMAIN,i.pixiv.re,PROXY

[Body Rewrite]
http-response-jq (?i)^https:\/\/oauth\.secure\.pixiv\.net\/auth\/token 'if ((getpath(["response","user"]) // {}) | has("is_premium")) then (setpath(["response","user","is_premium"]; true)) else . end'
http-response-jq (?i)^https:\/\/oauth\.secure\.pixiv\.net\/auth\/token 'if ((getpath(["user"]) // {}) | has("is_premium")) then (setpath(["user","is_premium"]; true)) else . end'

[MITM]
hostname = %APPEND% oauth.secure.pixiv.net

