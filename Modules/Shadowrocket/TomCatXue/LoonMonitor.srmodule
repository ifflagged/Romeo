#!name=LoonMonitor · 小组件数据提供与状态服务
#!desc=专为 iOS 哑巴面板 (MutePanel) 小组件打造的 Loon 本地监控数据服务。实时提供当前策略组、活跃节点、VPN 出口 IP/归属地、延迟、运行模式与订阅流量统计。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=Loon, 监控, 小组件, VPN
#!version=1.2.0
#!date=2026-10-12 15:30

[Rule]
DOMAIN,loon.box,DIRECT
DOMAIN,api.loon.box,DIRECT

[Host]
loon.box = 127.0.0.1
api.loon.box = 127.0.0.1

[Script]
# 1. 本地虚拟 API 请求拦截响应 (标准 http-request 语法，短路 Mock 返回 HTTP 200 JSON)
Loon监控·小组件数据服务 = type=http-request, pattern=^https?:\/\/(api\.)?loon\.box\/api\/monitor, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/cdn_loon_monitor.js, timeout=10

# 2. 订阅更新流量静默捕获 (当 Loon 刷新机场订阅时，自动捕获并持久化剩余流量配额)
Loon监控·订阅流量捕获 = type=http-response, pattern=/subscription|subscribe|token=/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/cdn_loon_monitor.js

[MITM]
hostname = %APPEND% loon.box, api.loon.box

