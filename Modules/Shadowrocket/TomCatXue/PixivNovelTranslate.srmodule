[Script]
# Google Worker 代理（可选）：填了 Google 翻译走 Worker 代理，不直连 Google；缓解设备 IP 被 429
Google代理地址 = type=cron, cronexp="google_proxy_url = input,,tag=Google代理地址,desc=Cloudflare Worker 地址（如", script-path=https://xxx.workers.dev，插件自动补全 /translate），不填则直连 Google, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% app-api.pixiv.net

