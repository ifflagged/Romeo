#!name=UmetripAds
#!desc=UmetripAds
#!icon=icon not found
#!category=Jacob

[Script]
umetrip.ads = type=http-response, pattern=^https:\/\/(?:sns|appmsg|umehome|opactivity|activity|umerp|umeflightstatus|umestartup)\.umetrip\.com\/gateway\/api\/umetrip\/native$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/UmetripAds/ddgksf2013.top_umetrip.ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% sns.umetrip.com, appmsg.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, umeflightstatus.umetrip.com, umestartup.umetrip.com, oss.umetrip.com

