#!name=BiliBiliAds
#!desc=BiliBiliAds
#!icon=icon not found
#!category=ddgksf2013

[URL Rewrite]
^https?:\/\/bilibili.2025.04.02/c136 - reject-200
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report - reject-dict
^https://api.bilibili.com/pgc/season/player/cards - reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards - reject-dict
^https://app.bilibili.com/x/v2/splash/show - reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash|GetActivityTab) - reject-dict
^https?:\/\/app\.bilibili\.com\/x\/v\d\/search\/defaultwords - reject-dict
^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default - reject-200

[Script]
bilibili.ads = type=http-response, pattern=^https?:\/\/api\.bili(api|bili)\.(net|com)\/pgc\/season\/app\/related\/recommend\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

bilibili.ads = type=http-response, pattern=^https://app.bilibili.com/x/v2/search/square, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js, requires-body=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo)$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% -broadcast.chat.bilibili.com, -cm.bilibili.com, -*cdn*.biliapi.net, -*tracker*.biliapi.net, app.bilibili.com, api.live.bilibili.com, *.bilibili.com, *.bili*.*, *.bilibili.*, grpc.biliapi.net, *biliapi.net

