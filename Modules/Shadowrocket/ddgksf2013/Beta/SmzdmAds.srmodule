#!name=SmzdmAds
#!desc=SmzdmAds
#!icon=icon not found
#!category=ddgksf2013

[URL Rewrite]
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul - reject-200
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul - reject-200
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul - reject-200

[Script]
smzdm_json = type=http-response, pattern=^https?:\/\/s-api.smzdm\.com\/sou\/search_default_keyword, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/app-api\.smzdm\.com\/util\/loading, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/.*zdmimg\.com\/cpm\/api\/v\d\/advert_distribution\/get_all_advertise, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/homepage-api\.smzdm\.com\/v3\/home, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/haojia-api\.smzdm\.com\/home\/list, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/article_releated_modul, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/baike-api\.smzdm\.com\/home_v3\/list, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/s-api\.smzdm\.com\/sou\/list_v10, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

smzdm_json = type=http-response, pattern=^https?:\/\/zhiyou\.m\.smzdm\.com\/user\/vip\/ajax_get_banner, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% app-api.smzdm.com, *.zdmimg.com, homepage-api.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, baike-api.smzdm.com, s-api.smzdm.com, zhiyou.m.smzdm.com

