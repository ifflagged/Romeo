#!name= iRingo: 🌤 WeatherKit
#!desc=iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据
#!author=VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!icon=icon not found
#!category=Jacob
#!openUrl=http://boxjs.com/#/app/iRingo.WeatherKit
#!homepage=https://NSRingo.github.io/guide/Weather/weather-kit
#!date=2026-08-17 12:04:29
#!version=3.3.0

[Rule]
#[filter_local]
DOMAIN,weather-analytics-events.apple.com,REJECT
DOMAIN-SUFFIX,tthr.apple.com,REJECT
DOMAIN,tether.edge.apple,REJECT

[Script]
# 🌤 WeatherKit.api.v1.availability.response
response.bundle = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/iRingo.WeatherKit/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🌤 WeatherKit.api.v1.airQualityScale.request
request.bundle = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/iRingo.WeatherKit/NSRingo_request.bundle.js, timeout=60

# 🌤 WeatherKit.api.v1.weatherAlerts.response
request.bundle = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/iRingo.WeatherKit/NSRingo_request.bundle.js, timeout=60

request.bundle = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/iRingo.WeatherKit/NSRingo_request.bundle.js, timeout=60

# 🌤 WeatherKit.api.v2.weather.response
response.bundle = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/iRingo.WeatherKit/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% weatherkit.apple.com

