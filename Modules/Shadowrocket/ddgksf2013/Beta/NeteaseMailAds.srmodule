#!name=NeteaseMailAds
#!desc=NeteaseMailAds
#!icon=icon not found
#!category=ddgksf2013

[URL Rewrite]
^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mmad\/master\/get\.do - reject-200
^https?:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/getRegConfig\.do - reject-dict
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do - reject-dict

[Body Rewrite]
http-response-jq ^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/.*conf\.do '.data |= del(.masterLoginGuideList, .masterOperatorList, .functionOperatorInfoList, .memberOperator, .activityTabInfoList, .extList)'
http-response-jq ^https?:\/\/mail\.163\.com\/fgw\/mailsrv-webrobot\/.*user\/info '.result |= del(.assistantInfo, .quotaData)'

[MITM]
hostname = %APPEND% dashi.163.com, appconf.mail.163.com, mail.163.com

