#!name=bdpan
#!desc=bdpan
#!icon=icon not found
#!category=ddgksf2013

[URL Rewrite]
^https?:\/\/pan\.baidu\.com\/api\/getconfig - reject-dict
^https?:\/\/.*baidu\.com\/rest\/.*\/membership\/(proxy\/)?guide - reject-200
^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list - reject-200
^https?:\/\/pan\.baidu\.com\/rest\/.*\/pcs\/ad - reject-200
^https?:\/\/pan\.baidu\.com\/act\/api\/activityentry - reject-200
^https:\/\/pan\.baidu\.com\/feed\/hotlist - reject-200
^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk - reject-200
^https?:\/\/pan\.baidu\.com\/api\/getsyscfg - reject-dict
^https:\/\/pan\.baidu\.com\/queryintent\/queryhint - reject-200
^https:\/\/pan\.baidu\.com\/coins\/center\/notice - reject-200
^https:\/\/pan\.baidu\.com\/recommend\/shortseries\/list - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist '.result.list=[]'

[Script]
bdpan.ads = type=http-response, pattern=^https?:\/\/afd\.baidu\.com\/afd\/entry, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js, requires-body=true, max-size=-1, timeout=60

bdpan.ads = type=http-response, pattern=^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?method=gamecenter, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js, requires-body=true, max-size=-1, timeout=60

bdpan.ads = type=http-response, pattern=^https:\/\/pan\.baidu\.com\/feed\/cardinfos, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% pan.baidu.com, afd.baidu.com

