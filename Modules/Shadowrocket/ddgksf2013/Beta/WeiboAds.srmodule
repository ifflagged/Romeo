#!name=WeiboAds
#!desc=WeiboAds
#!icon=icon not found
#!category=ddgksf2013

[Rule]
DOMAIN,sdkapp.uve.weibo.com,DIRECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN-SUFFIX,api.touch-moblie.com,REJECT

[URL Rewrite]
^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_positive - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/push\/info - reject-200
^https?:\/\/api\.weibo\.cn\/.*account\/recommend_interesttags - reject-dict
^https?:\/\/api\.weibo\.cn\/.*\/media_homelist - reject-200
^https?:\/\/api\.weibo\.cn\/.*finder\/searchbarchange - reject-200
^https?:\/\/api\.weibo\.cn\/\d\/ad\/preload - reject-dict
^https?:\/\/api\.weibo\.cn\/\d\/profile\/recommend_popuser - reject-dict
^https?:\/\/boot.*weibo\.com\/v\d\/ad\/realtime - reject-200
^https?:\/\/api\.weibo\.cn\/.*discovery_home_bottom_getdotinfo - reject-dict
^https?:\/\/m?api\.weibo\.c(n|om)\/\d/push/daily - reject-dict
^https?:\/\/(preload-click|preload-impression)\.uve\.weibo\.com\/(interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua) - reject
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php - reject
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/hot\/hours_spotlight - reject-dict
^https?:\/\/api\.weibo\.cn\/\d\/cardlist\?v_f=.*Weibo_intl - reject-dict
^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users - reject-dict
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/ad\/weibointl\? - reject-dict

[Body Rewrite]
http-response-jq ^https?:\/\/api\.weibo\.cn\/\d\/ug\/checkin\/stream '.items |= map(select(.category != "card"))'

[Script]
weibo_json = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_detail, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/groups\/allgroups\/v\d, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/boot.*weibo\.com\/v\d\/ad\/preload, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/\w{5}\/(statuses_unread_hot_timeline|timeline), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/\d\/video\/tiny_stream_mid_detail, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/\w{5}\/cardlist, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https://api.weibo.cn/2/!/client/light_skin, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https://new.vip.weibo.cn/littleskin/preview, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(searchall|page\?|0flowpage), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(unread_)?friends(/|_)timeline, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/groups/timeline, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(container_timeline|unread_hot_timeline|extend|video_mixtimeline|unread_topic_timeline), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/profile/(me|container_timeline), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/video/(community_tab|remind_info|tiny_stream_video_list), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/search/(finder|container_timeline|container_discover), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(checkin/show|\!/live/media_homelist|container/get_item), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/cardlist, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=open_app, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_search_info = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=get_searching_info, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_search_info.json, requires-body=true, max-size=-1, timeout=60

weibo_search_topic = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*feed&a=search_topic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_search_topic.json, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*get_coopen_ads, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?://(sdk|wb)app\.uve\.weibo\.com(/interface/sdk/sdkad.php|/wbapplua/wbpullad.lua), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=trends, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=user_center, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

weibo_json = type=http-response, pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=search_topic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeiboAds/ddgksf2013_weibo_json.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.weibo.*, *.api.weibo.*, mapi.weibo.*, *.uve.weibo.com, new.vip.weibo.cn, boot.biz.weibo.com

