[Rewrite]
request if ${url} ~= /^https:\/\/jz\.wacaijizhang\.com\/api\/banners\/ribbon\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/jz\.wacaijizhang\.com\/api\/banners\/list\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/jz\.wacaijizhang\.com\/api\/resource\/universal\/fetch$/i then reject_dict(200)

[MitM]
hostname=jz.wacaijizhang.com