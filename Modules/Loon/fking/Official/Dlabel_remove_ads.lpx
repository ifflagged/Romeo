[Rewrite]
request if ${url} ~= /^https:\/\/dlabel\.ctaiot\.com\/api\/spreadstart\/list\.json\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/dlabel\.ctaiot\.com\/api\/spread\/journey\/select\.json\?/i then reject_dict(200)

[MitM]
hostname=dlabel.ctaiot.com