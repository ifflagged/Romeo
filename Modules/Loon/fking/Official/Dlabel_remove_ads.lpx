#!name=Dlabel云标签去广告
#!desc=移除开屏广告及首页横幅。
#!openUrl=https://apps.apple.com/app/id1397719437
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Dlabel.png
