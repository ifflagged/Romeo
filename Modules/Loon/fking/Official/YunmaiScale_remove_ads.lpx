[Rewrite]
request if ${url} ~= /^https:\/\/yunmai\.sfo-tx-beijing-02\.saas\.sensorsdata\.cn\/api\/v2\/sfo\/user_popup_configs\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/apisvr\.iyunmai\.com\/api\/ios\/apps\/get-online-parameter-list\.json\?/i then response.json.jq(".data.rows |= map(select(.name | IN(\"AC_startTime\",\"AC_endTime\",\"AC_enable\",\"AC_url\",\"AC_challenge_tip\",\"AC_challenge_tip_id\",\"AC_pt_tip\",\"AC_pt_tip_id\",\"AC_pt_go_tmall_jd\",\"month7_activity\",\"AC_xmas_isOpen\",\"home_show_info\",\"new_user_credit_exchange_info\",\"AC_share_recommendUrl\",\"AC_share_recommendUrl_2\",\"AC_share_recommendUrl_3\") | not))")

request if ${url} ~= /^https:\/\/restapi\.iyunmai\.com\/ad-api\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/apisvr\.iyunmai\.com\/api\/ios\/first-page-module\/center_menu\.json\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/restapi\.iyunmai\.com\/api\/ios\/ad\//i then reject_dict(200)

[MitM]
hostname=yunmai.sfo-tx-beijing-02.saas.sensorsdata.cn, apisvr.iyunmai.com, restapi.iyunmai.com