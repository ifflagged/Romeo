#!name=掌阅去广告
#!desc=移除开屏广告、悬浮广告、弹窗广告、朗读音色广告及我的页面广告，移除各页面的横幅轮播图。
#!openUrl=https://apps.apple.com/app/id463150061
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReader.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, saad.ms.zhangyue.net, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zyapi\/bookstore\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/bookstore\/ad\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zybook4\/iphone\/u\/p\/api\.php\?/i then response.json.delete("Splash")

request if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zybk\/api\/pop\/index\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/bookstore\/read\/visual\/channel\/list\?/i then response.json.jq(".body.list |= map(select(.id | contains(\"ad_\") | not))")

request if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zyapi\/bookstore\/user\/mytab\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zyboot\/activity\/mytab\?/i then reject_dict(200)

request if ${url} ~= /https:\/\/(webboot\.zhangyue\.com|ih2\.ireader\.com)\/zyam\/app\/app\.php\?/i then reject_dict(200)

[MitM]
hostname=webboot.zhangyue.com, ih2.ireader.com