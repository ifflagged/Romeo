#!name=CC直播去广告
#!desc=移除信息流推广和横幅，精简顶部标签。
#!openUrl=https://apps.apple.com/app/id853008299
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CCLive.png
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/api\.cc\.163\.com\/v\d\/mgamenavigation\/navigation_list\?/i then response.json.jq(".data.info_list |= map(select(.name == \"关注\" or .name == \"推荐\" or .name == \"视频\" or .name == \"全部\"))")

response if ${url} ~= /^https:\/\/api\.cc\.163\.com\/v\d\/mgamerecpage\/recommend_page\?/i then response.json.jq(".data.plugins|=map(select(.module_type!=\"banner\"))|.data.plugins|=map(select(.module_type!=\"show_list\"))|.data.plugins|=map(select(.title!=\"推荐品类\"))")

response if ${url} ~= /^https:\/\/api\.cc\.163\.com\/v\d\/entpage\/live_navbar_mobile\/ios\?/i then response.json.jq(".data.top_nav |= map(select(.cn_name == \"推荐\" or .cn_name == \"星秀\" or .cn_name == \"心动交友\"))")

request if ${url} ~= /^https:\/\/cc\.163\.com\/act\/m\/daily\/ad_/i then reject(404)
request if ${url} ~= /^http:\/\/mshare\.cc\.163\.com\/mshare\/startadv_mobile_v\d\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/appapi\.cc\.163\.com\/v\d\/mixfloatingwindow\/floating_windows\?/i then reject_dict(200)

request if ${url} ~= /^http:\/\/api\.cc\.163\.com\/v1\/mpopuprecommend\/exit_room_conf$/i then reject_dict(200)

[MitM]
hostname=api.cc.163.com, cc.163.com, mshare.cc.163.com, appapi.cc.163.com