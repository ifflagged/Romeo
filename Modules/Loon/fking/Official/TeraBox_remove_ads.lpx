#!name=TeraBox去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告及横幅广告。
#!openUrl=https://apps.apple.com/app/id1509453185
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TeraBox.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, ymg-api.terabox.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/www\.terabox\.com\/adx\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.terabox\.com\/api\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/www\.terabox\.com\/api\/page\/tips\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/www\.terabox\.com\/rest\/1\.0\/task\/common\/inttips\?/i then reject_dict(200)

[MitM]
hostname=www.terabox.com