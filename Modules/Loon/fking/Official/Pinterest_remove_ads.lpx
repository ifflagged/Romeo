#!name=Pinterest去广告
#!desc=移除瀑布流、更多探索内容中的广告
#!openUrl=https://apps.apple.com/app/id429047995
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Pinterest.png
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/api\.pinterest\.com\/v\d\/feeds\/home\/\?/i then response.json.jq(".data |= map(select(.is_promoted == false or .is_promoted == \"false\"))")

response if ${url} ~= /^https:\/\/api\.pinterest\.com\/v\d\/pins\/\d+\/related\/modules\/\?/i then response.json.jq(".data |= map(select(.is_promoted == false or .is_promoted == \"false\"))")

[MitM]
hostname=api.pinterest.com