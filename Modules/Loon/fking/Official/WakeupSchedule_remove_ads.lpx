[Rewrite]
request if ${url} ~= /^https:\/\/api\.wakeup\.fun\/wakeup\/app\/bannerconf$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.wakeup\.fun\/wakeup\/user\/mine$/i then response.json.delete("data.bannerItems")

[MitM]
hostname=api.wakeup.fun