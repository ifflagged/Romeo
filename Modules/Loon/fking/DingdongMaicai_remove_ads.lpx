#!name=叮咚买菜去广告
#!desc=移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。
#!openUrl=https://apps.apple.com/app/id768082524
#!author=zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], wish
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, trackercollect.ddxq.mobi, REJECT
DOMAIN, ddfs-public.ddimg.mobi, REJECT
DOMAIN, rttrack.ddxq.mobi, REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/119\.29\.29\.\d+\/d/i then reject(200)

request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\//i then reject(404)

request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop/i then reject(404)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rollHotKeyword\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rankingList\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/search\/hotKeyword\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v1\/user\/queryMyPage\/\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\?/i then response.json.delete("data.ad_info")

response if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig\?/i then response.json.delete("data.ai_enter_config")

request if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/userLike\/flowData$/i then reject_dict(200)

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\?/i then response.json.delete(["data.top_advert_data", "data.suspension"])

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\?/i then response.json.jq(".data.list |= map(select(has(\"capsule_freedom_zone\") | not))")

response if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/productApi\/productDetail\/info\?/i then response.json.delete("data.detail.chatEntry")

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/bottomNavi/i then response.json.jq("del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != \"eatwhat\")) else . end")

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail/i then response.json.jq("walk(if type == \"object\" and has(\"list\") then .list |= map(if type == \"object\" and has(\"multi_advertise_data_list\") then del(.multi_advertise_data_list) else . end) else . end)")

[MitM]
hostname= 119.29.29.*, maicai.api.ddxq.mobi, user.api.ddxq.mobi