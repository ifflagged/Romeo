[Rewrite]
response if ${url} ~= /^https?:\/\/m\.pvp\.xoyo\.com\/conf\/server-mapping$/i then response.json.delete(["data.splashConf", "data.splashConfNew"])

[MitM]
hostname=m.pvp.xoyo.com