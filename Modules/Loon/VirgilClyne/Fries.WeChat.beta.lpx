[Script]
response if ${url} ~= /^https?:\/\/weixin110\.qq\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi(\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.WeChat.beta/VirgilClyne_WeChat.response.beta.js") with tag="WeChat.mmspamsupport.response", requires_body=true

[MITM]
hostname = szsupport.weixin.qq.com, weixin110.qq.com

