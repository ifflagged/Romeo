#!name=🍟 Fries: ♪ TikTok
#!desc=TikTok解锁与增强
#!author=VirgilClyne
#!icon=icon not found
#!tag=VirgilClyne
#!openUrl=http://boxjs.com/#/app/GetSomeFries.TikTok
#!homepage=https://github.com/VirgilClyne/GetSomeFries/wiki/TikTok
#!manual=https://github.com/VirgilClyne/GetSomeFries/wiki/TikTok

[Argument]
CountryCode=input,"TW",tag=国家或地区代码, desc=国家或地区代码
Carrier=input,"中華電信",tag=网络运营商, desc=网络运营商

[Script]
request if ${url} ~= /^https?:\/\/tnc(.+)\.tiktokv\.com\/get_domains\/v\d\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.TikTok/VirgilClyne_TikTok.request.js") with tag="Fries.TikTok.tnc.get_domains.request"

response if ${url} ~= /^https?:\/\/tnc(.+)\.tiktokv\.com\/get_domains\/v\d\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.TikTok/VirgilClyne_TikTok.response.js") with tag="Fries.TikTok.tnc.get_domains.response", requires_body=true

request if ${url} ~= /^https?:\/\/api(.+)\.tiktokv\.com\/(aweme|tiktok)\/v\d\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.TikTok/VirgilClyne_TikTok.request.js", {${CountryCode}, ${Carrier}}) with tag="Fries.TikTok.api.request"

response if ${url} ~= /^https?:\/\/api(.+)\.tiktokv\.com\/(aweme|tiktok)\/v\d\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.TikTok/VirgilClyne_TikTok.response.js") with tag="Fries.TikTok.api.response", requires_body=true

[MITM]
hostname = *.tiktokv.com

