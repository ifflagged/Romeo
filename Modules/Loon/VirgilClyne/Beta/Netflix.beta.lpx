#!name=🍟 Fries: Netflix
#!desc=(BETA) Netflix Mod
#!author=VirgilClyne
#!icon=icon not found
#!tag=VirgilClyne
#!openUrl=http://boxjs.com/#/app/GetSomeFries.Netflix.beta
#!homepage=https://github.com/VirgilClyne/GetSomeFries/wiki/🍟-Netflix

[Script]
response if ${url} ~= /^https?:\/\/www\.netflix\.com\/(api\/ftl\/probe)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Netflix.beta/VirgilClyne_Netflix.beta.js") with tag="🍟 Netflix Web", requires_body=true

response if ${url} ~= /^https?:\/\/(ios|ios-anycast|ios-prefix)\.prod\.(ftl|cloud|http1)\.netflix\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Netflix.beta/VirgilClyne_Netflix.beta.js") with tag="🍟 Netflix iOS", requires_body=true

response if ${url} ~= /^https?:\/\/(android|android-anycast|android-prefix)\.prod\.(ftl|cloud)\.netflix\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Netflix.beta/VirgilClyne_Netflix.beta.js") with tag="🍟 Netflix Android", requires_body=true

response if ${url} ~= /^https?:\/\/(cast|cast-uiboot|android-prefix)\.prod\.(http1)\.netflix\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Netflix.beta/VirgilClyne_Netflix.beta.js") with tag="🍟 Netflix Chromecast", requires_body=true

[MITM]
hostname = www.netflix.com, *.prod.ftl.netflix.com, *.prod.cloud.netflix.com

