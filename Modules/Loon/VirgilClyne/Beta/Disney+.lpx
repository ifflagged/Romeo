[Script]
response if ${url} ~= /^https?:\/\/disney\.api\.edge\.bamgrid\.com\/(session|(graph\/)?v1\/(public|device)\/graphql)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Disney+/VirgilClyne_Disney_2B.js") with tag="🍟 Disney+ Response", requires_body=true

request if ${url} ~= /^https?:\/\/disney\.content\.edge\.bamgrid\.com\/svc/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Disney+/VirgilClyne_Disney_2B.js") with tag="🍟 Disney+ Request"

[MITM]
hostname = disney.api.edge.bamgrid.com, disney.content.edge.bamgrid.com

