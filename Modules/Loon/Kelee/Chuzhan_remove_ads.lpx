#!name=触站去广告
#!desc=移除开屏广告、弹窗广告、各页面横幅推广，移除首页悬浮挂件。
#!openUrl=https://apps.apple.com/app/id1503129125
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chuzhan.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/index\/ad\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/common\/config$/i then response.json.replace(["data.disableAd", "data.showTopFloatAdvanceTips"], [true, false])
response if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/common\/config$/i then response.json.delete(["data.adsConfigIOS", "data.adsConfigAndroid", "data.url.tabMarket"])

response if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/common\/layouts$/i then response.json.jq(".data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}")

response if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/common\/themeConfig$/i then response.json.jq(".data.tabbars |= map(select(.title != \"商城\"))")

request if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/works\/relative$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/index\/follow\/all_random\/list$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/app\.huashi6\.com\/app\/index\/csyxh\/icon$/i then reject_dict(200)

[MitM]
hostname=app.huashi6.com