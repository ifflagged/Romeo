[Rewrite]
request if ${url} ~= /^https:\/\/api\.chips-cloud\.com\/v\d\/home\/collection\/smartv\d\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.chips-cloud\.com\/v\d\/communityManage\/list\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.chips-cloud\.com\/v\d\/good\/list\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/shop171777386\.m\.youzan\.com\/v2\/showcase\/homepage\?/i then reject(404)

[MitM]
hostname=api.chips-cloud.com, shop171777386.m.youzan.com