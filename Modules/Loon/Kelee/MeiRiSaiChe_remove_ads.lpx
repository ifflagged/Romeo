#!name=每日赛车去广告
#!desc=移除开屏广告、信息流广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Jacob
#!openUrl=https://apps.apple.com/app/id1590997618
#!tag=去广告
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-07-02 20:41:31

[Rewrite]
^https:\/\/api\.romielf\.com\/index\/indexv\d\? response-body-json-replace data.advertisement [] data.listadvertising []
^https:\/\/api\.romielf\.com\/index\/indexv\d\? response-body-json-jq '.data.list |= map(select(.type == 1))'

[MITM]
hostname = api.romielf.com

