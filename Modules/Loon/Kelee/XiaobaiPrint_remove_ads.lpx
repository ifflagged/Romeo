#!name=小白智慧打印去广告
#!desc=移除开屏广告、首页推广金刚位、热门内容推荐、横幅广告、搜索填充词、搜索发现，精简我的页面。账户页面错误是已知问题，无需反馈。
#!openUrl=https://apps.apple.com/app/id1505946846
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaobaiPrint.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, ad.lovefree.cc, REJECT
DOMAIN-SUFFIX, adwanji.com, REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/epbox\.gongfudou\.com\/graphql$/i then response.json.delete(["data.mallConsumables", "data.currentUser.goodsCoupons"])

response if ${url} ~= /^https:\/\/epbox\.gongfudou\.com\/graphql$/i then response.json.jq("if .data.systemConfig.searchHotTags? then del(.data.systemConfig) else . end")

response if ${url} ~= /^https:\/\/epbox\.gongfudou\.com\/graphql$/i then response.json.jq("if (.data.page.__typename==\"Page\" and .data.page.name==\"场景化改版 2024\") then .data.page.firstTabDetail.floors|=map(select(.numType==\"row\")) else . end")

request if ${url} ~= /^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/banners\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/canvas\/query_actions\?/i then reject_dict(200)

[MitM]
hostname=epbox.gongfudou.com, epbox.gongfudou.com