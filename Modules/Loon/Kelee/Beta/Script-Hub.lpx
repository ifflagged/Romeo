#!name=Script-Hub
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], CKYB[https://github.com/CKYB], 小白脸
#!icon=icon not found
#!tag=Kelee
#!openUrl=http://127.0.0.1:9101/
#!tag=资源转换
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49
#!select=ScriptHub通知,开启通知,关闭通知,跟随链接
#!input=Parser_body_max
#!input=Parser_http_timeout

[Rule]
DOMAIN,scripthub.vercel.app,PROXY

[Script]
request if ${url} ~= /^https?:\/\/script\.hub\/($|edit\/|reload)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Script-Hub/Script-Hub-Org_script-hub.js") with tag="前端界面", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Script-Hub/Script-Hub-Org_Rewrite-Parser.js") with tag="Rewrite转换", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Script-Hub/Script-Hub-Org_rule-parser.js") with tag="Rule转换", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/convert\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Script-Hub/Script-Hub-Org_script-converter.js") with tag="JavaScript转换", timeout=300

[MITM]
hostname = script.hub, *.script.hub

