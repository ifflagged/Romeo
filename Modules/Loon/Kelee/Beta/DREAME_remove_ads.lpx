#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/cn\.iot\.dreame\.tech:\d+\/dreame-product\/public\/advertisement\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-mall\.dreame\.tech\/dreame-mall\/api\/v1\/tag\/list$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-wxmall\.dreame\.tech\/main\/goods\/get-topgoods$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/cn\.iot\.dreame\.tech:\d+\/dreame-product\/public\/common-plugin$/i then response.body.mock("json", "{\"code\":0,\"success\":true,\"data\":{\"version\":1144,\"appVer\":20,\"url\":\"https://kelee.one/Resource/Zip/DREAME/d6996fee95380affdf740ee44a85fbe9___UNI__EDB922E.zip\",\"md5\":\"e0cc9cb77d9e0cf275e41e73dba3f988\",\"validDate\":\"\",\"changeLog\":\"\",\"status\":\"\"},\"msg\":\"操作成功\"}", 200)
response if ${url} ~= /^https:\/\/cn\.iot\.dreame\.tech:13267\/dreame-system\/dreame-app\/setting\/query$/i then response.json.delete("data.appIconConfig")

[MITM]
hostname = cn-mall.dreame.tech, cn-wxmall.dreame.tech, cn.iot.dreame.tech

