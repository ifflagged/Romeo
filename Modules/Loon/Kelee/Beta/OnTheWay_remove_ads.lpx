#!name=行者户外去广告
#!desc=移除弹窗广告、发现页面横幅推广的推广金刚位，移除我的页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id779325629
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/www\.imxingzhe\.com\/api\/v1\/pop\/window\/\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/www\.imxingzhe\.com\/api\/v4\/account\/get_user_info\?/i then response.json.delete("banner")
response if ${url} ~= /^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\?/i then response.json.delete(["banners", "ad"])
response if ${url} ~= /^https:\/\/www\.imxingzhe\.com\/api\/v4\/discovery\/ios\/\?/i then response.json.jq(".display_areas |= map(select(.name == \"赛事\" or .name == \"行者帮\" or .name == \"头条\" or .name == \"排行榜\" or .name == \"约伴\"))")

[MITM]
hostname = www.imxingzhe.com

