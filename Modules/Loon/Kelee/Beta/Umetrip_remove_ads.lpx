[Rule]
URL-REGEX,"^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native",REJECT

[Script]
response if ${url} ~= /^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Umetrip_remove_ads/kelee_Umetrip_remove_ads.js") with tag="移除首页广告"

[MITM]
hostname = 114.115.217.129, home.umetrip.com

