[General]
real-ip = *-update.xoyocdn.com, xg-flow.xoyo.com

[Rewrite]
request if ${url} ~= /^https:\/\/jx3comm\.xoyocdn\.com\/jx3gc\/zhcn\/login_ad\/WebCareer\/WebCareerTab\.txt/i then reject(404)

[MITM]
hostname = jx3comm.xoyocdn.com

