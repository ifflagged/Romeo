#!name=华尔街见闻去广告
#!desc=移除开屏广告、文末广告、信息流广告，精简底栏。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id738227477
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/advertising\//i then reject_dict(200)
response if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/kvconfig\/items\/tabbarconfig1$/i then response.json.jq(".data.items |= [.[] | select(.key == \"news\" or .key == \"live\")]")
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/kvconfig\/items\/search_keywords_wscnvip$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/search\/hotsearch\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/content\/articles\/hot\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/wallstreetcn\.com\/app-faas\/coupon\/user\/search\/popup$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/content\/lives\/relateddata\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/content\/articles\/relateddata\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/content\/carousel\/information-flow\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/apiv1\/content\/articles\//i then response.json.delete("data.recommend_vip_img_uri")
response if ${url} ~= /^https:\/\/api-one-wscn\.awtmt\.com\/\/apiv1\/kvconfig\/items\/membersrights$/i then response.json.delete("data.vip_article")

[MITM]
hostname = api-one-wscn.awtmt.com

