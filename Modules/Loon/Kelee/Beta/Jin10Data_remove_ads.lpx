[Rewrite]
request if ${url} ~= /^https:\/\/jad-api\.jin10\.com\/ad\d\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/common-open-api\.jin10\.com\/configuration\/getById\?id=1493$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/search-open-api\.jin10\.com\/search\/getHotWords$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cdn\.jin10\.com\/json\/index\/hits_rank\.json\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/[0-9a-z]+\.z3c\.jin10\.com\/api\/home\/search\/hot$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/jad-api\.jin10\.com\/mult\/list_unread\?/i then reject_dict(200)

[MITM]
hostname = jad-api.jin10.com, common-open-api.jin10.com, search-open-api.jin10.com, cdn.jin10.com, *.z3c.jin10.com

