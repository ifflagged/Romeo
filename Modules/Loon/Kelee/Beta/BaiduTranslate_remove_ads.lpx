[Rewrite]
request if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/v2\/api\/launch\/config\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/comment\/my\?/i then response.json.delete(["data.taskBanner", "data.act"])
response if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/recitewd\/myplan\?/i then response.json.delete(["data.activityRec", "data.activityRecList"])
request if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/static\/react-activity\/page\/courseBoutique\.html\?/i then reject(404)

[MITM]
hostname = fanyi-app.baidu.com

