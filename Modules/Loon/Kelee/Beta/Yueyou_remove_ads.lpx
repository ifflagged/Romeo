#!name=阅友去广告
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1066723192
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN,ads.reader.yueyouxs.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/goway\.reader\.yueyouxs\.com\/assemble\/app\/basic\/getAppInfo\?/i then response.json.delete(["data.isShowDLPopup", "data.isShowGame", "data.touTiaoShowDlPopup", "data.offLineDownload.WatchVideoBtnDesc", "data.readVipFirstCfg", "data.readVipNormalCfg", "data.notifyAd", "data.hotStartSplashTime", "data.hotStartReqSwitch", "data.isShowBFTab", "data.popReqDelayTime", "data.benefitCfg", "data.chestTask", "data.hotStartAd", "data.activeTagList", "data.secondOrderCfg", "data.secondOrderList", "data.blockedWordsCfg", "data.aaReportListCfg", "data.pddAdSwitch", "data.isShowShelfAuthPopup", "data.firstPopUpAmount"])
response if ${url} ~= /^https:\/\/goway\.reader\.yueyouxs\.com\/assemble\/app\/basic\/getAppInfo\?/i then response.json.replace("data.isAdClosed", true)

[MITM]
hostname = goway.reader.yueyouxs.com

