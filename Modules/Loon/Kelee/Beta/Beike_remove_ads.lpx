#!name=贝壳找房去广告
#!desc=移除开屏广告、弹窗广告、悬浮广告、信息流推广、我家页面的装修推荐。移除我的页面的专属推荐、游戏入口、钱包入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1347663353
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/initData\/mini\?/i then response.json.delete(["data.bootpage", "data.bottom_bar_activity"])
request if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/config\/config\/bootpage\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/feed\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/info\?/i then response.json.delete("data.islandModule")
response if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/info\?/i then response.json.jq("del(.data.mainIcons.list[] | select(.indexKey == \"coupon\"))")
response if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/myhome\/pagedetail\?/i then response.json.jq(".data.moduleList |= map(select(.tab != \"myHomeDecorV4\"))")
request if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/config\/config\/getactivityconfig\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/feed\?/i then response.json.jq(".data.list |= map(select(.cardType == \"houseContainer\" or .cardType == \"houseV2\" or .cardType == \"houseV3\" or .cardType == \"rentHouseDiscount\" or .cardType == \"decorationCase\"))")

[MITM]
hostname = apps.api.ke.com

