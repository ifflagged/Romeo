#!name=百度网页去广告
#!desc=移除百度搜索移动端网页的首页广告信息流
#!author=Keywos[https://github.com/Keywos]
#!icon=icon not found
#!tag=Kelee
#!tag=去广告
#!loon_version=3.5.1(998)
