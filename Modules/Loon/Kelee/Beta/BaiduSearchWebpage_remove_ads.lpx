[Script]
response if ${url} ~= /^https?:\/\/(www|m)\.baidu\.com\/?($|\?from=\w{8,9})/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/BaiduSearchWebpage_remove_ads/kelee_BaiduSearchHomePage_remove_ads.js") with tag="移除百度搜索首页信息流广告", requires_body=true

[MITM]
hostname = m.baidu.com, www.baidu.com

