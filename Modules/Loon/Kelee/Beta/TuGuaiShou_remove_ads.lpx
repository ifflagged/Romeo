#!name=图怪兽去广告
#!desc=移除开屏广告、弹窗广告、各页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1492397619
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/api\.818ps\.com\/v4\/advertisement\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.818ps\.com\/v4\/popup\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.818ps\.com\/v4\/festival\/newYear\/pop\?/i then reject_dict(200)

[MITM]
hostname = api.818ps.com

