#!name=Fileball网盘挂载
#!desc=支持挂载阿里云盘、夸克网盘和PikPak网盘，点击下方署名查看使用方法。
#!author=小白脸
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1558391784
#!tag=功能增强
#!loon_version=3.5.1(998)
#!homepage=https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/Fileball/README.md
#!date=2026-10-02 13:57:49

[Script]
request if ${url} ~= /^http:\/\/(aliyun|quark|pikpak)\.example\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Fileball_mount/kelee_Fileball_mount.js") with tag="三合一网盘挂载", requires_body=true

[MITM]
hostname = aliyun.example.com, quark.example.com, pikpak.example.com

