#!name=数字心动去广告
#!desc=移除开屏广告、首页顶部标签、轮播图、悬浮挂件、热门搜索、信息流广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1532385111
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-common-proxy-api\/api\/advertising\/proxy\/getOpenScreenAdvertising$/i then response.json.replace("data.advertisingList", "[]")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/getBrand$/i then response.json.jq(".data |= map(select(.advertisementName == \"路跑赛事\" or .advertisementName == \"线上赛\" or .advertisementName == \"越野赛事\"))")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.delete(["data.topHotSearchList", "data.bannerListTwo", "data.textAdvertisementList"])
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.jq(".data.recommendList |= map(select(.raceAdList | not or length == 0))")
request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-basic-center-api\/api\/appConfigBanner\/listBannerRelease\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-content-center-api\/api\/global\/search\/hotSearch\/list$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-basic-center-api\/api\/advertisement\//i then reject_dict(200)

[MITM]
hostname = api-changzheng.chinaath.com

