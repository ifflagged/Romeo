[Rewrite]
request if ${url} ~= /^https:\/\/tg\.feidee\.com\/online_ad\/api\/search\.do$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yunmk\.feidee\.net\/cab-market-ws\/market\/v2\/contents$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/tg\.feidee\.com\/vis-ad-engine-ws\/api\/v2\/ads\/.+esultNum/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.feidee\.net\/v1\/configs\/client\/configs/i then reject(404)
request if ${url} ~= /^https:\/\/tg\.feidee\.com\/vis-ad-engine-ws\/api\/show/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yun\.feidee\.net\/cab-periodic-activity-ws\/terminal\/v1\/members\/status/i then reject_dict(200)

[MITM]
hostname = tg.feidee.com, yunmk.feidee.net, community.feidee.com, api.feidee.net, yun.feidee.net

