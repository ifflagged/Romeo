[Rewrite]
request if ${url} ~= /^https?:\/\/dat\.ruanmei\.com\/ithome\/money\/acd\.json$/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/napi\.ithome\.com\/api\/(news\/indexv2\/iphone\/\d+|topmenu\/getfeeds\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/IThome_remove_ads/kelee_IThome_remove_ads.js", {${removeAllBanners}, ${removePinnedArticles}}) with tag="IT之家去广告", requires_body=true

[MITM]
hostname = napi.ithome.com, api.zuihuimai.com, dat.ruanmei.com

