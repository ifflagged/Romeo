#!name=Apple天气增强
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。
#!author=VirgilClyne[https://github.com/VirgilClyne], WordlessEcho[https://github.com/WordlessEcho], 001[https://github.com/001ProMax]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://itunes.apple.com/app/id1069513131
#!tag=功能增强
#!system=iOS, iPadOS, macOS, watchOS
#!system_version=18
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
response if ${url} ~= /^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/AppleWeatherEnhancer/NSRingo_response.bundle.js", {${Weather.Provider}, ${NextHour.Provider}, ${AirQuality.Calculate.Algorithm}, ${API.ColorfulClouds.Token}, ${API.QWeather.Host}, ${API.QWeather.Token}, ${API.WAQI.Token}, ${Storage}, ${LogLevel}}) with tag="天气可用性响应", requires_body=true

response if ${url} ~= /^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/AppleWeatherEnhancer/NSRingo_response.bundle.js", {${Weather.Provider}, ${NextHour.Provider}, ${AirQuality.Calculate.Algorithm}, ${API.ColorfulClouds.Token}, ${API.QWeather.Host}, ${API.QWeather.Token}, ${API.WAQI.Token}, ${Storage}, ${LogLevel}}) with tag="天气响应", requires_body=true, binary_body_mode=true

[MITM]
hostname = weatherkit.apple.com

