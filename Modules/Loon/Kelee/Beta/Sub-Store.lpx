#!name=Sub-Store
#!desc=高级订阅管理工具，定时任务默认为每天23点55分，可在插件设置中自定义。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://sub.store
#!tag=订阅管理
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Argument]
cron=input,"55 23 * * *",tag=定时参数, desc=这里需要输入符合CRON表达式的参数

[Rule]
DOMAIN,sub-store.vercel.app,PROXY

[Script]
request if ${url} ~= /^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Sub-Store/sub-store-org_sub-store-1.min.js") with tag="Sub-Store Core", timeout=120, requires_body=true

request if ${url} ~= /^https?:\/\/sub\.store/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Sub-Store/sub-store-org_sub-store-0.min.js") with tag="Sub-Store Simple", timeout=120, requires_body=true

cron ${cron} then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Sub-Store/sub-store-org_cron-sync-artifacts.min.js") with tag="Sub-Store Sync", timeout=120

[MITM]
hostname = sub.store

