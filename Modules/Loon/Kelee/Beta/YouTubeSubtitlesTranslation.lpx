#!name=YouTube双语翻译
#!desc=字幕增强及双语翻译，支持Youtube Music歌词翻译。此插件需要置于YouTube去广告插件之下，且和YouTube去广告插件的歌词翻译冲突，不支持tvOS设备。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id544007664
#!tag=功能增强
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Script]
request if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_request.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="JSON·YouTube播放器请求", requires_body=true

response if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_response.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="JSON·YouTube播放器响应", requires_body=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_request.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="Proto·YouTube播放器请求", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_response.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="Proto·YouTube播放器响应.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_response.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="Proto·GetWatch响应", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_request.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="YouTube定时文本请求"

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Composite_Subtitles_response.js") with tag="YouTube合成定时文本响应", requires_body=true

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_Translate_response.js") with tag="YouTube翻译定时文本响应", requires_body=true

request if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_request.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="JSON·YouTube Music浏览请求", requires_body=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_request.js", {${Type}, ${AutoCC}, ${ShowOnly}, ${Position}}) with tag="Proto·YouTube Music浏览请求", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_Translate_response.js") with tag="JSON·YouTube Music翻译歌词响应", requires_body=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/YouTubeSubtitlesTranslation/kelee_YouTube_Subtitles_Translate_response.js") with tag="Proto·YouTube Music翻译歌词响应", requires_body=true, binary_body_mode=true

[MITM]
hostname = www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com

