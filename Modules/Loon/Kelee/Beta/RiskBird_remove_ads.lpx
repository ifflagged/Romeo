#!name=风鸟去广告
#!desc=移除首页信息流和轮播图
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id1528682937
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/RiskBird_remove_ads/kelee_RiskBird_remove_ads.js") with tag="移除推荐老板", requires_body=true

[MITM]
hostname = m.riskbird.com

