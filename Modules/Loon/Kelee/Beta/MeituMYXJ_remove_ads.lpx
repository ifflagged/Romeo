#!name=美颜相机去广告
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id592331499
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/home_banner\.json\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.meiyan\.com\/vip\/permission_update_popup\.json\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\?/i then response.json.delete(["response.time_limit", "response.bubble", "response.person_center"])
response if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\?/i then response.json.replace(["response.function_pop.meiyan_style.is_pop", "response.onoff.vip_half_window_exit_remain_popup.open", "response.onoff.vip_home_exit_remain_popup"], [false, 0, 0])

[Script]
response if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/home\.json\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/MeituMYXJ_remove_ads/kelee_MeituMYXJ_remove_ads.js") with tag="精简首页功能栏目并移除美颜推荐", requires_body=true

[MITM]
hostname = api.meiyan.com

