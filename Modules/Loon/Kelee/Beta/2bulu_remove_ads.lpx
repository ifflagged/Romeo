#!name=两步路户外助手去广告
#!desc=移除开屏广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=Kelee
#!openUrl=https://apps.apple.com/app/id646277024
#!tag=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/helper\.2bulu\.com\/getAppEntranceConfig\?/i then response.json.jq(".configData=(.configData|fromjson|del(.adPlatform,.adIntertitialShowType,.adsConfig,.adIntertitialDisplayedLimit,.adSplashShowTypeWhenHotStart,.adIntertitialDayDisplayedMaxCount,.od_adsType,.showMeBaiHeAdView)|tojson)")
request if ${url} ~= /^https:\/\/helper\.2bulu\.com\/search\/searchHotKeyList\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/helper\.2bulu\.com\/promote\/getAppUserModule\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/helper\.2bulu\.com\/proSpecial\/allData\?/i then reject_dict(200)

[MITM]
hostname = helper.2bulu.com

