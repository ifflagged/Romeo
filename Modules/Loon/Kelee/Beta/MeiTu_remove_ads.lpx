[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/api\.posters\.meitu\.com\/common\/init\.json/i then response.json.delete("data.vip")

[MITM]
hostname = api.posters.meitu.com

