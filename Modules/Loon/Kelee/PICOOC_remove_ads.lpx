[Rewrite]
request if ${url} ~= /^https:\/\/api2\.picooc\.com\/v\d\/api\/focus\/strategy\/execute\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api2\.picooc\.com\/v\d\/api\/dietGuide\/query\?/i then reject_dict(200)


request if ${url} ~= /^https:\/\/api2\.picooc\.com\/program\/listMainProgram\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/a\.picooc\.com\/v\d\/api\/camp\/sys\/config\/coupon\/pattern\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api2\.picooc\.com\/v\d\/api\/account\/getTabsInfo\?/i then reject_dict(200)

[MitM]
hostname=api2.picooc.com, a.picooc.com