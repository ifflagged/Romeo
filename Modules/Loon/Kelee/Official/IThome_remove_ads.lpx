#!name=IT之家去广告
#!desc=过滤IT之家信息流广告和文末广告，自定义移除置顶和轮播图，自定义移除项需在插件配置。
#!openUrl=https://apps.apple.com/app/id570610859
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/IThome.png
#!date=2026-10-02 13:57:49

[Argument]
removePinnedArticles = switch, false, true, tag=移除置顶文章, desc=启用后将移除置顶文章
removeAllBanners = switch, false, true, tag=移除全部横幅, desc=启用后将移除全部横幅

[Rewrite]
request if ${url} ~= /^https?:\/\/dat\.ruanmei\.com\/ithome\/money\/acd\.json$/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/napi\.ithome\.com\/api\/(news\/indexv2\/iphone\/\d+|topmenu\/getfeeds\?)/i then script("https://kelee.one/Resource/JavaScript/IThome/IThome_remove_ads.js", {${removeAllBanners}, ${removePinnedArticles}}) with tag="IT之家去广告", requires_body=true

[MitM]
hostname=napi.ithome.com, api.zuihuimai.com, dat.ruanmei.com