[Script]
request if ${url} ~= /^http:\/\/(aliyun|quark|pikpak)\.example\.com/i then script("https://kelee.one/Resource/JavaScript/Fileball/Fileball_mount.js") with tag="三合一网盘挂载", requires_body=true

[MitM]
hostname=aliyun.example.com, quark.example.com, pikpak.example.com,