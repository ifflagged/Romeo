#!name=云鲸智能去广告
#!desc=移除开屏广告、横幅推广，禁用商城。
#!openUrl=https://apps.apple.com/app/id1462004352
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NarwelRobots.png
#!date=2026-10-02 13:57:49

[Rewrite]
request if ${url} ~= /^https:\/\/cn-app\.narwaltech\.com\/operate\/appPosition\/listSplash\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/cn-app\.narwaltech\.com\/operate\/cactivity\/listByResourceIds\?resourceIds=(user_center_banner|index_banner)/i then reject_dict(200)

request if ${url} ~= /^https:\/\/store\.narwal\.com\/mall\/customPage\/getByPageKeyword\?/i then reject_dict(200)

[MitM]
hostname=cn-app.narwaltech.com, store.narwal.com