[Rewrite]
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/union\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/home\/getAdPopup$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/street\/listRecommendBanner$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/street\/listThemeBanner$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/home\/homePage\/config$/i then response.json.jq(".data.functionEntries |= map(select(.name == \"运动\" or .name == \"空间\")) | del(.data.seaview)")

request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/home\/activityEntry$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/home\/promoSlots\/config$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/user\/cs\/index$/i then response.json.delete("data.bannerList")

request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/channel\/subject\/hotspot\/rank$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/home$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/lotteryPage$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/list$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/api\/mall\/goods\/recommend\/pagePointsGoodsList$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.huachenjie\.com\/run-front\/common\/bottom-bar\/redDot$/i then response.json.delete("data.inspiration")

[MitM]
hostname=api.huachenjie.com