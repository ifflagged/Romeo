[Rewrite]
request if ${url} ~= /^https:\/\/api\.wfdata\.club\/v2\/yesfeng\/yesList\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.wfdata\.club\/v2\/yesfeng\/slideshow\?/i then response.json.jq(".data |= map(select(.protocolId == 1))")

[MitM]
hostname=api.wfdata.club