#!name=5EPlay去广告
#!desc=移除开屏广告、弹窗广告、活动角标、商城。
#!openUrl=https://apps.apple.com/app/id1149334962
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
#!date=2026-10-02 13:57:49

[Rewrite]
response if ${url} ~= /^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\?/i then response.json.delete(["data.function_configs.startup_ad_switch", "data.function_configs.startup_ad_timeout", "data.function_configs.startup_ad_day_max", "data.function_configs.app_bar_guide_width", "data.function_configs.app_bar_guide_height", "data.function_configs.app_bar_guide_url", "data.function_configs.app_bar_guide_time", "data.function_configs.home_tab_event_tag", "data.function_configs.home_tab_event_tag_ext", "data.function_configs.home_tab_player_tag", "data.function_configs.home_tab_player_tag_ext", "data.function_configs.task_center_entrance", "data.function_configs.store_go", "data.function_configs.wall_closed"])

response if ${url} ~= /^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$/i then response.json.delete("data.float_advertise")

request if ${url} ~= /^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$/i then response.json.delete("data.placeholder")

[MitM]
hostname=app.5eplay.com, ya-api-app.5eplay.com