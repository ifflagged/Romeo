#!name=比心去广告
#!desc=移除弹窗广告、悬浮广告、横幅广告、轮播图广告，精简搜索页及我的页面。
#!openUrl=https://apps.apple.com/app/id1286964732
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(980)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bixin.png
#!date=2026-08-28 17:10:45

[Rewrite]
request if ${url} ~= /^https:\/\/web\.hibixin\.com\/user-recall\/signModal$/i then reject(404)

request if ${url} ~= /^https:\/\/api\.hibixin\.com\/config\/v\d\/common\/popup$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.hibixin\.com\/biggie\/home\/v\d\/query\/biggie$/i then response.json.jq(".result.list |= map(select(has(\"bannerList\") and .bannerList == null))")

request if ${url} ~= /^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/rec\/card\/query$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.hibixin\.com\/msg\/user\/friends\/trends\/top$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.xxqapp\.cn\/live\/pendant\/index\/items$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.xxqapp\.cn\/banner\/list\/\d$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.hibixin\.com\/content\/v\d\/home\/page\/list$/i then response.body.mock("json", "{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}", 200)

request if ${url} ~= /^https:\/\/api\.hibixin\.com\/resource\/v\d\/discovery\/entrance\/activity$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.hibixin\.com\/config\/search\/qryConfigPart$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.xxqapp\.cn\/live\/flow\/pendant\/meta$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/web-bxyuer\.bixin\.cn\/yuer-ads\?/i then reject(404)
request if ${url} ~= /^https:\/\/gateway\.bxyuer\.com\/official\/room\/tab\/pop$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/gateway\.xxqapp\.cn\/living\/room\/fetch\/recommend-follow-list$/i then response.body.mock("json", "{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}", 200)

request if ${url} ~= /^https:\/\/api\.hibixin\.com\/biggie\/query\/skill\/detail\/relateRecommendBiggieV\d$/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.hibixin\.com\/resource\/v\d\/common\/tab$/i then response.json.jq(".result |= map(select(.type != \"activityCenter\"))")

[Script]
response if ${url} ~= /^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/common\/tab\/query$/i then script("https://kelee.one/Resource/JavaScript/Bixin/common_tab.js") with tag="精简首页标签", requires_body=true

response if ${url} ~= /^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/my\/page$/i then script("https://kelee.one/Resource/JavaScript/Bixin/my_page.js") with tag="精简我的页面", requires_body=true

[MitM]
hostname=web.hibixin.com, api.hibixin.com, gateway.hibixin.com, gateway.xxqapp.cn, api.xxqapp.cn, web-bxyuer.bixin.cn, gateway.bxyuer.com