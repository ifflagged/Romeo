#!name=🍿️ DualSubs: ▶️ YouTube
#!desc=YouTube 增强及双语字幕(歌词)
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Jacob
#!openUrl=http://boxjs.com/#/app/DualSubs.YouTube
#!homepage=https://DualSubs.github.io/guide/youtube
#!date=2024-12-11 01:41:21
#!version=1.5.11
#!arguments-desc=Type: [字幕] 启用类型\n    ├ Official: 官方字幕（合成器）\n    └ Translate: 翻译字幕（翻译器）\n请选择要使用的字幕，双语字幕将使用您选择类型呈现。\n\nTypes: [歌词] 启用类型\n    └ Translate: 翻译歌词（翻译器）\n请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。\n\nAutoCC: [字幕] 自动显示\n是否总是自动开启字幕显示。\n\nPosition: [字幕] 主语言（源语言）字幕位置\n    ├ Forward: 上面（第一行）\n    └ Reverse: 下面（第二行）\n主语言（源语言）字幕的显示位置。\n\nVendor: [翻译器] 服务商API\n    ├ Google: Google Translate\n    └ Microsoft: Microsoft Translator（需填写API）\n请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。\n\nShowOnly: [翻译器] 只显示“自动翻译”字幕\n是否仅显示“自动翻译”字幕，不显示源语言字幕。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n

[Argument]
Type=input,Official,tag=Type, desc=Type
Types=input,Translate,tag=Types, desc=Types
AutoCC=switch,"true","false",tag=AutoCC, desc=AutoCC
Position=input,Forward,tag=Position, desc=Position
Vendor=input,Google,tag=Vendor, desc=Vendor
ShowOnly=switch,"false","true",tag=ShowOnly, desc=ShowOnly
LogLevel=input,WARN,tag=LogLevel, desc=LogLevel

[Rule]
URL-REGEX,"^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$",REJECT-IMG

[Script]
# YouTube
http-request ^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTube.Player.request.json, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTube.Player.response.json, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js, requires-body=true, binary-body-mode=true, tag=🍿️ DualSubs.YouTube.Player.request.proto, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js, requires-body=true, binary-body-mode=true, tag=🍿️ DualSubs.YouTube.Player.response.proto, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js, requires-body=true, binary-body-mode=true, tag=🍿️ DualSubs.YouTube.GetWatch.response.proto, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js, tag=🍿️ DualSubs.YouTube.TimedText.request, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Composite.Subtitles.response.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTube.Composite.TimedText.response, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTube.Translate.TimedText.response, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

# YouTube Music
http-request ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTubeMusic.Browse.request.json, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js, requires-body=true, binary-body-mode=true, tag=🍿️ DualSubs.YouTube.Browse.request.proto, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js, requires-body=true, tag=🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.json, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js, requires-body=true, binary-body-mode=true, tag=🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.proto, argument=Type="{Type}"&Types="{Types}"&AutoCC="{AutoCC}"&Position="{Position}"&Vendor="{Vendor}"&ShowOnly="{ShowOnly}"&LogLevel="{LogLevel}"

[MITM]
hostname = www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com

