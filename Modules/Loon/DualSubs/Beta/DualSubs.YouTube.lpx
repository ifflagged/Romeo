#!name=🍿️ DualSubs: ▶️ YouTube
#!desc=YouTube 增强及双语字幕(歌词)
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=DualSubs
#!openUrl=https://dualsubs.github.io/preferences/
#!homepage=https://DualSubs.github.io/guide/youtube
#!date=2026-10-15 02:15:01
#!version=1.6.0

[Argument]
Type=input,"Official",tag=[字幕] 启用类型, desc=[字幕] 启用类型\n    ├ Official: 官方字幕（合成器）\n    └ Translate: 翻译字幕（翻译器）\n请选择要使用的字幕，双语字幕将使用您选择类型呈现。
Types=input,"Translate",tag=[歌词] 启用类型, desc=[歌词] 启用类型\n    └ Translate: 翻译歌词（翻译器）\n请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。
AutoCC=switch,true,false,tag=[字幕] 自动显示, desc=[字幕] 自动显示\n是否总是自动开启字幕显示。
Position=input,"Forward",tag=[字幕] 主语言（源语言）字幕位置, desc=[字幕] 主语言（源语言）字幕位置\n    ├ Forward: 上面（第一行）\n    └ Reverse: 下面（第二行）\n主语言（源语言）字幕的显示位置。
Vendor=input,"Google",tag=[翻译器] 服务商API, desc=[翻译器] 服务商API\n    ├ Google: Google Translate\n    └ Microsoft: Microsoft Translator（需填写API）\n请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly=switch,false,true,tag=[翻译器] 只显示“自动翻译”字幕, desc=[翻译器] 只显示“自动翻译”字幕\n是否仅显示“自动翻译”字幕，不显示源语言字幕。
Storage=input,"PersistentStore",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 插件配置优先\n    ├ PersistentStore: 持久化存储优先\n    └ database: 仅使用默认配置\n默认优先使用设置面板或 BoxJS 保存的配置，其次使用插件配置，最后使用脚本默认配置。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
URL-REGEX,"^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$",REJECT-IMG

[Rewrite]
response if ${url} ~= /^https:\/\/dualsubs\.github\.io\/api\/YouTube(?:\?.*)?$/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_DualSubs.YouTube.PreferencePanes.json", 200)

[Script]
request if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Player.request.json", requires_body=true

response if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Player.response.json", requires_body=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Player.request.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Player.response.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.GetWatch.response.proto", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.TimedText.request"

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Composite.Subtitles.response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Composite.TimedText.response", requires_body=true

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Translate.TimedText.response", requires_body=true

request if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTubeMusic.Browse.request.json", requires_body=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_request.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTube.Browse.request.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.json", requires_body=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.YouTube/DualSubs_Translate.response.bundle.js", {${Type}, ${Types}, ${AutoCC}, ${Position}, ${Vendor}, ${ShowOnly}, ${Storage}, ${LogLevel}}) with tag="🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.proto", requires_body=true, binary_body_mode=true

[MITM]
hostname = dualsubs.github.io, www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com

