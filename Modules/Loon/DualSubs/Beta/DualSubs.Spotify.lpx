#!name=🍿️ DualSubs: 🎵 Spotify
#!desc=Spotify 增强及双语歌词
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=DualSubs
#!openUrl=http://boxjs.com/#/app/DualSubs.Spotify
#!homepage=https://DualSubs.github.io/guide/spotify
#!date=2025-10-25 04:40:57
#!version=1.9.12

[Script]
# 🍿️ DualSubs.Spotify.Tracks.response
http-response ^https?:\/\/api\.spotify\.com\/v1\/tracks\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_response.bundle.js, requires-body=true, binary-body-mode=true, timeout=60, tag=response.bundle

# 🍿️ DualSubs.Spotify.Lyrics.request
http-request ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_request.bundle.js, requires-body=true, binary-body-mode=true, timeout=60, tag=request.bundle

# 🍿️ DualSubs.Spotify.Translate.Lyrics.response
http-response ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=Translate script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_Translate.response.bundle.js, requires-body=true, timeout=60, tag=Translate.response.bundle

# 🍿️ DualSubs.Spotify.External.Lyrics.response
http-response ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=External script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_External.Lyrics.response.bundle.js, requires-body=true, timeout=60, tag=External.Lyrics.response.bundle

[MITM]
hostname = api.spotify.com, spclient.wg.spotify.com, *-spclient.spotify.com

