#!name=🍿️ DualSubs: 🎵 Spotify
#!desc=Spotify 增强及双语歌词
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=DualSubs
#!openUrl=http://boxjs.com/#/app/DualSubs.Spotify
#!homepage=https://DualSubs.github.io/guide/spotify
#!date=2025-10-25 04:40:57
#!version=1.9.12

[Argument]
Types=input,"Translate,External",tag=[歌词] 启用类型（多选）, desc=[歌词] 启用类型（多选）\n    ├ Translate: 翻译歌词（翻译器）\n    └ External: 外部歌词（外部源）\n请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。
Languages[0]=input,"AUTO",tag=[翻译器] 主语言（源语言）, desc=[翻译器] 主语言（源语言）\n    ├ AUTO: 自动 - Automatic\n    ├ ZH: 中文（自动）\n    ├ ZH-HANS: 中文（简体）\n    ├ ZH-HK: 中文（香港）\n    ├ ZH-HANT: 中文（繁体）\n    ├ EN: English - 英语（自动）\n    ├ ES: Español - 西班牙语（自动）\n    ├ JA: 日本語 - 日语\n    ├ KO: 한국어 - 韩语\n    ├ DE: Deutsch - 德语\n    ├ FR: Français - 法语\n    ├ TR: Türkçe - 土耳其语\n    └ KM: ភាសាខ្មែរ - 高棉语\n仅当源语言识别不准确时更改此选项。
Languages[1]=input,"ZH",tag=[翻译器] 副语言（目标语言）, desc=[翻译器] 副语言（目标语言）\n    ├ ZH: 中文（自动）\n    ├ ZH-HANS: 中文（简体）\n    ├ ZH-HK: 中文（香港）\n    ├ ZH-HANT: 中文（繁体）\n    ├ EN: English - 英语（自动）\n    ├ ES: Español - 西班牙语（自动）\n    ├ JA: 日本語 - 日语\n    ├ KO: 한국어 - 韩语\n    ├ DE: Deutsch - 德语\n    ├ FR: Français - 法语\n    ├ TR: Türkçe - 土耳其语\n    └ KM: ភាសាខ្មែរ - 高棉语\n请指定翻译歌词的目标语言。
Vendor=input,"Google",tag=[翻译器] 服务商API, desc=[翻译器] 服务商API\n    ├ Google: Google Translate\n    └ Microsoft: Microsoft Translator（需填写API）\n请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
LrcVendor=input,"NeteaseMusic",tag=[歌词] 服务商API, desc=[歌词] 服务商API\n    ├ NeteaseMusic: 网易云音乐（官方）\n    ├ QQMusic: QQ音乐（官方）\n    └ NeteaseMusicNodeJS: 网易云音乐 NodeJS API\n请选择外部源所使用的服务商API。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 🔴 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Script]
response if ${url} ~= /^https?:\/\/api\.spotify\.com\/v1\/tracks\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_response.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.Tracks.response.json", requires_body=true

request if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_request.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.Lyrics.request.json", requires_body=true

request if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_request.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.Lyrics.request.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_Translate.response.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.Translate.Lyrics.response.json", requires_body=true

response if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_Translate.response.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.Translate.Lyrics.response.proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_External.Lyrics.response.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.External.Lyrics.response.json", requires_body=true

response if ${url} ~= /^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_External.Lyrics.response.bundle.js", "[{Types},{Languages[0]},{Languages[1]},{Vendor},{LrcVendor},{LogLevel}]") with tag="🍿️ DualSubs.Spotify.External.Lyrics.response.proto", requires_body=true, binary_body_mode=true

[MITM]
hostname = api.spotify.com, spclient.wg.spotify.com, *-spclient.spotify.com

