#!name=🍿️ DualSubs: 🇳 Netflix
#!desc=Netflix 增强及双语字幕
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=DualSubs
#!openUrl=https://dualsubs.github.io/preferences/
#!homepage=https://DualSubs.github.io/guide/netflix
#!date=2026-10-16 01:54:54
#!version=0.6.0

[Argument]
Type=input,"Translate",tag=[字幕] 启用类型, desc=[字幕] 启用类型\n    └ Translate: 翻译字幕（翻译器）\n请选择要使用的字幕，双语字幕将使用您选择类型呈现。
Languages[0]=input,"AUTO",tag=[字幕] 主语言（源语言）, desc=[字幕] 主语言（源语言）\n    ├ AUTO: 自动 - Automatic\n    ├ ZH: 中文（自动）\n    ├ ZH-HANS: 中文（简体）\n    ├ ZH-HK: 中文（香港）\n    ├ ZH-HANT: 中文（繁体）\n    ├ EN: English - 英语（自动）\n    ├ ES: Español - 西班牙语（自动）\n    ├ JA: 日本語 - 日语\n    ├ KO: 한국어 - 韩语\n    ├ DE: Deutsch - 德语\n    ├ FR: Français - 法语\n    ├ TR: Türkçe - 土耳其语\n    └ KM: ភាសាខ្មែរ - 高棉语\n当“主语言”字幕存在时，将生成“主语言/副语言（翻译）”与“主语言（外挂）”的字幕或字幕选项。仅当源语言识别不准确时更改此选项。
Languages[1]=input,"ZH",tag=[字幕] 副语言（目标语言）, desc=[字幕] 副语言（目标语言）\n    ├ ZH: 中文（自动）\n    ├ ZH-HANS: 中文（简体）\n    ├ ZH-HK: 中文（香港）\n    ├ ZH-HANT: 中文（繁体）\n    ├ EN: English - 英语（自动）\n    ├ ES: Español - 西班牙语（自动）\n    ├ JA: 日本語 - 日语\n    ├ KO: 한국어 - 韩语\n    ├ DE: Deutsch - 德语\n    ├ FR: Français - 法语\n    ├ TR: Türkçe - 土耳其语\n    └ KM: ភាសាខ្មែរ - 高棉语\n当“副语言”字幕存在时，将生成“副语言/主语言（官方）”的字幕或字幕选项。
Position=input,"Forward",tag=[字幕] 主语言（源语言）字幕位置, desc=[字幕] 主语言（源语言）字幕位置\n    ├ Forward: 上面（第一行）\n    └ Reverse: 下面（第二行）\n主语言（源语言）字幕的显示位置。
Vendor=input,"Google",tag=[翻译器] 服务商API, desc=[翻译器] 服务商API\n    ├ Google: Google Translate\n    └ Microsoft: Microsoft Translator（需填写API）\n请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly=switch,false,true,tag=[翻译器] 只显示翻译字幕, desc=[翻译器] 只显示翻译字幕\n是否仅显示翻译后字幕，不显示源语言字幕。
Storage=input,"PersistentStore",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 插件配置优先\n    ├ PersistentStore: 持久化存储优先\n    └ database: 仅使用默认配置\n默认优先使用设置面板或 BoxJS 保存的配置，其次使用插件配置，最后使用脚本默认配置。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
response if ${url} ~= /^https:\/\/dualsubs\.github\.io\/api\/Netflix(?:\?.*)?$/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_DualSubs.Netflix.PreferencePanes.json", 200)

[Script]
request if ${url} ~= /^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/NSNanoCat_api.js") with tag="PreferencePanes.API", requires_body=true

response if ${url} ~= /^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_Translate.response.bundle.js", "[{Type},{Languages[0]},{Languages[1]},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]") with tag="🍿️ DualSubs.Netflix.Translate.Subtitles.response", requires_body=true

[MITM]
hostname = dualsubs.github.io, *.oca.nflxvideo.net

