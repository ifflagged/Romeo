[Script]
# 🍿️ DualSubs.Netflix.Translate.Subtitles.response
http-response ^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_Translate.response.bundle.js, requires-body=true, timeout=60, tag=Translate.response.bundle

[MITM]
hostname = *.oca.nflxvideo.net

