#!name= Jacob
#!desc= Merged Plugin For Jacob
#!author= Jacob[https://github.com/ifflagged/Romeo]
#!icon= https://github.com/Semporia/Hand-Painted-icon/raw/master/Social_Media/Apple.png

[Rewrite]
# BYDDynasty
^https:\/\/cache\.bydauto\.com\.cn\/dilink_user_upload\/20 reject-200
# LeKe
^https?:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AppAdvertisingFrontService\/getAppAdvertisingNew reject-dict
^https?:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.bff\.ClientFrontFacade\/queryHomeMiddleInfo reject-dict
^https?:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AdvertiseConfigFrontService\/getAdvertiseConfigNew reject-dict
# Roborock_remove_ads
request if ${url} ~= /^https:\/\/cniot\.roborock\.com\/api\/v1\/activity\/banner\/list$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cniot\.roborock\.com\/api\/v1\/activity\/latest$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cniot\.roborock\.com\/api\/v1\/app\/theme\/device\/icon\?/i then reject(404)
response if ${url} ~= /^https:\/\/api\.roborock\.com\/v2\/h5\.page\.item\.info\?id=4115$/i then response.json.jq(".data |= map(select(.title == \"常用功能\"))")
# SamClub
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/sams-user\/(window\/getGoUpPlus|screen_promotion\/get) reject
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/channel\/portal\/AdgroupData reject-dict
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/configuration\/personCenterEntrance\/query reject-dict
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/trade\/order\/getOftenBuyGoods reject-dict
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/goods-portal\/spu\/searchRecommendPool reject-dict
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/configuration\/appVersionUpdate\/getAppVersionUpdateInfo reject-dict
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/portal\/beUpdate reject-dict
# AtourSplash
^https?:\/\/api2\.yaduo\.com\/atourlife\/activity\/appLaunch reject-dict

[MITM]
hostname = api-sams.walmartmobile.cn, api.roborock.com, api2.yaduo.com, cache.bydauto.com.cn, cniot.roborock.com, lens.leoao.com

