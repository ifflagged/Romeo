#!name=ZhuanZhuanAds
#!desc=ZhuanZhuanAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzlogic\/getOpenScreen response-body-json-jq '.respData=null'
^https:\/\/app\.zhuanzhuan\.com\/zzopen\/popwindow\/getallpopwin response-body-json-jq '.respData.popWindow=null | .respData.bottomFloat=null | .respData.bubbleGuide=null | .respData.topOperation=null | .respData.topOperationIsOther=false'
^https:\/\/app\.zhuanzhuan\.com\/api\/zzlogic\/cbchomepage response-body-json-jq '.respData.topActBanner=null | .respData.leftPendant={} | .respData.operationCardArea=null | .respData.horizontalCard=null | .respData.newUserArea=null | .respData.redInfoBanner=null'
^https:\/\/app\.zhuanzhuan\.com\/zzopen\/zzbmlogic\/queryFrontPageWindowInfo response-body-json-jq '.respData.bannerInfo.data=[] | .respData.popupInfo={} | .respData.operatingInfo=[] | .respData.rightBanner=null | .respData.topAtmosphereV2.carouselList=[]'
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzinfoshow\/getfeedflowinfo response-body-json-jq '.respData.infoData=((.respData.infoData // []) | map(select(.type!=29)))'
^https:\/\/app\.zhuanzhuan\.com\/api\/ptlogic\/getnewcomerzoneentry response-body-json-jq '.respData=null'
^https:\/\/app\.zhuanzhuan\.com\/zzopen\/zzbmlogic\/getSearchHomePageConfig response-body-json-jq '.respData.searchWords=[] | .respData.hotBrands=[] | .respData.hotSearch=[] | .respData.hotOrder=[]'
^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getsearchword response-body-json-jq '.respData.recommendword.data=[]'
^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getsearchconfigdata response-body-json-jq '.respData.goods=[] | .respData.officialCheckMindWordConfig={}'
^https:\/\/app\.zhuanzhuan\.com\/api\/zzlogic\/getShowCaseWords response-body-json-jq '.respData.showCaseData=[]'
^https:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo response-body-json-jq '.respData.zzReport={} | .respData.questionnairePop=[]'
^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ptuserlogic\/getmymien response-body-json-jq '.respData.bmNewInfo=null | .respData.activityField=null | .respData.miniActivityField=null | .respData.memberCenter=null | .respData.displayChoiceGoodsFeed=0 | .respData.walletArea.cardItems=((.respData.walletArea.cardItems // []) | map(select(.tokenId=="balance"))) | .respData.toolbarArea=((.respData.toolbarArea // []) | map(select(.tokenId!="3cInvest" and .tokenId!="quzuji" and .tokenId!="financial" and .tokenId!="fenqishagncheng" and .tokenId!="dianyuanzhaomu" and .tokenId!="offlStore" and .tokenId!="equity")))'
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzusercenter\/myprofilevariouscardsv2 response-body-json-jq '.respData.cardList=[]'
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzinfoshow\/getchoicegoodsinfos response-body-json-jq '.respData.infoData=[]'
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/corecyclelogic\/getredpointconfig response-body-json-jq '.respData.showFlag=0 | .respData.picture=""'
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzlogic\/tabredpoint response-body-json-jq '.respData={}'
# > 行为埋点
^https:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzlogic\/(?:reportdautracking|reportVariousData|reportPushChannelStatus|reporttabclick) - reject-dict
^https:\/\/lego\.zhuanzhuan\.com\/(?:v1\/coke|page\/mark) - reject-dict
^https:\/\/lego-tech\.zhuanzhuan\.com\/(?:v1\/coke-tech|page\/mark-p-tech) - reject-dict
# > Sentry / 听云监控
^https:\/\/sentry\.zhuanzhuan\.com\/api\/\d+\/envelope\/ - reject-dict
^https:\/\/wkdcm1\.tingyun\.com\/(?:initMobileApp|getTaskDefs|reportSpanData) - reject-dict
^https:\/\/wkrt\.tingyun\.com\/getMobileRedirectHost - reject-dict

[MITM]
hostname = app.zhuanzhuan.com, lego.zhuanzhuan.com, lego-tech.zhuanzhuan.com, sentry.zhuanzhuan.com, wkdcm1.tingyun.com, wkrt.tingyun.com

