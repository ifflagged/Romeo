#!name=CaiXinAds
#!desc=CaiXinAds
#!icon=icon not found
#!tag=Jacob

[Rewrite]
^https:\/\/gateway\.caixin\.com\/api\/app-api\/caixinapp\/appinfo response-body-json-jq '.data.adConfig.audio_ad=[] | .data.adConfig.article_ad=[] | .data.adConfig.channel_list_ad=[] | .data.memberCharge=null | .data.inviteFriend=null | .data.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.memberCharge=[] | .data.userCenterSettingsConfigV2.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.topRightBtnList=((.data.userCenterSettingsConfigV2.topRightBtnList // []) | map(select(.code!="hotSelection"))) | .data.channel.channel_show=((.data.channel.channel_show // []) | map(select(.id!="186" and .name!="AI荐读"))) | .data.channel.channel_hide=((.data.channel.channel_hide // []) | map(select(.id!="186" and .name!="AI荐读"))) | .data.channelList=((.data.channelList // []) | map(select(.id!=186 and .name!="AI荐读"))) | .data.homePageWatchingList=((.data.homePageWatchingList // []) | map(select(.title!="AI全景"))) | .data.aiConfig=null | .data.isShowAiPairedReading="0" | .data.isShowAiAbFeature="0"'
^https:\/\/gateway\.caixin\.com\/api\/app-api\/userChannelNew\/getUserChannel response-body-json-jq '.data=((.data // []) | map(select(.channelId!=186)))'
^https:\/\/gateway\.caixin\.com\/api\/app-api\/adInfoData\/getDateAdAll response-body-json-jq '.data=[]'
^https:\/\/gateway\.caixin\.com\/api\/app-api\/poster\/getAll response-body-json-jq '.data=[]'
^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxBubbleInfo\/getCxBubbleInfo(?:V3)? response-body-json-jq '.data=[]'
^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist\/ response-body-json-jq '.data=[]'
^https:\/\/gateway\.caixin\.com\/api\/app-api\/search\/getkeyword response-body-json-jq '.data.keys=[] | .data.hot_news=[]'
# > 文章页猜你想问
^https:\/\/www\.caixin\.com\/ai\/question\/\d+\/\d+\.js - reject-200
# > 原生广告 / 开屏 / 信息流 / Banner
^https:\/\/gg\.caixin\.com\/s - reject-200
# > 文章页广告
^https:\/\/dolphin\.caixin\.com\/s - reject-200
# > 数据统计上报
^https:\/\/gateway\.caixin\.com\/api\/stat\/v\d\/client_data\/from_app - reject-200

[MITM]
hostname = gateway.caixin.com, msgapi.caixin.com, gg.caixin.com, dolphin.caixin.com, www.caixin.com

