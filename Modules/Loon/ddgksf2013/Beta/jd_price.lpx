[Script]
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/jd_price/wf021325_jd_price.js") with tag="jd_price", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/jd_price/wf021325_jd_price.js") with tag="jd_price", timeout=60, requires_body=true

[MITM]
hostname = in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com

