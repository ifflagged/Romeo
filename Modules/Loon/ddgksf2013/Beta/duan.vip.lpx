[Script]
response if ${url} ~= /^https?:\/\/app\.theinitium\.com\/subs\/[a-zA-Z_]+\/verify_subscription/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013_duan.vip.js") with tag="duan.vip", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.wallkit\.net\/api\/v\d\/user/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013_duan.vip.js") with tag="duan.vip", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.theinitium\.com\/editionfeed.*pugpig_atom_contents\.json/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013_duan.vip.js") with tag="duan.vip", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/app\.theinitium\.com\/editionfeed.*pugpig_atom_contents\.json/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)If-None-Match%3A.%2B(%5Cr%5Cn)-%3E%241If-None-Match%3A%242") with tag="replaceHeader", timeout=30

[MITM]
hostname = app.theinitium.com, api.wallkit.net

