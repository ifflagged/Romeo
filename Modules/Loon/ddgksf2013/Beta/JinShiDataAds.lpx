request if ${url} ~= /^https?:\/\/jad-api\.jin10\.com\/mult\/list_unread\?display=flash_list&fit_type=new_flash_flash/i then reject(200, " ")

[MITM]
hostname = search-open-api.jin10.com, jad-api.jin10.com, 121.40.226.146, 121.40.189.47, 120.55.71.177, 121.40.128.214, 121.40.195.238

