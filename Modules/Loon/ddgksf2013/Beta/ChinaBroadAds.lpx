[Rewrite]
response if ${url} ~= /^https?:\/\/app\.10099\.com\.cn\/contact-web\/api\/content\/qryPosterStand/i then response.json.jq(".data |= map(select(.posterStandName | test(\"中部业务菜单|导航栏|我的-特色|个人中心|客服\")))")
response if ${url} ~= /^https?:\/\/app\.10099\.com\.cn\/contact-web\/api\/content\/qryNavigationMenuList/i then response.json.jq(".data[]?.children |= map(select(.catalogName!=\"视听\"))")
request if ${url} ~= /^https?:\/\/app\.10099\.com\.cn\/contact-web\/api\/version\/getFlashScreenPage/i then reject(200, " ")

[MITM]
hostname = app.10099.com.cn

