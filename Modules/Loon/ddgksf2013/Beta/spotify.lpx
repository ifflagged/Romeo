#!name=spotify
#!desc=spotify
#!icon=icon not found
#!tag=ddgksf2013

[Script]
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/spotify/app2smile_spotify-qx-header.js") with tag="spotify-qx-header", timeout=60

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/spotify/app2smile_spotify-proto.js") with tag="spotify-proto", timeout=60, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/spotify/app2smile_spotify-json.js") with tag="spotify-json", timeout=60

[MITM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com

