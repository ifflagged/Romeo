#!name=BiliBiliAdsLite
#!desc=BiliBiliAdsLite
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show/i then reject(200, " ")

[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/square/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAdsLite/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

[MITM]
hostname = app.bilibili.com

