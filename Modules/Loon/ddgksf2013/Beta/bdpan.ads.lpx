#!name=bdpan
#!desc=bdpan
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist/i then response.json.jq(".result.list=[]")
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/api\/getconfig/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*baidu\.com\/rest\/.*\/membership\/(proxy\/)?guide/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/.*\/pcs\/ad/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/api\/activityentry/i then reject(200, " ")
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/feed\/hotlist/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/api\/getsyscfg/i then reject_dict(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/queryintent\/queryhint/i then reject(200, " ")
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/coins\/center\/notice/i then reject(200, " ")
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/recommend\/shortseries\/list/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/afd\.baidu\.com\/afd\/entry/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js") with tag="bdpan.ads", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?method=gamecenter/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js") with tag="bdpan.ads", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/pan\.baidu\.com\/feed\/cardinfos/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/bdpan.ads/ddgksf2013_bdpan.ads.js") with tag="bdpan.ads", timeout=60, requires_body=true

[MITM]
hostname = pan.baidu.com, afd.baidu.com

