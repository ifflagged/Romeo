[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/boxjs.rewrite.quanx/chavyleung_chavy.boxjs.js") with tag="chavy.boxjs", timeout=60, requires_body=true

[MITM]
hostname = boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

