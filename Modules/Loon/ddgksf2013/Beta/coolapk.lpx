#!name=coolapk
#!desc=coolapk
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/api.coolapk.com\/v6\/main\/init/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.coolapk.com\/v6\/dataList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.coolapk.com\/v6\/main\/indexV8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.coolapk.com\/v6\/feed\/replyList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.coolapk.com\/v6\/feed\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/api.coolapk.com\/v6\/page\/dataList\?.*title=%E9%85/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/coolapk/ddgksf2013_coolapk.js") with tag="coolapk", timeout=60, requires_body=true

[MITM]
hostname = api.coolapk.com

