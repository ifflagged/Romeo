#!name=ZhongYuZaiXianAds
#!desc=ZhongYuZaiXianAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/operative\/v1\/ad\/listNotEndByPlace/i then response.json.jq(".list=[]")
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/info\/v\d+\/channel\/channelConfigById/i then response.json.jq(".data.operative_config=((.data.operative_config // []) | map(select(._type!=\"pic_slide\")))")
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/info\/v\d+\/(?:channel|info)\/infoListByCatId/i then response.json.jq(".list=((.list // []) | map(select(._type!=\"pic_ad\")))")
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/user\/v\d+\/user\/myCenter/i then response.json.jq(".list=((.list // []) | map(select(.name!=\"中羽小店\")) | map(if .title==\"我的权益\" then .items=((.items // []) | map(select(.title!=\"我的推广\" and .title!=\"每日红包\" and .title!=\"优惠券\"))) else . end))")
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/circle\/v\d+\/Circle\/circleRecommend/i then response.json.jq(".tops=((.tops // []) | map(select(.name!=\"中羽商业街\")))")
response if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/operative\/v\d+\/assistant\/pullAssistantMsg/i then response.json.jq(".list=((.list // []) | map(select((((.content | tostring) | contains(\"cbo_gg/count.php\")) == false))))")
request if ${url} ~= /^https:\/\/app\.badmintoncn\.com\/mag\/config\/v\d+\/iframe\/iframeView\?id=13/i then reject(200, " ")
request if ${url} ~= /^https:\/\/www\.badmintoncn\.com\/cboa\.php/i then reject(200, " ")
request if ${url} ~= /^https:\/\/pc-mon\.snssdk\.com\/monitor_pc\/collect\/api\/pc_log/i then reject(200, " ")

[MITM]
hostname = app.badmintoncn.com, www.badmintoncn.com, pc-mon.snssdk.com

