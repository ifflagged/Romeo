request if ${url} ~= /^https?:\/\/vip\.zeusai\.xin\/api\/adx/i then reject(200)
request if ${url} ~= /^https?:\/\/richmanrules\.ksedt\.com\/serverConfig/i then reject(200)
request if ${url} ~= /^https?:\/\/gw-api\.jxedt\.com\/app\/config.*homead/i then reject(200)
request if ${url} ~= /^https?:\/\/richmanrules\.ksedt\.com\/intellectWaterfall\/find/i then reject(200)
request if ${url} ~= /^https?:\/\/richmanrules\.ksedt\.com\/intellectWaterfallBidding\/find/i then reject(200)

