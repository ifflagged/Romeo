#!name=Youtube_CC
#!desc=Youtube_CC
#!icon=icon not found
#!tag=ddgksf2013

[Script]
request if ${url} ~= /https:\/\/www.youtube.com\/api\/timedtext\?.+&lang=(?!(zh|zh\-Hans)&)((?!&tlang=zh\-Hans).)*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Youtube_CC/Script-Hub-Org_replace-header.js", "%5CsHTTP%2F1%5C.1(%5Cr%5Cn)-%3E%26tlang%3Dzh-Hans%20HTTP%2F1.1%241") with tag="replaceHeader", timeout=30

request if ${url} ~= /https:\/\/www.youtube.com\/api\/timedtext\?.+&lang=(?!zh\-Hant&)((?!&tlang=zh\-Hant).)*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Youtube_CC/Script-Hub-Org_replace-header.js", "%5CsHTTP%2F1%5C.1(%5Cr%5Cn)-%3E%26tlang%3Dzh-Hant%20HTTP%2F1.1%241") with tag="replaceHeader", timeout=30

[MITM]
hostname = www.youtube.com

