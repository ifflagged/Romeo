[Script]
response if ${url} ~= /https:\/\/i\.weread\.qq\.com\/(book\/(reading[sS]tat|chapterReview)|user\/profile|groups\/readerEntrance|review\/list|mobileSync)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/WeRead/Maasea_weread.js") with tag="WeRead", requires_body=true

[MITM]
hostname = i.weread.qq.com

