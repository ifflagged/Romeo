#!name=XiaoHongShuAds
#!desc=XiaoHongShuAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\/recommend_info\?/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/gslb/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/httpdns/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/(tag\/)?ads/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/v\d+\/stateReport/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/data\/native\/matrix_switches/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/teenager\/status/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/home_guide/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/tabfeed/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/video\/save/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/live_photo\/save/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/redtube\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/videofeed\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

