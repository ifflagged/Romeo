response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/XiaoHongShuAds/ddgksf2013_redbook.ads.js") with tag="redbook.ads", timeout=60, requires_body=true

