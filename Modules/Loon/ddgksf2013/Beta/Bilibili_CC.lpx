[Script]
response if ${url} ~= /^https?:\/\/.*\.hdslb\.com\/bfs\/subtitle\/.+\.json/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Bilibili_CC/ddgksf2013_bilibili_cc.js") with tag="bilibili_cc", timeout=60, requires_body=true

[MITM]
hostname = aisubtitle.hdslb.com, i0.hdslb.com

