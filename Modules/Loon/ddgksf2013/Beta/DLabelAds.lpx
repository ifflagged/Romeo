[Rewrite]
request if ${url} ~= /^https?:\/\/dlabel\.ctaiot\.com\/api\/spreadstart\/list\.json/i then reject(200)
request if ${url} ~= /^https?:\/\/dlabel\.ctaiot\.com\/api\/status\/advise\/control\.json/i then reject(200)
request if ${url} ~= /^https?:\/\/dlabel\.ctaiot\.com\/api\/spread\/journey\/select\.json/i then reject(200)
request if ${url} ~= /^https?:\/\/dlabel\.ctaiot\.com\/api\/spreadslide\/list\.json/i then reject(200)

[MITM]
hostname = dlabel.ctaiot.com

