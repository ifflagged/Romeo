#!name=rrtv_json
#!desc=rrtv_json
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /https:\/\/api.juxingclub.com\/storage\/business\/rootName\/app\/homePage\?dataType=JSON/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api.juxingclub.com\/ad\/getAll/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/rrtv_json/ddgksf2013_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.juxingclub.com\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_MY/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/rrtv_json/ddgksf2013_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/api.juxingclub.com\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_INDEX/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/rrtv_json/ddgksf2013_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api.juxingclub.com\/app\/config\/h5NativeBar/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/rrtv_json/ddgksf2013_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

[MITM]
hostname = api.juxingclub.com

