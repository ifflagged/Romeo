#!name=KuaiKanComicsAds
#!desc=KuaiKanComicsAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/search\/app\/shading_word\/v\d\/list\?/i then response.json.jq(".data.shading_words=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/search\/show/i then response.json.jq(".data.info=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/kb\/wallet\?/i then response.json.jq(".data.activity={}")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/vip\/(charge_tip_list|banner_tip_list)\?/i then response.json.jq(".data.list=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/vip\/platform_base\/popups_display/i then response.json.jq(".data.popup_list=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/business\/mine\/business_config\?/i then response.json.jq(".data.module_config=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/ironman\/discovery_v2\/tab_list_v3\?gender=0&location=7/i then response.json.jq(".data.list=[]")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/ironman\/topic_detail\/tabs\?/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/comments\/cruel\/hot_floor_list/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/checkin\/task_center\/checkin_list_for_home_page_pop/i then response.json.jq(".data={}")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/app\/young_config\/get/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/vip\/nameplate\/list_all\?/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/business\/activities\/get/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/(ad|advertisement)\//i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/ironman\/comic\/recommend\?/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/business\/fake_push\/info/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/.*kkmh\.com\/v\d\/topic\/discovery_v2\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/KuaiKanComicsAds/Script-Hub-Org_replace-body.js", "ad_show%22%3A1-%3Ead_show%22%3A0") with tag="replaceBody", timeout=30, requires_body=true

[MITM]
hostname = api.kkmh.com, cdn-api.kkmh.com, cdn-search.kkmh.com, search.kkmh.com, pay.kkmh.com, cdn-pay.kkmh.com

