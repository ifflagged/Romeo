[Script]
response if ${url} ~= /^https:\/\/isi\.csan.[a-z.]+\/.+\/(receipts$|subscribers\/[^\/]+$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/goodbility.vip/ddgksf2013_goodbility.vip.js") with tag="goodbility.vip", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/isi\.csan.[a-z.]+\/.+\/(receipts|subscribers)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/goodbility.vip/ddgksf2013_deleteHeader.js") with tag="deleteHeader", timeout=60

response if ${url} ~= /^https?:\/\/notability\.com\/global/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/goodbility.vip/ddgksf2013_goodbility.vip.js") with tag="goodbility.vip", timeout=60, requires_body=true

[MITM]
hostname = isi.csan.*, notability.com

