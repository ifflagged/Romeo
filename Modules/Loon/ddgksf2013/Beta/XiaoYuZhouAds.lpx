[Rewrite]
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list/i then response.json.jq(".data |= map(select(.type != \"DISCOVERY_BANNER\"))")
request if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get-express/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get-preset/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category\/list-daily-suggestion/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash-screen\/list/i then reject(200, " ")

[MITM]
hostname = api.xiaoyuzhoufm.com, 118.31.123.175, 112.124.203.116, 118.31.125.171, 47.57.181.112, 47.57.182.96

