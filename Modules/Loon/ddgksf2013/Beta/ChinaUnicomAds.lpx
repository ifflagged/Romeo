#!name=ChinaUnicomAds
#!desc=ChinaUnicomAds
#!icon=icon not found
#!tag=ddgksf2013

[Rule]
DOMAIN-SUFFIX,ad.10010.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/search_service\/search\/searchScrollWord/i then response.json.jq(".[\"113000004\"]=[]")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientIndex\/homefusion\/fuInter/i then response.json.jq("del(.[\"HomeFusion.backGroundQuery\"], .[\"HomeFusion.bottomLabel\"].bottomMallKey)")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myWallet/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myPoints/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myColorfulRingtone/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/newUserInfo/i then response.json.jq(".data={}")
response if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/getDeviceInfo/i then response.json.jq(".data={}")
request if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/mobileserviceimportant\/customer\/querySmartServicekhd.htm/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.client\.10010\.com\/clientIndex\/api\/v1\/index\/queryIndexExclusiveOffers/i then reject(200)
request if ${url} ~= /^https?:\/\/img\.client\.10010\.com\/homejingxuan12\/js\/(pubuliu|1homeView)/i then reject(200)

[MITM]
hostname = m.client.10010.com, img.client.10010.com

