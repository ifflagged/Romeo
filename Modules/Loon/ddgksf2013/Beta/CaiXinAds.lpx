#!name=CaiXinAds
#!desc=CaiXinAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/caixinapp\/appinfo/i then response.json.jq(".data.adConfig.audio_ad=[] | .data.adConfig.article_ad=[] | .data.adConfig.channel_list_ad=[] | .data.memberCharge=null | .data.inviteFriend=null | .data.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.memberCharge=[] | .data.userCenterSettingsConfigV2.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.topRightBtnList=((.data.userCenterSettingsConfigV2.topRightBtnList // []) | map(select(.code!=\"hotSelection\"))) | .data.channel.channel_show=((.data.channel.channel_show // []) | map(select(.id!=\"186\" and .name!=\"AI荐读\"))) | .data.channel.channel_hide=((.data.channel.channel_hide // []) | map(select(.id!=\"186\" and .name!=\"AI荐读\"))) | .data.channelList=((.data.channelList // []) | map(select(.id!=186 and .name!=\"AI荐读\"))) | .data.homePageWatchingList=((.data.homePageWatchingList // []) | map(select(.title!=\"AI全景\"))) | .data.aiConfig=null | .data.isShowAiPairedReading=\"0\" | .data.isShowAiAbFeature=\"0\"")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/userChannelNew\/getUserChannel/i then response.json.jq(".data=((.data // []) | map(select(.channelId!=186)))")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/adInfoData\/getDateAdAll/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/poster\/getAll/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxBubbleInfo\/getCxBubbleInfo(?:V3)?/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist\//i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/search\/getkeyword/i then response.json.jq(".data.keys=[] | .data.hot_news=[]")
response if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/app-api\/articlesHotRecommend\/getHotRecommendArticles/i then response.json.jq(".data.hotRecommendArticleList=[]")
request if ${url} ~= /^https:\/\/www\.caixin\.com\/ai\/question\/\d+\/\d+\.js/i then reject(200, " ")
request if ${url} ~= /^https:\/\/gg\.caixin\.com\/s/i then reject(200, " ")
request if ${url} ~= /^https:\/\/dolphin\.caixin\.com\/s/i then reject(200, " ")
request if ${url} ~= /^https:\/\/gateway\.caixin\.com\/api\/stat\/v\d\/client_data\/from_app/i then reject(200, " ")

[MITM]
hostname = gateway.caixin.com, msgapi.caixin.com, gg.caixin.com, dolphin.caixin.com, www.caixin.com

