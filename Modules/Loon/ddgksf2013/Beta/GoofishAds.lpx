#!name=GoofishAds
#!desc=GoofishAds
#!icon=icon not found
#!tag=ddgksf2013

[Rule]
DOMAIN-SUFFIX,iyes.youku.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.user.strategy.list/i then response.json.jq(".data.strategies = [{}]")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlehome.home.circle.list/i then response.json.jq(".data.circleList |= map(select(.bizCode != \"saveMoney\"))")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlehome.home.nextfresh/i then response.json.jq(".data.homeTopList |= [ .[0] ] | .data.sections |= map(select(.data.bizType == \"item\"))")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search.shade/i then response.json.jq(".data.singleShadeWords =[{}]")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.item.search.activate/i then response.json.jq(".data.cardList = [{}]")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search.discover/i then response.json.jq("del(.data.resultList)")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.idle.user.page.my.adapter/i then response.json.jq(".data.ability=[] | .data.container.sections |= map(select(.sectionBizCode | test(\"head|user|trade\")))")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.item.buy.feeds/i then response.json.jq("del(.data.sections)")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.local.home/i then response.json.jq(".data.sections |= map(select(.data.bizType == \"item\"))")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idlemtopsearch.search/i then response.json.jq(".data.resultList |= map(select(.data.item.main.clickParam.args.biz_type == \"item\"))")
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.taobao.idle.item.recommend/i then response.json.jq(".data.cardList |= map(select(.cardData.bizType != \"mamaAD\"))")
request if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.*splash\.ads/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.idle.ad.expose/i then reject(200, " ")

[Script]
response if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/amdc\/mobileDispatch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/GoofishAds/ddgksf2013_amdc.js") with tag="amdc", timeout=60, requires_body=true

[MITM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com

