#!name=Reddit 自动翻译
#!desc=自动注入 x-reddit-translations 开启 Reddit App 翻译功能
#!author=RavelloH
#!icon=icon not found
#!tag=ddgksf2013

[Script]
request if ${url} ~= /^https?:\/\/gql(-fed)?\.reddit\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/main/RavelloH_main.js") with tag="main", timeout=60

[MITM]
hostname = gql.reddit.com, gql-fed.reddit.com

