[Rewrite]
request if ${url} ~= /^https?:\/\/(cn|www)\.pornhub\.com\/_xa\/ads/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/(cn|www)\.pornhub\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/pornhub.ads/ddgksf2013_pornhub.ads.js") with tag="pornhub.ads", timeout=60, requires_body=true

[MITM]
hostname = cn.pornhub.com, www.pornhub.com

