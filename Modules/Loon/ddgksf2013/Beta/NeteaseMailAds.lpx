#!name=NeteaseMailAds
#!desc=NeteaseMailAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/.*conf\.do/i then response.json.jq(".data |= del(.masterLoginGuideList, .masterOperatorList, .functionOperatorInfoList, .memberOperator, .activityTabInfoList, .extList)")
response if ${url} ~= /^https?:\/\/mail\.163\.com\/fgw\/mailsrv-webrobot\/.*user\/info/i then response.json.jq(".result |= del(.assistantInfo, .quotaData)")
request if ${url} ~= /^https?:\/\/dashi\.163\.com\/task-center-api\/fapi\/task/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mmad\/master\/get\.do/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/getRegConfig\.do/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do/i then reject_dict(200)

[MITM]
hostname = dashi.163.com, appconf.mail.163.com, mail.163.com

