#!name=AiHuiShouAds
#!desc=AiHuiShouAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/search-config/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dammam-service\/api\/scene-message-template\/pull/i then response.json.jq(".data.statusCode=1 | .data.params={} | .data.context={} | .data.templateId=0 | .data.eventName=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/config-renew-v3/i then response.json.jq(".data.promotionBannerConfigs=[] | .data.homeSecondFloorBanner=[] | .data.yanxuanSlogan=null | .data.recycleSlogan=null")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/my-product-rotate-v2/i then response.json.jq(".data.myProductCoupon={\"receivableCouponCount\":0,\"receivableCouponList\":[],\"userCouponCount\":0,\"couponPrice\":0,\"couponCondition\":0} | .data.otherCategoriesImg=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/welfare-center\/entry-v2/i then response.json.jq(".data.pop=false | .data.receiveStatus=0 | .data.couponPackages=[] | .data.cashBacks=null | .data.taskBonus=null | .data.totalAwardPrice=0 | .data.homeWelfareZone=null | .data.notLoginPopup=null | .data.bgImageUrl=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/activity\/gradient-increase-sniff-v2/i then response.json.jq(".data.items=[] | .data.matchedPolicyItem=null | .data.nextPolicyItem=null | .data.inquiryItems=[] | .data.illustrate=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/module-config-v2/i then response.json.jq(".data.userCenterAflBanner=null | .data.userCenterLinLiBanner=null | .data.userCenterBottomBanners=[] | .data.activityCarouselMap=[] | .data.inviteNewUserActivity=null | .data.userCenterCommonFunctions=((.data.userCenterCommonFunctions // []) | map(select(.title!=\"福利中心\" and .title!=\"口令兑换\" and .title!=\"门店加盟\")))")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/products\/home\/config/i then response.json.jq(".data.adBannerList=null | .data.categoryAdBannerList=[] | .data.adBannerImgList=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/channel\/banner/i then response.json.jq(".data.flowBannerList=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/search\/placeholders-v2/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/find-tab-v4/i then response.json.jq(".data=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/navbar-v7/i then response.json.jq(".data=((.data // []) | map(select(.type!=8 and .type!=9 and .type!=10)))")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/task-center\/show-entrance/i then response.json.jq(".data.showEntrance=false | .data.unclaimedAmount=0 | .data.expireAmount=null | .data.secondsUntilExpired=null | .data.timeLimitTask=false | .data.showWaitComment=false | .data.fissionBubble=null")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/float-layers\/guide-login-v2/i then response.json.jq(".data.id=0 | .data.name=\"\" | .data.interactionMethod=0 | .data.commonLink=null | .data.couponPackageCode=null | .data.imgUrl=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/commonConfig/i then response.json.jq(".data.loginPageConfig.loginNewCouponTips=\"\" | .data.loginPageConfig.loginNewCouponTipsImg=\"\" | .data.loginPageConfig.loginBannerUrl=\"\" | .data.cartHeaderImage=\"\" | .data.promotionCenter.popup=false | .data.promotionCenterV2.popup=false | .data.promotionCenterV2.popupImg=\"\" | .data.promotionCenterV2.popupButtonImg=\"\" | .data.tradeRelievedRecycleAdvantageImage=\"\"")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/shops\/service-station-list-v7/i then response.json.jq(".data.customerTagConfig=[]")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config-center\/search-project/i then response.json.jq(".data=((.data // []) | map(select(.name==\"附近回收机\" or .name==\"附近门店\" or .name==\"手机维修\" or .name==\"帮助中心\")))")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/member\/static-config/i then response.json.jq(".data.memberUserCenter={} | .data.memberWelfareCenter={} | .data.couponTagImgUrl=\"\" | .data.memberInquiry.popTitleImageUrl=\"\" | .data.memberInquiry.popBgImageUrl=\"\" | .data.memberInquiry.popCoupon={}")
response if ${url} ~= /^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/gemini\/grouping/i then response.json.jq(".data=((.data // []) | map(if .name==\"wechat_advertisement\" then .group=0 else . end))")
request if ${url} ~= /^https:\/\/bi-log\.aihuishou\.com\/trace\/log\/ahs/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ahs-sentry\.aihuishou\.com\/api\/\d+\/envelope\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/wirelessgate\.aihuishou\.com\/garage-versional\/sniffer/i then reject_dict(200)

[MITM]
hostname = dubai-app.aihuishou.com, dubai.aihuishou.com, bi-log.aihuishou.com, ahs-sentry.aihuishou.com, wirelessgate.aihuishou.com

