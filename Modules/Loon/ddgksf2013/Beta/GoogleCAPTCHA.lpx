[Script]
response if ${url} ~= /^https:\/\/www\.google\.com(?:\.[a-z]+|)\/(?:search\?(?:|.+?&)q=|$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/GoogleCAPTCHA/NobyDa_Google_CAPTCHA.js") with tag="Google_CAPTCHA", timeout=60, requires_body=true

[MITM]
hostname = www.google.com*

