#!name=EmbyPlugin
#!desc=EmbyPlugin
#!icon=icon not found
#!tag=ddgksf2013

[Script]
response if ${url} ~= /^https?:\/\/mb3admin.com\/admin\/service\/registration\/validateDevice/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_unlock.js") with tag="unlock", timeout=60, requires_body=true

response if ${url} ~= /\/[Uu]sers\/\w{32}\/[Ii]tems\/\d+\??/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js") with tag="emby-plugin", timeout=60, requires_body=true

request if ${url} ~= /\/plugin\/scheme/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js") with tag="emby-plugin", timeout=60

request if ${url} ~= /(\/[Vv]ideos\/\d+\/stream\/.+\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/\d+\/.+\?.+&filename)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js") with tag="emby-plugin", timeout=60

response if ${url} ~= /(\/[Vv]ideos\/\d+\/stream\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/.+&filename)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_download_file_rename.js") with tag="download_file_rename", timeout=60

request if ${url} ~= /\/Users\/\w{32}\/Items\/\d+\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)Accept-Encoding%3A.%2B-%3E%24Accept-Encoding%3A%20gzip%2C%20deflate%2C%20br") with tag="replaceHeader", timeout=30

[MITM]
hostname = mb3admin.com, *.emby.wtf, *.plusmedia.site

