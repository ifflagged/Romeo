[Script]
response if ${url} ~= /^https?:\/\/missav\.(ws|live|com|ai)\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/missav.ads/ddgksf2013_missav.ads.js") with tag="missav.ads", timeout=60, requires_body=true

[MITM]
hostname = missav.live, missav.ws, missav.ai, missav.com

