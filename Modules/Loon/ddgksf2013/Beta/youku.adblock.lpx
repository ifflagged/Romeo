#!name=youku
#!desc=youku
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/iyes\.youku\.com\/uts\/v1\/video/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/amdc\.m\.youku\.com/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.relationrecommend\.wirelessrecommend\.recommend/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/iyes\.youku\.com\/uts\/v1\/start/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.haidai\.lantern\.appconfig\.get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.home\.query/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.uc\.query/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.soku\.yksearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.gateway\.new\.execute/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.huluwa\.dispatcher\.youthmode\.config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.ycp\.query/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/youku.adblock/ddgksf2013_youku.adblock.js") with tag="youku.adblock", timeout=60, requires_body=true

[MITM]
hostname = acs.youku.com, iyes.youku.com, acs.m.taobao.com

