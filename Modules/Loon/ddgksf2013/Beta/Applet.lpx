[Rewrite]
request if ${url} ~= /^https?:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+$/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query$/i then reject(200, " ")

[Script]
response if ${url} ~= /^(http|https):\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Applet/Script-Hub-Org_replace-body.js", "advertisement-%3Eddgksf2013") with tag="replaceBody", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Applet/ddgksf2013_zhangshanggongjiao.js") with tag="zhangshanggongjiao", timeout=60, requires_body=true

response if ${url} ~= /^(https?:\/\/)?([a-zA-Z0-9]+(-[a-zA-Z0-9]+)*\.)+[a-zA-Z]{2,}(:\d+)?\/wp-json\/[a-zA-Z0-9_-]+\/(mp\/)?v\d\/posts/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Applet/ddgksf2013_applet.js") with tag="applet", timeout=60, requires_body=true

