[Script]
request if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBili.Surge.Vip/ddgksf2013_bilibili.vip.js") with tag="bili.vip1", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBili.Surge.Vip/ddgksf2013_bili_myinfo_vip.js") with tag="bili.vip2", timeout=60, requires_body=true

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com

