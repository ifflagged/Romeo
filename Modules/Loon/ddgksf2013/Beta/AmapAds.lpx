#!name=AmapAds
#!desc=AmapAds
#!icon=icon not found
#!tag=ddgksf2013

[Rule]
DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT

[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif/i then reject_img(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather/i then reject_dict(200)

[Script]
response if ${url} ~= /^http:\/\/amdc\.m\.taobao\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amdc.js") with tag="amdc", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/AmapAds/ddgksf2013_amap.js") with tag="amap", timeout=60, requires_body=true

[MITM]
hostname = m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com

