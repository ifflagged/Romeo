#!name=QiShuiMusicAds
#!desc=QiShuiMusicAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/me\?/i then response.json.jq("del(.reward_ad_banner)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/card/i then response.json.jq("del(.preview_guide)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/search-block/i then response.json.jq("del(.search_chart_block)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/activities/i then response.json.jq("del(.activity_map)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/feed\/song-tab/i then response.json.jq(".items |= map(select(.type == \"track\"))")
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/media_ads/i then reject(200, " ")
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads/i then reject(200, " ")
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info/i then reject(200, " ")
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/commerce/i then reject(200, " ")
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend/i then reject(200, " ")
request if ${url} ~= /^https:\/\/tnc.*zijieapi\.com\/get_domains/i then reject(200, " ")

[MITM]
hostname = beta-luna.douyin.com, api.qishui.com, tnc*-*.zijieapi.com

