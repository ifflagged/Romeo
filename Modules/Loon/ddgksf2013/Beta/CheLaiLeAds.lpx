#!name=CheLaiLeAds
#!desc=CheLaiLeAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/.*chelaile\.net\.cn\/goocity\/flowPos\/listByPos/i then reject(200)
request if ${url} ~= /^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*chelaile\.net\.cn\/(api\/)?adpub/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/124\.70\.194\.16\/(ip|adpub)/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/124\.70\.194\.16\/goocity\/flowPos\/listByPos/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/atrace\.chelaile\.net\.cn\/(wx_preloadAd|adAnalysis)/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/.*chelaile\.net\.cn\/goocity\/city!/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CheLaiLeAds/ddgksf2013_chelaile.js") with tag="chelaile", timeout=60, requires_body=true

[MITM]
hostname = web.chelaile.net.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn, cdn.web.chelaile.net.cn, atrace.chelaile.net.cn

