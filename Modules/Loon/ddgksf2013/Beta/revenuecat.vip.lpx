#!name=revenuecat
#!desc=revenuecat
#!icon=icon not found
#!tag=ddgksf2013

[Script]
response if ${url} ~= /^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^\/]+$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/revenuecat.vip/ddgksf2013_revenuecat.vip.js") with tag="revenuecat.vip", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/revenuecat.vip/ddgksf2013_deleteHeader.js") with tag="deleteHeader", timeout=60

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com

