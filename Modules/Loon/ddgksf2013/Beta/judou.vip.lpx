[Script]
request if ${url} ~= /https:\/\/judouapp.com\/api\/v\d\/mine\/profile/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/judou.vip/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)If-None-Match%3A.%2B%3F(%5Cr%5Cn)-%3E%241%242") with tag="replaceHeader", timeout=30

response if ${url} ~= /^https?:\/\/judouapp.com\/api\/v\d\/mine\/profile/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/judou.vip/ddgksf2013_judou.vip.js") with tag="judou.vip", timeout=60, requires_body=true

[MITM]
hostname = judouapp.com

