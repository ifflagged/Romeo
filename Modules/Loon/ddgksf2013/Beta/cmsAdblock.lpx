#!name=去廣告｜CMS_DEBUG
#!desc=去除插入式廣告
#!icon=icon not found
#!tag=ddgksf2013

[Argument]
彈窗通知=switch,false,true,tag=彈窗通知, desc=彈窗通知

[Rewrite]
request if ${url} ~= /(^https?:\/\/s\d+\.bfengbf\.com\/video)(.+)_z5q\.ts/i then redirect(302, "$1$2.ts")

[Script]
response if ${url} ~= /^https?:\/\/m3u8\.(hmrvideo|heimuertv)\.com\/play\/(.+).m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/cmsAdblock/Yswag_cmsAdblock.js", "{彈窗通知}") with tag="去廣告｜黑木耳", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/((?:v\.lzcdn|v\.cdnlz|vip.*\.lz[-]?cdn)\d+\.com)\/.+\/hls\/.+\.m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/cmsAdblock/Yswag_cmsAdblock.js", "{彈窗通知}") with tag="去廣告｜量子資源", requires_body=true

response if ${url} ~= /^https?:\/\/(super|svipsvip|vip)\.ffzy[A-Za-z0-9-]+\.com\/.+\/hls\/.+\.m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/cmsAdblock/Yswag_cmsAdblock.js", "{彈窗通知}") with tag="去廣告｜非凡資源", requires_body=true

response if ${url} ~= /^https?:\/\/c\d+\.rrcdnbf\d+\.com\/video\/(.+)\.m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/cmsAdblock/Yswag_cmsAdblock.js", "{彈窗通知}") with tag="去廣告｜暴風影視", requires_body=true

response if ${url} ~= /^https?:\/\/vip\.kuaikan-(cdn|play)\d+\.com\/.+\/hls\/.+\.m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/cmsAdblock/Yswag_cmsAdblock.js", "{彈窗通知}") with tag="去廣告｜快看資源", requires_body=true

