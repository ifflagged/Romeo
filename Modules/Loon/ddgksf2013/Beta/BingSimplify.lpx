#!name=BingSimplify
#!desc=BingSimplify
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/assets\.msn\.com\/service\/weather\/locations\/search/i then reject_dict(200)
request if ${url} ~= /^https:\/\/assets\.msn\.com\/service\/news\/feed\/pages\/startmhp/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.msn\.com\/weather/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/sapphire\.api\.microsoftapp\.net\/config\/api\/v1\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BingSimplify/ddgksf2013_bing.js") with tag="bing", timeout=60, requires_body=true

[MITM]
hostname = sapphire.api.microsoftapp.net, assets.msn.com, api.msn.com

