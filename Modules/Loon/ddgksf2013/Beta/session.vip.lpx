#!name=session
#!desc=session
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /(^https:\/\/api\.stayinsession\.com\/\?token=.*?&)(is_setapp\=false)/i then redirect(302, "$1is_setapp=true")

[Script]
response if ${url} ~= /^https:\/\/api\.stayinsession\.com\/user\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/session.vip/ddgksf2013_session.vip.js") with tag="session.vip", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/api\.stayinsession\.com\/user\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/session.vip/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)If-None-Match%3A.%2B(%5Cr%5Cn)-%3E%241If-None-Match%3A%242") with tag="replaceHeader", timeout=30

[MITM]
hostname = api.stayinsession.com

