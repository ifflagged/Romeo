#!name=DaMaiAds
#!desc=DaMaiAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.aristotle\.get\/[\d.]+\//i then response.json.jq(".data.data.top.keywords=[] | .data.data.top.aiUrl=\"\" | .data.data.top.aiLottieUrl=\"\" | .data.data.top.aiLottieAmbientUrl=\"\" | .data.data.top.arScan={} | .data.nodes=((.data.nodes // []) | map(select(((.nodes[0].data.componentId // \"\") != \"dm_home_supper_banner\"))) | map(if ((.nodes[0].data.componentId // \"\") == \"dm_pioneer_function_area_with_city_rank\") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(select(.data.title != \"天天抽奖\"))) else . end) | map(if ((.nodes[0].data.componentId // \"\") == \"dm_pioneer_home_feed\") then .nodes[0].nodes=((.nodes[0].nodes // []) | map(if (.nodes? != null) then .nodes=((.nodes // []) | map(select(.data.cardType != \"15\" and .data.cardType != \"21\"))) else . end)) else . end))")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.appglobalconfig\/[\d.]+\//i then response.json.jq(".data.pop={} | .data.searchTip={} | .data.searchTips=[] | .data.headLottie={} | .data.headStyle={}")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.float\/[\d.]+\//i then response.json.jq(".data={}")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvlist\/[\d.]+\//i then response.json.jq(".data.adList=[]")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopmindapi\.loadwantshowlotteryanimationurl\/[\d.]+\//i then response.json.jq(".data.returnValue={}")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.user\.my\.content\.get\/[\d.]+\//i then response.json.jq(".data.banner=[] | .data.dynamicMenu.itemList=((.data.dynamicMenu.itemList // []) | map(select(.title != \"周边商城\" and .title != \"观演团\" and .title != \"电影包场\" and .title != \"公益三小时\" and .title != \"大麦VIP卡\" and .title != \"特惠专区\"))) | .data.performFilmVip={} | .data.showVip=false | .data.vipCardInfo={}")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.discovery\.publish\.check\/[\d.]+\//i then response.json.jq(".data.appPublishHint=\"\"")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.search\.tips\.get\/[\d.]+\//i then response.json.jq(".data.result=[]")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.search\.pioneer\.page\.get\/[\d.]+\//i then response.json.jq(".data.rankInfo.localSearchRankingList=[] | .data.rankInfo.searchFilmRankingList=[] | .data.rankInfo.searchRankingList=[] | .data.rankInfo.description=\"\" | .data.rankInfo.name=\"\"")
response if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.ai\.pageconfig\/[\d.]+\//i then response.json.jq(".data.enable=\"false\" | .data.aiLottieUrl=\"\"")
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup\.get/i then reject(200, " ")

[Script]
response if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/amdc\/mobileDispatch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DaMaiAds/ddgksf2013_amdc.js") with tag="amdc", timeout=60, requires_body=true

[MITM]
hostname = acs.m.taobao.com

