[Script]
response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v\d+\/(user\/profile|content\/(article_list|content-show)|reader\/section-detail|services\/play-token)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/vistopia.vip/ddgksf2013_vistopia.js") with tag="vistopia", timeout=60, requires_body=true

