[Script]
request if ${url} ~= /^https:\/\/testflight\.apple\.com\/v\d\/(app|account|invite)s\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/TestFlightAccount/NobyDa_TestFlightAccount.js") with tag="TestFlightAccount", timeout=60, requires_body=true

[MITM]
hostname = testflight.apple.com

