#!name=Twitch去廣告
#!desc=Avoid Twitch ads by grabbing video playlists from Russia
#!icon=icon not found
#!tag=ddgksf2013

[Argument]
luminous=input,"https://as.luminous.dev",tag=luminous, desc=luminous

[Script]
response if ${url} ~= /https:\/\/usher.ttvnw.net\/(api\/channel\/hls|vod)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/TwitchAdBlock/Yswag_twitchAdBlock.js", {${luminous}}) with tag="Twitch去廣告", requires_body=true

[MITM]
hostname = usher.ttvnw.net

