#!name=BiliBiliAds
#!desc=BiliBiliAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/bilibili.2025.04.02\/c136/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api.bilibili.com\/pgc\/season\/player\/cards/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/splash\/show/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash|GetActivityTab)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v\d\/search\/defaultwords/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/api\.bili(api|bili)\.(net|com)\/pgc\/season\/app\/related\/recommend\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app.bilibili.com\/x\/v2\/search\/square/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/ddgksf2013_bilibili.ads.js") with tag="bilibili.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BiliBiliAds/BiliUniverse_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = -broadcast.chat.bilibili.com, -cm.bilibili.com, -*cdn*.biliapi.net, -*tracker*.biliapi.net, app.bilibili.com, api.live.bilibili.com, *.bilibili.com, *.bili*.*, *.bilibili.*, grpc.biliapi.net, *biliapi.net

