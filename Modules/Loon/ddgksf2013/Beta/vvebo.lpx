#!name=vvebo
#!desc=vvebo
#!icon=icon not found
#!tag=ddgksf2013

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/users\/show\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/vvebo/bin64_vvebo.js") with tag="vvebo", timeout=60

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/vvebo/bin64_vvebo.js") with tag="vvebo", timeout=60

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/vvebo/bin64_vvebo.js") with tag="vvebo", timeout=60, requires_body=true

[MITM]
hostname = api.weibo.cn

