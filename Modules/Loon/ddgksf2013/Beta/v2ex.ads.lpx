#!name=v2ex
#!desc=v2ex
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/pagead.*googlesyndication\.com\/pagead/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/.*v2ex\.com\/pro\/emitter/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/.*v2ex\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/v2ex.ads/ddgksf2013_v2ex.ads.js") with tag="v2ex.ads", timeout=60, requires_body=true

[MITM]
hostname = *.v2ex.com, pagead*.googlesyndication.com

