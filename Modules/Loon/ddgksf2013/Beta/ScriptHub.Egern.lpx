#!name=墨鱼手记页一键添加模块
#!desc=Tab栏显示Egern，代表网页变身成功，即可一键添加模块
#!author=@ddgksf2013 @小白脸 @xream @keywos @ckyb
#!icon=icon not found
#!tag=ddgksf2013
#!webUrl=https://ddgksf2013.top
#!moduleUrl=https://ddgksf2013.top/module/ScriptHub.Egern.sgmodule

[General]
force-http-engine-hosts = script.hub, *.script.hub

[Rule]
AND,((DOMAIN-SUFFIX,ddgksf2013.top),(PROTOCOL,QUIC)),REJECT-NO-DROP

[Script]
response if ${url} ~= /^https?:\/\/ddgksf2013.top\/$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/ScriptHub.Egern/ddgksf2013_web.egern.js") with tag="网页变身", timeout=3500, requires_body=true

request if ${url} ~= /^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|all-module)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/ScriptHub.Egern/Script-Hub-Org_Rewrite-Parser.js") with tag="脚本转换", timeout=300

[MITM]
hostname = script.hub, *.script.hub, ddgksf2013.top

