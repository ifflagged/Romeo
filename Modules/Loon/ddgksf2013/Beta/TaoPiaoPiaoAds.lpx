#!name=TaoPiaoPiaoAds
#!desc=TaoPiaoPiaoAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopadvertiseapi.queryloadingbanner/i then response.json.jq(".data.returnValue={}")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.independentadvertiseapi.querypreloadadvertise/i then response.json.jq(".data.returnValue=[]")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopsearchapi.getranklistbytypeforsearch/i then response.json.jq(".data.returnValue={}")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopintegrationapi.homeconfig/i then response.json.jq(".data.returnValue={}")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopindependentadvertiseapi.queryadvertise/i then response.json.jq(".data.returnValue=[]")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.life.aristotle.get/i then response.json.jq(".data.nodes[]?.nodes |= map(select(.data.componentId | IN(\"tpp_banner_loop\", \"tpp_guess_like\") | not))")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.life.popup.get/i then response.json.jq(".data={}")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopitemadvertiseapi.queryadvertise/i then response.json.jq("del(.data.returnValue)")

[Script]
response if ${url} ~= /^http:\/\/amdc\.m\.taobao\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/TaoPiaoPiaoAds/ddgksf2013_amdc.js") with tag="amdc", timeout=60, requires_body=true

[MITM]
hostname = acs.m.taobao.com

