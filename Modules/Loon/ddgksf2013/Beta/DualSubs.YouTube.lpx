#!name=🍿️ DualSubs: ▶️ YouTube
#!desc=YouTube 增强及双语字幕(歌词)
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=ddgksf2013
#!openUrl=http://boxjs.com/#/app/DualSubs.YouTube
#!homepage=https://DualSubs.github.io/guide/youtube
#!date=2024-12-11 01:41:21
#!version=1.5.11

[Rewrite]
request if ${url} ~= /^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$/i then reject_dict(200)

[Script]
request if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js") with tag="request.bundle", timeout=60, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Composite.Subtitles.response.bundle.js") with tag="Composite.Subtitles.response.bundle", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js") with tag="Translate.response.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js") with tag="Translate.response.bundle", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js") with tag="Translate.response.bundle", timeout=60, requires_body=true

[MITM]
hostname = www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com

