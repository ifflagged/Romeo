[Rule]
DOMAIN,gwp.xiaojukeji.com,REJECT
IP-CIDR,139.199.244.6/32,REJECT,no-resolve
IP-CIDR,113.46.225.9/32,REJECT,no-resolve
IP-CIDR,139.199.244.7/32,REJECT,no-resolve
IP-CIDR,113.46.225.8/32,REJECT,no-resolve
IP-CIDR,123.207.209.39/32,REJECT,no-resolve
IP-CIDR,123.207.209.60/32,REJECT,no-resolve
IP-CIDR,139.199.240.15/32,REJECT,no-resolve
IP-CIDR,139.199.240.12/32,REJECT,no-resolve
IP-CIDR,116.85.3.37/32,REJECT,no-resolve
IP-CIDR,162.14.157.2/32,REJECT,no-resolve
IP-CIDR,162.14.157.24/32,REJECT,no-resolve
IP-CIDR,116.85.1.0/32,REJECT,no-resolve
IP-CIDR,116.85.1.17/32,REJECT,no-resolve
IP-CIDR,116.85.1.22/32,REJECT,no-resolve
IP-CIDR,116.85.3.25/32,REJECT,no-resolve

[Rewrite]
response if ${url} ~= /^https:\/\/mapi\.xiaojukeji\.com\/passenger-wallet\/api\/v6\/wallet\/homepage/i then response.json.jq("del(.data.cardList[0].detailData.myCreditLimit, .data.cardList[0].detailData.discountList[3], .data.cardList[0].detailData.discountList[4], .data.cardList[1], .data.cardList[2], .data.cardList[3], .data.cardList[4], .data.cardList[5], .data.cardList[6], .data.cardList[7], .data.cardList[8], .data.cardList[9])")
response if ${url} ~= /^https:\/\/goblin\.hupu\.com\/d\/d\.d\.d+\/interfaceAd\/getOther\/v3/i then response.json.jq(".ad_code = 0")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout/i then response.json.jq("del(.data.instances[\"xp-card-01\"])")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/passenger-center\/v2\/other\/pInTripLayout/i then response.json.jq("del(.data.order_components[8].data) | .data.order_components |= map(select(.name != \"passenger_common_casper\"))")
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v5\/usercenter\/layout/i then response.json.jq("if (.data.instances? | type) == \"object\" then   .data.instances |= del(     .center_widget_list,     .center_tool_card,     .center_marketing_card   ) else   . end | if (.data.instances?.center_wallet_finance_card?.data?.view_info | type) == \"array\" then   del(     .data.instances.center_wallet_finance_card.data.view_info[3],     .data.instances.center_wallet_finance_card.data.view_info[2],     .data.instances.center_wallet_finance_card.data.view_info[1]   ) elif (.data.instances?.center_wallet_finance_card?.data?.view_info | type) == \"object\" then   del(     .data.instances.center_wallet_finance_card.data.view_info[\"3\"],     .data.instances.center_wallet_finance_card.data.view_info[\"2\"],     .data.instances.center_wallet_finance_card.data.view_info[\"1\"]   ) else   . end")
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getMulti\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/xpget/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds/i then reject_dict(200)
request if ${url} ~= /^https:\/\/freight\.xiaojukeji\.com\/gateway/i then reject_dict(200)
request if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com:443\/gateway/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/watson\/v1\/bubble\/getBubble/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getInsActivityV2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/slow/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me/i then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Didichuxing.js") with tag="Didichuxing", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core/i then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Didichuxing.js") with tag="Didichuxing", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v1\/other\/pGetSceneList/i then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Didichuxing.js") with tag="Didichuxing", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/ota\/na\/yuantu\/infoList/i then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Didichuxing.js") with tag="Didichuxing", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/oversea\/layout/i then script("https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Didichuxing.js") with tag="Didichuxing", timeout=60, requires_body=true

[MITM]
hostname = 113.46.225.*, common.diditaxi.com.cn, freight.xiaojukeji.com, daijia.kuaidadi.com, 162.14.157.*, ct.xiaojukeji.com, res.xiaojukeji.com, conf.diditaxi.com.cn, api.udache.com, 123.207.209.*, 112.53.55.225, 120.241.142.*, 120.241.143.*, 116.85.*, 139.199.240.84

