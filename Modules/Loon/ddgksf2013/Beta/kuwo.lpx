#!name=酷我音乐
#!desc=解锁会员权限
#!author=𝐎𝐍𝐙𝟑𝐕
#!icon=icon not found
#!tag=ddgksf2013
#!tag=𝐎𝐍𝐙𝟑𝐕
#!homepage=https://github.com/Yuheng0101/X
#!openUrl=https://github.com/Yuheng0101/X
#!version=1.1.0
#!date=2025-12-22

[Script]
response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/enc\/user\/vip/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我修改会员信息", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/music(pay)?\.kuwo\.cn\/music.pay\?newver=3/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我修改音乐信息", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.+\.kuwo\.cn\/mobi\.s\?f=kwxs&q=/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我修改播放接口", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/tingshu\.kuwo\.cn\/api\/v2\/pay\/app\/getConfigInfo/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我听书伪装会员", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/tingshu\.kuwo\.cn\/v2\/api\/pay\/payInfo\/kwplayer\/payMiniBar/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我听书列表横幅", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?simpleToken=1/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我修改听书信息", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?newver=3/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我修改漫剧信息", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/(commercia\/)?vip\/(v2\/theme\?op\=gd|(player\/getStyleListByModel|hanger\/wear))/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我解锁会员皮肤", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/user\/vip/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我解锁会员信息", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/commercia\/vip\/dressCenter\/getTabList/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我去除装扮横幅", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/commercia\/vipTab\/myTab\/base/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="酷我个人信息修改", timeout=60, requires_body=true

[MITM]
hostname = *.kuwo.cn

