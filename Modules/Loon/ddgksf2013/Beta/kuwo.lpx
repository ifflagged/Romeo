#!name=kuwo
#!desc=kuwo
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/mobilead\.kuwo\.cn\/EcomResourceServer\/((getIOSIsHideAd|getMotor)\.do|adEarnGuajian\/adinfo)/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/rich\.kuwo\.cn\/(AdService|ecom)\/kaiping\/ad[iI]nfo/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v1\/user\/adVip\/info/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v1\/operate(\/(adVip|freeMode\/h5))?\/text/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/ad\.tencentmusic\.com\/config\/uni/i then reject(200, " ")
request if ${url} ~= /^https?:\/\abt-kuwo\.tencentmusic\.com\/kuwo\/ui\/info/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/enc\/user\/vip/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/music(pay)?\.kuwo\.cn\/music.pay\?newver=3/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.+\.kuwo\.cn\/mobi\.s\?f=kwxs&q=/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/tingshu\.kuwo\.cn\/api\/v2\/pay\/app\/getConfigInfo/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/tingshu\.kuwo\.cn\/v2\/api\/pay\/payInfo\/kwplayer\/payMiniBar/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?simpleToken=1/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?newver=3/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/(commercia\/)?vip\/(v2\/theme\?op\=gd|(player\/getStyleListByModel|hanger\/wear))/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/user\/vip/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/commercia\/vip\/dressCenter\/getTabList/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/commercia\/vipTab\/myTab\/base/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/commercia\/userAssets\/downloadCoupon\/reduce/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/homepages\.kuwo\.cn(\.eo\.dnse1\.com)?\/mgxh\.s/i then script("https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/kuwo.js") with tag="kuwo", timeout=60, requires_body=true

[MITM]
hostname = *.kuwo.cn, ad.tencentmusic.com, abt-kuwo.tencentmusic.com

