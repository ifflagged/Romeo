[Rewrite]
request if ${url} ~= /^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/popupWindow\/getDetail/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/newTopPullSecond\/getNewTopPullList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/emotionMarket\/getEmotionMarketNew/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/homeArea\/getTopAreaList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/navigation\/getNavigationNewInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/friendShake\/getShakeList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NoAds/Yuheng0101_NoAds.js") with tag="NoAds", timeout=60, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn

