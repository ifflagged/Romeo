#!name=SmzdmAds
#!desc=SmzdmAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/s-api.smzdm\.com\/sou\/search_default_keyword/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app-api\.smzdm\.com\/util\/loading/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*zdmimg\.com\/cpm\/api\/v\d\/advert_distribution\/get_all_advertise/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/homepage-api\.smzdm\.com\/v3\/home/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/haojia-api\.smzdm\.com\/home\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/article_releated_modul/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/baike-api\.smzdm\.com\/home_v3\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/s-api\.smzdm\.com\/sou\/list_v10/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/zhiyou\.m\.smzdm\.com\/user\/vip\/ajax_get_banner/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/SmzdmAds/ddgksf2013_smzdm_json.js") with tag="smzdm_json", timeout=60, requires_body=true

[MITM]
hostname = app-api.smzdm.com, *.zdmimg.com, homepage-api.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, baike-api.smzdm.com, s-api.smzdm.com, zhiyou.m.smzdm.com

