response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments_v3\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

