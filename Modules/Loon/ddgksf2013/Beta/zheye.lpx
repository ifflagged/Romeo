#!name=zheye
#!desc=zheye
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/118\.89\.204\.198/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/103\.41\.167\.237/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/2402:4e00:1200:ed00:0:9089:6dac:96b6/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/answer\/\d+\/bottom-v2/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/message-push\/event/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/guide_center\/strategy/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/float_window/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/metrics\/report/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/settings\/new\/notification/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/window/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/me\/guides/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/recent/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/content-distribution-core\/sections\//i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/people\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed-root\/block/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/tab\/v2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/(api|web-render)\.zhihu\.com\/topstory\/recommend/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/next-render/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/notifications\/v3\/(message|timeline\/entry\/system_message)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(comment_v5\/)?(answers|comments?|articles|pins)\/\d+\/(root_|child_)?comments?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/(page-info|api)\.zhihu\.com\/answers\/v2\/\d+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zheye/blackmatrix7_zheye.min.js") with tag="zheye.min", timeout=60, requires_body=true

