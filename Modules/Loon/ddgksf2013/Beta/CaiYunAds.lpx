#!name=CaiYunAds
#!desc=CaiYunAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/ad\.cyapi\.cn\/v\d/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/biz\.cyapi\.cn\/api\/v\d\/user_detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/biz\.cyapi\.cn\/v\d\/user/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/wrapper\.cyapi\.cn\/v\d\/activity/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.caiyunapp\.com\/v\d\/activity/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/homefeatures/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/notification\/message_center/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config\/cypage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/feeds/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/banners/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/operation\/features/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/campaigns/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CaiYunAds/ddgksf2013_caiyun_json.js") with tag="caiyun_json", timeout=60, requires_body=true

[MITM]
hostname = wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn, ad.cyapi.cn

