#!name=TieBaAds
#!desc=TieBaAds
#!icon=icon not found
#!tag=ddgksf2013

[Rule]
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[Rewrite]
response if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/search\/discover/i then response.json.jq(".data.discover_list = []")
response if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/sidebar\/home/i then response.json.jq("del(.game_center, .tools, .vip_banner, .task_list)")
response if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/u\/user\/profile/i then response.json.jq("del(.duxiaoman, .namoaixud, .namoaixud_entry, .recom_naws_list, .duxiaoman_entry, .vip_banner) | .zone_info |= map(select(.type == \"common_func\" or .type == \"auxiliary_func\"))")
response if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/forum\/forumGuide/i then response.json.jq(".hot_search = []")
response if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/mo\/q\/search\/startPage/i then response.json.jq("del(.data)")
request if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/ad\/getFeedAd/i then reject(200, " ")

[Script]
response if ${url} ~= /^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/f\/(frs\/(page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/TieBaAds/app2smile_tieba-proto.js") with tag="tieba-proto", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = tieba.baidu.com, tiebac.baidu.com

