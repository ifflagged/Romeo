[Rewrite]
request if ${url} ~= /https:\/\/tg.feidee.com\/online_ad\/api\/search.do/i then reject(200)
request if ${url} ~= /https:\/\/tg.feidee.com\/vis-ad-engine-ws\/api\/show/i then reject(200)
request if ${url} ~= /https:\/\/api.feidee.net\/v1\/configs\/client\/configs/i then reject(200, " ")
request if ${url} ~= /https:\/\/yunmk.feidee.net\/cab-market-ws\/market\/v2\/contents/i then reject_dict(200)
request if ${url} ~= /https:\/\/community.feidee.com\/api\/v1\/home\/top/i then reject(200, " ")
request if ${url} ~= /https:\/\/yun.feidee.net\/cab-query-ws\/v1\/comet\/vtable\/score-card/i then reject_dict(200)
request if ${url} ~= /https:\/\/moneymarket.ssjlicai.com\/finance-common-operation-ws\/api\/actShelve\/v1\/actShelveShowTipInfo/i then reject(200)
request if ${url} ~= /https:\/\/yun.feidee.net\/cab-draw-activity-ws\/terminal\/v1\/draw-record\/user-draw-result/i then reject_dict(200)

[MITM]
hostname = *.feidee.*, *.ssjlicai.*

