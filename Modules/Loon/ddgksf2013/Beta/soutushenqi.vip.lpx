#!name=soutushenqi
#!desc=soutushenqi
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^http?:\/\/wallpaper\.soutushenqi\.com\/v\d\/home\/dialog/i then reject(200, " ")

[Script]
response if ${url} ~= /^http?:\/\/wallpaper.soutushenqi.com\/v\d\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/soutushenqi.vip/ddgksf2013_soutushenqi.vip.js") with tag="soutushenqi.vip", timeout=60, requires_body=true

request if ${url} ~= /^http?:\/\/wallpaper.soutushenqi.com\/v\d\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/soutushenqi.vip/Script-Hub-Org_replace-body.js", "config_key%3Dstsq_ios_home_vipI-%3Econfig_key%3D") with tag="replaceBody", timeout=30, requires_body=true

response if ${url} ~= /^http?:\/\/wallpaper\.soutushenqi\.com\/api\/v\d\/account/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/soutushenqi.vip/ddgksf2013_soutushenqi.vip.js") with tag="soutushenqi.vip", timeout=60, requires_body=true

[MITM]
hostname = wallpaper.soutushenqi.com

