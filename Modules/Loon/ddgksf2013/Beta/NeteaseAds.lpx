#!name=NeteaseAds
#!desc=NeteaseAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/resource-exposure\/config/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/home\/framework\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/NeteaseAds/ddgksf2013_netease.adblock.js") with tag="netease.adblock", timeout=60, requires_body=true

