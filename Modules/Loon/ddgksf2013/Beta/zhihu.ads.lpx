#!name=zhihu
#!desc=zhihu
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
response if ${url} ~= /^https?:\/\/.*zhihu.com\/(answers|articles)\/v\d/i then response.json.jq(".third_business |= del(.related_queries, .ring)")
request if ${url} ~= /^https?:\/\/118\.89\.204\.198/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/103\.41\.167\.237/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/2402:4e00:1200:ed00:0:9089:6dac:96b6/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/brand\/question\/\d+\/card\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d+\/brand\/question\/\d+\/card\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/tab_v2/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/answers\/\d+\/recommendations/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/me\/guides/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/recent/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/current_reading/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*zhihu\.com\/commercial_api/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*zhihu\.com\/ad-style-service\/request/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/articles\/\d+\/recommendation/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/profile\/cards/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/drama\/hot-drama-list/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/topics\/rank_list\/question\/\d+\/related/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/app_float_layer/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/answer\//i then reject_dict(200)
request if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/v2\/resolv/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/window/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/appview\/v\d\/zhmore/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/unlimited\/go\/my_card/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zhihu.ads/ddgksf2013_zhihu.ads.js") with tag="zhihu.ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api.*launch_v2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/zhihu.ads/ddgksf2013_zhihu.ads.js") with tag="zhihu.ads", timeout=60, requires_body=true

