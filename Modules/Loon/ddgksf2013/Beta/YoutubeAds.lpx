#!name=YoutubeAds
#!desc=YoutubeAds
#!icon=icon not found
#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+)/i then redirect(302, "$1$2$3")
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking)/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/YoutubeAds/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com

