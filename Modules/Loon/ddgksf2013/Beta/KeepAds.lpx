#!tag=ddgksf2013

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d\/popup\/getPopUp/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/running\/v\d\/home\/dialog/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/kprime\/v\d\/popups\/primeGuide/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/hc-ssp\.sm\.cn/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api.gotokeep.com\/cauchy\/growth\/init/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/default\/keyword\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotword\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotHashtag\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotCourse\/list/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/ads\/v\d\/ads\/preload/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/training\/box\/config/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/anno\/v\d\/upgrade\/check/i then reject(200, " ")

[Script]
response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/athena\/v\d\/people\/my$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/KeepAds/ddgksf2013_keepStyle.js") with tag="keepStyle", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/config\/v\d\/basic/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/KeepAds/ddgksf2013_keepStyle.js") with tag="keepStyle", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/course/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/KeepAds/ddgksf2013_keepStyle.js") with tag="keepStyle", timeout=60, requires_body=true

