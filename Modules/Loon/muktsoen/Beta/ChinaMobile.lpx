#!name=中国移动去广告
#!desc=由 ccyykk666 的 Loon 插件移植而来，Surge 可用。含 AES 垫片（模拟 Loon 的 $crypto.aes）与 8 个开关。
#!author=ccyykk666
#!icon=icon not found
#!tag=muktsoen

[Argument]
HideTopFamily=switch,false,true,tag=HideTopFamily, desc=HideTopFamily
HideTopAge=switch,false,true,tag=HideTopAge, desc=HideTopAge
HideTopPhone=switch,false,true,tag=HideTopPhone, desc=HideTopPhone
HideTopNearby=switch,false,true,tag=HideTopNearby, desc=HideTopNearby
HideTopAI=switch,false,true,tag=HideTopAI, desc=HideTopAI
HideTopEnterprise=switch,false,true,tag=HideTopEnterprise, desc=HideTopEnterprise
BottomClean=switch,true,false,tag=BottomClean, desc=BottomClean
MineClean=switch,true,false,tag=MineClean, desc=MineClean

[Script]
response if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|multipleInterfaces\/aggregationData|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-homepage", requires_body=true

response if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/getNavigation(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-navigation", requires_body=true

response if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/bottomNavigationService\/getNavigationInfo(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-bottomnav", requires_body=true

response if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/myPageNew\/getMyPageNew(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-mypage", requires_body=true

response if ${url} ~= /^https:\/\/(?:h\.app\.coc\.10086\.cn\/biz-orange\/(?:DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)|DA\/baseServiceFunction\/getAdverList)|app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-h5", requires_body=true

response if ${url} ~= /^https:\/\/touch\.10086\.cn\/i\/v1\/cust\/(?:aiMainQry|iopBatchQry)\/[^?]+(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-recharge", requires_body=true

response if ${url} ~= /^https:\/\/touch\.10086\.cn\/i\/v1\/pay\/popWindowQry\/[^?]+(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-popwindow", requires_body=true

response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile.js", "HideTopFamily:{HideTopFamily};HideTopAge:{HideTopAge};HideTopPhone:{HideTopPhone};HideTopNearby:{HideTopNearby};HideTopAI:{HideTopAI};HideTopEnterprise:{HideTopEnterprise};BottomClean:{BottomClean};MineClean:{MineClean}") with tag="CM-adfilter", requires_body=true

request if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule)|DH\/toast\/august\/getToast|DA\/liveSuspension\/getPageCode)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile-request.js") with tag="CM-reject"

request if ${url} ~= /^https?:\/\/res\.app\.coc\.10086\.cn\/qwhdcdn_cmcc-cs_cn\/prd-mgcenter\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/muktsoen/ChinaMobile/muktsoen_ChinaMobile-request.js") with tag="CM-splash"

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn, ad.mcloud.139.com, res.app.coc.10086.cn

