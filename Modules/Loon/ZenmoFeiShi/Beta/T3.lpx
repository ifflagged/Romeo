[Rewrite]
response if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/solution-passenger-api\/notoken\/trip\/api\/solution\/passenger\/open\/getHomeMenuList/i then response.json.jq(".data.baseMenuList |= map(select(.menuId == \"100001\" or .menuId == \"100018\" or .menuId == \"100046\")) | .data.subMenuList = []")
response if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/notoken\/api\/v\d\/ad\/getNegativescreen/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/notoken\/api\/v\d\/ad\/getActivityPopup/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/notoken\/api\/v\d\/ad\/getNotices/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/notoken\/api\/v\d\/resourceLocation\/floating/i then response.json.jq(".data = null")
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/ad\/act\/v1\/notoken\/popup/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/ad\/act\/v1\/notoken\/negativeScreen/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/open-app-api\/api\/intime\/push\/offline\/pull/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/ad\/act\/v1\/notoken\/addressUp/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/v1\/ad\/getNotices/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/notoken\/api\/v1\/resource\/getPageSceneListData/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/v1\/resource\/getTripRemind/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/common-app-api\/api\/passenger\/v1\/getCardInfo/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-activity-api\/api\/v3\/resource\/bottom/i then reject_dict(200)
request if ${url} ~= /^https:\/\/passenger\.t3go\.cn(:\d+)?\/passenger-app-api\/notoken\/api\/home\/v\d\/leftmenu/i then reject_dict(200)
request if ${url} ~= /^http:\/\/.+\/resolve/i then reject(200)

[MITM]
hostname = *.t3go.cn, 124.71.144.189, 123.60.34.69, 121.36.220.180, 121.37.134.39

