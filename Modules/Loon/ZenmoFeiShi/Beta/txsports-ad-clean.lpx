#!name=腾讯体育净化
#!desc=去除开屏广告、优化我的页面、去除底部会员tap、优化首页展示、去除搜索热词
#!author=TG@ZenMoFiShi
#!icon=icon not found
#!tag=ZenmoFeiShi
#!update=2026-11-1

[Script]
response if ${url} ~= /^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js") with tag="txsports-ad-clean", timeout=60, requires_body=true

[MITM]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com

