[Script]
request if ${url} ~= /^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/PingMe/ZenmoFeiShi_PingMe.js") with tag="PingMe", timeout=60

cron "30 8,20 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/PingMe/ZenmoFeiShi_PingMe.js") with tag="PingMe签到", timeout=120

[MITM]
hostname = api.pingmeapp.net

