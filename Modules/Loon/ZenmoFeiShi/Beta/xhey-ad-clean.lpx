#!name=XCamera广告净化合集
#!desc=今日水印专业版3.0.186全局关广告开关、TopOn/百度/快手/CLL广告请求拦截。作者：TG@ZenMoFiShi
#!icon=icon not found
#!tag=ZenmoFeiShi

[Rewrite]
request if ${url} ~= /^https?:\/\/(?:api|da|tk|adx)\.anythinktech\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/api\.toponadss\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/mobads(?:-logs)?\.baidu\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/mobads-pre-config\.(?:bj|cdn)\.bcebos\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/open\.e\.kuaishou\.(?:com|cn)\//i then reject(200)
request if ${url} ~= /^https?:\/\/stage2\.chelaile\.net\.cn\/sdk/i then reject(200)
request if ${url} ~= /^https?:\/\/ad\.xhey\.top\/next\/(?:app\/adx\/|promote\/operation\/appstart\/adx\/|ad\/event\/track\/).*/i then reject(200)
request if ${url} ~= /^https?:\/\/39\.108\.85\.131\/next\/(?:ios\/config\/cache|promote\/operation\/config\/get\/cache)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config\/v2a|req_ad)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/adx-strategy-api-cn\.statisticslinks\.com\/sdk\/pl_strategy(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/adx-micro\.statisticslinks\.com\/http_bid(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/da\.statisticslinks\.com\/v1\/open\/da(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/tk\.statisticslinks\.com\/v2\/open\/a_tk(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/sdkquic\.e\.qq\.com\/launch(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/als\.baidu\.com\/clog\/glog(?:\?.*)?$/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/abtest-tx-beijing-01\.saas\.sensorsdata\.cn\/api\/v2\/abtest\/online\/results\?project-key=(?:0E6053C30A799D63EFA48959776B2EE2EDC81359|EE39C73914ED208E6EBE24A7333CAF5C3FE2E89D)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xhey-ad-clean/ZenmoFeiShi_xhey-ad-clean.js") with tag="xhey-ad-clean", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/jt-sdk-ios\.oss-cn-beijing\.aliyuncs\.com\/iOSConfig\.txt(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xhey-ad-clean/ZenmoFeiShi_xhey-ad-clean.js") with tag="xhey-ad-clean", timeout=60, requires_body=true

[MITM]
hostname = abtest-tx-beijing-01.saas.sensorsdata.cn, api.anythinktech.com, da.anythinktech.com, tk.anythinktech.com, adx.anythinktech.com, api.toponadss.com, mobads.baidu.com, mobads-logs.baidu.com, mobads-pre-config.bj.bcebos.com, mobads-pre-config.cdn.bcebos.com, open.e.kuaishou.com, open.e.kuaishou.cn, stage2.chelaile.net.cn, ad.xhey.top, 39.108.85.131, sdk.1rtb.net, adx-strategy-api-cn.statisticslinks.com, adx-micro.statisticslinks.com, da.statisticslinks.com, tk.statisticslinks.com, sdkquic.e.qq.com, als.baidu.com, jt-sdk-ios.oss-cn-beijing.aliyuncs.com

