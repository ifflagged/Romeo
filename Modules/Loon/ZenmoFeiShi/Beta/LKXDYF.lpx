cron "1 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/LKXDYF/ZenmoFeiShi_LKXDYF.js") with tag="老百姓大药房签到", timeout=120

[MITM]
hostname = mall.lbxcn.com

