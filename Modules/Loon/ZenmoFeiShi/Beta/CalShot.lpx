[Script]
http-request ^https:\/\/calshotapi\.sdtsdt\.net\/api\/v1\/(check-ins\/statistics|co-builder\/profile) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/CalShot/ZenmoFeiShi_CalShot.js, timeout=60, tag=CalShot

cron "1 8 * * *" script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/CalShot/ZenmoFeiShi_CalShot.js, timeout=120, tag=CalShot每日打卡

[MITM]
hostname = calshotapi.sdtsdt.net

