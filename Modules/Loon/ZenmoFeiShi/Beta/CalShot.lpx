#!name=CalShot
#!desc=CalShot
#!icon=icon not found
#!tag=ZenmoFeiShi

[Script]
request if ${url} ~= /^https:\/\/calshotapi\.sdtsdt\.net\/api\/v1\/(check-ins\/statistics|co-builder\/profile)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/CalShot/ZenmoFeiShi_CalShot.js") with tag="CalShot", timeout=60

cron "1 8 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/CalShot/ZenmoFeiShi_CalShot.js") with tag="CalShot每日打卡", timeout=120

[MITM]
hostname = calshotapi.sdtsdt.net

