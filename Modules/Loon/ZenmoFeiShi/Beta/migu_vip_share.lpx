[Script]
request if ${url} ~= /^https?:\/\/(play|play-pre|v|v[0-9]?-sc|vmesh|app-sc|vms-sc|display(-sc)?|common-sc|program-sc|d[0-9]-sc|fs-sc|fsdv-sc|mp-user|recommend-dy|chat|chat-wx|public-deliver[0-9]?|public-operbiz[0-9]?|public-img)\.miguvideo\.com\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/migu_vip_share/ZenmoFeiShi_migu_vip.js") with tag="migu_vip", timeout=60

request if ${url} ~= /^https?:\/\/(passport|uem|push|jadeite|jadeiteapp|hound|feedback|rcsdk)\.migu\.cn\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/migu_vip_share/ZenmoFeiShi_migu_vip.js") with tag="migu_vip", timeout=60

[MITM]
hostname = *.miguvideo.com, *.migu.cn

