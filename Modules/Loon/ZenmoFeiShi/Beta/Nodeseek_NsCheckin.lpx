#!name=Nodeseek_NsCheckin
#!desc=Nodeseek_NsCheckin
#!icon=icon not found
#!tag=ZenmoFeiShi

[Script]
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/\d+\?readme=1$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Nodeseek_NsCheckin/ZenmoFeiShi_Nodeseek_NsCheckin.js") with tag="Nodeseek_NsCheckin", timeout=60

cron "1 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Nodeseek_NsCheckin/ZenmoFeiShi_Nodeseek_NsCheckin.js") with tag="NS🍗签到", timeout=120, img_url=", img-url=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Nodeseek_NsCheckin/fmz200_ZenMoFeiShi.js"

[MITM]
hostname = www.nodeseek.com

