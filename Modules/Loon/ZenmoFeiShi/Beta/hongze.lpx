[Script]
request if ${url} ~= /^https:\/\/app\.hongze\.net\/mag\/user\/v1\/User\/getUserInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/hongze/ZenmoFeiShi_hongze.js") with tag="hongze", timeout=60

cron "8 1 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/hongze/ZenmoFeiShi_hongze.js") with tag="洪泽论坛签到", timeout=120

[MITM]
hostname = app.hongze.net

