#!name=YouTube 强制简体中文字幕
#!desc=Yt-zh
#!author=@ZenmoFeiShi
#!icon=icon not found
#!tag=ZenmoFeiShi

[Script]
request if ${url} ~= /^https:\/\/www\.youtube\.com\/api\/timedtext\?.*_ytzhsub=1/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Yt-zh/ZenmoFeiShi_yt-sub-clean.js") with tag="yt-sub-clean", timeout=60

response if ${url} ~= /^https:\/\/www\.youtube\.com\/api\/timedtext\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/Yt-zh/ZenmoFeiShi_yt-zh-sub.js") with tag="yt-zh-sub", timeout=60, requires_body=true

[MITM]
hostname = www.youtube.com

