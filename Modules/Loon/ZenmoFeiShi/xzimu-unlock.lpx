response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xzimu-unlock/ZenmoFeiShi_xzimu-unlock.js") with tag="xzimu-unlock", timeout=60, requires_body=true

request if ${url} ~= /^http:\/\/47\.251\.39\.178:18080\/task\/runSegment/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/xzimu-unlock/ZenmoFeiShi_xzimu-unlock.js") with tag="xzimu-unlock", timeout=60, requires_body=true

