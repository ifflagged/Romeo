#!name=mixc_signin
#!desc=mixc_signin
#!icon=icon not found
#!tag=ZenmoFeiShi

[Script]
request if ${url} ~= /^https?:\/\/app\.mixcapp\.com\/mixc\/gateway/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/mixc_signin/ZenmoFeiShi_mixc_signin.js") with tag="mixc_signin", timeout=60, requires_body=true

cron "1 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/mixc_signin/ZenmoFeiShi_mixc_signin.js") with tag="一点万象签到", timeout=120

[MITM]
hostname = app.mixcapp.com

