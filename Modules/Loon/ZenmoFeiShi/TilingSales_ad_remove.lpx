[Rewrite]
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/splashInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/noticeInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/IndexList\/homeFloatAd/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/activityInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/skitAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/countPopTotal/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsUserAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/ad\/config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/vajraInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/bannerInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/bardCacheAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsIndexAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/comicAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/liveEventAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/novelAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/sportAdInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/CommentAd\/show/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Config\/getNav/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/barsPlayAdInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Ad\/playAdInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/IndexPlay\/vodAdvertisement/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/showOne/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/[\w.-]+\/App\/Resource\/Vod\/vurlDetail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/TilingSales_ad_remove/ZenmoFeiShi_TilingSales_getNav.js") with tag="TilingSales_getNav", timeout=60, requires_body=true

