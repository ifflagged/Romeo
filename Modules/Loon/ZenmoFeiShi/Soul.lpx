#!name=Soul净化
#!desc=Soul
#!author=怎么肥事  感谢@可莉对去除开屏广告提供的帮助
#!icon=icon not found
#!tag=ZenmoFeiShi
#!update=2026-4-14

[Rewrite]
response if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/v2\/post\/gift\/list/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/hot\/soul\/rank/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/gateway-mobile-gray\.soulapp\.cn\/mobile\/app\/version\/queryIos/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/i then response.json.jq(".data.limit = false")
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/api-account\.soulapp\.cn\/teenager\/config/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module/i then response.json.jq(".data = null")
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList/i then response.json.jq(".data.roomList = []")
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config/i then response.json.jq(".data.gameInfo.gameCards |= map(select(.title != \"异世界回响\" and .title != \"狼人魅影\" and .title != \"梦想海岛王\" and .title != \"幻想星球\" and .title != \"爆弹喵\" and .title != \"星球实验室\" and .title != \"兴趣群组\" and .title != \"群聊派对\")) | .data.coreCards |= map(select(.title != \"异世界回响\" and .title != \"狼人魅影\" and .title != \"梦想海岛王\" and .title != \"幻想星球\" and .title != \"爆弹喵\" and .title != \"星球实验室\" and .title != \"兴趣群组\" and .title != \"群聊派对\") | if .secondCards then .secondCards |= map(select(.title != \"异世界回响\" and .title != \"狼人魅影\" and .title != \"梦想海岛王\" and .title != \"幻想星球\" and .title != \"爆弹喵\" and .title != \"星球实验室\" and .title != \"兴趣群组\" and .title != \"群聊派对\")) else . end | if .style == 2 then .style = 1 else . end)")
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v2\/post\/recSquare\/subTabs/i then response.json.jq(".data |= map(select(.tabType == 7 or .tabType == 6 or .tabType == 2))")
request if ${url} ~= /^https:\/\/ssp\.soulapp\.cn\/api\/q/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu\/v2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/attach\/menu/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first/i then reject_dict(200)
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2/i then reject(200, " ")

[MITM]
hostname = api-account.soulapp.cn, chat-live.soulapp.cn, api-a.soulapp.cn, api-pay.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-chat.soulapp.cn, 120.55.55.115, 120.55.62.124, 121.196.203.183, 47.96.20.45, 47.98.54.106, 118.31.112.221, 8.210.3.170, 47.75.72.47, post.soulapp.cn, api-user.soulapp.cn, ssp.soulapp.cn, 47.110.187.87

