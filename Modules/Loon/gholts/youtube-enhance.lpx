#!name=YouTube Enhance
#!desc=Block ads. Enable background play, PiP and up to 4x speed.\nBased on Maasea's code (Apache-2.0).
#!icon=icon not found
#!tag=gholts
#!arguments-desc=block_upload\n  └ Remove upload tab\nblock_shorts\n  └ Remove Shorts tab\nauto_hd\n  └ Prefer high video quality\nblock_games\n  └ Remove Playables on homepage\nblock_vertical_live\n  └ Remove Vertical live on homepage\njump_ahead\n  └  Enable Jump Ahead button\nblock_store\n  └  Remove creator stores, product cards and overlays
#!requirement=SYSTEM = 'iOS'

[Argument]
block_upload=switch,"true","false",tag=block_upload, desc=block_upload
block_shorts=switch,"false","true",tag=block_shorts, desc=block_shorts
auto_hd=switch,"true","false",tag=auto_hd, desc=auto_hd
block_games=switch,"true","false",tag=block_games, desc=block_games
block_vertical_live=switch,"false","true",tag=block_vertical_live, desc=block_vertical_live
jump_ahead=switch,"true","false",tag=jump_ahead, desc=jump_ahead
block_store=switch,"true","false",tag=block_store, desc=block_store

[Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[Script]
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, tag=youtube.enhance.ad-break

http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_response.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.response, argument="{"blockUpload":{block_upload},"blockShorts":{block_shorts},"blockGames":{block_games},"blockVerticalLive":{block_vertical_live},"jumpAhead":{jump_ahead},"autoHd":{auto_hd},"blockStore":{block_store}}"

http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_key.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.key

http-response ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_ump.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.ump, argument="{"blockGames":{block_games},"blockVerticalLive":{block_vertical_live},"jumpAhead":{jump_ahead},"autoHd":{auto_hd},"blockStore":{block_store}}"

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.init

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.auto-hd, argument="{"autoHd":{auto_hd}}"

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, tag=youtube.enhance.log-event

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com

