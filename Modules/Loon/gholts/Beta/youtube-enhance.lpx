#!name=YouTube Enhance
#!desc=Remove YouTube ads and enable background playback, Picture in Picture, and up to 4x speed.\nOptions can hide unwanted sections, prefer the highest quality, and enable Jump Ahead.\nBased on Maasea's code (Apache-2.0).
#!icon=icon not found
#!tag=gholts
#!requirement=SYSTEM = 'iOS'

[Argument]
blockUpload=switch,true,false,tag=Hide the Uploads entry from YouTube navigation., desc=Hide the Uploads entry from YouTube navigation.
blockShorts=switch,false,true,tag=Hide the Shorts entry from YouTube navigation., desc=Hide the Shorts entry from YouTube navigation.
autoHd=switch,true,false,tag=Prefer the highest available video quality and prevent automatic downgrades., desc=Prefer the highest available video quality and prevent automatic downgrades.
blockGames=switch,true,false,tag=Hide YouTube Playables recommendations., desc=Hide YouTube Playables recommendations.
blockVerticalLive=switch,false,true,tag=Hide vertical live recommendations across YouTube layouts., desc=Hide vertical live recommendations across YouTube layouts.
jumpAhead=switch,true,false,tag=Enable YouTube's native Jump Ahead button without its promotion., desc=Enable YouTube's native Jump Ahead button without its promotion.
blockStore=switch,true,false,tag=Hide creator stores and shopping sections under videos and on channel profiles., desc=Hide creator stores and shopping sections under videos and on channel profiles.
nativeDownload=switch,false,true,tag=Experimental native downloads; use 720p if quality is unset. Server restrictions may still apply., desc=Experimental native downloads; use 720p if quality is unset. Server restrictions may still apply.

[Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[Script]
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, tag=youtube.enhance.ad-break

http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_response.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.download, argument=[{nativeDownload}]

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.download-player, argument=[{nativeDownload}]

http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_response.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.response, argument=[{blockUpload},{blockShorts},{blockGames},{blockVerticalLive},{jumpAhead},{autoHd},{blockStore}]

http-response ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_response.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.ump, argument=[{blockGames},{blockVerticalLive},{jumpAhead},{autoHd},{blockStore}]

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.init

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.auto-hd, argument=[{autoHd}]

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/gholts/youtube-enhance/gholts_request.js, requires-body=true, binary-body-mode=true, tag=youtube.enhance.log-event

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, *.youtube.com

