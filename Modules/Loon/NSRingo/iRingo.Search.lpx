#!name= iRingo: 🔍 Search
#!desc=iOS 17.6⬇️\n全面自定义「Siri 建议」功能。\n⚠️ 不含自定义「询问 Siri」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Spotlight
#!homepage=https://NSRingo.github.io/guide/Siri/spotlight
#!date=2024-12-24 04:25:10
#!version=4.2.7

[Script]
# 🔍 Search Bag (iOS/macOS)
http-request ^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60, tag=request.bundle

http-response ^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_response.bundle.js, requires-body=true, timeout=60, tag=response.bundle

# 🔍 Siri Suggestions & Look Up Search (iOS/macOS)
http-request ^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/search script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60, tag=request.bundle

# 🔍 Search Infomation Card (macOS)
http-request ^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/card script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60, tag=request.bundle

# 🔍 Search Flight Search (iOS/macOS)
http-request ^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/flight script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60, tag=request.bundle

[MITM]
hostname = api*.smoot.apple.com, api.smoot.apple.cn

