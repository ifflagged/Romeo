#!name= iRingo: ⭕ Siri
#!desc=iOS 18⬆️ & macOS 15⬆️\n全面自定义「Siri 请求」功能。\n⚠️ 不含自定义「Siri 建议」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Siri
#!homepage=https://NSRingo.github.io/guide/Siri/siri
#!date=2024-12-24 04:25:06
#!version=4.2.7

[Script]
request if ${url} ~= /^https?:\/\/(api-siri|api2|api-.+)\.smoot\.apple\.com\/search/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60

request if ${url} ~= /^https?:\/\/(guzzoni|api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.siri\.v2alpha\.SiriSearch\/SiriSearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/api-safari(-.+)?\.smoot\.apple\.com\/apple\.parsec\.safari\.v1alpha\.SafariSearch\/SafariSearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/api-lookup(-.+)?\.smoot\.apple\.com\/apple\.parsec\.lookup\.v1alpha\.LookupSearch\/LookupSearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/(api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.visualsearch\.v2\.VisualSearch\/VisualSearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.responseframework\.engagement\.v1alpha\.EngagementSearch\/EngagementSearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.spotlight\.v1alpha\.ZkwSuggestService\/Suggest/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Siri/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60, requires_body=true

[MITM]
hostname = guzzoni.smoot.apple.com, api2.smoot.apple.com, api-*.smoot.apple.com

