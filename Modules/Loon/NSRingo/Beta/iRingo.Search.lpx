#!name= iRingo: 🔍 Search
#!desc=iOS 17.6⬇️\n全面自定义「Siri 建议」功能。\n⚠️ 不含自定义「询问 Siri」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Spotlight
#!homepage=https://NSRingo.github.io/guide/Siri/spotlight
#!date=2024-12-24 04:25:10
#!version=4.2.7

[Script]
request if ${url} ~= /^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60

response if ${url} ~= /^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_response.bundle.js") with tag="response.bundle", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/search/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60

request if ${url} ~= /^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/card/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60

request if ${url} ~= /^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/flight/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js") with tag="request.bundle", timeout=60

[MITM]
hostname = api*.smoot.apple.com, api.smoot.apple.cn

