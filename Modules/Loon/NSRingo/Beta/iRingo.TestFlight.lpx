#!name= iRingo: ✈ TestFlight
#!desc=1.自定义TestFlight登录商店地区\n2.多账户保存及切换(需配置BoxJs使用)\n3.让通用应用在任意苹果处理器设备上可安装
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.TestFlight
#!homepage=https://NSRingo.github.io/guide/test-flight
#!date=2024-12-24 08:53:51
#!version=3.4.0

[General]
skip-proxy = iosapps.itunes.apple.com

[Script]
request if ${url} ~= /^https?:\/\/testflight\.apple\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_request.bundle.js") with tag="✈ TestFlight.request", requires_body=true

response if ${url} ~= /^https?:\/\/testflight\.apple\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_response.bundle.js") with tag="✈ TestFlight.response", requires_body=true

[MITM]
hostname = testflight.apple.com

