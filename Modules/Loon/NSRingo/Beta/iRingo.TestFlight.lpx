#!name= iRingo: ✈ TestFlight
#!desc=1.自定义TestFlight登录商店地区\n2.多账户保存及切换(需配置BoxJs使用)\n3.让通用应用在任意苹果处理器设备上可安装
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Jacob
#!openUrl=http://boxjs.com/#/app/iRingo.TestFlight
#!homepage=https://NSRingo.github.io/guide/test-flight
#!date=2024-12-24 08:53:51
#!version=3.4.0

[Argument]
CountryCode=input,"US",tag=国家或地区代码, desc=国家或地区代码\n    ├ AUTO: 🇺🇳自动（跟随地区检测结果）\n    ├ CN: 🇨🇳中国大陆\n    ├ HK: 🇭🇰香港\n    ├ TW: 🇹🇼台湾\n    ├ SG: 🇸🇬新加坡\n    ├ US: 🇺🇸美国\n    ├ JP: 🇯🇵日本\n    ├ AU: 🇦🇺澳大利亚\n    ├ GB: 🇬🇧英国\n    ├ KR: 🇰🇷韩国\n    ├ CA: 🇨🇦加拿大\n    └ IE: 🇮🇪爱尔兰\n不同国家或地区提供的内容或有差别。
MultiAccount=switch,false,true,tag=启用多账号支持, desc=启用多账号支持\n启用多账号支持会自动保存保存更新当前账号信息。
Universal=switch,true,false,tag=启用通用应用支持, desc=启用通用应用支持\n启用通用应用支持会解除 TestFlight app 的 iOS/iPadOS/macOS(AppleSilicon) 平台限制。
AlwaysShowInstall=switch,false,true,tag=总是显示安装选项, desc=总是显示安装选项\n当 Testflight 无法加入时，也总是显示app详情页面的安装选项。
MergeNotifications=switch,false,true,tag=合并通知开关, desc=合并通知开关\n同步开关全平台的电子邮件通知，如关闭 iOS 的 Testflight 更新电子邮件通知，也会同时关闭 tvOS 的 Testflight 更新电子邮件通知。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 🔴 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[General]
skip-proxy = iosapps.itunes.apple.com

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_request.bundle.js, requires-body=true, tag=✈ TestFlight.request, argument=[{CountryCode},{MultiAccount},{Universal},{AlwaysShowInstall},{MergeNotifications},{LogLevel}]

http-response ^https?:\/\/testflight\.apple\.com\/ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_response.bundle.js, requires-body=true, tag=✈ TestFlight.response, argument=[{CountryCode},{MultiAccount},{Universal},{AlwaysShowInstall},{MergeNotifications},{LogLevel}]

[MITM]
hostname = testflight.apple.com

