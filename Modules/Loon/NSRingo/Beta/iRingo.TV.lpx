#!name= iRingo: 📺 TV app
#!desc=全面自定义「TV app」功能
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.TV
#!homepage=https://NSRingo.github.io/guide/apple-tv
#!date=2025-04-17 03:19:05
#!version=3.4.4

[Argument]
ThirdParty=switch,false,true,tag=启用第三方 App 与 TV app 关联功能, desc=启用第三方 App 与 TV app 关联功能\n是否将桌面版/macOS版/app版等平台的 TV app 转换至 iPad 版，以启用第三方 App 与 TV app 关联功能(如: Disney+, Prime Video 等)。
isWorkaroundSSLPinning=switch,true,false,tag=启用绕过 SSL 证书固定校验, desc=启用绕过 SSL 证书固定校验\n是否绕过播放列表所使用域名的证书固定校验功能，从而恢复对DualSubs的双语字幕支持。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 🔴 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
DOMAIN,known-issues.apple.com,REJECT-DROP

[Rewrite]
request if ${url} ~= /^https?:\/\/play-cdn\.itunes\.apple\.com/i then url.replace("https://play.itunes.apple.com")
request if ${url} ~= /^https?:\/\/play-edge-cdn\.itunes\.apple\.com/i then url.replace("https://play-edge.itunes.apple.com")

[Script]
request if ${url} ~= /^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_request.bundle.js", {${ThirdParty}, ${isWorkaroundSSLPinning}, ${LogLevel}}) with tag="📺 TV.uts.request", requires_body=true

response if ${url} ~= /^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_response.bundle.js", {${ThirdParty}, ${isWorkaroundSSLPinning}, ${LogLevel}}) with tag="📺 TV.uts.response", requires_body=true

request if ${url} ~= /^https?:\/\/umc-tempo-api\.apple\.com\/(v1|v2|v3)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_request.bundle.js") with tag="📺 TV.umc.request", requires_body=true

[MITM]
hostname = uts-api.itunes.apple.com, umc-tempo-api.apple.com, play-cdn.itunes.apple.com, play-edge-cdn.itunes.apple.com

