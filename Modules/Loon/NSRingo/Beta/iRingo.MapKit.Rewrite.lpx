#!name= iRingo: 🗺️ MapKit (Rewrite)
#!desc=自定义 Maps app\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!homepage=https://NSRingo.github.io/guide/GeoServices/maps

[Rule]
DOMAIN-SUFFIX,is.autonavi.com,DIRECT
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT

[Rewrite]
request if ${url} ~= /^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults/i then url.replace("https://{endpoint}/config/defaults")
request if ${url} ~= /^https?:\/\/gspe35-ssl\.ls\.apple\.com\/config\/announcements/i then url.replace("https://{endpoint}/config/announcements")
request if ${url} ~= /^https?:\/\/gspe35-ssl\.ls\.apple\.com\/geo_manifest\/dynamic\/config/i then url.replace("https://{endpoint}/geo_manifest/dynamic/config")

[MITM]
hostname = configuration.ls.apple.com, gspe35-ssl.ls.apple.com

