#!name= iRingo: 📍 LocationService
#!desc=自定义定位服务内容\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.LocationService
#!homepage=https://NSRingo.github.io/guide/GeoServices/location-service
#!date=2025-10-24 08:48:41
#!version=1.0.1

[Rule]
# 📍 Country Code
DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
# 📍 Amap Dispatcher
DOMAIN,dispatcher.is.autonavi.com,DIRECT

[Script]
# 📍 Country Code
http-response ^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_request.bundle.js, requires-body=true, timeout=60, tag=request.bundle

# 📍 Dispatcher
http-request ^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_request.bundle.js, requires-body=true, timeout=60, tag=request.bundle

http-response ^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.LocationService/NSRingo_response.bundle.js, requires-body=true, timeout=60, tag=response.bundle

[MITM]
hostname = gspe1-ssl.ls.apple.com, dispatcher.is.autonavi.com

