[Rewrite]
response if ${url} ~= /^https?:\/\/portal-xunyou\.qingcdn\.com\/api\/v\d\/ios\/ads\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/portal-xunyou\.qingcdn\.com\/api\/v\d\/ios\/configs\/(?>splash_ad|ad_urls)/i then response.body.mock("text", "", 200)

[MITM]
hostname = portal-xunyou.qingcdn.com

