#!name=芒果TV
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partM/MangoTV.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,dflow.bz.mgtv.com,REJECT
DOMAIN,encounter.bz.mgtv.com,REJECT
DOMAIN,floor.bz.mgtv.com,REJECT
DOMAIN,img.da.mgtv.com,REJECT
DOMAIN,layer.bz.mgtv.com,REJECT
DOMAIN,mob.bz.mgtv.com,REJECT
DOMAIN,mobile.da.mgtv.com,REJECT
DOMAIN,rc-topic-api.bz.mgtv.com,REJECT
DOMAIN,v2.da.mgtv.com,REJECT
DOMAIN,video.da.mgtv.com,REJECT
DOMAIN,vip.bz.mgtv.com,REJECT
DOMAIN,ys.da.mgtv.com,REJECT
DOMAIN-SUFFIX,mobile2.da.mgtv.com,REJECT
DOMAIN-SUFFIX,cdn.cmop.mgtv.com,REJECT
DOMAIN-SUFFIX,cmop.mgtv.com,REJECT
DOMAIN-SUFFIX,imgaliyun.da.mgtv.com,REJECT
DOMAIN-SUFFIX,imgaliyun.res.mgtv.com,REJECT
DOMAIN-SUFFIX,m2.da.mgtv.com,REJECT
DOMAIN-SUFFIX,mobaliyun.res.mgtv.com,REJECT
DOMAIN-SUFFIX,pc.da.mgtv.com,REJECT
DOMAIN-SUFFIX,pc1.da.mgtv.com,REJECT
DOMAIN-SUFFIX,pcvideoaliyun.titan.mgtv.com,REJECT
DOMAIN-SUFFIX,pcvideoyd.titan.mgtv.com,REJECT
DOMAIN-SUFFIX,pcweb.v1.mgtv.com,REJECT
DOMAIN-SUFFIX,py.da.mgtv.com,REJECT
DOMAIN-SUFFIX,web.da.mgtv.com,REJECT
DOMAIN-SUFFIX,x.da.mgtv.com,REJECT
DOMAIN-SUFFIX,y.da.mgtv.com,REJECT
DOMAIN-SUFFIX,da.mgtv.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/[\d\.]+:\d{5}\/\?cmd=indexes/i then reject(200)
response if ${url} ~= /^https?:\/\/[\d\.]+\/odin\/c1\/(channel\/ads|skin\/config)\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/damang\.api\.mgtv\.com\/station\/album\/red\/dot\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/hb-boom\.api\.mgtv\.com\/release\/pullReleaseInfo/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/v2\/mobile\/checkUpdate\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mobileso\.bz\.mgtv\.com\/spotlight\/search\/v1\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/me\.bz\.mgtv\.com\/v3\/module\/list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV我的页面", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mob-st\.bz\.mgtv\.com\/odin\/c1\/channel\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV首页信息流,顶部tab", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/dc2?\.bz\.mgtv\.com\/dynamic\/v1\/channel\/(index|vrsList)\/\w/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/config\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV底部tab", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/v10\/video\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV播放详情页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mobile-thor\.api\.mgtv\.com\/v1\/vod\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV播放详情页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mobileso\.bz\.mgtv\.com\/mobile\/recommend\/v2\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MangoTV/fmz200_cnftp.js") with tag="芒果TV搜索框填充词", timeout=60, requires_body=true

[MITM]
hostname = *.mgtv.com

