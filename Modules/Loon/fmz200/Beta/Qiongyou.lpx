[Rewrite]
request if ${url} ~= /^https?:\/\/open\.qyer\.com\/qyer\/config\/get/i then reject(200)
request if ${url} ~= /^https?:\/\/media\.qyer\.com\/ad\//i then reject(200)
response if ${url} ~= /^https?:\/\/open\.qyer\.com\/qyer\/startpage\//i then response.body.mock("text", "", 200)

[MITM]
hostname = open.qyer.com, media.qyer.com

