[Rewrite]
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/recommend/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/no_auth\/benefit/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/.+\/more\/ios\?v=2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Blued/fmz200_blued.js") with tag="blued登录后个人界面广告", timeout=60, requires_body=true

[MITM]
hostname = social.blued.cn

