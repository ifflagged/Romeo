[Script]
response if ${url} ~= /^https?:\/\/license\.enpass\.io\/api\/v1\/subscription\/me/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/enpass/fmz200_enpass.js") with tag="enpass", timeout=60, requires_body=true

