[Rewrite]
request if ${url} ~= /^https?:\/\/hcz-member\.pingan\.com\.cn\/micro-api\/homepage\/do\/app\/popbox\/getTopPopBox/i then reject(200)
response if ${url} ~= /^https?:\/\/iobs\.pingan\.com\.cn\/download\/bweb-per-sf-prd\/bweb/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/iobs\.pingan\.com\.cn\/download\/icore-aops-base-dmz-prd\/(YourSystemName|icore-apps-ad)/i then response.body.mock("text", "", 200)

[MITM]
hostname = iobs.pingan.com.cn, hcz-member.pingan.com.cn

