[Rewrite]
request if ${url} ~= /^https?:\/\/[a-z]*\.rsscc\.com\/[a-z]*\/adver/i then reject(200)
response if ${url} ~= /^https?:\/\/cdn\.133\.cn\/md\/gtgj\/.+\/.+720x1280/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = cdn.133.cn, jt.rsscc.com, jp.rsscc.com

