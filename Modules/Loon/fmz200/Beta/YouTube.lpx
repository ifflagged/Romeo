#!name=YouTube
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partY/YouTube.sgmodule
#!tg-channel=https://t.me/inaisi

[Rewrite]
response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/YouTube/Maasea_youtube.response.js") with tag="YouTube响应体", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = rr*.googlevideo.com, youtubei.googleapis.com

