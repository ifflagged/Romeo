[Rewrite]
response if ${url} ~= /^https?:\/\/api\.u51\.com\/(generic-config-gateway|rs-resys)\/api\/v\d\/(creditpage-config|recommend)/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.u51\.com\/liabilitygateway\/api\/v\d\/homepage\/liabilityline/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/51CreditCardManager/fmz200_51card.js") with tag="51信用卡管家", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.u51\.com\/generic-config-gateway\/api\/v\d\/guanjia\/me-tab2\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/51CreditCardManager/fmz200_51card.js") with tag="51信用卡管家", timeout=60, requires_body=true

[MITM]
hostname = api.u51.com

