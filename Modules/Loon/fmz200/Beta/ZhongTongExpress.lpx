response if ${url} ~= /^https?:\/\/hdgateway\.zto\.com\/getAdInfo/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/hdgateway\.zto\.com\/listJumperShow/i then response.body.mock("text", "{}", 200)

