[Rule]
DOMAIN,cdn-new-ad.wtzw.com,REJECT
DOMAIN,a-remad.qm989.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,qzs.gdtimg.com,REJECT
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/open\.e\.kuaishou\.cn\/rest\/e\/v3\/open\/univ/i then reject(200)
request if ${url} ~= /^https?:\/\/api-access\.pangolin-sdk-toutiao-b\.com\/api\/ad\/union\/sdk\/get_ads/i then reject(200)
request if ${url} ~= /^https?:\/\/api-access\.(pangolin-sdk-toutiao|pangolin-sdk-toutiao1)\.com\/api\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/dsp\-x\.jd\.com\/adx\/sdk/i then reject(200)
request if ${url} ~= /^https?:\/\/api\-cfg\.wtzw\.com\/v1\/(adv|reward|operation)/i then reject(200)
request if ${url} ~= /^https?:\/\/p1\-lm\.adukwai\.com\/bs2\/adUnionVideo/i then reject(200)
request if ${url} ~= /^https?:\/\/lf\-cdn\-tos\.bytescm\.com\/obj\/static\/ad/i then reject(200)

[MITM]
hostname = open.e.kuaishou.cn, api-access.pangolin-sdk-toutiao-b.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, dsp-x.jd.com, api-cfg.wtzw.com, p1-lm.adukwai.com, lf-cdn-tos.bytescm.com

