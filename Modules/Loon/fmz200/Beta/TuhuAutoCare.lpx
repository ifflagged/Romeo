#!name=途虎养车
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partT/TuhuAutoCare.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,analytics.tuhu.com,REJECT
DOMAIN,ta.tuhu.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-cms\/circle\/recommend\//i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-scene-marketing-service\/api\/scene\/queryScheme/i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-push-message-box\/banner\/cms\/getIndexBanner/i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mlp-product-search-api\/search\/helper\/defaultAndHotWord/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/beautyIndex\/getBeautyIndex/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/channelPage\/v\d\/channelPageCouponPromptComponent/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getAutoSuperConfig/i then reject(200)
response if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/[a-z-]+\/recommend/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getCmsModuleList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/TuhuAutoCare/zirawell_tuhu.js") with tag="途虎养车去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/[a-z-]+\/homePage\/getHomePageInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/TuhuAutoCare/zirawell_tuhu.js") with tag="途虎养车去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-shop-api\/shopTab\/getModuleForC/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/TuhuAutoCare/zirawell_tuhu.js") with tag="途虎养车去广告", timeout=60, requires_body=true

[MITM]
hostname = mkt-gateway.tuhu.cn, cl-gateway.tuhu.cn, gateway.tuhu.cn

