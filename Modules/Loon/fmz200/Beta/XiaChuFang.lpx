[Rewrite]
request if ${url} ~= /^https?:\/\/api\.xiachufang\.com\/v\d\/ad\//i then reject(200)
response if ${url} ~= /^https?:\/\/images\.cib\.com\.cn\/commons\/uploads\/commons\/[a-zA-Z0-9]{32}\.jpg\?ver=20221[1-2]{1}/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/images\.cib\.com\.cn\/commons\/uploads\/commons\/[a-zA-Z0-9]{32}\.jpg\?ver=20230[1-9]{1}/i then response.body.mock("text", "", 200)
response if ${url} ~= /^http?:\/\/.*\.pglstatp-toutiao\.com/i then response.body.mock("text", "", 200)
response if ${url} ~= /^http:\/\/res1\.hubcloud\.com\.cn/i then response.body.mock("text", "", 200)

[MITM]
hostname = *.pglstatp-toutiao.com, res1.hubcloud.com.cnhostname

