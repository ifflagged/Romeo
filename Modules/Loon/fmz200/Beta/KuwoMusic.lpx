#!name=酷我音乐
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partK/KuwoMusic.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,mobilead.kuwo.cn,REJECT
DOMAIN,rich.kuwo.cn,REJECT
DOMAIN-KEYWORD,rich.kuwo.cn,REJECT
DOMAIN-KEYWORD,mobilead.kuwo.cn,REJECT
DOMAIN-SUFFIX,c.kuwo.cn,REJECT
DOMAIN-SUFFIX,deliver.kuwo.cn,REJECT
DOMAIN-SUFFIX,game.kuwo.cn,REJECT
DOMAIN-SUFFIX,kuwoyy.com,REJECT
DOMAIN-SUFFIX,kwmsg.kuwo.cn,REJECT
DOMAIN-SUFFIX,msclick2.kuwo.cn,REJECT
DOMAIN-SUFFIX,msphoneclick.kuwo.cn,REJECT
DOMAIN-SUFFIX,updatepage.kuwo.cn,REJECT
DOMAIN-SUFFIX,wa.kuwo.cn,REJECT
DOMAIN-SUFFIX,webstat.kuwo.cn,REJECT
DOMAIN-SUFFIX,mobilead.kuwo.cn,REJECT
DOMAIN-SUFFIX,rich.kuwo.cn,REJECT
DOMAIN-SUFFIX,ad.kuwo.cn,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?op=get_advertright_endtime/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(mgxhtj|nmobi|searchrecterm)\.kuwo\.cn\/(mgxh|mobi|recterm)\.s/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/KuwoMusic/fmz200_kuwo.js") with tag="酷我音乐", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/KuwoMusic/fmz200_kuwo.js") with tag="酷我音乐", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/musicpay\.kuwo\.cn\/music\.pay/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/KuwoMusic/fmz200_kuwo.js") with tag="酷我音乐", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/(enc\/user\/vip\?op=ui|v\d\/theme\?op=gd)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/KuwoMusic/fmz200_kuwo.js") with tag="酷我音乐", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/vip1\.kuwo\.cn\/vip\/v\d\/user\/vip\?op=ui/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/KuwoMusic/fmz200_kuwo.js") with tag="酷我音乐", timeout=60, requires_body=true

[MITM]
hostname = audiobookpay.kuwo.cn, mgxhtj.kuwo.cn, nmobi.kuwo.cn, searchrecterm.kuwo.cn, musicpay.kuwo.cn, vip1.kuwo.cn

