[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.pglstatp-toutiao\.com\/.*ad.*/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.htp\.ad-scope\.com\.cn.*/i then reject(200)
request if ${url} ~= /^https?:\/\/appgw\.ddpai\.com.*\/ad\/list.*/i then reject(200)
request if ${url} ~= /^https?:\/\/init\.sms\.mob\.com\/.*sdk\/init.*/i then reject(200)
response if ${url} ~= /^https?:\/\/apphw\.ddpai\.com:\d+\/onroad\/api\/v\d\/\w+\/list/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = *.pglstatp-toutiao.com, api.htp.ad-scope.com.cn, appgw.ddpai.com, init.sms.mob.com, apphw.ddpai.com

