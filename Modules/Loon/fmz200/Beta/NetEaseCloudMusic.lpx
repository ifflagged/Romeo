#!name=网易云音乐
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partQ/NetEaseCloudMusic.sgmodule
#!tg-channel=https://t.me/inaisi

[Argument]
MY=switch,true,false,tag=MY, desc=MY
DT=switch,true,false,tag=DT, desc=DT
FX=switch,true,false,tag=FX, desc=FX

[Rule]
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,httpdns.n.netease.com,REJECT
DOMAIN,httpdns.music.163.com,REJECT

[Rewrite]
response if ${url} ~= /https?:\/\/(ipv4|interface\d?)\.music\.163.com\/e?api\/ad/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/w?e?api\/(side-bar\/mini-program\/music-service\/account|delivery\/(batch-deliver|deliver)|moment\/tab\/info\/get|yunbei\/account\/entrance\/get)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(resource\/comments?\/musiciansaid|community\/friends\/fans-group\/artist\/group\/get|user\/sub\/artist|music\/songshare\/text\/recommend\/get|mine\/applet\/redpoint|resniche\/position\/play\/new\/get)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/(search\/(chart|default|rcmd\/keyword|specialkeyword)|resource-exposure\/|activity\/bonus\/playpage\/time\/query)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/eapi\/(mlivestream\/entrance\/playpage|link\/(position\/show\/strategy|scene\/show)|ios\/version|v\d\/content\/exposure\/comment\/banner)/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/(batch|v\d\/resource\/comment\/floor\/get)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js") with tag="NetEaseCloudMusic_mian", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/home\/framework\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js", {${MY}, ${DT}, ${FX}}) with tag="NetEaseCloudMusic_tab", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js", {${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}}) with tag="NetEaseCloudMusic_home", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js") with tag="NetEaseCloudMusic_fx", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/position\/show\/resource/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js") with tag="NetEaseCloudMusic_mybarad", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/user\/follow\/users\/mixed\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/NetEaseCloudMusic/Keywos_wyres.js") with tag="NetEaseCloudMusic_foll", timeout=20, requires_body=true, binary_body_mode=true

[MITM]
hostname = ipv4.music.163.com, interface.music.163.com, interface3.music.163.com, interface9.music.163.com

