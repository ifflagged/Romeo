[Rule]
DOMAIN,o2o-ad-log-gateway.alibaba.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup/i then reject(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup/i then reject(200)
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?/i then response.body.replace(/TAG_AD_INFO/, "fmz200")
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource/i then response.body.replace(/posterList/, "fmz200")
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341A(002|006|009|119|120)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341C147/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB05/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CCBLife/fmz200_A3341AB05.json", 200)

[Script]
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB04/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CCBLife/fmz200_ccbLifeAds.js") with tag="建行生活", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g\.alicdn\.com\/.*o2o-ad/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CCBLife/zirawell_alicdn.js") with tag="建行生活内置饿了么", timeout=60, requires_body=true

[MITM]
hostname = yunbusiness.ccb.com, g.alicdn.com, waimai-guide.ele.me

