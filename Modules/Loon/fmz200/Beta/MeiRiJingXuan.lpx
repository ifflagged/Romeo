[Rewrite]
response if ${url} ~= /http:\/\/dili.sqcosmos.com\/jiekou\/mains\/p\d+.html/i then response.json.jq(".album |= map(select(.id != \"4154\" and .id != \"4165\"))")
response if ${url} ~= /http:\/\/dili.sqcosmos.com\/jiekou\/endpage\/ad/i then response.body.mock("text", "{}", 200)

