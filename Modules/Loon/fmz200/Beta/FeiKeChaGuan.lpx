[Rewrite]
request if ${url} ~= /^https?:\/\/47\.100\.65\.202\/source\/plugin\/mobile\/mobile\.php\?module=advis/i then reject(200)
response if ${url} ~= /^https?:\/\/47\.100\.65\.202\/api\/mobile\/index\.php\?version=\d&mobile=yes&module=basicdata&type=forumlist/i then response.body.replace(/adv/, "fmz200")
response if ${url} ~= /^https?:\/\/ptf\.flyertrip\.com\/common\/cf\/.*.jpg/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/www\.flyert\.com\/.*\.php\?module=advis/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.flyert\.com(\.cn)?\/.*\.php\?module=advis/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.flydigi\.com\/android\/v2\/ad/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/47\.100\.65\.202\/source\/plugin\/mobile\/mobile\.php\?module=threadpost&.+?&page=1/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/FeiKeChaGuan/fmz200_fly.js") with tag="飞客茶馆", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/www\.flyert\.com(\.cn)?\/.*plugin/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/FeiKeChaGuan/zirawell_flyert.js") with tag="飞客茶馆", timeout=60, requires_body=true

[MITM]
hostname = api.flydigi.com

