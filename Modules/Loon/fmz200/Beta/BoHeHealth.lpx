[Rewrite]
response if ${url} ~= /^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/page_float_bubbles\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/tool_buttons\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.boohee\.com\/app-interface\/v1\/search\/search\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/status\.boohee\.com\/api\/v1\/merged_messages$/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn\/api\/v2\/sfo\/user_popup_configs\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/sensor-banners\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/api\.boohee\.com\/meta-interface\/v2\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BoHeHealth/fmz200_bohe_ads.js") with tag="薄荷健康", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.boohee\.com\/meta-interface\/v1\/index\/plaza\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BoHeHealth/fmz200_bohe_ads.js") with tag="薄荷健康", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.boohee\.com\/open-interface\/v1\/string\/market_page\?title=metabolism_config$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BoHeHealth/fmz200_bohe_ads.js") with tag="薄荷健康", timeout=60, requires_body=true

[MITM]
hostname = api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn, lego.boohee.com, status.boohee.com

