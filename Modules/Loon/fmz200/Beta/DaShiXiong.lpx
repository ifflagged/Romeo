[Rewrite]
response if ${url} ~= /^https?:\/\/adservice\.sigmob\.cn\/extconfig/i then response.body.replace(/false/, "true")
response if ${url} ~= /^https?:\/\/sdk\.alibaba\.com\.ailbaba\.me\/xgapp\.php\/v\d\/version/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/sdk\.alibaba\.com\.ailbaba\.me\/xgapp\.php\/v\d\/advert\?position=[^2]+/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/sdk\.alibaba\.com\.ailbaba\.me\/xgapp\.php\/v\d\/top_notice\?/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/sdk\.alibaba\.com\.ailbaba\.me\/(dsx|xgapp)\.php\/v\d\/(top_notice\?|version|advert\?position=[^2]+)/i then response.body.mock("text", "", 200)

[MITM]
hostname = sdk.alibaba.com.ailbaba.me, adservice.sigmob.cn

