[Rewrite]
response if ${url} ~= /^https?:\/\/delivery-api\.imdada\.cn\/v2_0\/dada\/promote\/imax\?privacyParam/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/delivery-api\.imdada\.cn\/v1_0\/transporter\/screen\/ads_list/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/delivery-api\.imdada\.cn\/v1_0\/transporter\/ad/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = delivery-api.imdada.cn

