#!name=斗鱼直播
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partD/DouyuLive.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,wan.douyu.com,REJECT
DOMAIN-SUFFIX,g.wan.douyu.com,REJECT
DOMAIN-SUFFIX,dotcounter.douyutv.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/daoyu\.sdo\.com\/api\/userCommon\/getAppStartAd/i then reject(200)
request if ${url} ~= /^https?:\/\/staticlive\.douyucdn\.cn\/upload\/signs\//i then reject(200)
request if ${url} ~= /^https?:\/\/staticlive\.douyucdn\.cn\/.+\/getStartSend/i then reject(200)
request if ${url} ~= /^https?:\/\/capi\.douyucdn\.cn\/lapi\/sign\/app(api)?\/getinfo\?client_sys=ios/i then reject(200)
request if ${url} ~= /^https?:\/\/douyucdn\.cn\/.+\/appapi\/getinfo/i then reject(200)
response if ${url} ~= /^https?:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo/i then response.body.mock("text", "{}", 200)
^https?:\/\/staticlive\.douyucdn\.cn\/.+?\/getStartSend mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/capi\.douyucdn\.cn\/api\/ios_app\/check_update mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/capi\.douyucdn\.cn\/api\/v1\/getStartSend?client_sys=ios mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/douyucdn\.cn\/.+?\/appapi\/getinfo mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = daoyu.sdo.com, rtbapi.douyucdn.cn, staticlive.douyucdn.cn, capi.douyucdn.cn, douyucdn.cn

