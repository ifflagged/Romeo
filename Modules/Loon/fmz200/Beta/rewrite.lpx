response if ${url} ~= /^https?:\/\/oneapp-api\.faw-vw\.com\/content\/(customize\/getCustomizePageName|recommend\/getRecommendInfoFlows|activity\/getSquareActivityList|theme\/getThemeList|post\/getPostsByTags|evaluate\/getEvaluateCards)\/v1\?.*/i then response.json.jq(". = { returnStatus: \"SUCCEED\", hasMore: false, data: [] }")
