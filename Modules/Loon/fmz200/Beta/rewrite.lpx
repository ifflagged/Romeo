response if ${url} ~= /^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(ICE|MEB)_(OPEN_SCREEN_ADS|CAR_ZHIHU_COLLEGE)/i then response.json.jq(". = { returnStatus: \"SUCCEED\", hasMore: false, data: [] }")
