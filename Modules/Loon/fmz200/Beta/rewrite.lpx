response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/open\/advertisingV2/i then response.json.jq(".dt = []")
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/c\/search\/hot\/v(2|4)/i then response.json.jq(".dt.hot = [] | .dt.recommand = [] | .dt.bannerList = []")
response if ${url} ~= /^https:\/\/(apissl|az2-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/system\/startup\?/i then response.json.jq("del(.reskinConfig.sidebarExSquareStyle.moreList, .reskinConfig.sidebarExSquareStyle.topList)")
response if ${url} ~= /^https:\/\/(apissl|az2-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com\/rest\/system\/startup\?/i then response.json.jq(".sidebarExSquareStyle.commonlyUsedList |= map(select(.title == \"设置\" or .title == \"历史记录\" or .title == \"草稿箱\" or .title == \"我的钱包\" or .title == \"小程序\" or .title == \"未成年人模式\" or .title == \"官方客服\" or .title == \"内容偏好\" or .title == \"离线模式\" or .title == \"稍后再看\" or .title == \"举报中心\" or .title == \"挂件\"))")
response if ${url} ~= /^https:\/\/az2-live\.ksapisrv\.com\/rest\/n\/live\/feed\/square\/refresh\?/i then response.json.jq("del(.data.banners)")
response if ${url} ~= /^https:\/\/az4-api(-idc)?\.ksapisrv\.com\/rest\/n\/feed\/selectionFast\?/i then response.json.jq("if (.feeds | type) == \"array\" then .feeds |= map(select(.ad | not)) else . end")
response if ${url} ~= /^https:\/\/az2-api-js\.gifshow\.com\/rest\/n\/user\/profile\/v2\?/i then response.json.jq("del(.postRecommends)")
response if ${url} ~= /http:\/\/dili.sqcosmos.com\/jiekou\/mains\/p\d+.html/i then response.json.jq(".album |= map(select(.id != \"4154\" and .id != \"4165\"))")
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number/i then response.json.jq(".data = []")
response if ${url} ~= /^https?:\/\/misc-api-prd-mx\.wandafilm\.com\/commend\/common_banner_batch\.api/i then response.json.jq(".data.objects[\"OpenAPP-&-FlashAD\"] = [] | .data.objects[\"InTheaters-&-BoxAD\"] = []")
