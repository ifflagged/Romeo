[Rewrite]
request if ${url} ~= /^https?:\/\/static\.mobile-bank\.psbc\.com\/mgs/i then reject(200)
response if ${url} ~= /^https?:\/\/static.psbc.com:8090\/mbank_f\/images\/[0-9]+\.png/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mcc.psbc.com:9090\/mcc\/resources\/[0-9]+\.(jpg|png)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/d\.psbc\.com:9091\/mcc\/resources\/[0-9]+\.(jpg|png|jpeg)/i then response.body.mock("text", "", 200)

[MITM]
hostname = static.psbc.com, mcc.psbc.com, static.mobile-bank.psbc.com, d.psbc.com

