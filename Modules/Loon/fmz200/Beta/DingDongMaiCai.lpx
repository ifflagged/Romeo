#!name=叮咚买菜
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partD/DingDongMaiCai.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,trackercollect.ddxq.mobi,REJECT
DOMAIN,ddfs-public.ddimg.mobi,REJECT
DOMAIN,rttrack.ddxq.mobi,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\//i then reject(200)
request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop/i then reject(200)
request if ${url} ~= /^https?:\/\/gw\.api\.ddxq\.mobi\/vip-app-service\/vip\/my\/page\/advertising/i then reject(200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails/i then response.body.replace(/suspension/, "fmz200")
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/queryMyPagePopup/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/cart\/vipGuide/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/(?>bottomNavi|homeFlowDetail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DingDongMaiCai/zirawell_ddxq.js") with tag="叮咚买菜", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DingDongMaiCai/zirawell_ddxq.js") with tag="叮咚买菜", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v\d\/user\/queryMyPage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DingDongMaiCai/zirawell_ddxq.js") with tag="叮咚买菜", timeout=60, requires_body=true

[MITM]
hostname = maicai.api.ddxq.mobi, gw.api.ddxq.mobi, user.api.ddxq.mobi

