[Rewrite]
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads/i then reject(200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.cncommunity\.my\.station\.query\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(batch\.show\.v2|index)\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbopen\.miniapp\.recommend\.cpc\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbmensa\.research\.researchservice\.(acquire|event|close)\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.(homepage\.merge|tabbar\.marketing)\.get\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.com\.cainiao\.cnactivitycenter/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.com\.cainiao\.cncreditmarket\.hit\.getactivityhit\.cn/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.com\.cainiao\.longquan\.place\.getpageresourcecontent\.cn/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CaiNiaoGuoGuo/fmz200_header.js") with tag="菜鸟裹裹", timeout=60

response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.m?show\.cn/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CaiNiaoGuoGuo/fmz200_cainiao.js") with tag="菜鸟裹裹", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.(pickup\.empty\.page|protocol\.homepage)\.get\.cn/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CaiNiaoGuoGuo/fmz200_cainiao.js") with tag="菜鸟裹裹", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.nbfriend\.message\.conversation\.list\.cn/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CaiNiaoGuoGuo/fmz200_cainiao.js") with tag="菜鸟裹裹", timeout=60, requires_body=true

[MITM]
hostname = cn-acs.m.cainiao.com, amdc.m.taobao.com

