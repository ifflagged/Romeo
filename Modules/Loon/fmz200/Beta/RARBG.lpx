[Rewrite]
response if ${url} ~= /^https?:\/\/dyncdn\.me\/static\/\d{0,2}\/js\/showads\.js$/i then response.body.replace(/true/, "false")
response if ${url} ~= /^https?:\/\/dyncdn\.me\/static\/\d{0,2}\/js\/expla\d{0,4}\.js$/i then response.body.mock("text", "", 200)

[MITM]
hostname = dyncdn.me

