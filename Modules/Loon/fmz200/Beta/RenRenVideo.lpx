#!name=人人视频
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partR/RenRenVideo.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,ad.rr.tv,REJECT
DOMAIN-SUFFIX,ebp.renren.com,REJECT
DOMAIN-SUFFIX,jebe.renren.com,REJECT
DOMAIN-SUFFIX,bolt.jebe.renren.com,REJECT
DOMAIN-SUFFIX,cupid.jebe.renren.com,REJECT
DOMAIN-SUFFIX,shaft.jebe.renren.com,REJECT
DOMAIN-SUFFIX,xray.jebe.renren.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.rr\.tv\/.*?Version/i then reject(200)
response if ${url} ~= /https:\/\/api.rr.tv\/storage\/business\/rootName\/app\/homePage\?dataType=JSON/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.rr\.tv\/\w{3}\/level\/info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/api.rr.tv\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_INDEX/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/app\/config\/h5NativeBar/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_MY/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/user\/privilege\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/ad\/getAll/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/drama\/app\/get_combined_drama_detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/api.rr.tv\/watch\/v4/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/api.rr.tv\/user\/profile/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/RenRenVideo/fmz200_rrtv_json.js") with tag="rrtv_json", timeout=60, requires_body=true

[MITM]
hostname = api.rr.tv

