[Rewrite]
request if ${url} ~= /^https?:\/\/app\.dewu\.com\/api\/v1\/app\/advertisement/i then reject(200)
response if ${url} ~= /^https?:\/\/cdn\.poizon\.com\/node-common\/.*.jpg/i then response.body.mock("text", "", 200)

