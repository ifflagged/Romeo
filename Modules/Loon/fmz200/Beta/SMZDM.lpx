[Rule]
DOMAIN,aaid.uyunad.com,REJECT
DOMAIN,acs4baichuan.m.taobao.com,REJECT
DOMAIN,adashxgc.ut.taobao.com,REJECT
DOMAIN,analytics-api.smzdm.com,REJECT
DOMAIN,baichuan-sdk.alicdn.com,REJECT
DOMAIN,dgstatic.jd.com,REJECT
DOMAIN,msg.umengcloud.com,REJECT
DOMAIN,sec.umeng.com,REJECT
DOMAIN,ulogs.umeng.com,REJECT
DOMAIN,ynuf.aliapp.org,REJECT
DOMAIN-SUFFIX,res-ga.smzdm.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_smzdm_ads.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/haojia-api\.smzdm\.com\/ranking_list\/articles\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_smzdm_ads.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_smzdm_ads.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/s-api\.smzdm\.com\/sou\/list_v10\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_smzdm_ads.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/user-api\.smzdm\.com\/vip\/creator_user_center/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_smzdm_ads.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/user-api\.smzdm\.com\/vip$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_Smzdm.js") with tag="什么值得买去广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app-api\.smzdm\.com\/util\/loading/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_Smzdm.js") with tag="Smzdm", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app-api\.smzdm\.com\/util\/update/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_Smzdm.js") with tag="Smzdm", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/user-api\.smzdm\.com\/vip\/bottom_card_list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_Smzdm.js") with tag="Smzdm", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/haojia-api\.smzdm\.com\/home\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SMZDM/fmz200_Smzdm.js") with tag="Smzdm", timeout=60, requires_body=true

