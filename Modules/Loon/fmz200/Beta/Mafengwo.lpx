#!name=马蜂窝
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partM/Mafengwo.sgmodule
#!tg-channel=https://t.me/inaisi

[Rewrite]
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/(travelguide\/)?ad/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/widget\/note\/get_widget_note/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/push\/get_local_push_config/i then reject(200)
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/update\/check_update/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/config\/(get|mark)_(push|alert)_config/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/user\/profile\/get_(list|profile)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Mafengwo/zirawell_mafengwo.js") with tag="马蜂窝", timeout=60, requires_body=true

[MITM]
hostname = mapi.mafengwo.cn

