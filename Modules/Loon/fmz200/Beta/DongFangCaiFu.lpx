[Rule]
DOMAIN-SUFFIX,bduserlog.eastmoney.com,REJECT
DOMAIN-SUFFIX,js4.eastmoney.com,REJECT
DOMAIN-SUFFIX,same.eastmoney.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/emdcadvertise\.eastmoney\.com\/infoService\/v\d/i then reject(200)
response if ${url} ~= /^https?:\/\/app\.ceair\.com\/customize\/security\/update/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/app\.ceair\.com\/customize\/main\/adScreen/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = app.ceair.com

