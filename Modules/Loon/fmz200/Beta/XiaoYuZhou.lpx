[Rewrite]
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list/i then response.json.jq(".data |= map(select(.type != \"DISCOVERY_HEADER\" and .type != \"DISCOVERY_BANNER\"))")
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v1\/(related-episode|operation-resource)\/list/i then response.json.jq(".data = []")
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = api.xiaoyuzhoufm.com

