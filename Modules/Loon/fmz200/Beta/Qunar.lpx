[Rewrite]
request if ${url} ~= /^https?:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd/i then reject(200)
response if ${url} ~= /^https?:\/\/qde\.qunar\.com\/preload/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/homefront\.qunar\.com\/front\/splash\/ad/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = qde.qunar.com, homefront.qunar.com, client.qunar.com

