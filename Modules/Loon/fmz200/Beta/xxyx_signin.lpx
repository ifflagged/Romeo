#!name=xxyx_signin
#!desc=xxyx_signin
#!icon=icon not found
#!tag=fmz200

[Script]
response if ${url} ~= /^https:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/my/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/xxyx_signin/fmz200_get_cookie.js") with tag="get_cookie", timeout=60, requires_body=true

cron "* 16 7 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/xxyx_signin/fmz200_xxyx_signin.js") with tag="晓晓优选每日任务", timeout=120, img_url=", img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/xxyx.jpeg"

