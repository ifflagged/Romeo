[Rewrite]
request if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/(promotion\/popup\/getpopupups\/bnb|portal\/getStartPictureAdvertising)/i then reject(200)
response if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getportalconfig\/bnb\/v2/i then response.body.replace(/"banners":\[.+\],/, "\"banners\":[],")
response if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = client.tujia.com

