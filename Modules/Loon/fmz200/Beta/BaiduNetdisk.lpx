[Rewrite]
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adx/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/api\/activityentry/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/pmall\/order\/privilege\/info/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/.+\/pcs\/adx/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/api\/useractivity\/activity/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/.+\/bchannel\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/api\/certuser\/get/i then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/component\/view\/(1510|1130)\?vip/i then reject(200)
request if ${url} ~= /^https?:\/\/ndstatic\.cdn\.bcebos\.com\/activity\/welfare\/js\/.+\.js/i then reject(200)
request if ${url} ~= /^https?:\/\/ndstatic\.cdn\.bcebos\.com\/activity\/welfare\/index\.html/i then reject(200)
request if ${url} ~= /^https?:\/\/staticsns\.cdn\.bcebos\.com\/amis\/.+\/banner.png/i then reject(200)
request if ${url} ~= /^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao/i then reject(200)
request if ${url} ~= /^https?:\/\/update\.pan\.baidu\.com\/statistics/i then reject(200)
request if ${url} ~= /^https?:\/\/fc-video\.cdn\.bcebos\.com/i then reject(200)
request if ${url} ~= /^https?:\/\/rp\.hpplay\.cn\/logouts/i then reject(200)

[MITM]
hostname = pan.baidu.com, ndstatic.cdn.bcebos.com, staticsns.cdn.bcebos.com, issuecdn.baidupcs.com, update.pan.baidu.com, fc-video.cdn.bcebos.com, rp.hpplay.cn

