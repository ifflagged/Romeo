#!name=游民星空
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partY/Gamersky.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,ja.gamersky.com,REJECT
DOMAIN-SUFFIX,ja1.gamersky.com,REJECT

[Rewrite]
response if ${url} ~= /http:\/\/.+\.gamersky.com\/.+\/lists\/getListElements/i then response.json.jq(".listElements |= map(select(has(\"adCategory\") | not))")
response if ${url} ~= /^http:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /https:\/\/.+\.gamersky.com\/v1\/statisticAd/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = *.gamersky.com

