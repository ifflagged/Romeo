[Script]
response if ${url} ~= /^https?:\/\/x\.com\/i\/api\/graphql\/[^\/]+\/(HomeTimeline|HomeLatestTimeline|TweetDetail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/XWebAds/fmz200_X_ads.js") with tag="X网页版去广告", requires_body=true

[MITM]
hostname = x.com

