[Rewrite]
request if ${url} ~= /^https?:\/\/api-marketing\.zhinengxiyifang\.cn\/api\/v2\/cloudcode\/wechat\/bid/i then reject(200)
request if ${url} ~= /^https?:\/\/adsoss\.zhinengxiyifang\.cn\/ads/i then reject(200)
response if ${url} ~= /^https?:\/\/ads\.zhinengxiyifang\.cn\/api\/v1\.1\/ads\/*/i then response.body.mock("text", "", 200)

[MITM]
hostname = api-marketing.zhinengxiyifang.cn, adsoss.zhinengxiyifang.cn, ads.zhinengxiyifang.cn

