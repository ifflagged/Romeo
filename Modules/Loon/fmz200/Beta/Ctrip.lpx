[Rewrite]
request if ${url} ~= /^https?:\/\/ma-adx\.ctrip\.com\/_ma\.gif/i then reject(200)
request if ${url} ~= /^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads\?page\=landingshare/i then reject(200)
response if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/[0-9]{5}\/json\/getTimeZoneServerIpList\?__gw_os=IOS/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/13916\/json\/tripAds/i then response.body.mock("text", "", 200)

[MITM]
hostname = m.ctrip.com, ma-adx.ctrip.com, mbd.baidu.com

