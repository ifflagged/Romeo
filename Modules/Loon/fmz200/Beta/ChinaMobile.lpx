[Rule]
IP-CIDR,120.240.95.37/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/explorePage\/getAdverList/i then reject(200)
request if ${url} ~= /^https?:\/\/(client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/emotionMarket/i then reject(200)
response if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit/i then response.body.mock("text", "", 200)

[MITM]
hostname = client.app.coc.10086.cn, app.10086.cn

