#!name=ccbLife_signin
#!desc=ccbLife_signin
#!icon=icon not found
#!tag=fmz200

[Script]
request if ${url} ~= /^https:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ccbLife_signin/FoKit_jhsh_checkIn.js") with tag="建行数据", requires_body=true

cron "17 7 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ccbLife_signin/FoKit_jhsh_checkIn.js") with tag="建行生活", timeout=60

request if ${url} ~= /^https:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ccbLife_signin/FoKit_jhsh_checkIn.js") with tag="jhsh_checkIn", timeout=60, requires_body=true

[MITM]
hostname = yunbusiness.ccb.com

