[Rule]
DOMAIN,ad.seeyouyima.com,REJECT

[Rewrite]
request if ${url} ~= /^http:\/\/x\.seeyouyima\.com\/adx\/staticstics\?/i then reject(200)
request if ${url} ~= /^https:\/\/axxd\.xmseeyouyima\.com\/ad\//i then reject(200)
request if ${url} ~= /^https:\/\/axxd\.xmseeyouyima\.com\/ad_statistics\?/i then reject(200)
request if ${url} ~= /^https:\/\/axxd\.xmseeyouyima\.com\/v1\/getad\?/i then reject(200)
request if ${url} ~= /^https:\/\/axxd\.xmseeyouyima\.com\/pregetad\?/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/config-service\.seeyouyima\.com\/api\/configs\/batch\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Meiyou/fmz200_meiyou_ads.js") with tag="美柚App净化", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/config-service\.seeyouyima\.com\/api\/configs\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Meiyou/fmz200_meiyou_ads.js") with tag="美柚App净化", timeout=60, requires_body=true

[MITM]
hostname = x.seeyouyima.com, axxd.xmseeyouyima.com, config-service.seeyouyima.com

