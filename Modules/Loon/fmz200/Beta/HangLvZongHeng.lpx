[Rewrite]
request if ${url} ~= /^https:\/\/oss\.umetrip\.com\/fs\/advert\/polite/i then reject(200)
request if ${url} ~= /^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native/i then reject(200)

[Script]
response if ${url} ~= /^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/HangLvZongHeng/fmz200_umetrip_ads.js") with tag="航旅纵横", timeout=60, requires_body=true

[MITM]
hostname = home.umetrip.com, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com

