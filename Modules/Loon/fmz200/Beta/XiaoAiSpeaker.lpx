#!name=小爱音箱
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partX/XiaoAiSpeaker.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,mistat.xiaomi.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/advertise(?!\/banner)/i then reject(200)
request if ${url} ~= /^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/payGuide\/userCenter/i then reject(200)
response if ${url} ~= /^https?:\/\/(info\.mina\.xiaoaisound|marketing-aibox\.v\.mitvos)\.com\/popup/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = info.mina.xiaoaisound.com, marketing-aibox.v.mitvos.com

