[Rewrite]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getfeedflowinfo\?/i then response.body.replace(/userRed/, "fmz200")
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getchoicegoodsinfos/i then response.body.replace(/infoData/, "fmz200")
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zzopen\/popwindow\/getallpopwin\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/getOpenScreen/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/userred\?scene=homePage/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev3/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ZhuanZhuan/fmz200_zhuanzhuan.js") with tag="转转", timeout=60, requires_body=true

[MITM]
hostname = app.zhuanzhuan.com

