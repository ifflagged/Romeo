#!tg-channel=https://t.me/inaisi

[Rewrite]
request if ${url} ~= /^https?:\/\/r6\.mo\.baidu\.com\/res\/file\/advertisement\/files\/.+\.jpg/i then reject(200)
request if ${url} ~= /^https?:\/\/res\.mi\.baidu\.com\/imeres\/ime-res\/advertisement\/files\/.+\.jpg/i then reject(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/activity\/advertisementnonrealtime/i then reject(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/hotpatch\/check\?hotpatch/i then reject(200)
response if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads\/list/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/lccorpus\/(applist|pannellist)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/circle\/joinedlist/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mime\.baidu\.com\/commer\/pocket_api\/enterprise_list/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?appname=baidu_input/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = r6.mo.baidu.com, res.mi.baidu.com, mime.baidu.com, mbd.baidu.com

