[Rewrite]
request if ${url} ~= /^(http:\/\/www\.vgtime\.com\/app\/topic\/\d+\.jhtml\?.*?&close_ad=)false(&page=\d&sign=\w+&timestamp=\d+&font_size=\d$)/i then redirect(302, "$1true$2")
response if ${url} ~= /^https?:\/\/app02\.vgtime\.com:8080\/vgtime-app\/api\/v2\/init\/ad\.json$/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = app02.vgtime.com, www.vgtime.com

