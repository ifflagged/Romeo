[Rewrite]
response if ${url} ~= /^https?:\/\/ad\.lofter.com\/v1\.1\/yitou\/madr/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/images\.pinduoduo\.com\/marketing\_api/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/lofter\.lf127\.net\/ad\-material/i then response.body.mock("text", "", 200)

[MITM]
hostname = ad.lofter.com, images.pinduoduo.com, lofter.lf127.net

