[Rewrite]
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/signintask\/adServing/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/getUpgradeStrategy/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/frontEntrance\/getThirdAdvertising\?displayPort=1&type=15/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/memberCard\/listMemberCard\?isShowSecondaryCard=1/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/entrance/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/homeIconDetail\/list\/v7/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/YouXiAPP/fmz200_yx.js") with tag="悠洗APP", timeout=60, requires_body=true

[MITM]
hostname = api.ulife.group

