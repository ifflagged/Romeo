[Rewrite]
#############################################
^https?:\/\/ec\.ems\.com\.cn\/mailAd$ - reject
^https?:\/\/ec\.ems\.com\.cn\/ecr-exp-web\/advert - reject
^https?:\/\/ump\.ems\.com\.cn\/mailAd$ - reject

[Script]
http-response ^https?:\/\/ec\.ems\.com\.cn\/ecr-qry-web\/redis\/pageInfoByChannel script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js, requires-body=true, timeout=60, tag=wechatApplet

http-response ^https?:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js, requires-body=true, timeout=60, tag=wechatApplet

[MITM]
hostname = ec.ems.com.cn, ump.ems.com.cn

