#!name=EMS微信小程序
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/QuantumultX/rewrite/split/partE/EMS.snippet
#!tg-group=https://t.me/QuantumultXCommunity
#!date=undefined

[Rewrite]
request if ${url} ~= /^https?:\/\/ec\.ems\.com\.cn\/mailAd$/i then reject(200)
request if ${url} ~= /^https?:\/\/ec\.ems\.com\.cn\/ecr-exp-web\/advert/i then reject(200)
request if ${url} ~= /^https?:\/\/ump\.ems\.com\.cn\/mailAd$/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/ec\.ems\.com\.cn\/ecr-qry-web\/redis\/pageInfoByChannel/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js") with tag="wechatApplet", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/EMS/zirawell_wechatApplet.js") with tag="wechatApplet", timeout=60, requires_body=true

[MITM]
hostname = ec.ems.com.cn, ump.ems.com.cn

