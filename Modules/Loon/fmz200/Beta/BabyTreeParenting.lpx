[Rewrite]
response if ${url} ~= /^https?:\/\/aimg\.babytreeimg\.com\/group1\/M00\/*\/*\/.*.jpg/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/plough\.babytree\.com\/plough\.do/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mapiweb\.babytree\.com\/newapi\/luban\/behavior\/receive/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/index_activity\/get_app_index_activity/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_tool\/api\/feeding_record\/get_home_banner_info/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = aimg.babytreeimg.com, plough.babytree.com, mapiweb.babytree.com, go.babytree.com

