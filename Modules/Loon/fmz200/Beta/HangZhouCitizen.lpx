[Rewrite]
request if ${url} ~= /^https?:\/\/smkmp\.96225\.com\/smkcenter\/ad\//i then reject(200)
response if ${url} ~= /^https?:\/\/ads\.iconntech\.com\/resource-delivery\/*\/.*.(jpg|png)/i then response.body.mock("text", "", 200)

[MITM]
hostname = ads.iconntech.com, smkmp.96225.com

