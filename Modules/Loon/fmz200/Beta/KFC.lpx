[Rewrite]
request if ${url} ~= /^https?:\/\/res\.kfc\.com.\cn\/advertisement\//i then reject(200)
response if ${url} ~= /^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/apphome5\/apphome/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/apphome6\/\w+\.json\?/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = res.kfc.com.cn

