[Rewrite]
response if ${url} ~= /^https?:\/\/hd\.xiaojukeji\.com\/d/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DiDiChuxing/fmz200_didiAds.js") with tag="滴滴出行", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/freight\.xiaojukeji\.com\/gateway/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DiDiChuxing/fmz200_didiAds.js") with tag="滴滴出行", timeout=60, requires_body=true

