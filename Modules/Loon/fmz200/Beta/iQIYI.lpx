[Rewrite]
response if ${url} ~= /^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/[\d\.]+\/3f1\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺首页信息流广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/access\.if\.iqiyi\.com\/3f1\/cards\.iqiyi\.com\/(views_category\/3\.0\/category_home|views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺首页信息流广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/(category_home|categorylib_content|film_hybrid)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺首页信息流广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺首页信息流广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺播放详情页广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/(hot_query_)?search\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺搜索页列表广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺评论区", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺我的页面菜单", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺首页左上角天气", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺通用控制,各tab页二楼", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views\/3\.0\/(bottom_theme|home_top_menu)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺底部tab、顶部tab", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/search\.video\.iqiyi\.com\/q\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺搜索框填充词", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/iQIYI/fmz200_cnftp.js") with tag="爱奇艺开屏广告,播放广告", timeout=60, requires_body=true

