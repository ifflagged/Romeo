#!name=TiktokJP
#!desc=TiktokJP
#!icon=icon not found
#!tag=fmz200

[Rewrite]
request if ${url} ~= /(?<=_region=)CN(?=&)/i then redirect(307, "JP")
request if ${url} ~= /(?<=&mcc_mnc=)4/i then redirect(307, "2")
request if ${url} ~= /^(https?:\/\/(tnc|dm)[\w-]+\.\w+\.com\/.+)(\?)(.+)/i then redirect(302, "$1$3")
request if ${url} ~= /(?<=\d\/\?\w{7}_\w{4}=)1[6-9]..(?=.?.?&)/i then redirect(307, "17")

[MITM]
hostname = *.tiktokv.com, *.byteoversea.com, *.tik-tokapi.com

