[Script]
request if ${url} ~= /^https:\/\/home\.m\.jd\.com\/myJd\/home\.action/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/jd_cookie/fmz200_jd_cookie.js") with tag="jd_cookie", timeout=60

request if ${url} ~= /^https:\/\/home\.m\.jd\.com\/myJd\/home\.action/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/jd_cookie/fmz200_jd_cookie.js") with tag="获取多账号京东Cookie", requires_body=true

[MITM]
hostname = home.m.jd.com

