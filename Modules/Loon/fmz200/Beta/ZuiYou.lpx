[Rewrite]
request if ${url} ~= /^https?:\/\/api\.izuiyou\.com\/ad\//i then reject(200)
request if ${url} ~= /^https?:\/\/adapi\.izuiyou\.com\//i then reject(200)

[MITM]
hostname = api.izuiyou.com, adapi.izuiyou.com

