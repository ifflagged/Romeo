#!name=唯品会
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partW/Vipshop.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,n-st.vip.com,REJECT
DOMAIN-SUFFIX,api.union.vip.com,REJECT
DOMAIN-SUFFIX,ms.vipstatic.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/b\.appsimg\.com\/upload\/momin/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/iosAdInfo\/report/i then reject(200)
response if ${url} ~= /^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/activity\/advertisement\/get/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/layout\/productList\/eventData\/v/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/activity\/coupon\/float_entrance\/get\?api_key/i then response.body.mock("text", "", 200)

[MITM]
hostname = b.appsimg.com, mapi.appvipshop.com

