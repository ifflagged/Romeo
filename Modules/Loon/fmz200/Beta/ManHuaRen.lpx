[Rewrite]
request if ${url} ~= /^https?:\/\/mangaapi\.manhuaren\.com\/v\d\/public\/getStartPageAds/i then reject(200)
request if ${url} ~= /^https?:\/\/.*mangaapi\.manhuaren\.\w{2,4}\/v\d\/public\/(getStartUpMessage|getStartPageAds|getShelfActivity)/i then reject(200)
request if ${url} ~= /^https?:\/\/.*mangaapi\.manhuaren\.\w{2,4}\/v\d\/ad/i then reject(200)

[MITM]
hostname = mangaapi.manhuaren.com, *mangaapi.manhuaren.*

