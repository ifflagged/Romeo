[Rule]
DOMAIN-SUFFIX,ut2.shuqistat.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/ut2\.shuqistat\.com\/.+\.gif/i then reject(200)
request if ${url} ~= /^https?:\/\/dsp\.toutiao\.com\/api\/xunfei\/ads\//i then reject(200)
request if ${url} ~= /^https?:\/\/sf3-be-pack\.pglstatp-toutiao\.com\/img\/ad\.union\.api/i then reject(200)
request if ${url} ~= /^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/sq\.sljkj\.com\/api\/sdk\/ads2/i then reject(200)
request if ${url} ~= /^https?:\/\/ocean\.shuqireader\.com\/api\/ad\/adserver\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/ad.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pglstatp-toutiao\.com/i then reject(200)
request if ${url} ~= /^https?:\/\/img-tailor\.11222\.cn\/pm\/app\/.+\.gif/i then reject(200)
request if ${url} ~= /^https?:\/\/img-tailor\.11222\.cn\/cms\/upload\/img\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/message\.shuqireader\.com\/message\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/101\.91\.69\.26:8080\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/feedback\.uc\.cn\/feedback\/api\/get_unread_status/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.shuqireader\.com\/sapi\/.+/i then reject(200)

[MITM]
hostname = ut2.shuqistat.com, dsp.toutiao.com, sf3-be-pack.pglstatp-toutiao.com, api-access.pangolin-sdk-toutiao.com, sq.sljkj.com, ocean.shuqireader.com, img-tailor.11222.cn, message.shuqireader.com, feedback.uc.cn, *.shuqireader.com, 101.91.69.26

