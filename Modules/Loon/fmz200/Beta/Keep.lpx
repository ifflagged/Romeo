#!name=Keep
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partK/Keep.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,httpdns.n.netease.com,REJECT
DOMAIN,httpdns.calorietech.com,REJECT
DOMAIN,hc-ssp.sm.cn,REJECT
DOMAIN,apm.gotokeep.com,REJECT
DOMAIN,kad.gotokeep.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d\/popup\/getPopUp/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/kprime\/v\d\/popups\/primeGuide/i then reject(200)
request if ${url} ~= /^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/api.gotokeep.com\/cauchy\/growth\/init/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/default\/keyword\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotword\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotCourse\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/ads\/v\d\/ads\/preload/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/training\/box\/config/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/anno\/v\d\/upgrade\/check/i then reject(200)
response if ${url} ~= /^https?:\/\/static1\.keepcdn\.com\/ark_optimus\/202\d\/*\/*\/.*.(png|jpg)/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/athena\/v\d\/people\/my$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Keep/fmz200_keep.js") with tag="keep", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/config\/v\d\/basic/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Keep/fmz200_keep.js") with tag="keep", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/homepage\/v\d\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Keep/fmz200_keep.js") with tag="keep", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/nuocha\/course\/v\d\/\w+\/preview/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Keep/fmz200_keep.js") with tag="keep", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/sportpage\/sport\/v\d\/mysport/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Keep/fmz200_keep.js") with tag="keep", timeout=60, requires_body=true

[MITM]
hostname = api.gotokeep.com, kad.gotokeep.com, static1.keepcdn.com

