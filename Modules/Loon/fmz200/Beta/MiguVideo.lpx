#!name=咪咕视频
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partM/MiguVideo.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,ad.cmvideo.cn,REJECT
DOMAIN,ggc.cmvideo.cn,REJECT
DOMAIN,ggv.cmvideo.cn,REJECT
DOMAIN,ggx.cmvideo.cn,REJECT
DOMAIN,ggx03.miguvideo.com,REJECT
DOMAIN,ggic03.miguvideo.com,REJECT
DOMAIN,ggmk.miguvideo.com,REJECT
DOMAIN,ggadoffline.miguvideo.com,REJECT

[Rewrite]
^https?:\/\/ggc\.miguvideo\.com\/v1\/iflyad\/deliverysystem\/direct\/ mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/public-deliver9\.miguvideo\.com\/deliver\/site\/batchMatch\/mergeSpot\/miguvideo\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/recommend-dy\.miguvideo\.com\/recommend-dynamic\/dataSource\/v1\/recommend\/merge/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/app-sc\.miguvideo\.com\/app-management\/v1\/staticcache\/settings\/miguvideo\/SHARE_PIC/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/common-sc\.miguvideo\.com\/videoActivity\/activityList\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/ggx.+\.miguvideo\.com\/request\/sdk.+[^?]*$/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/ggic\d+.miguvideo\.com\/ad\//i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static\/PERSONAL_CENTER$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/MiguVideo/fmz200_miguvideo_ads.js") with tag="咪咕视频个人中心去广告", timeout=60, requires_body=true

[MITM]
hostname = ggc.miguvideo.com, public-deliver9.miguvideo.com, display*-sc.miguvideo.com, recommend-dy.miguvideo.com, app-sc.miguvideo.com, common-sc.miguvideo.com, ggx*.miguvideo.com, ggic*.miguvideo.com

