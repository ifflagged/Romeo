[Rewrite]
response if ${url} ~= /^https?:\/\/(gw|img)\.alicdn\.com\/imgextra\/.+\/[\w!]+\d+-\d+-.+-\b([8-9]\d{2,}|[1-9]\d{3,})\b-\b([5-9]\d{2,}|[1-9]\d{3,})\b/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = gw.alicdn.com, img.alicdn.com

