[Rewrite]
response if ${url} ~= /^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad/i then response.body.replace(/advertisement/, "fmz200")
response if ${url} ~= /^https?:\/\/mp\.weixin\.qq\.com\/mp\/cps_product_info\?action/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = mp.weixin.qq.com

