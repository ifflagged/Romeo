#!name=百度地图
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partB/BaiduMaps.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,afd.baidu.com,REJECT
DOMAIN,afdconf.baidu.com,REJECT
DOMAIN,httpdns.baidubce.com,REJECT
DOMAIN,lc.map.baidu.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/dss0\.bdstatic\.com\/.+\/tam-ogel\/.+\.(jpg|mp4)/i then reject(200)
request if ${url} ~= /^https?:\/\/tb1\.bdstatic\.com\/tb\/cms\/ngmis\/adsense\/*.jpg/i then reject(200)
response if ${url} ~= /^https?:\/\/dss0\.bdstatic\.com\/-0U0bnSm1A5BphGlnYG\//i then response.body.mock("text", "", 200)
^https?:\/\/tb2\.bdstatic\.com\/tb\/mobile\/spb\/widget\/jump mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/ss0\.bdstatic\.com\/.+?_\d{3}_\d{4}\.jpg/i then response.body.mock("text", "", 200)
^https?:\/\/gss0\.bdstatic\.com\/.+?\/static\/wiseindex\/img\/bd_red_packet\.png mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BaiduMaps/fmz200_baidumap.js") with tag="百度地图广告", timeout=60, requires_body=true

[MITM]
hostname = dss0.bdstatic.com, tb1.bdstatic.com, tb2.bdstatic.com, ss0.bdstatic.com, gss0.bdstatic.com, newclient.map.baidu.com

