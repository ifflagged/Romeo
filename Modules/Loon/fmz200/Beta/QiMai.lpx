#!name=企迈 - QMAI(包含: 挪瓦咖啡、林里柠檬茶、霸王茶姬、陈香贵)
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partQ/QiMai.sgmodule
#!tg-channel=https://t.me/inaisi

[Rewrite]
request if ${url} ~= /^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/catering([0-9]-apiserver)?\/advertising\/ad\/advertiseInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/QiMai/zirawell_qmai.js") with tag="企迈（挪瓦咖啡、林里柠檬茶、霸王茶姬、陈香贵）", timeout=60, requires_body=true

[MITM]
hostname = webapi.qmai.cn, miniapp.qmai.cn

