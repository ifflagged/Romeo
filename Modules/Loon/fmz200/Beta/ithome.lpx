[Script]
response if ${url} ~= /^https:\/\/napi\.ithome\.com\/api\/(news\/index|topmenu\/getfeeds)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ithome/fmz200_ithome.js") with tag="ithome", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/napi\.ithome\.com\/api\/news\/indexv2\/iphone\/927/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ithome/fmz200_ithome.js") with tag="ithome", timeout=60, requires_body=true

