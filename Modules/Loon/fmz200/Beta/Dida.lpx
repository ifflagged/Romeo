[Rule]
DOMAIN-KEYWORD,image.bianxianmao.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/img\.admobile\.top\/admobile-adRequest\/.*.(jpg|png)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/webcdn\.m\.qq\.com\/qiantu\/upload\/202[0-9]{5}\/.*.(jpg|png)/i then response.body.mock("text", "", 200)

[MITM]
hostname = img.admobile.top, webcdn.m.qq.com

