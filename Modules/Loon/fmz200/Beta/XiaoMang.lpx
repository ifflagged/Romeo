[Rewrite]
response if ${url} ~= /^https:\/\/mgesq\.api\.mgtv\.com\/v2\/goods\/guess_you_like/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /https:\/\/mgesq.api.mgtv.com\/v2\/user\/center\/icon/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mgesq\.api\.mgtv\.com\/search\/goods\/rank/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mgesq\.api\.mgtv\.com\/user\/center\/config/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /https:\/\/mgesq.api.mgtv.com\/dsl\/index.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/XiaoMang/Sliverkiss_xmApp.js") with tag="小芒APP主页广告", timeout=60, requires_body=true

[MITM]
hostname = mgesq.api.mgtv.com, *.hitv.com

