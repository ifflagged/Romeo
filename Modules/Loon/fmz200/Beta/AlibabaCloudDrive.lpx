[Rewrite]
response if ${url} ~= /^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/api\.alipan\.com\/apps\/v2\/users\/home\/(news|widgets)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/AlibabaCloudDrive/fmz200_adrive.js") with tag="阿里云盘", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/member\.alipan\.com\/v1\/users\/onboard_list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/AlibabaCloudDrive/fmz200_adrive.js") with tag="阿里云盘", timeout=60, requires_body=true

[MITM]
hostname = api.alipan.com, member.alipan.com

