[Rewrite]
request if ${url} ~= /^https?:\/\/e\.dangdang\.com\/media\/api.+\?action=getDeviceStartPage/i then reject(200)
request if ${url} ~= /^https?:\/\/e\.dangdang\.com\/.+?getDeviceStartPage/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.dangdang\.com\/mapi\d\/mobile\/init/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.dangdang\.com\/index\.php\?action=init/i then reject(200)

[MITM]
hostname = e.dangdang.com, api.dangdang.com, mapi.dangdang.com

