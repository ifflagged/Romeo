[Rewrite]
response if ${url} ~= /^https?:\/\/webappcfg\.paas\.cmbchina\.com\/v\d\/func\/getmarketconfig/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mbmodule-openapi\.paas\.cmbchina\.com\/graphic\/v2\/module\/graphic/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = webappcfg.paas.cmbchina.com, mbmodule-openapi.paas.cmbchina.com

