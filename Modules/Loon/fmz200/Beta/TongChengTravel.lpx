[Rewrite]
request if ${url} ~= /^https?:\/\/wx\.17u\.cn\/xcxhomeapi\/((aggregator\/index)|(home\/(screen|banner|converge)))$/i then reject(200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/crapi\/query\/getAdImgUrlByCode/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/openscreen/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/getindexlayoutcelllist/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/gethotrecommend/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mobileapi\.ly\.com\/wlfrontend\/app\/scenicMain/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/wx\.17u\.cn\/crapi\/query\/ad/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mobilehotelapi\.elong\.com\/appHotel\/adx\/advert\/getAdvert/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = *.ly.com, *.17usoft.com, *.17u.cn, mobilehotelapi.elong.com, quic-tcmapi.elong.com

