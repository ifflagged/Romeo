[Rewrite]
request if ${url} ~= /^https?:\/\/mlol\.qt\.qq\.com\/go\/recommend/i then reject(200)
response if ${url} ~= /^https?:\/\/us\.l\.qq\.com\/exapp/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/ossweb-img\.qq\.com\/upload\/adw\/image\/[0-9]{3}\/202[0-9]{5}\/[a-z0-9]{32}\.(jpg|jpeg)/i then response.body.mock("text", "", 200)

[MITM]
hostname = us.l.qq.com, ossweb-img.qq.com, mlol.qt.qq.com

