#!name=百度贴吧
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partB/BaiduTieba.sgmodule
#!tg-channel=https://t.me/inaisi

[Argument]
per_filter_video_thread=input,"0",tag=per_filter_video_thread, desc=per_filter_video_thread

[Rule]
DOMAIN,180.76.76.200,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[Script]
response if ${url} ~= /^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BaiduTieba/app2smile_tieba-json.js") with tag="贴吧json", timeout=10, requires_body=true

response if ${url} ~= /^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BaiduTieba/app2smile_tieba-proto.js", {${per_filter_video_thread}}) with tag="贴吧proto", timeout=10, requires_body=true, binary_body_mode=true

[MITM]
hostname = tiebac.baidu.com

