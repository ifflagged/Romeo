[Rewrite]
request if ${url} ~= /^https?:\/\/gw\.kaola\.com\/gw\/dgmobile\/newOpenAd/i then reject(200)
response if ${url} ~= /^https?:\/\/kaola-haitao\.oss\.kaolacdn.com\/.+?_\d{3,4}_\d{4}\.jpg\?x-oss-process=image\/resize,m_mfit,w_\d{3,4},h_\d{4}\/format,webp\/quality,Q_85/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/sp\.kaola\.com\/api\/openad/i then response.body.mock("text", "", 200)

[MITM]
hostname = kaola-haitao.oss.kaolacdn.com, sp.kaola.com, gw.kaola.com

