[Rule]
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,is-lq.snssdk.com,REJECT
DOMAIN,ug-sinfonlinea.bytedance.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT
DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,security-lq.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT
DOMAIN,v6-novelapp.ixigua.com,REJECT
DOMAIN,msync-im1-vip6-std.easemob.com,REJECT
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,REJECT
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN-SUFFIX,novelapp.ixigua.com,REJECT
DOMAIN-SUFFIX,default.ixigua.com,REJECT
DOMAIN-SUFFIX,byteorge.com,REJECT
IP-CIDR,49.71.37.101/32,REJECT,no-resolve
IP-CIDR,117.71.105.23/32,REJECT,no-resolve
IP-CIDR,218.94.207.205/32,REJECT,no-resolve
IP-CIDR,117.92.229.188/32,REJECT,no-resolve
IP-CIDR,101.36.166.16/32,REJECT,no-resolve
IP-CIDR,180.96.2.114/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\//i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/(ad-app-package|ad)\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer/i then reject(200)
request if ${url} ~= /^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.snssdk.com\/api\/ad\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg\.com\/ad-app-package/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg\.com\/web\.business\.image/i then reject(200)

[MITM]
hostname = *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao.*, *.pstatp.com, *.pstatp.com.*, *.pglstatp-toutiao.com.*, *.pglstatp-toutiao.com, gurd.snssdk.com, gurd.snssdk.com.*, i-lq.snssdk.com, i-lq.snssdk.com.*, *default.ixigua.com

