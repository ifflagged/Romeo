[Rewrite]
request if ${url} ~= /^https?:\/\/open3\.vistastory\.com\/v\d\/api\/index\/loading_ad/i then reject(200)
request if ${url} ~= /^https?:\/\/open3\.vistastory\.com\/v\d\/api.*get_popup/i then reject(200)

