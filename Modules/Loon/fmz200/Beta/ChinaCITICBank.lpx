[Rewrite]
request if ${url} ~= /^https:\/\/imcs\.citicbank\.com\/cloud\/([a-fA-F0-9]{32})\.(jpg|png)/i then reject(200)
response if ${url} ~= /^https?:\/\/wap.bank\.ecitic\.com:6443\/NMBFOServer\/cbframework\.do\?act=CUBEPAGEDATA/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/imcs\.citicbank\.com\/cloud\/.+(1125.+2436|1242.+2688|750.+1638|563.+1218)/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = wap.bank.ecitic.com, imcs.citicbank.com

