[Rewrite]
response if ${url} ~= /^https?:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info/i then response.body.mock("text", "{", 200)

[MITM]
hostname = portal-portm.meituan.com, mall.meituan.com

