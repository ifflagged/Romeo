#!name=苏宁易购
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partS/Suning.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,show.suning.beer,REJECT
DOMAIN-SUFFIX,apm.suning.cn,REJECT
DOMAIN-SUFFIX,mads.suning.com,REJECT
DOMAIN-SUFFIX,ssac.suning.com,REJECT
DOMAIN-SUFFIX,tad.suning.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/mpcs\.suning\.com\/mpcs\/dm\/getDmInfo/i then reject(200)
response if ${url} ~= /^https?:\/\/image\.suning\.cn\/uimg\/ma\/ad\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/luckman\.suning\.com\/luck-web\/policy\/v\d\/msf\/index\.do/i then response.body.mock("text", "", 200)

[MITM]
hostname = mpcs.suning.com, image.suning.com, luckman.suning.com

