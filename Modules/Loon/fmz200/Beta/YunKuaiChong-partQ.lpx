[Rule]
DOMAIN,et.ykccn.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/enterpriseWeChatConfig\/app\/queryCityConfig/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/appAdvertising\/queryAdvertisingByParams/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/charge\/activity\/package\/newest/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = gw3.ykccn.com

