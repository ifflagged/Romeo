[Rewrite]
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/adshow\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/pay\/v5\/check_gift\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/go_gossip_darwin\/external\/v2\/query_flow_cards\?/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/feed\/v6\/detail_recommend_feeds\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Maimai/fmz200_maimai_ads.js") with tag="脉脉帖子末尾", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/(h3\.)?open\.taou\.com\/maimai\/(feed|gossip)\/v\d\/(focus_feed|gossip_detail_comment|feed_detail_comment?)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Maimai/fmz200_maimai_ads.js") with tag="脉脉", timeout=60, requires_body=true

[MITM]
hostname = open.taou.com, h3.open.taou.com

