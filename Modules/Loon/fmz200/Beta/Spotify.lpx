#!name=Spotify
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partS/Spotify.sgmodule
#!tg-channel=https://t.me/inaisi

[Argument]
tab=switch,true,false,tag=tab, desc=tab
useractivity=switch,true,false,tag=useractivity, desc=useractivity

[Rewrite]
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i then url.replace("https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad")
request if ${url} ~= /^https:\/\/gae2-spclient\.spotify\.com:443\/ad/i then reject(200)
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\//i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Spotify/001ProMax_Spotify.Crack.Dev.js", {${tab}, ${useractivity}}) with tag="Protobuf", timeout=3, requires_body=true, binary_body_mode=true

[MITM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com

