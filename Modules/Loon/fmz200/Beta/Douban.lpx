#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN-SUFFIX,erebor.douban.com,REJECT
DOMAIN-SUFFIX,ad.doubanio.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/img\d\.doubanio\.com\/view\/dale-online\/dale_ad\//i then reject(200)
request if ${url} ~= /^https?:\/\/frodo\.douban\.com\/api\/v2\/movie\/banner/i then reject(200)
request if ${url} ~= /^https?:\/\/erebor\.douban\.com\/count\/\?ad=/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.douban\.com\/v\d\/app_ads\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.douban\.com\/b.*\/common_ads\?.*/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = api.douban.com

