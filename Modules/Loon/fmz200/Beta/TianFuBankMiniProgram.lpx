[Rewrite]
response if ${url} ~= /^https?:\/\/chl\.tf\.cn\/channelmg\/sys\/socso\/order\/queryOrderInfo/i then response.body.replace(/imgUrl/, "response-body")
response if ${url} ~= /^https?:\/\/chl\.tf\.cn\/channelmg\/sys\/socso\/socsonew\/queryIsRealNameAdertInfo/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/wechat\.tf\.cn\/mini-financial\/model\/queryPopup/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = chl.tf.cn, wechat.tf.cn

