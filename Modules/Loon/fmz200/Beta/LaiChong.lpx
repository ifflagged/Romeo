[Rewrite]
request if ${url} ~= /^https?:\/\/(mobile|shop)\.laichon\.com\/api\/(v1\/goods\/goodsList|exposureAdvStatistics|getWebAdvList)/i then reject(200)

[MITM]
hostname = mobile.laichon.com, shop.laichon.com

