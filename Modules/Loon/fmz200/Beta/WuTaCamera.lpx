[Rewrite]
request if ${url} ~= /^https?:\/\/res-release\.wuta-cam\.com\/json\/ads_component_cache\.json/i then reject(200)
response if ${url} ~= /^https?:\/\/api-release\.wuta-cam\.com\/ad_tree/i then response.body.mock("text", "", 200)

[MITM]
hostname = api-release.wuta-cam.com, res-release.wuta-cam.com

