[Rewrite]
response if ${url} ~= /^https?:\/\/smarket\.dian\.so/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/file\.dian\.so\/c\/leto/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = smarket.dian.so, file.dian.so

