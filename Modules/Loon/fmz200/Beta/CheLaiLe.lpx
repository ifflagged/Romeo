[Rule]
DOMAIN-SUFFIX,atrace.chelaile.net.cn,REJECT
DOMAIN,logs.chelaile.net.cn,REJECT
DOMAIN,ad.chelaile.net.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/pic1\.chelaile\.net\.cn\/adv\//i then reject(200)
request if ${url} ~= /^https?:\/\/(api|atrace)\.chelaile\.net\.cn\/adpub\//i then reject(200)
request if ${url} ~= /^https?:\/\/api\.chelaile\.net\.cn\/goocity\/advert\//i then reject(200)
request if ${url} ~= /^https?:\/\/web\.chelaile\.net\.cn\/api\/adpub\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/cdn\.\w{3}\.chelaileapp\.cn\/(api\/)?adpub/i then reject(200)
^https?:\/\/atrace\.chelaile\.net\.cn\/adpub\/ mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/atrace\.chelaile\.net\.cn\/exhibit\?&adv_image mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = pic1.chelaile.net.cn, api.chelaile.net.cn, atrace.chelaile.net.cn, web.chelaile.net.cn, cdn.*.chelaileapp.cn

