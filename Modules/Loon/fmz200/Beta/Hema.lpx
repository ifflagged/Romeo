[Rewrite]
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.hippotown\.tabbar\.info/i then reject(200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.sg\.querysinglescene/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.render\.querysinglepage/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.fc\.recommend\.feedscommondservice/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.crm\.platform\.ma\.recommend/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.mimir\.recommend\.after\.purchase\.activity/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.render\.query(?>indexpage|mypage|tabfeedstream)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Hema/zirawell_freshippo.js") with tag="盒马", timeout=60, requires_body=true

[MITM]
hostname = acs.m.taobao.com, acs-m.freshippo.com

