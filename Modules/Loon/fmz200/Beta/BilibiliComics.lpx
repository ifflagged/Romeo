#!tg-channel=https://t.me/inaisi

[Rewrite]
response if ${url} ~= /^https?:\/\/i\d\.hdslb\.com\/bfs\/fawkes/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(?>jpg|png)$/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(?>jpg|png)@1200w_1500h_1e_1c/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(?>Recommend|MoreRecommend|Flash|ListFlash|GetBubbles|GetActivityTab|GetCommonBanner|GetComicConfigPicList|SearchBanner|AppInit)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Shop\/GetShopItems/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.SeasonV\d\/GetSeasonInfo/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.Read\/ActInfo/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/novel\.v\d\.Novel\/MoreRecommend/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/UCenterConf/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BilibiliComics/zirawell_bilibiliManga.js") with tag="哔哩哔哩漫画", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/GetInitInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BilibiliComics/zirawell_bilibiliManga.js") with tag="哔哩哔哩漫画", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Home\/HomeFeed/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BilibiliComics/zirawell_bilibiliManga.js") with tag="哔哩哔哩漫画", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comment\/Main/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/BilibiliComics/zirawell_bilibiliManga.js") with tag="哔哩哔哩漫画", timeout=60, requires_body=true

[MITM]
hostname = manga.bilibili.com, i*.hdslb.com

