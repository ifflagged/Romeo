[Rewrite]
request if ${url} ~= /^https?:\/\/p\.c\.music\.126.net\/.*?jpg$/i then reject(200)
request if ${url} ~= /^https?:\/\/img1.126.net\/.+dpi=\w{7,8}/i then reject(200)
request if ${url} ~= /^https?:\/\/img1.126.net\/channel14\//i then reject(200)
request if ${url} ~= /^https?:\/\/iadmusicmat\.music.126.net\/.*?jpg$/i then reject(200)
request if ${url} ~= /^https?:\/\/p\d\.music\.126\.net\/\w+==\/\d+\.jpg$/i then reject(200)
request if ${url} ~= /^https?:\/\/nex.163.com\/q/i then reject(200)
request if ${url} ~= /^https?:\/\/g1.163.com\/madfeedback/i then reject(200)
^https?:\/\/p[^4](c)?\.music\.126\.net\/\w+==\/10995\d{13}\.jpg$ mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/www.icourse163.org\/.*?(Advertisement) mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/www\.icourse163\.org\/mob\/j\/v1\/mobRecommendRPCBean\.getMaxWeightAdvertisement\.rpc/i then response.body.mock("text", "", 200)
^https?:\/\/interface3?\.music\.163\.com/eapi/(ad|abtest|sp|hot|store|mlog|search/(specialkeyword|defaultkeyword|hot)) mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = *.music.126.net, img1.126.net, www.icourse163.org, nex.163.com, g1.163.com, client.mail.163.com, c.m.163.com, interface*.music.163.com

