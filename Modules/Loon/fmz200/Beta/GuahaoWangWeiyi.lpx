[Rewrite]
request if ${url} ~= /^https?:\/\/app\.wy\.guahao\.com\/json\/white\/dayquestion\/getpopad/i then reject(200)
response if ${url} ~= /^https?:\/\/kano\.guahao\.cn\/[a-zA-Z0-9]{12}/i then response.body.mock("text", "", 200)
^https?:\/\/kano\.guahao\.cn\/.+?\?resize=\d{3}-\d{4} mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = kano.guahao.cn, app.wy.guahao.com

