[Rewrite]
request if ${url} ~= /^https?:\/\/aag\.enmonster\.com\/apa\/index\/advert\/skin/i then reject(200)
response if ${url} ~= /https?:\/\/awg\.enmonster\.com\/apa\/(advert\/demand\/home\/poster|index\/advert\/skin)/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = awg.enmonster.com, aag.enmonster.com

