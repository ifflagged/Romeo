#!name=weibotalk_signin
#!desc=weibotalk_signin
#!icon=icon not found
#!tag=fmz200

[Script]
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(flowlist|page\/button)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/weibotalk_signin/fmz200_weibotalk.cookie.js") with tag="微博超话cookie获取", requires_body=true

cron "5 0  * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/weibotalk_signin/fmz200_weibotalk_signin.js") with tag="微博超话", timeout=600

[MITM]
hostname = api.weibo.cn, mapi.weibo.com

