[Script]
response if ${url} ~= /^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/WeChatUnlockLinkRestrict/zZPiglet_UnblockURLinWeChat.js") with tag="UnblockURLinWeChat-解除微信链接限制", timeout=60, requires_body=true

[MITM]
hostname = weixin110.qq.com, security.wechat.com

