[Rewrite]
response if ${url} ~= /^https?:\/\/api\.caiyunapp\.com\/v1\/activity/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/wrapper\.cyapi\.cn\/v1\/activity\?/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/CaiYunWeather/Keywos_caiyun.json", 200)

