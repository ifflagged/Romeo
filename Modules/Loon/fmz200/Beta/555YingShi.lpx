[Rewrite]
request if ${url} ~= /^https?:\/\/[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+){1,3}(:\d+)?\/api\/v\d\/advert/i then reject(200)
response if ${url} ~= /^https?:\/\/vip7\.fzwdyy\.cn:8083\/api\/(getAdvertInfo|getGOOGAdvert)/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+){1,3}(:\d+)?\/api\/v\d\/movie\/index_recommend/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/555YingShi/fmz200_555Ad.js") with tag="555影视广告", timeout=60, requires_body=true

[MITM]
hostname = vip7.fzwdyy.cn, *.qyfxgd.cn, *.weilai555.com, *.ecoliving168.com

