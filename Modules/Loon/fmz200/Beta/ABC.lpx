[Rewrite]
request if ${url} ~= /^https?:\/\/midc\.cdn-static\.abchina\.com\.cn\/distributecenterimg\/file\/download\/(ed64|74b5)/i then reject(200)
response if ${url} ~= /^https?:\/\/enjoy\.cdn-static\.abchina\.com\/yx-engine-web\/file\/download\/(?!7dc2|fe96|cea3|06a8|1b11|d57b|6918|61db|2d58|aa23|)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/firefly\.abchina\.com\.cn\/firefly-collection\/Collect/i then response.body.mock("text", "", 200)

[MITM]
hostname = midc.cdn-static.abchina.com.cn, enjoy.cdn-static.abchina.com

