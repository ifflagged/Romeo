#!name=dalanshu_checkin
#!desc=dalanshu_checkin
#!icon=icon not found
#!tag=fmz200

[Script]
request if ${url} ~= /^https:\/\/dalanshu\.top\/api\/v1\/me\/checkin\/status/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/dalanshu_checkin/fmz200_get_cookie.js") with tag="* 大蓝树每日签到Token", img_url=", img-url=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/dalanshu_checkin/fmz200_dalanshu.js", requires_body=true

cron "30 8 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/dalanshu_checkin/fmz200_dalanshu_checkin.js") with tag="* 大蓝树每日签到", timeout=60, img_url=", img-url=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/dalanshu_checkin/fmz200_dalanshu.js"

request if ${url} ~= /^https:\/\/dalanshu\.top\/api\/v1\/me\/checkin\/status/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/dalanshu_checkin/fmz200_get_cookie.js") with tag="get_cookie", timeout=60

