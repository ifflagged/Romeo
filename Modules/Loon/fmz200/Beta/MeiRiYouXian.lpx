[Rewrite]
request if ${url} ~= /^https?:\/\/j-image\.missfresh\.cn\/img_(.+)\.gif$/i then reject(200)
request if ${url} ~= /^https?:\/\/j-image\.missfresh\.cn\/img_(.+)\.(jpg|jpeg|gif|png)\?iopcmd=convert&dst=webp&q=85$/i then reject(200)

[MITM]
hostname = j-image.missfresh.cn

