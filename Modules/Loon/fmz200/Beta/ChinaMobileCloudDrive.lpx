[Rule]
DOMAIN,ad.mcloud.139.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/mcmm\.caiyun\.feixin\.10086\.cn:80\/mcmm\/api\/IAdvert/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mcmm\.caiyun\.feixin\.10086\.cn:80\/mcmm\/api\/v\d\/getAdverts/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/middle\.yun\.139\.com\/openapi\/cardConfig\/queryCardInfoV3/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/mrp\.mcloud\.139\.com\/mc\/mc-client-service\/openapi\/letter\/query/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = mcmm.caiyun.feixin.10086.cn, mrp.mcloud.139.com, ad.mcloud.139.com, middle.yun.139.com

