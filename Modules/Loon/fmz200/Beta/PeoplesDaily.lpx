[Rewrite]
request if ${url} ~= /^https?:\/\/app\.peopleapp\.com\/Api\/\d+\/HomeApi\/(adv|getAdvertImage)/i then reject(200)
request if ${url} ~= /^https?:\/\/stat\.peopleapp\.com\//i then reject(200)
response if ${url} ~= /^https?:\/\/adstatic\.peopleapp\.com\/upload\/AppLoad\/.*.(jpg|png)/i then response.body.mock("text", "", 200)

[MITM]
hostname = app.peopleapp.com, stat.peopleapp.com, adstatic.peopleapp.com

