[Rule]
DOMAIN,adm.10jqka.com.cn,REJECT
DOMAIN,stat.10jqka.com.cn,REJECT
DOMAIN-SUFFIX,ad.thsi.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/iphone\.ac\.qq\.com\/.*\/Support\/(getSystemConf|bootScreen)/i then reject(200)
response if ${url} ~= /^https?:\/\/adm\.10jqka\.com\.cn\/interface\/ad\/recommend/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/stat\.10jqka\.com\.cn\/q\?ld=mobile&id=ad/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = adm.10jqka.com.cn, iphone.ac.qq.com, stat.10jqka.com.cn

