[Rewrite]
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/posters\?location=SODA_APP%3AHOME%3ABOTTOM/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/posters\?location=SODA_APP%3AHOME%3ACENTER/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/posters\?location=SODA_APP%3AMINE%3ABOTTOM/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/posters\?location=SODA_APP%3AREWARDS%3ACENTER/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/goods/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v1\/posters\?location=SODA_APP%3AHOME%3ATOP/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/SuDaXiaoYuanAPP/fmz200_soda.js") with tag="苏打校园APP", timeout=60, requires_body=true

[MITM]
hostname = api.sodalife.xyz

