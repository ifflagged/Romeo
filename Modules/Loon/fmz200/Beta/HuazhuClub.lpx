[Rewrite]
request if ${url} ~= /^https?:\/\/appapi\.huazhu\.com:\d+\/client\/app\/getAppStartPage\//i then reject(200)
response if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/home\/queryRecommond/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/{1,2}home\/(?>queryNewNotice|querySelectHotel|queryHotelBrand|queryMall|huazhuWorld)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/bundle\/upgrade\/check/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\//i then response.body.mock("text", "{}", 200)

[MITM]
hostname = appapi.huazhu.com, hweb-hotel.huazhu.com, hweb-manager.huazhu.com

