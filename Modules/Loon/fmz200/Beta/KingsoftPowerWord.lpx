#!name=金山词霸
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partJ/KingsoftPowerWord.sgmodule
#!tg-channel=https://t.me/inaisi

[Rule]
DOMAIN,ad-stat.ksosoft.com,REJECT
DOMAIN,img.auction-ads.wpscdn.cn,REJECT
DOMAIN,counter.kingsoft.com,REJECT
DOMAIN,counter.ksosoft.com,REJECT
DOMAIN,minfo.wps.cn,REJECT
DOMAIN,mobad.ijinshan.com,REJECT
DOMAIN,ups.ksmobile.net,REJECT
DOMAIN,ws.ksmobile.net,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/dict-mobile\.iciba\.com\/interface\/index\.php\?.+(c=ad|collectFeedsAdShowCount|KSFeedsAdCardViewController)/i then reject(200)
request if ${url} ~= /^https?:\/\/mobile-pic\.cache\.iciba\.com\/feeds_ad\//i then reject(200)
request if ${url} ~= /^https?:\/\/.+?\.kingsoft-office-service\.com/i then reject(200)
response if ${url} ~= /^https?:\/\/service\.iciba\.com\/popo\/open\/screens\/v\d\?adjson/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/\w+?\.kingsoft-office-service\.com\/ad/i then response.body.mock("text", "", 200)

[MITM]
hostname = dict-mobile.iciba.com, mobile-pic.cache.iciba.com, service.iciba.com, *.kingsoft-office-service.com

