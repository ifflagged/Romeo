[Rewrite]
request if ${url} ~= /^https?:\/\/mage\.if\.qidian\.com\/argus\/api\/v\d\/client\/getsplashscreen/i then reject(200)
request if ${url} ~= /^https?:\/\/magev6.if.qidian.com\/argus\/api\/v1\/client\/iosad/i then reject(200)
request if ${url} ~= /^https?:\/\/magev6.if.qidian.com\/argus\/api\/v1\/bookshelf\/getad/i then reject(200)
request if ${url} ~= /^https?:\/\/magev6.if.qidian.com\/argus\/api\/v4\/client\/getsplashscreen?/i then reject(200)
request if ${url} ~= /^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/adv\/getadvlistbatch/i then reject(200)
^https?:\/\/qidian\.qpic\.cn\/qidian_common mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/mage\.if\.qidian\.com\/Atom\.axd\/Api\/Client\/GetConfIOS mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/adv/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/followsubscribe/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^http[s]?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/refresh/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/getTopOperation/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/magev6\.if\.qidian\.com\/argus\/api\/v2\/adv\/getadvlistbatch/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = qidian.qpic.cn, mage.if.qidian.com, magev6.if.qidian.com

