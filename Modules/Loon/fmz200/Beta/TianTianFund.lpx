[Rewrite]
request if ${url} ~= /^https?:\/\/appactive\.1234567\.com\.cn\/AppoperationApi\/OperationService\/GetAppStartImg/i then reject(200)
response if ${url} ~= /^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/202[0-9]{5}\/.*.(jpg|png)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/j5\.dfcfw\.com\/WG\/appconf\/202[0-9]{5}\/.*.(jpg|png)/i then response.body.mock("text", "", 200)

[MITM]
hostname = j5.dfcfw.com, appactive.1234567.com.cn

