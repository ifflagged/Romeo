[Rewrite]
response if ${url} ~= /^https:\/\/plt\.yorentown\.com\/pltapp\/v1\/banner/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/LuoSenDianDian/fmz200_lawson.js") with tag="罗森点点", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/lawsonapi\.yorentown\.com\/portal\/app\/globalLaunch\/listAdvert/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/LuoSenDianDian/fmz200_lawson.js") with tag="罗森点点", timeout=60, requires_body=true

[MITM]
hostname = plt.yorentown.com, lawsonapi.yorentown.com

