[Rewrite]
request if ${url} ~= /^https?:\/\/103\.37\.155\.60\/fetch/i then reject(200)
request if ${url} ~= /^https?:\/\/catdot\.dianping\.com\/broker-service\/hijack/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/(?>indexopsmodules|loadsplashconfig)/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/wdrpreload\/userprediction/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/adshopping/i then reject(200)
request if ${url} ~= /^https?:\/\/p\.meituan\.com\/api\/privacy\/config/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.dpfile\.com\/app\/fecommonservice-lottie\/ugc-write-done\/media/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.dpfile\.com\/picasso\/picasso-qa\/src\/AnswerList\/AnswerList-bundle/i then reject(200)
