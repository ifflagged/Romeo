response if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/mapi\/intelliindex/i then response.body.mock("text", "{}", 200)
^https?:\/\/img\.meituan\.net\/goodsawardpic\/\w+\.gif mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryWechatAdvertisement/i then response.body.mock("text", "{}", 200)
^https?:\/\/p\d\.meituan\.net\/nrpresourcevenus\/\w+\.gif mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/p\d\.meituan\.net\/travelcube\/(?!c129a661)\w+\.gif mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/img\.meituan\.net\/(?>dpmobile|goodsawardpic)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DianPing/zirawell_dianping.js") with tag="大众点评", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/picassovc/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/DianPing/zirawell_dianping.js") with tag="大众点评", timeout=60, requires_body=true

[MITM]
hostname = 103.37.155.60, *.dianping.com, img.meituan.net, p.meituan.com, rms.meituan.com, www.dpfile.com, awp-assets.meituan.net, s3plus.meituan.net, p*.meituan.net, ddplus.meituan.net

