#!name=Soul
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=fmz200
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/QuantumultX/rewrite/split/partS/Soul.snippet
#!tg-group=https://t.me/QuantumultXCommunity
#!date=undefined

[Rule]
DOMAIN,soul-ad.soulapp.cn,REJECT
DOMAIN,ad-r.soulapp.cn,REJECT
DOMAIN,ad-reward.soulapp.cn,REJECT
DOMAIN-SUFFIX,cdn.soulapp.cn,REJECT
IP-CIDR,47.56.131.76/32,REJECT,no-resolve
IP-CIDR,47.97.215.55/32,REJECT,no-resolve
IP-CIDR,47.99.42.29/32,REJECT,no-resolve
IP-CIDR,120.27.235.201/32,REJECT,no-resolve
IP-CIDR,121.196.197.147/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/ssp\.soulapp\.cn\/api\/q/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ssp\.soulapp\.cn\/api\/ad\/config/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api-global\.soulapp\.me\/app\/open\/get/i then reject(200)

[Script]
request if ${url} ~= /^https:\/\/data-collector\.soulapp\.cn\/api\/data\/report\/v\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_req_replace_body.js") with tag="req_replace_body", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-account\.soulapp\.cn\/teenager\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-a\.soulapp\.cn\/v2\/post\/gift\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-a\.soulapp\.cn\/official\/scene\/module/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-user\.soulapp\.cn\/furion\/position\/content/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-user\.soulapp\.cn\/v\d\/planet\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/post\.soulapp\.cn\/hot\/soul\/rank/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/post\.soulapp\.cn\/v\d\/post\/recSquare\/subTabs/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/gateway-mobile-gray\.soulapp\.cn\/mobile\/app\/version\/queryIos/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/47\.110\.187\.87\/winterfell\/v2\/getIpByDomain/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/soul/fmz200_soul_ads.js") with tag="soul_ads", timeout=60, requires_body=true

[MITM]
hostname = 47.110.187.87, ssp.soulapp.cn, chat-live.soulapp.cn, api-account.soulapp.cn, api-global.soulapp.me, api-a.soulapp.cn, api-pay.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-chat.soulapp.cn, post.soulapp.cn, api-user.soulapp.cn

