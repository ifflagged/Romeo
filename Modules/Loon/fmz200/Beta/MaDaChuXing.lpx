[Rewrite]
response if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/ads/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/mine/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/tabAct/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^http:\/\/ebk\.17u\.cn\/tctrafficappversionadmin\/api\/getLatestVersionApp/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = mada-travel.17u.cn, ebk.17u.cn

