[Rewrite]
response if ${url} ~= /^https?:\/\/quanguo\.mygolbs\.com:8081\/MyBusServer\/servlet\/MyGoServer\.HttpPool\.HttpHandlerServlet/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ZhangShangGongJiao/fmz200_zhangshanggongjiao.js") with tag="掌上公交小程序广告", timeout=60, requires_body=true

[MITM]
hostname = quanguo.mygolbs.com, wx.mygolbs.com

