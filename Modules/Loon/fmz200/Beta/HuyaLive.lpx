[Rule]
DOMAIN,pp-cdnfile2pcdn.msstatic.com,REJECT
DOMAIN,livewebbs2pcdn.msstatic.com,REJECT
DOMAIN,huyafile.msstatic.com,REJECT
DOMAIN,livewebbs2.msstatic.com,REJECT
DOMAIN,business.msstatic.com,REJECT
DOMAIN-SUFFIX,v1d.szbdyd.com,REJECT
DOMAIN-SUFFIX,3dm.huya.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/cdn\.wup\.huya\.com\/launch\/queryHttpDns$/i then reject(200)
request if ${url} ~= /^https?:\/\/business\.msstatic\.com\/advertiser\/material/i then reject(200)
^https?:\/\/cdnfile1\.msstatic\.com\/cdnfile\/appad\/ mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/live-ads\.huya\.com\/live\/getAllEntrance.*$/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = cdn.wup.huya.com, business.msstatic.com, cdnfile1.msstatic.com, live-ads.huya.com

