[Rewrite]
response if ${url} ~= /^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/channel\/module\/opens/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/popup/i then response.body.mock("text", "", 200)

[MITM]
hostname = jdread-api.jd.com

