[Rewrite]
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/client\/main\/homePageSmallAd/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/index\.php\/Client\/main\/startPage/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/index\.php\/version\/version\/check/i then reject(200)

[MITM]
hostname = api.yikaobang.com.cn

