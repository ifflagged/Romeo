[Script]
response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Coolapk/fmz200_coolapk.js") with tag="酷安", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/main\/(dataList|indexV8|init)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Coolapk/fmz200_coolapk.js") with tag="酷安", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/page\/dataList\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Coolapk/fmz200_coolapk.js") with tag="酷安", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/www\.coolapk\.com\/link.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/Coolapk/VenenoSix24_Coolapk_Redirect.js") with tag="酷安URL重定向", timeout=10

[MITM]
hostname = api.coolapk.com, www.coolapk.com

