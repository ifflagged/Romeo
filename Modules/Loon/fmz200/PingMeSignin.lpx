[Script]
http-request ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/PingMeSignin/fmz200_get_cookie.js, timeout=60, tag=get_cookie

