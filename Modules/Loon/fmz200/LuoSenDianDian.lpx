#!name=罗森点点
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!icon=icon not found
#!tag=Jacob
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Shadowrocket/module/split/partL/LuoSenDianDian.srmodule
#!tg-channel=https://t.me/inaisi
#!arguments-desc=lawson_enable: lawson_enable

[Argument]
lawson_enable=switch,"true","false",tag=lawson_enable, desc=lawson_enable

[Rewrite]
^https:\/\/plt\.yorentown\.com\/pltapp\/v1\/banner mock-response-body data-type=text data="{}"

[Script]
http-response ^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/LuoSenDianDian/fmz200_lawson.js, requires-body=true, timeout=60, tag=罗森点点

http-response ^https:\/\/lawsonapi\.yorentown\.com\/portal\/app\/globalLaunch\/listAdvert script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/LuoSenDianDian/fmz200_lawson.js, requires-body=true, timeout=60, tag=罗森点点

[MITM]
hostname = plt.yorentown.com, lawsonapi.yorentown.com

