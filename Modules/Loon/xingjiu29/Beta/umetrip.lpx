#!name=航旅纵横去广告
#!desc=精简首页、精简我的页面
#!author=杏九
#!icon=icon not found
#!tag=xingjiu29
#!original=规则参考 zirawell/Ad-Cleaner
#!loon_version=3.5.3(1014)
#!tag=去广告

[Rule]
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,analytics.umetrip.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native/i then reject(200)
request if ${url} ~= /^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/(bkclient|umerp|home|umehome|sns|appmsg)\.umetrip\.com(\.cn)?\/gateway\/api\/umetrip\/native(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/xingjiu29/umetrip/xingjiu29_umetrip.js") with timeout=30, requires_body=true, binary_body_mode=true

[MITM]
hostname = umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com, umehome.umetrip.com, sns.umetrip.com, appmsg.umetrip.com

