#!name=养基宝 Pro
#!desc=养基宝 VIP 权益
#!icon=icon not found
#!tag=ifflagged

[Rewrite]
response if ${url} ~= /^https?:\/\/.*yangjibao\.com\/.*\/account|vip_info/i then response.json.jq("u'.data.vip_label=true|.data.vip_expiry_date=\"2099-12-31\"|.data.is_pay=true'")
response if ${url} ~= /^https?:\/\/.*yangjibao.com\/unify_ad/i then response.json.jq(".data=null")

[MITM]
hostname = *.yangjibao.com

