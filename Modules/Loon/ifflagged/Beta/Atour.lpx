[Script]
cron "0 30 7 * * *" then script("https://raw.githubusercontent.com/Sliverkiss/helloworld/master/Study/adjd.js") with tag="亚朵酒店app", timeout=300

request if ${url} ~= /^https:\/\/miniapp\.yaduo\.com\/atourlife\/signIn\/signIn.+/i then script("https://raw.githubusercontent.com/Sliverkiss/helloworld/master/Study/adjd.js") with tag="亚朵酒店app获取token", timeout=10

[MITM]
hostname = miniapp.yaduo.com

