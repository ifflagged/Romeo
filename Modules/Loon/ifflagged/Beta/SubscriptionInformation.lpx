#!name=SubscriptionInformation
#!desc=SubscriptionInformation
#!icon=icon not found
#!tag=ifflagged

[Script]
generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/SubscriptionInformation/mieqq_sub_info_panel.js", "url=[URL encode 后的机场节点链接]&reset_day=1&title=AmyInfo&icon=bonjour&color=#007aff") with tag="Sub_info", timeout=10

cron "可选参数icon=xxx 可以自定义图标，内容为任意有效的 SF Symbol Name，如 bolt.horizontal.circle.fill，详细可以下载app" then script("https://apps.apple.com/cn/app/sf-symbols-browser/id1491161336") with tag=".com/cn/app/sf-symbols-browser/", timeout=120

