#!name=🧰 Tools
#!desc=Tools for Surge & Shadowrocket
#!icon=icon not found
#!tag=ifflagged

[General]
force-http-engine-hosts = router.com, www.router.com

[Rewrite]
request if ${url} ~= /^https?:\/\/(|www\.)router\.com/i then redirect(302, "http://{GATEWAY_ADDRESS}")

[MITM]
hostname = router.com, www.router.com

