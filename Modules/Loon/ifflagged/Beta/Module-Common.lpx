#!name=🧰 Common Tools
#!desc=Common Tools for All
#!icon=icon not found
#!tag=ifflagged

[Rule]
DOMAIN,api-dsp.8ziben.com,REJECT
DOMAIN,sdk.zhangyuyidong.cn,REJECT
DOMAIN,open.e.kuaishou.cn,REJECT
DOMAIN,v66-ad.ndcjl.com,REJECT
DOMAIN,api-events.8ziben.com,REJECT
DOMAIN-SUFFIX,yximgs.com,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT
DOMAIN,wxa.wxs.qq.com,REJECT
DOMAIN,wximg.wxs.qq.com,REJECT
DOMAIN,wxsmw.wxs.qq.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.m\.jd\.com\/api\?functionId=union_exhibition_bff/i then reject_dict(200)
request if ${url} ~= /^https:\/\/spamblocker-api\.zeekstudio\.com\/profile/i then reject(200)
request if ${url} ~= /^https:\/\/spamblocker-api\.zeekstudio\.com\/checkVersion/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/\?functionId=union_exhibition_bff&client=apple&clientVer/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Module-Common/ifflagged_JD-JF.js") with tag="JD-Share", requires_body=true

[MITM]
hostname = wxa.wxs.qq.com, wximg.wxs.qq.com, wxsmw.wxs.qq.com, api.m.jd.com, spamblocker-api.zeekstudio.com

