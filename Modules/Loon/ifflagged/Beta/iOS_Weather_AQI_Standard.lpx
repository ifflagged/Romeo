#!name=iOS_Weather_AQI_Standard
#!desc=iOS_Weather_AQI_Standard
#!icon=icon not found
#!tag=ifflagged

[Host]
airQualityNode.index = aqicnIndex
airQualityNode.scale = AirQualityStandard.US
airQualityNode.source = aqicnData.city.name
airQualityNode.metadata.language = language

[Script]
response if ${url} ~= /https:\/\/weather-data.apple.com\/v2\/weather\/[\w-]+\/-?[0-9]+\.[0-9]+\/-?[0-9]+\.[0-9]+\?/i then script("path/to/iOS15_Weather_AQI_US.js") with tag="iOS15美标空气质量", requires_body=true

[MITM]
hostname = weather-data.apple.com

