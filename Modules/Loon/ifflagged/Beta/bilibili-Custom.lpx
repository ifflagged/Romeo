#!name=bilibili
#!desc=bilibili特殊处理
#!author=Jacob
#!icon=icon not found
#!tag=ifflagged
#!tag=Jacob
#!date=2026-11-04 22:56:00

[Argument]
bili_Airborne=switch,true,false,tag = "启用空降助手", desc = "开启或关闭空降助手"
logLevel=select,"error",tag = "空降助手日志级别", desc = "空降助手运行时的输出日志等级"

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq("jq-path=\"https://github.com/ifflagged/Neverflagged/raw/main/Loon/Scripts/tab_Bilibili_remove_ads.jq\"")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\?/i then response.json.jq("jq-path=\"https://github.com/ifflagged/Neverflagged/raw/main/Loon/Scripts/mine_Bilibili_remove_ads.jq\"")

[Script]
request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:community\.service\.dm\.v1\.DM\/DmSegMobile|app\.view(?:unite)?\.v1\.View\/ViewProgress)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/bilibili-Custom/kokoryh_bilibili.protobuf.request.js", {${logLevel}}) with tag="哔哩哔哩空降助手", timeout=10, enable=${bili_Airborne}, requires_body=true, binary_body_mode=true

