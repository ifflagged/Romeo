#!name=bilibili
#!desc=bilibili特殊处理
#!author=Jacob
#!icon=icon not found
#!tag=ifflagged
#!tag=Jacob
#!date=2026-06-19 23:23:00

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq("jq-path=\"https://github.com/ifflagged/Neverflagged/raw/main/Loon/Scripts/tab_Bilibili_remove_ads.jq\"")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\?/i then response.json.jq("jq-path=\"https://github.com/ifflagged/Neverflagged/raw/main/Loon/Scripts/mine_Bilibili_remove_ads.jq\"")

