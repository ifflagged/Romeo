[script]
generic script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/MediaCheck/ifflagged_MediaCheck.js, tag=Media Check, img-url=checkmark.seal.system

generic script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/MediaCheck/ifflagged_NetflixCheck_1.js, tag=Netflix Check, img-url=https://github.com/Koolson/Qure/raw/master/IconSet/Color/Netflix_Letter.png
generic script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/MediaCheck/ifflagged_Disney+Check.js, tag=Disney+ Check, img-url=https://github.com/Koolson/Qure/raw/master/IconSet/Color/Disney+.png
generic script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/MediaCheck/ifflagged_YoutubePremiumCheck.js, tag=YouTube Check, img-url=https://github.com/Koolson/Qure/raw/master/IconSet/Color/YouTube.png
