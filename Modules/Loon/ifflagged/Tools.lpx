[General]
force-http-engine-hosts = router.com, www.router.com

[Rewrite]
# Router //router.com, www.router.com
^https?://(|www\.)router\.com http://{GATEWAY_ADDRESS} 302

[MITM]
hostname = router.com, www.router.com

