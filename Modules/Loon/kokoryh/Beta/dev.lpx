#!name=Development Mode
#!desc=Redirect to the specified refName
#!icon=icon not found
#!tag=kokoryh

[Rewrite]
request if ${url} ~= /^https:\/\/raw\.githubusercontent\.com\/kokoryh\/Sparkle\/refs\/heads\/master/i then redirect(302, "https://raw.githubusercontent.com/kokoryh/Sparkle/{refname}")

[MITM]
hostname = raw.githubusercontent.com

