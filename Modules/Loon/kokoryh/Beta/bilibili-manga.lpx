#!name=哔哩哔哩漫画HD去广告
#!desc=去广告 & 精简页面
#!icon=icon not found
#!tag=kokoryh

[Rewrite]
response if ${url} ~= /^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.(Comic\/AppInit|Home\/HomeFeed)\?/i then response.json.jq(".data as $data | .data[(\"activity_tab\", \"flash\", \"operate\") | select($data[.])] = null | if .data.feeds then .data.feeds |= map(select(.type | IN(15, 30) | not)) end")
response if ${url} ~= /^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.Comic\/(Flash|ListFlash|GetActivityTab|GetBubbles)\?/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = manga.bilibili.com

