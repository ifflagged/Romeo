#!name=12306去广告
#!desc=移除开屏广告，精简首页
#!icon=icon not found
#!tag=kokoryh

[Script]
request if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/12306/kokoryh_12306.js") with tag="12306", requires_body=true

request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/12306/kokoryh_12306.js") with tag="12306"

[MITM]
hostname = ad.12306.cn, mobile.12306.cn

