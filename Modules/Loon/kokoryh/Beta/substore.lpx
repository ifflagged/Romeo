#!name=Sub-Store
#!desc=https://sub.store
#!author=sub-store-org[https://github.com/sub-store-org/Sub-Store]
#!icon=icon not found
#!tag=kokoryh

[Script]
request if ${url} ~= /^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/substore/sub-store-org_sub-store-1.min.js") with tag="substore.core", timeout=120, requires_body=true

request if ${url} ~= /^https?:\/\/sub\.store/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/substore/sub-store-org_sub-store-0.min.js") with tag="substore.simple", timeout=120, requires_body=true

[MITM]
hostname = sub.store

