#!name=E-Hentai增强
#!desc=https://e-hentai.org
#!icon=icon not found
#!tag=kokoryh

[Rewrite]
request if ${url} ~= /^https:\/\/exhentai\.org/i then redirect(307, "https://e-hentai.org")

[Script]
response if ${url} ~= /^https:\/\/e-hentai\.org\/g\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/ehentai/kokoryh_webpage.ehentai.js") with tag="ehentai", requires_body=true

[MITM]
hostname = e-hentai.org, exhentai.org

