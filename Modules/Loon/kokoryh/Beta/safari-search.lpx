#!name=Safari搜索拓展
#!desc=搜索引擎设置为DuckDuckGo
#!icon=icon not found
#!tag=kokoryh

[Rewrite]
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+trc.+/i then redirect(302, "https://translate.google.com/?op=translate&sl=auto&tl=zh-CN&text=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tre.+/i then redirect(302, "https://translate.google.com/?op=translate&sl=auto&tl=en&text=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+trj.+/i then redirect(302, "https://translate.google.com/?op=translate&sl=auto&tl=ja&text=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+gh.+/i then redirect(302, "https://github.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+gu.+/i then redirect(302, "https://github.com/search?type=users&q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+so.+/i then redirect(302, "https://stackoverflow.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+se.+/i then redirect(302, "https://stackexchange.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tw.+/i then redirect(302, "https://twitter.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+zh.+/i then redirect(302, "http://www.zhihu.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wb.+/i then redirect(302, "https://s.weibo.com/weibo/$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+tb.+/i then redirect(302, "taobao://s.taobao.com?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+jd.+/i then redirect(302, "openapp.jdmobile://virtual?params={\"des\":\"productList\",\"keyWord\":\"$1\",\"from\":\"search\",\"category\":\"jump\"}")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+zdm.+/i then redirect(302, "https://search.m.smzdm.com/?v=b&s=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+yt.+/i then redirect(302, "https://www.youtube.com/results?search_query=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+bli.+/i then redirect(302, "https://m.bilibili.com/search?keyword=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=cn&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143465&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=cn&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=hk&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143463&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=hk&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tw&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143470&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=tw&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=us&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143441&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=us&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=jp&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143462&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=jp&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=tr&.+/i then redirect(302, "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143480&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=tr&urlDesc=")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+bd.+/i then redirect(302, "https://www.baidu.com/s?wd=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+wk.+/i then redirect(302, "https://zh.wikipedia.org/wiki/$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^+]+)\+bi.+/i then redirect(302, "https://cn.bing.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo.com\/\?q=([^&]+).+/i then redirect(302, "https://www.google.com/search?q=$1")

[MITM]
hostname = duckduckgo.com

