#!name=微博轻享版去广告
#!desc=Version 6.6.8 is the last supported release
#!icon=icon not found
#!tag=kokoryh

[Rule]
DOMAIN-SUFFIX,biz.weibo.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.jq("del(.ad, .advertises, .trends) | if .statuses then .statuses |= map(select(((.promotion.type == \"ad\") or (.mblogtypename | IN(\"广告\", \"廣告\", \"热推\", \"熱推\"))) | not)) end")
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_coopen_ads&/i then response.json.jq(".data |= . + {\"ad_list\":[],\"pic_ad\":[],\"gdt_video_ad_ios\":[],\"display_ad\":0,\"ad_ios_id\":null,\"app_ad_ios_id\":null,\"reserve_ad_ios_id\":\"\",\"reserve_app_ad_ios_id\":\"\",\"ad_duration\":604800,\"ad_cd_interval\":604800}")
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends&/i then response.json.jq("if .data.order then .data.order = [\"search_topic\"] end")
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=search_topic&/i then response.json.jq("if .data.search_topic.cards[0].type == \"searchtop\" then del(.data.search_topic.cards[0]) end")
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=user_center&/i then response.json.jq("if .data.cards then .data.cards[].items |= map(select(.type != \"personal_vip\")) | .data.cards |= map(select((.items | length) > 0)) end")
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/ad\/weibointl\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_searching_info&/i then response.body.mock("text", "{", 200)
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?ct=feed&a=search_topic&/i then response.body.mock("text", "{", 200)

[MITM]
hostname = api.weibo.cn, weibointl.api.weibo.cn

