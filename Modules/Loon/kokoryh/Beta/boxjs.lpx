#!name=BoxJs
#!desc=https://boxjs.com
#!author=chavyleung[https://github.com/chavyleung/scripts]
#!icon=icon not found
#!tag=kokoryh

[General]
force-http-engine-hosts = boxjs.com

[Script]
request if ${url} ~= /https?:\/\/boxjs\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/boxjs/chavyleung_chavy.boxjs.js") with tag="boxjs", timeout=120, requires_body=true

[MITM]
hostname = boxjs.com

