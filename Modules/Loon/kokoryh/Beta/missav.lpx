#!name=MissAV去广告
#!desc=https://missav.ai
#!icon=icon not found
#!tag=kokoryh

[Rule]
DOMAIN,creative.myavlive.com,REJECT
DOMAIN-SUFFIX,trackwilltrk.com,REJECT
DOMAIN-SUFFIX,tsyndicate.com,REJECT

[Script]
response if ${url} ~= /^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/)./i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/missav/kokoryh_webpage.missav.js") with tag="missav", requires_body=true

[MITM]
hostname = missav.ai

