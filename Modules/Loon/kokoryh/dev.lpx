#!name=Development Mode
#!desc=Redirect to the specified refName
#!icon=icon not found
#!tag=kokoryh

[Argument]
refname=input,refs/heads/dev,tag=refname, desc=refname

[Rewrite]
^https:\/\/raw\.githubusercontent\.com\/kokoryh\/Sparkle\/refs\/heads\/master https://raw.githubusercontent.com/kokoryh/Sparkle/{refname} 302

[MITM]
hostname = raw.githubusercontent.com

