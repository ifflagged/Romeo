#!name=MTProto
#!desc=优化 Telegram 转圈问题
#!icon=icon not found
#!tag=kokoryh

[Argument]
interface=input,127.0.0.1,tag=interface, desc=interface
port=input,5753,tag=port, desc=port
secret=input,dd0123456789abcdef0123456789abcdef,tag=secret, desc=secret
ipv6=switch,"false","true",tag=ipv6, desc=ipv6
dc-config-url=input,https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/mtproto/ruleset_mtproto-dc-config.json,tag=dc-config-url, desc=dc-config-url

