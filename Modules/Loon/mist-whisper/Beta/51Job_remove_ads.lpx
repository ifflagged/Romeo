#!name=前程无忧去广告
#!desc=移除开屏广告、弹窗、信息流推广、职位页面推广和各类横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-07-11 17:40:27

[Rewrite]
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/recommend\/job-tab-dynamic\?/i then response.json.jq("delpaths([[\"resultbody\",\"adsTabFeeds\"]])")
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/user-task\/user\/task\//i then response.json.jq("delpaths([[\"resultbody\",\"availableTaskList\"]])")
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/tab\/good-job\/modules\?/i then response.json.jq("delpaths([[\"resultbody\",\"bannerList\"]])")
response if ${url} ~= /^https:\/\/appapi\.51jobapp\.com\/api\/market\/get_launch\.php\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/operation\/get\/latest\/banner-list\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/51job-activities\/secJob\/queryHomeSecondConfigV2\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/detail\/sesame-competitive\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/job-detail\/user-rights\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/resume\/strategy\/resume-build\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/getHomePagePopUp\?/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = appapi.51jobapp.com, cupid.51jobapp.com

