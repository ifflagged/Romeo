#!name= iRingo: 🗺️ Maps
#!desc=自定义 Maps app\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=mist-whisper
#!version=4.7.0-beta1
#!date=2026-08-21 19:16:13

[Argument]
UrlInfoSet.Dispatcher=input,"AutoNavi",tag=[URL信息集] 调度器, desc=[URL信息集] 调度器\n    ├ AUTO: 自动（保留资源清单原值）\n    ├ AutoNavi: 🧭高德（互动百科/大众点评/携程）\n    └ Apple: Apple（维基百科/Yelp/Booking）\n地点数据接口，此选项影响公共指南、兴趣点与位置信息等功能。
UrlInfoSet.Directions=input,"AutoNavi",tag=[URL信息集] 导航与 ETA, desc=[URL信息集] 导航与 ETA\n    ├ AutoNavi: 🧭高德（高德地图/TomTom）\n    └ Apple: Apple（TomTom）\n导航与 ETA 服务接口。
UrlInfoSet.RAP=input,"Apple",tag=[URL信息集] 评分和照片, desc=[URL信息集] 评分和照片\n    ├ AutoNavi: 🧭高德\n    └ Apple: Apple\n评分、照片及问题反馈服务接口。
UrlInfoSet.LocationShift=input,"AUTO",tag=[URL信息集] 定位漂移, desc=[URL信息集] 定位漂移\n    ├ AUTO: 自动（watchOS 使用 Apple，其他系统使用高德）\n    ├ AutoNavi: 🧭高德（GCJ-02）\n    └ Apple: Apple（WGS-84）\n定位漂移修正服务接口，控制指南针与坐标使用的坐标系。
TileSet.Earth=input,"CN",tag=[瓦片数据集] 地球, desc=[瓦片数据集] 地球\n    ├ CN: 🇨🇳中国版\n    └ XX: 🇺🇳国际版\n地球视图模型、材质、行政区划名称与极地数据。
TileSet.Road=input,"CN",tag=[瓦片数据集] 道路, desc=[瓦片数据集] 道路\n    ├ CN: 🇨🇳中国版\n    └ XX: 🇺🇳国际版\n道路、道路标签与道路选区数据。
TileSet.Satellite2D=input,"CN",tag=[瓦片数据集] 2D 卫星图像, desc=[瓦片数据集] 2D 卫星图像\n    ├ CN: 🇨🇳中国版\n    └ XX: 🇺🇳国际版\n2D 卫星图像及其夜间、极地等变体。
TileSet.Transit=input,"CN",tag=[瓦片数据集] 公共交通, desc=[瓦片数据集] 公共交通\n    ├ CN: 🇨🇳中国版\n    └ XX: 🇺🇳国际版\n公共交通与公共交通选区数据。
Storage=input,"Argument",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 优先使用模块参数，缺少的设置由 PersistentStore (BoxJS) 提供\n    ├ PersistentStore: 只使用 PersistentStore (BoxJS) 配置\n    └ database: 只使用脚本内置默认配置\n选择运行时读取模块参数、PersistentStore 或内置数据库的方式。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级。

[Rule]
# 🗺️ Amap
DOMAIN-SUFFIX,is.autonavi.com,DIRECT
# 🗺️ Maps
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT

[Script]
# 🗺️ Network Defaults
http-request ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_request.bundle.js, tag=🗺️ Maps.config.defaults.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

http-response ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_response.bundle.js, requires-body=true, tag=🗺️ Maps.config.defaults.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

# 🗺️ Announcements
http-request ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_request.bundle.js, tag=🗺️ Maps.config.announcements.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_response.bundle.js, requires-body=true, binary-body-mode=true, tag=🗺️ Maps.config.announcements.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

# 🗺️ Resource Manifest
http-request ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_request.bundle.js, tag=🗺️ Maps.geo_manifest.dynamic.config.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Maps/NSRingo_response.bundle.js, requires-body=true, binary-body-mode=true, tag=🗺️ Maps.geo_manifest.dynamic.config.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

[MITM]
hostname = configuration.ls.apple.com, gspe35-ssl.ls.apple.com

