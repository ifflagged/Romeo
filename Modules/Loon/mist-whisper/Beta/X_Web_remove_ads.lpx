[Script]
response if ${url} ~= /^https?:\/\/x\.com\/i\/api\/graphql\/[^\/]+\/(HomeTimeline|TweetDetail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/X_Web_remove_ads/resource_X_Web_remove_ads.js") with tag="X网页版去广告", requires_body=true

[MITM]
hostname = x.com

