[Rewrite]
request if ${url} ~= /^https:\/\/.*miguvideo\.com\/request\/sdk/i then reject(200, " ")
request if ${url} ~= /^https:\/\/.*miguvideo\.com\/task\/v7\/task-list\/cmvideo\/visitor/i then reject(200, " ")

[MITM]
hostname = *.miguvideo.com, *.migu.cn

