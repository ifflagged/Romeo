#!name=咪咕视频
#!desc=移除开屏广告、解锁VIP和画质。
#!author=WeiGiegie[https://github.com/WeiGiegie], ZenmoFeiShi[https://github.com/ZenmoFeiShi]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-05-14 21:14:00

[Rewrite]
response if ${url} ~= /^https:\/\/.*miguvideo\.com\/request\/sdk/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https:\/\/.*miguvideo\.com\/task\/v7\/task-list\/cmvideo\/visitor/i then response.body.mock("text", "", 200)

[Script]
request if ${url} ~= /^https?:\/\/(play|play-pre|v|v[0-9]?-sc|vmesh|app-sc|vms-sc|display(-sc)?|common-sc|program-sc|d[0-9]-sc|fs-sc|fsdv-sc|mp-user|recommend-dy|chat|chat-wx|public-deliver[0-9]?|public-operbiz[0-9]?|public-img)\.miguvideo\.com\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MiguTV/ZenmoFeiShi_migu_vip.js") with tag="咪咕视频VIP", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/(passport|uem|push|jadeite|jadeiteapp|hound|feedback|rcsdk)\.migu\.cn\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MiguTV/ZenmoFeiShi_migu_vip.js") with tag="咪咕视频VIP", timeout=60, requires_body=true

[MITM]
hostname = *.miguvideo.com, *.migu.cn

