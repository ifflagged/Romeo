#!name=芒果TV
#!desc=解锁芒果TV会员，提升画质，移除广告，页面优化。
#!author=WeiGiegie[https://github.com/WeiGiegie],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-03-17 11:37:00

[Rewrite]
response if ${url} ~= /^https?:\/\/mobile.da.mgtv.com\/m\/page/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/.*mgtv.com.*(GetUserInfo|module\/list\?_support|app\/bdboot|pullReleaseInfo|floor\/detail|video\/source|entry\?_support).*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MangoTV/resource_MangoTV.js") with tag="芒果TV页面优化", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MangoTV/resource_Mangotk.js") with tag="解锁芒果TV会员", timeout=60, requires_body=true

[MITM]
hostname = *mgtv.com, hb-boom.api.mgtv.com, *.api.mgtv.com, mobile-stream.api.mgtv.com, nuc.api.mgtv.com, 111.31.104.108, 111.31.104.*, 111.31.104.96, iphone.v0.mgtv.com, api.data.mgtv.com, *.*.mgtv.*

