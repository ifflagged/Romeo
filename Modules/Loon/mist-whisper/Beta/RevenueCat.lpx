[Script]
response if ${url} ~= /^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/RevenueCat/resource_Revenuecat.js") with tag="RevenueCat合集", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/RevenueCat/resource_Revenuecat.js") with tag="RevenueCat合集", timeout=60, requires_body=true

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com

