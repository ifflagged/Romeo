#!name=央视频去广告
#!desc=去除赛事直播前的广告。
#!author=Yu9191[https://github.com/Yu9191]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-07-12 00:20:00

[Rewrite]
response if ${url} ~= /^https?:\/\/cdn\.cmgadx\.com\/sdk\/pool\/.+\.json/i then response.body.mock("text", "{}", 200)

[Script]
request if ${url} ~= /^http:\/\/(liveinfo|bkliveinfo|playvv)\.ysp\.cctv\.cn\/(playvinfo\?.+|.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Yangshipin/resource_Yangshipin_remove_ads.js") with tag="央视频去广告", timeout=60

[MITM]
hostname = *.ysp.cctv.cn, cdn.cmgadx.com

