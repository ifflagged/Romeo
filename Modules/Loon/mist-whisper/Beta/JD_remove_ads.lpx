#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。在京东商品详情页可查看历史价格。
#!author=RuCu6[https://github.com/RuCu6], WeiGiegie[https://github.com/WeiGiegie], wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-02-02 20:35:00

[Rule]
DOMAIN,dns.jd.com,REJECT
IP-CIDR,101.124.19.122/32,REJECT,no-resolve
IP-CIDR6,2402:db40:5100:1011::5/128,REJECT,no-resolve
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/JD_remove_ads/resource_JD_remove_ads.js") with tag="移除京东广告", requires_body=true

response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/JD_remove_ads/resource_JD_Price.js") with tag="京东比价", requires_body=true

[MITM]
hostname = in.m.jd.com, m.360buyimg.com

