#!name=什么值得买去广告
#!desc=移除开屏广告、信息流广告、各类横幅广告、搜索页广告，移除活动皮肤，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-06-29 18:19:35

[Rule]
DOMAIN,adx-api.zdmimg.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/h5\.smzdm\.com\/user\/coupon\/coupon_list\?/i then reject(200)
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("if (getpath([\"data\"]) | has(\"silence_local_push\")) then (setpath([\"data\",\"silence_local_push\"]; 0)) else . end")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("if (getpath([\"data\"]) | has(\"baichuan_redirect_switch\")) then (setpath([\"data\",\"baichuan_redirect_switch\"]; 0)) else . end")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("delpaths([[\"data\",\"silence_local_push_msg\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("delpaths([[\"data\",\"video_cache_num_configs\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("delpaths([[\"data\",\"haojia_widget\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("delpaths([[\"data\",\"widget\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("delpaths([[\"data\",\"operation_float\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/update$/i then response.json.jq("def r: if type==\"object\" then if has(\"ad_campaign_name\") and (.ad_campaign_name|type==\"string\") and (.ad_campaign_name|test(\"\\S\")) then empty else . end elif type==\"array\" then map(r) else . end; .data.operation_float |= map(map(r))")
response if ${url} ~= /^https:\/\/homepage-api\.smzdm\.com\/v3\/home\?/i then response.json.jq(".data.component |= map(    if (.zz_content | type) == \"array\" then     .zz_content |= map(       select(         ( (.ad_campaign_id? | type == \"string\" and length > 0)// false ) or         ( (.tag? | type == \"string\" and length > 0)// false ) or         ( (.model_type? == \"ads\" and (type == \"string\"))// false )         | not       )     )   else . end )  | .data.component |= map(   select(     if has(\"zz_type\") then        .zz_type | IN([\"circular_banner\", \"filter\", \"list\"][])      else true end   ) )   | del(.data.theme) |  .data.component |= map(   if .zz_content | type == \"object\" then     .zz_content |= del(.circular_banner_option)   else     .   end )")
response if ${url} ~= /^https:\/\/haojia-api\.smzdm\.com\/home\/list\?/i then response.json.jq("delpaths([[\"data\",\"header_operation\",\"theme\"]])")
response if ${url} ~= /^https:\/\/haojia-api\.smzdm\.com\/home\/list\?/i then response.json.jq(".data.rows |= map(select(.cell_type == \"39001\")) | .data.banner_v2 |= map(select(.cell_type == \"21028\"))")
response if ${url} ~= /^https:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul\?/i then response.json.jq("delpaths([[\"data\",\"super_coupon\"]])")
response if ${url} ~= /^https:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul\?/i then response.json.jq("delpaths([[\"data\",\"banner\"]])")
response if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/vip$/i then response.json.jq("delpaths([[\"data\",\"activity_entrance_info\"]])")
response if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/vip$/i then response.json.jq("delpaths([[\"data\",\"big_banner\"]])")
response if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/vip$/i then response.json.jq("delpaths([[\"data\",\"top_banner\"]])")
response if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/vip$/i then response.json.jq("delpaths([[\"data\",\"banner_switch\"]])")
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/list_v10\?/i then response.json.jq(".data.rows |= map(select(.model_type != \"ads\")) | .data.top_aladdin |= map(select(has(\"ad\") | not))")
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\?/i then response.json.jq("delpaths([[\"data\",\"search_faxian\"]])")
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\?/i then response.json.jq("delpaths([[\"data\",\"tonglan\"]])")
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\?/i then response.json.jq("delpaths([[\"data\",\"hongbao\"]])")
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\?/i then response.json.jq(".data.search_hot.home |= map(select(.article_tag.article_title != \"广告\"))")
response if ${url} ~= /^https:\/\/haojia-api\.smzdm\.com\/detail\/\d+\?/i then response.json.jq("delpaths([[\"data\",\"quan_log\"]])")
response if ${url} ~= /^https:\/\/haojia-cdn\.smzdm\.com\/preload\/\d+\/fiphone\/v\d+_\d+_\d+\/wx\d+\/im\d+\/[0-9a-z]+\/[0-9a-z]+\.json$/i then response.json.jq("delpaths([[\"data\",\"quan_log\"]])")
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/util\/loading\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/mychannel\/list$/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/user-api\.smzdm\.com\/vip\/bottom_card_list\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/article-api\.smzdm\.com\/publish\/get_bubble\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/search_default_keyword\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/s-api\.smzdm\.com\/sou\/popup_coupon\?/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = app-api.smzdm.com, homepage-api.smzdm.com, h5.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, user-api.smzdm.com, article-api.smzdm.com, s-api.smzdm.com, haojia-cdn.smzdm.com

