#!name=高德地图去广告
#!desc=过滤高德地图开屏广告、各页面推广，精简我的页面。
#!author=RuCu6[https://github.com/RuCu6]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-02-22 06:04:15

[Rule]
DOMAIN,amap-aos-info-nogw.amap.com,REJECT
DOMAIN,free-aos-cdn-image.amap.com,REJECT
DOMAIN-SUFFIX,v.smtcdns.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?/i then response.json.jq("delpaths([[\"data\",\"commonMaterial\"]])")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?/i then response.json.jq("delpaths([[\"data\",\"tipsOperationLocation\"]])")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?/i then response.json.jq("delpaths([[\"data\",\"resourcePlacement\"]])")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/homepage\?/i then response.json.jq("delpaths([[\"history_tags\"]])")
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?/i then response.json.jq("delpaths([[\"data\",\"carTips\",\"data\",\"popupInfo\"]])")
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/ride\/home\/page\/get_commuting_card\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/orderList\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?:car-end|route-plan)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/main\/page\/product\/list\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:main-page-assets|main-page-location|ridewalk-end-fc|usr-profile-fc\/homeV2)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/(?:mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/valueadded\/weather\/v2\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:order\/car\/(?:feedback\/get_card_questions|feedback\/viptips|king_toolbox_car_bubble|remark\/satisfactionConf|rights_information)|tips\/onscene_visual_optimization)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving)/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除路线规划推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/bus\/plan\/integrate\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除路线规划、导航结束页推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除导航详情页底部酒店、处理附近页", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/perception\/drive\/(?:routeInfo|routePlan)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除路线规划推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_bff\/hotword\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除搜索栏推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(?:mps|search\/sp|sug|tips_operation_location)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除搜索详情页推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:card-service-plan-home|main-page)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除首页推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除首页推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除我的页面推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search\/nearbyrec_smart\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除附近页推广", requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除开屏广告", requires_body=true

response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:car\/order\/content_info|order_web\/friendly_information)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除打车页推广卡片、弹窗", requires_body=true

response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除打车页红点角标、天气图标", requires_body=true

response if ${url} ~= /^https:\/\/(?:info|m5)\.amap\.com\/ws\/shield\/search\/(?:common\/coupon\/info|poi\/detail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Amap_remove_ads/kelee_Amap_remove_ads.js") with tag="移除导航详情页推广", requires_body=true

[MITM]
hostname = *.amap.com

