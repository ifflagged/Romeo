#!name=Spotify去广告
#!desc=移除Spotify播放广告，移除随机播放，恢复歌手和专辑列表的正常展示，如有异常建议重新登录并清除缓存。
#!author=001ProMax[https://github.com/001ProMax], wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-03-20 18:05:00

[Rewrite]
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i then url.replace("https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad")
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:ad-|pendragon)/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_remove_ads/resource_Spotify_remove_ads.js") with tag="Protobuf处理", requires_body=true, binary_body_mode=true

[MITM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com

