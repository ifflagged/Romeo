#!name=小红书去广告
#!desc=过滤信息流推广，移除笔记和评论区图片视频以及live图水印，移除评论区表情包水印和下载限制，切换开关后重新进入笔记即可生效。IP分流可在模块内自行填写。如有异常，请先清除缓存或重装后再尝试。
#!author=fmz200[https://github.com/fmz200], Baby[https://github.com/Yu9191], RuCu6[https://github.com/RuCu6], wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-03-29 12:54:00

[Rule]
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT
URL-REGEX,"^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?!.*(list|feed|search|detail|get))",{Proxy}

[Rewrite]
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/longpress/i then response.json.jq("del(.data.image_press_result.anchor_detail)")
response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/guide\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery)/i then response.body.mock("text", "{}", 200)
^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(banner|hot)_list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书搜索页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(hint|trending)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书搜索页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(so|edith)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书搜索页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书开屏广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书开屏广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="小红书详情页", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="移除图片和实况照片水印", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="移除图片和视频水印", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="移除视频水印", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(edith|rec|www)\.xiaohongshu\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="移除评论区实况照片水印", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="表情包图片模式", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/interaction\/comment\/video\/download\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/REDnote_remove_ads/resource_REDnote_remove_ads.js") with tag="移除小红书评论区水印", timeout=60, requires_body=true

[MITM]
hostname = edith.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com, rec.xiaohongshu.com, so.xiaohongshu.com

