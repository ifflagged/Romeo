[Script]
request if ${url} ~= /^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/CatOnChairVIP/resource_CatOnChair.js") with tag="椅子上有猫会员", timeout=60, requires_body=true

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com

