#!name=看东方去广告
#!desc=移除看东方开屏广告、首页推广、搜索框推广、底部千V和商城tab、我的页面推广banner。
#!author=wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-04-26 22:38:00

[Rewrite]
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/open\/advertisingV2/i then response.json.jq(".dt = []")
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/c\/search\/hot\/v(2|4)/i then response.json.jq(".dt.hot = [] | .dt.recommand = [] | .dt.bannerList = []")
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/audit\/home\/v4/i then response.json.jq(".dt |= map(select(.styleString | IN(\"右侧金刚位\",\"首页头图\",\"智能体\") | not))")
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/isGreyModel$/i then response.json.jq(".dt.homeAreaButton |= (fromjson | .subscrip = \"0\" | .shop = \"0\" | tojson)")
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/userCenter/i then response.json.jq(".dt = []")

[MITM]
hostname = bp-api.bestv.cn

