[Rewrite]
response if ${url} ~= /^https:\/\/tianshu\.qq\.com\/open\/ts_access\/GetAds\?/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/h5\.qzone\.qq\.com\/p\/adboss\/api\/json\/ts_access\/GetAds$/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = tianshu.qq.com, h5.qzone.qq.com

