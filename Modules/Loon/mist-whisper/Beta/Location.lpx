#!name= iRingo: 📍 Location
#!desc=自定义定位服务内容\n添加国际版功能\n自定义服务版本
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=mist-whisper
#!version=1.0.1
#!date=2025-10-24 08:48:41

[Argument]
GeoCountryCode=input,"US",tag=[地区检测] 地理国家或地区代码, desc=[地区检测] 地理国家或地区代码\n    ├ AUTO: 🇺🇳自动（跟随地区检测结果）\n    ├ CN: 🇨🇳中国大陆\n    ├ HK: 🇭🇰中国香港\n    ├ TW: 🇹🇼中国台湾\n    ├ SG: 🇸🇬新加坡\n    ├ US: 🇺🇸美国\n    ├ JP: 🇯🇵日本\n    ├ AU: 🇦🇺澳大利亚\n    ├ GB: 🇬🇧英国\n    ├ KR: 🇰🇷韩国\n    ├ CA: 🇨🇦加拿大\n    └ IE: 🇮🇪爱尔兰\n要更改为的地区或国家，此选项影响GPS/Wi-Fi/有线网络下国家和地区检测的结果。
Dispatcher.Hybrid=switch,true,false,tag=[调度器] 融合数据, desc=[调度器] 融合数据\n地点数据接口，此选项影响公共指南，兴趣点(POI)与位置信息等功能。(注：使用国际版调度器时，不会进行数据融合）
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
DOMAIN,dispatcher.is.autonavi.com,DIRECT

[Script]
response if ${url} ~= /^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Location/NSRingo_response.bundle.js", {${GeoCountryCode}, ${Dispatcher.Hybrid}, ${LogLevel}}) with tag="📍 LocationService.pep.gcc.response", requires_body=true

request if ${url} ~= /^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Location/NSRingo_request.bundle.js", {${GeoCountryCode}, ${Dispatcher.Hybrid}, ${LogLevel}}) with tag="📍 LocationService.Dispatcher.request", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Location/NSRingo_response.bundle.js", {${GeoCountryCode}, ${Dispatcher.Hybrid}, ${LogLevel}}) with tag="📍 LocationService.Dispatcher.response", requires_body=true, binary_body_mode=true

[MITM]
hostname = gspe1-ssl.ls.apple.com, dispatcher.is.autonavi.com

