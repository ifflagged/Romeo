#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和短视频中的广告，移除底部的上传按钮和短视频按钮，解锁播放速度及精彩跳转，增加画中画及字幕翻译功能，支持后台播放。此插件需要Loon版本为3.1.7(677)及以上，且需要启用QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=gholts[https://github.com/gholts],RuCu6[https://github.com/RuCu6]
#!icon=icon not found
#!tag=mist-whisper
#!tag=去广告
#!system=iOS iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!date=2026-10-01 15:30:00

[Argument]
autoHD=switch,false,true,tag=自动最高画质, desc=自动选择最高画质
jumpAhead=switch,false,true,tag=开启精彩跳转, desc=解锁 YouTube Jump Ahead 按钮
blockUpload=switch,false,true,tag=隐藏上传按钮, desc=隐藏上传按钮
blockShorts=switch,false,true,tag=隐藏短视频按钮, desc=隐藏短视频按钮
blockGames=switch,false,true,tag=隐藏内置游戏, desc=隐藏游戏服务
blockVerticalLive=switch,false,true,tag=隐藏竖屏直播, desc=隐藏主页中的竖屏直播
blockStore=switch,false,true,tag=隐藏商品橱窗, desc=用于隐藏视频下方以及 Youtuber 主页中的商品推广
nativeDownload=switch,false,true,tag=本地下载, desc=解锁本地下载功能
captionLang=select,"off",tag=字幕翻译语言, desc=需要把YouTube字幕翻译翻译为何种语言

[Rewrite]
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)\//i then reject(200)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/ads/i then reject(200)

[Script]
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_Youtube.request.js", {${captionLang}}) with tag="YouTube_language", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_request_gholts.js") with tag="Youtube_ad-break"

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_request_gholts.js", {${nativeDownload}}) with tag="Youtube_download-player", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_request_gholts.js") with tag="Youtube_init", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_request_gholts.js", {${autoHD}}) with tag="Youtube_auto-HD", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_request_gholts.js") with tag="Youtube_log-event", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_response_gholts.js", {${nativeDownload}}) with tag="Youtube_download", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_response_gholts.js", {${blockUpload}, ${blockShorts}, ${blockGames}, ${blockVerticalLive}, ${jumpAhead}, ${autoHD}, ${blockStore}}) with tag="Youtube_response", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube/resource_YouTube_response_gholts.js", {${blockGames}, ${blockVerticalLive}, ${jumpAhead}, ${autoHD}, ${blockStore}}) with tag="Youtube_ump", requires_body=true, binary_body_mode=true

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, *.youtube.com

