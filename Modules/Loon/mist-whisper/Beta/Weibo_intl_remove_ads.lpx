#!name=微博轻享版去广告
#!desc=移除开屏广告、时间线广告及评论区广告，移除发现页面横幅推广、最常访问、主页访客及热门视频，移除搜索填充词。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-07-09 14:07:46

[Rewrite]
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq("delpaths([[\"data\",\"banner\"]])")
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq("delpaths([[\"data\",\"user_footprint\"]])")
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq("delpaths([[\"data\",\"profile_accessrecord\"]])")
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq("delpaths([[\"data\",\"native_content\"]])")
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends/i then response.json.jq(".data.discover |= map(select(.schema != \"尊享会员\"))")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.jq("delpaths([[\"advertises\"]])")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.jq("delpaths([[\"ad\"]])")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.jq("delpaths([[\"ad_version_2_weibo\"]])")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$/i then response.json.jq(".statuses|=map(select(.ad_marked!=true))")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.jq("delpaths([[\"ad\"]])")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.jq("delpaths([[\"ad_version_2_weibo\"]])")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$/i then response.json.jq(".statuses|=map(select(.ad_marked!=true))")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?/i then response.json.jq(".datas[].data.ad_from_comment? = true")
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?aid=/i then response.json.jq(".cards |= map(select((.mblog?|(.ad_marked?|type==\"boolean\")and.ad_marked==true)or(.card_group?|type==\"array\"and any(.[]?;.mblog?|(.ad_marked?|type==\"boolean\")and.ad_marked==true))|not))")
response if ${url} ~= /^https:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload$/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?v_f=2/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/ad\//i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_searching_info/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = bootpreload.uve.weibo.com, weibointl.api.weibo.cn, api.weibo.cn

