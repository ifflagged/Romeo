#!name=Telegram跳转第三方客户端
#!desc=Telegram外链直接跳转至第三方客户端，自行选择跳转至Swiftgram还是Turrit。
#!author=秦城二院彭医生[https://github.com/dcpengx],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-03-26

[Argument]
jump=input,"Swiftgram",tag=指定跳转客户端 - 选择跳转到哪个第三方tg (选项: Swiftgram, Turrit), desc=指定跳转客户端 - 选择跳转到哪个第三方tg (选项: Swiftgram, Turrit)

[Script]
response if ${url} ~= /(https:\/\/)?t\.me\/(.+)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Tg_url_redirect/dcpengx_tg-redirect.js", {${jump}}) with tag="telegram-redirect", timeout=10

[MITM]
hostname = t.me

