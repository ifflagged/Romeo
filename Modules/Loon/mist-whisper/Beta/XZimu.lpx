[Script]
response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/user\/updateStatus/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/XZimu/resource_XZimu.js") with tag="XZimu会员", timeout=60, requires_body=true

request if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/XZimu/resource_XZimu.js") with tag="XZimu会员", timeout=60, requires_body=true

response if ${url} ~= /^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/XZimu/resource_XZimu.js") with tag="XZimu会员", timeout=60, requires_body=true

