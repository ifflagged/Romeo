#!name=Soul去广告
#!desc=移除广告和精简页面。
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi], RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], kelv1n1n[https://github.com/kelv1n1n], wish[https://raw.githubusercontent.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-05-04 22:56:00

[Rule]
IP-CIDR,8.210.3.170/32,{PROXY},no-resolve
IP-CIDR,47.75.72.47/32,{PROXY},no-resolve

[Rewrite]
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter/i then reject(200)
request if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/user\/matchRelation\/getChatCard/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList/i then reject(200)
request if ${url} ~= /^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend/i then reject(200)
request if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url/i then reject(200)
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu/i then reject(200)
response if ${url} ~= /^https:\/\/ssp\.soulapp\.cn\/api\/q/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api-account\.soulapp\.cn\/teenager\/config/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/data-collector\.soulapp\.cn\/api\/data\/report\/v2/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc/i then response.body.mock("text", "{}", 200)

[Script]
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="派对猜你喜欢", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="去除私聊限制", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js", {${soulMatch}, ${voiceMatch}, ${partyMatch}, ${masked}, ${maskedMatch}, ${planet}}) with tag="星球页面", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="派对列表中间横幅官方广告", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="主页访问数量提示", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="个人主页tab", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js", {${hot}, ${all}, ${emotion}, ${personal}, ${play}, ${interest}, ${argue}, ${story}, ${chat}, ${heart}}) with tag="派对频道列表", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Soul_remove_ads/resource_Soul_remove_ads.js") with tag="阅后即焚", requires_body=true, binary_body_mode=true

[MITM]
hostname = ssp.soulapp.cn, increase-openapi.soulapp.cn, data-collector.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, 47.110.187.87

