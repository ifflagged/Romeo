[Rewrite]
response if ${url} ~= /^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/3\?iosVer=\d+\.\d+\.\d+&isGetList=1/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/27\?iosVer=\d+\.\d+\.\d+&isGetList=1/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/f-api\.kdocs\.cn\/godfather\/api\/thirdparty\/v1\/viewpager\?showLocal=mobileWebIndex/i then response.body.mock("text", "{}", 200)

[MITM]
hostname = www.kdocs.cn, f-api.kdocs.cn

