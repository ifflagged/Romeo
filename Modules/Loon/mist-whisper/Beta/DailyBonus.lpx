#!name=定时任务合集
#!desc=每天自动完成相关任务，根据需求进入插件打开相应开关即可。\n首次安装模块需打开对应 APP 获取Cookie。
#!author=Sliverkiss[https://github.com/Sliverkiss], wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-08-08 15:56:00

[Argument]
Xiaocan_CRONEXP=input,"0 0 * * *",tag=Xiaocan_CRONEXP, desc=Xiaocan_CRONEXP
Xiaoxiao_CRONEXP=input,"0 0 * * *",tag=Xiaoxiao_CRONEXP, desc=Xiaoxiao_CRONEXP
Waimai_CRONEXP=input,"0 0 * * *",tag=Waimai_CRONEXP, desc=Waimai_CRONEXP

[Script]
cron ${Xiaocan_CRONEXP} then script("https://gist.githubusercontent.com/Sliverkiss/250a02315f0a2c99f42da3b3573375c8/raw") with tag="小蚕霸王餐签到"

response if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/rpc/i then script("https://gist.githubusercontent.com/Sliverkiss/250a02315f0a2c99f42da3b3573375c8/raw") with tag="小蚕霸王餐Cookie", timeout=60, requires_body=true

cron ${Xiaoxiao_CRONEXP} then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/DailyBonus/Sliverkiss_xxyx.js") with tag="晓晓优选签到"

response if ${url} ~= /^https:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/my/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/DailyBonus/Sliverkiss_xxyx.js") with tag="晓晓优选Cookie", timeout=60, requires_body=true

cron ${Waimai_CRONEXP} then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/DailyBonus/Sliverkiss_wmbwc.js") with tag="歪麦每日任务", timeout=15

request if ${url} ~= /^https:\/\/wmapp-api\.waimaimingtang\.com\/api\/api\/v2\/user\/api_user_info_one/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/DailyBonus/Sliverkiss_wmbwc.js") with tag="歪麦霸王餐Cookie", timeout=60, requires_body=true

[MITM]
hostname = maicai.api.ddxq.mobi, wmapp-api.waimaimingtang.com, gw.xiaocantech.com, xxyx-client-api.xiaoxiaoyouxuan.com

