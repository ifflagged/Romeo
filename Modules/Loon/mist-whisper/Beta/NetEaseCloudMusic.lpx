#!name=网易云音乐去广告
#!desc=过滤网易云音乐广告，并允许自定义界面。\n解锁网易云音乐会员，非会员用户在模块参数中自行开启。
#!author=Keywos[https://github.com/Keywos], RuCu6[https://github.com/RuCu6], wish[https://github.com/mist-whisper], anyehttp[https://github.com/anyehttp]
#!icon=icon not found
#!tag=mist-whisper
#!date=2025-10-17 11:52:00

[Argument]
MY=input,"1",tag=漫游, desc=漫游
DT=input,"1",tag=笔记, desc=笔记
FX=input,"1",tag=发现, desc=发现
PRGG=input,"0",tag=问候语, desc=问候语
PRRK=input,"0",tag=排行榜, desc=排行榜
PRDRD=input,"0",tag=每日推荐, desc=每日推荐
PRSCVPT=input,"0",tag=推荐歌单, desc=推荐歌单
PRST=input,"1",tag=最近常听, desc=最近常听
PRRR=input,"1",tag=雷达歌单, desc=雷达歌单
HMPR=input,"1",tag=音乐合伙人, desc=音乐合伙人
PRMST=input,"0",tag=推荐专属歌单, desc=推荐专属歌单
PRCN=input,"0",tag=你的专属歌单, desc=你的专属歌单

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,ipv4.music.163.com,REJECT
DOMAIN,ipv6.music.163.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163.com\/e?api\/ad/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/w?e?api\/(?:side-bar\/mini-program\/music-service\/account|delivery\/(batch-deliver|deliver)|moment\/tab\/info\/get|yunbei\/account\/entrance\/get)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:resource\/comments?\/musiciansaid|community\/friends\/fans-group\/artist\/group\/get|user\/sub\/artist|music\/songshare\/text\/recommend\/get|mine\/applet\/redpoint|resniche\/position\/play\/new\/get)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/search\/default/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/(?:search\/(chart|rcmd\/keyword|specialkeyword)|resource-exposure\/|activity\/bonus\/playpage\/time\/query)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/eapi\/(?:mlivestream\/entrance\/playpage|link\/(position\/show\/strategy|scene\/show)|ios\/version|v\d\/content\/exposure\/comment\/banner)/i then response.body.mock("text", "{}", 200)
response if ${url} ~= /^https:\/\/interface\d\.music\.163\.com\/eapi\/my\/podcast\/tab\/recommend/i then response.body.mock("text", "{}", 200)

[Script]
request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/(v1\/artist\/top\/song|v3\/discovery\/recommend\/songs)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/v3\/song\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/song\/(chorus|enhance\/|play\/|type\/detail\/get)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/playermode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/search\/complex\/(page|rec\/song\/get)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https:\/\/interface3?\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https?:\/\/interface3?\.music\.163\.com\/eapi\/(homepage\/|v6\/)?playlist\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

request if ${url} ~= /^https?:\/\/interface3?\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_ShareVIP.js") with tag="共享会员", timeout=20

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/(batch|v\d\/resource\/comment\/floor\/get)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js") with tag="评论区、热推、有话想说、分享一下、歌曲下的祝福等小提示", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js", {${PRGG}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${HMPR}, ${PRRR}, ${PRRK}, ${PRMST}, ${PRCN}}) with tag="推荐、home、主页", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/home\/framework\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js", {${MY}, ${DT}, ${FX}}) with tag="底部选项卡", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js") with tag="发现页", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/link\/position\/show\/resource/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js") with tag="我的页面", timeout=20, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/e?api\/user\/follow\/users\/mixed\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/NetEaseCloudMusic/resource_NeteEseCloudMusic_remove_ads.js") with tag="显示未关注你的人", timeout=20, requires_body=true, binary_body_mode=true

[MITM]
hostname = interface*.music.163.com

