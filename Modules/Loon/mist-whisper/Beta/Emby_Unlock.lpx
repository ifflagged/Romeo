#!name=Emby解锁
#!desc=1. Emby 官方 iOS/macOS【客户端】播放权限解锁；2. 【浏览器】中下载视频或外挂字幕 ( 如果影片有外挂字幕且选中，则下载外挂字幕文件，否则下载视频文件 )、使用 Shu 下载 ( 如果影片有外挂字幕，则下载全部外挂字幕 )、使用 iOS 版 VLC 下载 ( 如果影片有外挂字幕且选中，则下载外挂字幕文件，否则下载视频文件 )、使用 iOS 版 nPlayer 播放 ( 不支持外挂字幕 )、使用 VLC 播放 ( 支持选中的外挂字幕 )、使用 iOS 和 macOS 版 Infuse 播放 ( 不支持外挂字幕 )。
#!author=rartv[https://github.com/rartv]
#!icon=icon not found
#!tag=mist-whisper
#!date=2022-07-06 20:05:57

[Script]
response if ${url} ~= /^https?:\/\/mb3admin.com\/admin\/service\/registration\/validateDevice/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Emby_Unlock/resource_EmbyUnlock.js") with tag="播放解锁", requires_body=true

response if ${url} ~= /((\/emby)*\/Users\/\w{32}\/Items\/\d+\?)|((\/emby)*\/Items\/\d+\/Download)|(\/web\/modules\/itemcontextmenu\.js)|(\/web\/item\/item\.js)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Emby_Unlock/resource_Emby.js") with tag="视频下载", requires_body=true

request if ${url} ~= /(\/Videos\/\d+\/stream\/.+\?.+&filename)|(\/Videos\/\d+\/\w{32}\/Subtitles\/\d+\/.+\?.+&filename)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Emby_Unlock/resource_Download_Path_Rename.js") with tag="请求路径重命名"

response if ${url} ~= /(\/Videos\/\d+\/stream\?.+&filename)|(\/Videos\/\d+\/\w{32}\/Subtitles\/.+&filename)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Emby_Unlock/resource_Download_File_Rename.js") with tag="下载文件重命名"

[MITM]
hostname = mb3admin.com, *.emby.wtf:0, *.plusmedia.site:0, *.jmsooo.com:0

