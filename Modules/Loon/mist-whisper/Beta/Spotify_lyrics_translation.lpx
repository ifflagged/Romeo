#!name=Spotify歌词增强
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=mist-whisper
#!date=2024-11-28 00:00:00

[Script]
response if ${url} ~= /^https?:\/\/api\.spotify\.com\/v1\/tracks\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_response.bundle.js") with tag="跟踪响应·JSON", requires_body=true

request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_request.bundle.js") with tag="歌词请求·JSON", requires_body=true

request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_request.bundle.js") with tag="歌词请求·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_Translate.response.bundle.js") with tag="翻译歌词响应·JSON", requires_body=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_Translate.response.bundle.js") with tag="翻译歌词响应·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_External.Lyrics.response.bundle.js") with tag="外部歌词响应·JSON", requires_body=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Spotify_lyrics_translation/DualSubs_External.Lyrics.response.bundle.js") with tag="外部歌词响应·Proto", requires_body=true, binary_body_mode=true

[MITM]
hostname = api.spotify.com, spclient.wg.spotify.com

