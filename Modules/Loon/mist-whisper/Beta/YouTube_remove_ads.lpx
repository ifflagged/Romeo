#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底部的上传按钮和Shorts按钮，增加画中画及字幕翻译功能，支持后台播放。需要启用QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=Jacob
#!date=2026-07-30 13:18:00

[Argument]
blockUpload=switch,false,true,tag=隐藏上传按钮, desc=隐藏上传按钮
blockShorts=switch,false,true,tag=隐藏短视频按钮, desc=隐藏短视频按钮
captionLang=input,"off",tag=字幕翻译语言, desc=字幕翻译语言

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://resource.wuyra.com/Script/YouTube/Youtube.response.js, requires-body=true, binary-body-mode=true, tag=youtube.response, argument=[{blockUpload},{blockShorts},{captionLang}]

http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://resource.wuyra.com/Script/YouTube/Youtube.request.js, requires-body=true, binary-body-mode=true, tag=youtube.request.init, argument=[{captionLang}]

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://resource.wuyra.com/Script/YouTube/Youtube.request.js, requires-body=true, binary-body-mode=true, tag=youtube.request.log_event

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com

