#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底部的上传按钮和Shorts按钮，增加画中画及字幕翻译功能，支持后台播放。需要启用QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!tag=mist-whisper
#!date=2026-07-30 13:18:00

[Argument]
blockUpload=switch,false,true,tag=隐藏上传按钮, desc=隐藏上传按钮
blockShorts=switch,false,true,tag=隐藏短视频按钮, desc=隐藏短视频按钮
captionLang=input,"off",tag=字幕翻译语言, desc=字幕翻译语言

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube_remove_ads/resource_Youtube.response.js", {${blockUpload}, ${blockShorts}, ${captionLang}}) with tag="youtube.response", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube_remove_ads/resource_Youtube.request.js", {${captionLang}}) with tag="youtube.request.init", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/YouTube_remove_ads/resource_Youtube.request.js") with tag="youtube.request.log_event", requires_body=true, binary_body_mode=true

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com

