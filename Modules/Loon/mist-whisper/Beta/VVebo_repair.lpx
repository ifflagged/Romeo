#!name=VVebo时间线修复
#!desc=修复失效的用户时间线和我的页面。使用此插件前建议禁用微博去广告插件，避免插件冲突导致失效。
#!author=suiyuran[https://github.com/suiyuran],androidcn[https://github.com/androidcn]
#!icon=icon not found
#!tag=mist-whisper
#!tag=功能增强
#!system=iOS iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!date=2025-05-13 15:17:08

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/users\/show\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/VVebo_repair/kelee_VVebo_repair.js") with tag="修复时间线"

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/VVebo_repair/kelee_VVebo_repair.js") with tag="修复时间线"

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/VVebo_repair/kelee_VVebo_repair.js") with tag="修复时间线"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/VVebo_repair/kelee_VVebo_repair.js") with tag="修复时间线", requires_body=true

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/VVebo_repair/kelee_VVebo_repair.js") with tag="修复我的页面", requires_body=true

[MITM]
hostname = api.weibo.cn

