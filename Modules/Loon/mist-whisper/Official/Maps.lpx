#!name= iRingo: 🗺️ Maps
#!desc=自定义 Maps app\n添加国际版功能\n自定义服务版本
#!version=4.7.0-beta1
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!tag= iRingo
#!system=iOS iPadOS macOS
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!icon=https://resource.wuyra.com/Icon/iRingo/maps-128x128.png
#!date=2026-08-21 19:16:13

[Argument]
UrlInfoSet.Dispatcher = select,"AutoNavi","AUTO","Apple",tag=[URL信息集] 调度器,desc=地点数据接口，此选项影响公共指南、兴趣点与位置信息等功能。
UrlInfoSet.Directions = select,"AutoNavi","Apple",tag=[URL信息集] 导航与 ETA,desc=导航与 ETA 服务接口。
UrlInfoSet.RAP = select,"Apple","AutoNavi",tag=[URL信息集] 评分和照片,desc=评分、照片及问题反馈服务接口。
UrlInfoSet.LocationShift = select,"AUTO","AutoNavi","Apple",tag=[URL信息集] 定位漂移,desc=定位漂移修正服务接口，控制指南针与坐标使用的坐标系。
TileSet.Earth = select,"CN","XX",tag=[瓦片数据集] 地球,desc=地球视图模型、材质、行政区划名称与极地数据。
TileSet.Road = select,"CN","XX",tag=[瓦片数据集] 道路,desc=道路、道路标签与道路选区数据。
TileSet.Satellite2D = select,"CN","XX",tag=[瓦片数据集] 2D 卫星图像,desc=2D 卫星图像及其夜间、极地等变体。
TileSet.Transit = select,"CN","XX",tag=[瓦片数据集] 公共交通,desc=公共交通与公共交通选区数据。
Storage = select,"Argument","PersistentStore","database",tag=[储存] 配置类型,desc=选择运行时读取模块参数、PersistentStore 或内置数据库的方式。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级。

[Rule]
# 🗺️ Amap
DOMAIN-SUFFIX,is.autonavi.com,DIRECT
# 🗺️ Maps
DOMAIN,gspe11-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe12-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe19-2-cn-ssl.ls.apple.com,DIRECT
DOMAIN,gspe79-cn-ssl.ls.apple.com,DIRECT

[Script]
# 🗺️ Network Defaults
http-request ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/request.bundle.js, tag=🗺️ Maps.config.defaults.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]
http-response ^https?:\/\/configuration\.ls\.apple\.com\/config\/defaults script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/response.bundle.js, requires-body=1, tag=🗺️ Maps.config.defaults.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]
# 🗺️ Announcements
http-request ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/request.bundle.js, tag=🗺️ Maps.config.announcements.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]
http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/config\/announcements script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/response.bundle.js, requires-body=1, binary-body-mode=1, tag=🗺️ Maps.config.announcements.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]
# 🗺️ Resource Manifest
http-request ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/request.bundle.js, tag=🗺️ Maps.config.announcements.request, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]
http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.(com|cn)\/geo_manifest\/dynamic\/config script-path=https://github.com/NSRingo/GeoServices/releases/download/v4.7.0-beta1/response.bundle.js, requires-body=1, binary-body-mode=1, tag=🗺️ Maps.geo_manifest.dynamic.config.response, argument=[{UrlInfoSet.Dispatcher},{UrlInfoSet.Directions},{UrlInfoSet.RAP},{UrlInfoSet.LocationShift},{TileSet.Earth},{TileSet.Road},{TileSet.Satellite2D},{TileSet.Transit},{Storage},{LogLevel}]

[MITM]
hostname = configuration.ls.apple.com, gspe35-ssl.ls.apple.com
