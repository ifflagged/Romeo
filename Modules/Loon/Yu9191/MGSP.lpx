#!name=咪咕视频
#!desc=伟人
#!icon=icon not found
#!tag=Yu9191

[Rewrite]
# > 开屏广告
^https://.*miguvideo\.com/request/sdk mock-response-body data-type=text data=" " status-code=200
^https://common-sc\.miguvideo\.com/task/v7/task-list/cmvideo/visitor mock-response-body data-type=text data=" " status-code=200

[Script]
# > 咪咕视频Vip会员
http-response ^https?:\/\/(play|dis).*miguvideo.com\/(play|dis)(url|play)\/.*$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MGSP/WeiGiegie_mgsp.js, requires-body=true, timeout=60, tag=mgsp

http-request ^https?:\/\/play.miguvideo.com\/playurl\/v1\/play\/playurl\?2Kvivid=true?.*=true$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MGSP/ios151_mgspck.js, timeout=60, tag=mgspck

[MITM]
hostname = *.miguvideo.com

