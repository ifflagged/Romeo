#!name=面具公社
#!desc=18+
#!icon=icon not found
#!tag=Yu9191

[Rewrite]
#游戏
^https:\/\/(mfjk|gnjk|buyaoda).+\.com\/request_game\/v3\/game\/list - reject-dict

[Script]
#广告
http-response https:\/\/(mfjk|gnjk|buyaoda).+\.com\/(playerinfo|api\/home\/popup|api\/get_advert) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MJGS/ios151_mjgsad.js, requires-body=true, timeout=60, tag=mjgsad

#视频
http-request https?:\/\/(mfjk|gnjk|buyaoda).+\.com\/api\/(comic|video|short_movie_info|novel|gallery|vip|index) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MJGS/ios151_mjgshd.js, timeout=60, tag=mjgshd

[MITM]
hostname = gnjk.*.com, mfjk.*.com, buyaoda.*.com

