#!name=kandonfang
#!desc=kandonfang
#!icon=icon not found
#!tag=Yu9191

[Rewrite]
# 首页弹窗广告
^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/advertise\/popup\/scene$ - reject
# 开屏广告（清除缓存）
https://bp-api.bestv.cn/cms/api/free/open/advertisingV2 - reject

[Script]
# NBA视频和电视剧
http-response https:\/\/bp-api\.bestv\.(?:com\.cn|cn)\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/kandonfang/ios151_video-parser.js, requires-body=true, timeout=60, tag=video-parser

# HTML页面
http-response ^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/kandonfang/ios151_video-parser.js, requires-body=true, timeout=60, tag=video-parser

[MITM]
hostname = 360.com, bp-api.bestv.com.cn, bp-api.bestv.cn

