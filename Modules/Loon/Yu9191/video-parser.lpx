[Script]
# NBA视频和电视剧
http-response https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js, requires-body=true, timeout=60, tag=video-parser

# HTML页面
http-response ^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js, requires-body=true, timeout=60, tag=video-parser

[MITM]
hostname = 360.com, bp-api.bestv.com.cn

