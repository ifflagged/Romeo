#!name=Apple WLOC 定位修改
#!desc=修改 Apple 网络定位返回坐标 | 快捷指令(推荐): 设置地理位置 https://www.icloud.com/shortcuts/a82717d8fdad4e6280866fcf911173f7 清理恢复位置 https://www.icloud.com/shortcuts/f42632d406504f24a2cd163af4fe012f | 选点页面: https://wloc-pages.pages.dev/
#!author=Yu9191 Rewrite
#!icon=icon not found
#!tag=Jacob
#!homepage=https://github.com/Yu9191/wloc
#!arguments-desc=经度/纬度: 默认坐标(在线选点储存后优先)\n精度: GPS精度(米)\n日志级别: off/error/warn/info/debug/all\n\n使用方法: 打开选点页面 -> 选位置 -> 储存到设备

[Argument]
经度=input,113.94114,tag=经度, desc=经度
纬度=input,22.544577,tag=纬度, desc=纬度
精度=input,25,tag=精度, desc=精度
日志级别=input,info,tag=日志级别, desc=日志级别

[Script]
http-response ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/wloc/Yu9191_wloc.js, requires-body=true, binary-body-mode=true, timeout=30, tag=Apple WLOC, argument=longitude={经度}&latitude={纬度}&accuracy={精度}&logLevel={日志级别}

http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/wloc/Yu9191_wloc-settings.js, timeout=10, tag=WLOC Settings

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com

