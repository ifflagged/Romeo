[Script]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/xqjs/ios151_xqjs.js") with tag="xqjs", timeout=60, requires_body=true

[MITM]
hostname = buy.itunes.apple.com

