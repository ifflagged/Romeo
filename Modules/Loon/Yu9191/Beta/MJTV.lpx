[Rewrite]
request if ${url} ~= /^https:\/\/api02\.maijitv\.com\/api\/v1\/layout\/floatingcards/i then reject(200)
request if ${url} ~= /^https:\/\/api\.maijitv\.com\/common\/findCommonConfig$/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/api\.maijitv\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MJTV/ios151_mjtv.js") with tag="mjtv", timeout=60, requires_body=true

[MITM]
hostname = api.maijitv.com

