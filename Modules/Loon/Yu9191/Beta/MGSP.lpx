#!name=咪咕视频
#!desc=伟人
#!icon=icon not found
#!tag=Yu9191

[Rewrite]
response if ${url} ~= /^https:\/\/.*miguvideo\.com\/request\/sdk/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https:\/\/common-sc\.miguvideo\.com\/task\/v7\/task-list\/cmvideo\/visitor/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/(play|dis).*miguvideo.com\/(play|dis)(url|play)\/.*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MGSP/WeiGiegie_mgsp.js") with tag="mgsp", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/play.miguvideo.com\/playurl\/v1\/play\/playurl\?2Kvivid=true?.*=true$/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/mgspck.js") with tag="mgspck", timeout=60

[MITM]
hostname = *.miguvideo.com

