#!name=insav 解锁
#!desc=去除广告,解锁视频
#!author=@Jsforbaby
#!icon=icon not found
#!tag=Yu9191
#!openUrl=http://boxjs.com/#/sub/add/https%3A%2F%2Fraw.githubusercontent.com%2FYu9191%2FRewrite%2Frefs%2Fheads%2Fmain%2Fpear.boxjs.json
#!homepage=https://github.com/Yu9191/Rewrite

[Argument]
player=input,"lenna",tag=播放器名称, desc=播放器名称
scheme=input,"完整的URLscheme",tag=自定义Scheme, desc=自定义Scheme
encode=input,"auto",tag=auto(自动), yes(强制编码), no(不编码), desc=auto(自动), yes(强制编码), no(不编码)
logLevel=input,"info",tag=off / error / warn / info(默认) / debug / all, desc=off / error / warn / info(默认) / debug / all\n\n推荐使用BoxJS配置，无需填写参数！\nBoxJS订阅: https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.boxjs.json

[Script]
request if ${url} ~= /^https?:\/\/(\w+\.)?(insav\.tv|[a-z]{4,}\d{2,}\.(top|com|net|cc|xyz))\/api\/(extend\/lists|banner\/lists|config\/lists|config\/links|notice\/lists|user\/(getVipStatus|info|login)|video\/(info|getVideoUrl))/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/insav-tv/dist/insav.js", {${player}, ${scheme}, ${encode}, ${logLevel}}) with tag="insav", timeout=20, requires_body=true

[MITM]
hostname = insav.tv, 4k.insav.tv, dm.insav.tv, *.rftn469.com, *.pbfk364.com, *.rahc448.com, wuma.*.*

