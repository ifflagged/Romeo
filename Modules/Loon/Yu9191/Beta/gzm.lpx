[Script]
response if ${url} ~= /^https?:\/\/(?:h5\.|platform\.)?singerdream\.com\/(?!.*\.jpg).*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/gzm/ios151_gzm.js") with tag="gzm", timeout=60, requires_body=true

[MITM]
hostname = h5.singerdream.com, platform.singerdream.com, singerdream.com

