[Script]
response if ${url} ~= /^https?:\/\/(?:h5\.|platform\.)?singerdream\.com\/(?!.*\.jpg).*$/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/gzm.js") with tag="gzm", timeout=60, requires_body=true

[MITM]
hostname = h5.singerdream.com, platform.singerdream.com, singerdream.com

