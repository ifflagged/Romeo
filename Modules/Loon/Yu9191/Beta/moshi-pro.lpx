[Script]
request if ${url} ~= /^https:\/\/api\.getmoshi\.app\/api\/(?:v1\/licenses\/(?:me|activate|[^\/]+\/devices)|ota\/manifest)(?:[\/?#]|$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/moshi-pro/ios151_moshi-pro.js") with tag="Moshi Pro", timeout=30, requires_body=true

[MITM]
hostname = api.getmoshi.app

