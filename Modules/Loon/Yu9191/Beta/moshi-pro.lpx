[Script]
request if ${url} ~= /^https:\/\/api\.getmoshi\.app\/api\/v1\/licenses\/(?:me|activate|[^\/]+\/devices)(?:[\/?#]|$)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/moshi/moshi-pro.js") with tag="Moshi Pro", timeout=30, requires_body=true

[MITM]
hostname = api.getmoshi.app

