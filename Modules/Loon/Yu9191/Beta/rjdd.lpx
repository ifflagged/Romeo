[Script]
response if ${url} ~= /^https?:\/\/.*\.mypep\.cn\/(thirdPartyService\/book_init(_v3)?\.json|user\/ak\/pep_click\/user\/.*\/userinfo\.json|loginvcode|unit\/encrypt\/detail)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/rjdd.js") with tag="rjdd", timeout=60, requires_body=true

[MITM]
hostname = *.mypep.cn

