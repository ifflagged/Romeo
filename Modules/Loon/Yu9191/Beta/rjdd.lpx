[Script]
response if ${url} ~= /^https?:\/\/.*\.mypep\.cn\/(thirdPartyService\/book_init(_v3)?\.json|user\/ak\/pep_click\/user\/.*\/userinfo\.json|loginvcode|unit\/encrypt\/detail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/rjdd/ios151_rjdd.js") with tag="rjdd", timeout=60, requires_body=true

