[Script]
request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/activity\/get_listen_song_task\?.*/i then script("https://gist.githubusercontent.com/Yu9191/f679b48faf12794f794e7f95fc823fe1/raw/kugou_signin.js") with tag="kugou_signin", timeout=60

cron "10 9 * * *" then script("https://gist.githubusercontent.com/Yu9191/f679b48faf12794f794e7f95fc823fe1/raw/kugou_signin.js") with tag="酷狗音乐概念版签到", timeout=120

[MITM]
hostname = gateway.kugou.com

