[Script]
request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/activity\/get_listen_song_task\?.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/KuGougainianban/Yu9191_kugou_signin.js") with tag="kugou_signin", timeout=60

cron "10 9 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/KuGougainianban/Yu9191_kugou_signin.js") with tag="酷狗音乐概念版签到", timeout=120

[MITM]
hostname = gateway.kugou.com

