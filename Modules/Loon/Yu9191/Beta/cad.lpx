[Script]
request if ${url} ~= /^https?:\/\/cad\.everdrawing\.com\/(mobile\/verifyVip|.*authorize\/(verify-vip|query))/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/cad.js") with tag="cad", timeout=60, requires_body=true

