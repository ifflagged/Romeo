[Script]
response if ${url} ~= /^https:\/\/www\.mxs11\.cc\/(chapter|book)\/\d+/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/mxshm.js") with tag="mxshm", timeout=60, requires_body=true

[MITM]
hostname = www.mxs11.cc

