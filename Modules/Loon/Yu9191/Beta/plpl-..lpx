[Script]
response if ${url} ~= /https:\/\/(?:\S+\/video\/info\/.*\?token=\S+)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/plpl.js") with tag="plpl", timeout=60, requires_body=true

[MITM]
hostname = apiaws.*.com, apiaws.*.cn, *apiaws*

