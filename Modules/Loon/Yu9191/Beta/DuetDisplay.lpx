[Script]
response if ${url} ~= /https:\/\/rdp.duetdisplay.com\/v1\/users\/validateReceipt/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/DuetDisplay.js") with tag="DuetDisplay", timeout=60, requires_body=true

