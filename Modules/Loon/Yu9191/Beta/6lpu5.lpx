[Script]
response if ${url} ~= /^https?:\/\/[a-z0-9]+\.wt33k\.com\/(home\/getAds|base\/getBulletin|panel\/(list|get))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/6lpu5/ios151_6lpu5.response.js") with tag="含羞草_广告", timeout=15, requires_body=true

response if ${url} ~= /^https?:\/\/www\.6lpu5\.com\/play\/video\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/6lpu5/ios151_6lpu5.response.js") with tag="含羞草_视频", timeout=15, requires_body=true

[MITM]
hostname = *.wt33k.com, www.6lpu5.com

