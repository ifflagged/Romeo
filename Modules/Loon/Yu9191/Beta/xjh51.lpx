#!name=xjh51 香蕉视频
#!desc=VIP 视频解锁 + 去广告 + 外部播放器
#!author=Yu9191 Rewrite
#!icon=icon not found
#!tag=Yu9191
#!homepage=https://github.com/Yu9191/Rewrite

[Argument]
logLevel=input,"info",tag=off / error / warn / info(默认) / debug / all, desc=off / error / warn / info(默认) / debug / all
player=input,"SenPlayer",tag=lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / potplayer / Safari, desc=lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / potplayer / Safari
scheme=input,"none",tag=填写后覆盖播放器，例如 myplayer://play?url= ；留默认 none 表示不启用, desc=填写后覆盖播放器，例如 myplayer://play?url= ；留默认 none 表示不启用
encode=input,"default",tag=yes / no / default(默认，走播放器默认行为), desc=yes / no / default(默认，走播放器默认行为)
jump=input,"no",tag=yes(解锁时自动跳转外部播放器) / no(默认，仅通知), desc=yes(解锁时自动跳转外部播放器) / no(默认，仅通知)

[Script]
response if ${url} ~= /^https?:\/\/www\.xjh51\.tv\/api\/(?:init|index|ucp\/index|v2\/vod\/(?:reqplay|listing)|vod\/(?:reqplay|show)|getLikeRows|special\/listing|game\/broadcasts)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/xjh51/dist/xjh51.js", {${logLevel}, ${player}, ${scheme}, ${encode}, ${jump}}) with tag="xjh51 API", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/www\.xjh51\.tv\/(?:index|pc)\.html/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/xjh51/dist/xjh51-frontend.js") with tag="xjh51 Frontend", timeout=10, requires_body=true

[MITM]
hostname = www.xjh51.tv

