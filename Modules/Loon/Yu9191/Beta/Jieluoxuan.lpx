[Script]
response if ${url} ~= /^https:\/\/(app|api)\.helixlife\.cn\/api\/v1\/(user\/(users\/profile|overviews)|edu\/(trainings|courses|meeting_lives)|public\/search)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/Jieluoxuan.js") with tag="Jieluoxuan", timeout=60, requires_body=true

[MITM]
hostname = *.helixlife.cn

