#!name=Topluntan
#!desc=Topluntan
#!icon=icon not found
#!tag=Yu9191

[Script]
response if ${url} ~= /^https:\/\/super\.toppps\.com\/app-api\/v(1|3)\/(toppps\/(live\/getLiveSpaceDetailsV|products)|blueMain)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TOPlt.js") with tag="Topluntan", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/mpv\.videocc\.net\/.*\.mp4/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TOPlt.js") with tag="Topluntan-Video", timeout=60

[MITM]
hostname = super.toppps.com, mpv.videocc.net

