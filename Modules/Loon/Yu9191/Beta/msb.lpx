[Script]
response if ${url} ~= /https:\/\/gateway\.mashibing\.com\/edu-course\/(coursePackage\/app\/1|app\/systemCourse|courseWeb)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/msb.js") with tag="msb", timeout=60, requires_body=true

[MITM]
hostname = gateway.mashibing.com

