[Rewrite]
request if ${url} ~= /https:\/\/api.lianjiu.fun\/app\/api\/v1\/profile/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/Reven/ios151_Revenuecat.js") with tag="Revenuecat", timeout=60, requires_body=true

request if ${url} ~= /^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/Reven/ios151_Revenuecat.js") with tag="Revenuecat", timeout=60

[MITM]
hostname = api.revenuecat.com, api.lianjiu.fun

