[Script]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/Clipboard-itunes/ios151_Clipboard.js") with tag="Clipboard", timeout=60, requires_body=true

[MITM]
hostname = buy.itunes.apple.com

