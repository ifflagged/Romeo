#!name=insav
#!desc=解锁insav全部VIP功能，去除广告，支持选择播放器跳转（支持BoxJS配置）
#!author=@Jsforbaby
#!icon=icon not found
#!tag=Yu9191

[Argument]
player=input,"lenna",tag=播放器名称, desc=播放器名称
scheme=input,"完整的URLscheme",tag=自定义Scheme, desc=自定义Scheme
encode=input,"auto",tag=auto(自动), yes(强制编码), no(不编码), desc=auto(自动), yes(强制编码), no(不编码)\n\n推荐使用BoxJS配置，无需填写参数！\nBoxJS订阅: https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/pear.boxjs.json

[Script]
request if ${url} ~= /^https?:\/\/(insav\.tv|4k\.insav\.tv|dm\.insav\.tv|wuma\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62}(\.[a-zA-Z0-9][-a-zA-Z0-9]{0,62})+(:[0-9]+)?|.*\.[a-z]{4}\d{3}\.com)\/api\/(extend\/lists|config\/lists|config\/links|notice\/lists|user\/(getVipStatus|info|login)|video\/getVideoUrl)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/insav.tv.js", {${player}, ${scheme}, ${encode}}) with tag="insav.tv", timeout=60, requires_body=true

[MITM]
hostname = insav.tv, 4k.insav.tv, dm.insav.tv, *.rftn469.com, *.pbfk364.com, *.rahc448.com, wuma.*.com, wuma.*.top

