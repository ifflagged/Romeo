[Script]
response if ${url} ~= /^https:\/\/.*\.(intsig\.net|camscanner\.com)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/CamScanner.js") with tag="CamScanner", timeout=60, requires_body=true

[MITM]
hostname = *.camscanner.com, *.intsig.net

