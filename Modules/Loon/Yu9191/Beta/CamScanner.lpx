[Script]
response if ${url} ~= /^https:\/\/.*\.(intsig\.net|camscanner\.com)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/CamScanner/ios151_CamScanner.js") with tag="CamScanner", timeout=60, requires_body=true

[MITM]
hostname = *.camscanner.com, *.intsig.net

