[Script]
response if ${url} ~= /^https:\/\/parseapi\.handyapp\.(cn|io)\/parse\/classes\/(Theme|Discover|ExploreBanner|StandbyPromote)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/Handy.js") with tag="Handy", timeout=60, requires_body=true

[MITM]
hostname = parseapi.handyapp.*

