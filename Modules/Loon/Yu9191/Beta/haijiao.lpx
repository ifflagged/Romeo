[Script]
response if ${url} ~= /^https?:\/\/(www\.)?haijiao\.com\/api\/(banner\/banner_list|attachment|topic\/\d+)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/haijiao/dist/haijiao.js") with tag="海角API", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/ts\d+\.hj\d+\.top\/.*\.m3u8$/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/haijiao/dist/haijiao.js") with tag="海角m3u8", timeout=20, requires_body=true

[MITM]
hostname = haijiao.com, www.haijiao.com, *.hj260302818.top

