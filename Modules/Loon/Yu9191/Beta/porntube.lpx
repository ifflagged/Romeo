[Argument]
logLevel=input,"info",tag=off / error / warn / info(默认) / debug / all, desc=off / error / warn / info(默认) / debug / all
player=input,"lenna",tag=lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / Safari, desc=lenna / SenPlayer / SenPlayer-dl / Infuse / Fileball / VidHub / IINA / Alook / VLC / KMPlayer / NPlayer / Safari
scheme=input,"none",tag=填写后覆盖播放器，例如 myplayer://play?url= ；留默认 none 表示不启用, desc=填写后覆盖播放器，例如 myplayer://play?url= ；留默认 none 表示不启用
encode=input,"default",tag=yes / no / default(默认，走播放器默认行为), desc=yes / no / default(默认，走播放器默认行为)
jump=input,"yes",tag=yes(默认) / no, desc=yes(默认) / no

[Script]
request if ${url} ~= /^https?:\/\/v2\.(?:cdn199\.com|kekecdn\.net|luchu\.org|madou\.ws|papapa\.biz|tianmtv\.com|xiaoshuo\.info|xiaoshuo\.la)\/js/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/porntube/dist/porntube-request.js") with tag="porntube 请求", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/v2\.(?:cdn199\.com|kekecdn\.net|luchu\.org|madou\.ws|papapa\.biz|tianmtv\.com|xiaoshuo\.info|xiaoshuo\.la)\/js/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/porntube/dist/porntube.js", {${logLevel}, ${player}, ${scheme}, ${encode}, ${jump}}) with tag="porntube API", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/(?:porntube\.(?:cool|fit|site|store)|91porn\.(?:coach|top|band|name|plus|porn|red|sex)|91pornny\.com|91\.wtf|91forum\.com|91dabiaojie\.com|91zpc\.(?:app|pro|org|co|com)|chineseselfie\.(?:com|net|org)|xchina\.(?:day|cloud|plus|tube|cool|red)|xasian\.org|theporny\.com|madoumedia\.org|1024(?:videos|movies)\.com|bdsmzoo\.com|pornshop\.one|pilipili\.cool|dsdav\.net|x91\.club|x91porn\.com|chinesebdsm\.\w+)\/(?:video\/[^\/?]+|videos\?|videos$|$|\?)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/porntube/dist/porntube-frontend.js") with tag="porntube 前端", timeout=20, requires_body=true

