[Script]
response if ${url} ~= /^https?:\/\/(www\.)?haijiao\.com\/api\/(attachment|topic\/\d+|banner\/banner_list)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/haijiao.js") with tag="haijiao", timeout=60, requires_body=true

[MITM]
hostname = haijiao.com, *.haijiao.com

