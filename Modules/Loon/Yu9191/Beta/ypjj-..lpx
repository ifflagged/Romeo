#!name=ypjj-
#!desc=ypjj-
#!icon=icon not found
#!tag=Yu9191

[Rewrite]
request if ${url} ~= /^https:\/\/ad\.camoryapps\.com\/api\/app\/get\/ad/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/pay\.camoryapps\.com\/appPay\/api\/user\/info\/tokenLogin/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/ypjj.js") with tag="ypjj", timeout=60, requires_body=true

[MITM]
hostname = pay.camoryapps.com, ad.camoryapps.com

