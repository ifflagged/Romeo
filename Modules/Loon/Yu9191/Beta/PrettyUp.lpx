[Script]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/itunes/PrettyUp.js") with tag="PrettyUp", timeout=60, requires_body=true

