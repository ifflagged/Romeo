[Rewrite]
request if ${url} ~= /^http:\/\/206\.119\.85\.11:8361\/ad\/getAd$/i then reject(200)
request if ${url} ~= /^http:\/\/47\.57\.71\.112:8361\/ad\/getAd$/i then reject(200)

[Script]
