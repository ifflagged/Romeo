[Script]
response if ${url} ~= /^https?:\/\/(user-api\.speedtest\.net\/v1\/flows\/users\/(me\/)?(login|apply-identities)|(www\.)?speedtest\.net\/(api\/)?ios-config\.php)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/speedtest.js") with tag="Speedtest_advip", requires_body=true

