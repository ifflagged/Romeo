[Script]
request if ${url} ~= /^https:\/\/[^\/]*\..*\.cn\/\w+\/[a-z0-9]{32}\/[a-z0-9]{32}\.m3u8(\?.*)?/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/lsp/Tangtoutiao.js") with tag="Tangtoutiao", timeout=60

[MITM]
hostname = *.shjsvkj.cn, *.qxoovv.cn, *.shoknkj.cn, *.shedbgs.cn, *.shnyigs.cn, *.sholfgs.cn, *.shjtqgs.cn, *.shjtpkj.cn, *.hfsudf.cn, *.qohzni.cn

