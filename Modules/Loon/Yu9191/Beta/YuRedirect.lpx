#!name=Yu9191 → ios151 链接重定向
#!desc=旧号 Yu9191 已迁移至 ios151，访问 raw / github 旧路径时自动 302 到新号
#!author=ios151
#!icon=icon not found
#!tag=Yu9191
#!homepage=https://github.com/ios151/Rewrite

[Rewrite]
#undefined undefined undefined
request if ${url} ~= /^https:\/\/raw\.githubusercontent\.com\/Yu9191\/Yu9191\/(.*)/i then redirect(302, "https://raw.githubusercontent.com/ios151/ios151/$1")
request if ${url} ~= /^https:\/\/raw\.githubusercontent\.com\/Yu9191\/(.*)/i then redirect(302, "https://raw.githubusercontent.com/ios151/$1")
request if ${url} ~= /^https:\/\/github\.com\/Yu9191\/Yu9191(\/.*)?$/i then redirect(302, "https://github.com/ios151/ios151$1")
request if ${url} ~= /^https:\/\/github\.com\/Yu9191(\/.*)?$/i then redirect(302, "https://github.com/ios151$1")

[MITM]
hostname = raw.githubusercontent.com, github.com

