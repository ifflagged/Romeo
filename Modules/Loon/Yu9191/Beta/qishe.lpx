[Script]
response if ${url} ~= /^https?:\/\/[\w-]+\.qsh\d+\.(?:com|cn|org\.cn)\/(?:source\/plugin\/qsts_app\/index\.php|mserver)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/qishe/ios151_qishe.js") with tag="妻社", timeout=30, requires_body=true

