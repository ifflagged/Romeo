[Script]
response if ${url} ~= /^https?:\/\/[\w-]+\.qsh\d+\.(?:com|cn|org\.cn)\/(?:source\/plugin\/qsts_app\/index\.php|mserver)\//i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/qishe/qishe.js") with tag="妻社", timeout=30, requires_body=true

