[Rewrite]
request if ${url} ~= /^https:\/\/lab\.shadowbox\.top\/ab\/apppage\/launch$/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/lab\.shadowbox\.top\/ab/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/mohe.js") with tag="mohe", timeout=60, requires_body=true

[MITM]
hostname = lab.shadowbox.top

