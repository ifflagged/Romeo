[Script]
response if ${url} ~= /https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js") with tag="video-parser", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/video-parser/ios151_video-parser.js") with tag="video-parser", timeout=60, requires_body=true

[MITM]
hostname = 360.com, bp-api.bestv.com.cn

