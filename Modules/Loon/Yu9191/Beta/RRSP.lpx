#!name=人人视频
#!desc=频道获取每日最新Token..UMID
#!author=@Jsforbaby
#!icon=icon not found
#!tag=Yu9191

[Argument]
token=input,"请填写",tag=Token, desc=Token
umid=input,"请填写",tag=UMID, desc=UMID
player=input,"SenPlayer",tag=播放器名称, desc=播放器名称
scheme=input,"xxx",tag=自定义Scheme, desc=自定义Scheme

[Script]
request if ${url} ~= /^https?:\/\/api\.rrmj\.plus\/m-station\/drama\/(?:page|play)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/RRSP.js", {${token}, ${umid}, ${player}, ${scheme}}) with tag="RRTV_4K", timeout=60, requires_body=true

[MITM]
hostname = api.rrmj.plus

