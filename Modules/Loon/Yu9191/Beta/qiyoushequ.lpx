#!name=妻友社区解锁
#!desc=VIP 解锁 + 去广告 + 完整 m3u8 + 第三方播放器跳转可选
#!author=Yu9191 Rewrite
#!icon=icon not found
#!tag=Yu9191
#!homepage=https://github.com/Yu9191/Rewrite

[Argument]
player=input,"lenna",tag=播放器名称, desc=播放器名称
scheme=input,"完整的URLscheme",tag=自定义Scheme, desc=自定义Scheme
encode=input,"auto",tag=auto(自动), yes(强制编码), no(不编码), desc=auto(自动), yes(强制编码), no(不编码)
logLevel=input,"info",tag=off / error / warn / info(默认) / debug / all, desc=off / error / warn / info(默认) / debug / all\n\n推荐使用BoxJS配置，无需填写参数！
jump=input,"yes",tag=yes(通知跳转外部播放器), no(不通知、不跳转), desc=yes(通知跳转外部播放器), no(不通知、不跳转)

[Script]
response if ${url} ~= /^https?:\/\/d1kmvkv4iwtiup\.cloudfront\.net\/js\/index-Dg2qL6uR\.\d+\.js/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/qiyoushe/dist/qiyoushequ.js", {${player}, ${scheme}, ${encode}, ${logLevel}, ${jump}}) with tag="妻友社区启动页", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/d1kmvkv4iwtiup\.cloudfront\.net\/api\/app\/(ping\/config|login\/guest|user\/info|media\/(play|home|short\/hot)|card\/(promotion|list|advance\/status)|post\/(detail|list|pay|rent\/check))/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/qiyoushe/dist/qiyoushequ.js", {${player}, ${scheme}, ${encode}, ${logLevel}, ${jump}}) with tag="妻友社区", timeout=20, requires_body=true

[MITM]
hostname = *.cloudfront.net, *.gcwe44p.com

