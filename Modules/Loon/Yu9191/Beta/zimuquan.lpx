[Script]
response if ${url} ~= /^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\//i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/zimuquan.js") with tag="zimuquan", timeout=60, requires_body=true

[MITM]
hostname = *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com

