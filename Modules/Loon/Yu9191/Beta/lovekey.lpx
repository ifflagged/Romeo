#!name=Lovekey键盘
#!desc=无限制使用 更新2026-10-11
#!icon=icon not found
#!tag=Yu9191

[Script]
request if ${url} ~= /^https:\/\/sea\.api\.lovekeyboard\.com\/\S*(?:-(?:ow|stream)-msg|stream_super_msg)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/lovekey/ios151_lovekey.js") with tag="Lovekey-聊天", timeout=60

response if ${url} ~= /^https:\/\/sea\.api\.lovekeyboard\.com\/v2\/account/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/lovekey/ios151_lovekey.js") with tag="Lovekey-账号", timeout=60, requires_body=true

[MITM]
hostname = sea.api.lovekeyboard.com

