[Script]
response if ${url} ~= /https:\/\/apiv2.vivipic.com\/get-tx-info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/genpix/ios151_genpix.js") with tag="genpix", timeout=60, requires_body=true

request if ${url} ~= /https:\/\/apiv2.vivipic.com\/gen-image-v3/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/genpix/ios151_genpix.js") with tag="genpix", timeout=60, requires_body=true

