[Rewrite]
request if ${url} ~= /xhlld.*\.shop\/view\/(adList|getVideoInfoAdList)/i then reject(200)

[Script]
response if ${url} ~= /xhlld.*\.shop\/view\/getVideoInfo\/\d+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/xiaohuli/ios151_xiaohuli.js") with tag="xiaohuli", timeout=60, requires_body=true

[MITM]
hostname = *.xhlld076.shop, *.xhlsc006.shop

