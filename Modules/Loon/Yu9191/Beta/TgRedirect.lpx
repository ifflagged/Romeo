#!name=Telegram跳转
#!desc=将 https://t.me/... 重定向到你选择的客户端（tg/sg/turrit/ime/ng/lingo
#!author=b
#!icon=icon not found
#!tag=Yu9191

[Argument]
client=input,"Telegram",tag=Telegram/Swiftgram/Turrit/iMe/Nicegram/Lingogram 或 tg/sg/turrit/ime/ng/lingo, desc=Telegram/Swiftgram/Turrit/iMe/Nicegram/Lingogram 或 tg/sg/turrit/ime/ng/lingo

[Script]
request if ${url} ~= /^https?:\/\/t\.me\/.+/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TgRedirect.js", {${client}}) with tag="tme_redirect"

[MITM]
hostname = t.me

