[Rewrite]
request if ${url} ~= /^https?:\/\/hm-img\.xuezhumall\.com\/(.*\/)preview\.m3u8/i then redirect(302, "https://hm-img.xuezhumall.com/$1index.m3u8")

[Script]
response if ${url} ~= /^https:\/\/([a-zA-Z0-9-]+\.)*[a-zA-Z0-9-]+\.[a-z]{2,}(:\d+)?\/(video-details\/[0-9]*|api\/users\/[a-zA-Z0-9-_]+)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/65kan.js") with tag="65kan", timeout=60, requires_body=true

[MITM]
hostname = *.413550.xyz, *.xuezhumall.com, *.413550.xyz:8283

