#!name=Fi11 VIP 解锁
#!desc=Fi11 解锁 VIP 视频 + 去广告
#!author=Jsforbaby
#!icon=icon not found
#!tag=Yu9191

[Argument]
logLevel=input,"info",tag=off / error / warn / info(默认) / debug / all, desc=off / error / warn / info(默认) / debug / all

[Script]
request if ${url} ~= /^https?:\/\/a74d\.uwegu\.com\/(videos\/v2\/getUrl|visitor\/add)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/hvvj0/dist/fi11.js", {${logLevel}}) with tag="fi11-req", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/a74d\.uwegu\.com\/(videos\/(getInfo|getList|getRecommendListByVideoId|getFeatured|getHot)|gather\/(getDetail|getListByVideoId)|visitor\/getOrderInfo|user\/(getUserHome|getInfo|detail|info)|home\/(getAds|getMoreAds|getMoreAdsList))/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/hvvj0/dist/fi11.js", {${logLevel}}) with tag="fi11-resp", timeout=30, requires_body=true

[MITM]
hostname = a74d.uwegu.com

