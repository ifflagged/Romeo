[Script]
response if ${url} ~= /https:\/\/api.revenuecat.com\/v1\/(receipts|subscribers)\/*/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/PureLibro.js") with tag="PureLibro", timeout=60, requires_body=true

[MITM]
hostname = api.revenuecat.com

