[Script]
response if ${url} ~= /^(https:\/\/be\.aimirror\.fun\/(draw|draw\/process|query_is_vip|users\/video_render_count|query_consumable_quota|users\/discount))/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/aimirror.js") with tag="aimirror", timeout=60, requires_body=true

