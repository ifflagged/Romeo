[Script]
response if ${url} ~= /^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/itunes/bs.js") with tag="bs", timeout=60, requires_body=true

[MITM]
hostname = buy.itunes.apple.com

