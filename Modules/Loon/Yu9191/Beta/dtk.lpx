[Script]
response if ${url} ~= /^https:\/\/admin\.dingtiku\.cn\/app\/(testinfo\/listTestInfo|video\/getVideoCourseDetails|testinfo\/startTest|video\/listVideoCourse|buy\/getBuyDetails|user\/getUserScore)/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/dtk.js") with tag="dtk", timeout=60, requires_body=true

