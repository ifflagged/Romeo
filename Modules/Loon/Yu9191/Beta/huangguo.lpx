#!name=黄果短剧去广告
#!desc=去广告（播放跳转/轮播/横幅/贴片）
#!author=ios151 Rewrite
#!icon=icon not found
#!tag=Yu9191
#!homepage=https://github.com/ios151/Rewrite
#!date=2026-09-02

[Rule]
URL-REGEX,"^https?://[^/]*adsdk[12]\.cc",REJECT

[Script]
response if ${url} ~= /^https?:\/\/huangguoai\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/huangguo/ios151_huangguo.js") with tag="黄果短剧", timeout=30, requires_body=true

[MITM]
hostname = huangguoai.com, *.huangguoai.com, *.adsdk1.cc, *.adsdk2.cc

