[Script]
response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/iTunes.js") with tag="iTunes", timeout=60, requires_body=true

[MITM]
hostname = buy.itunes.apple.com

