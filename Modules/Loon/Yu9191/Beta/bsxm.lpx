[Script]
request if ${url} ~= /^http:\/\/\d{10}\.vod2\.myqcloud\.com\/[a-zA-Z0-9]+\/[a-zA-Z0-9]+\/video_\d+_\d+\.m3u8/i then script("https://raw.githubusercontent.com/Yu9191/Rewrite/main/m3u8/bsxm.js") with tag="bsxm", timeout=60

[MITM]
hostname = *.vod2.myqcloud.com

