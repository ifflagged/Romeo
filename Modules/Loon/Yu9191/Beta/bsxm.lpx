[Script]
request if ${url} ~= /^http:\/\/\d{10}\.vod2\.myqcloud\.com\/[a-zA-Z0-9]+\/[a-zA-Z0-9]+\/video_\d+_\d+\.m3u8/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/bsxm/ios151_bsxm.js") with tag="bsxm", timeout=60

[MITM]
hostname = *.vod2.myqcloud.com

