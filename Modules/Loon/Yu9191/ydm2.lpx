[Rewrite]
# 广告 
^https://(?:[a-zA-Z0-9-]+\.cloudfront\.net|snerbnew\.pxyzjmspfl\.work)(?::\d+)?/api/?(?:sys/partner/list|activity/indexActs|sys/advertisement/list|sys/getImgAndVideoCdnList|aibox/entranceConfig)?$ - reject

[Script]
# 视频
http-request https:\/\/[^\/]+\.cloudfront\.net\/api\/m3u8\/decode\/authPath script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm2/ios151_ydm2.js, timeout=60, tag=ydm2

#三年二班 
http-request ^https:\/\/snerbnew\.pxyzjmspfl\.work(?::\d+)?\/api\/m3u8\/decode\/authPath script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm2/ios151_ydm2.js, timeout=60, tag=ydm2

[MITM]
hostname = *.cloudfront.net, snerbnew.pxyzjmspfl.work, snerbnew.pxyzjmspfl.work:51999

