#!name=Telegram跳转
#!desc=将 https://t.me/... 重定向到你选择的客户端（tg/sg/turrit/ime/ng/lingo
#!author=b
#!icon=icon not found
#!tag=Yu9191
#!arguments-desc=Client: Telegram/Swiftgram/Turrit/iMe/Nicegram/Lingogram 或 tg/sg/turrit/ime/ng/lingo

[Argument]
Client=input,Telegram,tag=Client, desc=Client

[Script]
http-request ^https?:\/\/t\.me\/.+ script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/TgRedirect.js, tag=tme_redirect, argument=client={Client}

[MITM]
hostname = t.me

