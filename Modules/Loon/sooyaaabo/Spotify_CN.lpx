#!name = Spotify
#!desc = 移除Spotify广告并解锁部分高级功能。音质无法设置为“极高（Very High）”。可选功能：隐藏正在播放页面的发现推荐信息流、设置页面的会员信息及AI DJ入口。启用插件后，请重新登录以应用完整配置。\n该插件基于devchristian1337的Spotify插件汉化。
#!openUrl = https://apps.apple.com/app/id324684580
#!author = devchristian1337[https://github.com/devchristian1337]
#!tag = 去广告, 会员解锁
#!system = 
#!system_version = 
#!loon_version = 3.5.3(1014)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Spotify.png
#!date = 2026-11-10 23:00

# 2026-11-10
# https://raw.githubusercontent.com/devchristian1337/loon-plugins/main/Plugins/Spotify.lpx

[Argument]
spot_remote_config = switch, false, true, tag = Protobuf远程配置修改, desc = 另一种Protobuf修补方案，用于修改bootstrap/customize响应中由服务器下发的功能标志。关闭时（推荐）将使用本地配置覆盖方案：根据应用版本（9.1.76及更新版本，或更早版本）匹配对应的高级会员配置快照。两种方案只会运行其中一种，不会同时运行。
hide_discovery_feed = switch, true, false, tag = 隐藏发现推荐, desc = 隐藏正在播放页面中显示的发现推荐信息流
hide_membership_info = switch, true, false, tag = 隐藏会员信息, desc = 隐藏设置页面中的会员信息（仅影响显示）
hide_ai_dj = switch, true, false, tag = 隐藏AI DJ, desc = 屏蔽AI DJ入口，使其不在应用中显示

[Rule]
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT
DOMAIN, aet.spotify.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize/i then request.header.del("if-none-match")

# 从应用 9.1.98 开始，配置和账户属性通过以下两个接口刷新；如果不删除条件请求头，服务器将返回 304，导致应用继续使用未修补的缓存。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$/i then request.header.del("if-none-match")
request if ${url} ~= /^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon/i then reject_dict(200)

# 广告投放接口，包括播放器核心及首页横幅使用的接口（ads/*、ad-logic/*、ad-on-app-open），以及高级会员升级推广接口。请求失败后，应用将跳过广告播放。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer)/i then reject(404)

# 可选功能，每项均由独立开关控制（条件重写语法，需要 Loon 3.5.1 或更高版本）
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/watch-feed-entrypoints\/v\d\/discovery-from-seed/ && ${hide_discovery_feed} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/[\w-]+-spclient\.spotify\.com(?::443)?\/pam-view-service\// && ${hide_membership_info} == true then reject_dict(200)
request if ${url} ~= /37i9dQZF1EYkqdzj48dyYq/ && ${hide_ai_dj} == true then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-gabo.js") with tag="[Spotify]GABO请求处理", timeout=10

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-NoSearchAd.js") with tag="[Spotify]搜索广告处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-NoHomeAd.js") with tag="[Spotify]首页广告处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-NoScrollAd.js") with tag="[Spotify]滚动信息流广告处理", timeout=10, requires_body=true, binary_body_mode=true

# 对于同一个响应，仅第一个匹配的脚本会运行：远程修补规则排在前面，仅在对应开关开启时运行；否则由下面的本地配置覆盖规则处理。
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-proto-eevee.js") with enable=${spot_remote_config}, tag="[Spotify]Protobuf远程配置", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-proto-ev3.js") with tag="[Spotify]Protobuf本地配置", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Spotify_CN/devchristian1337_spot-proto-ev3.js") with tag="[Spotify]Protobuf版本9.1.98及以上的配置与属性）", timeout=10, requires_body=true, binary_body_mode=true

[MitM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com