#!name = 虎扑
#!desc = 过滤虎扑广告
#!openUrl = https://apps.apple.com/app/id906632439
#!author = ishowshu[https://github.com/ishowshu]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/HUPU-01.png
#!date = 2026-09-23 00:00

# 2026-08-19
# https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/hupu.snippet

[Rewrite]
# 我的页面游戏栏目
request if ${url} ~= /^https:\/\/fairy\.mobileapi\.hupu\.com\/gallery\/getmod2/i then reject_dict(200)

# 搜索框提示词
request if ${url} ~= /^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/search\/v2\/hintkeylist/i then reject_dict(200)

# 专区Tab最近浏览
request if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/users\/browse\/topics/i then reject_dict(200)

# 话题榜
request if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/tag\/v1\/heatTag/i then reject_dict(200)

# 评分榜
request if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsrankapi\/bff\/v1\/rating\/list/i then reject_dict(200)

# 开屏广告、信息流广告、评论区广告
response if ${url} ~= /^https:\/\/goblin\.hupu\.com\/\d\/\d\.\d\.\d+\/interfaceAd\/getOther/i then response.json.jq(".ad_code = -41 | .ads = [] | if has(\"interval\") then .interval = 0 else . end")

# 我的页面VIP推广
response if ${url} ~= /^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplapi\/user\/v1\/more/i then response.json.jq("del(.result.inviteInfo, .result.vipInfo)")

# 推荐页横幅广告
response if ${url} ~= /^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/buffer\/hotList/i then response.json.jq(".result.topBanner = []")

# 专区顶部横幅
response if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/topics\/\d/i then response.json.jq(".data.topicResources = []")

# 专区推荐Tab
response if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/topics\/topicSquareDetail/i then response.json.jq(".data.list |= map(select(.cate_id != -99))")

# 我的页面底部菜单
response if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/lego\/data/i then response.json.jq(".data.cards |= map(select(.code != \"multiIcon\"))")

# NBA页签到活动
response if ${url} ~= /^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplbffapi\/device\/v1\/nav\/content/i then response.json.jq(".result.components |= map(select(.order != 5))")

# 虎扑广场顶部话题
response if ${url} ~= /^https:\/\/bbs\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bbsallapi\/tab\/cardModule/i then response.json.jq(".data = {}")

# 顶部频道净化
# response if ${url} ~= /^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bpldeviceapi\/device\/v1\/nav\/detail/i then response.json.jq(".result.topNav.navs |= map(.usePic = false)")

[MitM]
hostname = games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com, match-api.hupu.com, *.hupu.com