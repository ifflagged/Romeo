[Rule]
# 放行地址
DOMAIN, push.m.youku.com, DIRECT
DOMAIN, un-acs.youku.com, DIRECT
DOMAIN, dorangesource.alicdn.com, DIRECT

# 拦截地址
DOMAIN, h-adashx.ut.taobao.com, REJECT
DOMAIN, adx-core.youku.com, REJECT
DOMAIN, adx-open-service.youku.com, REJECT
DOMAIN, yk-ssp.ad.youku.com, REJECT
DOMAIN, cad.youku.com, REJECT
DOMAIN, ykad-data.youku.com, REJECT
DOMAIN, yk-ssp.ad.youku.com, REJECT
DOMAIN, amdc.m.youku.com, REJECT
DOMAIN, cad.youku.com, REJECT
DOMAIN, nbsdk-baichuan.alicdn.com, REJECT
DOMAIN, youku-crm-product.youku.com, REJECT
DOMAIN, dr-danmu.youku.com, REJECT
DOMAIN, group-ssl-danmu-ori.youku.com, REJECT
DOMAIN, m.atm.youku.com, REJECT
DOMAIN, mc.atm.youku.com, REJECT
DOMAIN, vali-g1.cp31.ott.cibntv.net, REJECT
DOMAIN, vali-ugc.cp31.ott.cibntv.net, REJECT
DOMAIN-SUFFIX, iyes.youku.com, REJECT
DOMAIN, adsmind.ugdtimg.com, REJECT
DOMAIN, pre-acs.youku.com, REJECT
DOMAIN, youku-acs.m.taobao.com, REJECT

[Rewrite]
# 播放页弹窗动图
# request if ${url} ~= /^https:\/\/acs\.youku\.com\/gw\/mtop\.youku\.(pisp\.scripts\.get|xspace\.play\.position\.preload\.query|xspace\.poplayer\.position\.query)/i then reject_dict(200)

response if ${url} ~= /^https:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get/i then response.json.delete(["data.data.ad", "data.data.watermark", "data.data.ykad"])

response if ${url} ~= /^https:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\?/i then response.json.delete(["data.tipContent", "data.tipContentNew"])

[Script]
# 播放详情页、首页信息流、顶部标签页、我的页面、评论区
# response if ${url} ~= /^https:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.(gateway\.new\.execute|home\.feed|home\.query|uc\.query|ycp\.query)/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]首页", requires_body=true

# 底栏
# response if ${url} ~= /^https:\/\/acs\.youku\.com\/gw\/mtop\.youku\.haidai\.lantern\.appconfig\.get/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]底栏", requires_body=true

# 青少年模式弹窗
# response if ${url} ~= /^https:\/\/acs\.youku\.com\/gw\/mtop\.youku\.huluwa\.dispatcher\.youthmode\.config2/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]青少年模式弹窗", requires_body=true

# 搜索列表
# response if ${url} ~= /^https:\/\/acs\.youku\.com\/gw\/mtop\.youku\.soku\.yksearch/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]搜索列表", requires_body=true

# 热剧弹窗
# response if ${url} ~= /^https:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\?/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]热剧弹窗", requires_body=true

# 开屏广告
# response if ${url} ~= /^https:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get/i then script("https://loon.103516.xyz/Script/ChinaFTP/ChinaFTP.js") with tag="[优酷视频]开屏广告", requires_body=true

[MitM]
hostname = push.m.youku.com, un-acs.youku.com