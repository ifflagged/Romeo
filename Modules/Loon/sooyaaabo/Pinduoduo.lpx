[Script]
# http-response ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? script-path = https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Pinduoduo/rucu6.pages.dev_pinduoduo.js, requires-body = true, timeout = 10, tag = [拼多多]精简首页
