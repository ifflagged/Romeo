[Rewrite]
# 小程序 & 广告拦截
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getMulti\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/xpget/i then reject_dict(200)
request if ${url} ~= /^https:\/\/freight\.xiaojukeji\.com\/gateway/i then reject_dict(200)

# 顶部活动通知
request if ${url} ~= /^https:\/\/lion\.didialift\.com\/broker\/\?/i then reject_dict(200)

# 重逢专属福利
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/slow\?/i then reject_dict(200)

# 底栏配置、首页工具栏
# response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core\?/i then response.json.jq(".data.order_cards.nav_list_card.data |= map(select(.nav_id == \"dache_anycar\" or .nav_id == \"carmate\" or .nav_id == \"driverservice\" or .nav_id == \"zhandianbashi\" or .nav_id == \"yuancheng\" or .nav_id == \"pincheche\" or .nav_id == \"bike\" or .nav_id == \"special_ride\" or .nav_id == \"nav_more_v3\")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.nav_id == \"chu_xing\" or .nav_id == \"freight_cargo\"))")
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/core\?/i then response.json.jq(".data.disorder_cards.bottom_nav_list.data |= map(select(.id == \"home_page\" or .id == \"user_center\")) | .data.order_cards.nav_list_card.data |= map(select(.nav_id == \"dache_anycar\" or .nav_id == \"carmate\" or .nav_id == \"driverservice\" or .nav_id == \"bike\" or .nav_id == \"nav_more_v3\"))")

# 首页 - 登录奖励广告、促销提示栏、乘车码、主要轮播广告、车主服务入口、横幅广告
# request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/fast\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/fast\?/i then response.json.delete(["data.disorder_cards.communicate_card", "data.disorder_cards.not_login_bottom_bar", "data.disorder_cards.riding_code_card", "data.order_cards.car_owner_widget_card", "data.order_cards.marketing_card", "data.order_cards.super_banner_card", "data.disorder_cards.car_icon.data.icon_info_new_agreement", "data.order_cards.widget_card"])

# 首页 - 横幅广告
response if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\?/i then response.json.delete("data.mult_home_banner")

# 我的 - 钱包、营销卡片
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v5\/usercenter\/layout$/i then response.json.jq(".data.instances |= with_entries(select(.key==\"center_base_info_card\" or .key==\"center_wallet_finance_card\" or .key==\"center_order_related_card\" or .key==\"center_tool_card\")) | (.data.instances.center_tool_card?.data?[0]?.data |= map(select(.content_data.nav_id | IN(\"chengweisiji\",\"chuxingchengjiu\",\"chongzhizhongxin\",\"shoucangjia\",\"ditufankui\")))) | (.data.instances.center_wallet_finance_card?.data.view_info |= map(select(.title==\"优惠卡券\")))")

# 首页 - 拼车功能运营卡片配置数据
request if ${url} ~= /^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\?/i then reject_dict(200)

# 首页 - 旅行页面
request if ${url} ~= /^https:\/\/travel-alioth\.xiaojukeji\.com\/didi_travel_home\/infoList\?/i then reject_dict(200)

# 打车页面 - 运营卡片配置数据
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout\?/i then response.json.jq(".data |= (.instances |= (to_entries | map(select(.key | test(\"feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_\"))) | from_entries))")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/pSFCHomePage\?/i then response.json.jq(".data |= (if . == null then null else {hot_route_info, legal_info} end) | . as $root | .data.tab_list = ($root.data.tab_list | map(select(.tab_id == \"passenger\")))")

# 订单进行页面 - 各种推广
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/passenger-center\/v2\/other\/pInTripLayout/i then response.json.jq(".data.order_components |= map(select((.name != \"passenger_common_casper\") and (.name != \"xp-card\")))")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/passenger-center\/v2\/bronze\/pEndTripPaidLayout/i then response.json.jq(".data.layout.order |= [\"finish-order-01\"] | del(.\"data\".\"layout\".\"disorder\".\"member-growth\")")
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/passenger-center\/v2\/bronze\/pInTripLayout/i then response.json.jq(".data.layout.order |= [\"header-card-1\", \"driver-card-1\"]")

# 代驾页面 - 弹窗和横幅广告
response if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com:443\/gateway\?/i then response.json.delete("data.variantInfo")
response if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com:443\/gateway\?/i then response.json.jq(".data |= with_entries(select(.value.isAd != 1))")

# 订单详情页 - 底部推广调研反馈
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/getInsActivityV2/i then reject_dict(200)

# 订单页面 - 右上角地址分享图标
request if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/pandora\/v1\/invitation\/shareAddress\/pGetShareAddressPage/i then reject_dict(200)

# 用户中心 - 移除多余卡片，钱包只保留优惠券/省钱套餐/出行里程
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me/i then response.json.jq(".data.cards |= (map(select(.title != \"天天领福利\" and .title != \"金融服务\" and .title != \"更多服务\" and .title != \"企业服务\" and .title != \"安全中心\")) | map(if .tag == \"wallet\" then (.items |= map(select(.title == \"优惠券\"))) | (if .card_type == 4 then .bottom_items |= map(select(.title == \"省钱套餐\" or .title == \"出行里程\")) else . end) else . end))")

# 场景列表 - 移除优惠商城
response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v1\/other\/pGetSceneList/i then response.json.jq(".data.scene_list |= map(select(.text != \"优惠商城\")) | .data.show_data |= map(.scene_ids |= map(select(. != \"scene_coupon_mall\")))")

# 顶部横幅 - 移除元图广告
request if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/ota\/na\/yuantu\/infoList/i then reject_dict(200)

# 海外布局 - 移除主横幅广告
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/oversea\/layout/i then response.json.jq("del(.data.instances.oversea_main_banner)")

# 钱包首页 - 保留资产卡片，去除借钱、信用卡、支付立减、滴滴保等所有推广卡
response if ${url} ~= /^https:\/\/mapi\.xiaojukeji\.com\/passenger-wallet\/api\/v[\d.]+\/wallet\/homepage/i then response.json.jq(".data.cardList |= (map(if .mcode == \"index_assets_v6\" then .detailData |= (del(.myCreditLimit) | .discountList |= .[:3] | del(.noticeList)) else . end) | map(select(.mcode == \"index_assets_v6\")))")

# 我的资产页 - 去除"我的额度"(借钱、信用卡、领神券)、"我的保障"、banner
response if ${url} ~= /^https:\/\/manhattan\.webapp\.xiaojukeji\.com\/zootopia\/api\/my-assets\/get-assets-data/i then response.json.jq("del(.data.myQuotaModularRes, .data.assetsData.myQuotaModularRes, .data.banner, .data.assetsData.banner, .data.myGuaranteeModularRes, .data.assetsData.myGuaranteeModularRes)")

# 我的资产页 - 模块开关
response if ${url} ~= /^https:\/\/manhattan\.webapp\.xiaojukeji\.com\/zootopia\/api\/my-assets\/module-is-show/i then response.json.jq(".data = []")

# 零钱页 - 去除底部"支付立减 5-20 元"等 banner
response if ${url} ~= /^https:\/\/ddpay\.xiaojukeji\.com\/ddpay\/api\/manhattan-small-change\/get-all-config/i then response.json.jq(".data.result = []")
response if ${url} ~= /^https:\/\/ddpay\.xiaojukeji\.com\/ddpay\/api\/manhattan-small-change\/get-apollo-config/i then response.json.jq(".data.result.hideList = []")

# 订单列表 - Tip提示
response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/passenger\/historyV2/i then response.json.jq(".data.orders |= map(del(.guide_bar))")

request if ${url} ~= /^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/recommend\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v1\/core\/getFullPageInfoLayout\?/i then response.json.jq(".data.disorder_components |= (map(select(.name == \"history_order_card\" or .name == \"inprogress_order_card\" or .name == \"station_calendar\" or .name == \"main_card_v2\" or .name == \"user_history_order\")))")

response if ${url} ~= /^https:\/\/htwkop\.xiaojukeji\.com:443\/gateway\?/i then response.json.delete(["data.didi-bike-homepage-popup", "data.variantInfo"])

response if ${url} ~= /^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\?/i then response.json.jq(".data |= map(if .name|IN(\"daijia_journey_new_tcp_switch\",\"daijia_tcp_init\",\"daijia_tcp_msg_encrypt\",\"daijia_tcp_site_info\",\"daijia_tcp_site_report\")then.allow=false else. end)")


# response if ${url} ~= /^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\?/i then response.json.jq(".data |= map(select(.name != \"isUseNetConnectivity\") | .assign.args.rootca_pin = 0 | .assign.args.sni_list = {})")

# response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/slow\?/i then response.json.delete(["data.order_cards.new_loss_banner_card", "data.order_cards.call_car_card_80"])

# response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core\?/i then response.json.jq(".data.order_cards.nav_list_card.data |= map(select(.nav_id == \"dache_anycar\" or .nav_id == \"carmate\" or .nav_id == \"driverservice\" or .nav_id == \"zhandianbashi\" or .nav_id == \"pincheche\" or .nav_id == \"bike\" or .nav_id == \"nav_more_v3\")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.nav_id == \"chu_xing\" or .nav_id == \"freight_cargo\"))")

# response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\?/i then response.json.delete(["data.disorder_cards.communicate_card", "data.disorder_cards.not_login_bottom_bar", "data.disorder_cards.riding_code_card", "data.order_cards", "data.disorder_cards.car_icon.data.icon_info_new_agreement"])

# response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/layout/i then response.json.jq(".data |= (.instances |= (to_entries | map(select(.key as $k | [\"center_base_info_card\", \"center_tool_card\", \"center_wallet_finance_card\", \"center_order_related_card\"] | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == \"优惠卡券\"))")

# request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget$/i then reject_dict(200)

# response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast\?/i then response.json.delete(["data.disorder_cards.guess_card", "data.disorder_cards.scene_list_card"])

# response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\?/i then response.json.delete("data.instances.dache_main_core_icon")

# response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/dache_homepage_layout\?/i then response.json.jq(".data |= (.instances |= (to_entries | map(select(.key | test(\"feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_\"))) | from_entries))")

# response if ${url} ~= /^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v\d\/core\/getFullPageInfoLayout\?/i then response.json.jq(".data.disorder_components |= (map(select(.name == \"history_order_card\" or .name == \"inprogress_order_card\" or .name == \"station_calendar\" or .name == \"main_card_v2\" or .name == \"user_history_order\")))")

request if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.delivery\.batch/i then reject_dict(200)

request if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery/i then reject_dict(200)

response if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloConfig/i then response.json.jq(".data |= map(select(.name != \"daijia-memberInfo-config\" and .name != \"daijia-transfer-share-config\"))")

request if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus/i then reject_dict(200)

request if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.p\.popup/i then reject_dict(200)

response if ${url} ~= /^https:\/\/daijia\.kuaidadi\.com(:443)?\/gateway\?api=lj\.cos\.apolloToggle/i then response.json.jq(".data |= map(select(.name as $n | {daijia_app_estimate_pre_req_switch:true,daijia_agent_car_picture_check:true,daijia_bluetooth_wifi_degrade_switch:true,daijia_weixin_publish_login:true,daijia_estimate_recommend_degrade_switch:true,daijia_yugu_policy_switch:true,daijia_home_location_guide_switch:true,daijia_estimate_switch:true} | has($n)))")

response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/bronze\/pinchengle_homepage_layout$/i then response.json.jq(".data.instances |= with_entries(select(.key | IN(\"dacheanycar-certificates-1\", \"main-card-1\", \"map-1\", \"nav-1\", \"tool-container-1\")))")

# request if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/pSFCHomePage\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v\d\/SFCHomeTab\?/i then response.json.jq(".data.tab_list |= map(select(.tab_id == \"passenger\" or .tab_id == \"driver\"))")

request if ${url} ~= /^https:\/\/htwkop-st\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery\.batch/i then reject_dict(200)

# response if ${url} ~= /^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.querySellCardSummary/i then response.json.replace("data", `{}`)

# response if ${url} ~= /^https:\/\/htwkop\.xiaojukeji\.com(:443)?\/gateway\?api=hm\.fa\.queryWelfareCenter/i then response.json.replace("data", `{}`)

# request if ${url} ~= /^https:\/\/freight\.xiaojukeji\.com\/gateway\?api=freight\.d\.core\.multiDisplayV\d/i then reject_dict(200)

response if ${url} ~= /^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/startinfo\?api_version/i then response.json.delete("rec_destination")
response if ${url} ~= /^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/poiinfo\?product_id/i then response.json.delete("rec_destination")

response if ${url} ~= /^https:\/\/common\.diditaxi\.com\.cn\/user_common\/itineraryList\?/i then response.json.jq("del(.data.tab_nav[]?.tab_param)")

[MitM]
hostname = 112.53.55.225, 113.46.225.*, 116.85.*, 117.51.168.*, 120.241.142.*, 120.241.143.*, 123.207.209.*, 139.199.240.84, 162.14.157.*, api.udache.com,as.xiaojukeji.com, common.diditaxi.com.cn, conf.diditaxi.com.cn, ct.xiaojukeji.com, daijia.kuaidadi.com, ddpay.xiaojukeji.com, freight.xiaojukeji.com, lion.didialift.com, manhattan.webapp.xiaojukeji.com, mapi.xiaojukeji.com, res.xiaojukeji.com
