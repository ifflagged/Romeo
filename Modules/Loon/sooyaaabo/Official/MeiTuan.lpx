URL-REGEX, "^http:\/\/103\.37\.155\.60\/fetch", REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\//i then reject(200)

# request if ${url} ~= /^http:\/\/103\.37\.155\.60\/fetch/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$)/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\//i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture/i then script("https://loon.103516.xyz/Script/MeiTuan/MeiTuan.js") with tag="[美团]移除广告", timeout=60, requires_body=true

[MitM]
hostname = apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com, httpdns.meituan.com, httpdnsmultiapi.meituan.com