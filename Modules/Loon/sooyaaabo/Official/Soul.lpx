[Argument]
# planetPage = switch, true, false, tag = 过滤[星球]页面, desc = true: 开启; false: 关闭;
# soulMatch = switch, true, false, tag = 显示[灵魂匹配], desc = true: 开启; false: 关闭;
# voiceMatch = switch, true, false, tag = 显示[语音匹配], desc = true: 开启; false: 关闭;
# partyMatch = switch, true, false, tag = 显示[群聊派对], desc = true: 开启; false: 关闭;
# masked = switch, true, false, tag = 显示[蒙面酒馆], desc = true: 开启; false: 关闭;
# maskedMatch = switch, true, false, tag = 显示[萌面匹配], desc = true: 开启; false: 关闭;
# planet = switch, true, false, tag = 显示[奇遇铃], desc = true: 开启; false: 关闭;

# hot = switch, true, false, tag = 显示[派对分类：今日Hot], desc = true: 开启; false: 关闭;
# all = switch, true, false, tag = 显示[派对分类：全部派对], desc = true: 开启; false: 关闭;
# emotion = switch, true, false, tag = 显示[派对分类：情感树洞], desc = true: 开启; false: 关闭;
# personal = switch, true, false, tag = 显示[派对分类：个人成长], desc = true: 开启; false: 关闭;
# play = switch, true, false, tag = 显示[派对分类：玩法专区], desc = true: 开启; false: 关闭;
# interest = switch, true, false, tag = 显示[派对分类：兴趣交流], desc = true: 开启; false: 关闭;
# argue = switch, true, false, tag = 显示[派对分类：趣味讨论], desc = true: 开启; false: 关闭;
# story = switch, true, false, tag = 显示[派对分类：情感故事], desc = true: 开启; false: 关闭;
# chat = switch, true, false, tag = 显示[派对分类：闲聊唠嗑], desc = true: 开启; false: 关闭;
# heart = switch, true, false, tag = 显示[派对分类：心动速配], desc = true: 开启; false: 关闭;

vist = switch, true, false, tag = 主页访问数量提示, desc = true: 开启; false: 关闭;
chatPri = switch, true, false, tag = 私聊免礼, desc = true: 开启; false: 关闭;
picRead = switch, true, false, tag = 阅后即焚, desc = true: 开启; false: 关闭;

[Rule]
# 地理位置 - 影响注册账号时的属地判断
DOMAIN-SUFFIX, soulapp.cn, DIRECT
IP-CIDR, 8.210.3.170/32, DIRECT, no-resolve
IP-CIDR, 47.75.72.47/32, DIRECT, no-resolve
IP-CIDR, 13.127.149.196/32, DIRECT, no-resolve
IP-CIDR, 52.194.158.59/32, DIRECT, no-resolve
IP-CIDR, 47.56.131.76/32, DIRECT, no-resolve
IP-CIDR, 47.75.72.47/32, DIRECT, no-resolve
IP-CIDR, 3.0.163.78/32, DIRECT, no-resolve

# 官方广告
DOMAIN, ad-h5-cdn.soulapp.cn, REJECT
DOMAIN, ad-h5-station-cdn.soulapp.cn, REJECT
DOMAIN, ad-r.soulapp.cn, REJECT
DOMAIN, soul-ad.soulapp.cn, REJECT
DOMAIN, ssp.soulapp.cn, REJECT

# 第三方平台广告
DOMAIN, ssp.1rtb.com, REJECT
DOMAIN, impdsp.meituan.com, REJECT
DOMAIN, s3plus.meituan.net, REJECT
DOMAIN, ssp.maplehaze.cn, REJECT

# 广告域名IP查询
# IP-CIDR, 47.56.131.76/32, REJECT, no-resolve
IP-CIDR, 47.97.215.55/32, REJECT, no-resolve
IP-CIDR, 47.99.42.29/32, REJECT, no-resolve
IP-CIDR, 47.110.187.87/32, REJECT, no-resolve
IP-CIDR, 47.243.147.125/32, REJECT, no-resolve
IP-CIDR, 120.27.235.201/32, REJECT, no-resolve
IP-CIDR, 121.196.197.147/32, REJECT, no-resolve

[Rewrite]
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2/i then reject(200)

response if ${url} ~= /^https:\/\/(?:api-\w+|gateway-mobile-gray|post)\.soulapp\.cn\/(?:furion\/position\/content|hot\/soul\/rank|mobile\/app\/version\/queryIos|official\/scene\/module|teenager\/config|v2\/post\/gift\/list|v\d\/post\/homepage\/guide\/card)/i then response.json.delete("data")

# 广告下发
request if ${url} ~= /^https:\/\/ssp\.soulapp\.cn\/api\/q/i then reject_dict(200)
request if ${url} ~= /^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain/i then reject_dict(200)

# 主页瞬间指导
request if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/i then reject_dict(200)

# 青少年弹窗
request if ${url} ~= /^https:\/\/api-account\.soulapp\.cn\/teenager\/config/i then reject_dict(200)

# 谁看过我横幅广告
request if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module/i then reject_dict(200)

# 主页右下角悬浮广告
request if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content/i then reject_dict(200)

# 通讯录右下角机器人图标
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter/i then reject(404)

# 表情推荐
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList/i then reject(404)

# 我的页面soul币活动推荐
request if ${url} ~= /^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon/i then reject(404)

# 首次私聊打开星球交汇小卡片
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger/i then reject(404)

# 首次打开私聊界面底部瞬间表情推荐
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord/i then reject(404)

# 聊天输入文字时的gif表情推荐
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend/i then reject(404)

# 去除私聊瞬间小横幅
request if ${url} ~= /^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url/i then reject(404)

# 私聊快捷菜单
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu/i then reject(404)

# 私聊用户匹配推荐
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck/i then reject_dict(200)

# 派对体验反馈
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback/i then reject_dict(200)

# 广场关注tab用户派对推荐
request if ${url} ~= /^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms/i then reject_dict(200)

# 聊天页通讯录tab邀请好友回归横幅
request if ${url} ~= /^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings/i then reject_dict(200)

# 派对的关注tab隐藏猜我喜欢的派对
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList/i then reject_dict(200)

# 主页ai描述推荐
request if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc/i then reject_dict(200)

# 我的页面瞬间得分向导
request if ${url} ~= /^https:\/\/post\.soulapp\.cn\/v1\/post\/homepage\/ai\/assistant\/guide/i then reject_dict(200)

# 聊天列表页面顶部头像推荐横幅
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chatList\/limitAvatar\/entrance/i then reject_dict(200)

# 聊天列表页面顶部用户推荐
request if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chatList\/top\/recommendList/i then reject_dict(200)

# 派对左、右上角广告图标
request if ${url} ~= /^https:\/\/activity\.soulapp\.cn\/commercial\/room\/resources/i then reject_dict(200)
request if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/official\/scene\/module/i then reject_dict(200)

# 派对页面的关注tab中我的关注推荐
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/live\/queryFollowRoomList/i then response.json.jq(".data.recUserFeedList = []")

# 派对页面的关注tab中猜你喜欢
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList/i then response.json.jq(".data.userDTOList = []")

# 星球页面
response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config/i then response.json.jq(".data.showRedMind = false | .data.showLuckyBag = false | .data.coreCards |= map(select(.type != 27))")

# 派对列表中间横幅官方广告
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList/i then response.json.jq(".data.positionContentRespList = []")

# 我的页面tab
response if ${url} ~= /^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2/i then response.json.jq(".data.selectedTagPool = {} | .data.headTabDTOList |= map(select(.tabCode != \"STAR_TRAILS\"))")

# 派对频道列表
response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo/i then response.json.jq(".data.res |= map(.iconConfig = null)")

[Script]
# response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config/i then script("https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js", {${soulMatch}, ${voiceMatch}, ${partyMatch}, ${masked}, ${maskedMatch}, ${planet}}) with enable=${planetPage}, tag="[Soul]星球页面按钮"

# response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo/i then script("https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js", {${hot}, ${all}, ${emotion}, ${personal}, ${play}, ${interest}, ${argue}, ${story}, ${chat}, ${heart}}) with tag="[Soul]派对频道列表"

response if ${url} ~= /^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics/i then script("https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js") with enable=${vist}, tag="[Soul]个人主页数量提示", requires_body=true

response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/i then script("https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js") with enable=${chatPri}, tag="[Soul]去除私聊限制", requires_body=true

response if ${url} ~= /^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url/i then script("https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js") with enable=${picRead}, tag="[Soul]私聊阅后即焚", requires_body=true

[MitM]
hostname = ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, activity.soulapp.cn, 47.110.187.87, 47.75.72.47, 47.96.7.91, 47.96.11.46, 47.96.20.45, 47.97.215.55, 47.98.54.106, 47.98.137.249, 47.99.42.29, 114.215.255.94, 116.62.28.7, 116.62.47.28, 118.31.7.235, 118.31.112.221, 120.27.235.201, 120.55.55.115, 120.55.62.124, 121.196.197.147, 121.196.203.183
