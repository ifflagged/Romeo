# 2026-04-14
# https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Soul.snippet
# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/Soul_remove_ads.lpx
# 2026-09-05
# https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/soul.snippet

[Argument]
# planetPage = switch, true, false, tag = 过滤[星球]页面, desc = true: 开启; false: 关闭;
# soulMatch = switch, true, false, tag = 显示[灵魂匹配], desc = true: 开启; false: 关闭;
# voiceMatch = switch, true, false, tag = 显示[语音匹配], desc = true: 开启; false: 关闭;
# partyMatch = switch, true, false, tag = 显示[群聊派对], desc = true: 开启; false: 关闭;
# masked = switch, true, false, tag = 显示[蒙面酒馆], desc = true: 开启; false: 关闭;
# maskedMatch = switch, true, false, tag = 显示[萌面匹配], desc = true: 开启; false: 关闭;
# planet = switch, true, false, tag = 显示[奇遇铃], desc = true: 开启; false: 关闭;

# hot = switch, true, false, tag = 显示[派对分类：今日Hot], desc = true: 开启; false: 关闭;
# all = switch, true, false, tag = 显示[派对分类：全部派对], desc = true: 开启; false: 关闭;
# emotion = switch, true, false, tag = 显示[派对分类：情感树洞], desc = true: 开启; false: 关闭;
# personal = switch, true, false, tag = 显示[派对分类：个人成长], desc = true: 开启; false: 关闭;
# play = switch, true, false, tag = 显示[派对分类：玩法专区], desc = true: 开启; false: 关闭;
# interest = switch, true, false, tag = 显示[派对分类：兴趣交流], desc = true: 开启; false: 关闭;
# argue = switch, true, false, tag = 显示[派对分类：趣味讨论], desc = true: 开启; false: 关闭;
# story = switch, true, false, tag = 显示[派对分类：情感故事], desc = true: 开启; false: 关闭;
# chat = switch, true, false, tag = 显示[派对分类：闲聊唠嗑], desc = true: 开启; false: 关闭;
# heart = switch, true, false, tag = 显示[派对分类：心动速配], desc = true: 开启; false: 关闭;

vist = switch, true, false, tag = 主页访问数量提示, desc = true: 开启; false: 关闭;
chatPri = switch, true, false, tag = 私聊免礼, desc = true: 开启; false: 关闭;
picRead = switch, true, false, tag = 阅后即焚, desc = true: 开启; false: 关闭;

[Rule]
# 地理位置 - 影响注册账号时的属地判断
DOMAIN-SUFFIX, soulapp.cn, DIRECT
IP-CIDR, 8.210.3.170/32, DIRECT, no-resolve
IP-CIDR, 47.75.72.47/32, DIRECT, no-resolve
IP-CIDR, 13.127.149.196/32, DIRECT, no-resolve
IP-CIDR, 52.194.158.59/32, DIRECT, no-resolve
IP-CIDR, 47.56.131.76/32, DIRECT, no-resolve
IP-CIDR, 47.75.72.47/32, DIRECT, no-resolve
IP-CIDR, 3.0.163.78/32, DIRECT, no-resolve

# 官方广告
DOMAIN, ad-h5-cdn.soulapp.cn, REJECT
DOMAIN, ad-h5-station-cdn.soulapp.cn, REJECT
DOMAIN, ad-r.soulapp.cn, REJECT
DOMAIN, soul-ad.soulapp.cn, REJECT
DOMAIN, ssp.soulapp.cn, REJECT

# 第三方平台广告
DOMAIN, ssp.1rtb.com, REJECT
DOMAIN, impdsp.meituan.com, REJECT
DOMAIN, s3plus.meituan.net, REJECT
DOMAIN, ssp.maplehaze.cn, REJECT

# 广告域名IP查询
# IP-CIDR, 47.56.131.76/32, REJECT, no-resolve
IP-CIDR, 47.97.215.55/32, REJECT, no-resolve
IP-CIDR, 47.99.42.29/32, REJECT, no-resolve
IP-CIDR, 47.110.187.87/32, REJECT, no-resolve
IP-CIDR, 47.243.147.125/32, REJECT, no-resolve
IP-CIDR, 120.27.235.201/32, REJECT, no-resolve
IP-CIDR, 121.196.197.147/32, REJECT, no-resolve

[Rewrite]
^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2 reject-200

^https:\/\/(?:api-\w+|gateway-mobile-gray|post)\.soulapp\.cn\/(?:furion\/position\/content|hot\/soul\/rank|mobile\/app\/version\/queryIos|official\/scene\/module|teenager\/config|v2\/post\/gift\/list|v\d\/post\/homepage\/guide\/card) response-body-json-del data

# 广告下发
^https:\/\/ssp\.soulapp\.cn\/api\/q reject-dict
^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain reject-dict

# 主页瞬间指导
^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card reject-dict

# 青少年弹窗
^https:\/\/api-account\.soulapp\.cn\/teenager\/config reject-dict

# 谁看过我横幅广告
^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module reject-dict

# 主页右下角悬浮广告
^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content reject-dict

# 通讯录右下角机器人图标
^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter reject

# 表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList reject

# 我的页面soul币活动推荐
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon reject

# 首次私聊打开星球交汇小卡片
^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger reject

# 首次打开私聊界面底部瞬间表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord reject

# 聊天输入文字时的gif表情推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend reject

# 去除私聊瞬间小横幅
^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url reject

# 私聊快捷菜单
^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu reject

# 私聊用户匹配推荐
^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck reject-dict

# 派对体验反馈
^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback reject-dict

# 广场关注tab用户派对推荐
^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms reject-dict

# 聊天页通讯录tab邀请好友回归横幅
^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings reject-dict

# 派对的关注tab隐藏猜我喜欢的派对
^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList reject-dict

# 主页ai描述推荐
^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc reject-dict

# 我的页面瞬间得分向导
^https:\/\/post\.soulapp\.cn\/v1\/post\/homepage\/ai\/assistant\/guide reject-dict

# 聊天列表页面顶部头像推荐横幅
^https:\/\/api-chat\.soulapp\.cn\/chatList\/limitAvatar\/entrance reject-dict

# 聊天列表页面顶部用户推荐
^https:\/\/api-chat\.soulapp\.cn\/chatList\/top\/recommendList reject-dict

# 派对页面的关注tab中我的关注推荐
^https:\/\/chat-live\.soulapp\.cn\/live\/queryFollowRoomList response-body-json-jq '.data.recUserFeedList = []'

# 派对页面的关注tab中猜你喜欢
^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList response-body-json-jq '.data.userDTOList = []'

# 星球页面
^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config response-body-json-jq '.data.showRedMind = false | .data.showLuckyBag = false | .data.coreCards |= map(select(.type != 27))'

# 派对列表中间横幅官方广告
^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList response-body-json-jq '.data.positionContentRespList = []'

# 我的页面tab
^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 response-body-json-jq '.data.selectedTagPool = {} | .data.headTabDTOList |= map(select(.tabCode != "STAR_TRAILS"))'

# 派对频道列表
^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo response-body-json-jq '.data.res |= map(.iconConfig = null)'

[Script]
# http-response ^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config script-path = https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body = true, tag = [Soul]星球页面按钮, enable={planetPage}, argument=[{soulMatch}, {voiceMatch}, {partyMatch}, {masked}, {maskedMatch}, {planet}]

# http-response ^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo script-path = https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body = true, tag = [Soul]派对频道列表, argument=[{hot},{all},{emotion},{personal},{play},{interest},{argue},{story},{chat},{heart}]

http-response ^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics script-path = https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body = true, tag = [Soul]个人主页数量提示, enable={vist}

http-response ^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo script-path = https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body = true, tag = [Soul]去除私聊限制, enable={chatPri}

http-response ^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url script-path = https://raw.githubusercontent.com/ishowshu/qx/main/script/soul.js, requires-body = true, tag = [Soul]私聊阅后即焚, enable={picRead}

[MitM]
hostname = ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, 47.110.187.87
