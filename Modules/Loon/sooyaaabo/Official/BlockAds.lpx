request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads/list/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/lccorpus\/(applist|pannellist)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/circle\/joinedlist/i then reject_dict(200)
