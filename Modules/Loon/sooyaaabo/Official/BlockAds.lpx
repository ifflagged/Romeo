[Rewrite]
# >>>>>>>>>>>>>>> ✅ 1 ✅ <<<<<<<<<<<<<<< #
# 12123 - gab.122.gov.cn
# request if ${url} ~= /^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery/i then reject(404)
request if ${url} ~= /^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery\/adver$/i then reject(404)

# >>>>>>>>>>>>>>> ✅ 2 ✅ <<<<<<<<<<<<<<< #
# 21经济网 - api.21jingji.com
request if ${url} ~= /^https?:\/\/api\.21jingji\.com\/ad\//i then reject(404)

# 2345天气王 - tianqi.2345.com
request if ${url} ~= /^https?:\/\/tianqi\.2345\.com\/api\/content\/getContentFeeds\.php/i then reject_dict(200)

# >>>>>>>>>>>>>>> ✅ 3 ✅ <<<<<<<<<<<<<<< #
# 360儿童卫士 - ad.life.360.cn
request if ${url} ~= /^https?:\/\/ad\.life\.360\.cn\/v2\/app\/advertisement\/config\?sdk_ver=/i then reject_dict(200)

# 36kr - gateway.36kr.com
# request if ${url} ~= /^https?:\/\/gateway\.36kr\.com\/api\/adx\/ad\/show/i then reject(404)

# >>>>>>>>>>>>>>> ✅ 5 ✅ <<<<<<<<<<<<<<< #
# 500 - evs.500.com
request if ${url} ~= /^https?:\/\/evs\.500\.com\/esinfo\/loading\/loading/i then reject(404)

# 51信用卡管家 - api.u51.com
request if ${url} ~= /^https?:\/\/api\.u51\.com\/(generic-config-gateway|rs-resys)\/api\/v\d\/(creditpage-config|recommend)/i then reject(200)

# 555电影 - vip7.fzwdyy.cn, *.qyfxgd.cn, *.weilai555.com, *.ecoliving168.com
request if ${url} ~= /^https?:\/\/vip7\.fzwdyy\.cn:8083\/api\/(getAdvertInfo|getGOOGAdvert)/i then reject(200)
request if ${url} ~= /^https?:\/\/[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+){1,3}(:\d+)?\/api\/v\d\/advert/i then reject(404)

# 58同城 - *.58cdn.com.cn, app.58.com
request if ${url} ~= /^https?:\/\/.+?\.58cdn\.com\.cn\/brandads\//i then reject(200)
request if ${url} ~= /^https?:\/\/app\.58\.com\/api\/home\/(advertising|appadv)\//i then reject(404)
request if ${url} ~= /^https?:\/\/app\.58\.com\/api\/home\/invite\/popupAdv/i then reject(200)
request if ${url} ~= /^https?:\/\/app\.58\.com\/api\/log\//i then reject(404)

# >>>>>>>>>>>>>>> ✅ A ✅ <<<<<<<<<<<<<<< #
# 阿里巴巴 - acs.m.taobao.com, heic.alicdn.com, guide-acs.m.taobao.com
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then reject_dict(200)
request if ${url} ~= /^https:\/\/heic\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(octopus|tps-1125-1602|tps-1080-1920)\.(jp|pn)g_(1\d{3}|9\d{2})x(1\d{3}|9\d{2})q[59]0/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)/i then reject_dict(200)

# 爱美剧 - api.bjxkhc.com
