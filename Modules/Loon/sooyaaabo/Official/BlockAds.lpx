# 哔哩哔哩漫画 - manga.bilibili.com, i*.hdslb.com
request if ${url} ~= /^https?:\/\/i\d\.hdslb\.com\/bfs\/fawkes -/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(?>jpg|png)$ -/i then reject(200)
