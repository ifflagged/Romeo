# >>>>>>>>>>>>>>> ✅ B ✅ <<<<<<<<<<<<<<< #
# 百度 - fcvbjbcebos.baidu.com, cover.baidu.com, baichuan.baidu.com, api*.tuisong.baidu.com, afd.baidu.com, als.baidu.com, mobads.baidu.com, issuecdn.baidupcs.com, *.baidu.com, www.baidu.com, sa*.tuisong.baidu.com
request if ${url} ~= /^https?:\/\/fcvbjbcebos\.baidu\.com\/.+.mp4/i then reject(404)
request if ${url} ~= /^https?:\/\/fcvbjbcebos\.baidu\.com\/.+?\.mp4/i then reject_img(200)
request if ${url} ~= /^https?:\/\/cover\.baidu\.com\/cover\/page\/dspSwitchAds\//i then reject(404)
request if ${url} ~= /^https?:\/\/baichuan\.baidu\.com\/rs\/adpmobile\/launch/i then reject(404)
request if ${url} ~= /^https?:\/\/api\d\.tuisong\.baidu\.com/i then reject_img(200)
request if ${url} ~= /^https?:\/\/afd\.baidu\.com\/afd\/entry/i then reject(404)
request if ${url} ~= /^https?:\/\/als\.baidu\.com\/clog\/clog/i then reject(404)
request if ${url} ~= /^https?:\/\/mobads\.baidu\.com\/cpro\/ui\/mads.+/i then reject(404)
request if ${url} ~= /^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao\//i then reject(200)
request if ${url} ~= /^https?:\/\/[\s\S]*\.baidu\.com\/.*?ad[xs]\.php/i then reject_img(200)
request if ${url} ~= /^https?:\/\/t\d{2}\.baidu\.com/i then reject_img(200)
request if ${url} ~= /^https?:\/\/log.+?baidu\.com/i then reject(404)
request if ${url} ~= /^https?:\/\/sa\d\.tuisong\.baidu\.com/i then reject_img(200)
request if ${url} ~= /^https?:\/\/www\.baidu\.com\/?action=static&ms=1&version=css_page_2@0.*?/i then reject(404)

# 百度翻译 - mime.baidu.com
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v\d\/IosStart\/getStartInfo/i then reject(404)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v\d\/activity\/advertisement/i then reject(404)

# 百度输入法 - r6.mo.baidu.com, res.mi.baidu.com, mime.baidu.com, mbd.baidu.com
request if ${url} ~= /^https?:\/\/r6\.mo\.baidu\.com\/res\/file/advertisement\/files\/.+\.jpg/i then reject(404)
request if ${url} ~= /^https?:\/\/res\.mi\.baidu\.com\/imeres\/ime-res\/advertisement\/files\/.+\.jpg/i then reject(404)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/activity\/advertisementnonrealtime/i then reject(404)
