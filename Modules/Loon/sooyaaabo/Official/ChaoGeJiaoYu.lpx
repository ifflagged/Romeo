#!name = 超格教育
#!desc = 过滤超格教育广告
#!openUrl = https://apps.apple.com/app/id1367434722
#!author = sooyaaabo[https://github.com/sooyaaabo]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ChaoGeJiaoYu.png
#!date = 2026-10-05 15:00

[Rewrite]
# 页面广告：中部卡片、右侧悬浮按钮、顶部广告入口
response if ${url} ~= /^https:\/\/mapi\.chaogejiaoyu\.com\/api\/ad\/getPageAdList(?:\?|$)/i then response.body.mock("json", `{"status":0,"message":"success","data":{"ad_list":[]}}`, 200)

# 开屏广告：倒计时仍在
response if ${url} ~= /^https:\/\/mapi\.chaogejiaoyu\.com\/api\/outline\/getAppBanner\?(?:[^#]*&)?adv_flag=1(?:&|$)/i then response.body.mock("json", `{"status":0,"message":"success","data":[]}`, 200)

# 滚动横幅Banner
response if ${url} ~= /^https:\/\/mapi\.chaogejiaoyu\.com\/api\/outline\/getAppBanner\?(?:[^#]*&)?adv_flag=2(?:&|$)/i && ${response.status} == 200 then response.json.jq(`.data = [(.data[0] | .banner_img = "https://i.im.ge/QQdilvc/CGBanner.png" | .banner_img_new = "https://i.im.ge/QQdilvc/CGBanner.png" | .title = "超格教育" | .content = "" | .source_type = "0" | .source_id = "0" | .h5_url = "")]`)

# 优师公开课
response if ${url} ~= /^https:\/\/mapi\.chaogejiaoyu\.com\/api\/course\/getOpenCourseColumnInfo(?:\?|$)/i then response.body.mock("json", `{"status":0,"message":"success","data":{}}`, 200)

# 广告配置接口
response if ${url} ~= /^https:\/\/mapi\.chaogejiaoyu\.com\/api\/user\/checkToken(?:\?|$)/i then response.json.jq(`.data.has_ad_page_list = [] | .data.startup.show_promotion = 0 | .data.startup.promotion_url = "" | .data.startup.home_top_menu_list |= map(select(.type != "ad_btn"))`)

[MitM]
hostname = mapi.chaogejiaoyu.com
