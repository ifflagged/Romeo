#!name = 小红书
#!desc = 过滤小红书广告，去除水印
#!openUrl = https://apps.apple.com/app/id741292507
#!author = RuCu6[https://github.com/RuCu6], fmz200[https://github.com/fmz200], meichiny[https://github.com/meichiny], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/RedNote.png
#!date = 2026-09-23 00:00

# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/RedPaper_remove_ads.lpx
# 2026-09-14 11:00
# https://rucu6.pages.dev/Plugins/xiaohongshu.lpx
# 2026-06-17
# https://raw.githubusercontent.com/meichiny/rednote-feed-time/rewrite-rule/modules/shadowrocket/rednote-feed-time.sgmodule

[Argument]
rednote-feedtime = switch, false, true, tag = 首页笔记标题前显示时间, desc = 是否启用首页笔记标题前显示时间

[Rule]
DOMAIN, ads-img-al.xhscdn.com, REJECT
DOMAIN, ads-img-qc.xhscdn.com, REJECT
DOMAIN, ads-video-al.xhscdn.com, REJECT
DOMAIN, ads-video-qc.xhscdn.com, REJECT
DOMAIN, t-ads.xiaohongshu.com, REJECT
AND, ((PROTOCOL, QUIC), (OR, ((DOMAIN-SUFFIX, xiaohongshu.com), (DOMAIN-SUFFIX, rnote.com)))), REJECT

[Rewrite]
# 评论区图片水印
request if ${url} ~= /^https?:\/\/ci\.(?:xiaohongshu|rnote)\.com\/system_config\/watermark/i then reject_img(200)

# 惊喜弹窗
request if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\?/i then reject_dict(200)

# 信息流
request if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:guide\/user_banner|note\/guide)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:ads\/resource|hey\/\w+\/hey_gallery)/i then reject_dict(200)

# 搜索页
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/banner_list$/i then response.json.replace("data", `{}`)
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/hot_list$/i then response.json.replace("data.items", `[]`)
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/hint/i then response.json.replace("data.hint_words", `[]`)
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/trending\?/i then response.json.replace(["data.queries", "data.hint_word"], [`[]`, `{}`])

# 首页及搜索结果页面，仅保留图文笔记
# response if ${url} ~= /^https:\/\/so\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/notes/i then response.json.jq(".data.items |= map(select(.note?.type == \"normal\"))")
# response if ${url} ~= /^https:\/\/rec\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/homefeed/i then response.json.jq(".data |= map(select(.type == \"normal\"))")

# 首页热点
# response if ${url} ~= /^https:\/\/rec\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/homefeed/i then response.json.jq(".data |= map(select((((.recommend.type // \"\") == \"hot_reason\") or ((.recommend.desc // \"\") == \"热点\") or (((.recommend.track_id // \"\") | test(\"(^|_)hotspot|hotspoti2i\"; \"i\"))) or (((.rec_extra_info // \"\") | test(\"\\\"hotEventId\\\"\")))) | not))")

[Script]
# 界面整体配置
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system\/service\/ui\/config\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除整体配置 ui", requires_body=true

# 开屏广告
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system_service\/config\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除开屏广告 config", requires_body=true
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/system_service\/splash_config/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除开屏广告 splash_config", requires_body=true

# 详情页、关注页
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed)/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除详情页小部件、关注页感兴趣的人", requires_body=true
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除详情页感兴趣的人", requires_body=true

# 信息流
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?/i then script("https://loon.103516.xyz/Script/RedNote/rednote-feedtime.js") with enable=${rednote-feedtime}, tag="[小红书]首页笔记标题前显示时间", requires_body=true
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/followfeed\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除信息流广告", requires_body=true
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除信息流广告", requires_body=true

# 搜索页
response if ${url} ~= /^https:\/\/(?:edith|so)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v10\/search\/notes\?/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除搜索页广告", requires_body=true

# 实况、图片、视频水印
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save)/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除图片和实况照片水印", requires_body=true
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed)/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除图片和视频水印", requires_body=true
response if ${url} ~= /^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save)/i then script("https://rucu6.pages.dev/Scripts/xiaohongshu.js") with tag="[小红书]移除视频水印", requires_body=true

# 评论区图片、Live图水印、表情包下载
response if ${url} ~= /^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list|v3\/note\/comment\/sub_comments)/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/xiaohongshu/xiaohongshu.js") with tag="[小红书]移除评论区实况照片水印", requires_body=true

[MitM]
hostname = ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com, so.xiaohongshu.com, ci.rnote.com, edith.rnote.com, rec.rnote.com, www.rnote.com, so.rnote.com