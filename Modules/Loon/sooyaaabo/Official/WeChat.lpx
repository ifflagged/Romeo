# 松果出行 @keywos //api.songguo7.com
request if ${url} ~= /^https:\/\/api\.songguo7\.com\/(\w{3})?mp\/v2\/misc\/(toast|user_operate_info|unlock_without_order|unlock_operate_info)/i then reject_dict(200)

