#!name = 微信
#!desc = 微信公众号、小程序去广告以及微信外部链接解锁
#!openUrl = https://apps.apple.com/app/id414478124
#!author = RuCu6[https://github.com/RuCu6], zZPiglet[https://github.com/zZPiglet], blackmatrix7[https://github.com/blackmatrix7], zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/WeChat.png
#!date = 2026-09-23 00:00

# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/Weixin_Official_Accounts_remove_ads.lpx
# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/Weixin_external_links_unlock.lpx
# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/WexinMiniPrograms_Remove_ads.lpx
# 2026-04-27
# https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/WxPureDominion.snippet

[Argument]
UnblockURLinWeChat_script = switch, true, false, tag = 微信外部链接解锁, desc = 解锁微信外部链接访问限制，跳过中间界面。

[Rule]
# --------------- 微信公众号 --------------- #
DOMAIN-SUFFIX, wxs.qq.com, REJECT
DOMAIN, badjs.weixinbridge.com, REJECT
DOMAIN, dns.weixin.qq.com.cn, REJECT

# --------------- 微信小程序 --------------- #
# 微信小程序通用规则
DOMAIN, wxsnsdy.wxs.qq.com, REJECT
DOMAIN, wxsmsdy.video.qq.com, REJECT
DOMAIN, wxsnsdythumb.wxs.qq.com, REJECT

# 收钱吧
DOMAIN, ads-shopping.shouqianba.com, REJECT

# 猫眼电影
DOMAIN, ad.maoyan.com, REJECT

# 捷停车 @怎么肥事
DOMAIN, e.jparking.cn, REJECT

# 朵朵校友圈
DOMAIN-SUFFIX, ad.duoduo.link, REJECT

# 深圳通
DOMAIN-SUFFIX, wxsnsdythumb.wxs.qq.com, REJECT

# 云快充
DOMAIN, et.ykccn.com, REJECT

[Rewrite]
# --------------- 微信公众号 --------------- #
# 移除公众号中的推广内容 //mp.weixin.qq.com, *.wxs.qq.com
# request if ${url} ~= /^http:\/\/\w+\.wxs\.qq\.com\/\d+\/\d+\/(snscosdownload|snssvpdownload)\/(SH|SZ)\/reserved\/\w+/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)

# 移除微信公众号文章底栏都在搜 @wish
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)

# --------------- 微信小程序 --------------- #
# 企迈点单系统 //webapi.qmai.cn
request if ${url} ~= /^https:\/\/webapi\.qmai\.cn\/web\/catering\/advertising\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/webapi\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert-reach/i then reject(404)

# 挪瓦咖啡 //images.qmai.cn
request if ${url} ~= /^https:\/\/images\.qmai\.cn\/s214925\/2023/i then reject_dict(200)

# 交通银行小程序开屏广告 @张军 //creditcardapp.bankcomm.com
request if ${url} ~= /^https:\/\/creditcardapp\.bankcomm\.com\/cnsvPmpaMdbcardWeb\/page\/getGuidePageAds/i then reject(404)

# 招行首页横幅广告 @ArthasYZ //mbmodule-openapi.paas.cmbchina.com
request if ${url} ~= /^https:\/\/mbmodule-openapi\.paas\.cmbchina\.com\/graphic\/v2\/module\/graphic/i then reject(404)

# 丰巢 //webchatapp.fcbox.com, dsp.fcbox.com
# 丰巢 - 首页服务推广
request if ${url} ~= /^https:\/\/webchatapp\.fcbox\.com\/fcboxactivityweb\/api\/v2\/clientPage\/modulesAggregated\?/i then reject_dict(200)
# 丰巢 - 首页丰巢直播
request if ${url} ~= /^https:\/\/webchatapp\.fcbox\.com\/fcboxactivityweb\/api\/v2\/clientPage\/getHomeLiveInfo$/i then reject_dict(200)
# 丰巢 - 横幅和广告配置
request if ${url} ~= /^https:\/\/dsp\.fcbox\.com\/adSearch\//i then reject_dict(200)
# 丰巢 - 订单页面 - 邀请开通会员横幅
request if ${url} ~= /^https:\/\/webchatapp\.fcbox\.com\/post\/suggestion\/query$/i then reject_dict(200)
# 丰巢 - 订单页面 - 好友助力
request if ${url} ~= /^https:\/\/webchatapp\.fcbox\.com\/fcboxactivityweb\/marketingEntrance\/v2\/infoWithItems$/i then reject_dict(200)
# 丰巢 - 订单页面 - 悬浮窗
request if ${url} ~= /^https:\/\/webchatapp\.fcbox\.com\/fcboxactivityweb\/marketingEntrance\/info$/i then reject_dict(200)

# 中国石油去广告 @张军 //app.95504.net, minipro.95504.net
# 中石油去开屏广告发现
request if ${url} ~= /^https:\/\/app\.95504\.net\/app\/json\/page_ad\/initPageAd\?ver=/i then reject(404)
# 中油好客e站小程序弹窗广告
request if ${url} ~= /^https:\/\/minipro\.95504\.net\/app\/json\/ad\/getPopAdData/i then reject(404)
# 中油好客e站小程序底部横幅广告
request if ${url} ~= /^https:\/\/minipro\.95504\.net\/app\/json\/ad\/getIndexAdData/i then reject(404)

# 多点 @ArthasYZ //flow.dmall.com
request if ${url} ~= /^https:\/\/flow\.dmall\.com\/app\/home\/pops/i then reject(404)

# 永辉 @ArthasYZ //api.yonghuivip.com, activity.yonghuivip.com, sauron-report.yonghuivip.com
request if ${url} ~= /^https:\/\/api\.yonghuivip\.com\/api\/fp\/homepage\/pop/i then reject(404)
request if ${url} ~= /^https:\/\/activity\.yonghuivip\.com\/api\/app\/fp\/homepage\/pop/i then reject(404)
request if ${url} ~= /^https:\/\/activity\.yonghuivip\.com\/api\/\/web\/shensuan\/ad/i then reject(404)
request if ${url} ~= /^https:\/\/sauron-report\.yonghuivip\.com\/collect/i then reject(404)

# 必胜客 //res.pizzahut.com.cn
request if ${url} ~= /^https:\/\/res\.pizzahut\.com\.cn\/CRM/i then reject_dict(200)

# 肯德基 //orders.kfc.com.cn, dynamicad.kfc.com.cn, res.kfc.com.cn
# request if ${url} ~= /^https:\/\/orders\.kfc\.com\.cn\/preorder-portal\/api\/v2\/coupon/i then reject_dict(200)
# request if ${url} ~= /^https:\/\/dynamicad\.kfc\.com\.cn\/api/i then reject_dict(200)
# request if ${url} ~= /^https:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/custom_v2\/wxapp/i then reject_dict(200)
# request if ${url} ~= /^https:\/\/orders\.kfc\.com\.cn\/preorder-portal\/api\/v2\/activity/i then reject_dict(200)

# 麦当劳 //api.mcd.cn
request if ${url} ~= /^https:\/\/api\.mcd\.cn\/bff\/portal\/home\/hotActivity/i then reject_dict(200)

# 星巴克 //3pp.starbucks.com.cn
request if ${url} ~= /^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/popup/i then reject_dict(200)
request if ${url} ~= /^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/index\/banner/i then reject_dict(200)
request if ${url} ~= /^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/index\/global/i then reject_dict(200)

# 石家庄公交乘车码 //wechat-api.i-xiaoma.com.cn
request if ${url} ~= /^https:\/\/wechat-api\.i-xiaoma\.com\.cn\/app\/v1\/bus\/wechat\/content/i then reject_dict(200)

# 神州租车 //apiproxy.zuche.com
request if ${url} ~= /^https:\/\/apiproxy\.zuche\.com\/resource\/carrctapi\/home\/marketing/i then reject_dict(200)
