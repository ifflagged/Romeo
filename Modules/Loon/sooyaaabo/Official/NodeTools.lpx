[Script]
generic then script("https://loon.103516.xyz/Script/NodeTools/NodeSpeedtest.js") with tag="节点网速测试 𝕂", img_url="speedometer", timeout=10

generic then script("https://loon.103516.xyz/Script/NodeTools/NodeUnlockDetection.js") with tag="节点解锁查询 𝕂", img_url="play.circle", timeout=20

generic then script("https://loon.103516.xyz/Script/NodeTools/NodeLocation.js") with tag="节点风险查询 𝕂", img_url="asterisk.circle", timeout=10

generic then script("https://raw.githubusercontent.com/Keywos/rule/master/script/netisp/js/loon.js") with tag="入口落地查询 𝕂", img_url="network"