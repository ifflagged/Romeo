#!name = 网易云音乐
#!desc = 网易云音乐全面净化，可自定义界面样式。
#!openUrl = https://apps.apple.com/app/id590338362
#!author = RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告, 解锁会员
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!date = 2026-09-23 00:00

# 2025-02-17 02:24:04
# https://raw.githubusercontent.com/Keywos/rule/main/script/wy/wy.plugin
# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/NeteaseCloudMusic_remove_ads.lpx
# 2024-10-01
# https://raw.githubusercontent.com/anyehttp/quantumult-x/main/headers/wyy-surge.sgmodule
# 2024-11-21 20:30:00
# https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/NeteaseCloudMusic/netease.plugin

[Argument]
FX = switch, false, true, tag = 隐藏[底部-发现], desc = 是否隐藏底部发现标签
MY = switch, false, true, tag = 隐藏[底部-漫游], desc = 是否隐藏底部漫游标签
DT = switch, false, true, tag = 隐藏[底部-笔记], desc = 是否隐藏底部笔记标签
GZ = switch, false, true, tag = 隐藏[底部-关注], desc = 是否隐藏底部关注标签

PRGG = switch, false, true, tag = 隐藏[首页-问候语], desc = 是否隐藏首页问候语
PRRK = switch, false, true, tag = 隐藏[首页-排行榜], desc = 是否隐藏首页排行榜
PRDRD = switch, false, true, tag = 隐藏[首页-每日推荐], desc = 是否隐藏首页每日推荐
PRSCVPT = switch, false, true, tag = 隐藏[首页-推荐歌单], desc = 是否隐藏首页推荐歌单
PRST = switch, false, true, tag = 隐藏[首页-最近常听], desc = 是否隐藏首页最近常听
PRRR = switch, false, true, tag = 隐藏[首页-雷达歌单], desc = 是否隐藏首页雷达歌单
HMPR = switch, false, true, tag = 隐藏[首页-音乐合伙人], desc = 是否隐藏首页音乐合伙人
PRMST = switch, false, true, tag = 隐藏[首页-推荐专属歌单], desc = 是否隐藏首页专属歌单
PRCN = switch, false, true, tag = 隐藏[首页-你的专属歌单], desc = 是否隐藏首页你的专属歌单

Music163_VIP_Shared = switch, false, true, tag = 启用[共享会员], desc = 是否启用网易云音乐共享会员
Cookie = input, "", tag = Cookie, desc = 请填写Cookie值
MConfigInfo = input, "", tag = MConfigInfo ,desc = 请填写MConfigInfo值
UserAgent = input, "", tag = UserAgent, desc = 请填写UserAgent值

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT
DOMAIN, ipv4.music.163.com, REJECT
DOMAIN, ipv6.music.163.com, REJECT

[Rewrite]
# 开屏广告
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(ocpc\/)?ad\//i then response.body.mock("text", "{}", 200)

# 今日运势 商城 Beat专区 音乐收藏家 | type:ACTIVITY | 低至5.2折
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:delivery\/(batch-)?deliver|moment\/tab\/info\/|side-bar\/mini-program\/music-service\/account|yunbei\/account\/entrance\/)/i then reject_dict(200)

# 播放页 歌名下方 乐迷团｜关注｜播放页提示｜音乐应用红点｜播放提示
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:community\/friends\/fans-group\/artist\/group\/|mine\/applet\/redpoint|music\/songshare\/text\/recommend\/|resniche\/position\/play\/new\/|resniche\/tspopup\/show|resource\/comments?\/musiciansaid\/|user\/sub\/artist)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:ios\/version|mlivestream\/entrance\/playpage\/|link\/position\/show\/strategy|link\/scene\/show\/resource|v1\/content\/exposure\/comment\/banner\/)/i then reject_dict(200)

# 搜索页 搜索词 热搜卡片 猜你喜欢 我的应用下方提醒
request if ${url} ~= /^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(?:activity\/bonus\/playpage\/time\/query|resource-exposure\/|search\/(?:chart\/|rcmd\/keyword\/|specialkeyword\/))/i then reject_dict(200)
response if ${url} ~= /^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/search\/default/i then response.body.mock("text", "{}", 200)

# 主页播客推荐
request if ${url} ~= /^https:\/\/interface\d\.music\.163\.com\/eapi\/my\/podcast\/tab\/recommend/i then reject_dict(200)

[Script]
#----------  会员解锁 ----------#
# 播放会员歌曲
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs)/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/v3\/song\/detail/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get)/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放会员歌曲"

# 播放器会员皮肤
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/playermode\//i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]播放器会员皮肤"

# 搜索结果会员歌曲
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page)/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]搜索结果会员歌曲"

# 侧边栏会员等级
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipnewcenter\/app\/resource\/newaccountpage/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]侧边栏会员等级"

# 歌单列表会员认证
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/w?e?api\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe))/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]歌单列表会员认证"

# 会员认证
request if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/vipauth\/app\/auth\/(soundquality\/)?query/i then script("https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js", {${Cookie}, ${MConfigInfo}, ${UserAgent}}) with enable=${Music163_VIP_Shared}, tag="[网易云音乐]会员认证"

#----------  广告过滤 ----------#
# 热推、有话想说、分享一下、歌曲下的祝福等小提示、评论区、乐迷、星评等级、关注等图标
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/(?:batch|v2\/resource\/comment\/floor\/get)/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js") with tag="[网易云音乐]评论区", requires_body=true, binary_body_mode=true

# 推荐、home、主页
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/(?:homepage\/block\/page|link\/page\/rcmd\/(?:block\/resource\/multi\/refresh|resource\/show))/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js", {${PRGG}, ${PRRK}, ${PRDRD}, ${PRSCVPT}, ${PRST}, ${PRRR}, ${HMPR}, ${PRMST}, ${PRCN}}) with tag="[网易云音乐]主页", requires_body=true, binary_body_mode=true

# 底部Tab
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/link\/home\/framework\/tab/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js", {${MY}, ${DT}, ${FX}, ${GZ}}) with tag="[网易云音乐]底部Tab", requires_body=true, binary_body_mode=true

# 发现页
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/link\/page\/discovery\/resource\/show/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js") with tag="[网易云音乐]发现页", requires_body=true, binary_body_mode=true

# 播放音效
# response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/song\/play\/more\/list\/v\d/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js") with tag="[网易云音乐]播放音效", requires_body=true, binary_body_mode=true

# 我的页面
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/link\/position\/show\/resource/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js") with tag="[网易云音乐]我的页面", requires_body=true, binary_body_mode=true

# 显示未关注你的人
response if ${url} ~= /^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/eapi\/user\/follow\/users\/mixed\/get/i then script("https://loon.103516.xyz/Script/NeteaseMusic/NeteaseMusicAds.js") with tag="[网易云音乐]显示未关注你的人", requires_body=true, binary_body_mode=true

[MitM]
hostname = interface*.music.163.com, ipv4.music.163.com