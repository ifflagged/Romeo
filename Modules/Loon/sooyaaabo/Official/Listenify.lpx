[Script]
request if ${url} ~= /^https:\/\/api\.lrc\.cx\/(lyrics|cover)/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/js/listenify.js") with tag="[Listenify]Lyrics"

[MitM]
hostname = api.lrc.cx