#!name = 帆书
#!desc = 过滤帆书（樊登读书）广告
#!openUrl = https://apps.apple.com/app/id963152777
#!author = Yuheng0101[https://github.com/Yuheng0101]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
