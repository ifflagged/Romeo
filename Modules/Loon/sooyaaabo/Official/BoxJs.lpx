#!name = BoxJs
#!desc = Data manager，使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!openUrl = http://boxjs.com/
#!author = chavyleung[https://github.com/chavyleung]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/BoxJs.png
#!date = 2026-09-23 00:00

# 2023-02-08
# https://raw.githubusercontent.com/chavyleung/scripts/master/box/rewrite/boxjs.rewrite.loon.plugin

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js") with tag="BoxJs", timeout=120, requires_body=true

[MitM]
hostname = boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net