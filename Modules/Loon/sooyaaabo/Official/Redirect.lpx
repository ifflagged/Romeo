#!name = Redirect
#!desc = 针对部分网站进行重定向
#!openUrl = 
#!author = blackmatrix7[https://github.com/blackmatrix7]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
