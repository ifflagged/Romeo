# 2025-06-06 09:20:11
# https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rewrite/Loon/Redirect/Redirect.plugin

[Rewrite]
request if ${url} ~= /(^https?:\/\/app\.biliintl\.com\/(x\/)?(intl|dm|reply|history|v\d\/(fav|msgfeed)).+?)(&s_locale=zh-Hans_[A-Z]{2})(.+?)(&sim_code=\d+)(.+)/i as urlMatch then redirect(302, "${urlMatch.1}&s_locale=zh-Hans_PH${urlMatch.6}&sim_code=51503${urlMatch.8}")
request if ${url} ~= /(^https?:\/\/passport\.biliintl\.com\/x\/intl\/passport-login\/.+)(&s_locale=zh-Hans_[A-Z]{2})(.+)(&sim_code=\d+)(.+)/i as urlMatch then redirect(302, "${urlMatch.1}&s_locale=zh-Hans_PH${urlMatch.3}&sim_code=51503${urlMatch.5}")
request if ${url} ~= /^http:\/\/(www.)?aicoin\.cn\/$/i then redirect(302, "https://www.aicoin.com/")
request if ${url} ~= /^http:\/\/(www.)?jd\.com\//i then redirect(302, "https://www.jd.com/")
request if ${url} ~= /^http:\/\/(www.)?mi\.com\//i then redirect(302, "https://www.mi.com/")
request if ${url} ~= /^http:\/\/(www.)?suning\.com\//i then redirect(302, "https://suning.com/")
request if ${url} ~= /^http:\/\/(www.)?taobao\.com\//i then redirect(302, "https://taobao.com/")
request if ${url} ~= /^http:\/\/(www.)?yhd\.com\//i then redirect(302, "https://yhd.com/")
request if ${url} ~= /^http:\/\/you\.163\.com\//i then redirect(302, "https://you.163.com/")
request if ${url} ~= /^https?:\/\/(ditu|maps).google\.cn/i then redirect(302, "https://maps.google.com")
request if ${url} ~= /^https?:\/\/(www.)?(betterzipcn|betterzip)\.(com|net)\//i then redirect(302, "https://macitbetter.com/")
request if ${url} ~= /^https?:\/\/(www.)?(g|google)\.cn/i then redirect(302, "https://www.google.com")
request if ${url} ~= /^https?:\/\/(www.)?(mycleanmymac|xitongqingli)\.com\//i then redirect(302, "https://macpaw.com/")
request if ${url} ~= /^https?:\/\/(www.)?abbyychina\.com\//i then redirect(302, "https://www.abbyy.cn/")
request if ${url} ~= /^https?:\/\/(www.)?alienskins\.cn\//i then redirect(302, "https://exposure.software/")
