#!name = Google
#!desc = 将Google搜索重定向至.com域名，如遇频繁跳转请禁用本插件。
#!openUrl = https://apps.apple.com/app/id284815942
#!author = sooyaaabo[https://github.com/sooyaaabo]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Google.png
#!date = 2026-09-23 00:00

[Rewrite]
# request if ${url} ~= /^https?:\/\/(www\.)?(?:g|google)\.(cn|com\.hk)/i then redirect(307, "https://www.google.com")
request if ${url} ~= /^https?:\/\/(www\.)?(?:g|google)\.cn/i then redirect(307, "https://www.google.com")
request if ${url} ~= /^https?:\/\/(?:ditu|maps).google\.cn/i then redirect(307, "https://maps.google.com")
request if ${url} ~= /^https?:\/\/translate\.google\.cn/i then redirect(307, "https://translate.google.com")

[MitM]
hostname = *.google.cn, *.g.cn