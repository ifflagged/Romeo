#!name = 流媒体解锁测试
#!desc = 设置不同流媒体规则所经策略组，访问服务检测网页（https://streaming.test），点击所需要测试的流媒体卡片，等待测试结果即可。
#!openUrl = https://streaming.test/
#!author = huskydsb[https://github.com/huskydsb]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Conflux.png
#!date = 2026-09-23 00:00

# 2025-01-31
# https://github.com/huskydsb/Shadowrocket/blob/main/Sgmodule/%E6%B5%81%E5%AA%92%E4%BD%93%E8%A7%A3%E9%94%81%E6%B5%8B%E8%AF%95.module

