#!name = 看理想
#!desc = 过滤看理想部分广告，解锁会员广告及无限畅听，暂不支持数字图书馆。\n视频解析：进入视频课程详情页，点击右上角分享并复制链接，在浏览器中打开，进入播放面板后点击任意一集即可自动解析。
#!openUrl = https://apps.apple.com/app/id1342118033
#!author = ios151[https://github.com/ios151], Aioneas[https://github.com/Aioneas]
#!tag = 去广告, 解锁会员
#!system =
#!system_version =
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Vistopia.png
#!date = 2026-10-27 23:00

# 2026-10-12
# https://klx-proxy.pages.dev/proxy/vistopia.lpx
# 2026-10-27
# https://raw.githubusercontent.com/Aioneas/Surge/main/Module/kanlixiang.app.sgmodule

# 去开屏广告、推广、弹窗，解锁VIP与目录处理、音频及下载链路修正，新增原生视频直接播放、选集切换和进度拖动，会员页与资料页净化。

[Rewrite]
response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/home\/advertisement(\?|$)/i then response.body.mock("base64", "eyJzdGF0dXMiOiJzdWNjZXNzIiwiZGF0YSI6W119", 200, true)

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/other\/pop-up(\?|$)/i then response.body.mock("base64", "eyJzdGF0dXMiOiJlcnJvciIsImRhdGEiOm51bGx9", 404, true)

[Script]
response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/home\/header-new(\?|$)/i then script("https://raw.githubusercontent.com/Aioneas/Surge/main/Script/klx_no_ads.js") with tag="[看理想]移除首页推广", requires_body=true

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/other\/config(\?|$)/i then script("https://raw.githubusercontent.com/Aioneas/Surge/main/Script/klx_no_ads.js") with tag="[看理想]移除广告配置", requires_body=true

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/(reader\/(section-detail|detail)|user\/home|vip\/buy-list|services\/play-token(?!\?library_article_id=))/i then script("https://raw.githubusercontent.com/Aioneas/Surge/8918cca082e16cf42f7b72cd52f20e036724e719/Script/klx_app_video_compat.js") with tag="[看理想]VIP解锁", timeout=15, requires_body=true

response if ${url} ~= /^https?:\/\/shop\.vistopia\.com\.cn\/vip_rights(?:\?|$)/i then script("https://raw.githubusercontent.com/Aioneas/Surge/b29d585e7953968337272a9e0f74a83676602e56/Script/klx_vip_page_hide_purchase.js") with tag="[看理想]移除会员页购买区", requires_body=true

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/(services\/articles-play-token(\?|$)|content\/batch(\?|$))/i then script("https://raw.githubusercontent.com/Aioneas/Surge/main/Script/klx_app_download_unlock.js?v=20260814g") with tag="[看理想]下载链路修正", requires_body=true

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/content\/(content-show\/\d+|article_list(\?|$))/i then script("https://raw.githubusercontent.com/Aioneas/Surge/main/Script/klx_app_catalog_unlock.js") with tag="[看理想]目录解锁", requires_body=true

response if ${url} ~= /^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/user\/profile(\?|$)/i then script("https://raw.githubusercontent.com/Aioneas/Surge/main/Script/klx_profile_clean.js") with tag="[看理想]移除推广昵称", requires_body=true

[MitM]
hostname = api.vistopia.com.cn, shop.vistopia.com.cn
