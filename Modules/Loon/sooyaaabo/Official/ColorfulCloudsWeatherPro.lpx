#!name = 彩云天气Pro
#!desc = 过滤彩云天气广告，解锁SVIP功能。\n解锁功能需App版本低于7.20.2。
#!openUrl = https://apps.apple.com/app/id1067198688
#!author = RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告, 解锁会员
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ColorfulCloudsWeatherPro.png
#!date = 2026-09-23 00:00

# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/ColorfulClouds_remove_ads.lpx

[Rule]
DOMAIN, abyss.cyapi.cn, REJECT
DOMAIN, ad.cyapi.cn, REJECT
DOMAIN, gather.colorfulclouds.net, REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.caiyunapp\.com\/v1\/activity/i then reject_dict(200)
request if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)/i then reject_dict(200)
response if ${url} ~= /^https?:\/\/wrapper\.cyapi\.cn\/v1\/activity\?/i then response.body.mock_file("json", "https://raw.githubusercontent.com/Keywos/rule/main/mocks/caiyun.json", 200)

[Script]
# 共享会员
request if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\?/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气]共享会员"
response if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(api\/v1\/user_detail|p\/v1\/vip_info|v2\/user)/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气]共享会员", requires_body=true

# 底部菜单栏,活动推广
response if ${url} ~= /^https:\/\/(wrapper\.cyapi\.cn|api\.caiyunapp\.com|cdn-w\.caiyunapp\.com)\/v1\/activity\?/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气]移除广告", requires_body=true

[MitM]
hostname = biz.cyapi.cn, starplucker.cyapi.cn, api.caiyunapp.com, cdn-w.caiyunapp.com, wrapper.cyapi.cn