#!name = 彩云天气Pro
#!desc = 过滤彩云天气广告，解锁SVIP功能。\nApp版本低于7.20.2。
#!openUrl = https://apps.apple.com/app/id1067198688
#!author = RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告, 解锁会员
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ColorfulCloudsWeatherPro.png
#!date = 2026-09-23 00:00

# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/ColorfulClouds_remove_ads.lpx
# 2026-08-30 10:10
# https://rucu6.pages.dev/Plugins/caiyun.lpx

[Rule]
DOMAIN, abyss.cyapi.cn, REJECT
DOMAIN, ad.cyapi.cn, REJECT
DOMAIN, gather.colorfulclouds.net, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)/i then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\?/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]会员Crack"

response if ${url} ~= /^https:\/\/api\.caiyunapp\.com\/v1\/activity\?/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]底部菜单栏", requires_body=true

response if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(api\/v1\/user_detail|p\/v1\/vip_info|v2\/user)/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]我的页面", requires_body=true

response if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\?/i then script("https://loon.103516.xyz/Script/ColorfulCloudsWeatherPro/ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]活动推广", requires_body=true

[MitM]
hostname = api.caiyunapp.com, *.cyapi.cn
