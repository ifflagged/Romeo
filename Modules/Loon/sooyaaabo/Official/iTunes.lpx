# 2026-09-16
# https://raw.githubusercontent.com/chxm1023/Rewrite/main/iTunes.js
# 2024-01-24
# https://ddgksf2013.top/scripts/buyitunes.vip.js
# 2024-02-10
# https://github.com/Guding88/Script/blob/main/APPheji_iTunes.js

[Argument]
iTunes-chxm1023 = switch, false, true, tag = iTunes-chxm1023, desc = 是否启用chxm1023的脚本来解锁iTunes系列
iTunes-ddgksf2013 = switch, false, true, tag = iTunes-ddgksf2013, desc = 是否启用ddgksf2013的脚本来解锁iTunes系列
iTunes-Guding88 = switch, false, true, tag = iTunes-Guding88, desc = 是否启用Guding88的脚本来解锁iTunes系列

[Script]
# chxm1023
response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://raw.githubusercontent.com/chxm1023/Rewrite/main/iTunes.js") with enable=${iTunes-chxm1023}, tag="[iTunes]会员Crack@chxm1023", requires_body=true

# ddgksf2013
response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://loon.103516.xyz/Script/iTunes/iTunes-ddgksf2013.js") with enable=${iTunes-ddgksf2013}, tag="[iTunes]会员Crack@ddgksf2013", requires_body=true

# Guding88
response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://raw.githubusercontent.com/Guding88/Script/main/APPheji_iTunes.js") with enable=${iTunes-Guding88}, tag="[iTunes]会员Crack@Guding88", requires_body=true

[MitM]
hostname = buy.itunes.apple.com