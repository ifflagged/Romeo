#!name = 1.1.1.1 with WARP
#!desc = WARP检测面板与节点提取，点击下方主页链接前往配置1.1.1.1的BoxJs配置。
#!openUrl = https://itunes.apple.com/app/id1423538627
#!author = VirgilClyne[https://github.com/VirgilClyne], I-am-R-E[https://github.com/I-am-R-E]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/1.1.1.1-01.png
#!date = 2026-09-23 00:00

# 2024-02-07
# https://github.com/VirgilClyne/Cloudflare/blob/main/modules/Cloudflare.1.1.1.1.plugin

[Script]
# WARP Panel
generic then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.panel.js") with tag="WARP Panel", img_url="lock.icloud.fill", timeout=10

# WARP Personal
request if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.request.js") with tag="[1.1.1.1]WARP Personal Request", requires_body=true
response if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.response.js") with tag="[1.1.1.1]WARP Personal Response", requires_body=true

# Zero Trust Client (Cloudflare for Teams)
request if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.request.js") with tag="[1.1.1.1]WARP Teams Request", requires_body=true
response if ${url} ~= /^https?:\/\/(api|zero-trust-client)\.cloudflareclient\.com\/(.*)\/reg\/t\.[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$/i then script("https://raw.githubusercontent.com/VirgilClyne/Cloudflare/main/js/1.1.1.1.response.js") with tag="[1.1.1.1]WARP Teams Response", requires_body=true

[MitM]
hostname = api.cloudflareclient.com, zero-trust-client.cloudflareclient.com