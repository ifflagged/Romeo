#!name = XPTV
#!desc = 伪CMS源，安装此插件后在XPTV内添加订阅地址：https://ykusu.ykusu/getJSON/cmsbeta.json
#!openUrl = https://apps.apple.com/app/id6459409368
#!author = Yswag[https://github.com/Yswag]
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/XPTV.png
#!date = 2026-09-23 00:00

# 2024-08-06 00:14
# https://github.com/Yswag/for-own-use/blob/main/XPTV/XPTV-sources.plugin

# 目前支持：4K测试、Anfuns、BILFUN、NO视频、短剧天堂、韩剧看看、两个BT、MGTV、美剧星球、耐看点播、烧火电影、素白白影视、速讯影院、文才资源、小苹果、小蚂蚁、星芽短剧、瓜子影视
# 已知问题：
# 1. 两个BT及素白白经常盗用小红书图床存资源，如果播放失败很可能是被小红书删除了
# 2. 海外访问小红书cdn会分配到cf ip，速度很慢，解决方法是将域名(dc.xhscdn.com)本地DNS映射到境内ip
# 3. 烧火电影的搜索需要通过图形验证码，所以脚本会请求ocr api，如果烧火搜寻失败有可能是api连接失败(域名为api.nn.ci)
# (仅作为VOD的补充，日常以VOD源为主)

[Rewrite]
# request if ${url} ~= /^https:\/\/tencent-1257389134\.cos\.ap-nanjing\.myqcloud\.com\.qqhd\.net\/fangdao\.php/i then request.header.set("Content-Type", "application/vnd.apple.mpegURL")

[Script]
request if ${url} ~= /^https?:\/\/ykusu\.ykusu\/(.*)\/provide\/vod/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/spider.js") with tag="[XPTV]XPTV-sources"

request if ${url} ~= /^https?:\/\/ykusu\.ykusu\/getJSON\/(.*).json/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/spider.js") with tag="[XPTV]XPTV-getJSON"

response if ${url} ~= /^https:\/\/tencent-1257389134\.cos\.ap-nanjing\.myqcloud\.com\.qqhd\.net\/fangdao\.php/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]美剧星球", timeout=10, requires_body=true

request if ${url} ~= /^https:\/\/api\.emasmr\.com.*mp4/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]短剧天堂", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/hd\.suxun\.site\/api\.php\/provide\/vod(.*)&ids/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]速讯影院", timeout=10, requires_body=true

request if ${url} ~= /^https?:\/\/ppvod01\.blbtgg\.com.*(ts|m3u8)/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]文才资源", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/vipcj\.timizy\.top\/api\.php\/provide\/vod\/from\/mgtv(.*)&ids/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]MGTV", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/dsakf23665\.com\/api\.php\/provide\/vod(.*)&ids/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]dsakf23665", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/42\.157\.129\.29:2222\/.*\.png/i then script("https://raw.githubusercontent.com/Yswag/for-own-use/main/XPTV/spider/xptv-misc.js") with tag="[XPTV]JX", timeout=10, requires_body=true

[MitM]
hostname = ykusu.ykusu, tencent-1257389134.cos.ap-nanjing.myqcloud.com.qqhd.net, api.emasmr.com, ppvod01.blbtgg.com, vipcj.timizy.top, 42.157.129.29:2222