#!name = 小蚕惠生活
#!desc = 过滤小蚕惠生活广告
#!openUrl = https://apps.apple.com/app/id1618414236
#!author = Sliverkiss[https://github.com/Sliverkiss], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/XiaoCan.png
#!date = 2026-09-23 00:00

# 2026-06-01 17:11:35
# https://kelee.one/Tool/Loon/Lpx/XiaoCan_remove_ads.lpx

[Rewrite]
# 红包推广
request if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/rpc/i then request.header.replace("methodname", /.*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg)/, "null")

# 首页横幅推广
request if ${url} ~= /^https:\/\/web2\.realtech-inc\.com\/oss\/xc-app-assets\/configs\/common\/theme\.json/i then reject_dict(200)

# 打车权益
request if ${url} ~= /^https:\/\/web\.xinyifm\.cn\/oss\/xc-app-assets\/configs\/common\/index_activity\.json/i then reject_dict(200)

# 大牌活动
request if ${url} ~= /^https:\/\/web2\.realtech-inc\.com\/oss\/xc-app-assets\/configs\/common\/links\.json/i then reject_dict(200)

# 开屏广告
request if ${url} ~= /^https:\/\/sdk\.1rtb\.net\/sdk\/req_ad\?/i then reject_dict(200)

# 更新弹窗
request if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/g\/pa/i then reject_dict(200)

[MitM]
hostname = gw.xiaocantech.com, web2.realtech-inc.com, sdk.1rtb.net