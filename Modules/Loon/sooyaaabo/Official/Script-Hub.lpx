#!name = Script Hub
#!desc = 重写 & 规则集转换，使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!openUrl = https://script.hub/
#!author = xream[https://github.com/xream], Keywos[https://github.com/Keywos], CKYB[https://github.com/CKYB], 小白脸
#!tag = 功能增强
#!system = 
#!system_version = 
#!loon_version = 3.5.1(998)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Script-Hub-Dark.png
#!select = 启用插件随机图标, 启用, 禁用
#!select = 替换原始插件图标, 启用, 禁用
#!select = 插件随机图标合集, Doraemon(100P), Shin-chan(100P), Weslie-Wolffy(100P), Tom-Jerry(100P), Genshin(160P), Shin-Miya(100P), OnePiece(100P), Stitch(100P), Pokemon(112P), PokemonGif(56P), Digimon(56P), Transformers(48P), Maruko-chan(100P), AttackOnTitan(84P), Naruto(284P)
#!select = ScriptHub通知, 开启通知, 关闭通知, 跟随链接
#!input = Parser_body_max
#!input = Parser_http_timeout
#!date = 2026-09-23 00:00

# 2025-07-02
# https://github.com/Script-Hub-Org/Script-Hub/blob/main/modules/script-hub.beta.loon.plugin

[General]
force-http-engine-hosts = script.hub, *.script.hub

[Rule]
DOMAIN, scripthub.vercel.app, PROXY

[Script]
request if ${url} ~= /^https?:\/\/script\.hub\/($|edit\/|reload)/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.beta.js") with tag="[Script Hub]前端", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module)/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.beta.js") with tag="[Script Hub]重写转换", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.beta.js") with tag="[Script Hub]规则集转换", timeout=300

request if ${url} ~= /^https?:\/\/script\.hub\/convert\//i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.beta.js") with tag="[Script Hub]脚本转换", timeout=300

[MitM]
hostname = script.hub, *.script.hub