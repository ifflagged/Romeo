#!name=彩云天气Pro
#!desc=过滤彩云天气广告，解锁SVIP功能。\nApp版本低于7.20.2。
#!author=RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id1067198688
#!tag=去广告, 解锁会员
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT
DOMAIN,gather.colorfulclouds.net,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures)/i then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ColorfulCloudsWeatherPro/loon_ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]会员Crack"

response if ${url} ~= /^https:\/\/api\.caiyunapp\.com\/v1\/activity\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ColorfulCloudsWeatherPro/loon_ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]底部菜单栏", requires_body=true

response if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/(api\/v1\/user_detail|p\/v1\/vip_info|v2\/user)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ColorfulCloudsWeatherPro/loon_ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]我的页面", requires_body=true

response if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ColorfulCloudsWeatherPro/loon_ColorfulCloudsWeatherPro.js") with tag="[彩云天气Pro]活动推广", requires_body=true

[MITM]
hostname = api.caiyunapp.com, *.cyapi.cn

