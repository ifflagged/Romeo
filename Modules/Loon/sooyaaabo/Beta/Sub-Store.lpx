#!name=Sub-Store
#!desc=高级订阅管理工具。使用前请在本插件的详情页面为[PROXY]项分配代理策略。定时任务默认为每天23点55分，可在插件设置中自定义。定时任务指定时将订阅/文件上传到私有Gist。在前端，叫做'同步'或'同步配置'。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://sub.store/
#!tag=功能增强
#!loon_version=3.5.1(998)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-09-23 00:00

[Rule]
DOMAIN,sub-store.vercel.app,PROXY

[Script]
cron "cors = input, https://sub-store.vercel.app," script-path=http://substore.stash, timeout=120, tag=CORS允许来源

[MITM]
hostname = sub.store

