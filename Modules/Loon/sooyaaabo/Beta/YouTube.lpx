#!name=YouTube (Music)
#!desc=过滤YouTube (Music)广告，增加画中画、字幕翻译、歌词翻译功能，支持后台播放。需要启用QUIC回退保护。不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile], RuCu6[https://github.com/RuCu6]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id544007664
#!tag=去广告, 功能增强
#!system_version=15
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Argument]
blockUpload=switch,true,false,tag = 隐藏上传按钮, desc = 用于隐藏YouTube底栏的上传按钮
blockShorts=switch,true,false,tag = 隐藏Shorts按钮, desc = 用于隐藏YouTube底栏的Shorts按钮
blockImmersive=switch,true,false,tag = 隐藏选段按钮, desc = 用于隐藏YouTube Music底栏的选段按钮
captionLang=select,"off",tag = 字幕翻译语言, desc = 选择翻译为何种语言字幕
debug=switch,false,true,tag = 启用调试模式, desc = 此插件的调试模式

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.response.js", {${captionLang}, ${blockUpload}, ${blockImmersive}, ${blockShorts}, ${debug}}) with tag="[YouTube]response", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.request.js", {${captionLang}}) with tag="[YouTube]request_init", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube/Maasea_youtube.request.js") with tag="[YouTube]request_log_event", requires_body=true, binary_body_mode=true

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com

