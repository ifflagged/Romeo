#!name=帆书
#!desc=过滤帆书（樊登读书）广告
#!author=Yuheng0101[https://github.com/Yuheng0101]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id963152777
#!tag=去广告
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rewrite]
request if ${url} ~= /^https?:\/\/popup\.dushu365\.com\/api\/v2\/sfo\/(user_)?popup_(?:config|display)s/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/(?:shortCut|appUpdateUnite|loadingAd)/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fs-retain\/trialVip\/v\d+\/requestTrialVipPopDoNotSendReward/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/vipLandingPage\/v\d+\/getVipLandingPageApp/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fandeng-orch\/dual2211\/config/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fdtalk-orch\/newcomerzone\/v\d+\/guide/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fandeng-orch\/bookboy\/v\d+\/vipPagePop/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/appConfig/i then reject(404)
request if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/order-orchestration\/orderWeb\/exchange\/v100\/showExchangeButton/i then reject(404)

[Script]
response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v105\/category/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/abtest-front\/banner-modular\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/book\/channel\/v100\/info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fs-member\/user\/profile\/v100\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v111\/forApp/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/sns-orchestration-system\/homePage\/api\/v100\/myPage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/task-orchestration\/taskCenter\/api\/v101\/taskList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/book\/v101\/content/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/user-orchestration\/user\/api\/v101\/ceiltip/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/FanShu/Yuheng0101_No_Ads.js") with tag="[帆书]移除广告", timeout=60, requires_body=true

