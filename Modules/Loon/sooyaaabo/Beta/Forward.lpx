[Rule]
DOMAIN,mock.forward1.workers.dev,PROXY
DOMAIN,fluxapi.vvebo.vip,PROXY

[Rewrite]
request if ${url} ~= /^https:\/\/fluxapi\.vvebo\.vip\/v1\/(purchase\/iap\/subscription)/i as urlMatch then url.replace("https://mock.forward1.workers.dev/forward/v1/${urlMatch.1}")

[MITM]
hostname = fluxapi.vvebo.vip

