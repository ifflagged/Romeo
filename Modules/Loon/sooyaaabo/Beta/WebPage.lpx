[Rule]
DOMAIN-SUFFIX,creative.myavlive.com,REJECT
DOMAIN-SUFFIX,trackwilltrk.com,REJECT
DOMAIN-SUFFIX,tsyndicate.com,REJECT
DOMAIN-SUFFIX,jads.co,REJECT
DOMAIN-SUFFIX,juicyads.com,REJECT
DOMAIN-SUFFIX,mnaspm.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/exhentai\.org/i then redirect(307, "https://e-hentai.org")
request if ${url} ~= /^https?:\/\/(www.)?(g|google)\.cn/i then redirect(307, "https://www.google.com")
request if ${url} ~= /^https?:\/\/translate\.google\.cn/i then redirect(307, "https://translate.google.com")
request if ${url} ~= /^https:\/\/(?:cn|www)\.pornhub\.com\/_xa\/ads(_batch)?\?/i then reject(200)
request if ${url} ~= /^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/kokoryh_webpage.hanime.js") with tag="[WebPage]Hanime", requires_body=true

response if ${url} ~= /^https:\/\/e-hentai\.org\/g\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/kokoryh_webpage.ehentai.js") with tag="[WebPage]E-Hentai", requires_body=true

request if ${url} ~= /^https:\/\/boxer\.baidu\.com\/scheme\?scheme/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduNoRedirect.js") with tag="[WebPage]百度防跳转"

response if ${url} ~= /^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduIndex.js") with tag="[WebPage]百度首页", requires_body=true

response if ${url} ~= /^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_BaiduZhidao.js") with tag="[WebPage]百度知道", requires_body=true

response if ${url} ~= /^https:\/\/javdb\.com\/(?!over18\?)/i then script("https://loon.103516.xyz/Script/WebPage/JavDB.js") with tag="[WebPage]JavDB", requires_body=true

response if ${url} ~= /^https:\/\/2023\.redircdn\.com\/web\/mob_post\.js\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/loon_MyBlockAds.js") with tag="[WebPage]草榴社区", requires_body=true

response if ${url} ~= /^https?:\/\/www\.zxzjhd\.com\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_adguard.js") with tag="[WebPage]在线之家", requires_body=true

response if ${url} ~= /^https?:\/\/www\.freeok\.(vip|pro)(\/$|\/[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_adguard.js") with tag="[WebPage]FreeOk", requires_body=true

response if ${url} ~= /^https?:\/\/.*bdys.*com\/($|([a-z]+)\/(play\/)?\d+.*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_bdys.js") with tag="[WebPage]哔嘀影视", requires_body=true

response if ${url} ~= /^https?:\/\/(cn|www)\.pornhub\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_pornhub.ads.js") with tag="[WebPage]PornHub", requires_body=true

response if ${url} ~= /^https?:\/\/.*bimi.*net\/($|(vodshow|bangumi|type)\/[0-9a-z-\/]+\/$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_bimi.js") with tag="[WebPage]Bimi", requires_body=true

response if ${url} ~= /^https?:\/\/.*18comic\.org\/($|(album|photo).*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_18comic.js") with tag="[WebPage]禁漫天堂", requires_body=true

response if ${url} ~= /^https?:\/\/.*gimy.*\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_gimytv.js") with tag="[WebPage]剧迷", requires_body=true

response if ${url} ~= /^https?:\/\/.*czzy.*\/($|\?btwaf=\w+$|[0-9a-zA-Z=_\/-]+\.html)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_qianoo.js") with tag="[WebPage]厂长电影", requires_body=true

response if ${url} ~= /^https?:\/\/.*cupfox\.*\/($|[\u4E00-\u9FFFa-zA-Z0-9%=_\/-]+$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_cupbox.js") with tag="[WebPage]茶杯狐", requires_body=true

response if ${url} ~= /^https?:\/\/cokemv\.me\/($|vod.*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_cokemv.js") with tag="[WebPage]Cokemv", requires_body=true

response if ${url} ~= /^https?:\/\/.*5y.*\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_555.js") with tag="[WebPage]555影视", requires_body=true

response if ${url} ~= /^https?:\/\/.*nivod.*\/($|[0-9a-zA-Z=_\/-]+\.html)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_nivod.js") with tag="[WebPage]泥巴影视", requires_body=true

response if ${url} ~= /^https?:\/\/.*netflix.*\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_netflix.js") with tag="[WebPage]奈飞鸭", requires_body=true

response if ${url} ~= /^https?:\/\/.*lezhutv\.com\/($|(type|detail|play|index).*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_lezhu.js") with tag="[WebPage]LeZhu", requires_body=true

response if ${url} ~= /^https?:\/\/.*tkznp.*com\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_tkys.js") with tag="[WebPage]天空影视", requires_body=true

response if ${url} ~= /^https?:\/\/.*ikandy.*fun\/($|(vod|top).*$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_zhenbuka.js") with tag="[WebPage]真不卡", requires_body=true

response if ${url} ~= /^https?:\/\/.*libvio.*me\/($|[0-9a-zA-Z=_\/-]+\.html$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/WebPage/ddgksf2013_libvio.js") with tag="[WebPage]Libvio", requires_body=true

[MITM]
hostname = e-hentai.org, exhentai.org, hanime1.me, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, *.google.cn, asserts.avple.tv, javdb.com, 2023.redircdn.com, *.pornhub.com, www.zxzjhd.com, m.nivod4.tv, *.freeok.*, *netflix*, *bdys*, *cupfox*, *cokemv*, *pornhub.com, *lezhutv*, *bimi*, 18comic.org, *5y*, *gimy*, *tkznp*, *czzy*, *ikandy*, *libvio*

