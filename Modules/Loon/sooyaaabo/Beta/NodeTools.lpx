#!name=节点检测工具 𝕂
#!desc=节点网速测试、节点解锁状况、节点风险查询、节点入口落地查询
#!author=KOP-XIAO[https://github.com/KOP-XIAO], xream[https://github.com/xream], Keywos[https://github.com/Keywos], dcpengx[https://github.com/dcpengx], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=icon not found
#!tag=sooyaaabo
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00
#!select=入口查询超时时间ms, 100, 200, 500, 800, 1000, 1200, 2000, 5000, 10000
#!select=落地查询超时时间ms, 100, 200, 500, 1000, 1500, 2000, 3000, 5000, 10000
#!select=是否隐藏真实IP, 隐藏, 不隐藏

[Script]
generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeTools/loon_NodeSpeedtest.js") with tag="节点网速测试 𝕂", img_url="speedometer", timeout=10

generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeTools/loon_NodeUnlockDetection.js") with tag="节点解锁查询 𝕂", img_url="play.circle", timeout=20

generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeTools/loon_NodeLocation.js") with tag="节点风险查询 𝕂", img_url="asterisk.circle", timeout=10

generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeTools/Keywos_loon.js") with tag="入口落地查询 𝕂", img_url="network"

