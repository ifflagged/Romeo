#!name=VVebo
#!desc=修复用户主页时间线问题，需禁用[微博]插件和[微博轻享版]插件，以避免本插件不生效。
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id670910957
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/VVebo/suiyuran_fix-vvebo-user-timeline.js") with tag="[VVebo]修复时间线"

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/VVebo/suiyuran_fix-vvebo-user-timeline.js") with tag="[VVebo]修复时间线"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/VVebo/suiyuran_fix-vvebo-user-timeline.js") with tag="[VVebo]修复时间线", requires_body=true

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/VVebo/suiyuran_fix-vvebo-fans.js") with tag="[VVebo]修复我的页面", requires_body=true

[MITM]
hostname = api.weibo.cn

