[Script]
request if ${url} ~= /^https:\/\/api\.lrc\.cx\/(lyrics|cover)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Listenify/Yswag_listenify.js") with tag="[Listenify]Lyrics"

[MITM]
hostname = api.lrc.cx

