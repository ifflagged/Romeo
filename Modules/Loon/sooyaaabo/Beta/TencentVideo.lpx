#!name=腾讯视频
#!desc=不负好时光 [不负好广告]
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id458318329
#!tag=去广告
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-27 16:00

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/TencentVideo/loon_TencentVideo.js") with tag="[腾讯视频]请求体处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/TencentVideo/loon_TencentVideo.js") with tag="[腾讯视频]响应体处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/TencentVideo/loon_TencentVideo.js") with tag="[腾讯视频]JCE处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/TencentVideo/loon_TencentVideo.js") with tag="[腾讯视频]配置处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/TencentVideo/loon_TencentVideo.js") with tag="[腾讯视频]配置处理", timeout=10, requires_body=true

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com

