#!name=中国移动
#!desc=过滤中国移动广告，可自定义。
#!author=sooyaaabo[https://github.com/sooyaaabo], ccyykk666[https://github.com/ccyykk666]
#!icon=icon not found
#!tag=Jacob
#!openUrl=https://apps.apple.com/app/id583700738
#!tag=去广告, 功能增强
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-07-27 17:00

[Argument]
HomeBasicClean=switch,true,false,tag = [首页] 基础净化, desc = 移除基础广告
HideTopFamily=switch,false,true,tag = [首页] 隐藏-爱家, desc = 隐藏首页顶部Tab-爱家
HideTopAge=switch,false,true,tag = [首页] 隐藏-网龄, desc = 隐藏首页顶部Tab-网龄
HideTopPhone=switch,false,true,tag = [首页] 隐藏-手机, desc = 隐藏首页顶部Tab-手机
HideTopNearby=switch,false,true,tag = [首页] 隐藏-附近厅, desc = 隐藏首页顶部Tab-附近厅
HideTopAI=switch,false,true,tag = [首页] 隐藏-AI尝鲜, desc = 隐藏首页顶部Tab-AI尝鲜
HideTopEnterprise=switch,false,true,tag = [首页] 隐藏-政企, desc = 隐藏首页顶部Tab-政企
MineClean=switch,true,false,tag = [我的] 基础净化, desc = 移除基础广告
HideMyCheckIn=switch,false,true,tag = [我的] 隐藏-签到浮窗, desc = 隐藏我的-签到浮窗 areaId 20230721008
HideMyMarketing=switch,false,true,tag = [我的] 隐藏-营销区域, desc = 隐藏我的-营销区域 areaId 20230721012
HideMyServices=switch,false,true,tag = [我的] 隐藏-我的服务, desc = 隐藏我的-我的服务 areaId 20230721018
HideMyFamilyCube=switch,false,true,tag = [我的] 隐藏-我的家庭, desc = 隐藏我的-我的家庭 areaId 20240708002
HideMyDevicesCube=switch,false,true,tag = [我的] 隐藏-我的设备, desc = 隐藏我的-我的设备 areaId 20251024002
HideMyMiniProgram=switch,false,true,tag = [我的] 隐藏-我的账户, desc = 隐藏我的-我的账户 areaId 20231017002
HideMyDigitalHuman=switch,false,true,tag = [我的] 隐藏-AI智能助理, desc = 隐藏我的-AI智能助理 areaId 20230721020
HideMySelections=switch,false,true,tag = [我的] 隐藏-我的优选, desc = 隐藏我的-我的优选 areaId 20230721030
HideMyGroup=switch,false,true,tag = [我的] 隐藏-我的集团, desc = 隐藏我的-我的集团 areaId 20230721036
HideMyRingtone=switch,false,true,tag = [我的] 隐藏-我的彩铃, desc = 隐藏我的-我的彩铃 areaId 20251230002
HideMyCloudDrive=switch,false,true,tag = [我的] 隐藏-我的云盘, desc = 隐藏我的-我的云盘 areaId 20240624002
HideMyToolbox=switch,false,true,tag = [我的] 隐藏-百宝箱, desc = 隐藏我的-百宝箱 areaId 20230721044
HideMyLifeServices=switch,false,true,tag = [我的] 隐藏-生活服务, desc = 隐藏我的-生活服务 areaId 20230928004

[Rewrite]
^https?:\/\/(client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(explorePage\/getAdverList|init\/startInit|emotionMarket) - reject-200

[Script]
http-response ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$ script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10, tag=[中国移动]页面净化, argument=[{HomeBasicClean},{HideTopFamily},{HideTopAge},{HideTopPhone},{HideTopNearby},{HideTopAI},{HideTopEnterprise},{MineClean},{HideMyCheckIn},{HideMyMarketing},{HideMyServices},{HideMyFamilyCube},{HideMyDevicesCube},{HideMyMiniProgram},{HideMyDigitalHuman},{HideMySelections},{HideMyGroup},{HideMyRingtone},{HideMyCloudDrive},{HideMyToolbox},{HideMyLifeServices}]

http-response ^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$ script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10, tag=[中国移动]消息与卡券净化

http-response ^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$ script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10, tag=[中国移动]充值横幅净化

http-response ^https:\/\/touch\.10086\.cn\/i\/v1\/(?:cust\/(?:aiMainQry|iopBatchQry)|pay\/popWindowQry)\/[^?]+(?:\?.*)?$ script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10, tag=[中国移动]充值内容净化

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn

