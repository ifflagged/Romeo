#!name=NodeSeek & DeepFlood
#!desc=NodeSeek、DeepFlood每日签到。\n登录账号进入个人页面以获取Cookie，成功后关闭Cookie脚本。\n支持设置签到鸡腿奖励模式，默认为固定5个鸡腿。
#!author=sooyaaabo[https://github.com/sooyaaabo]
#!icon=icon not found
#!tag=sooyaaabo
#!tag=定时任务
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rule]
DOMAIN-SUFFIX,nodeseek.com,PROXY
DOMAIN-SUFFIX,deepflood.com,PROXY

[Script]
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/\d+\?readme=1$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeSeek/loon_nodeseek-checkin.js") with enable=${Cookie-NodeSeek}, tag="[NodeSeek]获取Cookie"

cron ${Cron-NodeSeek} then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeSeek/loon_nodeseek-checkin.js", {${Mode-NodeSeek}}) with enable=${Task-NodeSeek}, tag="[NodeSeek]定时签到"

request if ${url} ~= /^https:\/\/www\.deepflood\.com\/api\/account\/getInfo\/\d+\?readme=1$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeSeek/loon_deepflood-checkin.js") with enable=${Cookie-DeepFlood}, tag="[DeepFlood]获取Cookie"

cron ${Cron-DeepFlood} then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/NodeSeek/loon_deepflood-checkin.js", {${Mode-DeepFlood}}) with enable=${Task-DeepFlood}, tag="[DeepFlood]定时签到"

[MITM]
hostname = www.nodeseek.com, www.deepflood.com

