#!name=Loon Gallery
#!desc=Loon插件仓库，一键安装。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://🎈.com
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rule]
DOMAIN,loon-plugin.vercel.app,PROXY

[Script]
request if ${url} ~= /^https?:\/\/xn--ck8h\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/LoonGallery/Loon0x00_gallery.js") with tag="Loon插件仓库", timeout=120, requires_body=true

[MITM]
hostname = xn--ck8h.com

