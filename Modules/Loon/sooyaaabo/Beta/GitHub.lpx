#!name=GitHub
#!desc=解决GitHub 429请求频繁问题
#!author=Yuheng0101[https://github.com/Yuheng0101], sooyaaabo[https://github.com/sooyaaabo]
#!icon=icon not found
#!tag=Jacob
#!openUrl=https://github.com/
#!tag=功能增强
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-07-09 18:00

[Rewrite]
# 解决GitHub速率限制返回429问题
^https:\/\/.*\.githubusercontent\.com\/ header-replace 'Accept-Language' 'en-us'
^https:\/\/github\.com\/ header-replace 'Accept-Language' 'en-us'

[Script]
http-request ^https?:\/\/raw\.githubusercontent\.com/.+ script-path=https://loon.103516.xyz/Script/GitHub/GitRawAutoCDN.js, timeout=5, tag=[GitHub]将Raw请求自动重定向到CDN

[MITM]
hostname = github.com, *.githubusercontent.com

