#!name=GitHub
#!desc=解决GitHub 429请求频繁问题
#!author=Yuheng0101[https://github.com/Yuheng0101], sooyaaabo[https://github.com/sooyaaabo]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://github.com/
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rewrite]
request if ${url} ~= /^https:\/\/.*\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")

[Script]
request if ${url} ~= /^https?:\/\/raw\.githubusercontent\.com\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GitHub/loon_GitRawAutoCDN.js") with tag="[GitHub]将Raw请求自动重定向到CDN", timeout=5

[MITM]
hostname = github.com, *.githubusercontent.com

