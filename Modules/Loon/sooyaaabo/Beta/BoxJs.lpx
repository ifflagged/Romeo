#!name=BoxJs
#!desc=Data manager，使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=chavyleung[https://github.com/chavyleung]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=http://boxjs.com/
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rule]
DOMAIN-SUFFIX,jsdelivr.net,PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/BoxJs/chavyleung_chavy.boxjs.js") with tag="BoxJs", timeout=120, requires_body=true

[MITM]
hostname = boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

