#!name=iTunes
#!desc=iTunes系列解锁合集，在设置中选择需要使用的原作者脚本以使用此插件。
#!author=chxm1023[https://github.com/chxm1023], ddgksf2013[https://github.com/ddgksf2013], Guding88[https://github.com/Guding88]
#!icon=icon not found
#!tag=sooyaaabo
#!tag=解锁会员
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Argument]
iTunes-chxm1023=switch,false,true,tag = iTunes-chxm1023, desc = 是否启用chxm1023的脚本来解锁iTunes系列
iTunes-ddgksf2013=switch,false,true,tag = iTunes-ddgksf2013, desc = 是否启用ddgksf2013的脚本来解锁iTunes系列
iTunes-Guding88=switch,false,true,tag = iTunes-Guding88, desc = 是否启用Guding88的脚本来解锁iTunes系列

[Script]
response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/iTunes/chxm1023_iTunes.js") with enable=${iTunes-chxm1023}, tag="[iTunes]会员Crack@chxm1023", requires_body=true

response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/iTunes/loon_iTunes-ddgksf2013.js") with enable=${iTunes-ddgksf2013}, tag="[iTunes]会员Crack@ddgksf2013", requires_body=true

response if ${url} ~= /^https?:\/\/buy\.itunes\.apple\.com\/verifyReceipt$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/iTunes/Guding88_APPheji_iTunes.js") with enable=${iTunes-Guding88}, tag="[iTunes]会员Crack@Guding88", requires_body=true

[MITM]
hostname = buy.itunes.apple.com

