#!name=百度地图
#!desc=过滤百度地图广告
#!author=ddgksf2013[https://github.com/ddgksf2013]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id452186370
#!tag=去广告
#!loon_version=3.3.7(921)
#!homepage=https://loonlab.103516.xyz/
#!date=2025-12-30 10:00

[Rewrite]
response if ${url} ~= /^https?:\/\/.*map\.baidu\.com\/.*govui\/rich_content/i then response.json.jq(".data.posts.content=[]")
response if ${url} ~= /^https?:\/\/httpdns\.baidubce\.com/i then response.json.jq(".data[\"newclient.map.baidu.com\"]={}")
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/usercenter\/mine\/page/i then response.json.jq("del(.data.sport_card, .data.gold, .data.gold_coin_card, .data.shop)")
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/living\/nearby\/hot-words\?/i then response.json.jq(".Result.data=[]")
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/client\/phpui.*qt=hw/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/client\/crossmarketing/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/client\/usersystem\/home\/dynamic/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com\/contributor-bus\/bounty\/tips/i then reject(200, " ")

[MITM]
hostname = 180.76.76.200, newclient.map.baidu.com, httpdns.baidubce.com, ugc.map.baidu.com

