#!name=YouTube
#!desc=移除YouTube应用广告、启用后台播放，并翻译现有字幕轨道（目标语言为zh-CN或en-US；没有字幕的视频无法翻译）。默认仅记录媒体响应头；完整采样可能增加延迟。\n该插件基于devchristian1337的YouTube插件汉化。
#!author=devchristian1337[https://github.com/devchristian1337]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id544007664
#!tag=去广告, 功能增强
#!system_version=15
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-10 16:00

[Argument]
background_playback=switch,true,false,tag = 后台播放, desc = 切换应用或锁定屏幕后，保持普通视频继续播放音频。直播和受限内容仍由YouTube自身决定是否允许后台播放。
playback_region=select,"original",tag = 播放请求地区, desc = original表示保持当前地区。仅修改客户端gl参数，不改变出口IP。是否有助于拦截广告仍需验证。
translation_enabled=switch,true,false,tag = 字幕翻译, desc = 将现有字幕翻译为所选目标语言。关闭时保留原始字幕请求。
translation_target=select,"zh-CN",tag = 字幕目标语言, desc = 仅转换现有字幕轨道，支持简体中文zh-CN或美式英语en-US。没有字幕的视频无法翻译。不会修改音轨、标题和视频简介。
hide_home_shorts=switch,true,false,tag = 隐藏首页 Shorts, desc = 移除首页信息流中的Shorts推荐栏。底部Shorts标签和其他页面不受影响。
blocked_channels=input,"",tag = 屏蔽频道, desc = 频道ID、@用户名或完整频道名称，多个条目用空格分隔。建议优先使用频道ID；频道名称包含空格时请使用用户名或ID。留空则禁用。仅隐藏能够识别出所属频道的视频。
blocked_channels_url=input,"",tag = 远程屏蔽频道列表, desc = 公开的HTTPS纯文本直链（例如GitHub Raw）。本地缓存每小时刷新一次，也可以手动运行更新脚本。远程列表与手动列表合并。留空则禁用。
log_enabled=switch,false,true,tag = 日志工具, desc = 首次匹配到请求时自动启动，并通知日志入口。关闭后，下一次API请求会清除日志并停止采样；如需保留记录，请先下载。完整采样可能增加延迟。
quality_research=switch,false,true,tag = 画质研究采样, desc = 仅在日志工具开启时生效。记录可识别的画质与格式参数，并读取较小的媒体POST请求以供比较。不会自动切换画质。
media_capture_mode=select,"headers",tag = 媒体采样模式, desc = 仅在日志工具开启时生效；关闭日志时会自动停用。headers仅记录响应头；full读取完整响应内容用于开发调试，可能增加延迟。
log_level=select,"info",tag = 日志级别, desc = info保留完整的脱敏跟踪记录；debug保留调试信息；warn保留警告和错误；error仅保留错误。
capture_budget=select,"32",tag = 日志容量（MB）, desc = 达到容量上限后停止录制，并保留已有采样记录。导出后可清理。

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.header['User-Agent']} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then reject_video(200)
response if ${url} ~= /^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\//i then response.header.set("Alt-Svc", "clear")

[Script]
cron "0 * * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${blocked_channels_url}}) with tag="YouTube 定时更新屏蔽频道列表", timeout=10

generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${blocked_channels_url}}) with tag="YouTube 手动更新屏蔽频道", img_url="person.crop.circle.badge.xmark.system", timeout=10

request if ${url} ~= /^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${translation_enabled}, ${translation_target}}) with enable=${translation_enabled}, tag="YouTube 字幕目标语言", timeout=10

request if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${log_enabled} == true && ${quality_research} == true then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${quality_research}}) with tag="YouTube 画质研究请求采样", timeout=10, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${media_capture_mode}, ${quality_research}}) with enable=${log_enabled}, tag="YouTube 日志与导出", timeout=10

response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i && ${log_enabled} == true && ${media_capture_mode} == "full" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${media_capture_mode}}) with tag="YouTube 完整媒体开发采样", timeout=30, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with enable=${log_enabled}, tag="YouTube 媒体响应日志", timeout=10

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with tag="YouTube Onesie 配置缓存", timeout=10, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${playback_region}}) with tag="YouTube 播放请求与广告配置处理", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${hide_home_shorts}, ${blocked_channels}, ${blocked_channels_url}}) with tag="YouTube 信息流广告与首页 Shorts 处理", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/YouTube_CN/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${quality_research}}) with tag="YouTube 播放响应与后台播放", timeout=10, requires_body=true, binary_body_mode=true

[MITM]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com

