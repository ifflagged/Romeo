#!name=迅雷
#!desc=过滤迅雷广告，解锁部分会员功能。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], Marol62926[https://github.com/Marol62926]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id1503466530
#!tag=去广告, 解锁会员
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Rewrite]
response if ${url} ~= /^https:\/\/conf-m-ssl\.xunlei\.com\/external\//i then response.json.delete(["values.me_config.entrance_list_vertical_enable", "values.me_config.common_service_list", "values.me_config.banner_service_list"])
response if ${url} ~= /^https:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v1\/slots:batchGet$/i then response.json.jq(".slots |= map(select(.id == \"xl_ios_mytab_vipicon\" or (.native.assets.title.text.value? and (.native.assets.title.text.value | . == \"清理助手\" or . == \"云盘容量\" or . == \"远程设备\"))))")

[Script]
response if ${url} ~= /^https:\/\/xluser-ssl\.xunlei\.com\/xluser\.core\.login\/v3\/getuserinfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/ThunderCloudDisk/Marol62926_xunlei.js") with tag="[迅雷云盘]解锁会员", requires_body=true

[MITM]
hostname = conf-m-ssl.xunlei.com, api-shoulei-ssl.xunlei.com, xluser-ssl.xunlei.com

