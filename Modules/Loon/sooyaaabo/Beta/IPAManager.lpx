#!name=IPA Manager
#!desc=下载IPA文件实现降级应用安装、已购下架应用安装。\n本插件依赖Scripting App且需解锁Pro权限。
#!author=githubdulong[https://github.com/githubdulong]
#!icon=icon not found
#!tag=sooyaaabo
#!openUrl=https://apps.apple.com/app/id6479691128
#!tag=功能增强
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00

[Script]
request if ${url} ~= /^https:\/\/apple-api\.com/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/IPAManager/loon_AppleStoreAPI.js") with tag="[IPA Manager]应用接口", requires_body=true

request if ${url} ~= /^https:\/\/xiaobai\.app/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/IPAManager/loon_InstallApp.js") with tag="[IPA Manager]应用安装"

[MITM]
hostname = apple-api.com, xiaobai.app

