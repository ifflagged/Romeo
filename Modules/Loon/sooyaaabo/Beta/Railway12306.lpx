[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Script]
request if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Railway12306/kokoryh_12306.js") with tag="[铁路12306]移除开屏广告", requires_body=true

request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Railway12306/kokoryh_12306.js") with tag="[铁路12306]移除应用内广告"

[MITM]
hostname = ad.12306.cn, mobile.12306.cn

