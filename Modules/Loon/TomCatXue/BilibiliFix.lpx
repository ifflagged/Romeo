#!name=哔哩哔哩 𝕏
#!desc=哔哩哔哩增强版：包含SponsorBlock空降助手、新版gRPC卡片分区与多级子分类优化(含港澳台及快捷访问)、扫码登录原生签名修复、新版多Tab分类收藏升级、1080P高码率画质解锁、大会员凭证解锁。
#!author=TomCatXue
#!icon=icon not found
#!tag=Jacob
#!openUrl=https://apps.apple.com/app/id736536022
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=去广告,空降助手,画质解锁,Bilibili
#!version=2.8.2
#!date=2026-09-19 14:00

[Argument]
quality=switch,"false","true",tag = [画质] 解锁1080P高码率/4K, desc = 开启后非大会员也可直接选择并切换1080P高码率、1080P60、杜比视界等画质
sponsorBlock=switch,"false","true",tag = [空降助手] 跳过视频内插播广告, desc = 自动跳过视频内的赞助插播、片头、片尾等片段
displayUpList=select, "auto", "show", "hide",tag = [动态] 最常访问显示方式, desc = auto: 仅当列表中存在直播状态时显示; show: 始终显示; hide: 始终隐藏;
purifyComment=switch,"false","true",tag = [评论区] 过滤置顶广告, desc = 过滤评论区置顶广告及引流链接
optimizeRequest=switch,"false","true",tag = [评论区] 优化加载速度, desc = 优化评论区请求
VIP=switch,"false","true",tag = [会员] 凭证注入解锁, desc = 注入第三方大会员 Authorization 凭证以解锁大会员专属番剧(开启前请在下方填入凭证)
Authorization=input, "",tag = 会员凭证 Authorization, desc = 填入抓包获取的 authorization 凭证(仅开启[会员]时需填)
UserAgent=input, "",tag = 会员凭证 UserAgent, desc = 填入抓包获取的 user-agent 凭证(选填)
logLevel=select, "error", "warn", "info", "debug", "off",tag = 日志等级, desc = 选择日志输出等级

[Rule]
# 空降助手服务器 (必须走代理以防连接超时)
DOMAIN,bsbsb.top,PROXY
# 阻止B站备用域名访问
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.live.bilibili.com, passport.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com

