#!name=呆呆面板 · 凭据捕获与自动同步
#!desc=聚合微信读书、中国移动、扫描全能王、中国电信凭据静默捕获。各应用配备独立开关，凭据发生变化时就地推送到呆呆面板环境变量，零机械定时。
#!author=TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=签到, Cookie, 凭据捕获, 呆呆面板, Dumb-Panel
#!version=1.0.4
#!date=2026-10-22 18:30

[Argument]
weread=switch,true,false,tag=微信读书, desc=打开微信读书 App 进「我」或「翻牌/限免」自动触发抓取并就地同步至呆呆面板 WEREAD_AUTH
cmcc_mark=switch,true,false,tag=中国移动, desc=在中国移动 App 打开「每日签到」活动页触发，自动抓取长期 app_token 并就地同步至呆呆面板 CMCC_AUTH
camscanner=switch,true,false,tag=扫描全能王, desc=打开扫描全能王 App 进个人中心触发静默抓取并就地同步至呆呆面板 camscanner_data
telecom=switch,true,false,tag=中国电信, desc=打开电信营业厅或小程序，自动捕获 5G会员 SessionKey、等级权益 sign 与活动福利凭据

[Script]
request if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify|login)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_weread_cookie.js") with enable=${weread}, tag="微信读书·凭据捕获", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"

response if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_weread_cookie.js") with enable=${weread}, tag="微信读书·登录回填", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"

request if ${url} ~= /^https?:\/\/(wx\.10086\.cn\/(qwhdsso\/appTokenLogin|qwhdhub\/api\/mark\/)|dev\.coc\.10086\.cn\/(coc3\/|gr\/login\/)|sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_cmcc_cookie.js") with enable=${cmcc_mark}, tag="中国移动·凭据捕获", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png"

response if ${url} ~= /^https?:\/\/(wx\.10086\.cn\/qwhdhub\/(qwhdmark|qwhdsso)\/|sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/(tokenLogin\/login|qinCoin\/))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_cmcc_cookie.js") with enable=${cmcc_mark}, tag="中国移动·会话回填", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png"

request if ${url} ~= /^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_camscanner.cookie.js") with enable=${camscanner}, tag="扫描全能王·凭据捕获", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png"

request if ${url} ~= /^https?:\/\/(cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json|mapi-h5\.bestpay\.com\.cn\/gapi\/handyservice\/miniprogram\/checkParam|spanner\.bestpay\.com\.cn:10081|(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)|wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_telecom_cookie.js") with enable=${telecom}, tag="中国电信·凭据捕获", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"

response if ${url} ~= /^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/DaiDaiPanel/TomCatXue_telecom_cookie.js") with enable=${telecom}, tag="中国电信·会话回填", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"

[MITM]
hostname = weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn, api-cs.intsig.net, wx.10086.cn, qwhdcdn.cmcc-cs.cn, dev.coc.10086.cn, sn.clientaccess.10086.cn

