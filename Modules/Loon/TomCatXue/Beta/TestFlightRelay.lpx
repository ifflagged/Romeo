#!tag=TestFlight

[Script]
request if ${url} ~= /^http:\/\/tf-relay\.test(?::8799)?\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TestFlightRelay/ScriptingApp_TestFlight-Relay.js") with tag="TestFlight-Relay", timeout=30, requires_body=true, binary_body_mode=false, img_url="https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/b3/ed/fb/b3edfb91-3ac2-080e-f4a1-49b5f93c7f31/AppIcon-0-1x_U007epad-0-1-0-P3-85-220-0.png/512x512bb.jpg"

cron "0 */5 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TestFlightRelay/ScriptingApp_TestFlight-Relay.js") with tag="TestFlight-Relay-Refresh", timeout=300, img_url="https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/b3/ed/fb/b3edfb91-3ac2-080e-f4a1-49b5f93c7f31/AppIcon-0-1x_U007epad-0-1-0-P3-85-220-0.png/512x512bb.jpg"

