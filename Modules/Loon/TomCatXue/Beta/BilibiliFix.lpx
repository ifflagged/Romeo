#!name=哔哩哔哩 𝕏
#!desc=哔哩哔哩增强版：包含SponsorBlock空降助手、新版gRPC卡片分区与多级子分类优化(含港澳台及快捷访问)、扫码登录原生签名修复、新版多Tab分类收藏升级、1080P高码率画质解锁、大会员凭证解锁。
#!author=TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!openUrl=https://apps.apple.com/app/id736536022
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=去广告,空降助手,画质解锁,Bilibili
#!version=2.8.2
#!date=2026-09-19 14:00

[Argument]
sponsorBlock=switch,true,false,tag = [空降助手] 跳过视频内插播广告, desc = 自动跳过视频内的赞助插播、片头、片尾等片段
displayUpList=select,"auto",tag = [动态] 最常访问显示方式, desc = auto: 仅当列表中存在直播状态时显示; show: 始终显示; hide: 始终隐藏;
purifyComment=switch,true,false,tag = [评论区] 过滤置顶广告, desc = 过滤评论区置顶广告及引流链接
optimizeRequest=switch,true,false,tag = [评论区] 优化加载速度, desc = 优化评论区请求
VIP=switch,false,true,tag = [会员] 凭证注入解锁, desc = 注入第三方大会员 Authorization 凭证以解锁大会员专属番剧(开启前请在下方填入凭证)
Authorization=input,"",tag = 会员凭证 Authorization, desc = 填入抓包获取的 authorization 凭证(仅开启[会员]时需填)
UserAgent=input,"",tag = 会员凭证 UserAgent, desc = 填入抓包获取的 user-agent 凭证(选填)
logLevel=select,"error",tag = 日志等级, desc = 选择日志输出等级

[Rule]
DOMAIN,bsbsb.top,PROXY
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?/i then response.json.jq(".data.domains=[\"wss://tracker.chat.bilibili.com\"]")
request if ${url} ~= /^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.body.mock("text", "{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":31536000,\"pull_interval\":31536000,\"keep_ids\":[],\"show\":[],\"list\":[{}],\"splash_request_id\":\"\"}}", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?/i then response.json.jq(".data |= with_entries(if .key | IN(\"show\", \"event_list\") then .value = [] else . end)")
response if ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?/i then response.body.mock("text", "{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}", 200)
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/topic\/getlist\?/i then response.body.mock("text", "{\"code\":0,\"message\":\"0\",\"ttl\":1,\"data\":{\"list\":[],\"total\":0}}", 200)
request if ${url} ~= /^https:\/\/www\.bilibili\.com\/h5\/mooc/i then redirect(302, "https://m.bilibili.com/cheese/home?navhide=1")
request if ${url} ~= /^https:\/\/www\.bilibili\.com\/h5\/musicplus/i then redirect(302, "https://www.bilibili.com/v/popular/rank/music")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/i then response.body.mock("text", "{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}", 200)
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/i then response.json.jq("del(.data.payment)")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?/i then response.json.jq(".data.modules |= map(select(.type != \"TIP\") | if .type == \"BANNER\" then .module_data.items |= map(select(.url | startswith(\"https://www.bilibili.com/blackboard/era/\") | not)) else . end)")
request if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?(.*)&mobi_app=iphone&(.*)$/i as urlMatch then url.replace("https://api.bilibili.com/pgc/page/channel?${urlMatch.1}&mobi_app=iphone_i&${urlMatch.2}")
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$/i then response.body.mock("text", "AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA", 200, true)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/i then response.body.mock("text", "AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=", 200, true)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.body.mock("text", "AAAAAAA=", 200, true)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.header.add("grpc-status", "0")
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.show\.v1\.(Mixture\/(RegionIndex|RegionList)|Rank\/RankRegionList)$/i then response.header.add("grpc-status", "0")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?/i then response.json.jq(".data[][]?=\"stun.chat.bilibili.com:3478\"")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then response.json.delete("data.common_equip")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq("if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == \"av\") and (.card_type | IN(\"small_cover_v2\", \"large_cover_single_v9\", \"large_cover_v1\")))) end")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq("if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN(\"vertical_ad_av\", \"vertical_ad_live\", \"vertical_ad_picture\") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(?:\/ipad)?\?/i then response.json.jq("if .data.sections_v2 then .data.sections_v2 |= map(.items |= map(if .title == \"我的收藏\" or .id == 496 or .id == 3072 then .uri = \"bilibili://user_center/favourite?version=2\" else . end)) end | if .data.ipad_sections then .data.ipad_sections |= map(if .title == \"我的收藏\" or .id == 749 then .uri = \"bilibili://user_center/favourite?version=2\" else . end) end")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?/i then response.json.jq(".data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end")

[Script]
response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_region.js") with tag="[哔哩哔哩]首页分区入口重定向", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_region.js") with tag="[哔哩哔哩]全部分区优化(gRPC)", timeout=10, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_region.js") with tag="[哔哩哔哩]快捷分区保存", timeout=10

request if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(channel\/region\/list|region\/index)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_region.js") with tag="[哔哩哔哩]分区列表修复(HTTP)", timeout=10, requires_body=true

request if ${url} ~= /^https?:\/\/(?:app|api)\.bilibili\.com\/x\/(?:v2\/account\/mine|v2\/account\/myinfo|member\/app\/nickfree|resource\/show\/tab)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_qrcode.js") with tag="[哔哩哔哩]凭证捕获"

request if ${url} ~= /^https:\/\/passport\.bilibili\.com\/x\/passport-login\/web\/qrcode\/(check|confirm|scene)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_qrcode.js") with tag="[哔哩哔哩]扫码登录修复", timeout=10, requires_body=true

request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/kokoryh_bilibili.protobuf.request.js", {${logLevel}}) with enable=${sponsorBlock}, tag="[哔哩哔哩]空降助手", timeout=10, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/kokoryh_bilibili.protobuf.request.js", {${purifyComment}, ${logLevel}}) with enable=${optimizeRequest}, tag="[哔哩哔哩]ProtoBuf Request", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/kokoryh_bilibili.protobuf.response.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="[哔哩哔哩]ProtoBuf Response", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/kokoryh_bilibili.json.js") with tag="[哔哩哔哩]移除直播间广告", requires_body=true

request if ${url} ~= /^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/(?:bilibili\.app\.(?:playerunite\.v1\.Player\/PlayViewUnite|playurl\.v1\.PlayURL\/PlayView)|bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/BilibiliFix/TomCatXue_bilibili_vip.js", {${Authorization}, ${UserAgent}}) with enable=${VIP}, tag="[哔哩哔哩]大会员凭证注入", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.live.bilibili.com, passport.bilibili.com, line3-h5-mobile-api.biligame.com, www.bilibili.com

