#!name=移动爱家 · 全方位净化与纯净增强
#!desc=彻底净化移动爱家首页轮播、智能专区右上角广告与画布轮播大图/悬浮弹窗、发现页短视频/资讯文章流，以及我的钱包充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流。
#!author=TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!openUrl=https://apps.apple.com/app/id1147452377
#!tag=去广告, 移动爱家, 中国移动, 轮播净化
#!system=iOS,iPadOS
#!loon_version=3.5.2(1005)
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!version=1.1.3
#!date=2026-10-23 22:30

[Argument]
HideCarousel=switch,true,false,tag=[轮播] 彻底移除轮播图, desc=移除首页与各专区横幅轮播图组件，使其彻底消失而非仅阻断跳转
HomeClean=switch,true,false,tag=[首页] 首页基础净化, desc=清理首页横幅轮播、XBYYW运营位广告、等级条营销与瀑布流
SmartPageClean=switch,true,false,tag=[智能] 移动爱家智能专区净化, desc=清理移动爱家/智能专区右上角广告、轮播大图、悬浮窗动效与营销触点弹窗
DiscoverClean=switch,true,false,tag=[发现] 发现页短视频与文章净化, desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
WalletClean=switch,true,false,tag=[钱包] 充话费与钱包净化, desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流

[Rule]
DOMAIN-SUFFIX,cmicapm.com,REJECT
DOMAIN-SUFFIX,dc.cmicapm.com,REJECT
DOMAIN-SUFFIX,uba.cmft.com.cn,REJECT
DOMAIN-SUFFIX,yxfk.market.chinamobile.com,REJECT
DOMAIN-SUFFIX,uem.migu.cn,REJECT
DOMAIN-SUFFIX,da.mmarket.com,REJECT
DOMAIN-SUFFIX,dfp.cmft.com.cn,REJECT
DOMAIN-SUFFIX,mtm.online-cmcc.cn,REJECT
DOMAIN-SUFFIX,trace.hjq.komect.com,REJECT
DOMAIN-SUFFIX,event.video.komect.com,REJECT
DOMAIN-SUFFIX,aishop.vis.komect.com,REJECT
DOMAIN-SUFFIX,ggc.cmvideo.cn,REJECT
DOMAIN-SUFFIX,adxserver.ad.cmvideo.cn,REJECT
DOMAIN-SUFFIX,ggadjust.cmvideo.cn,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/(?:goods\/(?:price\/reduction\/bubble|recommend\/light))(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:ulogs\.umeng\.com|ulogs\.umengcloud\.com|msg\.umengcloud\.com)\/admsg\/v2\/launch(?:\?.*)?$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/p\.10086\.cn\/wap\/v1\/(?:polymeriza-page\/(?:banner|popup|activity|business|group-cards|marquee)|float\/window|guess\/shop)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${WalletClean}, ${HideCarousel}}) with tag="[移动爱家]和包充话费营销净化", requires_body=true

request if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${WalletClean}, ${HideCarousel}}) with tag="[移动爱家]防304缓存穿透", timeout=5

response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${DiscoverClean}, ${HideCarousel}}) with tag="[移动爱家]发现页视频与文章净化", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${SmartPageClean}, ${HideCarousel}}) with tag="[移动爱家]智能专区与爱家画布净化", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/layout\/index\/(?:content|frame)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${HomeClean}, ${HideCarousel}}) with tag="[移动爱家]商城楼层净化", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/(?:(?:base|keel)\/)?idx\/(?:getBannerContentList|getTabBannerList)(?:[\/?].*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${HideCarousel}, ${HomeClean}}) with tag="[移动爱家]和家亲首页Banner与楼层净化", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/hjq-prov\/api\/provApply\/homepage\/getBannerList(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${HideCarousel}, ${HomeClean}}) with tag="[移动爱家]和家亲设备与省份Banner净化", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/(?:base\/)?scene\/(?:getRuleTemplates|getRecommendRules)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js", {${SmartPageClean}, ${HideCarousel}}) with tag="[移动爱家]智能专区场景轮播净化", timeout=10, requires_body=true

[MITM]
hostname = p.10086.cn, shop.hjq.komect.com, base.hjq.komect.com, display-sc.miguvideo.com, res.coc.10086.cn, ulogs.umeng.com, ulogs.umengcloud.com, msg.umengcloud.com

