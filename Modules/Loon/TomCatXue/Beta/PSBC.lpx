[Rewrite]
request if ${url} ~= /^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/getStartUpAdvPicture/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/qryShakeInfo/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/static\.mobile-bank\.psbc\.com\/static\/index\/advertise\//i then reject(200)

[MITM]
hostname = login-service.mobile-bank.psbc.com, static.mobile-bank.psbc.com

