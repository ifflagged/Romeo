#!name=中国移动 · 净屏与功能增强
#!desc=彻底净化启动页、首页轮播、各专区横幅推广与「我的」弹窗，底层物理级彻底移除轮播图组件；标准插件格式。
#!author=Yuheng0101, anker1209, ccyykk666, sooyaaabo; 轮播净化 TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!openUrl=https://apps.apple.com/app/id583700738
#!tag=去广告, 中国移动, 轮播净化
#!system=iOS,iPadOS
#!loon_version=3.5.2(1005)
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!version=1.0.9
#!date=2026-10-24 13:13

[Argument]
HideCarousel=switch,true,false,tag=[轮播] 彻底移除轮播图, desc=移除首页与各专区横幅轮播图组件及四大落地推广（办宽带/智盒/摄像头/融合套餐），使其彻底消失而非仅阻断跳转
HomeBasicClean=switch,true,false,tag=[首页] 基础净化, desc=清理首页瀑布流、推荐位与活动广告
ServicePageClean=switch,true,false,tag=[专区] 专区横幅净化, desc=清理话费/余量等业务专区横幅推广
WalletClean=switch,true,false,tag=[钱包] 充话费与钱包净化, desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流
DiscoverClean=switch,true,false,tag=[发现] 发现页短视频与文章净化, desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
HideTopFamily=switch,false,true,tag=[首页] 隐藏-爱家, desc=隐藏首页顶部 Tab「爱家」
HideTopAge=switch,false,true,tag=[首页] 隐藏-网龄, desc=隐藏首页顶部 Tab「网龄」
HideTopPhone=switch,false,true,tag=[首页] 隐藏-手机, desc=隐藏首页顶部 Tab「手机」
HideTopNearby=switch,false,true,tag=[首页] 隐藏-附近厅, desc=隐藏首页顶部 Tab「附近厅」
HideTopAI=switch,false,true,tag=[首页] 隐藏-AI尝鲜, desc=隐藏首页顶部 Tab「AI 尝鲜」
HideTopEnterprise=switch,false,true,tag=[首页] 隐藏-政企, desc=隐藏首页顶部 Tab「政企」
HideMyHeaderEntry=switch,false,true,tag=[我的] 隐藏-标题栏服务入口, desc=隐藏「我的」标题栏服务入口（areaId 20230720006）
HideMyCheckIn=switch,false,true,tag=[我的] 隐藏-签到浮窗, desc=隐藏「我的」签到浮窗（areaId 20230721008）
HideMyServices=switch,false,true,tag=[我的] 隐藏-我的服务, desc=隐藏「我的」我的服务卡片（areaId 20230721018 / 20260104006）
HideMyFamilyCube=switch,false,true,tag=[我的] 隐藏-我的家庭, desc=隐藏「我的」我的家庭卡片（areaId 20240708002 / 20240429006）
HideMyDevicesCube=switch,false,true,tag=[我的] 隐藏-我的设备, desc=隐藏「我的」我的设备卡片（areaId 20251024002 / 20251016004）
HideMyMiniProgram=switch,false,true,tag=[我的] 隐藏-我的账户, desc=隐藏「我的」我的账户（areaId 20231017002）
HideMyDigitalHuman=switch,false,true,tag=[我的] 隐藏-AI智能助理, desc=隐藏「我的」AI 智能助理（areaId 20230721020）
HideMySelections=switch,false,true,tag=[我的] 隐藏-我的优选, desc=隐藏「我的」我的优选（areaId 20230721030）
HideMyGroup=switch,false,true,tag=[我的] 隐藏-我的集团, desc=隐藏「我的」我的集团（areaId 20230721036）
HideMyRingtone=switch,false,true,tag=[我的] 隐藏-我的彩铃, desc=隐藏「我的」我的彩铃（areaId 20251230002）
HideMyCloudDrive=switch,false,true,tag=[我的] 隐藏-我的云盘, desc=隐藏「我的」我的云盘（areaId 20240624002）
HideMyToolbox=switch,false,true,tag=[我的] 隐藏-百宝箱, desc=隐藏「我的」百宝箱（areaId 20230721044）
HideMyLifeServices=switch,false,true,tag=[我的] 隐藏-生活服务, desc=隐藏「我的」生活服务（areaId 20230928004 / 20240528002）
HideMyVideo=switch,false,true,tag=[我的] 隐藏-我的视频, desc=隐藏「我的」我的视频（areaId 20260423002）
HideMyExclusiveServices=switch,false,true,tag=[我的] 隐藏-我的专属服务, desc=隐藏「我的」我的专属服务（areaId 20260508004）
HideMyNewCall=switch,false,true,tag=[我的] 隐藏-新通话, desc=隐藏「我的」新通话卡片（areaId 20260610004）

[Rule]
DOMAIN-SUFFIX,cmicapm.com,REJECT
DOMAIN-SUFFIX,dc.cmicapm.com,REJECT
DOMAIN-SUFFIX,jiguang.coc.10086.cn,REJECT
DOMAIN-SUFFIX,uba.cmft.com.cn,REJECT
DOMAIN-SUFFIX,yxfk.market.chinamobile.com,REJECT
DOMAIN-SUFFIX,uem.migu.cn,REJECT
DOMAIN-SUFFIX,da.mmarket.com,REJECT
DOMAIN-SUFFIX,dfp.cmft.com.cn,REJECT
DOMAIN-SUFFIX,mtm.online-cmcc.cn,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,bytegoofy.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/(?:DN|DA)\/(?:explorePage\/.*|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdver.*|homepagePopup\/getSortInfo|homePage\/getPopupInfo|toast\/.*|detainment\/.*)|DH\/(?:toast\/.*|detainment\/.*|facePopup\/.*|livePopup\/.*)|DA\/liveSuspension\/getPageCode)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/cms\/(?:advertisePosition|advertisePage|globalIcon)(?:\?.*)?$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo|titleBar\/getIcon)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${HideCarousel}, ${HomeBasicClean}, ${ServicePageClean}, ${WalletClean}, ${DiscoverClean}, ${HideTopFamily}, ${HideTopAge}, ${HideTopPhone}, ${HideTopNearby}, ${HideTopAI}, ${HideTopEnterprise}, ${HideMyHeaderEntry}, ${HideMyCheckIn}, ${HideMyServices}, ${HideMyFamilyCube}, ${HideMyDevicesCube}, ${HideMyMiniProgram}, ${HideMyDigitalHuman}, ${HideMySelections}, ${HideMyGroup}, ${HideMyRingtone}, ${HideMyCloudDrive}, ${HideMyToolbox}, ${HideMyLifeServices}, ${HideMyVideo}, ${HideMyExclusiveServices}, ${HideMyNewCall}}) with tag="[中国移动]页面与轮播净化", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${HideCarousel}}) with tag="[中国移动]消息与卡券横幅净化", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${HideCarousel}}) with tag="[中国移动]横幅看板净化", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/(?:cms\/(?:contents|yourFavorite)|hePay\/all)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${WalletClean}, ${HideCarousel}}) with tag="[中国移动]我的钱包与充话费净化", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${DiscoverClean}, ${HideCarousel}}) with tag="[中国移动]发现页视频与文章净化", timeout=10, requires_body=true

response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js", {${HideCarousel}}) with tag="[中国移动]智能专区与爱家画布净化", timeout=10, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, ad.mcloud.139.com, app.jf.10086.cn, display-sc.miguvideo.com, res.coc.10086.cn

