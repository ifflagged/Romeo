#!name=Telegram增强
#!desc=将Telegram的垃圾IP转移到优质IP上减少转圈加载；全量高精度拦截外部 t.me / telegram.me / telegram.dog 链接，支持直接唤醒跳转至官方或任意第三方客户端（消息贴文、群组频道邀请、Bot、MiniApp、代理、贴纸全兼容）。
#!author=chaoscard (原作), sooyaaabo, Repcz / TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!openUrl=https://apps.apple.com/app/id686449807
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=Telegram,功能增强,分流优化
#!version=1.1.0
#!date=2026-11-01 13:10

[Argument]
t.me_redirect=select,"Telegram",tag=跳转至对应客户端, desc=选择点击t.me链接时唤起的目标客户端

[Rule]
DOMAIN-SUFFIX,nagram.app,PROXY
DOMAIN-SUFFIX,swiftgram.app,PROXY
DOMAIN-SUFFIX,iturrit.com,PROXY
DOMAIN-SUFFIX,imem.app,PROXY
DOMAIN-SUFFIX,nicegram.app,PROXY
DOMAIN-SUFFIX,nicegram.cloud,PROXY
DOMAIN-SUFFIX,intentchat.app,PROXY

[Script]
request if ${url} ~= /^https?:\/\/(t\.me|telegram\.(?:me|dog))\/.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Telegram/TomCatXue_t.me_redirect.js", {${t.me_redirect}}) with tag="[Telegram]链接重定向", timeout=10

[MITM]
hostname = t.me, telegram.me, telegram.dog

