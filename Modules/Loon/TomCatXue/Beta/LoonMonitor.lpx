#!name=LoonMonitor · 小组件数据提供与状态服务
#!desc=专为 iOS 哑巴面板 (MutePanel) 小组件打造的 Loon 本地监控数据服务。实时提供当前运行模式、策略组数量、活跃节点、VPN 出口 IP/归属地、延迟与订阅流量统计。
#!author=TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=Loon, 监控, 小组件, VPN
#!version=1.4.6
#!date=2026-10-13 16:00

[Rule]
DOMAIN,loon.box,DIRECT
DOMAIN,api.loon.box,DIRECT
DOMAIN,loon.local,DIRECT
IP-CIDR,198.18.0.1/32,DIRECT,no-resolve
DOMAIN-KEYWORD,subscribe,DIRECT
DOMAIN-KEYWORD,sub,DIRECT
DOMAIN-SUFFIX,jsdelivr.net,PROXY
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,ip.sb,PROXY

[Host]
loon.box = 198.18.0.1
api.loon.box = 198.18.0.1
loon.local = 198.18.0.1

[Script]
request if ${url} ~= /^https?:\/\/(?:(?:api\.)?loon\.(?:box|local)|198\.18\.0\.1)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js") with tag="Loon监控·小组件数据服务", timeout=10, requires_body=true

response if ${url} ~= /\/(subscription|subscribe)|[?&]token=/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js") with tag="Loon监控·订阅流量捕获", timeout=10

cron "0 */2 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/fastly_loon_monitor.js") with tag="Loon监控·定时同步", timeout=20

[MITM]
hostname = loon.box, *.loon.box, api.loon.box, loon.local, *.loon.local

