#!name=LoonMonitor · 小组件数据提供与状态服务
#!desc=专为 iOS 哑巴面板 (MutePanel) 小组件提供 Loon 运行状态。机场订阅流量由小组件直接请求用户填写的订阅链接，本插件只返回运行模式、策略组数量、活跃节点、出口 IP、归属地与延迟。
#!author=TomCatXue
#!icon=icon not found
#!tag=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=Loon, 监控, 小组件, VPN
#!version=1.5.0
#!date=2026-10-18 11:10

[Rule]
DOMAIN,loon.box,DIRECT
DOMAIN,api.loon.box,DIRECT
DOMAIN,loon.local,DIRECT
IP-CIDR,198.18.0.1/32,DIRECT,no-resolve
DOMAIN-SUFFIX,jsdelivr.net,PROXY
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,ip.sb,PROXY

[Host]
loon.box = 198.18.0.1
api.loon.box = 198.18.0.1
loon.local = 198.18.0.1

[Script]
request if ${url} ~= /^https?:\/\/(?:(?:api\.)?loon\.(?:box|local)|198\.18\.0\.1)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/TomCatXue_loon_monitor.js") with requires_body=true, timeout=10, tag="Loon监控·小组件数据服务"

cron "0 */2 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/LoonMonitor/TomCatXue_loon_monitor.js") with timeout=20, tag="Loon监控·定时同步"

[MITM]
hostname = loon.box, *.loon.box, api.loon.box, loon.local, *.loon.local

