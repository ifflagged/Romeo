#!name=多邻国 𝕏
#!desc=多邻国会员功能解锁（Gold 家庭套餐）
#!author=j4gm4g (原作) / TomCatXue (修复)
#!icon=icon not found
#!tag=TomCatXue
#!openUrl=https://apps.apple.com/app/id570060128
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!tag=多邻国,Duolingo,会员,解锁
#!version=2.0.3
#!date=2026-11-12 22:56

[Script]
response if ${url} ~= /^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/.*\/users\/.*\?fields=subscriberLevel/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.level.js") with tag="订购等级", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/.*\/users\/.*\/(?:available-features|advertisable-features).*$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.features.js") with tag="订购配置", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/\d{4}-\d{1,2}-\d{1,2}\/batch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.batch.js") with tag="订购信息", timeout=60, requires_body=true

[MITM]
hostname = ios-api-*.duolingo.*, api*.duolingo.*

