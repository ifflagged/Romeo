#!name = 多邻国 𝕏
#!desc = 多邻国会员功能解锁（Gold 家庭套餐）
#!openUrl = https://apps.apple.com/app/id570060128
#!author = j4gm4g (原作) / TomCatXue (修复)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/duolingo.webp
#!tag = 多邻国,Duolingo,会员,解锁
#!version = 2.0.3
#!date = 2026-11-12 22:56

[Script]
http-response ^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/.*\/users\/.*\?fields=subscriberLevel script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.level.js, requires-body=true, timeout=60, tag=订购等级
http-response ^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/.*\/users\/.*\/(?:available-features|advertisable-features).*$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.features.js, requires-body=true, timeout=60, tag=订购配置
http-response ^https?:\/\/(?:ios-api-[^.]+|api[^.]+)\.duolingo\.[a-z.]+\/\d{4}-\d{1,2}-\d{1,2}\/batch script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/Duolingo/TomCatXue_duolingo.batch.js, requires-body=true, timeout=60, tag=订购信息

[MITM]
hostname = ios-api-*.duolingo.*, api*.duolingo.*
