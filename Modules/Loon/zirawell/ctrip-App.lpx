#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id379395415
#!bundleId=ctrip.com
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-12-25

[Rule]
DOMAIN,sofire.baidu.com,REJECT
DOMAIN-SUFFIX,cn-shanghai.nlb.aliyuncs.com,REJECT
DOMAIN-SUFFIX,volceapplog.com,REJECT
IP-CIDR,210.13.85.204/32,REJECT,no-resolve
IP-CIDR,114.80.56.98/32,REJECT,no-resolve
IP-CIDR,162.14.145.54/32,REJECT,no-resolve
IP-CIDR,162.14.137.43/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/getTimeZoneServerIpList/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/tripAds/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/getAdsList/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/getAppConfig/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/incrQueryTrans/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/.*\/getDiscardUbts/i then reject(200)
request if ${url} ~= /^https?:\/\/m\.ctrip\.com\/html5\/webresource\/js\/iscroll\.js$/i then reject(200)
request if ${url} ~= /^https?:\/\/ma-adx\.ctrip\.com\/_ma\.gif/i then reject(200)
request if ${url} ~= /^https?:\/\/mbd\.baidu\.com\/newspage\/api\/getmobads\?page\=landingshare/i then reject(200)

[MITM]
hostname = ma-adx.ctrip.com, mbd.baidu.com

