#!name=吉祥航空 - JUNEYAOAIR
#!desc=吉祥航空-特价机票预订查询
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id639531062
#!bundleId=com.juneyaoair.distribution
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-10-21

[Rewrite]
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/(?>queryPopUpWinPic|getLoadPic|getRecommendProduct|creditCardAd) - reject
^https?:\/\/shopping\.juneyaoair\.com\/mobile\/shop\/mobile\/app response-body-replace-regex "index_pop_wap_enable":true "index_pop_wap_enable":false
# 屏蔽更新
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/version mock-response-body data-type=text status-code=200

[Script]
http-response ^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/getPictureList script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/juneyaoair/zirawell_juneyaoair.js, requires-body=true, tag=juneyaoair

[MITM]
hostname = hoapp.juneyaoair.com, m.juneyaoair.com, shopping.juneyaoair.com

