#!name=App-广告拦截合集-重写规则
#!desc=某些规则要清除缓存或者重新安装APP，拦截广告才会生效！
#!author=zirawell
#!icon=icon not found
#!tag=zirawell
#!count=支持约515个App
#!homepage=https://github.com/zirawell/R-Store
#!raw-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Rule/QuanX/Adblock/All/rewrite/appAdRewrite.conf
#!tg-group=https://t.me/RStoreCom
#!date=2026-09-25 08:11:21

[Rewrite]
^https?:\/\/(?>a|s)\.ajmide\.com\/v\d\/get_init_config response-body-json-jq 'if (.data?.loading_img? and (.data.loading_img|type=="array") and (.data.loading_img|length>0)) then (.data.loading_img=[(.data.loading_img[0] | .imgpath="https://upload-qn.ajmide.com/__splash_pixel.png")]) else . end'
^https?:\/\/(?>a|s)\.ajmide\.com\/v\d\/get_(?>search_keywords|search_home|bar_img) response-body-json-jq 'if (.data? and ((.data|has("hotImg")) or (.data|has("hotKeywords")) or (.data|has("hotPrograms")) or (.data|has("boCaiList")) or (.data|has("adInfo")))) then (del(.data.hotImg) | .data.hotKeywords=[] | .data.hotPrograms=[] | .data.boCaiList=[] | .data.adInfo=[]) elif (.data? and (.data|has("search_bar_banner"))) then del(.data.search_bar_banner) elif (.data? and (.data|has("list"))) then (.data.list=[]) else . end'
^https?:\/\/(?>a|s)\.ajmide\.com\/v\d\/index_tab response-body-json-jq 'if (.data|type=="array") then (.data = ([.data[] | select(((.tab_id|tostring)=="2") or (.tab_name=="听广播"))] | map(.position="1" | .fixed="1"))) else . end'
^https?:\/\/(?>a|s)\.ajmide\.com\/(?>v\d\/get_(?>radio_station|live_bocai)|index\.php\?r=program(%2F|\/)radio-station-top-list) response-body-json-jq 'if (.data? and (.data|type=="object") and (.data|has("radioList"))) then (.data={radioList:.data.radioList}) elif (.data? and (.data|type=="object") and (.data|has("img_path"))) then (.data.img_path="" | .data.schema="" | .data.title="" | .data.resource_id="" | .data.topicId=0) elif (.data? and (.data|type=="array")) then (.data=[]) else . end'
^https?:\/\/wrapper\.cyapi\.cn\/v\d\/activity\?.*type_id=A03 response-body-json-jq '.activities[]? |= (if .feature != null then .feature = false else . end)'
^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config response-body-json-jq 'del(.search_suggestions)?'
^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config response-body-json-jq '(.pic_page_card_orders[]?, .map_page_card_orders[]?) |= select(.name | test("^(A|C01)") | not)'
^https?:\/\/api\.charmdeer\.com\/services\/render\/app\/lux\/util\/entries response-body-json-jq '.results[] |= map(select(.extendedProp.skippable != true))'
^https?:\/\/api\.charmdeer\.com\/services\/render\/app\/lux\/feed\/home response-body-json-jq '.list = []'
^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list response-body-json-jq '.data |= map(select(.type == "DISCOVERY_EPISODE_RECOMMEND" or .type == "EDITOR_PICK"))'
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene response-body-json-jq '.data.showShopEntry=false|.data.idolTabShow=true'
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList response-body-json-jq '.data.musicList[] |= del(.showAd)'
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/resource\/recommend response-body-json-jq '.data.resourceList[] |= del(.resource)'
^https?:\/\/bd-api\.kuwo\.cn\/api\/voice\/room\/v\d\/sidebar response-body-json-jq '(.data) = {}'
^https?:\/\/oneapp-api\.faw-vw\.com\/content\/collection\/getCollectionList\/v\d\? response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: {} }'
^https?:\/\/oneapp-api\.faw-vw\.com\/search\/firstPage\/getPromptList\/v\d\? response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
^https?:\/\/oneapp-api\.faw-vw\.com\/benefits\/benefitsCard\/getInfo\/v\d\? response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v\d\?.*showPositionCode=VWAPP_HOME_BUOY response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v\d\?.*showPositionCode=VWAPP_(?>ICE|MEB)_(?>OPEN_SCREEN_ADS|CAR_ZHIHU_COLLEGE) response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v\d\?.*showPositionCode=VWAPP_(?>ICE|MEB)_HOME_(?>OWNER_BANNER|PROSPECTS_BANNER|CUSTOM_BANNER|KONGO|CUSTOM_KONGO) response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
^https?:\/\/oneapp-api\.faw-vw\.com\/content\/(?>customize\/getCustomizePageName|recommend\/getRecommendInfoFlows|activity\/getSquareActivityList|theme\/getThemeList|post\/getPostsByTags|evaluate\/getEvaluateCards)\/v\d\? response-body-json-jq '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
