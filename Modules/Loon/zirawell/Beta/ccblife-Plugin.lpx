[Script]
request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-Plugin/zirawell_ccblife.js") with tag="ccblife", requires_body=true

[MITM]
hostname = yunbusiness.ccb.com

