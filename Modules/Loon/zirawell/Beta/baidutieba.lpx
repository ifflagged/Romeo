[Rule]
IP-CIDR,180.76.76.200/32,REJECT,no-resolve
DOMAIN,afd.baidu.com,REJECT
DOMAIN,mobads.baidu.com,REJECT

[Script]
response if ${url} ~= /^https?:\/\/c\.tieba\.baidu\.com\/c\/f\/(excellent\/personalized|frs\/(?>generalTabList|page|threadlist)|pb\/(pic)?page)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/baidutieba/zirawell_tiebaJson.js") with tag="baidutieba", requires_body=true

response if ${url} ~= /^https?:\/\/c\.tieba\.baidu\.com\/c\/f\/(excellent\/personalized|frs\/(?>generalTabList|page|threadlist)|pb\/(pic)?page)\?cmd/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/baidutieba/zirawell_tiebaProto.js") with tag="baidutieba", requires_body=true

response if ${url} ~= /^https?:\/\/c\.tieba\.baidu\.com\/c\/s\/sync$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/baidutieba/zirawell_tiebaJson.js") with tag="baidutieba", requires_body=true

response if ${url} ~= /^https?:\/\/tiebac\.baidu\.com\/tiebaads\/commonbatch\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/baidutieba/zirawell_tiebaJson.js") with tag="baidutieba", requires_body=true

