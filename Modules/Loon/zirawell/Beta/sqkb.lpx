#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,log.17gwx.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/v\d\/base\/app\/ad/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/v\d\/recommend\/feed\/list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/v\d\/mentor\/testflight\/getupgradereward/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/v\d\/growth\/popup\/remind/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/v\d\/history\/remind\/listV/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/sqkb/zirawell_sqkb.js") with tag="sqkb", requires_body=true

response if ${url} ~= /^https?:\/\/api\.17gwx\.com\/operate\/elements/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/sqkb/zirawell_sqkb.js") with tag="sqkb", requires_body=true

[MITM]
hostname = api.17gwx.com

