[Rewrite]
request if ${url} ~= /^https?:\/\/tqt\.weibo\.cn\/overall\/redirect\.php\?r=(?>tqt_sdkad|tqtad)/i then reject(200)
request if ${url} ~= /^https?:\/\/tqt\.weibo\.cn\/.*advert/i then reject(200)

[MITM]
hostname = tqt.weibo.cn

