#!name=高德地图 - AMAP
#!desc=高德地图-高德打车,导航公交地铁出行
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id461703208
#!bundleId=com.autonavi.amap
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,amap-aos-info-nogw.amap.com,REJECT
DOMAIN,free-aos-cdn-image.amap.com,REJECT
DOMAIN,apiinit.amap.com,REJECT
DOMAIN,icloud-amap.com,REJECT
DOMAIN,optimus-ads.amap.com,REJECT
DOMAIN-SUFFIX,adiu.amap.com,REJECT
DOMAIN-SUFFIX,page.amap.com,REJECT
DOMAIN-KEYWORD,logs.amap.com,REJECT
DOMAIN-KEYWORD,ads.amap.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt/i then reject(200)
request if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/valueadded\//i then reject(200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?>car-end|route-plan)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search\/new_hotword\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search_poi\/tips_adv\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/oss\.amap\.com\/ws\/banner\/lists\/\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/(?>main-page-assets|main-page-location|ridewalk-end-fc)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/(mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/scene\/recommend\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/boss\/(order\/car\/king_toolbox_car_bubble|tips\/onscene_visual_optimization)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/bus\/plan\/integrate\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/c3frontend\/af-(hotel|launch)\/page\/main\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/perception\/drive\/(?>routeInfo|routePlan)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search\/(common\/coupon\/info|poi\/detail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search_poi\/(homepage|mps|search\/sp|sug|tips_operation_location)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/(?>card-service-plan-home|main-page)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv\d\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search\/nearbyrec_smart\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/boss\/(car\/order\/content_info|order_web\/friendly_information)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-App/zirawell_amap.js") with tag="amap", requires_body=true

[MITM]
hostname = amap-aos-info-nogw.amap.com, m*.amap.com, oss.amap.com, sns.amap.com

