#!name=拼多多 - PDD
#!desc=拼多多 - 多多买菜，百亿补贴
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1044283059
#!bundleId=com.xunmeng.pinduoduo
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-25

[Rule]
DOMAIN,titan.pinduoduo.com,REJECT
DOMAIN,apm.pinduoduo.com,REJECT
DOMAIN,ta-a.pinduoduo.com,REJECT
DOMAIN,ta.pinduoduo.com,REJECT
DOMAIN,th-a.pinduoduo.com,REJECT
DOMAIN,th-b.pinduoduo.com,REJECT
DOMAIN,th.pinduoduo.com,REJECT
DOMAIN,ta.yangkeduo.com,REJECT
DOMAIN,th.yangkeduo.com,REJECT
DOMAIN,meta.yangkeduo.com,REJECT
DOMAIN,meta.pinduoduo.com,REJECT
DOMAIN,m.pinduoduo.net,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash/i then reject(200)
request if ${url} ~= /^https?:\/\/mobile\.yangkeduo\.com\/layer\/app_upgrade_popup/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\//i then reject(200)
request if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/app_popup/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/flow\/hungary\/window\/global/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/search_hotquery/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/engels\/reviews\/require\/append/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/my_order_group/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/likes/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/personal/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/new_chat_group/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.yangkeduo\.com\/api\/ant\/entry\/navigate/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/barrow\/query/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/pdd_live_moore_main_lego/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/pdd/zirawell_pdd.js") with tag="pdd", requires_body=true

response if ${url} ~= /^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/\w+\/hub/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/pdd/zirawell_pdd.js") with tag="pdd", requires_body=true

[MITM]
hostname = api.pinduoduo.com, api.yangkeduo.com, mobile.yangkeduo.com

