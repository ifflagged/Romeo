#!name=支付宝小程序-广告拦截合集-重写规则
#!desc=某些规则要清除缓存或者重新安装APP，拦截广告才会生效！
#!author=zirawell
#!icon=icon not found
#!tag=zirawell
#!count=支持约7个支付宝程序
#!homepage=https://github.com/zirawell/R-Store
#!raw-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Rule/QuanX/Adblock/All/rewrite/alipayAdRewrite.conf
#!tg-group=https://t.me/RStoreCom
#!date=2026-08-17 08:45:16

[Rewrite]
request if ${url} ~= /^https?:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5-zb\.amap\.com\/ws\/boss\/end\/recommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.(popup|aristotle)\.get/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mdn\.alicdn\.com\/imgextra\/i1\/.*-tps-180-180\.gif$/i then reject_img(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.ele\.growth\.fission\.client\.etmd\.et\.getmainpageicon/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.interact\.content\.homepage\.float/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?msg\.toast\.user/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?homepage\.recommend\.popUp/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?homepage\.newWelfare\.alipay/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?homepage\.module\.newAlipay/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?homepage\.shortcut\.scene\.perception/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?applet\.homepage\.medal\.activity/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.hellobike\.com\/api\?bottom\.aggregation\.tab\.info/i then reject(200)
request if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.com\/cnsvPmpaAliCardWeb\/page\/getGuidePageAds/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/shopping\.ele\.me\/(gw|h5)\/mtop\.o2o\.ad\.exposure\.get/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.upp\.tbet\.send/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.eleme\.trigger\.respond/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/alsc-buy2\.ele\.me\/h5\/mtop\.alsc\.eleme\.order\.detail\.miniapp\.build/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/alipayAdRewrite/Script-Hub-Org_replace-body.js", "orderDetailCdpTriggerInfo-%3Erandom_body") with tag="replaceBody", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.eleme\.miniapp\.homepage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/alipayAdRewrite/zirawell_eleme.js") with tag="eleme", timeout=60, requires_body=true

[MITM]
hostname = m5-zb.amap.com, aimai-guide.ele.me, creditcardapp.bankcomm.com, mdn.alicdn.com, shopping.ele.me, guide-acs.m.taobao.com, api.hellobike.com, alsc-buy2.ele.me, waimai-guide.ele.me

