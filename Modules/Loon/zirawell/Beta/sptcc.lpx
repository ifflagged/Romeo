#!name=上海交通卡 - SPTCC
#!desc=上海交通卡官方版
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id910068158
#!bundleId=com.jiuyu.sptcc.phonegap
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-01

[Rule]
DOMAIN-SUFFIX,medproad.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/jiguang\.sptcc\.com\/smartop\/\d\/getEvent/i then reject(200)
request if ${url} ~= /^https?:\/\/online\.sptcc\.com(:\d+)?\/handapp_app\/(?>ActivityGetServlet|queryWebUrlConfig)/i then reject(200)
request if ${url} ~= /^https?:\/\/online\.sptcc\.com(:\d+)?\/handapp_zx\/rss_info/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/online\.sptcc\.com(:\d+)?\/handapp_update\/AppInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/sptcc/zirawell_sptcc.js") with tag="sptcc", requires_body=true

[MITM]
hostname = jiguang.sptcc.com, online.sptcc.com

