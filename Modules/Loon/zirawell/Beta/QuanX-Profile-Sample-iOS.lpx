#!name=QuanX-Profile-Sample-iOS
#!desc=QuanX-Profile-Sample-iOS
#!icon=icon not found
#!tag=zirawell

[Rule]
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,224.0.0.0/24,DIRECT,no-resolve
DOMAIN,ocsp.apple.com,REJECT
GEOIP,CN,DIRECT,no-resolve

[Script]
cron "10 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/QuanX-Profile-Sample-iOS/zirawell_flyert.js") with tag="飞客茶馆", timeout=120, img_url=", img-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/flyert.png"

response if ${url} ~= /^https:\/\/ap(p|i)\.bili(bili|api)\.(com|net)\/(pgc\/view\/v\d\/app\/season|x\/v\d\/search\/defaultwords)\?access_key/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/QuanX-Profile-Sample-iOS/zirawell_Bili_Auto_Regions.js") with tag="Bili_Auto_Regions", timeout=60, requires_body=true

request if ${url} ~= /^https:\/\/ap(p|i)\.bili(bili|api)\.(com|net)\/x\/v\d\/search(\/type)?\?.+?%20(%E6%B8%AF|%E5%8F%B0|%E4%B8%AD)&/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/QuanX-Profile-Sample-iOS/zirawell_Bili_Auto_Regions.js") with tag="Bili_Auto_Regions", timeout=60

request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/QuanX-Profile-Sample-iOS/chavyleung_chavy.boxjs.js") with tag="chavy.boxjs", timeout=60, requires_body=true

[MITM]
hostname = ap?.bilibili.com, ap?.biliapi.net, boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net, res.cc.cmbimg.com, elife.icbc.com.cn, m.ctrip.com

