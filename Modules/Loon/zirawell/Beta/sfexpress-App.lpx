[Rewrite]
response if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/bms\/queryRecommend/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-video\/video\/app\/video\/labelClusterList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberGoods\/pointMallService\/goodsList/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = ccsp-egmas.sf-express.com, ucmp.sf-express.com

