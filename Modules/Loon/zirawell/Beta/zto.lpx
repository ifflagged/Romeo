#!name=zto
#!desc=zto
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/fscdn\.zto\.com\/fs1/i then reject(200)
response if ${url} ~= /^https?:\/\/hdgateway\.zto\.com\/(?>getApolloConfig|track|getAdInfo|listJumperShow)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = hdgateway.zto.com, fscdn.zto.com

