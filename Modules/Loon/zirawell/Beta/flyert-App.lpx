#!name=飞客 - FLYERT
#!desc=飞客-五星级轻奢旅行
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id547560608
#!bundleId=com.flyguest.flyertea
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=basicdata&type=forumlist/i then response.body.replace(/adv/, "adv0")
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=threadpost/i then response.body.replace(/relatedrecommend/, "relatedrecommend0")
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=advis/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=basicdata&type=appinfo/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*plugin/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-App/zirawell_flyert.js") with tag="flyert", requires_body=true

[MITM]
hostname = www.flyert.com, www.flyert.com.cn, www.flyertrip.com, www.flyertrip.com.cn

