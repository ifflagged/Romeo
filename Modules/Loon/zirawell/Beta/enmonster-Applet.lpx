[Rewrite]
request if ${url} ~= /^https?:\/\/aag\.enmonster\.com\/apa(\/index)?\/advert/i then reject(200)
response if ${url} ~= /^https?:\/\/aag\.enmonster\.com\/apa(\/discount)?\/activity/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = aag.enmonster.com

