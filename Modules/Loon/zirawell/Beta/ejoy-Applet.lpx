[Rewrite]
response if ${url} ~= /^https?:\/\/a\.sinopecsales\.com\/app\/cms/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ocrifs\.ejoy\.sinopec\.com\/advertitfs\/advert\/findAdvertInfo/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/egw\.ejoy\.sinopec\.com\/api\/interface\/queryEffectiveBulletin/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = a.sinopecsales.com, ocrifs.ejoy.sinopec.com, egw.ejoy.sinopec.com

