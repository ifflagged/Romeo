#!name=Bili_Auto_Regions
#!desc=Bili_Auto_Regions
#!icon=icon not found
#!tag=zirawell

[Rule]
IP-CIDR,203.107.1.1/24,REJECT,no-resolve

[Script]
response if ${url} ~= /^https:\/\/ap(p|i)\.bili(bili|api)\.(com|net)\/(pgc\/view\/v\d\/app\/season|x\/offline\/version)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Bili_Auto_Regions/NobyDa_Bili_Auto_Regions.js") with tag="Bili Region", requires_body=true

request if ${url} ~= /^https:\/\/ap(p|i)\.bili(bili|api)\.(com|net)\/x\/v\d\/search(\/type)?\?.+?%20(%E6%B8%AF|%E5%8F%B0|%E4%B8%AD)&/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Bili_Auto_Regions/NobyDa_Bili_Auto_Regions.js") with tag="Bili Search"

response if ${url} ~= /^https:\/\/ap(p|i)\.bili(bili|api)\.(com|net)\/(pgc\/view\/v\d\/app\/season|x\/offline\/version)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Bili_Auto_Regions/NobyDa_Bili_Auto_Regions.js") with tag="Bili_Auto_Regions", timeout=60, requires_body=true

[MITM]
hostname = ap?.bili*i.com, ap?.bili*i.net

