#!name=掌上生活 - CMBCC
#!desc=掌上生活-招商银行信用卡
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id398453262
#!bundleId=com.cmbchina.cmblife
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-10-01

[Rule]
DOMAIN,applog.paas.cmbchina.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/intellicc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.intelli\.adrender\.api\.(?>AdWork|QueryMultipleAds)/i then reject(200)
request if ${url} ~= /^https?:\/\/intellicc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.intelli\.render\.api\.render\/getDynamicDataSec/i then reject(200)
request if ${url} ~= /^https?:\/\/.*mbasecc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.preloadService\/preload/i then reject(200)
request if ${url} ~= /^https?:\/\/.*mbasecc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.advertiseService\/preCacheAdvertiseSec/i then reject(200)
request if ${url} ~= /^https?:\/\/.*mbasecc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.mbase\.appWidget\.api\.WidgetGatewayControllerApi\/executeWidgetJobs/i then reject(200)
response if ${url} ~= /^https?:\/\/res\.cc\.cmbimg\.com\/fsp\/File\/ClientFacePublic\/\w+\.DAT$/i then response.body.replace(/widget/, "widget0")
response if ${url} ~= /^https?:\/\/mars\.ccc\.cmbchina\.com\/MarsReceiver/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/marscc\.bcs\.cmbchina\.com\/MarsReceiver/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/contentcc\.bcs\.cmbchina\.com\/Edge\/api\/contentpublisher\.api\.UserFeedsControllerApi\/query/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/intellicc\.\w+\.cmbchina\.com\/Edge\/api\/mlife\.intelli\.render\.api\.RecommendRenderControllerApi\/getRecommendResult/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/interactivecc\.\w+\.cmbchina\.com\/Edge\/api\/atpcore\.api\.AccompanyingServiceControllerApi\/queryAccompanyingServiceUserConfForApp/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/yummy2web01-edge-dmz\.bcs\.cmbchina\.com\/Edge\/api\/cmscampaign\.api\.HomeActivityClientControllerApi\/activityClientPartake/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = mars.ccc.cmbchina.com, marscc.bcs.cmbchina.com, contentcc.bcs.cmbchina.com, intellicc.b*s.cmbchina.com, *mbasecc.b*s.cmbchina.com, interactivecc.b*s.cmbchina.com, yummy2web01-edge-dmz.bcs.cmbchina.com

