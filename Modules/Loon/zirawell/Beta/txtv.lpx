#!name=txtv
#!desc=txtv
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT
DOMAIN,vv.video.qq.com,REJECT
DOMAIN,ugchsy.gtimg.com,REJECT
DOMAIN,wxsmsdy.video.qq.com,REJECT
DOMAIN,sdkconfig.video.qq.com,REJECT
DOMAIN,activity.video.qq.com,REJECT
DOMAIN-SUFFIX,video.mpush.qq.com,REJECT
DOMAIN-SUFFIX,video.wap.mpush.qq.com,REJECT
DOMAIN-SUFFIX,video.ureport.push.qq.com,REJECT
DOMAIN-SUFFIX,api.poll.video.qq.com,REJECT
DOMAIN-SUFFIX,livep.l.ott.video.qq.com,REJECT
DOMAIN-SUFFIX,news-l.play.ott.video.qq.com,REJECT
DOMAIN-SUFFIX,vlive.qqvideo.tc.qq.com,REJECT
DOMAIN-KEYWORD,1258344696.file.myqcloud.com,REJECT
IP-CIDR,183.201.213.194/24,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/vv\.video\.qq\.com\/(?>diff|get)vmind/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+/i then reject(200)
request if ${url} ~= /^https?:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/ossgw\.alicdn\.com\/creatives-assets\/prod\/feupload\/user/i then reject(200)

[Script]
request if ${url} ~= /^https?:\/\/vv\.video\.qq\.com\/getvinfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/txtv/Script-Hub-Org_replace-body.js", "%26sppreviewtype%3D%5Cd(.*)%26spsrt%3D%5Cd-%3E%26sppreviewtype%3D0%241%26spsrt%3D0") with tag="replaceBody", timeout=30, requires_body=true

[MITM]
hostname = vv.video.qq.com, apd-vlive.apdcdn.tc.qq.com, apd-*.v.smtcdns.com, ossgw.alicdn.com

