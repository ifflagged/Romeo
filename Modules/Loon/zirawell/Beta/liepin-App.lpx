[Rule]
DOMAIN,apmplus.volces.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/api-c\.liepin\.com\/api\/com\.liepin\.pupa\.discover\.city\.get-ad-comps/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-ac\.liepin\.com\/api\/com\.liepin\.cyclops\.live\.get-ad-cards/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-ac\.liepin\.com\/api\/com\.liepin\.pupa\.discover\.click-tab/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-wanda\.liepin\.com\/api\/com\.liepin\.cbp\.baizhong\.op\.v\d-show-4app/i then response.body.mock("text", "", 200)

[MITM]
hostname = api-c.liepin.com, api-ac.liepin.com, api-wanda.liepin.com

