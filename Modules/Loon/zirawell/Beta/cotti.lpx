#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/gateway\.cotticoffee\.com\/cotti-capi\/person\/homeLoginPrompt/i then reject(200)
response if ${url} ~= /^https?:\/\/gateway\.cotticoffee\.com\/cotti-capi\/customer\/position\/adSortList/i then response.body.mock("json", "{}", 200)

[Script]
request if ${url} ~= /^https?:\/\/gateway\.cotticoffee\.com\/cotti-capi\/customer\/position\/list$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/cotti/zirawell_cotti.js") with tag="cotti", requires_body=true

[MITM]
hostname = gateway.cotticoffee.com

