[Rewrite]
response if ${url} ~= /^https?:\/\/acs\.m\.shyhhema\.com\/h5\/mtop\.wdk\.fc\.recommend\.feeds/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/acs\.m\.shyhhema\.com\/h5\/mtop\.wdk\.render\.query(?>index|my)page/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/freshippo-Applet/zirawell_freshippo.js") with tag="freshippo", requires_body=true

[MITM]
hostname = acs.m.shyhhema.com

