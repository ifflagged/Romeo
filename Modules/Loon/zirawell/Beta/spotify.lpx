#!name=spotify - SPOTIFY
#!desc=Spotify: Music and Podcasts
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id324684580
#!bundleId=com.spotify.client
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i then redirect(302, "https://$1.spotify.com/artistview/v1/artist/$2&platform=ipad")
response if ${url} ~= /^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/pendragon\//i then response.body.mock("json", "{}", 200)
^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/(?>ad-logic|ads|.+ad_slot|.+banners|.+canvases|.+cards|.+crashlytics|.+doubleclick.net|.+enabled-tracks|.+event|.+sponsored|.+promoted) mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/(?>bootstrap\/v\d\/bootstrap|user-customization-service\/v\d\/customize)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/spotify/zirawell_spotify.js") with tag="spotify", requires_body=true

[MITM]
hostname = gae2-spclient.spotify.com, guc3-spclient.spotify.com, spclient.wg.spotify.com

