[Rewrite]
request if ${url} ~= /^https?:\/\/download1\.bankcomm\.com\/mobs6-inner\/offline\/static\/releaseConf/i then reject(200)
request if ${url} ~= /^https?:\/\/download1\.bankcomm\.com\/_cdn\/mobs\/home\/oss\/pub\/file\/file\/public\/config\/pageConfig/i then reject(200)
response if ${url} ~= /^https?:\/\/download1\.bankcomm\.com\/chngweb\/CHNRCSP\/media/i then response.body.mock("text", "", 200)

[MITM]
hostname = download1.bankcomm.com

