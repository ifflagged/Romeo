#!name=迅雷 - XUNLEI
#!desc=迅雷-您的专享云盘
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1503466530
#!bundleId=com.xunlei.mvideo
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN,adsp.xunlei.com,REJECT
DOMAIN,etl.xlmc.sandai.net,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/images\.client\.vip\.xunlei\.com(\/.+)?\/advert\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v\d\/slots:batchGet/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/conf-m-ssl\.xunlei\.com\/external\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xunlei/zirawell_xunlei.js") with tag="xunlei", requires_body=true

[MITM]
hostname = images.client.vip.xunlei.com, api-shoulei-ssl.xunlei.com, conf-m-ssl.xunlei.com

