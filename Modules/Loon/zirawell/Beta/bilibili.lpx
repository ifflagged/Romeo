#!name=bilibili
#!desc=bilibili
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,adtrack.qianwen.com,REJECT
DOMAIN,ad-api.morefreegame.com,REJECT
DOMAIN-SUFFIX,ad.bilibili.com,REJECT
DOMAIN-SUFFIX,adcommon.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.game.bilibili.com,REJECT
DOMAIN-SUFFIX,track.biligame.bilibili.com,REJECT
DOMAIN-KEYWORD,api.sobot.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v\d\.Search\/DefaultWords/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v\d\/resource\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/ip/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v\d\.Dynamic\/DynAll/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v\d\.Teenagers\/ModeStatus/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(?>view|viewunite)\.v\d\.View\/View/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.community\.service\.dm\.v\d\.DM\/DmView/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.main\.community\.reply\.v\d\.Reply\/MainList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(?>app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.polymer\.app\.search\.v\d\.Search\/SearchAll/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliProtoA.js") with tag="bilibiliProtoA", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/api\.bilibili\.com\/pgc\/page\/(?>bangumi|cinema\/tab\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v\d\/index\/getInfoByRoom\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v\d\/(?>feed\/index(\/story)?|search\/square)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/(?>top\/activity|show\/tab\/v\d)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v\d\/splash\/(?>brand\/list|event\/list2|list|show)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v\d\/account\/(?>mine(\/ipad)?|myinfo)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibili/zirawell_bilibiliJson.js") with tag="bilibiliJson", timeout=60, requires_body=true

[MITM]
hostname = app.bilibili.com, grpc.biliapi.net, api.bilibili.com, api.live.bilibili.com, upos-sz-static.bilivideo.com

