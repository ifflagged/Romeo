request if ${url} ~= /^https?:\/\/(www.)?zbrushcn\.com\//i then redirect(302, "https://pixologic.com/")
request if ${url} ~= /^https?:\/\/links\.jianshu\.com\/go\?to=(.*)/i then redirect(302, "$1")
request if ${url} ~= /^https?:\/\/www\.jianshu\.com\/go-wild\?ac=\d&url=(.*)/i then redirect(302, "$1")
request if ${url} ~= /^https?:\/\/link\.zhihu\.com\/\?target=(.*)/i then redirect(302, "$1")
request if ${url} ~= /(^https?:\/\/)?t\.me\/(.+)/i then redirect(302, "sg://resolve?domain=$2")
request if ${url} ~= /(^https?:\/\/ptf\.flyertrip\.com\/forum\/\d{4}(\/)?\d{2}\/\d{2}\/[0-9A-Za-z]+\.(png|jpg|jpeg|gif|bmp|webp))!o.*$/i then redirect(302, "$1")
request if ${url} ~= /^https?:\/\/surge\.app\/(install.*)/i then redirect(302, "surge:///$1")

