request if ${url} ~= /^https?:\/\/(www.)?vegaschina\.cn\//i then redirect(302, "https://www.vegascreativesoftware.com/")
request if ${url} ~= /^https?:\/\/(www.)?xshellcn\.com\//i then redirect(302, "https://www.netsarang.com/zh/xshell/")
