[Rewrite]
request if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/action\/carrctapi\/brand\/area\/advertising/i then reject(200)
response if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/action\/carrctapi\/order\/appStartInit/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/resource\/cardes\/toufang\/marketing/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/resource\/cardes\/guide/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/resource\/carrctapi\/base\/versionInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apiproxy\.zuche\.com\/resource\/carrctapi\/order\/homeCommonTips/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = apiproxy.zuche.com

