[Rewrite]
response if ${url} ~= /^https?:\/\/c\.kuaiduizuoye\.com\/adx\/impress/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.kuaiduizuoye\.com\/init\/ad\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.kuaiduizuoye\.com\/kdapi\/conf\/appbanners/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apivip\.kuaiduizuoye\.com\/viponline\/scancode\/mycard/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = c.kuaiduizuoye.com, www.kuaiduizuoye.com, apivip.kuaiduizuoye.com

