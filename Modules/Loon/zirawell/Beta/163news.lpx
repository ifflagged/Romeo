#!name=网易新闻 - 163NEWS
#!desc=网易新闻-头条新闻视频资讯平台
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id425349261
#!bundleId=com.netease.news
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rewrite]
response if ${url} ~= /^https?:\/\/c\.m\.163\.com\/nc\/gl\//i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/gw\.m\.163\.com\/nc\/api\/v\d\/feed\/dynamic\/headline-list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/163news/zirawell_163news.js") with tag="163news", requires_body=true

response if ${url} ~= /^https?:\/\/gw\.m\.163\.com\/nc\/api\/v\d\/search\/hot-word/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/163news/zirawell_163news.js") with tag="163news", requires_body=true

response if ${url} ~= /^https?:\/\/nex\.163\.com\/q/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/163news/zirawell_163news.js") with tag="163news", requires_body=true

[MITM]
hostname = c.m.163.com, gw.m.163.com, nex.163.com

