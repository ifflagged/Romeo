#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines/i then reject(200)
response if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/headLine\/headLineInit/i then response.body.replace(/data/, "data0")
response if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/windowsintegration\/getMessage/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/picc/zirawell_picc.js") with tag="picc", requires_body=true

response if ${url} ~= /^https?:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/picc/zirawell_picc.js") with tag="picc", requires_body=true

[MITM]
hostname = zgrb.epicc.com.cn

