#!name=17u-Applet
#!desc=17u-Applet
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/wx\.17u\.cn\/xcxhomeapi\/((aggregator\/index)|(home\/(?>screen|banner|converge)))$/i then reject(200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/wxocbdapi\/adService/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/homemarketapi\/(aggregator\/index|search\/recommend)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/mytourapi\/mytrip\/(?>blankflight|toptips)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/mytourapi\/blankpage\/recommendList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/mytourapi\/recommendation\/arriveCity/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/membermessageuserapi\/(message\/list|category\/getCategory)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/platformpubapi\/customer\/lead\/getInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/vacation\/webapp\/tailor\/miniHomeConfig/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wx\.17u\.cn\/wireless\/monitor\/wx\/common\/compressevent/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/\w+\.sh\.wxgateway\.com\/xcxhomeapi\/((aggregator\/index)|(home\/(?>screen|banner|converge)))$/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = wx.17u.cn, *.sh.wxgateway.com

