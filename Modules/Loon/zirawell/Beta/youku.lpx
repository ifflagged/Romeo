[Rewrite]
response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.(pisp\.scripts\.get|xspace\.play\.position\.preload\.query|xspace\.poplayer\.position\.query)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.columbus\.(gateway\.new\.execute|home\.feed|home\.query|uc\.query|ycp\.query)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.haidai\.lantern\.appconfig\.get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.huluwa\.dispatcher\.youthmode\.config2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

response if ${url} ~= /^https?:\/\/acs\.youku\.com\/gw\/mtop\.youku\.soku\.yksearch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

response if ${url} ~= /^https?:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

response if ${url} ~= /^https?:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/youku/zirawell_cntv.js") with tag="youku", requires_body=true

[MITM]
hostname = acs.youku.com, push.m.youku.com, un-acs.youku.com

