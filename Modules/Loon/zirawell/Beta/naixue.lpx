[Rewrite]
response if ${url} ~= /^https?:\/\/tm-api\.pin-dao\.cn\/home\/api\/index\/activeConfig\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/tm-api\.pin-dao\.cn\/home\/api\/resource\/config\/homeBannerNodes/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/tm-api\.pin-dao\.cn\/activity\/.*\/pop/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = tm-api.pin-dao.cn

