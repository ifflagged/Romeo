DOMAIN-SUFFIX,impservicetest.dictapp.youdao.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/course\/tab\/translateTab/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-overmind\.youdao\.com\/openapi\/get\/luna\/dict\/dict-mobile\/prod\/dictCommonConfig/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cdke\.youdao\.com\/course\d\/recommend\/dict\/startup/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/commonsearch/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/vip\/activity\/couponinfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/dictusertask\/system/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/dictvip-business\.youdao\.com\/home\/ad/i then response.body.mock("json", "{}", 200)
^https?:\/\/oimage\w\d\.ydstatic\.com\.+adpublish mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/dsp-impr2\.youdao\.com\/adload/i then response.body.mock("text", "", 200)
^https?:\/\/impservice\.dictapp\.youdao\.com\/imp\/request mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/oral\.youdao\.com\/oral\/adInfo mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/(homepage\/promotion|course\/tab\/home|homepage\/tile)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/163youdao/zirawell_163youdao.js") with tag="163youdao", requires_body=true

[MITM]
hostname = dict.youdao.com, api-overmind.youdao.com, cdke.youdao.com, dictvip-business.youdao.com, dsp-impr2.youdao.com, impservice.dictapp.youdao.com, oral.youdao.com, oimage*.ydstatic.com

