[Rewrite]
response if ${url} ~= /^https?:\/\/plt\.yorentown\.com\/pltapp\/v\d\/banner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/lawsonapi\.yorentown\.com\/app\/v\d\/globalLaunch\/listAdvert/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/lawson/zirawell_wechatApplet.js") with tag="lawson", requires_body=true

[MITM]
hostname = plt.yorentown.com, lawsonapi.yorentown.com

