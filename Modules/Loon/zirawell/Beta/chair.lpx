#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-08

[Rewrite]
request if ${url} ~= /^https?:\/\/gaia\.ch\.com\/ECProduct\/popupWindow/i then reject(200)
request if ${url} ~= /^https?:\/\/gaia\.ch\.com\/ECProduct\/homePageRevision\/(?>queryRecommend|findAll)Info/i then reject(200)
request if ${url} ~= /^https?:\/\/gaia\.ch\.com\/ECPromotion\/appFlash/i then reject(200)
request if ${url} ~= /^https?:\/\/gaia\.ch\.com\/ECMember\/psnCenter\/adversAndInfo/i then reject(200)
response if ${url} ~= /^https?:\/\/gaia\.ch\.com\/ECPromotion\/precisionactivity\/queryad/i then response.body.mock("json", "{}", 200)
^https?:\/\/appmedia\.springairlines\.com\/cmsstatic\/.*(\.gif|homeAi) mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = gaia.ch.com, appmedia.springairlines.com

