[Rewrite]
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/recommend/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/no_auth\/benefit/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/.+\/more\/ios\?v=\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/blued/zirawell_blued.js") with tag="blued", requires_body=true

[MITM]
hostname = social.blued.cn

