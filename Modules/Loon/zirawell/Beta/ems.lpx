#!name=ems
#!desc=ems
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/\w+\.ems\.com\.cn\/mailAd$/i then reject(200)
request if ${url} ~= /^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/advert/i then reject(200)
response if ${url} ~= /^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/adPlatform/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/\w+\.ems\.com\.cn\/[A-Za-z-]+\/redis\/pageInfoByChannel/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ems/zirawell_wechatApplet.js") with tag="ems", requires_body=true

[MITM]
hostname = ec.ems.com.cn, ump.ems.com.cn

