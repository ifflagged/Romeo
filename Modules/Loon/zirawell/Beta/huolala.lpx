[Rewrite]
response if ${url} ~= /^https?:\/\/qapi\.huolala\.cn\/(?>ads|home_new_user|get_service_list)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/appuser-static\.huolala\.cn\/imgs/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = qapi.huolala.cn, appuser-static.huolala.cn

