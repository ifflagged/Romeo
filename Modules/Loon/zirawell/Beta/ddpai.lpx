[Rule]
DOMAIN,api.htp.ad-scope.com.cn,REJECT
DOMAIN,init.sms.mob.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/app(\w+)?\.ddpai\.com(:\d+)?\/onroad\/api\/v\d\/(?>ad|banner|news)\/list/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = app*.ddpai.com

