#!name=Cookie获取大合集
#!desc=此远程订阅用于解决任务脚本的cookie获取
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!tag=Cookie
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-10

[Script]
request if ${url} ~= /^https?:\/\/passport\.iqiyi\.com\/apis\/user\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_iqiyi.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/www\.52pojie\.cn\/home\.php\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_52pj.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/(c\.)?tieba(c)?\.baidu\.com\/c\/u\/follow\/getFoldedMessageUserInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_tieba.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_bilibili.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/m.bilibili.com\/$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_bilibili.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_bilibiliManga.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_xmly.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.new_task_system\.task_system\.TaskSystem\/ReadTaskList\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_txtv.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/pbaccess\.video\.qq\.com\/trpc\.videosearch\.hot_rank\.HotRankServantHttp\/HotRankHttp/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_txtv.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/pbaccess\.video\.qq.\com\/trpc\.video_account_login\.web_login_trpc\.WebLoginTrpc\/NewRefresh/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_txtv.js") with tag="Remote_Cookies", requires_body=true

request if ${url} ~= /^https?:\/\/ngabbs.com\/nuke.php$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_nga.js") with tag="Remote_Cookies", requires_body=true

request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_ccblife.js") with tag="Remote_Cookies", requires_body=true

response if ${url} ~= /^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_amap.js") with tag="Remote_Cookies", requires_body=true

response if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_ctrip.js") with tag="Remote_Cookies", requires_body=true

request if ${url} ~= /^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_huazhu.js") with tag="Remote_Cookies"

request if ${url} ~= /^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/Remote_Cookies/zirawell_flyert.js") with tag="Remote_Cookies"

[MITM]
hostname = passport.iqiyi.com, www.52pojie.cn, tiebac.baidu.com, c.tieba.baidu.com, app.bilibili.com, m.bilibili.com, xmc.ximalaya.com, vip.video.qq.com, pbaccess.video.qq.com, ngabbs.com, yunbusiness.ccb.com, *.amap.com, m.ctrip.com, hweb-personalcenter.huazhu.com, www.flyert.com.cn

