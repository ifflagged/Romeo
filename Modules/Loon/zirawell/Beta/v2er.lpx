#!name=V2er Repair
#!desc=此远程订阅用于修复用户主页解析异常问题
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!tag=Repair
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-09-18

[Script]
response if ${url} ~= /^https?:\/\/www\.v2ex\.com\/member\/\w+$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/v2er/zirawell_V2er_Repair.js") with tag="v2er", requires_body=true

response if ${url} ~= /^https?:\/\/www\.v2ex\.com\/mission\/daily/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/v2er/zirawell_V2er_Repair.js") with tag="v2er", requires_body=true

response if ${url} ~= /^https?:\/\/www\.v2ex\.com\/t\/\d+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/v2er/zirawell_V2er_Repair.js") with tag="v2er", requires_body=true

[MITM]
hostname = www.v2ex.com

