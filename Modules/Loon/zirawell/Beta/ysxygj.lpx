#!name=银盛小Y管家 - YSXYGJ
#!desc=银盛小Y管家
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1483705019
#!bundleId=com.ysepay.merchant.service
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN,ads.ysepay.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/ya-sdn\.ysepay\.com\/ma_gate\/advertisement/i then reject(200)
request if ${url} ~= /^https?:\/\/ya-sdn\.ysepay\.com\/ma_gate\/popupAds/i then reject(200)
request if ${url} ~= /^https?:\/\/ya-sdn\.ysepay\.com\/ma_gate\/version\/updateAppVersion/i then reject(200)

[MITM]
hostname = ya-sdn.ysepay.com

