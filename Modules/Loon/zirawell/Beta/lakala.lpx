[Rewrite]
response if ${url} ~= /^https?:\/\/lamb\.lakala\.com\/lamo\/adv\/access\/queryMaterialUrl/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wallet\.lakala\.com\/m\/lama\/mgt\/activity\/bank\/query\/list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wallet\.lakala\.com\/m\/a\/lama\/mgt\/activity\/biz\/query\/byMerInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wallet\.lakala\.com\/m\/a\/message\/v\d\/fetchMsgList/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = lamb.lakala.com, wallet.lakala.com

