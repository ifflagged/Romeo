#!name=sfexpress-Applet
#!desc=sfexpress-Applet
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/cx-wechat-query\/query\/info-flow\/reconsitution-list/i then reject(200)
request if ${url} ~= /^https?:\/\/shopic\.sf-express\.com\/index\/home\/get(?>Popup|Layout)/i then reject(200)
request if ${url} ~= /^https?:\/\/shopic\.sf-express\.com\/account\/coupon\/getUserCouponCnt/i then reject(200)
response if ${url} ~= /^https?:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/integralPlanet\/getCxAdvertiseList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp-static\.sf-express\.com\/proxy\/wxbase\/wxTicket\/wxLiveStreamInfo\?pageNo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberGoods\/pointMallService\/goodsList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberManage\/memberEquity\/queryRecommendEquity/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberActLengthy\/fullGiveActivityService\/fullGiveInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/cx-wechat-query\/query\/module-config\/query/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = ucmp.sf-express.com, shopic.sf-express.com

