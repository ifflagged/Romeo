[Rewrite]
request if ${url} ~= /^https?:\/\/api\.caijingmobile\.com\/(ad|advert)\//i then reject(200)
request if ${url} ~= /^https?:\/\/m\.caijing\.com\.cn\/startup_ad_ios/i then reject(200)

[MITM]
hostname = api.caijingmobile.com, m.caijing.com.cn

