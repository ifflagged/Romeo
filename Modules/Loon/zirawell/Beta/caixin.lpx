#!name=财新 - CAIXIN
#!desc=财新-原创高质量财经资讯报道
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id356023612
#!bundleId=com.caixinmedia.client
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,gg.caixin.com,REJECT
DOMAIN,dolphin.caixin.com,REJECT
DOMAIN-SUFFIX,apollo.caixin.com,REJECT
DOMAIN-SUFFIX,logstat.caixin.com,REJECT
DOMAIN-SUFFIX,promote.caixin.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/www\.caixin\.com\/ai\/question/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cxdata\.caixin\.com\/api\/dataplus\/stkData\/list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/entities\.caixin\.com\/api\/public\/push\/appIndex\?target=index/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/gateway\.caixin\.com\/api\/app-api\/(?>search\/getkeyword|caixinminiapp\/appinfo|articlesHotRecommend\/getHotRecommendArticles)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = www.caixin.com, cxdata.caixin.com, entities.caixin.com, gateway.caixin.com

