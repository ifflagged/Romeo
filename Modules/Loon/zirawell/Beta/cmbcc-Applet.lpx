[Script]
response if ${url} ~= /^https?:\/\/xyk\.cmbchina\.com\/WebAppConfigService\/get(Page)?ResourceBits/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/cmbcc-Applet/zirawell_cmbcc.js") with tag="cmbcc", requires_body=true

response if ${url} ~= /^https?:\/\/weclub\.ccc\.cmbchina\.com\/SCRMMiniAppCenterNode\/resource\/gateway\/get-page-resource/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/cmbcc-Applet/zirawell_cmbcc.js") with tag="cmbcc", requires_body=true

[MITM]
hostname = xyk.cmbchina.com, weclub.ccc.cmbchina.com

