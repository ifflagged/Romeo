#!name=中国农业银行 - ABCHINA
#!desc=中国农业银行
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id515651240
#!bundleId=com.bankabc.iphonerelease
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,imc.abchina.com.cn,REJECT
DOMAIN,msmp.abchina.com.cn,REJECT
DOMAIN,firefly.abchina.com.cn,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/mall\.abchina\.com\.cn\/pips\/EbizccmClientServer\/PIPSPopupAdvertisement/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mobilepaas\.abchina\.com\.cn(:\d+)?\/mgw\.htm$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/abc/zirawell_mgw.js") with tag="abc"

[MITM]
hostname = mall.abchina.com.cn, mobilepaas.abchina.com.cn

