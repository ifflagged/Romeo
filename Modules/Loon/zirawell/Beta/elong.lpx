[Rewrite]
request if ${url} ~= /^https?:\/\/webboot\.zhangyue\.com\/zycl\/api\/ad\//i then reject(200)
request if ${url} ~= /^https?:\/\/saad\.ms\.zhangyue\.net\/ad/i then reject(200)
response if ${url} ~= /^https?:\/\/mobile-api2011\.elong\.com\/ad(?>v|gateway)/i then response.body.mock("text", "", 200)

[MITM]
hostname = mobile-api2011.elong.com, webboot.zhangyue.com, saad.ms.zhangyue.net

