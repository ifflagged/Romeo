#!name=rrtv
#!desc=rrtv
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.rr\.tv\/.*?Version/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.rr\.tv\/storage\/business\/rootName\/app\/homePage\?dataType=JSON/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.rr\.tv\/\w{3}\/level\/info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_MY/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_INDEX/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/ad\/getAll/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/app\/config\/h5NativeBar/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/drama\/app\/get_combined_drama_detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/watch\/v\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/user\/privilege\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

response if ${url} ~= /^https?:\/\/api\.rr\.tv\/user\/profile/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/rrtv/zirawell_rrtv.js") with tag="rrtv", requires_body=true

[MITM]
hostname = api.rr.tv

