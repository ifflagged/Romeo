#!name=zhuanzhuan-Applet
#!desc=zhuanzhuan-Applet
#!icon=icon not found
#!tag=zirawell

[Rewrite]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getpersonalcenter/i then response.body.replace(/pendantInfo/, "random_body")

[Script]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzlogic\/mywxcontinenthomepage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhuanzhuan-Applet/zirawell_zhuanzhuan.js") with tag="zhuanzhuan", requires_body=true

[MITM]
hostname = app.zhuanzhuan.com

