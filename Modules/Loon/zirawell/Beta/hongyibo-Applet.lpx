#!name=hongyibo-Applet
#!desc=hongyibo-Applet
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,api.hongyibo.com.cn,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/res\.hongyibo\.com\.cn\/os\/gs\/resapi\/activity/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = res.hongyibo.com.cn

