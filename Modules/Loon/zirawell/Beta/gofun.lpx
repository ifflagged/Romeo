[Rewrite]
response if ${url} ~= /^https?:\/\/gateway\.shouqiev\.com(:\d+)?\/app\/startUp/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/gateway\.shouqiev\.com(:\d+)?\/fsda\/app\/(?>bootImage|loadPic|appBannerList)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = gateway.shouqiev.com

