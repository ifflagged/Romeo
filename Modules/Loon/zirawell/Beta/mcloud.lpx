#!name=中国移动云盘 - MCLOUD
#!desc=中国移动云盘-全民不限速
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1618137934
#!bundleId=cn.10086.mobileClouds
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,ad.mcloud.139.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/mcmm\.caiyun\.feixin\.10086\.cn:\d+\/mcmm\/api\/(IAdvert|v\d\/getAdverts)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mrp\.mcloud\.139\.com\/mc\/mc-client-service\/openapi\/letter\/query/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/middle\.yun\.139\.com\/openapi\/cardConfig\/queryCardInfoV/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/jzts\.cmpassport\.com\/personalized\/getPushContent/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mcloud/zirawell_mcloud.js") with tag="mcloud", requires_body=true

[MITM]
hostname = mcmm.caiyun.feixin.10086.cn, mrp.mcloud.139.com, middle.yun.139.com, jzts.cmpassport.com

