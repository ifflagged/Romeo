[Script]
request if ${url} ~= /^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/huazhu/zirawell_huazhu.js") with tag="华住会-Cookie"

cron "5 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/huazhu/zirawell_huazhu.js") with tag="华住会-签到"

request if ${url} ~= /^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/huazhu/zirawell_huazhu.js") with tag="huazhu", timeout=60

