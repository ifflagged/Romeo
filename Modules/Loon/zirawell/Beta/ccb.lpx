#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,adv.ccb.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/image1\.ccb\.com\/newsinfo\/eBranch\/check\/(nf\/newfin\/activity|po\/poortheme\/activity)\/\w+\.png/i then reject(200)
request if ${url} ~= /^https?:\/\/imageadv\.ccb\.com\/adpic\/sszserver\/upload\/activity\/\d{8}\/\w+\.(?>gif|png|jpg)$/i then reject(200)
response if ${url} ~= /^https?:\/\/cy\.cloud\.ccb\.com\/\/gateway\/user-server\/user\/qyCenter\/getCustomizedAdv/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = image1.ccb.com, imageadv.ccb.com, cy.cloud.ccb.com

