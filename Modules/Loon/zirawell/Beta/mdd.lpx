[Rule]
DOMAIN,toblog.ctobsnssdk.com,REJECT
DOMAIN,t-dsp.pinduoduo.com,REJECT
DOMAIN,sdk1xyajs.data.kuiniuca.com,REJECT
DOMAIN,conf-darwin.xycdn.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/tower\.ubixioe\.com\/mob\/mediation/i then reject(200)
response if ${url} ~= /^https?:\/\/sfo\.mddcloud\.com\.cn\/api\/v\d\/sfo\/popup_displays/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mob\.mddcloud\.com\.cn\/api\/(ad|advert)\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mob\.mddcloud\.com\.cn\/adApi\/advert\/(?>first|third)part\/advertList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mobads-pre-config\.cdn\.bcebos\.com\/preload/i then response.body.mock("text", "", 200)

[MITM]
hostname = sfo.mddcloud.com.cn, mob.mddcloud.com.cn, mobads-pre-config.cdn.bcebos.com, tower.ubixioe.com

