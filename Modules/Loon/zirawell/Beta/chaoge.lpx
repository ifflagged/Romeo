#!name=超格教育 - CHAOGE
#!desc=超格教育
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1367434722
#!bundleId=com.chaogejiaoyu.www
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,ifconfig.me,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/mapi\.chaogejiaoyu\.com\/api\/ad\/adCheck/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mapi\.chaogejiaoyu\.com\/api\/ad\/getPageAdList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/chaoge/zirawell_chaoge.js") with tag="chaoge", requires_body=true

response if ${url} ~= /^https?:\/\/mapi\.chaogejiaoyu\.com\/api\/outline\/getAppBanner/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/chaoge/zirawell_chaoge.js") with tag="chaoge", requires_body=true

[MITM]
hostname = mapi.chaogejiaoyu.com

