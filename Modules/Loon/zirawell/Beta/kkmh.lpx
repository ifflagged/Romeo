[Rewrite]
request if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ad/i then reject(200)
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/activities\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/mine\/business_config/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/fake_push\/info/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/checkin\/api\/new_user\/tab_info/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/checkin\/task_center\/get_by_task_type/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?h5\.kuaikanmanhua\.com\/user\/scene\/api\/new_user\/sign_in\/list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?h5\.kuaikanmanhua\.com\/v\d\/kb\/recharge_good\/list_h5/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?h5\.kuaikanmanhua\.com\/game-h5\/new-user-welfare\/index\.html/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityModule\/userSignInInfo\?activitySignInConfigId/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityModule\/fetchButtonInfo\?buttonConfigId/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?topic\.kkmh\.com\/gamecard\/v\d\/activityText\/getUserActivityTextInfo\?activityTextConfigId/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/kb\/(?>wallet|comic_page_banner)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/vip\/(?>banner|charge)_tip_list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/vip\/platform_base\/popups_display/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(cdn-)?shop\.kkmh\.com\/mbff\/popup_administration/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ironman\/comic\/recommend/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kkmh/zirawell_kkmh.js") with tag="kkmh", requires_body=true

response if ${url} ~= /^https?:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ironman\/discovery_v\d\/tab_list_v\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kkmh/zirawell_kkmh.js") with tag="kkmh", requires_body=true

response if ${url} ~= /^https?:\/\/(cdn-)?social\.kkmh\.com\/v\d\/graph\/homepage\/comicVideo\/v\d\/configs/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kkmh/zirawell_kkmh.js") with tag="kkmh", requires_body=true

response if ${url} ~= /^https?:\/\/(cdn-)?social\.kkmh\.com\/v\d\/graph\/unified_feed/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kkmh/zirawell_kkmh.js") with tag="kkmh", requires_body=true

[MITM]
hostname = api.kkmh.com, cdn-api.kkmh.com, h5.kuaikanmanhua.com, cdn-h5.kuaikanmanhua.com, topic.kkmh.com, cdn-topic.kkmh.com, pay.kkmh.com, cdn-pay.kkmh.com, shop.kkmh.com, cdn-shop.kkmh.com, social.kkmh.com, cdn-social.kkmh.com

