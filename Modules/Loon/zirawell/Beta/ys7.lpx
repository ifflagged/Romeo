[Rewrite]
request if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/api\/ads/i then reject(200)
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/api\/user\/tabList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/v\d\/config\/service\/entrance\/bannerInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/v\d\/intelligent-app\/apps\/linkage/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/v\d\/configurations\/gray\/info\?grayTypes=185/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/v\d\/videoclips\/square\/video\/query/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/\w+\.ys7\.com\/v\d\/valueadded\/operation\/config\/master\/station/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ys7/zirawell_ys7.js") with tag="ys7", requires_body=true

[MITM]
hostname = i.ys7.com, api.ys7.com

