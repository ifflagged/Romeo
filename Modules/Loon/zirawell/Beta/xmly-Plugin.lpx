[Script]
request if ${url} ~= /^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly-Plugin/zirawell_xmly.js") with tag="xmly"

[MITM]
hostname = xmc.ximalaya.com

