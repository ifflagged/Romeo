#!name=飞猪旅行 - FLIGGY
#!desc=飞猪旅行-机票酒店火车票门票轻松预订
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id453691481
#!bundleId=com.taobao.travel
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-09-08

[Rule]
IP-CIDR,59.82.113.8/32,REJECT,no-resolve
DOMAIN,ad-track.fliggy.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.(?>popresource|screen)/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.guide\.guess\.what\.you\.like/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.tripbaymax\.busi\.buyer\.promote\.track/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.traffic\.ai\.chat\.init/i then reject(200)
response if ${url} ~= /^https?:\/\/outfliggys\.m\.taobao\.com\/app\/trip\/rx-travel-detail\/pages\/index/i then response.body.replace(/"showAiAssistant":true,/, "\"showAiAssistant\":false,")

[Script]
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.ssif\.pattern\.home/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/fliggy/zirawell_fliggy.js") with tag="fliggy", requires_body=true

response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.traveldetail\.ultron\.detail\.firstscreen\.get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/fliggy/zirawell_fliggy.js") with tag="fliggy", requires_body=true

[MITM]
hostname = acs.m.taobao.com

