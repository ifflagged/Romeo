#!name=xmly-CheckIn
#!desc=xmly-CheckIn
#!icon=icon not found
#!tag=zirawell

[Script]
request if ${url} ~= /^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly-CheckIn/zirawell_xmly.js") with tag="喜马拉雅-Cookie"

cron "35 8 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly-CheckIn/zirawell_xmly.js") with tag="喜马拉雅-签到", timeout=15

request if ${url} ~= /^https?:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly-CheckIn/zirawell_xmly.js") with tag="xmly", timeout=60

[MITM]
hostname = xmc.ximalaya.com

