[Rule]
DOMAIN-SUFFIX,e.kuaishou.com,REJECT
DOMAIN-SUFFIX,cm.downloader.commercial.kuaishou.com,REJECT
DOMAIN-SUFFIX,cm.ad.gifshow.com,REJECT
DOMAIN-SUFFIX,cm.kwad.com,REJECT

[Script]
response if ${url} ~= /^https?:\/\/open\.e\.kuaishou\.com\/rest\/e\/v\d\/open\/univ$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuaishou/zirawell_adsense.js") with tag="kuaishou", requires_body=true

[MITM]
hostname = open.e.kuaishou.com

