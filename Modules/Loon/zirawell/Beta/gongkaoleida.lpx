[Rewrite]
request if ${url} ~= /^https?:\/\/api\.gongkaoleida\.com\/api\/v\d\/ad\/info/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gongkaoleida\.com\/api\/\w+\/sets\/getAppVersion/i then reject(200)

[MITM]
hostname = api.gongkaoleida.com

