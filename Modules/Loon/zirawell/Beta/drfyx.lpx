[Rewrite]
response if ${url} ~= /^https?:\/\/membase-yxapp\.feiniu\.com\/misc\/memberIndex/i then response.body.replace(/myADArray/, "myADArray0")
response if ${url} ~= /^https?:\/\/www-yxapp\.feiniu\.com\/home\/popupWindow/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/search-yxapp\.feiniu\.com\/recommend\/general\/FreshRecBuyAgain/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/search-yxapp\.feiniu\.com\/recommend\/memberIndexGoodsList/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = www-yxapp.feiniu.com, search-yxapp.feiniu.com, membase-yxapp.feiniu.com

