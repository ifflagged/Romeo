[Rewrite]
request if ${url} ~= /^https?:\/\/gdlf\.bosc\.cn(:\d+)?\/static\/upload\/pro\/resource\/(?!1762370|1939565|20543596)\w+\.jpg$/i then reject(200)
response if ${url} ~= /^https?:\/\/mpaas1\.bosc\.cn(:\d+)?\/loggw/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/dfg\.bosc\.cn(:\d+)?\/public\/sdkConfig\/get/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mgs1\.bosc\.cn(:\d+)?\/mgw/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bosclife/zirawell_mgw.js") with tag="bosclife"

[MITM]
hostname = mpaas1.bosc.cn, dfg.bosc.cn, gdlf.bosc.cn, mgs1.bosc.cn

