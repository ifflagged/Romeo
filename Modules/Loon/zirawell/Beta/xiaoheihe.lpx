[Rewrite]
response if ${url} ~= /^https?:\/\/api\.xiaoheihe\.cn\/account\/get_ads_info/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/news/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xiaoheihe/zirawell_xiaoheihe.js") with tag="xiaoheihe", requires_body=true

[MITM]
hostname = api.xiaoheihe.cn

