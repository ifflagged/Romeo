[Rewrite]
response if ${url} ~= /^https?:\/\/mapi\.ghsmpwalmart\.com\/api\d\/ec\/navigation\/page\/getPageActivityTab/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mapi\.ghsmpwalmart\.com\/api\d\/ec\/navigation\/spread\/querySpreadList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mapi\.ghsmpwalmart\.com\/api\d\/ec\/navigation\/user\/getAdvertisementPlayModuleInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mapi\.ghsmpwalmart\.com\/api\d\/ec\/user\/couponPackage\/couponPackageAccess/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = mapi.ghsmpwalmart.com

