#!name=网易邮箱大师 - 163MAIL
#!desc=网易邮箱大师 - 智能AI邮件助手
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id897003024
#!bundleId=com.netease.mailmaster
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rewrite]
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/(?>searchMultiAds|showAds)/i then reject(200)
request if ${url} ~= /^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia/i then reject(200)
response if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mmad/i then response.body.mock("text", "", 200)

[MITM]
hostname = appconf.mail.163.com, client.mail.163.com, support.you.163.com

