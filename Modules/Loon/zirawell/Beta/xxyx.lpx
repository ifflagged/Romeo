#!name=晓晓优选 - XXYX
#!desc=晓晓优选-外卖霸王餐返利红包优惠
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1623308434
#!bundleId=moc.nauxuoyoaixoaix.www
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-02

[Rule]
DOMAIN-SUFFIX,1rtb.net,REJECT
DOMAIN-SUFFIX,adwangmai.com,REJECT
DOMAIN-SUFFIX,ad.richmob.cn,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN-SUFFIX,yfanads.com,REJECT
DOMAIN-SUFFIX,datads.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/agent_ad/i then reject(200)
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/get_.*_ad/i then reject(200)
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/\w+_banner/i then reject(200)
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/activity\/show/i then reject(200)
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/client\/invite\/phone\/activity\/popup/i then reject(200)
request if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/client\/urban\/activity\/index\/data/i then reject(200)
response if ${url} ~= /^https?:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/place_ad/i then response.body.replace(/resource_slug/, "random_body")

[MITM]
hostname = xxyx-client-api.xiaoxiaoyouxuan.com

