#!name=彩云天气 - CAIYUNAPP
#!desc=彩云天气-为您预报几点几分下雨
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id847764912
#!bundleId=net.colorfulclouds.app
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-01-22

[Rule]
DOMAIN,ad.cyapi.cn,REJECT
DOMAIN,gather.colorfulclouds.net,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/wrapper\.cyapi\.cn\/v\d\/activity\?.*type_id=A03/i then response.json.jq(".activities[]? |= (if .feature != null then .feature = false else . end)")
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config/i then response.json.jq("del(.search_suggestions)?")
response if ${url} ~= /^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config/i then response.json.jq("(.pic_page_card_orders[]?, .map_page_card_orders[]?) |= select(.name | test(\"^(A|C01)\") | not)")

[MITM]
hostname = wrapper.cyapi.cn, starplucker.cyapi.cn

