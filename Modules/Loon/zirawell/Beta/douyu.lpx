#!name=斗鱼直播 - DOUYU
#!desc=斗鱼直播-直播专业游戏赛事软件
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id863882795
#!bundleId=tv.douyu.live
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,stun1.douyucdn.cn,REJECT
DOMAIN,stun1.qvb.qcloud.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/daoyu\.sdo\.com\/api\/userCommon\/getAppStartAd/i then reject(200)
request if ${url} ~= /^https?:\/\/staticlive\.douyucdn\.cn\/upload\/signs\//i then reject(200)
request if ${url} ~= /^https?:\/\/capi\.douyucdn\.cn\/lapi\/sign\/app(api)?\/getinfo\?client_sys=ios/i then reject(200)
^https?:\/\/douyucdn\.cn\/.+?\/appapi\/getinfo mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo/i then response.body.mock("json", "{}", 200)
^https?:\/\/staticlive\.douyucdn\.cn\/.+?\/getStartSend mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/capi\.douyucdn\.cn\/api\/ios_app\/check_update mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/capi\.douyucdn\.cn\/api\/v\d\/getStartSend?client_sys=ios mock-response-body data-type=tiny-gif status-code=200

[Script]
response if ${url} ~= /^https?:\/\/apiv2\.douyucdn\.cn\/mgapi\/livenc\/home\/getRecV3/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/douyu/zirawell_douyu.js") with tag="douyu", requires_body=true

response if ${url} ~= /^https?:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/douyu/zirawell_douyu.js") with tag="douyu", requires_body=true

response if ${url} ~= /^https?:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/douyu/zirawell_douyu.js") with tag="douyu", requires_body=true

[MITM]
hostname = daoyu.sdo.com, douyucdn.cn, rtbapi.douyucdn.cn, staticlive.douyucdn.cn, capi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn

