[Rewrite]
request if ${url} ~= /^https?:\/\/capis(-\w+)?\.didapinche\.com\/ad\//i then reject(200)
response if ${url} ~= /^https?:\/\/capis(-\w+)?\.didapinche\.com\/publish\/api\/upgrade/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.didapinche\.com\/app\/adstat\//i then response.body.mock("text", "", 200)

[MITM]
hostname = capis*.didapinche.com, www.didapinche.com

