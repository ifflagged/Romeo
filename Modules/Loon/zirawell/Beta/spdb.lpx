[Rewrite]
request if ${url} ~= /^https?:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/getAdvList\.ah$/i then reject(200)
request if ${url} ~= /^https?:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/getAdvertisementList\.ah/i then reject(200)
request if ${url} ~= /^https?:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/prefetchAdvList\.ah/i then reject(200)
request if ${url} ~= /^https?:\/\/wap\.spdb\.com\.cn\/mspmk-web-homeassist\/OpenScreenAdv\.ah$/i then reject(200)

[MITM]
hostname = lban.spdb.com.cn, wap.spdb.com.cn

