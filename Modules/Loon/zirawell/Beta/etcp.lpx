#!name=etcp
#!desc=etcp
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,logs-bigdata.yeehaw.com.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/ife\.etcp\.cn\/api\/v[0-9]\/advertisement/i then reject(200)
response if ${url} ~= /^https?:\/\/static\.etcp\.cn\/json\/advertisment/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = ife.etcp.cn, static.etcp.cn

