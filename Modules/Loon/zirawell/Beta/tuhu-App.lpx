#!name=途虎养车 - TUHU
#!desc=途虎养车 - 专业汽车保养平台
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id943708006
#!bundleId=tuhu.cn.main
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,analytics.tuhu.com,REJECT
DOMAIN,ta.tuhu.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-cms\/circle\/recommend\//i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-scene-marketing-service\/api\/scene\/queryScheme/i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-push-message-box\/banner\/cms\/getIndexBanner/i then reject(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mlp-product-search-api\/search\/helper\/defaultAndHotWord/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/beautyIndex\/getBeautyIndex/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/channelPage\/v\d\/channelPageCouponPromptComponent/i then reject(200)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getAutoSuperConfig/i then reject(200)
response if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/[a-z-]+\/recommend/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getCmsModuleList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tuhu-App/zirawell_tuhu.js") with tag="tuhu", requires_body=true

response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/[a-z-]+\/homePage\/getHomePageInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tuhu-App/zirawell_tuhu.js") with tag="tuhu", requires_body=true

response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-shop-api\/shopTab\/getModuleForC/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tuhu-App/zirawell_tuhu.js") with tag="tuhu", requires_body=true

[MITM]
hostname = mkt-gateway.tuhu.cn, cl-gateway.tuhu.cn, gateway.tuhu.cn

