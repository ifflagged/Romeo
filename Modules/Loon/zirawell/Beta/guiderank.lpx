#!name=盖得排行 - GUIDERANK
#!desc=盖得排行-公正的排行榜
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1129695874
#!bundleId=com.guiderank.guiderank-release
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/ad\/listLaunchADByCity/i then reject(200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getInitData/i then response.body.replace(/SpecialSalePageMidTabConfig/, "random_body")
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/popUpAdCollection/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkPromotionInfoBySceneType/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkCategoryPromotionInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/stockTaking\/pageStockTakingForHomePage/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/specialSale\/pageRecommendedItems/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/specialSale\/listSpecialSalePageBanner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/manualOperationGoods\/pageManualOperationGoods/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/personal\/getPersonPageInfo/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/home\/getHomePageV/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/guiderank/zirawell_guiderank.js") with tag="guiderank", requires_body=true

[MITM]
hostname = zone.guiderank-app.com

