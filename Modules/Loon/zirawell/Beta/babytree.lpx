#!name=宝宝树 - BABYTREE
#!desc=宝宝树孕育-备孕怀孕育儿专用软件
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id523063187
#!bundleId=com.babytree.pregnancy
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,m.meitun.com,REJECT
DOMAIN,adx.babytree.com,REJECT
DOMAIN,adx-backend.babytree.com,REJECT
DOMAIN,ads.babytree.com,REJECT
DOMAIN,bbtads.babytree.com,REJECT
DOMAIN,tracking.babytree.com,REJECT
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN,titan.babytree.com,REJECT
DOMAIN,titan01.babytree.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.babytree\.com\/api\/(?>advertising|mobile_activity)/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.babytree\.com\/preg_intf\/index_content\/index_banner/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_tool\/api\/feeding_record\/get_home_banner_info/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/feeds/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_tool\/api\/tools\/get_third_privacy_msgbox_list/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/app_index\/get_ceramic_chip_area/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/index_activity/i then reject(200)
request if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/cms_second_tab\/topic_tab_list/i then reject(200)
response if ${url} ~= /^https?:\/\/plough\.babytree\.com\/plough\.do/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mapiweb\.babytree\.com\/newapi\/luban\/behavior\/receive/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/go\.babytree\.com\/go_pregnancy\/api\/(?>app_index|cms_column)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/babytree/zirawell_babytree.js") with tag="babytree", requires_body=true

[MITM]
hostname = go.babytree.com, api.babytree.com, plough.babytree.com, mapiweb.babytree.com

