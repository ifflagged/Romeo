#!name=华住会 - HUAZHU
#!desc=华住会
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id556808349
#!bundleId=com.htinns.iphone
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-28

[Rule]
DOMAIN,apm-api.huazhu.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/appapi\.huazhu\.com:\d+\/client\/app\/getAppStartPage\//i then reject(200)
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/start\/getAppStartPage/i then reject(200)
response if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/home\/queryRecommond/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/{1,2}home\/(?>queryNewNotice|querySelectHotel|queryHotelBrand|queryMall|huazhuWorld)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/bundle\/upgrade\/check/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\//i then response.body.mock("json", "{}", 200)

[MITM]
hostname = appapi.huazhu.com, hweb-hotel.huazhu.com, hweb-manager.huazhu.com

