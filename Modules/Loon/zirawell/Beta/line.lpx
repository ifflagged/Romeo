[Rewrite]
request if ${url} ~= /^https?:\/\/a\.line\.me\/lass\/api\/v\d\/ads$/i then reject(200)
request if ${url} ~= /^https?:\/\/a\.line\.me\/oa\/v\d\/e$/i then reject(200)
request if ${url} ~= /^https?:\/\/a\.line\.me\/cs\/v\d\/oa$/i then reject(200)
request if ${url} ~= /^https?:\/\/gw\.line\.naver\.jp\/ext\/lgfp\/lad\/v1$/i then reject(200)
request if ${url} ~= /^https?:\/\/gw\.line\.naver\.jp\/lass\/api\/v1\/ads$/i then reject(200)
request if ${url} ~= /^https?:\/\/gw\.line\.naver\.jp\/tr\/event$/i then reject(200)
request if ${url} ~= /^https?:\/\/legy\.line-apps\.com\/ext\/lgfp\/lad\/v1$/i then reject(200)
request if ${url} ~= /^https?:\/\/legy\.line-apps\.com\/ext\/smartch\/banner\/sch\/v1$/i then reject(200)
request if ${url} ~= /^https?:\/\/legy\.line-apps\.com\/tr\/event$/i then reject(200)
request if ${url} ~= /^https?:\/\/w\.line\.me\/adp\/api\/ad\/v\d\//i then reject(200)
request if ${url} ~= /^https?:\/\/buy\.line\.me\/api\/graphql\?variables/i then reject(200)
request if ${url} ~= /^https?:\/\/crs-event\.line\.me\/v\d\/imp/i then reject(200)
request if ${url} ~= /^https?:\/\/obs\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$/i then reject(200)
request if ${url} ~= /^https?:\/\/obs\.line-scdn\.net\/0hGH\d/i then reject(200)
request if ${url} ~= /^https?:\/\/obs\.line-scdn\.net\/0h.+\/\d+p\.mp4$/i then reject(200)
request if ${url} ~= /^https?:\/\/cix\.line-apps\.com\/R4\?/i then reject(200)
request if ${url} ~= /^https?:\/\/scdn\.line-apps\.com\/appresources\/moretab\/list\.json/i then reject(200)
request if ${url} ~= /^https?:\/\/scdn\.line-apps\.com\/lan\/image\/line\/bannerImageEvent\//i then reject(200)
request if ${url} ~= /^https?:\/\/scdn\.line-apps\.com\/lan\/document\/pageEvent\/line\/ios\//i then reject(200)
