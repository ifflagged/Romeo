request if ${url} ~= /^https?:\/\/static\.line-scdn\.net\/ad-sdk\//i then reject(200)
request if ${url} ~= /^https?:\/\/nelo2-col\.linecorp\.com\/_store$/i then reject(200)
^https?:\/\/a\.line\.me\/er\/lads\/v\d\/ei\? mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/a\.line\.me\/er\/l.*\/v\d\/event\/image mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/ad\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$ mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/obs\.line-scdn\.net\/r\/linecrs\/.+\/m180x180$ mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/d\.line-scdn\.net\/lcp-prod-photo\/20.+\.(?>jpg|jpeg|png) mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = a.line.me, ad.line-scdn.net, gw.line.naver.jp, legy.line-apps.com, w.line.me, buy.line.me, crs-event.line.me, obs.line-scdn.net, d.line-scdn.net, cix.line-apps.com, scdn.line-apps.com, sch.line.me, uts-front.line-apps.com, static.line-scdn.net, nelo2-col.linecorp.com

