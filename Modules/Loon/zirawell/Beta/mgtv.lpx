#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id629774477
#!bundleId=com.hunantv.imgotv
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,credits.bz.mgtv.com,REJECT
DOMAIN,credits2.bz.mgtv.com,REJECT
DOMAIN,credits3.bz.mgtv.com,REJECT
DOMAIN,dflow.bz.mgtv.com,REJECT
DOMAIN,encounter.bz.mgtv.com,REJECT
DOMAIN,floor.bz.mgtv.com,REJECT
DOMAIN,layer.bz.mgtv.com,REJECT
DOMAIN,vip.bz.mgtv.com,REJECT
DOMAIN,mob.bz.mgtv.com,REJECT
DOMAIN,rc-topic-api.bz.mgtv.com,REJECT
DOMAIN,rprain.bz.mgtv.com,REJECT
DOMAIN,rc-topic-api.bz.mgtv.com,REJECT
DOMAIN-SUFFIX,imgaliyun.res.mgtv.com,REJECT
DOMAIN-SUFFIX,pcvideoaliyun.titan.mgtv.com,REJECT
DOMAIN-SUFFIX,mobaliyun.res.mgtv.com,REJECT
DOMAIN-SUFFIX,pcvideoyd.titan.mgtv.com,REJECT
DOMAIN-SUFFIX,pcweb.v1.mgtv.com,REJECT
DOMAIN-SUFFIX,cmop.mgtv.com,REJECT
DOMAIN-SUFFIX,da.mgtv.com,REJECT
DOMAIN-SUFFIX,log.mgtv.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/[\d\.]+:\d{5}\/\?cmd=indexes/i then reject(200)
response if ${url} ~= /^https?:\/\/[\d\.]+\/odin\/c\d\/(channel\/ads|skin\/config)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/damang\.api\.mgtv\.com\/station\/album\/red\/dot\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/hb-boom\.api\.mgtv\.com\/release\/pullReleaseInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/v\d\/mobile\/checkUpdate\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mobileso\.bz\.mgtv\.com\/spotlight\/search\/v\d\?/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/me\.bz\.mgtv\.com\/v\d\/module\/list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/mob-st\.bz\.mgtv\.com\/odin\/c\d\/channel\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/dc2?\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/(index|vrsList)\/\w/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/config\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/v\d+\/video\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/mobile-thor\.api\.mgtv\.com\/v\d\/vod\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

response if ${url} ~= /^https?:\/\/mobileso\.bz\.mgtv\.com\/mobile\/recommend\/v\d\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js") with tag="mgtv", requires_body=true

[MITM]
hostname = *.mgtv.com

