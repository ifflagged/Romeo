[Rewrite]
response if ${url} ~= /^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/recommend/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/config\/getUpdatePopupConfig/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(?>api-cslp-emt|api\.globalstore)\.amazon\.cn\/gateway\/content\/widget\/(?>popup|floatingWindow)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = api-cslp-emt.amazon.cn, api.globalstore.amazon.cn

