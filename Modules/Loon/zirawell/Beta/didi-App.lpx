#!name=滴滴出行 - DIDI
#!desc=滴滴出行 - 打车骑车顺风车火车票租车代驾送货
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id554499054
#!bundleId=com.xiaojukeji.didi
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,adtrack.xiaojukeji.com,REJECT
IP-CIDR,123.207.209.39/32,REJECT,no-resolve
IP-CIDR,123.207.209.60/32,REJECT,no-resolve
IP-CIDR,139.199.240.12/32,REJECT,no-resolve
IP-CIDR,139.199.240.15/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/ut\.xiaojukeji\.com\/ut\/kappa\/api\/owner\/index\/dialog/i then reject(200)
response if ${url} ~= /^https?:\/\/ut\.xiaojukeji\.com\/ut\/kappa\/api\/owner\/index/i then response.body.replace(/banner_items/, "random_body")
response if ${url} ~= /^https?:\/\/hd\.xiaojukeji\.com\/d/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/ct\.xiaojukeji\.com\/agent\/v\d\/feeds/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/omgup\d?\.xiaojukeji\.com\/api/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/res\.xiaojukeji\.com\/resapi\/activity\/(?>m|xp)get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/as\.xiaojukeji\.com\/ep\/as\/conf\?ns=daijia-front&name=/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/freight\.xiaojukeji\.com\/gateway(?!\?api=freight\.p\.personal\.center)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.udache\.com\/gulfstream\/confucius\/api\/privacy\/app\/popList/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/pt-starimg\.didistatic\.com\/static\/starimg\/node\/.*.(?>jpg|png|gif)/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/other\/fast/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/didi-App/zirawell_didi.js") with tag="didi", requires_body=true

response if ${url} ~= /^https?:\/\/conf\.diditaxi\.com\.cn\/ota\/na\/yuantu\/infoList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/didi-App/zirawell_didi.js") with tag="didi", requires_body=true

response if ${url} ~= /^https?:\/\/common\.diditaxi\.com\.cn\/common\/v\d\/usercenter\/me/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/didi-App/zirawell_didi.js") with tag="didi", requires_body=true

response if ${url} ~= /^https?:\/\/api\.udache\.com\/gulfstream\/pre-sale\/v\d\/other\/pGetSceneList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/didi-App/zirawell_didi.js") with tag="didi", requires_body=true

[MITM]
hostname = hd.xiaojukeji.com, ct.xiaojukeji.com, omgup*.xiaojukeji.com, res.xiaojukeji.com, as.xiaojukeji.com, freight.xiaojukeji.com, ut.xiaojukeji.com, api.udache.com, pt-starimg.didistatic.com, conf.diditaxi.com.cn, common.diditaxi.com.cn

