[Rewrite]
response if ${url} ~= /^https?:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=cms\.htw\.delivery/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm\.fa\.(?>combineHomepageInfo|mallRecommend)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm\.fa\.homeConfig/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/didiqj/zirawell_wechatApplet.js") with tag="didiqj", requires_body=true

[MITM]
hostname = htwkop.xiaojukeji.com

