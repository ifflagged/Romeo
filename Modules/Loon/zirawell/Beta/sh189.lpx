[Rule]
DOMAIN,bigdata-behaviordata.189.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/m\.sh\.189\.cn\/business-appletapi\/packBinds\/getAadvertisement/i then reject(200)
response if ${url} ~= /^https?:\/\/m\.sh\.189\.cn\/business-appletapi\/applet\/query\/(?>items|banners|getAdItemList)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/m\.sh\.189\.cn\/business-appletapi\/packageQuery\/(?>getUserAdvertising|getLiveSessionList|getTop|getssplabelinfo|getsspmaterielinfo|sspQueryOperationInfo)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = m.sh.189.cn

