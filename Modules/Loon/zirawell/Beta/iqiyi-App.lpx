[Rewrite]
response if ${url} ~= /^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api(\/v\d)?\/show/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\?/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/[\d\.]+\/3f1\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/iqiyi-App/zirawell_cntv.js") with tag="iqiyi", requires_body=true

response if ${url} ~= /^https?:\/\/access\.if\.iqiyi\.com\/3f1\/cards\.iqiyi\.com\/(views_category\/3\.0\/category_home|views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/iqiyi-App/zirawell_cntv.js") with tag="iqiyi", requires_body=true

response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/(category_home|categorylib_content|film_hybrid)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/iqiyi-App/zirawell_cntv.js") with tag="iqiyi", requires_body=true

