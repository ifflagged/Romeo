response if ${url} ~= /^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/iqiyi-App/zirawell_cntv.js") with tag="iqiyi", requires_body=true

response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/iqiyi-App/zirawell_cntv.js") with tag="iqiyi", requires_body=true

