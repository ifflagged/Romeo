#!name=马蜂窝 - MAFENGWO
#!desc=马蜂窝-全球旅游攻略,旅行度假酒店预订
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id406596432
#!bundleId=cn.mafengwo.www
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,advert.mafengwo.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/(travelguide\/)?ad/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/widget\/note\/get_widget_note/i then reject(200)
request if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/push\/get_local_push_config/i then reject(200)
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/update\/check_update/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/system\/config\/(?>get|mark)_(?>push|alert)_config/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mapi\.mafengwo\.cn\/user\/profile\/get_(?>list|profile)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mafengwo/zirawell_mafengwo.js") with tag="mafengwo", requires_body=true

[MITM]
hostname = mapi.mafengwo.cn

