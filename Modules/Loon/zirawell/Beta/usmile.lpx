[Rewrite]
request if ${url} ~= /^https?:\/\/myusmile\.online\/user\/version\/requestFirmwareUpdate\//i then reject(200)
request if ${url} ~= /^https?:\/\/www\.myusmile\.online\/user\/userTagRecord\/popup/i then reject(200)
response if ${url} ~= /^https?:\/\/myusmile\.online\/user\/version\/requestAppUpdate/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wemallh5\.usmile\.com\/api\/sp-portal\/store\/usmile\/activity\/dayCheck\?pop/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/www\.myusmile\.online\/user\/plaqueTopic\/selectByType/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/usmile/zirawell_usmile.js") with tag="usmile", requires_body=true

[MITM]
hostname = myusmile.online, wemallh5.usmile.com, www.myusmile.online

