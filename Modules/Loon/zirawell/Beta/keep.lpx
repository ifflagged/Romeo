#!name=keep - KEEP
#!desc=Keep - AI 运动教练
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id952694580
#!bundleId=com.gotokeep.keep
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN,hc-ssp.sm.cn,REJECT
DOMAIN,apm.gotokeep.com,REJECT
DOMAIN,kad.gotokeep.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d\/popup\/getPopUp/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/kprime\/v\d\/popups\/primeGuide/i then reject(200)
request if ${url} ~= /^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/api.gotokeep.com\/cauchy\/growth\/init/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/default\/keyword\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotword\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotCourse\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/ads/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/training\/box\/config/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/anno\/v\d\/upgrade\/check/i then reject(200)
response if ${url} ~= /^https?:\/\/static1\.keepcdn\.com\/ark_optimus\/202\d\/*\/*\/.*.(?>png|jpg)/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/athena\/v\d\/people\/my$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js") with tag="keep", requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/config\/v\d\/basic/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js") with tag="keep", requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/homepage\/v\d\/tab/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js") with tag="keep", requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/nuocha\/course\/v\d\/\w+\/preview/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js") with tag="keep", requires_body=true

response if ${url} ~= /^https?:\/\/api\.gotokeep\.com\/sportpage\/sport\/v\d\/mysport/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js") with tag="keep", requires_body=true

[MITM]
hostname = static1.keepcdn.com, api.gotokeep.com, kad.gotokeep.com

