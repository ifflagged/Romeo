[Rewrite]
response if ${url} ~= /^https?:\/\/ydmbpic\.yundasys\.com\/opserver\/statics\/uniAppImage\/selfCenter\/rightsPop/i then response.body.mock("json", "{}", 200)

[Script]
request if ${url} ~= /^https?:\/\/mbpxapi\.yundasys\.com(:\d+)?\/gateway\/interface/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/yunda/zirawell_yunda.js") with tag="yunda", requires_body=true

[MITM]
hostname = ydmbpic.yundasys.com, mbpxapi.yundasys.com

