[Script]
response if ${url} ~= /^https?:\/\/tf\d+\.istrongcloud\.com\/member\/v[0-9.]+\/home/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tflj/zirawell_tflj.js") with tag="tflj", requires_body=true

response if ${url} ~= /^https?:\/\/tf\d+\.istrongcloud\.com\/data\/commonConfig\/typhoon-mp-config\/webModuleConfig/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tflj/zirawell_tflj.js") with tag="tflj", requires_body=true

[MITM]
hostname = tf*.istrongcloud.com

