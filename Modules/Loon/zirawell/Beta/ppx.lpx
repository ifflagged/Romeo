[Script]
response if ${url} ~= /^https?:\/\/.+\.pipix\.com\/bds\/feed\/channel_list\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ppx/zirawell_ppx.js") with tag="ppx", requires_body=true

response if ${url} ~= /^https?:\/\/.+\.pipix\.com\/bds\/user\/check_in\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ppx/zirawell_ppx.js") with tag="ppx", requires_body=true

[MITM]
hostname = *.pipix.com

