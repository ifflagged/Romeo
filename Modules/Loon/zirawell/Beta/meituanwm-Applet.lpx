#!name=meituanwm-Applet
#!desc=meituanwm-Applet
#!icon=icon not found
#!tag=zirawell

[Rewrite]
response if ${url} ~= /^https?:\/\/npay\.meituan\.com\/conch\/flow\/mypage-wallet-info/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/npay\.meituan\.com\/conch\/walletv\d\/wechat-pop-window/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/web\.meituan\.com\/newUser\/returnMoney\/popWindow/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/my\/(?>novelZone|resources)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/meituanwm-Applet/zirawell_meituanwm.js") with tag="meituanwm", requires_body=true

response if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/index\/aggregate/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/meituanwm-Applet/zirawell_meituanwm.js") with tag="meituanwm", requires_body=true

[MITM]
hostname = npay.meituan.com, web.meituan.com

