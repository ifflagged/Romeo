[Rewrite]
response if ${url} ~= /^https?:\/\/www\.onstar\.com\.cn\/mssos\/sos\/social\/v\d\/community\/article\/page/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.shanghaionstar\.com\/sos\/contentinfo\/v\d\/public\/landingpage/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = www.onstar.com.cn, api.shanghaionstar.com

