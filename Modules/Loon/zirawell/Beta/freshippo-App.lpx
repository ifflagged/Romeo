[Rule]
IP-CIDR,59.82.14.1/32,REJECT,no-resolve
IP-CIDR,59.82.14.161/32,REJECT,no-resolve
IP-CIDR,59.82.34.147/32,REJECT,no-resolve
IP-CIDR,59.82.34.255/32,REJECT,no-resolve
IP-CIDR,59.82.113.219/32,REJECT,no-resolve
IP-CIDR,59.82.113.10/32,REJECT,no-resolve
IP-CIDR,139.95.0.151/32,REJECT,no-resolve
IP-CIDR,139.95.4.98/32,REJECT,no-resolve
IP-CIDR,47.246.103.9/32,REJECT,no-resolve
IP-CIDR,47.246.103.10/32,REJECT,no-resolve
IP-CIDR,203.119.238.164/32,REJECT,no-resolve
IP-CIDR,203.119.238.63/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch\?appkey=23230111/i then reject(200)
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.hippotown\.tabbar\.info/i then reject(200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.alibaba\.emas\.publish\.update\.get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.sg\.querysinglescene/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.render\.querysinglepage/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.fc\.recommend\.feedscommondservice/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.crm\.platform\.ma\.recommend/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.mimir\.recommend(?!\.hgitems)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.render\.query(?>indexpage|mypage|tabfeedstream)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/freshippo-App/zirawell_freshippo.js") with tag="freshippo", requires_body=true

[MITM]
hostname = amdc.m.taobao.com, acs.m.taobao.com, acs-m.freshippo.com

