[Rewrite]
response if ${url} ~= /^https?:\/\/dynamicad\.kfc\.com\.cn\/api/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/res\.kfc\.com\.cn\/CRM\/kfcad\/custom_v\d\/wxapp/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = dynamicad.kfc.com.cn, res.kfc.com.cn

