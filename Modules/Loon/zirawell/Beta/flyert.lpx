#!name=flyert
#!desc=flyert
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=advis/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=basicdata&type=appinfo/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=basicdata&type=forumlist/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/Script-Hub-Org_replace-body.js", "adv-%3Eadv0") with tag="replaceBody", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=threadpost/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/Script-Hub-Org_replace-body.js", "relatedrecommend-%3Erelatedrecommend0") with tag="replaceBody", timeout=30, requires_body=true

response if ${url} ~= /^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*plugin/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert/zirawell_flyert.js") with tag="flyert", timeout=60, requires_body=true

[MITM]
hostname = www.flyert.com, www.flyert.com.cn, www.flyertrip.com, www.flyertrip.com.cn

