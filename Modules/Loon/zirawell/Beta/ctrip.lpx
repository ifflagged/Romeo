#!name=ctrip
#!desc=ctrip
#!icon=icon not found
#!tag=zirawell

[Script]
response if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js") with tag="携程旅行-Cookie"

cron "5 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js") with tag="携程旅行-签到"

response if ${url} ~= /^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js") with tag="ctrip", timeout=60, requires_body=true

[MITM]
hostname = m.ctrip.com

