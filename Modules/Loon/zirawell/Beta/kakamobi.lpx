[Rewrite]
request if ${url} ~= /^https?:\/\/\w+\.kakamobi\.cn\/api\/open\/v\d\/advert-sdk\//i then reject(200)
request if ${url} ~= /^https?:\/\/mcbd\.maiche\.com\/api\/open\/v\d\/user\/get-popup-window/i then reject(200)
response if ${url} ~= /^https?:\/\/swallow\.kakamobi\.cn\/api\/open\/config\/get-config/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/monkey\.kakamobi\.cn\/api\/open\/live\/get-recommend-live-protocol/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/jiaxiao-awd\.kakamobi\.cn\/api\/h5\/v\d\/home-lead-advertise\/abtest/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/jiakao-misc\.kakamobi\.cn\/api\/open\/my-tab-config\/(?>banner|selection)-list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/squirrel\.kakamobi\.cn\/api\/open\/recommend-goods\/get-my-page-banner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/monkey\.kakamobi\.cn\/api\/open\/live-room\/get-resource/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cheyouquan\.kakamobi\.com\/api\/open\/group\/recommend-subscribe-tag/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mcbd\.maiche\.com\/api\/open\/v\d\/jiakao-business\/get-naben-advert/i then response.body.mock("json", "{}", 200)
^https?:\/\/smart\.789\.image\.mucang\.cn\/advert mock-response-body data-type=tiny-gif status-code=200

[MITM]
hostname = *.kakamobi.cn, cheyouquan.kakamobi.com, mcbd.maiche.com, smart.789.image.mucang.cn

