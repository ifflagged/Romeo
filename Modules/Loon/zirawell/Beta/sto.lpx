[Rewrite]
response if ${url} ~= /^https?:\/\/customer-app\.sto\.cn\/api\/app\/banner\/banner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/sto-customer-app\.oss-cn-shanghai\.aliyuncs\.com\/images/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = customer-app.sto.cn, sto-customer-app.oss-cn-shanghai.aliyuncs.com

