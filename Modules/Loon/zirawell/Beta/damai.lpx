[Rewrite]
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup/i then reject(200)
request if ${url} ~= /^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch\?appkey=23782110/i then reject(200)
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome/i then response.body.mock("text", "", 200)

[MITM]
hostname = acs.m.taobao.com, amdc.m.taobao.com

