[Rewrite]
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.eleme\.miniapp\.homepage/i then response.body.replace(/wechat_miniapp_scene_card_template/, "zirawell")
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.eleme\.homepage\.miniapp\.popup/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = waimai-guide.ele.me

