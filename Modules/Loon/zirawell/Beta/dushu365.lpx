[Rule]
DOMAIN,popup.dushu365.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/chief-orch\/config\/config\/v\d+\/(shortCut|appUpdateUnite|loadingAd|appConfig)/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/fandeng-orch\/dual2211\/config/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/fandeng-orch\/bookboy\/v\d+\/vipPagePop/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/fdtalk-orch\/newcomerzone\/v\d+\/guide/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/fs-retain\/trialVip\/v\d+\/requestTrialVipPopDoNotSendReward/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/resource-orchestration-system\/vipLandingPage\/v\d+\/getVipLandingPageApp/i then reject(200)
request if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/order-orchestration\/orderWeb\/exchange\/v\d+\/showExchangeButton/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/chief-orch\/home\/bookPortal\/v105\/category/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/abtest-front\/banner-modular\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/resource-orchestration-system\/book\/channel\/v100\/info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/fs-member\/user\/profile\/v100\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/chief-orch\/home\/bookPortal\/v111\/forApp/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/sns-orchestration-system\/homePage\/api\/v100\/myPage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/task-orchestration\/taskCenter\/api\/v101\/taskList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/resource-orchestration-system\/book\/v101\/content/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

response if ${url} ~= /^https?:\/\/g(.*)\.dushu365\.com\/user-orchestration\/user\/api\/v101\/ceiltip/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/dushu365/zirawell_dushu365.js") with tag="dushu365", requires_body=true

[MITM]
hostname = g*.dushu365.com

