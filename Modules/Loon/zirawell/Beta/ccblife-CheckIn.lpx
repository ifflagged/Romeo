#!name=ccblife-CheckIn
#!desc=ccblife-CheckIn
#!icon=icon not found
#!tag=zirawell

[Script]
request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js") with tag="建行生活-Cookie", requires_body=true

cron "17 7 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js") with tag="建行生活-签到", timeout=60

request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/(clp_coupon|clp_service)\/txCtrl\?txcode=(A3341A038|autoLogin)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-CheckIn/zirawell_ccblife.js") with tag="ccblife", timeout=60, requires_body=true

[MITM]
hostname = yunbusiness.ccb.com

