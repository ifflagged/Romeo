#!name=买单吧 - BANKCOMM
#!desc=买单吧-交通银行信用卡
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1057446665
#!bundleId=com.bankcomm.maidanba
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,track.bankcomm.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/creditcard.*\.bankcomm\.(com|cn)\/.*Ads\.do/i then reject(200)
request if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/mappweb_interaction\/common\/globalNotify/i then reject(200)
request if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/mappweb_interaction\/qryHighRiskUser/i then reject(200)
request if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/mappweb_collection/i then reject(200)
^https?:\/\/creditcard\.bankcomm\.(com|cn)\/tfimg\/public00\/M00\/4C\/6F mock-response-body data-type=tiny-gif status-code=200
^https?:\/\/creditcard\.bankcomm\.(com|cn)\/tofimg\/bucket-pj-btss-tfcn-dmz\/OSS-F\/a8f2e8 mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/CnsvMdbaptFinclipWeb/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/mappweb_interaction\/appInfo\/appNewestVersion/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/mappweb\/homepage(\/discovery)?\/promote/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.(com|cn)\/rcg\/index\.html\?callbackurl=rcg\/index\.html&orclogin=1&/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mdb/zirawell_mdb.js") with tag="mdb", requires_body=true

[MITM]
hostname = *.bankcomm.com, *.bankcomm.cn

