[Rewrite]
request if ${url} ~= /^https?:\/\/res\.pizzahut\.com\.cn\/CRM\/phad\/apphome\/apphome/i then reject(200)
response if ${url} ~= /^https?:\/\/res\.pizzahut\.com\.cn\/CRM\/phad\/member\/app\/member/i then response.body.mock("text", "", 200)

[MITM]
hostname = res.pizzahut.com.cn

