#!bundleId=com.cmbchina.MPBBank
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-09-09

[Rule]
DOMAIN,log.cmbchina.com,REJECT
DOMAIN,mbads.paas.cmbchina.com,REJECT
DOMAIN,yl.zh.cmbchina.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/mobile\.cmbchina\.com\/gexternal/i then reject(200)
request if ${url} ~= /^https?:\/\/mobile\.cmbchina\.com\/icornucopia\/accompany\/slot/i then reject(200)
response if ${url} ~= /^https?:\/\/webappcfg\.paas\.cmbchina\.com\/v\d\/func\/getmarketconfig/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/mobile\.cmbchina\.com\/dcardmanage\/salary-welfare\/get-recommend/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/cmb/zirawell_cmb.json", 200)

[MITM]
hostname = webappcfg.paas.cmbchina.com, mobile.cmbchina.com

