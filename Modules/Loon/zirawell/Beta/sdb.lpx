#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,dwtracking.jk.cn,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/nps\/feedback\//i then reject(200)
request if ${url} ~= /^https?:\/\/b\.pingan\.com\.cn\/arch\/webtrends3\/collector-core/i then reject(200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/app_com\/adversdk/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https:\/\/cdn\.sdb\.com\.cn\/ibank\/upgrade\/plugins\/upgradefile\.ios\.simplify/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/magic-module-sprite\/general-banner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/magic-module-sprite\/dialog-normal/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/pb\/pb-plugins-recomend-content/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/pb\/pb-plugins-rec-content-list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/pb\/pb-plugins-rec-mivideo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/rsb\.pingan\.com\.cn\/brcp\/stp\/cust\/mobile\/source\/upgrade/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/rsb\.pingan\.com\.cn\/brcp\/bds\/cust\/ygfz\/up/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/bron-coms\/bron-coms\/material-image/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/sdb/zirawell_sdb.js") with tag="sdb", requires_body=true

[MITM]
hostname = cdn.sdb.com.cn, rsb.pingan.com.cn, b.pingan.com.cn

