#!name=腾讯视频 Cookie
#!desc=此远程订阅用于解决任务脚本的cookie获取
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!tag=Cookie
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-10

[Script]
request if ${url} ~= /^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.new_task_system\.task_system\.TaskSystem\/ReadTaskList\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/txtv-Plugin/zirawell_txtv.js") with tag="txtv"

request if ${url} ~= /^https?:\/\/pbaccess\.video\.qq\.com\/trpc\.videosearch\.hot_rank\.HotRankServantHttp\/HotRankHttp/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/txtv-Plugin/zirawell_txtv.js") with tag="txtv"

request if ${url} ~= /^https?:\/\/pbaccess\.video\.qq.\com\/trpc\.video_account_login\.web_login_trpc\.WebLoginTrpc\/NewRefresh/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/txtv-Plugin/zirawell_txtv.js") with tag="txtv", requires_body=true

[MITM]
hostname = vip.video.qq.com, pbaccess.video.qq.com

