[Rule]
DOMAIN-SUFFIX,anythinktech.com,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT
DOMAIN-SUFFIX,mob.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\d\.bybutter\.com\/v\d\/app\/placements\/\d\/advertisements/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/api\d\.bybutter\.com\/v\d/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bybutter/zirawell_bybutter.js") with tag="bybutter", requires_body=true

[MITM]
hostname = api*.bybutter.com

