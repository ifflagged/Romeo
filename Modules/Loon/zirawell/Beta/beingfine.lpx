[Rewrite]
response if ${url} ~= /^https?:\/\/(img|hwimg)\.beingfine\.cn\/(?>float_button|card)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/hwimg\.beingfine\.cn\/(?>card|Channel)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/learnywhere\.cn\/api\/activity\/23\/423dsj\/inapp\/bb\/promote/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = hwimg.beingfine.cn, learnywhere.cn

