#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/appapi\.51job(app)?\.com\/api\/market\/(?>adtrace|get_launch|get_prompt)/i then reject(200)
request if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/guide\/home-page-top/i then reject(200)
request if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/user-task\/user\/task\/init/i then reject(200)
request if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/launch-hub\/open\/noauth\/popUp/i then reject(200)
request if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/index\/recommend-infos/i then reject(200)
response if ${url} ~= /^https?:\/\/appapi\.51job(app)?\.com\/api\/util\/get_version/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/noauth\/index\/last-version/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/index\/notice-infos/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/noauth\/recommend\/job-tab-dynamic/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/51job/zirawell_51job.js") with tag="51job", requires_body=true

response if ${url} ~= /^https?:\/\/cupid\.51job(app)?\.com\/open\/my-page\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/51job/zirawell_51job.js") with tag="51job", requires_body=true

[MITM]
hostname = appapi.51job*.com, cupid.51job*.com

