[Rewrite]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/v\d\/zzinfoshow\/getchoicegoodsinfos/i then response.body.replace(/infoData/, "random_body")
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/userred\?scene=homePage/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhuanzhuan-App/zirawell_zhuanzhuan.js") with tag="zhuanzhuan", requires_body=true

[MITM]
hostname = app.zhuanzhuan.com

