[Rewrite]
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v\d\/IosStart\/getStartInfo/i then reject(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v\d\/activity\/advertisement/i then reject(200)

[MITM]
hostname = mime.baidu.com

