#!name=flyert-CheckIn
#!desc=flyert-CheckIn
#!icon=icon not found
#!tag=zirawell

[Script]
request if ${url} ~= /^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js") with tag="飞客-Cookie"

cron "10 0 * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js") with tag="飞客-签到"

request if ${url} ~= /^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-CheckIn/zirawell_flyert.js") with tag="flyert", timeout=60

[MITM]
hostname = www.flyert.com.cn

