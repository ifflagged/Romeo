[Script]
http-response ^^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-CheckIn/zirawell_amap.js, tag=高德打车-Cookie

cron "1 0 * * *" script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/amap-CheckIn/zirawell_amap.js, tag=高德打车-签到

