#!name=薄荷健康 - BOOHEE
#!desc=薄荷健康-减肥健身轻断食
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id457856023
#!bundleId=com.boohee.food
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.boohee\.(?>cn|com).*(?>notification_template|advertisements|share_contents|app_square|plugins|notifications|start_up_with_ad|float_ad|data_file_entrance)/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.boohee\.com\/app-interface\/v\d\/ad\/info/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/meta-interface\/v\d\/index\/record_index/i then response.body.replace(/articles/, "random_body")
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/shop-interface\/api\/v\d\/home\/index/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn\/api\/v\d\/sfo\/user_popup_configs/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/meta-interface\/v\d\/index\/(?>discover_chosen|page_float_bubbles|sensor-banners|tool_buttons)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/app-interface\/v\d\/record\/record_tool(_pop)?_ad/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/app-interface\/v\d\/search\/search\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/status\.boohee\.com\/api\/v\d\/merged_messages$/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.boohee\.com\/meta-interface\/v\d\/index\/plaza-flow\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/boohee/zirawell_boohee.js") with tag="boohee", requires_body=true

response if ${url} ~= /^https?:\/\/api\.boohee\.com\/meta-interface\/v\d\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/boohee/zirawell_boohee.js") with tag="boohee", requires_body=true

response if ${url} ~= /^https?:\/\/api\.boohee\.com\/meta-interface\/v\d\/index\/plaza\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/boohee/zirawell_boohee.js") with tag="boohee", requires_body=true

response if ${url} ~= /^https?:\/\/api\.boohee\.com\/open-interface\/v\d\/string\/market_page\?title=metabolism_config$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/boohee/zirawell_boohee.js") with tag="boohee", requires_body=true

[MITM]
hostname = *.boohee.com, *.boohee.cn, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn

