#!name=叮咚买菜 - DDXQ
#!desc=叮咚买菜——品质之爱
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id768082524
#!bundleId=com.mmbang.neighborhood
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,trackercollect.ddxq.mobi,REJECT
DOMAIN,ddfs-public.ddimg.mobi,REJECT
DOMAIN,rttrack.ddxq.mobi,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\//i then reject(200)
request if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop/i then reject(200)
request if ${url} ~= /^https?:\/\/gw\.api\.ddxq\.mobi\/vip-app-service\/vip\/my\/page\/advertising/i then reject(200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails/i then response.body.replace(/suspension/, "random_body")
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/queryMyPagePopup/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/cart\/vipGuide/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/(?>bottomNavi|homeFlowDetail)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ddxq/zirawell_ddxq.js") with tag="ddxq", requires_body=true

response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ddxq/zirawell_ddxq.js") with tag="ddxq", requires_body=true

response if ${url} ~= /^https?:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v\d\/user\/queryMyPage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ddxq/zirawell_ddxq.js") with tag="ddxq", requires_body=true

[MITM]
hostname = maicai.api.ddxq.mobi, gw.api.ddxq.mobi, user.api.ddxq.mobi

