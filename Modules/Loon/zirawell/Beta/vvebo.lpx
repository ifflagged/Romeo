#!name=vvebo
#!desc=vvebo
#!icon=icon not found
#!tag=zirawell

[Script]
request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js") with tag="VVebo_Repair", timeout=60

request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js") with tag="VVebo_Repair", timeout=60

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js") with tag="VVebo_Repair", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js") with tag="VVebo_Repair", timeout=60, requires_body=true

[MITM]
hostname = api.weibo.cn

