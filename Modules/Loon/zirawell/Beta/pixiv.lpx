#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,open-pixon.ads-pixiv.net,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/d\.socdm\.com\/adsv\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/app-api\.pixiv\.net\/v\d\/application-info\/ios/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = d.socdm.com, app-api.pixiv.net

