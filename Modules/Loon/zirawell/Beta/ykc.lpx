#!name=ykc
#!desc=ykc
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,et.ykccn.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/gw3\.ykccn\.com\/activityServer\/app\/commandAd/i then reject(200)
^https?:\/\/web-stable-cdn\.ykccn\.com\/sp-img-2023\/common\/weCom-open mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/appAdvertising\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/gw3\.ykccn\.com\/api\/omp\/mt\/charge\/activity\/package\/newest/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = web-stable-cdn.ykccn.com, gw3.ykccn.com

