[Rewrite]
response if ${url} ~= /^https?:\/\/mall\.meituan\.com\/api\/c\/homepage\/splash/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = mall.meituan.com

