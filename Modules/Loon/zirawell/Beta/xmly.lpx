#!name=xmly
#!desc=xmly
#!icon=icon not found
#!tag=zirawell

[Rule]
DOMAIN,adbehavior.ximalaya.com,REJECT
DOMAIN,adwbs.ximalaya.com,REJECT
DOMAIN-SUFFIX,ad.test.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.test.ximalaya.com,REJECT
DOMAIN-SUFFIX,adweb.test.ximalaya.com,REJECT
DOMAIN-SUFFIX,adweb.ximalaya.com,REJECT
DOMAIN-SUFFIX,linkeye.ximalaya.com,REJECT
DOMAIN-SUFFIX,location.ximalaya.com,REJECT
DOMAIN-SUFFIX,xdcs-collector.ximalaya.com,REJECT
DOMAIN-SUFFIX,ad.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.wsa.ximalaya.com,REJECT
DOMAIN-SUFFIX,adbehavior.wsa.ximalaya.com,REJECT
DOMAIN-SUFFIX,adsebs.ximalaya.com,REJECT
DOMAIN-SUFFIX,adbs.ximalaya.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/discovery-feed\/focus\/queryF/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/mobile-playpage\/view\//i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/chaos-notice-web\/v1\/message\/preview\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/social-web\/bottomTabs\/dynamicEntrance\/status/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xmcdn\.com\/\w{8}\/\w{4}-\w{16}\/.+gif$/i then reject(200)
request if ${url} ~= /^https?:\/\/gslb.*\.xima.*\.com\//i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/(dog-portal\/checkOld|(child-mobile\/child|aged-mobile\/aged)\/mode\/query)/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/discovery-feed\/isShowUserGiftPendant/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/mobile-user\/unread/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/mobile-user\/minorProtection\/pop/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/collector\/xl\/v\d/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/butler-portal\/versionCheck/i then reject(200)
request if ${url} ~= /^https?:\/\/(adse\.wsa|adse|adbehavior|xdcs-collector)\.xima.*\.com\/.*/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/mobile\/discovery\/v\d\/location/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/hotWord/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/(hub)?guideWord/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/api\/v\d\/adRealTime/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/ting\/(?>loading|feed|home)?/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/discovery-category\/customCategories/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly/zirawell_xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/focus-mobile\/focusPic/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly/zirawell_xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/discovery-feed\/v\d\/mix/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly/zirawell_xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/discovery-category\/v\d\/category/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly/zirawell_xmly.js") with tag="xmly", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/.*\.xima.*\.com\/mobile-user\/v\d\/homePage/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmly/zirawell_xmly.js") with tag="xmly", timeout=60, requires_body=true

[MITM]
hostname = *.xima*.*.com, *.xmcdn.com

