#!name=xiaotucc
#!desc=xiaotucc
#!icon=icon not found
#!tag=zirawell

[Rewrite]
request if ${url} ~= /^https?:\/\/ad\.xiaotucc\.com\/advert/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/mapi\.xiaotucc\.com\/(mall\/main|\w+\/main_page\/index\/getActivity)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xiaotucc/zirawell_wechatApplet.js") with tag="xiaotucc", requires_body=true

[MITM]
hostname = ad.xiaotucc.com, mapi.xiaotucc.com

