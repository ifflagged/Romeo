[Rewrite]
response if ${url} ~= /^https?:\/\/choicegw\.eastmoney\.com\/ads\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/innovactivity\.eastmoney\.com\/api\/app\/activity\/start/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/choicegw2\.eastmoney\.com\/app\/report\/web\/homePage\/getRecommendedInfoList/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = choicegw.eastmoney.com, innovactivity.eastmoney.com, choicegw2.eastmoney.com

