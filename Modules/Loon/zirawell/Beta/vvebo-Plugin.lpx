#!name=VVebo Repair
#!desc=此远程订阅用于修复用户主页时间线问题
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!tag=Repair
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-09-18

[Script]
request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo-Plugin/zirawell_VVebo_Repair.js") with tag="vvebo"

request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo-Plugin/zirawell_VVebo_Repair.js") with tag="vvebo"

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo-Plugin/zirawell_VVebo_Repair.js") with tag="vvebo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo-Plugin/zirawell_VVebo_Repair.js") with tag="vvebo", requires_body=true

[MITM]
hostname = api.weibo.cn

