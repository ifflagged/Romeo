#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/discovery-feed\/list/i then response.json.jq(".data |= map(select(.type == \"DISCOVERY_EPISODE_RECOMMEND\" or .type == \"EDITOR_PICK\"))")
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai-summary/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/membership\/platform/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get-(?>preset|express)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category\/list-daily-suggestion/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = api.xiaoyuzhoufm.com

