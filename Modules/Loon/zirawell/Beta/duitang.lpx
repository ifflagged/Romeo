[Rewrite]
response if ${url} ~= /^https?:\/\/api\.duitang\.com\/napi\/infra\/settings\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.duitang\.com\/napi\/vienna\/daren\/daren\/recommend\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/(www|api)\.duitang\.com\/napi\/ad/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(www|api)\.duitang\.com\/napi\/settings\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/duitang/zirawell_duitang.js") with tag="duitang", requires_body=true

[MITM]
hostname = api.duitang.com, www.duitang.com

