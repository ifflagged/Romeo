#!name=微信 - WECHAT
#!desc=微信
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id414478124
#!bundleId=com.tencent.xin
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,badjs.weixinbridge.com,REJECT
DOMAIN,cube.weixinbridge.com,REJECT
DOMAIN,dns.weixin.qq.com.cn,REJECT
DOMAIN-SUFFIX,wxs.qq.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/payapp\.weixin\.qq\.com\/mchopenapp\/goldplan\/adpage/i then reject(200)
response if ${url} ~= /^https?:\/\/dl\.wechat\.com\/checkresupdate/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mp\.weixin\.qq\.com\/mp\/(?>ad_|advertisement|getappmsgad|cps_product_info|masonryfeed|relatedarticle|relatedsearchword|searchkeywordreport|geticon|getainfo|jsmonitor)/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/wechat/zirawell_Wechat_Unblock_URL.js") with tag="wechat", requires_body=true

[MITM]
hostname = dl.wechat.com, payapp.weixin.qq.com, mp.weixin.qq.com, weixin110.qq.com, security.wechat.com

