[Rule]
DOMAIN,richmanapi.jxedt.com,REJECT
DOMAIN,richmanmain.jxedt.com,REJECT
DOMAIN,richmanrules.jxedt.com,REJECT
DOMAIN,richmanapi.ksedt.com,REJECT
DOMAIN,richmanmain.ksedt.com,REJECT
DOMAIN,richmanrules.ksedt.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.jxedt\.com\/ad\//i then reject(200)
^https?:\/\/api\.jxedt\.com\/jump\/EMiCcDNp mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/gouche\.ksedt\.com\/config\/popup\//i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/op\.ksedt\.com\/jxedtLive\/liveIntroduceResource/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = api.jxedt.com, gouche.ksedt.com, op.ksedt.com

