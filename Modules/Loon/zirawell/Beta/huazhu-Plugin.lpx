[Script]
request if ${url} ~= /^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/huazhu-Plugin/zirawell_huazhu.js") with tag="huazhu"

[MITM]
hostname = hweb-personalcenter.huazhu.com

