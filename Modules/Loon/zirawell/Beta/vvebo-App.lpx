[Script]
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/users\/show\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/vvebo.js") with tag="vvebo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/vvebo.js") with tag="vvebo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/vvebo.js") with tag="vvebo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/vvebo.js") with tag="vvebo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/vvebo.js") with tag="vvebo", requires_body=true

[MITM]
hostname = api.weibo.cn

