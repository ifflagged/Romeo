#!name=腾讯新闻 - TXNEWS
#!desc=腾讯新闻
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id399363156
#!bundleId=com.tencent.info
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN,news.ssp.qq.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/r\.inews\.qq\.com\/(?>adsBlacklist|getFullScreenPic|getQQNewsRemoteConfig)/i then reject(200)
request if ${url} ~= /^https?:\/\/r\.inews\.qq\.com\/(?>getBannerAds|getNewsRemoteConfig|getSplash|searchHotCatList|upLoadLoc)/i then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/r\.inews\.qq\.com\/gw\/page\/(?>event_detail|channel_feed)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/txnews/zirawell_txnews.js") with tag="txnews", requires_body=true

[MITM]
hostname = r.inews.qq.com

