[Rewrite]
response if ${url} ~= /^https?:\/\/mgesq\.api\.mgtv\.com\/v\d\/goods\/guess_you_like/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mgesq\.api\.mgtv\.com\/v\d\/user\/center\/icon/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mgesq\.api\.mgtv\.com\/search\/goods\/rank/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/mgesq\.api\.mgtv\.com\/user\/center\/config/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mgesq\.api\.mgtv\.com\/dsl\/index\.+/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/xmgtv/zirawell_xmgtv.js") with tag="xmgtv", requires_body=true

[MITM]
hostname = mgesq.api.mgtv.com

