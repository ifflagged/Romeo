#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/adv/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/booksearch\/hotWords/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/bookshelf\/get(?>ad|TopOperation)/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/client\/(?>getsplashscreen|iosad)/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/dailyrecommend\/recommendBook/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/freshman\/bookshelfbtn/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/maintain\/playstrip$/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/message\/getpushedmessagelist$/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/push\/getdialog/i then reject(200)
request if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/young\/getconf$/i then reject(200)
response if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/followsubscribe/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/(deeplink\/geturl|client\/getconf|bookshelf\/getHoverAdv|dailyrecommend\/getdailyrecommend|assembly\/toolbar|user\/getaccountpage)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/qidian/zirawell_qidian.js") with tag="qidian", requires_body=true

[MITM]
hostname = mage.if.qidian.com, magev*.if.qidian.com

