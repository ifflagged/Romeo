[Script]
response if ${url} ~= /^https?:\/\/iosapi\.peiyinxiu\.com\/Api\/Film\/GetConfigValue/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/peiyinxiu/zirawell_peiyinxiu.js") with tag="peiyinxiu", requires_body=true

response if ${url} ~= /^https?:\/\/iosapi\.peiyinxiu\.com\/Api\/live\/LiveList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/peiyinxiu/zirawell_peiyinxiu.js") with tag="peiyinxiu", requires_body=true

response if ${url} ~= /^https?:\/\/iosapi\.peiyinxiu\.com\/api\/live\/FollowList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/peiyinxiu/zirawell_peiyinxiu.js") with tag="peiyinxiu", requires_body=true

response if ${url} ~= /^https?:\/\/iosapi\.peiyinxiu\.com\/Api\/Friend\/GetRecommendUsers/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/peiyinxiu/zirawell_peiyinxiu.js") with tag="peiyinxiu", requires_body=true

response if ${url} ~= /^https?:\/\/iosapi\.peiyinxiu\.com\/api\/Union\/HomeData/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/peiyinxiu/zirawell_peiyinxiu.js") with tag="peiyinxiu", requires_body=true

