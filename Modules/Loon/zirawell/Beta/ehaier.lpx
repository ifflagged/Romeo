#!name=海尔智家 - EHAIER
#!desc=海尔智家
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id982191521
#!bundleId=com.haier.uhome.Uplus
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN-SUFFIX,ehaier.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/dualstack-(arestapi|restios)\.amap\.com\/v\d\/iasdkauth\?key=/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/dualstack-logs\.amap\.com\/ws\/log\/upload\?product/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/oss-zjrs\.haier\.net\/resource\/confFile\/\d{22}\.zip$/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/api-gw\/shpmResource\/ad\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/api-gw\/shpmResource\/servicePage\/start\/advertising\?approach/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/api-gw\/shpmResource\/servicePage\/visualize\/recommend\?dataType/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/api-gw\/shpmResource\/servicePage\/weather\/query\?areaId/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/api-gw\/upmapi\/appmanage\/publish\/getRecommendVersion$/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/omsappapi\/ad\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/omsappapi\/resource\/v\d\/resBagList$/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/zj\.haier\.net\/omssceneapi\/house\/v\d\/recommend\/listByRoom$/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https?:\/\/oss-zjrs\.haier\.net\/resource\/confFile\/\d{22}\.json$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ehaier/zirawell_haier.js") with tag="ehaier", requires_body=true

response if ${url} ~= /^https?:\/\/zj\.haier\.net\/omsappapi\/resource\/v\d\/get\/resourceBag$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ehaier/zirawell_haier.js") with tag="ehaier", requires_body=true

[MITM]
hostname = dualstack*.amap.com, oss-zjrs.haier.net, zj.haier.net

