#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene/i then response.json.jq(".data.showShopEntry=false|.data.idolTabShow=true")
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList/i then response.json.jq(".data.musicList[] |= del(.showAd)")
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/resource\/recommend/i then response.json.jq(".data.resourceList[] |= del(.resource)")
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/voice\/room\/v\d\/sidebar/i then response.json.jq("(.data) = {}")
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/(\w+\/)?advert/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/.*popup/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/play\/listening\/entrance\/music\?musicId/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/banner/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/finds\/module/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = bd-api.kuwo.cn

