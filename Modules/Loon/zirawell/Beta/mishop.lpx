#!name=小米商城 - MISHOP
#!desc=小米商城
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1024958046
#!bundleId=com.xiaomi.mishop
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rewrite]
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/app\/start/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/(rec\/merge\/|skywheel\/mishop\/splash)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/app\/popup_info$/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/misearch\/search_input$/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/search\/search_default$/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/home\/page_feed(_v5)?$/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.m\.mi\.com\/v\d\/order\/expressView/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mishop/zirawell_mishop.js") with tag="mishop", requires_body=true

[MITM]
hostname = api.m.mi.com, shop-api.retail.mi.com

