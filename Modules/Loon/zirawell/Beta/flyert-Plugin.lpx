[Script]
request if ${url} ~= /^https?:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=getdata&.*/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/flyert-Plugin/zirawell_flyert.js") with tag="flyert"

[MITM]
hostname = www.flyert.com.cn

