[Rewrite]
response if ${url} ~= /^https?:\/\/delivery-api\.imdada\.cn\/\w+\/dada\/promote\/imax\?privacyParam/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/delivery-api\.imdada\.cn\/\w+\/transporter(\/screen)?\/ad/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = delivery-api.imdada.cn

