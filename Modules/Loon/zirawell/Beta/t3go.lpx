[Rewrite]
response if ${url} ~= /^https?:\/\/passenger\.t3go\.cn\/passenger-activity-api\/notoken\/api\/v\d\/resource\/getSource/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/passenger\.t3go\.cn\/(solution\-|common\-)?(passenger\-)?(activity\-|app\-)?api\/notoken\/(trip\/)?api\/(home\/|common\/)?(v\d\/)?(ad\/getNegativescreen|solution\/passenger\/open\/getHomeMenu|leftmenu|getHomeInfoGlobal)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = passenger.t3go.cn

