[Script]
response if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.whale\.modulet\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/goofish/zirawell_goofish.js") with tag="goofish", requires_body=true

