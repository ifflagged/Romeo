[Rewrite]
request if ${url} ~= /^https?:\/\/dili\.bdatu\.com\/jiekou\/ad\//i then reject(200)
response if ${url} ~= /^https?:\/\/wap\.ngchina\.cn\/news\/adverts\//i then response.body.mock("text", "", 200)

[MITM]
hostname = dili.bdatu.com, wap.ngchina.cn

