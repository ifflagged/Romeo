[Rewrite]
request if ${url} ~= /^https?:\/\/api\.douban\.com\/v\d\/app_ads\//i then reject(200)
request if ${url} ~= /^https?:\/\/api\.douban\.com\/b.*\/common_ads\?/i then reject(200)

[MITM]
hostname = api.douban.com

