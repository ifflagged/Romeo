#!name=SearchEngine
#!desc=SearchEngine
#!icon=icon not found
#!tag=zirawell
#!homepage=https://github.com/zirawell/R-Store
#!raw-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Rule/Surge/Redirect/SearchEngine.sgmodule
#!tg-group=https://t.me/RStoreCom
#!date=2024-11-27 20:24:00

[Rewrite]
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=yd\+([^&]+).+/i then redirect(302, "https://dict.youdao.com/search?q=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=tc\+([^&]+).+/i then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=zh-CN&text=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=te\+([^&]+).+/i then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=en&text=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=tj\+([^&]+).+/i then redirect(302, "https://translate.google.com/#view=home&op=translate&sl=auto&tl=ja&text=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=db\+([^&]+).+/i then redirect(302, "https://m.douban.com/search?query=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=zh\+([^&]+).+/i then redirect(302, "http://www.zhihu.com/search?q=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+/i then redirect(302, "https://github.com/search?q=$1")
undefined undefined undefined
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=ssp\+([^&]+).+/i then redirect(302, "https://sspai.com/search/post/$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=yt\+([^&]+).+/i then redirect(302, "https://www.youtube.com/results?search_query=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=bl\+([^&]+).+/i then redirect(302, "https://m.bilibili.com/search?keyword=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+/i then redirect(302, "https://www.baidu.com/s?wd=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+/i then redirect(302, "https://zh.wikipedia.org/wiki/$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=yh\+([^&]+).+/i then redirect(302, "https://greasyfork.org/zh-CN/scripts?q=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=gi\+([^&]+).+/i then redirect(302, "https://www.google.com/search?&tbm=isch&q=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=by\+([^&]+).+/i then redirect(302, "https://www.bing.com/search?q=$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=qm\+([^&]+).+/i then redirect(302, "https://www.qimai.cn/search/index/search/$1")
request if ${url} ~= /^https?:\/\/duckduckgo\.com\/\?q=dd\+([^&]+).+/i then redirect(302, "https://devdocs.io/#q=$1")

[MITM]
hostname = duckduckgo.com

