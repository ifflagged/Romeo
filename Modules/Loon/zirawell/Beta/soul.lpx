#!name=soul - SOUL
#!desc=Soul-年轻人的社交元宇宙
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1032287195
#!bundleId=com.soulapp.cn
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,ad-h5-cdn.soulapp.cn,REJECT
DOMAIN,ad-h5-station-cdn.soulapp.cn,REJECT
DOMAIN,ad-r.soulapp.cn,REJECT
DOMAIN,soul-ad.soulapp.cn,REJECT
DOMAIN,ad-reward.soulapp.cn,REJECT
DOMAIN-SUFFIX,cdn.soulapp.cn,REJECT
IP-CIDR,47.56.131.76/32,REJECT,no-resolve
IP-CIDR,47.97.215.55/32,REJECT,no-resolve
IP-CIDR,47.99.42.29/32,REJECT,no-resolve
IP-CIDR,120.27.235.201/32,REJECT,no-resolve
IP-CIDR,121.196.197.147/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/api-global\.soulapp\.me\/app\/open\/get/i then reject(200)
response if ${url} ~= /^https?:\/\/ssp\.soulapp\.cn\/api\/q/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-account\.soulapp\.cn\/teenager\/config/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api-chat\.soulapp\.cn\/chat\/entrance\/first/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api-a\.soulapp\.cn\/v\d\/post\/gift\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/api-a\.soulapp\.cn\/official\/scene\/module/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/api-user\.soulapp\.cn\/furion\/position\/content/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/api-pay\.soulapp\.cn\/vip\/meet\/userInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/api-pay\.soulapp\.cn\/privilege\/supervip\/status/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/post\.soulapp\.cn\/hot\/soul\/rank/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

response if ${url} ~= /^https?:\/\/gateway-mobile-gray\.soulapp\.cn\/mobile\/app\/version\/queryIos/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/soul/zirawell_soul.js") with tag="soul", requires_body=true

[MITM]
hostname = ssp.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, api-chat.soulapp.cn, api-user.soulapp.cn, api-pay.soulapp.cn, post.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-global.soulapp.me

