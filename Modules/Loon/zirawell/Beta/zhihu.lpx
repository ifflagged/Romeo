#!name=知乎 - ZHIHU
#!desc=知乎
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id432274380
#!bundleId=com.zhihu.ios
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-11

[Rule]
USER-AGENT,"AVOS*",REJECT
DOMAIN,appcloud.zhihu.com,REJECT
DOMAIN,appcloud2.in.zhihu.com,REJECT
DOMAIN,crash2.zhihu.com,REJECT
DOMAIN,mqtt.zhihu.com,REJECT
DOMAIN,sugar.zhihu.com,REJECT
DOMAIN,zxid-m.mobileservice.cn,REJECT
IP-CIDR,103.41.167.237/32,REJECT,no-resolve
IP-CIDR,118.89.204.198/32,REJECT,no-resolve
IP-CIDR6,2402:4e00:1200:ed00:0:9089:6dac:96b6/128,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/unlimited\/go\/my_card/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/appview\/v\d\/zhmore/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/appview\/api\/v\d\/answers\/\d+\/recommendations/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/\w+\/\d+\/comments\/featured-comment-ad/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/ab\/api\/v\d\/products\/zhihu\/platforms\/ios\/config/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/hot_recommendation/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/mcn\/v\d\/linkcards\?/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/(questions|anwsers)\/\d+\/related-readings/i then reject(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/commercial_api\/banners_v\d\/mobile_banner/i then reject(200)
request if ${url} ~= /^https?:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation/i then reject(200)
request if ${url} ~= /^https?:\/\/zhstatic\.zhihu\.com\/brand-ad/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\?/i then response.body.replace(/"recommend_queries":\{.+\}/, "\"recommend_queries\":{}")
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/(banners_v\d\/app_topstory_banner|launch_v|real_time_launch_v)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(moments\/lastread|drama\/hot-drama-list)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/window/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/me\/guides/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/current_reading/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/search\/preset_words/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/search\/related_queries\/(answer|article)\/\d+/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/comment_v\d\/answers\/\d+\/list-headers/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/v\d\.\d\/topics\/answer\/\d+\/relation/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/ad/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/appcloud2\.zhihu\.com\/v\d\/resource\?group_name=mp/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\?/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api\/app_float_layer/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(moments_v\d|topstory\/recommend(_v\d)?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/v2\/topstory\/hot-lists\/everyone-seeing\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/next-(bff|data|render)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(v\d\/)?questions\/\d+\/(feeds|answers)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/(answers|articles)\/\d+\/recommendations?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/appcloud2\.zhihu\.com\/v\d\/config/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

response if ${url} ~= /^https?:\/\/m-cloud\.zhihu\.com\/api\/cloud\/config\/all\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/zhihu/zirawell_zhihu.js") with tag="zhihu", requires_body=true

[MITM]
hostname = api.zhihu.com, www.zhihu.com, appcloud2.zhihu.com, m-cloud.zhihu.com, zhuanlan.zhihu.com, zhstatic.zhihu.com

