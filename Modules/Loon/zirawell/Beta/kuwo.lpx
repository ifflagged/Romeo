#!name=酷我音乐 - KUWO
#!desc=酷我音乐-好音质用酷我
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id588673713
#!bundleId=com.yeelion.kwplayer
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,g.koowo.com,REJECT
DOMAIN-SUFFIX,c.kuwo.cn,REJECT
DOMAIN-SUFFIX,wa.kuwo.cn,REJECT
DOMAIN-SUFFIX,mobilead.kuwo.cn,REJECT
DOMAIN-SUFFIX,rich.kuwo.cn,REJECT
DOMAIN-SUFFIX,deliver.kuwo.cn,REJECT
DOMAIN-SUFFIX,game.kuwo.cn,REJECT
DOMAIN-SUFFIX,kuwoyy.com,REJECT
DOMAIN-SUFFIX,kwmsg.kuwo.cn,REJECT
DOMAIN-SUFFIX,msclick2.kuwo.cn,REJECT
DOMAIN-SUFFIX,msphoneclick.kuwo.cn,REJECT
DOMAIN-SUFFIX,updatepage.kuwo.cn,REJECT
DOMAIN-SUFFIX,webstat.kuwo.cn,REJECT
IP-CIDR,111.206.98.63/32,REJECT,no-resolve

[Rewrite]
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/album\/adBar/i then reject(200)
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/user\/freeMode/i then reject(200)
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/(?>pasterAdvert|startup)/i then reject(200)
request if ${url} ~= /^https?:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/newMenuList\/menuListInfo/i then reject(200)
request if ${url} ~= /^https?:\/\/vip\d\.kuwo\.cn\/vip\/v\d\/sysinfo\?op=getRePayAndDoPayBox/i then reject(200)
response if ${url} ~= /^https?:\/\/appi\.kuwo\.cn\/kuwopay\/personal\/cells/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?op=get_advertright_endtime/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/(mgxhtj|nmobi|searchrecterm)\.kuwo\.cn\/(mgxh|mobi|recterm)\.s/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuwo/zirawell_kuwo.js") with tag="kuwo", requires_body=true

response if ${url} ~= /^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuwo/zirawell_kuwo.js") with tag="kuwo", requires_body=true

response if ${url} ~= /^https?:\/\/musicpay\.kuwo\.cn\/music\.pay/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuwo/zirawell_kuwo.js") with tag="kuwo", requires_body=true

response if ${url} ~= /^https?:\/\/vip\d\.kuwo\.cn\/vip\/(enc\/user\/vip\?op=ui|v\d\/theme\?op=gd)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuwo/zirawell_kuwo.js") with tag="kuwo", requires_body=true

response if ${url} ~= /^https?:\/\/vip\d\.kuwo\.cn\/vip\/v\d\/user\/vip\?op=ui/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/kuwo/zirawell_kuwo.js") with tag="kuwo", requires_body=true

[MITM]
hostname = wapi.kuwo.cn, appi.kuwo.cn, audiobookpay.kuwo.cn, mgxhtj.kuwo.cn, nmobi.kuwo.cn, searchrecterm.kuwo.cn, musicpay.kuwo.cn, vip*.kuwo.cn

