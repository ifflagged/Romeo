[Rewrite]
request if ${url} ~= /^https?:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd/i then reject(200)
request if ${url} ~= /^https?:\/\/slugger\.qunar\.com\/slugger-proxy\?qrt=home_notice_banner/i then reject(200)
request if ${url} ~= /^https?:\/\/slugger\.qunar\.com\/slugger-proxy\?qrt=content_api_common_feed_open_postList/i then reject(200)
response if ${url} ~= /^https?:\/\/qde\.qunar\.com\/preload/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/homefront\.qunar\.com\/front\/splash\/ad/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/slugger\.qunar\.com\/slugger-proxy\?qrt=content_api_common_desert_damo_getPostList/i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/slugger\.qunar\.com\/slugger-proxy\?qrt=p_feedlist_recommend/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = qde.qunar.com, homefront.qunar.com, client.qunar.com, qimgs.qunarzz.com, slugger.qunar.com

