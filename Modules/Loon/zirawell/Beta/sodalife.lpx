[Rewrite]
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/goods/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/hydr\/v\d\/poster\/posters/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ATOP/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ABOTTOM/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AHOME%3ACENTER/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AMINE%3ABOTTOM/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.sodalife\.xyz\/v\d\/posters\?location=SODA_APP%3AREWARDS%3ACENTER/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = api.sodalife.xyz

