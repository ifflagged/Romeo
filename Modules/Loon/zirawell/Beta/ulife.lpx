[Rewrite]
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/signintask\/adServing/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/getUpgradeStrategy/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/frontEntrance\/getThirdAdvertising/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/memberCard\/listMemberCard\?isShowSecondaryCard=1/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/entrance/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = api.ulife.group

