#!openUrl=https://apps.apple.com/app/id288429040
#!bundleId=com.linkedin.LinkedIn
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,ads.linkedin.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/www\.linkedin\.com\/voyager\/api\/voyagerConfiguration/i then reject(200)
response if ${url} ~= /^https?:\/\/www\.linkedin\.com\/voyager\/api\/graphql\?queryId=voyagerAdstracking/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = www.linkedin.com

