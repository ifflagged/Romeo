[Rewrite]
request if ${url} ~= /^https?:\/\/huichuan\.sm\.cn\/nativead/i then reject(200)
response if ${url} ~= /^https?:\/\/stars\.shuqireader\.com\/kkios\/render\/load\/resource\/appConfig/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/open-cms-api\.quark\.cn\/open-cms/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/quark/zirawell_quark.js") with tag="quark", requires_body=true

[MITM]
hostname = huichuan.sm.cn, stars.shuqireader.com, open-cms-api.quark.cn

