#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,huodong.weibo.cn,REJECT
DOMAIN,bootpreload.uve.weibo.com,REJECT
DOMAIN,datacollection.uve.weibo.com,REJECT
DOMAIN,adpinpai.video.weibocdn.com,REJECT
DOMAIN-SUFFIX,fastimage.uve.weibo.com,REJECT
DOMAIN-SUFFIX,adimg.vue.weibo.com,REJECT
DOMAIN-SUFFIX,zymo.mps.weibo.com,REJECT
DOMAIN-SUFFIX,weibomingzi.com,REJECT
DOMAIN-SUFFIX,sdkapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,promote.biz.weibo.cn,REJECT
DOMAIN-SUFFIX,gw5.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,gw6.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,game.weibo.cn,REJECT
DOMAIN-SUFFIX,adimg.uve.weibo.com,REJECT
DOMAIN-SUFFIX,game.weibo.com,REJECT
DOMAIN-SUFFIX,ads.viber.com,REJECT
DOMAIN-SUFFIX,ads-d.viber.com,REJECT
DOMAIN-SUFFIX,ads.aws.viber.com,REJECT
DOMAIN-SUFFIX,alitui.weibo.com,REJECT
DOMAIN-SUFFIX,dp.im.weibo.cn,REJECT
DOMAIN-SUFFIX,click.uve.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com,REJECT
DOMAIN-SUFFIX,wbapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,widget.weibo.com,REJECT
DOMAIN-SUFFIX,dsp.edm.weibo.cn,REJECT
DOMAIN-SUFFIX,alitui.weibo.com.cn,REJECT
DOMAIN-SUFFIX,tui.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com.cn,REJECT
DOMAIN-SUFFIX,ad.weibo.com,REJECT
DOMAIN-KEYWORD,biz.weibo.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/logservice\/service\?/i then reject(200)
request if ${url} ~= /^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(get-lbs-cell-info\.php|sdkconfig\.php)/i then reject(200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/(ug\/checkin\/list|push\/daily)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/photo\/info\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/profile\/container_timeline\?flowId=\d+&invokeType=manual&manualType=scroll&pageDataType=flow&taskType=loadMore&/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/(container_positive|push_info)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/huati\/(discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(home_bottom_modal|interest_category)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/was\/finder\/searchbarchange\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/search\/container_discover\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/video\/redpacket\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/!\/sug\/list\/finderchange\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/card\.weibo\.com\/article\/m\/aj\/(reward|uvead)\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(reward|uvead)\?/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/(checkin\/show|client\/publisher_list|push\/active)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/(cardlist|page)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/(container\/asyn|flowlist|flowpage)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/friendships\/(create|destroy)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/profile\/(container_timeline|dealatt|me|statuses\/tab|userinfo)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/(container_timeline(?>_hot|_topic|_topicpage|_unread)?|unread_hot_timeline)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/statuses\/(extend|show)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/video\/tiny_stream_video_list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/messageflow\/notice\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/search\/(container_timeline|finder)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/searchall\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/wbapp\.uve\.weibo\.com\/(preload\/get_ad|wbapplua\/wbpullad\.lua)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

response if ${url} ~= /^https?:\/\/new\.vip\.weibo\.cn\/aj\/appicon\/list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/weibo/zirawell_weibo.js") with tag="weibo", requires_body=true

[MITM]
hostname = *.weibo.cn, *.weibo.com

