#!name=亲宝宝 - QBB
#!desc=亲宝宝-记录成长,科学育儿
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id672984826
#!bundleId=com.qbb6.app.iphone
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN-SUFFIX,apilog.qbb6.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/stlib\.qbb6\.com\/wclt\/js\/core\/popup/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.qbb6\.com\/baby\/relative\/visited/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.qbb6\.com\/commons\/check\/app\/update/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.qbb6\.com\/remind\/unread_count\/get/i then reject(200)
request if ${url} ~= /^https?:\/\/api\.qbb6\.com\/mamiyin\/large\/view\/get/i then reject(200)
^https?:\/\/stlib\.qbb6\.com\/content\/\w+\.webp mock-response-body data-type=tiny-gif status-code=200
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/ad\//i then response.body.mock("text", "", 200)
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/baby\/and\/litclass\/list\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/commons\/self\/button\/group\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/commons\/testflight\/check\/update/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/commons\/widget\/info\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.qbb6\.com\/timeline\/item\/list\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apipt\.qbb6\.com\/parenting\/pt\/home\/post\/card\/get/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/apicommunity\.qbb6\.com\/community\/category\/list\/get/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/webapi\.qbb6\.com\/h5\/api\/lib\/internal\/append\/get/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/qbb/zirawell_qbb.js") with tag="qbb", requires_body=true

[MITM]
hostname = stlib.qbb6.com, api.qbb6.com, apipt.qbb6.com, apicommunity.qbb6.com, webapi.qbb6.com

