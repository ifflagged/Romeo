[Rewrite]
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.(queryadvertise|queryloadingbanner)\//i then reject(200)
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.popup\.get\//i then response.body.mock("json", "{}", 200)

[MITM]
hostname = acs.m.taobao.com

