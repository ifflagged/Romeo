[Rewrite]
response if ${url} ~= /^https?:\/\/member\.alipan\.com\/v\d\/activity\/sign_in_(?>info|luckyBottle)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/api\.alipan\.com\/adrive\/v\d\/file\/getTopFolders/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/member\.alipan\.com\/v\d\/users\/onboard_list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/adrive/zirawell_adrive.js") with tag="adrive", requires_body=true

response if ${url} ~= /^https?:\/\/api\.alipan\.com\/apps\/v\d\/users\/home\/(?>news|widgets)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/adrive/zirawell_adrive.js") with tag="adrive", requires_body=true

[MITM]
hostname = member.alipan.com, api.alipan.com

