[Rewrite]
response if ${url} ~= /^https?:\/\/3pp\.starbucks\.com\.cn\/wxmem\/popup/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/3pp\.starbucks\.com\.cn\/wxmem\/index\/(?>banner|global)/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = 3pp.starbucks.com.cn

