#!name=番茄小说 - FANQIE
#!desc=番茄小说 - 热门短剧全本小说电子书阅读器
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!tag=zirawell
#!openUrl=https://apps.apple.com/app/id1468454200
#!bundleId=com.dragon.read
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-04-15

[Rule]
DOMAIN,zlink.ugsdk.cn,REJECT
DOMAIN,content-open.douyin.com,REJECT
DOMAIN,webcast-open.douyin.com,REJECT
DOMAIN,lf-webcast-gr-sourcecdn.bytegecko.com,REJECT
DOMAIN,lf3-reading.fqnovelstatic.com,REJECT
DOMAIN,mon11-misc.fqnovel.com,REJECT
DOMAIN-KEYWORD,-applog.fqnovel.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/(obj|img)\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/(obj|img)\/web\.business\.image\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.snssdk.com\/api\/ad\/.+/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg\.com\/ad-app-package/i then reject(200)
request if ${url} ~= /^https?:\/\/.+\.byteimg\.com\/web\.business\.image/i then reject(200)
request if ${url} ~= /^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains/i then reject(200)

[MITM]
hostname = *.pangolin-sdk-toutiao.*, *.pstatp.com, *.pstatp.com.*, *.pglstatp-toutiao.com.*, *.pglstatp-toutiao.com, gurd.snssdk.com, gurd.snssdk.com.*, *default.ixigua.com, lf-cdn-tos.bytescm.com, tnc3-alisc1.zijieapi.com

