[Rewrite]
request if ${url} ~= /^https?:\/\/xc\.ccblife\.ccb\.com\/p1ccbl\/service\/goods-service\/txCtrl\?txcode=A3341Z020/i then reject(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup/i then reject(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup/i then reject(200)
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource/i then response.body.replace(/posterList/, "random_body")
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/(?>basic_service|clp_service)\/txCtrl\?txcode=A3341(?>SB16|C147|MB22|A009|A120|AB03|AB04|A068|A095|AB08)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ccblife-App/zirawell_ccblife.js") with tag="ccblife", requires_body=true

[MITM]
hostname = yunbusiness.ccb.com, waimai-guide.ele.me, xc.ccblife.ccb.com

