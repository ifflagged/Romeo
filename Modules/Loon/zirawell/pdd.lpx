[Rule]
DOMAIN,titan.pinduoduo.com,REJECT
DOMAIN,apm.pinduoduo.com,REJECT
DOMAIN,ta-a.pinduoduo.com,REJECT
DOMAIN,ta.pinduoduo.com,REJECT
DOMAIN,th-a.pinduoduo.com,REJECT
DOMAIN,th-b.pinduoduo.com,REJECT
DOMAIN,th.pinduoduo.com,REJECT
DOMAIN,ta.yangkeduo.com,REJECT
DOMAIN,th.yangkeduo.com,REJECT
DOMAIN,meta.yangkeduo.com,REJECT
DOMAIN,meta.pinduoduo.com,REJECT
DOMAIN,m.pinduoduo.net,REJECT

[Rewrite]
^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject
^https?:\/\/mobile\.yangkeduo\.com\/layer\/app_upgrade_popup - reject
^https?:\/\/api\.pinduoduo\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\/ - reject
^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up - reject
^https?:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/app_popup mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/flow\/hungary\/window\/global mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/search_hotquery mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/engels\/reviews\/require\/append mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/my_order_group mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/likes mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/personal mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/new_chat_group mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.yangkeduo\.com\/api\/ant\/entry\/navigate mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/barrow\/query mock-response-body data-type=json data="{}" status-code=200
^https?:\/\/api\.pinduoduo\.com\/api\/pdd_live_moore_main_lego mock-response-body data-type=json data="{}" status-code=200

[Script]
http-response ^https?:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/pdd.js, requires-body=true, tag=pdd

http-response ^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/\w+\/hub script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/pdd.js, requires-body=true, tag=pdd

[MITM]
hostname = api.pinduoduo.com, api.yangkeduo.com, mobile.yangkeduo.com

