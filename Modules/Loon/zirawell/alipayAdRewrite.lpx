#!name=支付宝小程序-广告拦截合集-重写规则
#!desc=某些规则要清除缓存或者重新安装APP，拦截广告才会生效！
#!author=zirawell
#!icon=icon not found
#!tag=zirawell
#!count=支持约7个支付宝程序
#!homepage=https://github.com/zirawell/R-Store
#!raw-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Rule/QuanX/Adblock/All/rewrite/alipayAdRewrite.conf
#!tg-group=https://t.me/RStoreCom
#!date=2026-08-17 08:45:16

[Rewrite]
# > 高德打车<支付宝小程序> - AMAP
^https?:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource - reject-dict
^https?:\/\/m5-zb\.amap\.com\/ws\/boss\/end\/recommend - reject-dict
# > 淘票票<支付宝小程序> - TFILM
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.(popup|aristotle)\.get - reject-dict
^https?:\/\/mdn\.alicdn\.com\/imgextra\/i1\/.*-tps-180-180\.gif$ - reject-img
# > 淘宝闪购<支付宝小程序> - TBTO
^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.ele\.growth\.fission\.client\.etmd\.et\.getmainpageicon - reject-dict
^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.interact\.content\.homepage\.float - reject
# > 哈啰<支付宝小程序> - HELLOBIKE
^https?:\/\/api\.hellobike\.com\/api\?msg\.toast\.user - reject
^https?:\/\/api\.hellobike\.com\/api\?homepage\.recommend\.popUp - reject
^https?:\/\/api\.hellobike\.com\/api\?homepage\.newWelfare\.alipay - reject-dict
^https?:\/\/api\.hellobike\.com\/api\?homepage\.module\.newAlipay - reject
^https?:\/\/api\.hellobike\.com\/api\?homepage\.shortcut\.scene\.perception - reject
^https?:\/\/api\.hellobike\.com\/api\?applet\.homepage\.medal\.activity - reject-dict
^https?:\/\/api\.hellobike\.com\/api\?bottom\.aggregation\.tab\.info - reject
# > 交通银行信用卡<支付宝小程序> - BCCC
^https?:\/\/creditcardapp\.bankcomm\.com\/cnsvPmpaAliCardWeb\/page\/getGuidePageAds - reject-dict
# > 菜鸟裹裹<支付宝小程序> - CAINIAO
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads - reject-dict
# > 饿了么<支付宝小程序> - ELEME
^https?:\/\/shopping\.ele\.me\/(gw|h5)\/mtop\.o2o\.ad\.exposure\.get - reject-dict
^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.upp\.tbet\.send - reject-dict
^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.eleme\.trigger\.respond - reject

[Script]
http-response ^https?:\/\/alsc-buy2\.ele\.me\/h5\/mtop\.alsc\.eleme\.order\.detail\.miniapp\.build script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/alipayAdRewrite/Script-Hub-Org_replace-body.js, requires-body=true, timeout=30, tag=replaceBody, argument=orderDetailCdpTriggerInfo-%3Erandom_body

http-response ^https?:\/\/waimai-guide\.ele\.me\/(gw|h5)\/mtop\.alsc\.eleme\.miniapp\.homepage script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/alipayAdRewrite/zirawell_eleme.js, requires-body=true, timeout=60, tag=eleme

[MITM]
hostname = m5-zb.amap.com, aimai-guide.ele.me, creditcardapp.bankcomm.com, mdn.alicdn.com, shopping.ele.me, guide-acs.m.taobao.com, api.hellobike.com, alsc-buy2.ele.me, waimai-guide.ele.me

