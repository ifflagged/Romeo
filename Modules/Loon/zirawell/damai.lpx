[Rewrite]
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup - reject
^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch\?appkey=23782110 - reject
^https?:\/\/dorangesource\.alicdn\.com\/\w+\.json$ response-body-json-jq '(.mergedNamespaces[] | select(.name == "app_initialize") | .candidates) |= map(select(.match != "app_ver<9.0.13"))'
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.damai\.wireless\.home\.welcome mock-response-body data-type=text status-code=200

[MITM]
hostname = acs.m.taobao.com, dorangesource.alicdn.com, amdc.m.taobao.com

