[Rule]
DOMAIN,api.htp.ad-scope.com.cn,REJECT
DOMAIN,init.sms.mob.com,REJECT

[Rewrite]
^https?:\/\/app(\w+)?\.ddpai\.com(:\d+)?\/onroad\/api\/v\d\/(?>ad|banner|news)\/list mock-response-body data-type=json data="{}" status-code=200

[MITM]
hostname = app*.ddpai.com

