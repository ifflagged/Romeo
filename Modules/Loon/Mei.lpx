#!name= Mei
#!desc= Merged Plugin For Mei
#!author= Jacob[https://github.com/ifflagged/Romeo]
#!icon= https://github.com/Semporia/Hand-Painted-icon/raw/master/Social_Media/Apple.png

[Argument]
# BiliBili.ADBlock
Splash = switch,true,tag=[开屏] 去除广告,desc=是否启用此处修改
Feed.AD = switch,true,tag=[推荐] 去除广告,desc=是否启用此处修改
Feed.Activity = switch,false,tag=[推荐] 去除“活动大图”,desc=是否启用此处修改
Feed.Vertical = switch,false,tag=[推荐] 去除竖屏视频,desc=是否启用此处修改
Feed.BlockUpLiveList = input,"",tag=[推荐] 屏蔽UP主直播推广,desc=填写up主uid，以英文逗号隔开。
Feed.Story = switch,true,tag=[首页] 去除短视频流广告,desc=是否启用此处修改
Feed.StoryCommercial = switch,true,tag=[首页] 去除Story商业按钮,desc=移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。
Search.AD = switch,true,tag=[搜索] 去除广告,desc=是否启用此处修改
Search.Tracking = switch,false,tag=[搜索] 移除响应跟踪参数,desc=清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。
Search.HotSearch = switch,true,tag=[搜索] 去除“热搜”,desc=是否启用此处修改
PGC.AD = switch,true,tag=[番剧电影] 去除广告,desc=是否启用此处修改
Xlive.AD = switch,true,tag=[直播] 去除广告,desc=是否启用此处修改
Xlive.RemoveTrackingCallbacks = switch,false,tag=[直播] 移除推荐回调,desc=移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。
Xlive.RemovePreloadTracking = switch,false,tag=[直播] 移除预载链接trackid,desc=只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。
Dynamic.HotTopics = switch,true,tag=[动态] 去除“热门话题”,desc=是否启用此处修改
Dynamic.MostVisited = switch,false,tag=[动态] 去除“最常访问”,desc=是否启用此处修改
Dynamic.MostVisitedLiveOnly = switch,false,tag=[动态] “最常访问”仅显示直播,desc=是否启用此处修改
Dynamic.AdCard = switch,true,tag=[动态] 去除广告卡片,desc=是否启用此处修改
Dynamic.PersonalAdCard = switch,false,tag=[动态] 去除个人流广告卡片,desc=过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。
View.AD = switch,true,tag=[视频] 去除播放页广告,desc=是否启用此处修改
DM.Command = switch,false,tag=[弹幕] 去除交互式弹幕,desc=是否启用此处修改
DM.Colorful = switch,false,tag=[弹幕] 替换彩色弹幕,desc=是否启用此处修改
DM.Airborne = switch,false,tag=[弹幕] 空降助手,desc=是否启用此处修改
Reply.AD = switch,true,tag=[评论] 去除广告,desc=是否启用此处修改
Reply.CommercialLinks = switch,false,tag=[评论] 禁用普通评论商业跳转,desc=保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。
Reply.SubjectDescriptionCommercial = switch,false,tag=[评论] 隐藏编辑器商品能力,desc=移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。
Privacy.Tracking = switch,true,tag=[隐私] 移除响应链接跟踪参数,desc=清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。
Privacy.BlockBiliCommercial = switch,false,tag=[隐私] 阻止B站商业上报,desc=本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。
Privacy.BlockThirdParty = switch,false,tag=[隐私] 阻止第三方广告归因,desc=本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。
Privacy.Strict = switch,false,tag=[隐私] 严格模式,desc=同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。
bilibili_adblock_Storage = select,"PersistentStore","Argument","database",tag=[储存] 配置类型,desc=仅由模板参数选择配置来源；默认优先使用 PersistentStore (BoxJS)。
bilibili_adblock_LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
# Biliverse.Enhanced
Home.Switch = switch,true,tag=[首页] 启用自定义功能,desc=启用后可自定义首页顶栏、标签页和底部导航栏内容。标签页由分区页的快捷访问决定。
Home.Tab = input,"2036,2037,780,545,151",tag=[首页] 标签页,desc=这里只列出常用选项；分区页提供接近60个快捷访问选项，无法在模块参数中完整列出。请前往 BiliBili App 分区页，使用原生“快捷访问”功能自定义首页标签页。
Home.Tab_default = select,"2037","2036","780","545","774","151","801","2280",tag=[首页] 默认标签页,desc=请选择启动APP时默认展示的标签页，需先将该标签页加入分区页的快捷访问。
Home.Top_left = select,"mine","videoshortcut",tag=[首页] 顶栏（左侧）按钮（用户头像）,desc=请选择顶栏（左侧）按钮（用户头像）的作用（在biliBili粉色版中无法修改）。
Home.Top = input,"messages",tag=[首页] 顶栏（右侧）按钮,desc=请选择启用的顶栏（右侧）按钮。
Home.Top_more = input,"categories,search",tag=[首页] 标签栏右侧按钮,desc=请选择启用的首页标签栏右侧按钮。
Bottom = input,"home,dynamic,ogv,mall,mine",tag=[底部] 导航栏按钮,desc=请选择启用的底部导航栏按钮，最多6个。
Region.Switch = switch,true,tag=[分区] 启用此标签页自定义功能,desc=启用后可自定义分区标签页的内容。
Mine.Switch = switch,true,tag=[我的] 启用此标签页自定义功能,desc=启用后可自定义我的标签页的服务内容。
Mine.iPad.Switch = switch,true,tag=[我的 iPad版] 启用此标签页自定义功能,desc=启用后可自定义iPad版我的标签页的服务内容。
biliverse_enhanced_Storage = select,"PersistentStore","Argument","database",tag=[储存] 配置类型,desc=默认使用 PersistentStore，配置优先级为 database -> $argument -> PersistentStore (BoxJs)；选择 Argument 时为 database -> PersistentStore (BoxJs) -> $argument。
biliverse_enhanced_LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
# BiliBili.Redirect
Host.OverseaVideo = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",tag=[主机名] 重定向 OverseaVideo CDN (港澳台),desc=请选择 OverseaVideo 要重定向的主机名。
Host.BStar = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",tag=[主机名] 重定向 BStar CDN (国际版),desc=请选择 BStar 要重定向的主机名。
Host.PCDN = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",tag=[主机名] 重定向 PCDN 主机名 (中国大陆),desc=请选择 PCDN 要重定向的主机名。
Host.MCDN = select,"proxy-tf-all-ws.bilivideo.com",,tag=[主机名] 重定向 MCDN 主机名 (中国大陆),desc=请选择 MCDN 要重定向的主机名。
bilibili_redirect_Storage = select,"Argument","PersistentStore","database",tag=[储存] 配置类型,desc=选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 PersistentStore (BoxJs) > $argument > database.
bilibili_redirect_LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
# DualSubs.Spotify
Types = input,"Translate,External",tag=[歌词] 启用类型（多选）,desc=请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。
Languages[0] = select,"AUTO","ZH","ZH-HANS","ZH-HK","ZH-HANT","EN","ES","JA","KO","DE","FR","TR","KM",tag=[翻译器] 主语言（源语言）,desc=仅当源语言识别不准确时更改此选项。
Languages[1] = select,"ZH","ZH-HANS","ZH-HK","ZH-HANT","EN","ES","JA","KO","DE","FR","TR","KM",tag=[翻译器] 副语言（目标语言）,desc=请指定翻译歌词的目标语言。
Vendor = select,"Google","Microsoft",tag=[翻译器] 服务商API,desc=请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
LrcVendor = select,"NeteaseMusic","QQMusic","NeteaseMusicNodeJS",tag=[歌词] 服务商API,desc=请选择外部源所使用的服务商API。
dualsubs_spotify_Storage = select,"PersistentStore","Argument","database",tag=[储存] 配置类型,desc=默认优先使用设置面板或 BoxJS 保存的配置，其次使用插件配置，最后使用脚本默认配置。
dualsubs_spotify_LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[General]
# BiliBili.Redirect
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:8000, *:8082, *:9102

