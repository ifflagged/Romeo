#!name= Mei
#!desc= Merged Plugin For Mei
#!author= Jacob[https://github.com/ifflagged/Romeo]
#!icon= https://github.com/Semporia/Hand-Painted-icon/raw/master/Social_Media/Apple.png

[Argument]
# Bilibili
displayUpList = select, "auto", "show", "hide", tag = [动态]中[最常访问]的显示方式, desc = auto: 仅当列表中存在直播状态时显示; show: 始终显示; hide: 始终隐藏;
purifyComment = switch, true, false, tag = [评论区]过滤置顶评论广告, desc = true: 开启; false: 关闭;
optimizeRequest = switch, true, false, tag = [评论区]优化加载异常, desc = true: 开启; false: 关闭;
sponsorBlock = switch, true, false, tag = [空降助手]跳过视频内插播广告, desc = true: 开启; false: 关闭;
logLevel = select, "error", "warn", "info", "debug", "off", tag = 日志等级, desc = 选择日志输出等级
# youtube_gholts
autoHd=switch, false, true, tag=自动最高画质, desc=自动选择 YouTube 最高画质
blockAi=switch, false, true, tag=隐藏智能助手, desc=用于隐藏 YouTube 智能助手
blockGames=switch, false, true, tag=隐藏内置游戏, desc=用于隐藏 YouTube 游戏服务
blockShorts=switch, false, true, tag=隐藏短片按钮, desc=用于隐藏 YouTube 短片按钮
blockStore=switch, false, true, tag=隐藏商品橱窗, desc=用于隐藏视频下方以及 YouTuber 主页中的商品推广
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏 YouTube 上传按钮
blockVerticalLive=switch, false, true, tag=隐藏竖屏直播, desc=用于隐藏 YouTube 主页中的竖屏直播
jumpAhead=switch, false, true, tag=开启精彩跳转, desc=解锁 YouTube Premium Jump Ahead 按钮
onTheGo=switch, false, true, tag=开启通勤模式, desc=解锁 YouTube Premium On-the-go 模式

[Rule]
# Bilibili
DOMAIN, bsbsb.top, PROXY
DOMAIN, api.biliapi.com, REJECT
DOMAIN, app.biliapi.com, REJECT
DOMAIN, api.biliapi.net, REJECT
DOMAIN, app.biliapi.net, REJECT
AND, ((DOMAIN-SUFFIX, chat.bilibili.com), (OR, ((DOMAIN-KEYWORD, stun), (DOMAIN-KEYWORD, tracker), (DOMAIN-KEYWORD, p2p)))), REJECT
DEST-PORT, 4480, REJECT-NO-DROP
DEST-PORT, 4483, REJECT-NO-DROP
DEST-PORT, 9102, REJECT-NO-DROP
URL-REGEX, "^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH", REJECT-VIDEO-NO-DROP
URL-REGEX, "^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH", REJECT-VIDEO-NO-DROP
