[Rewrite]
# 爱思助手 //list-app-m.i4.cn
request if ${url} ~= /^https:\/\/list-app-m\.i4\.cn\/(?:adclickcb|getHotSearchList|getopfstadinfo)\.xhtml/i then reject(404)

# 阿里云盘 //*api.alipan.com, member.alipan.com
request if ${url} ~= /^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders/i then reject_dict(200)
request if ${url} ~= /^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle/i then reject_dict(200)

# 阿里巴巴 //acs.m.taobao.com, heic.alicdn.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.relationrecommend\.pailitaorecommend\.recommend/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:volvo\.secondfloor\.getconfig|shot\.resources\.load|wireless\.home\.(newface|splash)\.awesome\.get)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/i then reject_dict(200)

# 百度云 //pan.baidu.com
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/(?:act\/|aipic\/|aisearch\/|api\/getsyscfg\?|buy\/adx?\/|rest\/)/i then reject_dict(200)

# 昌原云充 五代十路 //www.washpayer.com
response if ${url} ~= /^http:\/\/ad\.5tao5ai\.com\/common\/getReceipt\?/i then response.json.delete("payload.adInfo")
request if ${url} ~= /^https:\/\/www\.washpayer\.com\/(?:ad\/getBannerAd|ad\/user-adword|user\/getBannerList)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/www\.washpayer\.com\/common\/getReceipt/i then response.json.delete("payload.adInfo")

# 东风日产 //oneapph5.dongfeng-nissan.com.cn
request if ${url} ~= /^https:\/\/oneapph5\.dongfeng-nissan\.com\.cn\/mb-gw\/(?:dndc-gateway\/nissan\/platform\/api\/advertisement\/app\/ad-content|ly-mp-iov-forwarding-service\/iov\/login\/advertapp\/listByCarSeries)/i then reject_dict(200)

# 豆瓣 //api.douban.com, img3.doubanio.com, qnmob3.doubanio.com
request if ${url} ~= /^https:\/\/api\.douban\.com\/v2\/app_ads\/splash\w+/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:img|qnmob)3\.doubanio\.com\/view\/dale-online\/dale_ad\/public\/\w+/i then reject_dict(200)

# 工商银行 //image.mybank.icbc.com.cn

# 和风天气 //hfapp-service.qweather.net
request if ${url} ~= /^https:\/\/hfapp-service\.qweather\.net\/v2\.0\/app\/ad\/list\?/i then reject_dict(200)

# 盒马
request if ${url} ~= /^https:\/\/acs-m\.freshippo\.com\/gw\/mtop\.wdk\.render\.querysinglepage\//i then reject_dict(200)

# 建设银行
request if ${url} ~= /^http:\/\/image1\.ccb\.com\/newsinfo\/eBranch\/check\/(?:nf\/newfin\/activity|po\/poortheme\/activity)\/\w+\.png/i then reject(404)

# 交管12123 //gab.122.gov.cn
request if ${url} ~= /^https:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery\/adver/i then reject_dict(200)

# 酷安 //api.coolapk.com
request if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch/i then reject_dict(200)

# 猫眼 //p0.pipi.cn
request if ${url} ~= /^https:\/\/p0\.pipi\.cn\/(?:adAdmin|mediaplus\/maoyantong_ads_fe)\/\w+\.jpe?g\?imageMogr2\/quality\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/p0\.pipi\.cn\/(?:adAdmin|mediaplus\/maoyantong_ads_fe)\/\w+\.(?:jpe?g|png)\?imageMogr2\/thumbnail\/(?:860x0|880x0|!165x165|!1049x1169)/i then reject_dict(200)

# 墨迹天气 //mme.api.moji.com, sns.api.moji.com
response if ${url} ~= /^https:\/\/mme\.api\.moji\.com\/json\/entrance\/list$/i then response.json.jq("del(.entrance_region_res_list[] | select(.region_name == \"皇冠区域\" or .region_name == \"banner区\")) | .entrance_region_res_list[].entrance_res_list |= if . then map(select(.entrance_name | . != \"墨迹钱包\" and . != \"墨圈\")) else . end")
request if ${url} ~= /^https:\/\/sns\.api\.moji\.com\/(?:forum|user\/dynamic_v[89]\/json)\//i then reject_dict(200)

# 每日万年历
request if ${url} ~= /^http:\/\/app-cdn\.2q10\.com\/app\/ical\/honored\?/i then reject_dict(200)

# 美团 & 美团外卖 //flowplus.meituan.net, img.meituan.net, s3plus.meituan.net
request if ${url} ~= /^http:\/\/wmapi\.meituan\.com\/api\/v7\/(?:loadInfo|openscreen|startpicture)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/flowplus\.meituan\.net\/v1\/mss_\w+\/linglong\/\d+\.jpg/i then reject_dict(200)
request if ${url} ~= /^https:\/\/img\.meituan\.net\/bizad\/bizad_brandCpt_\d+\.jpg/i then reject_dict(200)
request if ${url} ~= /^https:\/\/s3plus\.meituan\.net\/ocean-blk-index\/index\/blk_conf_\d+\.json/i then reject_dict(200)
request if ${url} ~= /^https:\/\/s3plus\.meituan\.net\/v1\/mss_\w+\/(?:brandcpt-vedio|waimai-alita)\/\w+\.zip$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/s3plus\.meituan\.net\/v1\/mss_\w+\/nebulafile\/\w+/i then reject_dict(200)

# 米家 //home.mi.com
request if ${url} ~= /^https:\/\/home\.mi\.com\/cgi-op\/api\/v1\/recommendation\/(?:banner|carousel\/banners|myTab|openingBanner)/i then reject_dict(200)

# Reddit //gql.reddit.com, gql-fed.reddit.com
response if ${url} ~= /^https:\/\/gql(-fed)?\.reddit\.com/i then response.json.jq("jq-path=https://rucu6.pages.dev/JQLang/reddit.jq")

# 太平洋寿险 //a.cpiccdn.com
request if ${url} ~= /^https:\/\/a\.cpiccdn\.com\/config-center\/api\/configfile\/images\/\d{8}\/\d{13}_(?:(?:630|945|1035)_\d{2,4}|123_48|136_136|207_210|408_408|750_750|1125_\d{4})\.(gif|jpg|png)$/i then reject_dict(200)

# 网上国网 //osg-service.sgcc.com.cn
request if ${url} ~= /^https:\/\/osg-service\.sgcc\.com\.cn:18600\/emss-pfa-appset-front\/bootpageoutter\//i then reject_dict(200)

# 下厨房 //api.xiachufang.com
request if ${url} ~= /^https:\/\/api\.xiachufang\.com\/v2\/ad\//i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.xiachufang\.com\/v2\/homepage\/paged_waterfall_recommendations\.json/i then response.json.jq(".multiplex_cells |= map(select(.recommendation_cell.label != \"广告\"))")

# 微信 //mp.weixin.qq.com
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(?:cps_product_info|getappmsgad|getbizbanner|jsmonitor|masonryfeed|relatedarticle|relatedsearchword)/i then reject_dict(200)

# 小米音箱 //marketing-aibox.v.mitvos.com
request if ${url} ~= /^https:\/\/marketing-aibox\.v\.mitvos\.com\/(?:advertise|payGuide\/halfScreenMulti)\//i then reject_dict(200)

# 小米商城 //api.m.mi.com, shop-api.retail.mi.com, xiaomishop.retail.mi.com
response if ${url} ~= /^https:\/\/api\.m\.mi\.com\/v1\/order\/expressView/i then response.json.delete("data.bottom.ad_info")
request if ${url} ~= /^https:\/\/api\.m\.mi\.com\/(?:v1\/(?:app\/popup_info|home\/page_feed|home\/recommendBlank|misearch\/search_input|product\/recommendv2)|v2\/search\/search_default)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/act\/mishopSearch\/mainSearch/i then response.json.replace("data.recProductList", `[]`)
response if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/home\/v1\/index/i then response.json.delete(["data.floors[0].data.left_icon_config", "data.floors[0].data.right_icon_config"])
response if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/usercenter\/personalHome/i then response.json.delete("data.carouselAD")
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/(?:cart|home|personal)\/recommend/i then reject_dict(200)
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/(?:act\/mishopSearch\/searchInput|mf\/home\/v1\/feed)/i then reject_dict(200)
