#!name=知乎
#!desc=上逼乎, 与世界分享你的装逼故事。
#!author=RuCu6[https://github.com/RuCu6], blackmatrix7[https://github.com/blackmatrix7]
#!icon=https://rucu6.pages.dev/Icons/app/zhihu.png
#!date=2026-08-30 10:10
#!loon_version=3.5.1(978)

[Rule]
# 知乎
DOMAIN, appcloud.zhihu.com, REJECT
DOMAIN, appcloud2.in.zhihu.com, REJECT
DOMAIN, crash2.zhihu.com, REJECT
DOMAIN, lens.zhihu.com, REJECT
DOMAIN, mqtt.zhihu.com, REJECT
DOMAIN, sugar.zhihu.com, REJECT
DOMAIN, zxid-m.mobileservice.cn, REJECT
IP-CIDR, 103.41.167.237/32, REJECT, no-resolve
IP-CIDR, 118.89.204.198/32, REJECT, no-resolve
IP-CIDR, 182.61.194.7/32, REJECT, no-resolve
IP-CIDR6, 2402:4e00:1200:ed00:0:9089:6dac:96b6/128, REJECT, no-resolve

[Rewrite]
# 首页 - 悬浮图标、顶部横幅、开屏广告、关注页推荐、推荐信息流、热榜信息流、热榜直播、回答底部卡片
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/commercial_api\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/(?:moments\/lastread|drama\/hot-drama-list)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/root\/window/i then reject_dict(200)

# 会员页面 - 弹窗、悬浮动图
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/(?:bazaar\/float_window|market\/popovers_v2)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header\?/i then response.json.delete(["activity_banner", "activity_window", "vip_tip"])

# 我的页面 - 项目列表、会员卡片
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/me\/guides/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/unlimited\/go\/my_card/i then reject(404)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/appview\/v3\/zhmore/i then reject(404)

# 搜索页 - 关键词、猜你想搜
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/search\/(hot_search|preset_words)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/search\/clicked_recommendation\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/(?:article|answer)\/\d+/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\?/i then response.body.replace(/recommend_queries:\{.+\}/, "recommend_queries:{}")

# 回答详情页 - 评论区顶部、下一个回答
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/comment_v5\/(?:articles|answers)\/\d+\/list-headers/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/prague\/related_suggestion_native\/feed\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/related_recommend\/feed\/waterfall\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/v5\.1\/topics\/answer\/\d+\/relation/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/comment_v5\/(pins\/)?\d+\/root_comment\?/i then response.json.delete("atmosphere_voting_config")
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/questions\/\d+(?:\/answers|\/feeds|\?include=)/i then response.json.jq("del(.ad_info, .data.ad_info?, .query_info) | if (.data | type) == \"array\" then .data |= map(select(.target?.answer_type? // \"\" | tostring | contains(\"paid\") | not)) else . end")

# 其他 - 服务器推送配置
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/ad-style-service\/request/i then reject_dict(200)
request if ${url} ~= /^https:\/\/appcloud2\.zhihu\.com\/v3\/resource\?group_name=mp/i then reject_dict(200)
request if ${url} ~= /^https:\/\/link\.zhihu\.com\/\?target=(?:https?)?(?:%3A|:)?(?:\/\/|%2F%2F)?(.*)/i as urlMatch then redirect(302, "http://${urlMatch.1}")

# 网页版去广告
request if ${url} ~= /^https:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/hot_recommendation/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/mcn\/v2\/linkcards\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/(?:answers|questions)\/\d+\/related-readings/i then reject_dict(200)
request if ${url} ~= /^https:\/\/www\.zhihu\.com\/commercial_api\/banners_v3\/mobile_banner/i then reject_dict(200)
request if ${url} ~= /^https:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/(?:api|page-info)\.zhihu\.com\/(?:answers|articles)\/v2\/\d+/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除回答底部卡片推广", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/commercial_api\/app_float_layer/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除首页悬浮图标", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/feed\/render\/tab\/config\?/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除推荐信息流推广", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/(?:moments_v3|topstory\/hot-lists\/total|topstory\/recommend)/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除推荐信息流推广", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/root\/tab/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="精简顶部标签", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/v2\/topstory\/hot-lists\/everyone-seeing\?/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除热榜信息流推广", requires_body=true
response if ${url} ~= /^https:\/\/api\.zhihu\.com\/next-(?:bff|data|render)/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除下一个回答推广、评论区顶部推广", requires_body=true
response if ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v4\/(?:articles|answers)\/\d+\/recommendations?\?/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="移除回答详情页推广", requires_body=true
response if ${url} ~= /^https:\/\/appcloud2\.zhihu\.com\/v3\/config/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="拦截服务器推送配置 config", requires_body=true
response if ${url} ~= /^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\?/i then script("https://rucu6.pages.dev/Scripts/zhihu.js") with tag="拦截服务器推送配置 config all", requires_body=true

[MITM]
hostname=*.zhihu.com
