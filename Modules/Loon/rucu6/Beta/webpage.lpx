#!name=WebPage
#!desc=移除网页广告。
#!author=RuCu6[https://github.com/RuCu6]
#!icon=icon not found
#!tag=rucu6
#!date=2026-08-30 10:10
#!loon_version=3.5.1(978)

[Rule]
DOMAIN-SUFFIX,mypikpak.com,PROXY
DOMAIN,18hlw.com,PROXY
DOMAIN,8olbt.imsatcmn.cc,PROXY
DOMAIN,yhg007.com,PROXY

[Rewrite]
request if ${url} ~= /^https?:\/\/(www\.)?(?:g|google)\.cn/i then redirect(302, "https://www.google.com")
request if ${url} ~= /^https?:\/\/translate\.google\.cn/i then redirect(302, "https://translate.google.com")
request if ${url} ~= /^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js/i then reject(404)
request if ${url} ~= /https:\/\/(rule\.)?kelee\.one\//i then request.header.set("user-agent", "Loon/786 CFNetwork/1568.200.51 Darwin/24.1.0")
response if ${url} ~= /https:\/\/(rule\.)?kelee\.one\//i then response.header.add("content-disposition", "inline")
response if ${url} ~= /https:\/\/(rule\.)?kelee\.one\//i then response.header.set("content-type", "text/plain; charset=utf-8")
request if ${url} ~= /^https:\/\/exhentai\.org/i then redirect(307, "https://e-hentai.org")
request if ${url} ~= /^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$/i as urlMatch then redirect(302, "${urlMatch.1}")
request if ${url} ~= /^https:\/\/www\.pornhub\.com\//i then redirect(302, "https://cn.pornhub.com/")
request if ${url} ~= /^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads)/i then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/boxer\.baidu\.com\/scheme\?scheme/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_baiduNoRedirect.js") with tag="baidu_boxer", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_baidu-index.js") with tag="baidu_home", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_baidu-zhidao.js") with tag="baidu_zhidao", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/www\.(?:hgeme|xn--wcv59z)\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_myblockads.js") with tag="guanying_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/hash\/(?:[a-fA-F0-9]{40}|[A-Z2-7]{32})\.html$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_myblockads.js") with tag="yihuagong_hash_ad", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/search-[^\/]+\.html$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_myblockads.js") with tag="yihuagong_search_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/(?:18hlw\.com|8olbt\.imsatcmn\.cc)\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_myblockads.js") with tag="18hlw_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/miniapp2\.52ywy\.com\/(?:ywyminiappbot\/(?:getLatest|getLatestAll|getCategoryVideos|getSearch|series|movies|tv|av|getbloger)|player\/getPlayer)(\?|$)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_52ywy.js") with tag="52ywy_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_zimuquan.js") with tag="zmq_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/e-hentai\.org\/g\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_ehentai.js") with tag="ehentai_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_hanime.js") with tag="hanime_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/javdb\.com\/(?!over18\?)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_myblockads.js") with tag="javdb_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/missav\.(?:ai|fans|ws)\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/)./i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_missav.js") with tag="missav_web_ads", requires_body=true, binary_body_mode=false

response if ${url} ~= /^https:\/\/cn\.pornhub\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/webpage/rucu6_pornhub.js") with tag="pornhub_web_ads", requires_body=true, binary_body_mode=false

[MITM]
hostname = *.google.cn, asserts.avple.tv, kelee.one, rule.kelee.one, e-hentai.org, exhentai.org, *.pornhub.com, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, www.hgeme.com, www.xn--wcv59z.com, yhg007.com, *.111107?.xyz, 18hlw.com, 8olbt.imsatcmn.cc, miniapp2.52ywy.com, *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com, hanime1.me, javdb.com, missav.ai, missav.fans, missav.ws

