#!name=SoundCloud
#!desc=Unlocks SoundCloud Go+ features and hides the upgrade tab and badge.
#!author=devchristian1337
#!icon=icon not found
#!tag=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!tag=SoundCloud, Premium
#!loon_version=3.3.4(898)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-10-08

[Script]
response if ${url} ~= /https:\/\/api-mobile.soundcloud.com\/configuration\/ios/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud.js") with tag="SoundCloud Go+", requires_body=true

response if ${url} ~= /https:\/\/graph.soundcloud.com\/graphql/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud-upsells.js") with tag="SoundCloud Upsells", requires_body=true

[MITM]
hostname = api-mobile.soundcloud.com, graph.soundcloud.com

