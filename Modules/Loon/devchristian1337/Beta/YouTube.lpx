#!name=YouTube
#!desc=Removes ads from the YouTube app, enables background playback and translates existing subtitle tracks (target language zh-CN or en-US, videos without subtitles cannot be translated). Logging captures media response headers only by default, full sampling may add delay. Requires MITM with a trusted certificate.
#!author=devchristian1337
#!icon=icon not found
#!tag=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!tag=YouTube, AdBlock
#!loon_version=3.5.1(983)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-10-07

[Argument]
background_playback=switch,false,true,tag=Background playback, desc=Keeps audio playing for regular videos after switching app or locking the screen. Live streams and restricted content are still decided by YouTube
playback_region=select,"original",tag=Playback request region, desc=original keeps the current region. Only changes the client gl parameter, the exit IP is unchanged. Ad-blocking effect still to be verified
translation_enabled=switch,false,true,tag=Subtitle translation, desc=Translates existing subtitles into the selected target language. When off, the original subtitle request is kept
translation_target=select,"zh-CN",tag=Subtitle target language, desc=Only converts existing subtitle tracks (Simplified Chinese zh-CN or US English en-US). Videos without subtitles cannot be translated. Audio track, title and description are unchanged
hide_home_shorts=switch,false,true,tag=Hide Home Shorts, desc=Removes the Shorts shelf from the Home feed. The bottom Shorts tab and other pages are kept
blocked_channels=input,"",tag=Blocked channels, desc=Channel IDs, @handles or full channel names separated by spaces. Prefer channel IDs, use handle or ID for names containing spaces. Leave empty to disable. Only hides videos whose owner can be identified
blocked_channels_url=input,"",tag=Remote blocked channels URL, desc=Public HTTPS plain-text direct link (e.g. GitHub Raw). Local cache refreshes hourly, or run the update script. Merged with the manual list. Leave empty to disable
log_enabled=switch,false,true,tag=Logging tool, desc=Starts automatically on the first matched request and notifies the log entry point. When turned off, the next API hit clears the log and stops sampling, download it first if you need it. Full sampling may add delay
quality_research=switch,false,true,tag=Quality research sampling, desc=Only active when the logging tool is on. Records recognizable quality and format parameters and reads small media POST requests for comparison. Does not switch quality automatically
media_capture_mode=select,"headers",tag=Media sampling mode, desc=Only active when the logging tool is on, disabled automatically when logging is off. headers records response headers only. full reads the whole response for development and may add delay
log_level=select,"info",tag=Log level, desc=info keeps the full redacted trace. error keeps errors only. debug keeps debug level. warn keeps warnings and errors
capture_budget=select,"32",tag=Log capacity (MB), desc=Recording stops when the limit is reached, existing samples are kept. Clear after exporting

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.header['User-Agent']} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then reject_video(200)
response if ${url} ~= /^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\//i then response.header.set("Alt-Svc", "clear")

[Script]
cron "0 * * * *" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${blocked_channels_url}}) with tag="YouTube scheduled blocked channels update", timeout=10

generic then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${blocked_channels_url}}) with tag="YouTube update blocked channels", timeout=10, img_url=", img-url=person.crop.circle.badge.xmark.system"

request if ${url} ~= /^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${translation_enabled}, ${translation_target}}) with tag="YouTube subtitle target language", timeout=10, enable=${translation_enabled}

request if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${log_enabled} == true && ${quality_research} == true then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${quality_research}}) with requires_body=true, binary_body_mode=true, timeout=10, tag="YouTube quality research request sampling"

request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${media_capture_mode}, ${quality_research}}) with tag="YouTube logging and export", timeout=10, enable=${log_enabled}

request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${playback_region}}) with tag="YouTube config request handling", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i && ${log_enabled} == true && ${media_capture_mode} == "full" then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${media_capture_mode}}) with requires_body=true, binary_body_mode=true, timeout=30, tag="YouTube full media development sampling"

response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with tag="YouTube media response logging", timeout=10, enable=${log_enabled}

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with tag="YouTube Onesie config cache", timeout=10, requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${playback_region}}) with tag="YouTube playback request and ad config handling", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${hide_home_shorts}, ${blocked_channels}, ${blocked_channels_url}}) with tag="YouTube feed ads and Home Shorts handling", timeout=10, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${quality_research}}) with tag="YouTube playback response and background playback", timeout=10, requires_body=true, binary_body_mode=true

[MITM]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com

