#!name = SoundCloud
#!desc = Unlocks SoundCloud Go+ features. Hiding the Upgrade tab and the "listen without ads" badge is optional.
#!openUrl = https://loon-plugins.vercel.app
#!author = devchristian1337
#!tag = SoundCloud, Premium
#!system = iOS,iPadOS,macOS
#!loon_version = 3.3.4(898)
#!homepage = https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!icon = https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/soundcloud.png
#!date = 2026-11-01

[Argument]
hide_upsells = switch,true,tag=Hide upgrade entry points,desc=Removes the Upgrade tab and the "listen without ads" badge. When off, the Go+ unlock is kept and the entry points stay visible

[Script]
http-response https://api-mobile.soundcloud.com/configuration/ios script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud.js,requires-body=true,timeout=10,argument=[{hide_upsells}],tag=SoundCloud Go+
http-response https://graph.soundcloud.com/graphql script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/SoundCloud/devchristian1337_soundcloud-upsells.js,requires-body=true,timeout=10,enable={hide_upsells},tag=SoundCloud Upsells

[Mitm]
hostname = api-mobile.soundcloud.com, graph.soundcloud.com
