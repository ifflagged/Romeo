#!name=朴朴超市
#!desc=移除广告，沉浸买菜
#!author=树先生, 可莉
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number/i then response.json.jq(".data = []")
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3/i then response.json.jq(".data = []")
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6/i then response.json.jq(".data.feed_banner_cards = []")
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail/i then response.json.jq(".data.member_card_v2 = []")
request if ${url} ~= /^http:\/\/139\.196\.12\.179:8053\/httpdns\//i then reject(200)
request if ${url} ~= /^http:\/\/106\.55\.220\.18:8053\/httpdns\//i then reject(200)
request if ${url} ~= /^http:\/\/54\.222\.159\.138:8053\/httpdns\//i then reject(200)
request if ${url} ~= /^http:\/\/101\.42\.130\.147\/httpdns\/resolve\//i then reject(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my/i then reject(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/hub\/camel\/search_input_ranking/i then reject_dict(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order/i then reject_dict(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/pupu/ishowshu_pp.js") with tag="pp", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/order\/orders\/list\/v4/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/pupu/ishowshu_pp.js") with tag="pp", timeout=60, requires_body=true

[MITM]
hostname = j1.pupuapi.com

