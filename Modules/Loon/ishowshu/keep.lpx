#!name=Keep
#!desc=我真的是来运动的
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rule]
DOMAIN,hc-ssp.sm.cn,REJECT
DOMAIN,httpdns.calorietech.com,REJECT

[Rewrite]
#response if ${url} ~= /^https:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/entryDetail/i then response.json.jq(".data.modules = [.data.modules[0]]")
response if ${url} ~= /^https:\/\/api\.gotokeep\.com\/twins\/v1\/social\/tab\/friends/i then response.json.jq(".data.modules |= map(select(.positions | type == \"object\" and (has(\"recommendReason\") | not) and (has(\"recommendUsers\") | not)))")
request if ${url} ~= /^https:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad\/preload/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/search\/v5\/hotCourse\/list/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/search\/v4\/hotword\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/search\/v6\/default\/keyword\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/anno\/v1\/upgrade\/check$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.gotokeep\.com\/guide-webapp\/v1\/popup\/getPopUp/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.gotokeep\.com\/config\/v3\/basic\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/keep/ishowshu_keep.js") with tag="keep", timeout=60, requires_body=true

[MITM]
hostname = api.gotokeep.com, kad.gotokeep.com

