#!name=天天跳绳
#!desc=移除广告
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/abtest\/ads_v2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/ad_sys\/fetch/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.tiantiantiaosheng\.com\/api2\/popup\/list/i then reject_dict(200)

[MITM]
hostname = api.tiantiantiaosheng.com

