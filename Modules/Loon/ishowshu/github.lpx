#!name=Github
#!desc=raw文件拉取
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Script]
request if ${url} ~= /^https:\/\/(raw|gist)\.githubusercontent\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/github/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)Accept-Language%3A.%2B(%5Cr%5Cn)-%3E%241Accept-Language%3A%20en-us%242") with tag="replaceHeader", timeout=30

request if ${url} ~= /^https:\/\/github\.com\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/github/Script-Hub-Org_replace-header.js", "(%5Cr%5Cn)Accept-Language%3A.%2B(%5Cr%5Cn)-%3E%241Accept-Language%3A%20en-us%242") with tag="replaceHeader", timeout=30

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com, github.com

