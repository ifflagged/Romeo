#!name=拼多多
#!desc=移除广告，沉浸购物
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub/i then response.json.jq("del(.personal_banner, .personal_center_style_v2_vo.third_personal_icons_v2) | .monthly_card_entrance.display = false")
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather/i then response.json.jq("del(.newer_index_banner.data)")
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/order\/\d+-\d+\/shipping/i then response.json.jq("del(.shipping.banner_above_recommend)")
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/cappuccino\/splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/search_hotquery/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/my_order_group/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/likes/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/social\/mall\/follow\/hot\/recommend/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/leporis\/notification\/clear_tab_red_dot/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/pdd-rewrite/ishowshu_pdd.js") with tag="pdd", timeout=60, requires_body=true

[MITM]
hostname = api.pinduoduo.com

