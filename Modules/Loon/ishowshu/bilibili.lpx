#!name=哔哩哔哩
#!desc=移除广告, qx已知最后能用的版本是8.44.0
#!author=kokoryh, Rucu6, 树先生
#!icon=icon not found
#!tag=ishowshu

[Rule]
DOMAIN,app.biliapi.net,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.com,REJECT
DOMAIN-SUFFIX,chat.bilibili.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?/i then response.json.jq(".data.domains=[\"wss://tracker.chat.bilibili.com\"]")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?/i then response.json.jq(".data[][]?=\"chat.bilibili.com:3478\"")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/i then response.json.jq("del(.data.payment)")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?/i then response.json.jq(".data.modules |= map(select(.type != \"TIP\") | if .type == \"BANNER\" then .module_data.items |= map(select(.url | startswith(\"https://www.bilibili.com/blackboard/era/\") | not)) else . end)")
request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view\.v1\.View\/TFInfo$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/show/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/second\/getList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(unite)?\.v1\.View\/(View|ViewProgress|RelatesFeed)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile)|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili/kokoryh_bilibili.protobuf.js") with tag="bilibili.protobuf", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = *.bilibili.com, grpc.biliapi.net

