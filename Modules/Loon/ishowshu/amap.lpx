[Rewrite]
request if ${url} ~= /^http:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch/i then reject(200)
request if ${url} ~= /^https:\/\/mps\.amap\.com\/ws\/mps\/scene\?/i then reject_dict(200)
