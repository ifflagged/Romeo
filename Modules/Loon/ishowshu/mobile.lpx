#!name=中国移动
#!desc=去除开屏广告
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/explorePage\/getAdverList/i then reject(200)
request if ${url} ~= /^https:\/\/(client\.app\.coc|h\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/emotionMarket/i then reject(200)

[MITM]
hostname = client.app.coc.10086.cn, h.client.app.coc.10086.cn

