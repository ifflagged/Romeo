[Rewrite]
^https:\/\/hoapp\.juneyaoair\.com\/data\/index\/getPictureList response-body-json-jq 'if (.objData | any(.picLocation == "POSITION_POP_INDEX" or .picLocation == "POSITION_MY_ADD")) then .objData = [] else . end'
^https:\/\/hoapp\.juneyaoair\.com\/data\/index\/getLoadPic - reject-dict

