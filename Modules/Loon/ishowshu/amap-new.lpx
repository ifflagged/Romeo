#!name=高德地图
#!desc=移除广告
#!author=树先生
#!icon=icon not found
#!tag=ishowshu
#!date=2026-09-16

[Rewrite]
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource/i then response.json.jq("del(.data.banner, .data.popup)")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend/i then response.json.jq(".data.shadingWords = {}")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\?/i then response.json.jq(".data.ad |= map(.set.setting.display_time = 0 | .creative |= map(.start_time = 3818332800 | .end_time = 3818419199))")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?/i then response.json.jq(".data.cardList |= map(select(.dataKey == ([\"MineNewFootprintCard\",\"MineNewBEntranceCardV4\",\"MineNewBEntranceCardV3\"][])))")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs/i then response.json.jq(".data.mapBizList |= map(select(IN(.dataKey; \"UserAssetsVirtualCard\", \"FootPrintNewCityDialog\", \"PoiRecommendVirtualCard\", \"PersonalRecommendVirtualCard\") | not))")
#response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets/i then response.json.jq(".data.msgs |= map(select(.category | IN(1, 2, 5, 24)))")
request if ${url} ~= /^http:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch/i then reject(200)
request if ${url} ~= /^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource\/home/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/order\/car\/remark\/satisfactionConf/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/pay\/web\/paySuccess\/info\/request/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/order\/car\/feedback\/get_card_questions/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured/i then reject_dict(200)
request if ${url} ~= /^https:\/\/render\.amap\.com\/ws\/render\/api\/data/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/fluorite\/resource/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/activity\/bus\/sign\/task/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/driving/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos_public_travel\/recommend_plan/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\/nav_start/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/bus_only_refresh/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/amap-new/ishowshu_amap-new.js") with tag="amap-new", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/amap-new/ishowshu_amap-new.js") with tag="amap-new", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/search\/sp/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/amap-new/ishowshu_amap-new.js") with tag="amap-new", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/info_bff\/tradeUnionPortal/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/amap-new/ishowshu_amap-new.js") with tag="amap-new", timeout=60, requires_body=true

[MITM]
hostname = m5.amap.com, amap-aos-info-nogw.amap.com, m5-zb.amap.com, info.amap.com, ai.amap.com, render.amap.com

