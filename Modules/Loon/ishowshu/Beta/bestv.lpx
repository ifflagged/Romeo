#!name=看东方
#!desc=移除广告
#!author=树先生, baby
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
request if ${url} ~= /^https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/free\/open\/advertisingV2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/advertise\/popup\/scene$/i then reject(200)
request if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/open\/advertisingV2/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/userCenter/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/ishowshu_bestv.js") with tag="bestv", timeout=60, requires_body=true

response if ${url} ~= /https:\/\/bp-api\.bestv\.(?:com\.cn|cn)\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common)/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/Yu9191_video-parser.js") with tag="video-parser", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bestv/Yu9191_video-parser.js") with tag="video-parser", timeout=60, requires_body=true

[MITM]
hostname = bp-api.bestv.com.cn, bp-api.bestv.cn, 360.com

