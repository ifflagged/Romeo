#!name=识货
#!desc=识货简化、开屏来源：https://github.com/fmz200/wool_scripts/raw/main/QuantumultX/rewrite/chongxie.txt
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
request if ${url} ~= /^https?:\/\/sh-gateway\.shihuo\.cn\/v\d\/services\/sh-adapi\/home\/(screen|ad)/i then reject(200)
request if ${url} ~= /^https?:\/\/static\.shihuocdn\.cn\/admin\/imgs\/202[0-9]{5}\/[a-z0-9]{32}_513x777\.png/i then reject(200, " ")
request if ${url} ~= /^https?:\/\/static\.shihuocdn\.cn\/admin\/imgs\/202[0-9]{5}\/[a-z0-9]{32}_750x1624\.png/i then reject(200, " ")
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/search\/act/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/search\/soaringlist/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v3\/sh-api\/sh\/searchSpeed\/hotWordSearch/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v3\/sh-api\/daga\/myPage\/goodsList\/v1/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v3\/sh-api\/daga\/gdetails\/middleList\/v1/i then reject(200)
request if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-goodsapi\/app_swoole_zone\/collections\/simple/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/home\/info\/v1/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/shihuo/ishowshu_shihuo.js") with tag="shihuo", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/my\/info/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/shihuo/ishowshu_shihuo.js") with tag="shihuo", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/center\/config\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/shihuo/ishowshu_shihuo.js") with tag="shihuo", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-appapi\/center\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/shihuo/ishowshu_shihuo.js") with tag="shihuo", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/sh-gateway\.shihuo\.cn\/v4\/services\/sh-applicationapi\/pti/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/shihuo/ishowshu_shihuo.js") with tag="shihuo", timeout=60, requires_body=true

[MITM]
hostname = sh-gateway.shihuo.cn, static.shihuocdn.cn

