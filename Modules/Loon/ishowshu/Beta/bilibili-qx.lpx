#!name=哔哩哔哩
#!desc=B站去广告
#!author=kokoryh, 树先生
#!icon=icon not found
#!tag=ishowshu

[Rule]
DOMAIN,app.biliapi.net,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.json.jq(".data |= with_entries(if .key | IN(\"show\", \"event_list\") then .value = [] else . end)")
request if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/second\/getList/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js") with tag="bilibili-ad", timeout=60, requires_body=true

[MITM]
hostname = app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com

