#!name=Youtube
#!desc=移除广告
#!author=Maasea
#!icon=icon not found
#!tag=ishowshu

[Rewrite]
request if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/search/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/account\/get_setting/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/next/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/reel\/reel_watch_sequence/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js") with tag="youtube.response", timeout=60, requires_body=true, binary_body_mode=true

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com

