#!name=Youtube (Music) Enhance
#!desc=适用于 Youtube & Youtube Music
#!icon=icon not found
#!tag=Jacob

[Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* - reject-dict

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, timeout=60, tag=youtube.response

http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.request.js, requires-body=true, binary-body-mode=true, timeout=60, tag=youtube.request

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com

