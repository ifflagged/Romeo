#!name=彩云天气Pro
#!desc=简单屏蔽一些广告
#!author=树先生
#!icon=icon not found
#!tag=ishowshu

[Rule]
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT

[Rewrite]
# 移除彩云广告
^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/features - reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) - reject-dict

[Script]
http-response ^https:\/\/api\.caiyunapp\.com\/v1\/activity\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/caiyun/ishowshu_caiyun.js, requires-body=true, timeout=60, tag=caiyun

http-response ^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/caiyun/ishowshu_caiyun.js, requires-body=true, timeout=60, tag=caiyun

http-response ^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/caiyun/ishowshu_caiyun.js, requires-body=true, timeout=60, tag=caiyun

[MITM]
hostname = wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn

