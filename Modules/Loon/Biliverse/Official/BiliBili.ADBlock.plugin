#!name = 📺 BiliBili: 🛡️ ADBlock
#!desc = 哔哩哔哩：去广告\n自定义去除APP内界面元素
#!openUrl = http://boxjs.com/#/app/BiliBili.ADBlock
#!author = ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!homepage = https://biliverse.github.io/guide/ad-block
#!icon = https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!tag = 🪐 Biliverse
#!system = iOS,iPadOS
#!date = 2026-09-17 11:51:01
#!version = 0.6.27
#!system_version = 15

[Argument]
Splash = switch,true,tag=[开屏] 去除广告,desc=是否启用此处修改
Feed.AD = switch,true,tag=[推荐] 去除广告,desc=是否启用此处修改
Feed.Activity = switch,false,tag=[推荐] 去除“活动大图”,desc=是否启用此处修改
Feed.Vertical = switch,false,tag=[推荐] 去除竖屏视频,desc=是否启用此处修改
Feed.BlockUpLiveList = input,"",tag=[推荐] 屏蔽UP主直播推广,desc=填写up主uid，以英文逗号隔开。
Feed.Story = switch,true,tag=[首页] 去除短视频流广告,desc=是否启用此处修改
Feed.StoryCommercial = switch,true,tag=[首页] 去除Story商业按钮,desc=移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。
Search.AD = switch,true,tag=[搜索] 去除广告,desc=是否启用此处修改
Search.Tracking = switch,false,tag=[搜索] 移除响应跟踪参数,desc=清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。
Search.HotSearch = switch,true,tag=[搜索] 去除“热搜”,desc=是否启用此处修改
PGC.AD = switch,true,tag=[番剧电影] 去除广告,desc=是否启用此处修改
Xlive.AD = switch,true,tag=[直播] 去除广告,desc=是否启用此处修改
Xlive.RemoveTrackingCallbacks = switch,false,tag=[直播] 移除推荐回调,desc=移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。
Xlive.RemovePreloadTracking = switch,false,tag=[直播] 移除预载链接trackid,desc=只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。
Dynamic.HotTopics = switch,true,tag=[动态] 去除“热门话题”,desc=是否启用此处修改
Dynamic.MostVisited = switch,false,tag=[动态] 去除“最常访问”,desc=是否启用此处修改
Dynamic.MostVisitedLiveOnly = switch,false,tag=[动态] “最常访问”仅显示直播,desc=是否启用此处修改
Dynamic.AdCard = switch,true,tag=[动态] 去除广告卡片,desc=是否启用此处修改
Dynamic.PersonalAdCard = switch,false,tag=[动态] 去除个人流广告卡片,desc=过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。
View.AD = switch,true,tag=[视频] 去除播放页广告,desc=是否启用此处修改
DM.Command = switch,false,tag=[弹幕] 去除交互式弹幕,desc=是否启用此处修改
DM.Colorful = switch,false,tag=[弹幕] 替换彩色弹幕,desc=是否启用此处修改
DM.Airborne = switch,false,tag=[弹幕] 空降助手,desc=是否启用此处修改
Reply.AD = switch,true,tag=[评论] 去除广告,desc=是否启用此处修改
Reply.CommercialLinks = switch,false,tag=[评论] 禁用普通评论商业跳转,desc=保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。
Reply.SubjectDescriptionCommercial = switch,false,tag=[评论] 隐藏编辑器商品能力,desc=移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。
Privacy.Tracking = switch,true,tag=[隐私] 移除响应链接跟踪参数,desc=清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。
Privacy.BlockBiliCommercial = switch,false,tag=[隐私] 阻止B站商业上报,desc=本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。
Privacy.BlockThirdParty = switch,false,tag=[隐私] 阻止第三方广告归因,desc=本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。
Privacy.Strict = switch,false,tag=[隐私] 严格模式,desc=同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$/ then response.body.mock_file("json", "https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/BiliBili.ADBlock.boxjs.json", 200) | response.header.set("X-PreferencePanes-Version", "0.6.27") | response.header.set("Cache-Control", "no-store")
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
# 番剧页可能弹出的HTML广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? mock-response-body data-type=text status-code=200 data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"
# iPad端番剧推荐列表上方广告
^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? response-body-json-jq 'del(.data.payment)'

[Script]
http-request ^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ requires-body=0, binary-body-mode=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js, tag=📺 BiliBili.ADBlock.defaultwords.request.grpc, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-request ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\? requires-body=0, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js, tag=📺 BiliBili.ADBlock.request.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-request ^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/) requires-body=0, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js, tag=📺 BiliBili.ADBlock.privacy.request, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/(relate\/)?story)?|search\/square) requires-body=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js, tag=📺 BiliBili.ADBlock.response.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/(web-interface\/wbi\/index\/top\/feed\/rcmd|vip\/ads\/materials)\? requires-body=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js, tag=📺 BiliBili.ADBlock.response.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?) requires-body=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js, tag=📺 BiliBili.ADBlock.response.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/(app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(index\/feed|room\/recList)) requires-body=1, script-path=https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js, tag=📺 BiliBili.ADBlock.response.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]
