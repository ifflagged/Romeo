#!name = 🪐 Biliverse: ⚙️ Enhanced
#!desc = 哔哩哔哩：增强模式\n中国站功能增强及UI自定义
#!openUrl = http://boxjs.com/#/app/Biliverse.Enhanced
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://biliverse.github.io/guide/enhanced
#!icon = https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!tag = 🪐 Biliverse
#!system = iOS,iPadOS,macOS,tvOS
#!date = 2026-09-22 01:53:39
#!version = 0.6.0
#!system_version = 15

[Argument]
Home.Switch = switch,true,tag=[首页] 启用自定义功能,desc=启用后可自定义首页顶栏、标签页和底部导航栏内容。标签页由分区页的快捷访问决定。
Home.Tab = input,"2036,2037,780,545,151",tag=[首页] 标签页,desc=这里只列出常用选项；分区页提供接近60个快捷访问选项，无法在模块参数中完整列出。请前往 BiliBili App 分区页，使用原生“快捷访问”功能自定义首页标签页。
Home.Tab_default = select,"2037","2036","780","545","774","151","801","2280",tag=[首页] 默认标签页,desc=请选择启动APP时默认展示的标签页，需先将该标签页加入分区页的快捷访问。
Home.Top_left = select,"mine","videoshortcut",tag=[首页] 顶栏（左侧）按钮（用户头像）,desc=请选择顶栏（左侧）按钮（用户头像）的作用（在biliBili粉色版中无法修改）。
Home.Top = input,"messages",tag=[首页] 顶栏（右侧）按钮,desc=请选择启用的顶栏（右侧）按钮。
Home.Top_more = input,"categories,search",tag=[首页] 标签栏右侧按钮,desc=请选择启用的首页标签栏右侧按钮。
Bottom = input,"home,dynamic,ogv,mall,mine",tag=[底部] 导航栏按钮,desc=请选择启用的底部导航栏按钮，最多6个。
Region.Switch = switch,true,tag=[分区] 启用此标签页自定义功能,desc=启用后可自定义分区标签页的内容。
Mine.Switch = switch,true,tag=[我的] 启用此标签页自定义功能,desc=启用后可自定义我的标签页的服务内容。
Mine.iPad.Switch = switch,true,tag=[我的 iPad版] 启用此标签页自定义功能,desc=启用后可自定义iPad版我的标签页的服务内容。
Storage = select,"PersistentStore","Argument","database",tag=[储存] 配置类型,desc=默认使用 PersistentStore，配置优先级为 database -> $argument -> PersistentStore (BoxJs)；选择 Argument 时为 database -> PersistentStore (BoxJs) -> $argument。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/theme\.css(?:\?[^#]*)?$/i then response.body.mock_file("css", "https://biliverse.github.io/settings/theme.css", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$/i then response.body.mock_file("html", "https://biliverse.github.io/settings/", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$/i then response.body.mock_file("javascript", "https://biliverse.github.io/settings/index.mjs", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$/i then response.body.mock_file("png", "https://biliverse.github.io/settings/assets/Biliverse_subject.png", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$/i then response.body.mock_file("png", "https://biliverse.github.io/settings/assets/Enhanced_subject.png", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$/i then response.body.mock_file("png", "https://biliverse.github.io/settings/assets/Global_subject.png", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$/i then response.body.mock_file("png", "https://biliverse.github.io/settings/assets/Redirect_subject.png", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$/i then response.body.mock_file("png", "https://biliverse.github.io/settings/assets/ADBlock_subject.png", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/[a-zA-Z0-9_-]+\/?(?:\?[^#]*)?$/i then response.body.mock_file("html", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.html", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/index\.mjs(?:\?[^#]*)?$/i then response.body.mock_file("javascript", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.mjs", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/navigation\.mjs(?:\?[^#]*)?$/i then response.body.mock_file("javascript", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/navigation.mjs", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$/i then response.body.mock_file("json", "https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/Biliverse.Enhanced.PreferencePanes.json", 200) | response.header.add(["X-PreferencePanes-Version", "Cache-Control"], ["0.6.0", "no-store"])

[Script]
http-request ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$ requires-body=1, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js, tag=PreferencePanes.API
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/response.bundle.js, tag=📺 Biliverse.Enhanced.x.resource.show.tab.v2, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]
http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$ requires-body=1, binary-body-mode=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/request.bundle.js, tag=📺 Biliverse.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]
http-response ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$ requires-body=1, binary-body-mode=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/response.bundle.js, tag=📺 Biliverse.Enhanced.show.v1.Mixture.RegionList.response.grpc, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/response.bundle.js, tag=📺 Biliverse.Enhanced.x.v2.account.mine, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/response.bundle.js, tag=📺 Biliverse.Enhanced.x.v2.region.index, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]
http-response ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? requires-body=1, script-path=https://github.com/Biliverse/Enhanced/releases/download/v0.6.0/response.bundle.js, tag=📺 Biliverse.Enhanced.x.v2.channel.region.list, argument=[{Home.Switch},{Home.Tab},{Home.Tab_default},{Home.Top_left},{Home.Top},{Home.Top_more},{Bottom},{Region.Switch},{Mine.Switch},{Mine.iPad.Switch},{Storage},{LogLevel}]

[MitM]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
