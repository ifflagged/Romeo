#!name=📺 BiliBili: 🔀 Redirect
#!desc=哔哩哔哩：重定向\n中国站CDN自定义
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Biliverse
#!openUrl=http://boxjs.com/#/app/BiliBili.Redirect
#!homepage=https://biliverse.github.io/guide/redirect
#!date=2026-09-17 14:37:46
#!version=0.2.24

[Argument]
Host.OverseaVideo=input,"upos-sz-mirrorali.bilivideo.com",tag=[主机名] 重定向 OverseaVideo CDN (港澳台), desc=[主机名] 重定向 OverseaVideo CDN (港澳台)\n    ├ upos-sz-mirrorali.bilivideo.com: 阿里云 CDN\n    ├ upos-sz-mirrorcos.bilivideo.com: 腾讯云 CDN\n    ├ upos-sz-mirrorhw.bilivideo.com: 华为云 CDN，融合 CDN\n    ├ upos-sz-mirroraliov.bilivideo.com: 阿里云 CDN，海外\n    ├ upos-sz-mirrorcosov.bilivideo.com: 腾讯云 CDN，海外\n    ├ upos-sz-mirrorhwov.bilivideo.com: 华为云 CDN，海外\n    ├ cn-hk-eq-01-01.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-03.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-09.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-10.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-12.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-13.bilivideo.com: Equinix IX CDN，香港\n    └ cn-hk-eq-01-14.bilivideo.com: Equinix IX CDN，香港\n请选择 OverseaVideo 要重定向的主机名。
Host.BStar=input,"upos-sz-mirrorali.bilivideo.com",tag=[主机名] 重定向 BStar CDN (国际版), desc=[主机名] 重定向 BStar CDN (国际版)\n    ├ upos-sz-mirrorali.bilivideo.com: 阿里云 CDN\n    ├ upos-sz-mirrorcos.bilivideo.com: 腾讯云 CDN\n    ├ upos-sz-mirrorhw.bilivideo.com: 华为云 CDN，融合 CDN\n    ├ upos-sz-mirroraliov.bilivideo.com: 阿里云 CDN，海外\n    ├ upos-sz-mirrorcosov.bilivideo.com: 腾讯云 CDN，海外\n    ├ upos-sz-mirrorhwov.bilivideo.com: 华为云 CDN，海外\n    ├ cn-hk-eq-01-01.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-03.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-09.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-10.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-12.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-13.bilivideo.com: Equinix IX CDN，香港\n    └ cn-hk-eq-01-14.bilivideo.com: Equinix IX CDN，香港\n请选择 BStar 要重定向的主机名。
Host.PCDN=input,"upos-sz-mirrorali.bilivideo.com",tag=[主机名] 重定向 PCDN 主机名 (中国大陆), desc=[主机名] 重定向 PCDN 主机名 (中国大陆)\n    ├ upos-sz-mirrorali.bilivideo.com: 阿里云 CDN\n    ├ upos-sz-mirrorcos.bilivideo.com: 腾讯云 CDN\n    ├ upos-sz-mirrorhw.bilivideo.com: 华为云 CDN，融合 CDN\n    ├ upos-sz-mirroraliov.bilivideo.com: 阿里云 CDN，海外\n    ├ upos-sz-mirrorcosov.bilivideo.com: 腾讯云 CDN，海外\n    ├ upos-sz-mirrorhwov.bilivideo.com: 华为云 CDN，海外\n    ├ cn-hk-eq-01-01.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-03.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-09.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-10.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-12.bilivideo.com: Equinix IX CDN，香港\n    ├ cn-hk-eq-01-13.bilivideo.com: Equinix IX CDN，香港\n    └ cn-hk-eq-01-14.bilivideo.com: Equinix IX CDN，香港\n请选择 PCDN 要重定向的主机名。
Host.MCDN=input,"proxy-tf-all-ws.bilivideo.com",tag=[主机名] 重定向 MCDN 主机名 (中国大陆), desc=[主机名] 重定向 MCDN 主机名 (中国大陆)\n    └ proxy-tf-all-ws.bilivideo.com: proxy-tf-all-ws.bilivideo.com\n请选择 MCDN 要重定向的主机名。
Storage=input,"Argument",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 优先使用来自 $argument 的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用 PersistentStore (BoxJs) 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 PersistentStore (BoxJs) > $argument > database.
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[General]
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:8000, *:8082, *:9102

[Rewrite]
request if ${url} ~= /^http:\/\/upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com(?::80)?\/upgcxcode\//i then url.replace("http://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^http:\/\/cn-hk-eq-[a-z0-9-]+\.bilivideo\.com(?::80)?\/upgcxcode\//i then url.replace("http://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^http:\/\/upos-hz-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\//i then url.replace("http://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^http:\/\/upos-sz-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\//i then url.replace("http://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^http:\/\/upos-sz-mirror[a-z0-9-]*bstar1\.bilivideo\.com(?::80)?\/upgcxcode\//i then url.replace("http://{Host.BStar}/upgcxcode/")
request if ${url} ~= /^http:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\//i then url.replace("http://{Host.BStar}/upgcxcode/")
request if ${url} ~= /^https:\/\/upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^https:\/\/cn-hk-eq-[a-z0-9-]+\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^https:\/\/upos-hz-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^https:\/\/upos-sz-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.OverseaVideo}/upgcxcode/")
request if ${url} ~= /^https:\/\/upos-sz-mirror[a-z0-9-]*bstar1\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.BStar}/upgcxcode/")
request if ${url} ~= /^https:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\//i then url.replace("https://{Host.BStar}/upgcxcode/")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Redirect(?:\?.*)?$/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_BiliBili.Redirect.boxjs.json", 200)

[Script]
request if ${url} ~= /^https?:\/\/.+\.bilivideo\.com(?::(?:80|443|4483))?\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.CDN.upgcxcode.m4s"

request if ${url} ~= /^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:8000|8082))?\/v1\/resource\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.MCDN.v1.resource.m4s"

request if ${url} ~= /^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:4483|9102))?\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.MCDN.upgcxcode.m4s"

request if ${url} ~= /^https?:\/\/(.+):4480\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.PCDN.upgcxcode.m4s"

request if ${url} ~= /^https?:\/\/upos-hz-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.Akamaized.hz.upgcxcode.m4s"

request if ${url} ~= /^https?:\/\/upos-sz-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.Akamaized.sz.upgcxcode.m4s"

request if ${url} ~= /^https?:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\//i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Redirect/Biliverse_request.bundle.js", {${Host.OverseaVideo}, ${Host.BStar}, ${Host.PCDN}, ${Host.MCDN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Redirect.Akamaized.bstar1.upgcxcode.m4s"

[MITM]
hostname = biliverse.github.io, *.mcdn.bilivideo.cn, upos-sz-mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net, upos-sz-mirror*.bilivideo.com:4483, cn-hk-eq-*.bilivideo.com:4483, upos-*-mirrorakam.akamaized.net:4483, app.bilibili.com

