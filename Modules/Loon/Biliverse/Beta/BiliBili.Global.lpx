[Script]
http-request ^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Global(?:\?.*)?$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_config.bundle.js, tag=PreferencePanes.Config.Global

http-request ^https?:\/\/www\.bilibili\.com\/bangumi\/play\/(ss|ep)\d+\/? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.bangumi.play.html

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.viewunite.v1.View.grpc

http-response ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.viewunite.v1.View.grpc

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.season.json

http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, tag=📺 BiliBili.Global.season.json

http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/ep\/list\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, tag=📺 BiliBili.Global.ep.list.json

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.playerunite.v1.Player.grpc

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.player.v2.PlayURL.grpc

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/(api|web)\/playurl(\/html5)?\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.player.playurl.json

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/web\/v2\/playurl\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.player.v2.playurl.json

http-request ^https?:\/\/search\.bilibili\.com\/all\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.html

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/(SearchAll|SearchByType)$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.search.grpc

http-request ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/search(\/type)?\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.app.json

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/wbi\/search\/(all\/v2|type)\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.wbi.json

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/search\/(all\/v2|type)\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.pc.json

http-request ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/space\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.space.app.json

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/space\/wbi\/acc\/info\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.space.wbi.json

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/space\/acc\/info\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.space.pc.json

