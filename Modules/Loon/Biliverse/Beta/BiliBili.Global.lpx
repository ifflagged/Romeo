#!name=📺 BiliBili: 🌐 Global
#!desc=哔哩哔哩：全球模式\n中国站自动线路及全区搜索
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Biliverse
#!openUrl=http://boxjs.com/#/app/BiliBili.Global
#!homepage=https://biliverse.github.io/guide/global
#!date=2026-09-17 14:37:43
#!version=0.8.25

[Argument]
ForceHost=input,"1",tag=强制CDN主机名类型, desc=强制CDN主机名类型\n    ├ 0: IP: 返回远端DNS解析地址（强烈不推荐！严重影响域名分流规则与CDN重定向）\n    ├ 1: HTTP: 返回HTTP域名（推荐，免去重定向时MitM操作）\n    └ 2: HTTPS: 返回HTTPS域名（不推荐，重定向时需对指定域名启用MitM）\n请设置强制返回的CDN主机名类型。
Locales=input,"CHN,HKG,TWN",tag=启用自动识别与分流功能的地区, desc=启用自动识别与分流功能的地区\n    ├ CHN: 🇨🇳中国大陆\n    ├ HKG: 🇭🇰中国香港\n    ├ MAC: 🇲🇴中国澳门\n    └ TWN: 🇹🇼中国台湾\n请选择启用自动识别与分流功能的地区。
Proxies.CHN=input,"DIRECT",tag=[🇨🇳中国大陆] 代理策略名称, desc=[🇨🇳中国大陆] 代理策略名称\n请填写此地区的代理或策略组名称。
Proxies.HKG=input,"🇭🇰香港",tag=[🇭🇰中国香港] 代理策略名称, desc=[🇭🇰中国香港] 代理策略名称\n请填写此地区的代理或策略组名称。
Proxies.MAC=input,"🇲🇴澳门",tag=[🇲🇴中国澳门] 代理策略名称, desc=[🇲🇴中国澳门] 代理策略名称\n请填写此地区的代理或策略组名称。
Proxies.TWN=input,"🇹🇼台湾",tag=[🇹🇼中国台湾] 代理策略名称, desc=[🇹🇼中国台湾] 代理策略名称\n请填写此地区的代理或策略组名称。
Storage=input,"Argument",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 优先使用来自 $argument 的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用 PersistentStore (BoxJs) 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 PersistentStore (BoxJs) > $argument > database。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Global(?:\?.*)?$/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_BiliBili.Global.boxjs.json", 200)

[Script]
request if ${url} ~= /^https?:\/\/www\.bilibili\.com\/bangumi\/play\/(ss|ep)\d+\/?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.bangumi.play.html"

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.viewunite.v1.View.grpc", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.viewunite.v1.View.grpc", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.season.json"

response if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.season.json", requires_body=true

response if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/ep\/list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.ep.list.json", requires_body=true

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.playerunite.v1.Player.grpc", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.player.v2.PlayURL.grpc", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/(api|web)\/playurl(\/html5)?\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.player.playurl.json"

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/web\/v2\/playurl\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.player.v2.playurl.json"

request if ${url} ~= /^https?:\/\/search\.bilibili\.com\/all\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.search.html"

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/(SearchAll|SearchByType)$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.search.grpc", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/search(\/type)?\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.search.app.json"

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/wbi\/search\/(all\/v2|type)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.search.wbi.json"

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/search\/(all\/v2|type)\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.search.pc.json"

request if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/space\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.space.app.json"

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/space\/wbi\/acc\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.space.wbi.json"

request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/space\/acc\/info\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.space.pc.json"

[MITM]
hostname = biliverse.github.io, www.bilibili.com, search.bilibili.com, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.biliapi.net, grpc.biliapi.net

