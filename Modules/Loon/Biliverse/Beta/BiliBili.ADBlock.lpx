#!name=📺 BiliBili: 🛡️ ADBlock
#!desc=哔哩哔哩：去广告\n自定义去除APP内界面元素
#!author=ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!icon=icon not found
#!tag=Jacob
#!openUrl=http://boxjs.com/#/app/BiliBili.ADBlock
#!homepage=https://biliverse.github.io/guide/ad-block
#!date=2026-09-17 11:51:01
#!version=0.6.27

[Argument]
Splash=switch,true,false,tag=[开屏] 去除广告, desc=[开屏] 去除广告\n是否启用此处修改
Feed.AD=switch,true,false,tag=[推荐] 去除广告, desc=[推荐] 去除广告\n是否启用此处修改
Feed.Activity=switch,false,true,tag=[推荐] 去除“活动大图”, desc=[推荐] 去除“活动大图”\n是否启用此处修改
Feed.Vertical=switch,false,true,tag=[推荐] 去除竖屏视频, desc=[推荐] 去除竖屏视频\n是否启用此处修改
Feed.BlockUpLiveList=input,"",tag=[推荐] 屏蔽UP主直播推广, desc=[推荐] 屏蔽UP主直播推广\n填写up主uid，以英文逗号隔开。
Feed.Story=switch,true,false,tag=[首页] 去除短视频流广告, desc=[首页] 去除短视频流广告\n是否启用此处修改
Feed.StoryCommercial=switch,true,false,tag=[首页] 去除Story商业按钮, desc=[首页] 去除Story商业按钮\n移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。
Search.AD=switch,true,false,tag=[搜索] 去除广告, desc=[搜索] 去除广告\n是否启用此处修改
Search.Tracking=switch,false,true,tag=[搜索] 移除响应跟踪参数, desc=[搜索] 移除响应跟踪参数\n清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。
Search.HotSearch=switch,true,false,tag=[搜索] 去除“热搜”, desc=[搜索] 去除“热搜”\n是否启用此处修改
PGC.AD=switch,true,false,tag=[番剧电影] 去除广告, desc=[番剧电影] 去除广告\n是否启用此处修改
Xlive.AD=switch,true,false,tag=[直播] 去除广告, desc=[直播] 去除广告\n是否启用此处修改
Xlive.RemoveTrackingCallbacks=switch,false,true,tag=[直播] 移除推荐回调, desc=[直播] 移除推荐回调\n移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。
Xlive.RemovePreloadTracking=switch,false,true,tag=[直播] 移除预载链接trackid, desc=[直播] 移除预载链接trackid\n只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。
Dynamic.HotTopics=switch,true,false,tag=[动态] 去除“热门话题”, desc=[动态] 去除“热门话题”\n是否启用此处修改
Dynamic.MostVisited=switch,false,true,tag=[动态] 去除“最常访问”, desc=[动态] 去除“最常访问”\n是否启用此处修改
Dynamic.MostVisitedLiveOnly=switch,false,true,tag=[动态] “最常访问”仅显示直播, desc=[动态] “最常访问”仅显示直播\n是否启用此处修改
Dynamic.AdCard=switch,true,false,tag=[动态] 去除广告卡片, desc=[动态] 去除广告卡片\n是否启用此处修改
Dynamic.PersonalAdCard=switch,false,true,tag=[动态] 去除个人流广告卡片, desc=[动态] 去除个人流广告卡片\n过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。
View.AD=switch,true,false,tag=[视频] 去除播放页广告, desc=[视频] 去除播放页广告\n是否启用此处修改
DM.Command=switch,false,true,tag=[弹幕] 去除交互式弹幕, desc=[弹幕] 去除交互式弹幕\n是否启用此处修改
DM.Colorful=switch,false,true,tag=[弹幕] 替换彩色弹幕, desc=[弹幕] 替换彩色弹幕\n是否启用此处修改
DM.Airborne=switch,false,true,tag=[弹幕] 空降助手, desc=[弹幕] 空降助手\n是否启用此处修改
Reply.AD=switch,true,false,tag=[评论] 去除广告, desc=[评论] 去除广告\n是否启用此处修改
Reply.CommercialLinks=switch,false,true,tag=[评论] 禁用普通评论商业跳转, desc=[评论] 禁用普通评论商业跳转\n保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。
Reply.SubjectDescriptionCommercial=switch,false,true,tag=[评论] 隐藏编辑器商品能力, desc=[评论] 隐藏编辑器商品能力\n移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。
Privacy.Tracking=switch,true,false,tag=[隐私] 移除响应链接跟踪参数, desc=[隐私] 移除响应链接跟踪参数\n清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。
Privacy.BlockBiliCommercial=switch,false,true,tag=[隐私] 阻止B站商业上报, desc=[隐私] 阻止B站商业上报\n本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。
Privacy.BlockThirdParty=switch,false,true,tag=[隐私] 阻止第三方广告归因, desc=[隐私] 阻止第三方广告归因\n本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。
Privacy.Strict=switch,false,true,tag=[隐私] 严格模式, desc=[隐私] 严格模式\n同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 🔴 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? response-body-json-jq 'del(.data.payment)'
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$ mock-response-body data-type=file data="https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.ADBlock/Biliverse_BiliBili.ADBlock.boxjs.json" status-code=200
# 去除默认搜索词：最小合法空 gRPC 帧
^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ mock-response-body data-type=base64 data="AAAAAAA=" status-code=200 mock-data-is-base64=true
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words mock-response-body data-type=text data="{}"
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr mock-response-body data-type=text data="{}"
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist mock-response-body data-type=text data="{}"
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash mock-response-body data-type=text data="{}"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash mock-response-body data-type=text data="{}"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? mock-response-body data-type=text data="{}"
# 番剧页可能弹出的HTML广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? mock-response-body data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"

[Script]
http-request ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.ADBlock/Biliverse_request.bundle.js, tag=📺 BiliBili.ADBlock.feed.index.request.json, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]

http-request ^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/) script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.ADBlock/Biliverse_request.bundle.js, tag=📺 BiliBili.ADBlock.privacy.request, argument=[{Splash},{Feed.AD},{Feed.Activity},{Feed.Vertical},{Feed.BlockUpLiveList},{Feed.Story},{Feed.StoryCommercial},{Search.AD},{Search.Tracking},{Search.HotSearch},{PGC.AD},{Xlive.AD},{Xlive.RemoveTrackingCallbacks},{Xlive.RemovePreloadTracking},{Dynamic.HotTopics},{Dynamic.MostVisited},{Dynamic.MostVisitedLiveOnly},{Dynamic.AdCard},{Dynamic.PersonalAdCard},{View.AD},{DM.Command},{DM.Colorful},{DM.Airborne},{Reply.AD},{Reply.CommercialLinks},{Reply.SubjectDescriptionCommercial},{Privacy.Tracking},{Privacy.BlockBiliCommercial},{Privacy.BlockThirdParty},{Privacy.Strict},{LogLevel}]

