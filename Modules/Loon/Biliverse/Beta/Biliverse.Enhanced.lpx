#!name=🪐 Biliverse: ⚙️ Enhanced
#!desc=哔哩哔哩：增强模式\n中国站功能增强及UI自定义
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Biliverse
#!openUrl=http://boxjs.com/#/app/Biliverse.Enhanced
#!homepage=https://biliverse.github.io/guide/enhanced
#!date=2026-09-22 01:53:39
#!version=0.6.0

[Argument]
Home.Switch=switch,true,false,tag=[首页] 启用自定义功能, desc=[首页] 启用自定义功能\n启用后可自定义首页顶栏、标签页和底部导航栏内容。标签页由分区页的快捷访问决定。
Home.Tab=input,"2036,2037,780,545,151",tag=[首页] 标签页, desc=[首页] 标签页\n    ├ 2036: 直播\n    ├ 2037: 推荐\n    ├ 780: 热门\n    ├ 545: 番剧\n    ├ 774: 动画（港澳台）\n    ├ 151: 影视\n    ├ 801: 韩综（港澳台）\n    └ 2280: 校园\n这里只列出常用选项；分区页提供接近60个快捷访问选项，无法在模块参数中完整列出。请前往 BiliBili App 分区页，使用原生“快捷访问”功能自定义首页标签页。
Home.Tab_default=input,"2037",tag=[首页] 默认标签页, desc=[首页] 默认标签页\n    ├ 2036: 直播\n    ├ 2037: 推荐\n    ├ 780: 热门\n    ├ 545: 番剧\n    ├ 774: 动画（港澳台）\n    ├ 151: 影视\n    ├ 801: 韩综（港澳台）\n    └ 2280: 校园\n请选择启动APP时默认展示的标签页，需先将该标签页加入分区页的快捷访问。
Home.Top_left=input,"mine",tag=[首页] 顶栏（左侧）按钮（用户头像）, desc=[首页] 顶栏（左侧）按钮（用户头像）\n    ├ mine: 用户中心-我的\n    └ videoshortcut: 短视频\n请选择顶栏（左侧）按钮（用户头像）的作用（在biliBili粉色版中无法修改）。
Home.Top=input,"messages",tag=[首页] 顶栏（右侧）按钮, desc=[首页] 顶栏（右侧）按钮\n    ├ game_center: 游戏中心\n    ├ mall: 会员购\n    └ messages: 消息\n请选择启用的顶栏（右侧）按钮。
Home.Top_more=input,"categories,search",tag=[首页] 标签栏右侧按钮, desc=[首页] 标签栏右侧按钮\n    ├ categories: 更多分区\n    └ search: 搜索\n请选择启用的首页标签栏右侧按钮。
Bottom=input,"home,dynamic,ogv,mall,mine",tag=[底部] 导航栏按钮, desc=[底部] 导航栏按钮\n    ├ home: 首页\n    ├ dynamic: 动态\n    ├ publish: 发布\n    ├ ogv: 节目（港澳台）\n    ├ mall: 会员购\n    ├ messages: 消息\n    └ mine: 我的\n请选择启用的底部导航栏按钮，最多6个。
Region.Switch=switch,true,false,tag=[分区] 启用此标签页自定义功能, desc=[分区] 启用此标签页自定义功能\n启用后可自定义分区标签页的内容。
Mine.Switch=switch,true,false,tag=[我的] 启用此标签页自定义功能, desc=[我的] 启用此标签页自定义功能\n启用后可自定义我的标签页的服务内容。
Mine.iPad.Switch=switch,true,false,tag=[我的 iPad版] 启用此标签页自定义功能, desc=[我的 iPad版] 启用此标签页自定义功能\n启用后可自定义iPad版我的标签页的服务内容。
Storage=input,"PersistentStore",tag=[储存] 配置类型, desc=[储存] 配置类型\n    ├ Argument: 优先使用 $argument，其次使用 PersistentStore (BoxJs)，最后使用 database.mjs 的默认配置\n    ├ PersistentStore: 优先使用 PersistentStore (BoxJs)，其次使用 $argument，最后使用 database.mjs 的默认配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n默认使用 PersistentStore，配置优先级为 database -> $argument -> PersistentStore (BoxJs)；选择 Argument 时为 database -> PersistentStore (BoxJs) -> $argument。
LogLevel=input,"WARN",tag=[调试] 日志等级, desc=[调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/theme\.css(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/theme.css", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/index\.mjs(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/index.mjs", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Biliverse_subject\.png(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/assets/Biliverse_subject.png", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Enhanced_subject\.png(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/assets/Enhanced_subject.png", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Global_subject\.png(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/assets/Global_subject.png", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/Redirect_subject\.png(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/assets/Redirect_subject.png", 200)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/assets\/ADBlock_subject\.png(?:\?[^#]*)?$/i then response.body.mock("file", "https://biliverse.github.io/settings/assets/ADBlock_subject.png", 200)
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/[a-zA-Z0-9_-]+\/?(?:\?[^#]*)?$/i then response.body.mock("file", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.html", 200)
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/index\.mjs(?:\?[^#]*)?$/i then response.body.mock("file", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/index.mjs", 200)
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/settings\/assets\/navigation\.mjs(?:\?[^#]*)?$/i then response.body.mock("file", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/navigation.mjs", 200)
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$/i then response.body.mock("file", "https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_Biliverse.Enhanced.PreferencePanes.json", 200)

[Script]
request if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/NSNanoCat_api.js") with tag="PreferencePanes.API", requires_body=true

response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.resource.show.tab.v2", requires_body=true

request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_request.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.show.v1.Mixture.RegionList.response.grpc", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.account.mine", requires_body=true

response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.region.index", requires_body=true

response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/Biliverse.Enhanced/Biliverse_response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.channel.region.list", requires_body=true

[MITM]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net

