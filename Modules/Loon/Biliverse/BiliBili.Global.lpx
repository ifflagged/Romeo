http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/wbi\/search\/(all\/v2|type)\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.wbi.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/web-interface\/search\/(all\/v2|type)\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.pc.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/space\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.space.app.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

