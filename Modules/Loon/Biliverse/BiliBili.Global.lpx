#!name=📺 BiliBili: 🌐 Global
#!desc=哔哩哔哩：全球模式\n中国站自动线路及全区搜索
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!tag=Jacob
#!openUrl=http://boxjs.com/#/app/BiliBili.Global
#!homepage=https://biliverse.github.io/guide/global
#!date=2026-09-17 14:37:43
#!version=0.8.25
#!arguments-desc=ForceHost: 强制CDN主机名类型\n    ├ 0: IP: 返回远端DNS解析地址（强烈不推荐！严重影响域名分流规则与CDN重定向）\n    ├ 1: HTTP: 返回HTTP域名（推荐，免去重定向时MitM操作）\n    └ 2: HTTPS: 返回HTTPS域名（不推荐，重定向时需对指定域名启用MitM）\n请设置强制返回的CDN主机名类型。\n\nLocales: 启用自动识别与分流功能的地区\n    ├ CHN: 🇨🇳中国大陆\n    ├ HKG: 🇭🇰中国香港\n    ├ MAC: 🇲🇴中国澳门\n    └ TWN: 🇹🇼中国台湾\n请选择启用自动识别与分流功能的地区。\n\nProxies.CHN: [🇨🇳中国大陆] 代理策略名称\n请填写此地区的代理或策略组名称。\n\nProxies.HKG: [🇭🇰中国香港] 代理策略名称\n请填写此地区的代理或策略组名称。\n\nProxies.MAC: [🇲🇴中国澳门] 代理策略名称\n请填写此地区的代理或策略组名称。\n\nProxies.TWN: [🇹🇼中国台湾] 代理策略名称\n请填写此地区的代理或策略组名称。\n\nStorage: [储存] 配置类型\n    ├ Argument: 优先使用来自 $argument 的配置，$argument 不包含的设置项由 PersistentStore (BoxJs) 提供\n    ├ PersistentStore: 只使用 PersistentStore (BoxJs) 提供的配置\n    └ database: 只使用由作者的 database.mjs 文件提供的默认配置，其他任何自定义配置不再起作用\n选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 PersistentStore (BoxJs) > $argument > database。\n\nLogLevel: [调试] 日志等级\n    ├ OFF: 关闭\n    ├ ERROR: ❌ 错误\n    ├ WARN: ⚠️ 警告\n    ├ INFO: ℹ️ 信息\n    ├ DEBUG: 🅱️ 调试\n    └ ALL: 全部\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n

[Argument]
ForceHost=input,1,tag=ForceHost, desc=ForceHost
Locales=input,CHN,HKG,TWN,tag=Locales, desc=Locales
Proxies.CHN=input,DIRECT,tag=Proxies.CHN, desc=Proxies.CHN
Proxies.HKG=input,🇭🇰香港,tag=Proxies.HKG, desc=Proxies.HKG
Proxies.MAC=input,🇲🇴澳门,tag=Proxies.MAC, desc=Proxies.MAC
Proxies.TWN=input,🇹🇼台湾,tag=Proxies.TWN, desc=Proxies.TWN
Storage=input,Argument,tag=Storage, desc=Storage
LogLevel=input,WARN,tag=LogLevel, desc=LogLevel

[Rewrite]
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Global(?:\?.*)?$ mock-response-body data-type=file data="https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_BiliBili.Global.boxjs.json" status-code=200

[Script]
http-request ^https?:\/\/www\.bilibili\.com\/bangumi\/play\/(ss|ep)\d+\/? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.bangumi.play.html, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.viewunite.v1.View.grpc, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.viewunite.v1.View.grpc, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.season.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, tag=📺 BiliBili.Global.season.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-response ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/ep\/list\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_response.bundle.js, requires-body=true, tag=📺 BiliBili.Global.ep.list.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.playerunite.v1.Player.grpc, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.player.v2.PlayURL.grpc, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/(api|web)\/playurl(\/html5)?\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.player.playurl.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/player\/web\/v2\/playurl\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.player.v2.playurl.json, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/search\.bilibili\.com\/all\? script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, tag=📺 BiliBili.Global.search.html, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

http-request ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/(SearchAll|SearchByType)$ script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Biliverse/BiliBili.Global/Biliverse_request.bundle.js, requires-body=true, binary-body-mode=true, tag=📺 BiliBili.Global.search.grpc, argument=ForceHost="{ForceHost}"&Locales="{Locales}"&Proxies.CHN="{Proxies.CHN}"&Proxies.HKG="{Proxies.HKG}"&Proxies.MAC="{Proxies.MAC}"&Proxies.TWN="{Proxies.TWN}"&Storage="{Storage}"&LogLevel="{LogLevel}"

