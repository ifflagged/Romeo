{"id":"DualSubs.Translate","name":"🍿️ DualSubs: 翻译器（翻译字幕&歌词）","descs_html":["请参照<a href=\"https://DualSubs.github.io\">DualSubs</a>的使用说明进行配置","填写完成后别忘点击此页面底端右下角的\"保存\"。"],"keys":["@DualSubs.Translate.Settings","@DualSubs.Translate.Caches.Subtitles"],"author":"@DualSubs","icons":["https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/ForeignMedia.png","https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png"],"settings":[{"id":"@DualSubs.Translate.Settings.Vendor","name":"服务商API","type":"selects","val":"Google","items":[{"key":"Google","label":"Google Translate"},{"key":"GoogleCloud","label":"Google Cloud Translate（需填写API）"},{"key":"Microsoft","label":"Microsoft Translator（需填写API）"},{"key":"DeepL","label":"DeepL API（需填写API）"}],"desc":"请选择字幕翻译功能所使用的翻译API"},{"id":"@DualSubs.Translate.Settings.ShowOnly","name":"只显示翻译字幕","type":"boolean","val":false,"desc":"是否仅显示翻译后字幕，不显示源语言字幕。"},{"id":"@DualSubs.Translate.Settings.Position","name":"主语言（源语言）字幕位置","type":"selects","val":"Forward","items":[{"key":"Forward","label":"上面（第一行）"},{"key":"Reverse","label":"下面（第二行）"}],"desc":"主语言（源语言）字幕的显示位置"},{"id":"@DualSubs.Translate.Settings.Method","name":"[翻译器] 翻译方式","type":"selects","val":"Part","items":[{"key":"Part","label":"逐段翻译（每50~128句文本合并发送一次翻译请求，对请求次数或频率限制型API友好）"},{"key":"Row","label":"逐句翻译（每句文本都发送一次翻译请求，不限量API可选，但会导致翻译缺乏上下文语境）"}],"desc":"翻译器工作方式，不懂就别动"},{"id":"@DualSubs.Translate.Settings.Times","name":"[翻译器] 重试次数","type":"number","val":"3","desc":"单位：次，正整数","placeholder":"3"},{"id":"@DualSubs.Translate.Settings.Interval","name":"[翻译器] 重试间隔时长","type":"number","val":"500","desc":"单位：毫秒(ms)，正整数","placeholder":"500"},{"id":"@DualSubs.Translate.Settings.Exponential","name":"[翻译器] 重试间隔时长递增","type":"boolean","val":true,"desc":"例如，第一次重试间隔时长1000ms，第二次重试间隔时长2000ms，第三次重试间隔时长4000ms，以此类推"}]}