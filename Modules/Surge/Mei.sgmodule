#!name=  Mei
#!desc= Merged Module For Mei
#!category= Jacob
#!arguments= displayUpList:"auto",purifyComment:true,optimizeRequest:"",sponsorBlock:"",logLevel:"error", block_upload:true,block_shorts:false,auto_hd:true,block_games:true,block_vertical_live:false,jump_ahead:true,block_store:true,block_ai:true,on_the_go:true
#!arguments-desc= # Bilibili\ndisplayUpList: [动态]中[最常访问]的显示方式\nauto: 仅当列表中存在直播状态时显示; show: 始终显示; hide: 始终隐藏;\n可选值: auto, show, hide\n\npurifyComment: [评论区]过滤置顶评论广告\ntrue: 开启; false: 关闭;\n可选值: true, false\n\noptimizeRequest: [评论区]优化加载异常\ntrue: 开启; false: 关闭;\n可选值: 留空启用, # 禁用\n\nsponsorBlock: [空降助手]跳过视频内插播广告\ntrue: 开启; false: 关闭;\n可选值: 留空启用, # 禁用\n\nlogLevel: 日志等级\n选择日志输出等级\n可选值: error, warn, info, debug, off\n\n# youtube-enhance\nblock_upload\n  └ Remove upload tab\nblock_shorts\n  └ Remove Shorts tab\nauto_hd\n  └ Prefer highest offered resolution; Premium bitrate when authorized\nblock_games\n  └ Remove Playables on homepage\nblock_vertical_live\n  └ Remove Vertical live on homepage\njump_ahead\n  └  Enable Jump Ahead button\nblock_store\n  └  Remove creator stores, product cards and overlays\nblock_ai\n  └ Remove Ask, AI summaries and related controls\non_the_go\n  └ On-the-go controls when compatible UI components are available


