[Script]
ithome = type=http-response, pattern=^https:\/\/napi\.ithome\.com\/api\/(news\/index|topmenu\/getfeeds), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ithome/fmz200_ithome.js, requires-body=true, max-size=-1, timeout=60

ithome = type=http-response, pattern=^https:\/\/napi\.ithome\.com\/api\/news\/indexv2\/iphone\/927, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/ithome/fmz200_ithome.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% napi.ithome.com

