[Script]
# 获取多账号京东Cookie
jd_cookie = type=http-request, pattern=^https:\/\/home\.m\.jd\.com\/myJd\/home\.action, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/jd_cookie/fmz200_jd_cookie.js, timeout=60

获取多账号京东Cookie = type=http-request, pattern=^https:\/\/home\.m\.jd\.com\/myJd\/home\.action, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/fmz200/jd_cookie/fmz200_jd_cookie.js, requires-body=true, max-size=0, script-update-interval=0

[MITM]
hostname = %APPEND% home.m.jd.com

