#!name=YouTube
#!desc=Removes ads from the YouTube app, enables background playback and translates existing subtitle tracks (target language zh-CN or en-US, videos without subtitles cannot be translated). Logging captures media response headers only by default, full sampling may add delay. Requires MITM with a trusted certificate.
#!author=devchristian1337
#!icon=icon not found
#!category=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!tag=YouTube, AdBlock
#!loon_version=3.5.1(983)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-10-07
#!arguments=background_playback:false,playback_region:"original",translation_enabled:false,translation_target:"zh-CN",hide_home_shorts:false,blocked_channels:"",blocked_channels_url:"",log_enabled:false,quality_research:false,media_capture_mode:"headers",log_level:"info",capture_budget:"32"

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Header Rewrite]
# Updated 2026-10-05. Actual startup delay still needs device verification, the client may use other HTTP/3 discovery methods.
http-response ^https://(?:[\w-]+\.)*googlevideo\.com(?::443)?/ header-replace 'Alt-Svc' 'clear'

[Script]
# Updated 2026-10-07
YouTube scheduled blocked channels update = type=cron, cronexp=0 * * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument=[{{{blocked_channels_url}}}]

YouTube subtitle target language = type=http-request, pattern=^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument="[{{{translation_enabled}}},{{{translation_target}}}]"

YouTube logging and export = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}},{{{background_playback}}},{{{media_capture_mode}}},{{{quality_research}}}]"

YouTube config request handling = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}},{{{playback_region}}}]"

YouTube media response logging = type=http-response, pattern=^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}}]"

YouTube Onesie config cache = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}}]"

YouTube playback request and ad config handling = type=http-request, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_request.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}},{{{playback_region}}}]"

YouTube feed ads and Home Shorts handling = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}},{{{hide_home_shorts}}},{{{blocked_channels}}},{{{blocked_channels_url}}}]"

YouTube playback response and background playback = type=http-response, pattern=^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/YouTube/devchristian1337_response.min.js, requires-body=true, binary-body-mode=true, timeout=10, argument="[{{{log_enabled}}},{{{log_level}}},{{{capture_budget}}},{{{background_playback}}},{{{quality_research}}}]"

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com

