#!name=Spotify
#!desc=Removes Spotify ads and unlocks some premium features. Audio quality cannot be set to Very High. Enable only one of the two protobuf scripts below, not both. Log in again after enabling the plugin to apply the full configuration.
#!author=devchristian1337
#!icon=icon not found
#!category=devchristian1337
#!openUrl=https://loon-plugins.vercel.app
#!tag=Spotify, AdBlock, Premium
#!loon_version=3.3.4(898)
#!homepage=https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!date=2026-10-08
#!arguments=spot-ev3-enable:true,spot-ev1-enable:false

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del 'if-none-match'

[Map Local]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Hide the discovery feed on the Now Playing screen (personal preference)
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/watch-feed-entrypoints\/v.\/discovery-from-seed data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Hide the membership info in Settings (display only, can be removed)
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Block the AI DJ URL
37i9dQZF1EYkqdzj48dyYq data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
Spotify gabo = type=http-request, pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-gabo.js, timeout=10

Spotify search ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-NoSearchAd.js, requires-body=true, binary-body-mode=true, timeout=10

Spotify home ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-NoHomeAd.js, requires-body=true, binary-body-mode=true, timeout=10

Spotify scroll ads = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-NoScrollAd.js, requires-body=true, binary-body-mode=true, timeout=10

Spotify protobuf (remote) = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-proto-eevee.js, requires-body=true, binary-body-mode=true, timeout=10

Spotify protobuf (local) = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/devchristian1337/Spotify/devchristian1337_spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

