#!name=BoxJs
#!desc=https://boxjs.com
#!category=Plugin
#!author=chavyleung[https://github.com/chavyleung/scripts]

[General]
force-http-engine-hosts = %APPEND% boxjs.com

[Script]
boxjs = type=http-request,pattern=https?:\/\/boxjs\.com,requires-body=true,timeout=120,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/boxjs/chavyleung_chavy.boxjs.js

[MITM]
hostname = %APPEND% boxjs.com
