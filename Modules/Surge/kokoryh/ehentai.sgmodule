ehentai = type=http-response,pattern=^https:\/\/e-hentai\.org\/g\/,requires-body=1,max-size=-1,engine=webview,script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/kokoryh/ehentai/kokoryh_webpage.ehentai.js

[MITM]
