[Script]
WeChat.mmspamsupport.response = type=http-response, pattern=^https?:\/\/weixin110\.qq\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi(\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/VirgilClyne/Fries.WeChat.beta/VirgilClyne_WeChat.response.beta.js, requires-body=true, engine=webview

[MITM]
hostname = %APPEND% szsupport.weixin.qq.com, weixin110.qq.com

