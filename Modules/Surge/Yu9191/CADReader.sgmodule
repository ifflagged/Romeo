[Script]
CADReader = type=http-request, pattern=^https://cad\.everdrawing\.com/(mobile/verifyVip|.*authorize/(verify-vip|query)), requires-body=1, max-size=4096, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/CADReader/ios151_cad.js

[MITM]
hostname = %APPEND% cad.everdrawing.com
