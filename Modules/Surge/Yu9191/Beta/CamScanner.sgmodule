#!name=CamScanner
#!desc=CamScanner
#!icon=icon not found
#!category=Yu9191

[Script]
CamScanner = type=http-response, pattern=^https:\/\/.*\.(intsig\.net|camscanner\.com), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/CamScanner.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.camscanner.com, *.intsig.net

