[Script]
mxshm = type=http-response, pattern=^https:\/\/www\.mxs11\.cc\/(chapter|book)\/\d+, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/mxshm.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% www.mxs11.cc

