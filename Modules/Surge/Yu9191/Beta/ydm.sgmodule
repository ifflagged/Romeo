[URL Rewrite]
^https?:\/\/(?:[a-z0-9-]+\.)?cloudfront\.net\/api\/(?:sys\/partner\/list|activity\/indexActs|sys\/advertisement\/list|sys\/getImgAndVideoCdnList|aibox\/entranceConfig) - reject
^https?:\/\/snerbnew\.pxyzjmspfl\.work\/api\/(?:sys\/partner\/list|activity\/indexActs|sys\/advertisement\/list|sys\/getImgAndVideoCdnList|aibox\/entranceConfig) - reject

[Script]
ydm2 = type=http-request, pattern=https:\/\/[^\/]+\.cloudfront\.net\/api\/m3u8\/decode\/authPath, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm/ios151_ydm2.js, timeout=60

ydm = type=http-response, pattern=^https:\/\/(?:[a-zA-Z0-9-]+\.cloudfront\.net|snerbnew\.pxyzjmspfl\.work)(?::\d+)?\/api\/(?:video\/getVideoById|user\/base\/info|community\/dynamic\/dynamicInfo), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm/ios151_ydm.js, requires-body=true, max-size=-1, timeout=60

ydm2 = type=http-request, pattern=^https:\/\/snerbnew\.pxyzjmspfl\.work(?::\d+)?\/api\/m3u8\/decode\/authPath, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/ydm/ios151_ydm2.js, timeout=60

[MITM]
hostname = %APPEND% *.cloudfront.net, snerbnew.pxyzjmspfl.work, snerbnew.pxyzjmspfl.work:51999

