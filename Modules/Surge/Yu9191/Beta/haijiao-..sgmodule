[Script]
haijiao = type=http-response, pattern=^https?:\/\/(www\.)?haijiao\.com\/api\/(attachment|topic\/\d+|banner\/banner_list), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/haijiao.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% haijiao.com, *.haijiao.com

