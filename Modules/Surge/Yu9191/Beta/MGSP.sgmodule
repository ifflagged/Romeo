#!name=咪咕视频
#!desc=伟人
#!icon=icon not found
#!category=Yu9191

[Map Local]
^https://.*miguvideo\.com/request/sdk data-type=text data=" " status-code=200

^https://common-sc\.miguvideo\.com/task/v7/task-list/cmvideo/visitor data-type=text data=" " status-code=200

[Script]
mgsp = type=http-response, pattern=^https?:\/\/(play|dis).*miguvideo.com\/(play|dis)(url|play)\/.*$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MGSP/WeiGiegie_mgsp.js, requires-body=true, max-size=-1, timeout=60

mgspck = type=http-request, pattern=^https?:\/\/play.miguvideo.com\/playurl\/v1\/play\/playurl\?2Kvivid=true?.*=true$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/MGSP/ios151_mgspck.js, timeout=60

[MITM]
hostname = %APPEND% *.miguvideo.com

