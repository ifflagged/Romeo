[Script]
rjdd = type=http-response, pattern=^https?:\/\/.*\.mypep\.cn\/(thirdPartyService\/book_init(_v3)?\.json|user\/ak\/pep_click\/user\/.*\/userinfo\.json|loginvcode|unit\/encrypt\/detail), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/rjdd.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.mypep.cn

