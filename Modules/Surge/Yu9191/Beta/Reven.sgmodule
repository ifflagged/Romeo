[URL Rewrite]
https://api.lianjiu.fun/app/api/v1/profile - reject

[Script]
Revenuecat = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/Reven/ios151_Revenuecat.js, requires-body=true, max-size=-1, timeout=60

Revenuecat = type=http-request, pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/Reven/ios151_Revenuecat.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.lianjiu.fun

