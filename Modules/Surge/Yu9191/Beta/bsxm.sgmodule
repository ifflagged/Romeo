[Script]
bsxm = type=http-request, pattern=^http:\/\/\d{10}\.vod2\.myqcloud\.com\/[a-zA-Z0-9]+\/[a-zA-Z0-9]+\/video_\d+_\d+\.m3u8, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/bsxm/ios151_bsxm.js, timeout=60

[MITM]
hostname = %APPEND% *.vod2.myqcloud.com

