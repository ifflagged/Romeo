[Rule]
DOMAIN,*.adukwai.com,REJECT

[Script]
chsj = type=http-response, pattern=^https:\/\/api2\.vilipix\.com\/api\/v1\/user\/current, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/chsj.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api2.vilipix.com

