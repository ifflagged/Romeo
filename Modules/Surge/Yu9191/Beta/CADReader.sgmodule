[Script]
CADReader = type=http-request, pattern=^https://cad\.everdrawing\.com/(mobile/verifyVip|.*authorize/(verify-vip|query)), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/cad.js, requires-body=true, max-size=4096

[MITM]
hostname = %APPEND% cad.everdrawing.com

