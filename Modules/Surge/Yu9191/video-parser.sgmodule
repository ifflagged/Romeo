#!name=video-parser
#!desc=video-parser
#!icon=icon not found
#!category=Yu9191

[Script]
# NBA视频和电视剧
video-parser = type=http-response, pattern=https:\/\/bp-api\.bestv\.com\.cn\/cms\/api\/(live\/studio\/id\/v8|c\/player\/common), script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/KDF/video-parser.js, requires-body=true, max-size=-1, timeout=60

# HTML页面
video-parser = type=http-response, pattern=^https?:\/\/360\.com\/(?:video|nba\.m3u|dianshi\.m3u)$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/KDF/video-parser.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% 360.com, bp-api.bestv.com.cn

