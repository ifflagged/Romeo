#!name=gzm
#!desc=gzm
#!icon=icon not found
#!category=Yu9191

[Script]
gzm = type=http-response, pattern=^https?:\/\/(?:h5\.|platform\.)?singerdream\.com\/(?!.*\.jpg).*$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/gzm.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% h5.singerdream.com, platform.singerdream.com, singerdream.com

