[Script]
kugou_signin = type=http-request, pattern=^https:\/\/gateway\.kugou\.com\/youth\/v1\/activity\/get_listen_song_task\?.*, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/KuGougainianban/Yu9191_kugou_signin.js, timeout=60

# 定时签到（每天 09:10 执行一次）
酷狗音乐概念版签到 = type=cron, cronexp=10 9 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Yu9191/KuGougainianban/Yu9191_kugou_signin.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% gateway.kugou.com

