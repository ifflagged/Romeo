simplypiano = type=http-response, pattern=^https:\/\/guitaralicdn\.joytunescn\.com\/server\/accounts\/accountAuthenticate$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/simplypiano.js, requires-body=true, max-size=-1, timeout=60

simplypiano = type=http-response, pattern=^https:\/\/guitaralicdn\.joytunescn\.com\/server\/accounts\/accountAuthenticateForAutoLogin$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/simplypiano.js, requires-body=true, max-size=-1, timeout=60

simplypiano = type=http-response, pattern=^https:\/\/guitaralicdn\.joytunescn\.com\/server\/accounts\/accountSyncProgress$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/simplypiano.js, requires-body=true, max-size=-1, timeout=60

# Simply Sing (sing.joytunes.com)
simplypiano = type=http-response, pattern=^https:\/\/sing\.joytunes\.com\/server\/accounts\/authenticate$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/simplypiano.js, requires-body=true, max-size=-1, timeout=60

