# Intercom 客服系统 (fjfoh75b-ios.mobile-messenger.intercom.com)
simplypiano = type=http-response, pattern=^https:\/\/fjfoh75b-ios\.mobile-messenger\.intercom\.com\/messenger\/mobile\/users$, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/refs/heads/main/simplypiano.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% alicdn.joytunescn.com, guitaralicdn.joytunescn.com, sing.joytunes.com, draw-accounts.joytunes.com, fjfoh75b-ios.mobile-messenger.intercom.com

