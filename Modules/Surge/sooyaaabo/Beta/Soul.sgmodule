#!arguments=vist:,chatPri:,picRead:
#!arguments-desc=vist: 主页访问数量提示\ntrue: 开启; false: 关闭;\n可选值: true, false\n\nchatPri: 私聊免礼\ntrue: 开启; false: 关闭;\n可选值: true, false\n\npicRead: 阅后即焚\ntrue: 开启; false: 关闭;\n可选值: true, false

[Rule]
# 地理位置 - 影响注册账号时的属地判断
DOMAIN-SUFFIX,soulapp.cn,DIRECT
IP-CIDR,8.210.3.170/32,DIRECT,no-resolve
IP-CIDR,47.75.72.47/32,DIRECT,no-resolve
IP-CIDR,13.127.149.196/32,DIRECT,no-resolve
IP-CIDR,52.194.158.59/32,DIRECT,no-resolve
IP-CIDR,47.56.131.76/32,DIRECT,no-resolve
IP-CIDR,47.75.72.47/32,DIRECT,no-resolve
IP-CIDR,3.0.163.78/32,DIRECT,no-resolve
# 官方广告
DOMAIN,ad-h5-cdn.soulapp.cn,REJECT
DOMAIN,ad-h5-station-cdn.soulapp.cn,REJECT
DOMAIN,ad-r.soulapp.cn,REJECT
DOMAIN,soul-ad.soulapp.cn,REJECT
DOMAIN,ssp.soulapp.cn,REJECT
# 第三方平台广告
DOMAIN,ssp.1rtb.com,REJECT
DOMAIN,impdsp.meituan.com,REJECT
# DOMAIN, s3plus.meituan.net, REJECT
DOMAIN,ssp.maplehaze.cn,REJECT
# IP-CIDR, 47.56.131.76/32, REJECT, no-resolve
IP-CIDR,47.97.215.55/32,REJECT,no-resolve
IP-CIDR,47.99.42.29/32,REJECT,no-resolve
IP-CIDR,47.110.187.87/32,REJECT,no-resolve
IP-CIDR,47.243.147.125/32,REJECT,no-resolve
IP-CIDR,120.27.235.201/32,REJECT,no-resolve
IP-CIDR,121.196.197.147/32,REJECT,no-resolve

[Body Rewrite]
http-response-jq (?i)^https:\/\/(?:api-\w+|gateway-mobile-gray|post)\.soulapp\.cn\/(?:furion\/position\/content|hot\/soul\/rank|mobile\/app\/version\/queryIos|official\/scene\/module|teenager\/config|v2\/post\/gift\/list|v\d\/post\/homepage\/guide\/card) 'delpaths([["data"]])'
http-response-jq (?i)^https:\/\/chat-live\.soulapp\.cn\/live\/queryFollowRoomList '.data.recUserFeedList = []'
http-response-jq (?i)^https:\/\/chat-live\.soulapp\.cn\/square\/relation\/guideUserList '.data.userDTOList = []'
http-response-jq (?i)^https:\/\/api-user\.soulapp\.cn\/v6\/planet\/config '.data.showRedMind = false | .data.showLuckyBag = false | .data.coreCards |= map(select(.type != 27))'
http-response-jq (?i)^https:\/\/chat-live\.soulapp\.cn\/chatroom\/chatClassifyRoomList '.data.positionContentRespList = []'
http-response-jq (?i)^https:\/\/post\.soulapp\.cn\/homepage\/tabs\/v2 '.data.selectedTagPool = {} | .data.headTabDTOList |= map(select(.tabCode != "STAR_TRAILS"))'
http-response-jq (?i)^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo '.data.res |= map(.iconConfig = null)'

[Map Local]
(?i)^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2 data-type=text data="" status-code=200

# 广告下发
(?i)^https:\/\/ssp\.soulapp\.cn\/api\/q data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/47\.110\.187\.87\/winterfell\/(?:v2\/)?getIpByDomain data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 主页瞬间指导
(?i)^https:\/\/post\.soulapp\.cn\/v\d\/post\/homepage\/guide\/card data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 青少年弹窗
(?i)^https:\/\/api-account\.soulapp\.cn\/teenager\/config data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 谁看过我横幅广告
(?i)^https:\/\/api-a\.soulapp\.cn\/official\/scene\/module data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 主页右下角悬浮广告
(?i)^https:\/\/api-user\.soulapp\.cn\/furion\/position\/content data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 通讯录右下角机器人图标
(?i)^https:\/\/api-chat\.soulapp\.cn\/addressBook\/showBubblingEnter data-type=text data="" status-code=404

# 表情推荐
(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/interact\/getEmojiList data-type=text data="" status-code=404

# 我的页面soul币活动推荐
(?i)^https:\/\/increase-openapi\.soulapp\.cn\/increase\/fission\/getHomePageRedIcon data-type=text data="" status-code=404

# 首次私聊打开星球交汇小卡片
(?i)^https:\/\/api-chat\.soulapp\.cn\/similar\/post\/intersect\/trigger data-type=text data="" status-code=404

# 首次打开私聊界面底部瞬间表情推荐
(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/guide\/defaultWord data-type=text data="" status-code=404

# 聊天输入文字时的gif表情推荐
(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/emoji\/recommend data-type=text data="" status-code=404

# 去除私聊瞬间小横幅
(?i)^https:\/\/api-a\.soulapp\.cn\/shara\/app\/url data-type=text data="" status-code=404

# 私聊快捷菜单
(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/quick\/menu data-type=text data="" status-code=404

# 私聊用户匹配推荐
(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/session\/quickButtonCheck data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 派对体验反馈
(?i)^https:\/\/chat-live\.soulapp\.cn\/live\/config\/rec-feedback data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 广场关注tab用户派对推荐
(?i)^https:\/\/post\.soulapp\.cn\/post\/relationUser\/chatRooms data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 聊天页通讯录tab邀请好友回归横幅
(?i)^https:\/\/increase-openapi\.soulapp\.cn\/increase\/dusting\/getAddressBookDustings data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 派对的关注tab隐藏猜我喜欢的派对
(?i)^https:\/\/chat-live\.soulapp\.cn\/live\/queryRelevantList data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 主页ai描述推荐
(?i)^https:\/\/api-user\.soulapp\.cn\/user\/desc\/getUserPersonalDesc data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 我的页面瞬间得分向导
(?i)^https:\/\/post\.soulapp\.cn\/v1\/post\/homepage\/ai\/assistant\/guide data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 聊天列表页面顶部头像推荐横幅
(?i)^https:\/\/api-chat\.soulapp\.cn\/chatList\/limitAvatar\/entrance data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 聊天列表页面顶部用户推荐
(?i)^https:\/\/api-chat\.soulapp\.cn\/chatList\/top\/recommendList data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 派对左、右上角广告图标
(?i)^https:\/\/activity\.soulapp\.cn\/commercial\/room\/resources data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/chat-live\.soulapp\.cn\/official\/scene\/module data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# response if ${url} ~= /^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo/i then script("https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Soul/ishowshu_soul.js", {${hot}, ${all}, ${emotion}, ${personal}, ${play}, ${interest}, ${argue}, ${story}, ${chat}, ${heart}}) with tag="[Soul]派对频道列表"
{{{{{vist}}}}}[Soul]个人主页数量提示 = type=http-response, pattern=(?i)^https:\/\/api-user\.soulapp\.cn\/user\/homepage\/metrics, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Soul/ishowshu_soul.js, requires-body=true

{{{{{chatPri}}}}}[Soul]去除私聊限制 = type=http-response, pattern=(?i)^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Soul/ishowshu_soul.js, requires-body=true

{{{{{picRead}}}}}[Soul]私聊阅后即焚 = type=http-response, pattern=(?i)^https:\/\/api-chat\.soulapp\.cn\/snapchat\/url, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/Soul/ishowshu_soul.js, requires-body=true

[MITM]
hostname = %APPEND% ssp.soulapp.cn, increase-openapi.soulapp.cn, post.soulapp.cn, api-account.soulapp.cn, api-a.soulapp.cn, gateway-mobile-gray.soulapp.cn, api-user.soulapp.cn, chat-live.soulapp.cn, api-chat.soulapp.cn, activity.soulapp.cn, 47.110.187.87, 47.75.72.47, 47.96.7.91, 47.96.11.46, 47.96.20.45, 47.97.215.55, 47.98.54.106, 47.98.137.249, 47.99.42.29, 114.215.255.94, 116.62.28.7, 116.62.47.28, 118.31.7.235, 118.31.112.221, 120.27.235.201, 120.55.55.115, 120.55.62.124, 121.196.197.147, 121.196.203.183

