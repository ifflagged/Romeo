#!name=GLaDOS
#!desc=GLaDOS每日签到，访问网页登录账号进入账户页面自动获取保存Cookie。
#!author=curtinp118[https://github.com/curtinp118]
#!icon=icon not found
#!category=sooyaaabo
#!openUrl=https://glados.cloud/
#!category=定时任务
#!loon_version=3.5.2(1005)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-10-02 12:00
#!arguments=Cookie-GLaDOS:,Task-GLaDOS:,Cron-GLaDOS:"0 0 9 * * *"
#!arguments-desc=Cookie-GLaDOS: [GLaDOS]每日签到Cookie\n获取[GLaDOS]每日签到Cookie\n可选值: true, false\n\nTask-GLaDOS: [GLaDOS]每日签到Task\n定时运行[GLaDOS]每日签到Task\n可选值: true, false\n\nCron-GLaDOS: [GLaDOS]定时参数Cron\n输入Cron表达式来定时运行[GLaDOS]每日签到Task

[Script]
{{{{{Cookie-GLaDOS}}}}}[GLaDOS]每日签到Cookie = type=http-request, pattern=(?i)^https:\/\/glados\.(?:cloud|network|one|space|vip)\/console\/account$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GLaDOS/loon_glados_checkin.js

{{{{{Task-GLaDOS}}}}}[GLaDOS]每日签到Task = type=cron, cronexp="{{{{{Cron-GLaDOS}}}}}", script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/sooyaaabo/GLaDOS/loon_glados_checkin.js

[MITM]
hostname = %APPEND% glados.cloud, glados.network, glados.one, glados.space, glados.vip

