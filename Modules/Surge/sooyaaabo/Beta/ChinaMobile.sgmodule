#!arguments-desc=HomeBasicClean: [首页] 基础净化\n移除基础广告\n\nHideTopFamily: [首页] 隐藏-爱家\n隐藏首页顶部Tab-爱家\n\nHideTopAge: [首页] 隐藏-网龄\n隐藏首页顶部Tab-网龄\n\nHideTopPhone: [首页] 隐藏-手机\n隐藏首页顶部Tab-手机\n\nHideTopNearby: [首页] 隐藏-附近厅\n隐藏首页顶部Tab-附近厅\n\nHideTopAI: [首页] 隐藏-AI尝鲜\n隐藏首页顶部Tab-AI尝鲜\n\nHideTopEnterprise: [首页] 隐藏-政企\n隐藏首页顶部Tab-政企\n\nMineClean: [我的] 基础净化\n移除基础广告\n\nHideMyCheckIn: [我的] 隐藏-签到浮窗\n隐藏我的-签到浮窗 areaId 20230721008\n\nHideMyMarketing: [我的] 隐藏-营销区域\n隐藏我的-营销区域 areaId 20230721012\n\nHideMyServices: [我的] 隐藏-我的服务\n隐藏我的-我的服务 areaId 20230721018\n\nHideMyFamilyCube: [我的] 隐藏-我的家庭\n隐藏我的-我的家庭 areaId 20240708002\n\nHideMyDevicesCube: [我的] 隐藏-我的设备\n隐藏我的-我的设备 areaId 20251024002\n\nHideMyMiniProgram: [我的] 隐藏-我的账户\n隐藏我的-我的账户 areaId 20231017002\n\nHideMyDigitalHuman: [我的] 隐藏-AI智能助理\n隐藏我的-AI智能助理 areaId 20230721020\n\nHideMySelections: [我的] 隐藏-我的优选\n隐藏我的-我的优选 areaId 20230721030\n\nHideMyGroup: [我的] 隐藏-我的集团\n隐藏我的-我的集团 areaId 20230721036\n\nHideMyRingtone: [我的] 隐藏-我的彩铃\n隐藏我的-我的彩铃 areaId 20251230002\n\nHideMyCloudDrive: [我的] 隐藏-我的云盘\n隐藏我的-我的云盘 areaId 20240624002\n\nHideMyToolbox: [我的] 隐藏-百宝箱\n隐藏我的-百宝箱 areaId 20230721044\n\nHideMyLifeServices: [我的] 隐藏-生活服务\n隐藏我的-生活服务 areaId 20230928004

[Map Local]
^https?:\/\/(client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(explorePage\/getAdverList|init\/startInit|emotionMarket) data-type=text data=" " status-code=200

[Script]
[中国移动]页面净化 = type=http-response, pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$, script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10, argument=HomeBasicClean="{{{HomeBasicClean}}}"&HideTopFamily="{{{HideTopFamily}}}"&HideTopAge="{{{HideTopAge}}}"&HideTopPhone="{{{HideTopPhone}}}"&HideTopNearby="{{{HideTopNearby}}}"&HideTopAI="{{{HideTopAI}}}"&HideTopEnterprise="{{{HideTopEnterprise}}}"&MineClean="{{{MineClean}}}"&HideMyCheckIn="{{{HideMyCheckIn}}}"&HideMyMarketing="{{{HideMyMarketing}}}"&HideMyServices="{{{HideMyServices}}}"&HideMyFamilyCube="{{{HideMyFamilyCube}}}"&HideMyDevicesCube="{{{HideMyDevicesCube}}}"&HideMyMiniProgram="{{{HideMyMiniProgram}}}"&HideMyDigitalHuman="{{{HideMyDigitalHuman}}}"&HideMySelections="{{{HideMySelections}}}"&HideMyGroup="{{{HideMyGroup}}}"&HideMyRingtone="{{{HideMyRingtone}}}"&HideMyCloudDrive="{{{HideMyCloudDrive}}}"&HideMyToolbox="{{{HideMyToolbox}}}"&HideMyLifeServices="{{{HideMyLifeServices}}}"

[中国移动]消息与卡券净化 = type=http-response, pattern=^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$, script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10

[中国移动]充值横幅净化 = type=http-response, pattern=^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$, script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10

[中国移动]充值内容净化 = type=http-response, pattern=^https:\/\/touch\.10086\.cn\/i\/v1\/(?:cust\/(?:aiMainQry|iopBatchQry)|pay\/popWindowQry)\/[^?]+(?:\?.*)?$, script-path=https://loon.103516.xyz/Script/ChinaMobile/ChinaMobile.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn

