#!name=Telegram
#!desc=Telegram外部链接跳转，可选目标客户端为Telegram、Swiftgram、Turrit、iMe、Nicegram、Lingogram，默认选择Telegram跳转至官方客户端。
#!author=sooyaaabo[https://github.com/sooyaaabo]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://apps.apple.com/app/id686449807
#!tag=功能增强
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-08-03 09:00
#!arguments=tgapp:"Telegram"

[Script]
[Telegram]t.me重定向 = type=http-response, pattern=^https?:\/\/(t\.me|telegram\.(me|dog))\/(.+), script-path=https://loon.103516.xyz/Script/Telegram/t.me_redirect.js, argument=[{{{tgapp}}}]

[MITM]
hostname = %APPEND% t.me, telegram.me, telegram.dog

