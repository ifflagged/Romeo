#!name=GLaDOS
#!desc=GLaDOS每日签到，访问网页登录账号进入账户页面自动获取保存Cookie。
#!author=curtinp118[https://github.com/curtinp118]
#!icon=icon not found
#!category=Jacob
#!openUrl=https://glados.cloud/
#!tag=定时任务
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-06-26 12:00
#!arguments=Cookie-GLaDOS:true,Task-GLaDOS:true,Cron-GLaDOS:"0 0 9 * * *"

[Script]
[GLaDOS]每日签到Cookie = type=http-request, pattern=^https:\/\/glados\.(?:network|cloud|vip|one|space|io)\/console\/account$, script-path=https://loon.103516.xyz/Script/GLaDOS/glados_checkin.js, timeout=10

[GLaDOS]每日签到Task = type=cron, cronexp={{{Cron-GLaDOS}}}, script-path=https://loon.103516.xyz/Script/GLaDOS/glados_checkin.js, timeout=60

[MITM]
hostname = %APPEND% glados.network, glados.vip, glados.one, glados.space, glados.cloud

