#!name=Sub_info_panel
#!desc=Sub_info_panel
#!icon=icon not found
#!category=ifflagged

[Panel]
Sub_info = script-name=Sub_info, update-interval=600

[Script]
Sub_info = type=generic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ifflagged/Sub_info_panel/mieqq_sub_info_panel.js, script-update-interval=0, timeout=10, argument=url=[URL encode 后的机场节点链接]&reset_day=1&title=AmyInfo&icon=bonjour&color=#007aff

.com/cn/app/sf-symbols-browser/ = type=cron, cronexp=可选参数icon=xxx 可以自定义图标，内容为任意有效的 SF Symbol Name，如 bolt.horizontal.circle.fill，详细可以下载app, script-path=https://apps.apple.com/cn/app/sf-symbols-browser/id1491161336, timeout=120, wake-system=1

