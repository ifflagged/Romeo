#!name=腾讯体育净化
#!desc=去除开屏广告、优化我的页面、去除底部会员tap、优化首页展示、去除搜索热词
#!author=TG@ZenMoFiShi
#!icon=icon not found
#!category=ddgksf2013
#!update=2026-11-1

[Script]
txsports-ad-clean = type=http-response, pattern=^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

txsports-ad-clean = type=http-response, pattern=^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/txsports-ad-clean/ZenmoFeiShi_txsports-ad-clean.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com

