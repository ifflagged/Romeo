#!name=BingSimplify
#!desc=BingSimplify
#!icon=icon not found
#!category=ddgksf2013

[Map Local]
^https?:\/\/assets\.msn\.com\/service\/weather\/locations\/search data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/assets\.msn\.com\/service\/news\/feed\/pages\/startmhp data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/api\.msn\.com\/weather data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
bing = type=http-response, pattern=^https?:\/\/sapphire\.api\.microsoftapp\.net\/config\/api\/v1\/get, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/BingSimplify/ddgksf2013_bing.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% sapphire.api.microsoftapp.net, assets.msn.com, api.msn.com

