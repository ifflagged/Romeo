#!name=CheLaiLeAds
#!desc=CheLaiLeAds
#!icon=icon not found
#!category=ddgksf2013

[URL Rewrite]
^https?:\/\/.*chelaile\.net\.cn\/goocity\/flowPos\/listByPos - reject

[Map Local]
^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html data-type=text data=" " status-code=200

^https?:\/\/.*chelaile\.net\.cn\/(api\/)?adpub data-type=text data=" " status-code=200

^https?:\/\/124\.70\.194\.16\/(ip|adpub) data-type=text data=" " status-code=200

^https?:\/\/124\.70\.194\.16\/goocity\/flowPos\/listByPos data-type=text data=" " status-code=200

^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow data-type=text data=" " status-code=200

^https?:\/\/atrace\.chelaile\.net\.cn\/(wx_preloadAd|adAnalysis) data-type=text data=" " status-code=200

[Script]
chelaile = type=http-response, pattern=^https?:\/\/.*chelaile\.net\.cn\/goocity\/city!, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/CheLaiLeAds/ddgksf2013_chelaile.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% web.chelaile.net.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn, cdn.web.chelaile.net.cn, atrace.chelaile.net.cn

