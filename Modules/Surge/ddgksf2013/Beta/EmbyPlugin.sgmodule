#!name=EmbyPlugin
#!desc=EmbyPlugin
#!icon=icon not found
#!category=ddgksf2013

[Script]
unlock = type=http-response, pattern=^https?:\/\/mb3admin.com\/admin\/service\/registration\/validateDevice, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_unlock.js, requires-body=true, max-size=-1, timeout=60

emby-plugin = type=http-response, pattern=\/[Uu]sers\/\w{32}\/[Ii]tems\/\d+\??, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js, requires-body=true, max-size=-1, timeout=60

emby-plugin = type=http-request, pattern=\/plugin\/scheme, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js, timeout=60

emby-plugin = type=http-request, pattern=(\/[Vv]ideos\/\d+\/stream\/.+\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/\d+\/.+\?.+&filename), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_emby-plugin.js, timeout=60

download_file_rename = type=http-response, pattern=(\/[Vv]ideos\/\d+\/stream\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/.+&filename), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/rartv_download_file_rename.js, timeout=60

replaceHeader = type=http-request, pattern=\/Users\/\w{32}\/Items\/\d+\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/EmbyPlugin/Script-Hub-Org_replace-header.js, timeout=30, argument=(%5Cr%5Cn)Accept-Encoding%3A.%2B-%3E%24Accept-Encoding%3A%20gzip%2C%20deflate%2C%20br

[MITM]
hostname = %APPEND% mb3admin.com, *.emby.wtf, *.plusmedia.site

