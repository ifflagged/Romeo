[Script]
bilibili_cc = type=http-response, pattern=^https?:\/\/.*\.hdslb\.com\/bfs\/subtitle\/.+\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/Bilibili_CC/ddgksf2013_bilibili_cc.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% aisubtitle.hdslb.com, i0.hdslb.com

