#!name=墨鱼手记页一键添加插件
#!desc=Tab栏显示Loon，代表网页变身成功，即可一键添加插件
#!author=@ddgksf2013 @小白脸 @xream @keywos @ckyb
#!icon=icon not found
#!category=Jacob
#!category=工具
#!homepage=https://ddgksf2013.top
#!openurl=https://ddgksf2013.top
#!pluginUrl=https://ddgksf2013.top/module/ScriptHub.Loon.plugin

[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Rule]
AND,((DOMAIN-SUFFIX,ddgksf2013.top),(PROTOCOL,QUIC)),REJECT-NO-DROP

[Script]
网页变身 = type=http-response, pattern=^https?:\/\/ddgksf2013.top\/$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/ScriptHub.Loon/ddgksf2013.top_web.loon.js, timeout=300

脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/ScriptHub.Loon/Script-Hub-Org_Rewrite-Parser.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub, ddgksf2013.top

