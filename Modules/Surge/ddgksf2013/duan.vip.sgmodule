[Script]
duan.vip = type=http-response, pattern=^https?:\/\/app\.theinitium\.com\/subs\/[a-zA-Z_]+\/verify_subscription, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013.top_duan.vip.js, requires-body=true, max-size=-1, timeout=60

duan.vip = type=http-response, pattern=^https?:\/\/api\.wallkit\.net\/api\/v\d/user, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013.top_duan.vip.js, requires-body=true, max-size=-1, timeout=60

duan.vip = type=http-response, pattern=^https?:\/\/app\.theinitium\.com\/editionfeed.*pugpig_atom_contents\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/ddgksf2013.top_duan.vip.js, requires-body=true, max-size=-1, timeout=60

replaceHeader = type=http-request, pattern=^https?:\/\/app\.theinitium\.com\/editionfeed.*pugpig_atom_contents\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/duan.vip/Script-Hub-Org_replace-header.js, timeout=30, argument=(%5Cr%5Cn)If-None-Match%3A.%2B(%5Cr%5Cn)-%3E%241If-None-Match%3A%242

[MITM]
hostname = %APPEND% app.theinitium.com, api.wallkit.net

