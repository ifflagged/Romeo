[Script]
vistopia = type=http-response, pattern=^https?:\/\/api\.vistopia\.com\.cn\/api\/v\d+\/(user\/profile|content\/(article_list|content-show)|reader\/section-detail|services\/play-token), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/vistopia.vip/ddgksf2013_vistopia.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.vistopia.com.cn

