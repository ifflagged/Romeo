[Script]
入口落地查询 = type=generic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Node_detection_tool/kelee_NetworkEntryAndExitQueries.js, timeout=10

地理位置查询 = type=generic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Node_detection_tool/kelee_LocationDetection.js, timeout=10

节点解锁查询 = type=generic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/Kelee/Node_detection_tool/kelee_NodeUnlockDetection.js, timeout=20

