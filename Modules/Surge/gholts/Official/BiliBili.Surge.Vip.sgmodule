[Script]
bili.vip1 = type=http-request, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite, script-path=https://ddgksf2013.top/scripts/bilibili.vip.js, requires-body=true, binary-body-mode=1, engine=webview, max-size=-1, timeout=60
bili.vip2 = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/, script-path=https://ddgksf2013.top/scripts/bili_myinfo_vip.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% grpc.biliapi.net,app.bilibili.com
