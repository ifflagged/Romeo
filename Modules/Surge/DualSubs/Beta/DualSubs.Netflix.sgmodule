[Script]
# 🍿️ DualSubs.Netflix.Translate.Subtitles.response
Translate.response.bundle = type=http-response, pattern=^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Netflix/DualSubs_Translate.response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.oca.nflxvideo.net

