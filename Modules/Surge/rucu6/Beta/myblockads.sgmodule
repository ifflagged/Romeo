[Body Rewrite]
http-response-jq (?i)^http:\/\/ad\.5tao5ai\.com\/common\/getReceipt\? 'delpaths([["payload","adInfo"]])'
http-response-jq (?i)^https:\/\/www\.washpayer\.com\/common\/getReceipt 'delpaths([["payload","adInfo"]])'
http-response-jq (?i)^https:\/\/mme\.api\.moji\.com\/json\/entrance\/list$ 'del(.entrance_region_res_list[] | select(.region_name == "皇冠区域" or .region_name == "banner区")) | .entrance_region_res_list[].entrance_res_list |= if . then map(select(.entrance_name | . != "墨迹钱包" and . != "墨圈")) else . end'
http-response-jq (?i)^https:\/\/gql(-fed)?\.reddit\.com 'jq-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/rucu6/myblockads/rucu6_reddit.jq'
http-response-jq (?i)^https:\/\/api\.xiachufang\.com\/v2\/homepage\/paged_waterfall_recommendations\.json '.multiplex_cells |= map(select(.recommendation_cell.label != "广告"))'
http-response-jq (?i)^https:\/\/api\.m\.mi\.com\/v1\/order\/expressView 'delpaths([["data","bottom","ad_info"]])'
http-response-jq (?i)^https:\/\/shop-api\.retail\.mi\.com\/mtop\/act\/mishopSearch\/mainSearch 'if ((getpath(["data"]) // {}) | has("recProductList")) then (setpath(["data","recProductList"]; "[]")) else . end'
http-response-jq (?i)^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/home\/v1\/index 'delpaths([["data","floors",0,"data","left_icon_config"]])'
http-response-jq (?i)^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/home\/v1\/index 'delpaths([["data","floors",0,"data","right_icon_config"]])'
http-response-jq (?i)^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/usercenter\/personalHome 'delpaths([["data","carouselAD"]])'
http-response-jq (?i)^https:\/\/xiaomishop\.retail\.mi\.com\/mtop\/xiaomishop\/product\/info 'delpaths([["data","carouselAdInfo"]])'
http-response-jq (?i)^https:\/\/xiaomishop\.retail\.mi\.com\/mtop\/xiaomishop\/product\/info 'delpaths([["data","product","floatWindow"]])'
http-response-jq (?i)^https:\/\/conf-m-ssl\.xunlei\.com\/external\/[0-9-a-z]+\? 'delpaths([["values","me_config","common_service_list"]])'

