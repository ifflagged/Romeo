#!name=GitHub 星标推送时间
#!desc=在 GitHub App 星标列表语言后显示推送时间
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=GitHub,星标,推送时间
#!version=1.2.0
#!date=2026-09-19 12:30
#!arguments=github_push_time:#
#!arguments-desc=github_push_time: 星标推送时间\n在 GitHub App 星标列表语言后显示推送时间\n可选值: 留空启用, # 禁用

[Script]
{{{github_push_time}}}GitHub 推送时间-查询增强 = type=http-request, pattern=(?i)^https?:\/\/api\.github\.com\/graphql, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/GitHubPushTime/TomCatXue_github_push_time.js, requires-body=true, timeout=10

{{{github_push_time}}}GitHub 推送时间-列表注入 = type=http-response, pattern=(?i)^https?:\/\/api\.github\.com\/graphql, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/GitHubPushTime/TomCatXue_github_push_time.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api.github.com

