#!name=CookieCenter · Cookie 抓取合集
#!desc=一键抓取全部维护中业务的 Cookie 凭据（微信读书、中国电信全系、扫描全能王）。每个业务配备独立开关（默认开启，可单独关闭）。仅含「抓取」规则，不含任何定时签到执行——签到调度已全面收归青龙面板。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!category=签到, Cookie, 凭据捕获
#!version=5.2.0
#!date=2026-10-18 10:10
#!arguments=weread:"",telecom_draw:"",telecom_rights:"",telecom_benefit:"",camscanner:""
#!arguments-desc=weread: 微信读书\n抓取技巧：建议先进「我」的页面(抓App基础票据)，再去「周二翻牌」页(补齐Web完整票据)\n可选值: 留空启用, # 禁用\n\ntelecom_draw: 电信·会员抽奖\n打开微信小程序「中国电信5G会员/权益商城」触发，自动抓取 SessionKey 与手机号\n可选值: 留空启用, # 禁用\n\ntelecom_rights: 电信·等级权益\n打开电信营业厅 App 进「我的签到」或「等级权益」页面触发抓取\n可选值: 留空启用, # 禁用\n\ntelecom_benefit: 电信·山西福利\n打开山西电信体验AI领福利活动页面触发抓取最新批次凭证\n可选值: 留空启用, # 禁用\n\ncamscanner: 扫描全能王\n打开扫描全能王 App 进个人中心触发静默更新\n可选值: 留空启用, # 禁用

[Script]
{{{weread}}}微信读书·凭据捕获 = type=http-request, pattern=(?i)^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js

{{{weread}}}微信读书·登录请求 = type=http-request, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true

{{{weread}}}微信读书·登录响应 = type=http-response, pattern=(?i)^https?:\/\/i\.weread\.qq\.com\/login, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_weread_cookie.js, requires-body=true

{{{telecom_draw}}}电信·会员配置捕获 = type=http-request, pattern=(?i)^https?:\/\/cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js

{{{telecom_draw}}}电信·小程序登录捕获 = type=http-request, pattern=(?i)^https?:\/\/mapi-h5\.bestpay\.com\.cn\/gapi\/handyservice\/miniprogram\/checkParam, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js, requires-body=true

{{{telecom_draw}}}电信·MGS网关捕获 = type=http-request, pattern=(?i)^https?:\/\/spanner\.bestpay\.com\.cn:10081, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_cookie.js

{{{telecom_rights}}}电信·等级权益凭证捕获 = type=http-request, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js

{{{telecom_rights}}}电信·等级权益会话回填 = type=http-response, pattern=(?i)^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_rights.js, requires-body=true

{{{telecom_benefit}}}电信·山西活动凭证捕获 = type=http-request, pattern=(?i)^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_telecom_benefit.js

{{{camscanner}}}扫描全能王 Cookie = type=http-request, pattern=(?i)^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/CookieCenter/TomCatXue_camscanner.cookie.js

[MITM]
hostname = %APPEND% weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn, api-cs.intsig.net

