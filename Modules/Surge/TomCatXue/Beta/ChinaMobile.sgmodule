[Map Local]
(?i)^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/(?:DN|DA)\/(?:explorePage\/.*|init\/startInit|emotionMarket)(?:\?.*)?$ data-type=text data="" status-code=200

(?i)^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdver.*|homepagePopup\/getSortInfo|homePage\/getPopupInfo|toast\/.*|detainment\/.*)|DH\/(?:toast\/.*|detainment\/.*|facePopup\/.*|livePopup\/.*)|DA\/liveSuspension\/getPageCode)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/cms\/(?:advertisePosition|advertisePage|globalIcon)(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[中国移动]页面与轮播净化 = type=http-response, pattern=(?i)^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo|titleBar\/getIcon)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"&HomeBasicClean="{{{HomeBasicClean}}}"&ServicePageClean="{{{ServicePageClean}}}"&MineClean="{{{MineClean}}}"&WalletClean="{{{WalletClean}}}"&DiscoverClean="{{{DiscoverClean}}}"&HideTopFamily="{{{HideTopFamily}}}"&HideTopAge="{{{HideTopAge}}}"&HideTopPhone="{{{HideTopPhone}}}"&HideTopNearby="{{{HideTopNearby}}}"&HideTopAI="{{{HideTopAI}}}"&HideTopEnterprise="{{{HideTopEnterprise}}}"&HideMyCheckIn="{{{HideMyCheckIn}}}"&HideMyMarketing="{{{HideMyMarketing}}}"&HideMyServices="{{{HideMyServices}}}"&HideMyFamilyCube="{{{HideMyFamilyCube}}}"&HideMyDevicesCube="{{{HideMyDevicesCube}}}"&HideMyMiniProgram="{{{HideMyMiniProgram}}}"&HideMyDigitalHuman="{{{HideMyDigitalHuman}}}"&HideMySelections="{{{HideMySelections}}}"&HideMyGroup="{{{HideMyGroup}}}"&HideMyRingtone="{{{HideMyRingtone}}}"&HideMyCloudDrive="{{{HideMyCloudDrive}}}"&HideMyToolbox="{{{HideMyToolbox}}}"&HideMyLifeServices="{{{HideMyLifeServices}}}"

[中国移动]消息与卡券横幅净化 = type=http-response, pattern=(?i)^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"

[中国移动]横幅看板净化 = type=http-response, pattern=(?i)^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"

[中国移动]我的钱包与充话费净化 = type=http-response, pattern=(?i)^https:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/(?:cms\/(?:contents|yourFavorite)|hePay\/all)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=WalletClean="{{{WalletClean}}}"&HideCarousel="{{{HideCarousel}}}"

[中国移动]发现页视频与文章净化 = type=http-response, pattern=(?i)^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=DiscoverClean="{{{DiscoverClean}}}"&HideCarousel="{{{HideCarousel}}}"

[中国移动]智能专区与爱家画布净化 = type=http-response, pattern=(?i)^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobile/TomCatXue_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, ad.mcloud.139.com, app.jf.10086.cn, display-sc.miguvideo.com, res.coc.10086.cn

