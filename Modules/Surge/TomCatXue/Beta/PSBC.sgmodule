[URL Rewrite]
^https?:\/\/static\.mobile-bank\.psbc\.com\/static\/index\/advertise\/ - reject

[Map Local]
^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/getStartUpAdvPicture data-type=text data=" " status-code=200

^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/qryShakeInfo data-type=text data=" " status-code=200

[MITM]
hostname = %APPEND% login-service.mobile-bank.psbc.com, static.mobile-bank.psbc.com

