#!arguments=HideCarousel:true,LaunchAdClean:true,HomeClean:true,SmartPageClean:true,DiscoverClean:true,WalletClean:true,MineClean:true
#!arguments-desc=HideCarousel: [轮播] 彻底移除轮播图\n移除首页与各专区横幅轮播图组件，使其彻底消失而非仅阻断跳转\n\nLaunchAdClean: [开屏] 启动广告净化\n清理友盟 U-Push 启动广告与本地缓存下发的开屏素材\n\nHomeClean: [首页] 首页基础净化\n清理首页横幅轮播、XBYYW运营位广告、等级条营销与瀑布流\n\nSmartPageClean: [智能] 移动爱家智能专区净化\n清理移动爱家/智能专区右上角广告、轮播大图、悬浮窗动效与营销触点弹窗\n\nDiscoverClean: [发现] 发现页短视频与文章净化\n清空发现页短视频信息流、大轮播图与新闻资讯模块\n\nWalletClean: [钱包] 充话费与钱包净化\n清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流\n\nMineClean: [我的] 「我的」页面净化\n清理「我的」页面营销区域与推荐卡片

[Rule]
DOMAIN-SUFFIX,cmicapm.com,REJECT
DOMAIN-SUFFIX,dc.cmicapm.com,REJECT
DOMAIN-SUFFIX,uba.cmft.com.cn,REJECT
DOMAIN-SUFFIX,yxfk.market.chinamobile.com,REJECT
DOMAIN-SUFFIX,uem.migu.cn,REJECT
DOMAIN-SUFFIX,da.mmarket.com,REJECT
DOMAIN-SUFFIX,dfp.cmft.com.cn,REJECT
DOMAIN-SUFFIX,mtm.online-cmcc.cn,REJECT
DOMAIN-SUFFIX,trace.hjq.komect.com,REJECT
DOMAIN-SUFFIX,event.video.komect.com,REJECT
DOMAIN-SUFFIX,aishop.vis.komect.com,REJECT
DOMAIN-SUFFIX,ggc.cmvideo.cn,REJECT
DOMAIN-SUFFIX,adxserver.ad.cmvideo.cn,REJECT
DOMAIN-SUFFIX,ggadjust.cmvideo.cn,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT

[Map Local]
(?i)^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/(?:goods\/(?:price\/reduction\/bubble|recommend\/light))(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https?:\/\/(?:ulogs\.umeng\.com|ulogs\.umengcloud\.com|msg\.umengcloud\.com)\/admsg\/v2\/launch(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
[移动爱家]和包充话费营销净化 = type=http-response, pattern=(?i)^https?:\/\/p\.10086\.cn\/wap\/v1\/(?:polymeriza-page\/(?:banner|popup|activity|business|group-cards|marquee)|float\/window|guess\/shop)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, argument=WalletClean="{{{WalletClean}}}"&HideCarousel="{{{HideCarousel}}}"

[移动爱家]防304缓存穿透 = type=http-request, pattern=(?i)^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, timeout=5, argument=WalletClean="{{{WalletClean}}}"&HideCarousel="{{{HideCarousel}}}"

[移动爱家]发现页视频与文章净化 = type=http-response, pattern=(?i)^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=DiscoverClean="{{{DiscoverClean}}}"&HideCarousel="{{{HideCarousel}}}"

[移动爱家]智能专区与爱家画布净化 = type=http-response, pattern=(?i)^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=SmartPageClean="{{{SmartPageClean}}}"&HideCarousel="{{{HideCarousel}}}"

[移动爱家]商城楼层净化 = type=http-response, pattern=(?i)^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/layout\/index\/(?:content|frame)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=HomeClean="{{{HomeClean}}}"&HideCarousel="{{{HideCarousel}}}"

[移动爱家]和家亲首页Banner与楼层净化 = type=http-response, pattern=(?i)^https?:\/\/base\.hjq\.komect\.com\/(?:(?:base|keel)\/)?idx\/(?:getBannerContentList|getTabBannerList)(?:[\/?].*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"&HomeClean="{{{HomeClean}}}"

[移动爱家]和家亲设备与省份Banner净化 = type=http-response, pattern=(?i)^https?:\/\/base\.hjq\.komect\.com\/hjq-prov\/api\/provApply\/homepage\/getBannerList(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=HideCarousel="{{{HideCarousel}}}"&HomeClean="{{{HomeClean}}}"

[移动爱家]智能专区场景轮播净化 = type=http-response, pattern=(?i)^https?:\/\/base\.hjq\.komect\.com\/(?:base\/)?scene\/(?:getRuleTemplates|getRecommendRules)(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/ChinaMobileAiJia/TomCatXue_aijia_remove_ads.js, requires-body=true, timeout=10, argument=SmartPageClean="{{{SmartPageClean}}}"&HideCarousel="{{{HideCarousel}}}"

[MITM]
hostname = %APPEND% p.10086.cn, shop.hjq.komect.com, base.hjq.komect.com, display-sc.miguvideo.com, res.coc.10086.cn, ulogs.umeng.com, ulogs.umengcloud.com, msg.umengcloud.com

