#!name=腾讯视频 · 全量净化
#!desc=全量移除开屏、前贴/中插、暂停、后贴、锚点、详情页、信息流、搜索、下载页、个人中心、激励、会员推广与播放页 SVIP 推广；融合简洁模式、底栏独立开关与 QUIC 防穿透。
#!author=TomCatXue
#!icon=icon not found
#!category=TomCatXue
#!homepage=https://github.com/TomCatXue/MyCookieCenter
#!system=ios
#!version=1.0.8
#!date=2026-11-05 20:24
#!loon_version=3.5.1(983)
#!category=腾讯视频
#!arguments=HideShortDrama:true,HideVipTab:true,HideGoods:true
#!arguments-desc=HideShortDrama: [底栏] 隐藏短剧\n关闭后显示「短剧」tab\n\nHideVipTab: [底栏] 隐藏 VIP 会员\n关闭后显示「VIP会员」tab\n\nHideGoods: [底栏] 隐藏好物\n关闭后显示「好物」tab

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,p.l.qq.com,REJECT
DOMAIN,dp3.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
DOMAIN,lives.l.qq.com,REJECT
DOMAIN,news.l.qq.com,REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,pre.video.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,pre.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Header Rewrite]
http-response ^https?:\/\/(?:i|pre)\.video\.qq\.com\/ header-replace 'Alt-Svc' 'clear'
http-response ^https?:\/\/iacc\.qq\.com\/ header-replace 'Alt-Svc' 'clear'

[Map Local]
^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.vip_ad_promotion\.accessor\.Accessor\/Access(?:\?|$) data-type=text data="{\"trace_id\":\"\",\"map_ads\":{},\"ext_info\":\"\"}" status-code=200 header="Content-Type:text/plain"

^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.vip_price_group\.svip_price_logic\.SvipPriceLogic\/GetSvipPrices(?:\?|$) data-type=text data="{\"prices\":{}}" status-code=200 header="Content-Type:text/plain"

^https?:\/\/vip\.video\.qq\.com\/rpc\/rpc\/trpc\.svip_proj\.trpc_vip_update\.GetVipUpdateInfos\/GetVipUpdateInfos(?:\?|$) data-type=text data="{\"update_infos\":{}}" status-code=200 header="Content-Type:text/plain"

[Script]
腾讯视频·请求拦截 = type=http-request, pattern=(?i)^https?:\/\/(?:i|pre)\.video\.qq\.com\/(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

腾讯视频·tRPC净化 = type=http-response, pattern=(?i)^https?:\/\/(?:i|pre)\.video\.qq\.com\/(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

腾讯视频·JCE净化 = type=http-response, pattern=(?i)^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

腾讯视频·简洁模式 = type=http-response, pattern=(?i)^https?:\/\/(?:config|tconfig)\.ab\.qq\.com\/tab\/GetTabRemoteConfig, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

腾讯视频·播放器配置 = type=http-response, pattern=(?i)^https?:\/\/tab\.video\.qq\.com\/tab\/GetTabRemoteConfig, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

腾讯视频·灰度开关 = type=http-response, pattern=(?i)^https?:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/TomCatXue/TencentVideo/TomCatXue_tencent_video_ad_clean.js, requires-body=true, binary-body-mode=true, argument=HideShortDrama="{{{HideShortDrama}}}"&HideVipTab="{{{HideVipTab}}}"&HideGoods="{{{HideGoods}}}"

[MITM]
hostname = %APPEND% i.video.qq.com, pre.video.qq.com, iacc.qq.com, config.ab.qq.com, tconfig.ab.qq.com, tab.video.qq.com, rdelivery.qq.com, vip.video.qq.com

