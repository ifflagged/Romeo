#!name=看东方去广告
#!desc=移除看东方开屏广告、首页推广、搜索框推广、底部千V和商城tab、我的页面推广banner。
#!author=wish[https://github.com/mist-whisper]
#!category=去广告
#!date=2026-04-26 22:38:00

[Body Rewrite]
http-response-jq ^https:\/\/bp-api\.bestv\.cn\/cms\/api\/free\/open\/advertisingV2 '.dt = []'
http-response-jq ^https:\/\/bp-api\.bestv\.cn\/cms\/api\/c\/search\/hot\/v(2|4) '.dt.hot = [] | .dt.recommand = [] | .dt.bannerList = []'
http-response-jq ^https:\/\/bp-api\.bestv\.cn\/cms\/api\/audit\/home\/v4 '.dt |= map(select(.styleString | IN("右侧金刚位","首页头图","智能体") | not))'
http-response-jq ^https://bp-api\.bestv\.cn/cms/api/free/isGreyModel$ '.dt.homeAreaButton |= (fromjson | .subscrip = "0" | .shop = "0" | tojson)'
http-response-jq ^https:\/\/bp-api\.bestv\.cn\/cms\/api\/advertise\/project\/userCenter '.dt = []'

[MITM]
hostname = %APPEND% bp-api.bestv.cn
