[Script]
看理想VIP = type=http-response, pattern=^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/(reader\/(section-detail|detail)|user\/home|vip\/buy-list|services\/play-token), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Kan_remove_ads/resource_KanVip.js, requires-body=true, timeout=60

看理想去广告 = type=http-response, pattern=^https?:\/\/api\.vistopia\.com\.cn\/api\/v2\/user\/profile(?:\?.*)?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Kan_remove_ads/resource_Kan_remove_ads.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.vistopia.com.cn
