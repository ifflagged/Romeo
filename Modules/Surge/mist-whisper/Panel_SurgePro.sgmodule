[Panel]
SurgePro = script-name=SurgePro, update-interval=1

[Script]
SurgePro = type=generic, script-path=https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Module/Panel/Surge-Pro/Moore/SurgePro.js, timeout=10, argument=icon=paperplane.circle&color=#f6c970

