#!name=咪咕视频
#!desc=移除开屏广告、解锁VIP和画质。
#!author=WeiGiegie[https://github.com/WeiGiegie], ZenmoFeiShi[https://github.com/ZenmoFeiShi]
#!category=去广告
#!date=2026-05-14 21:14:00

[Map Local]
^https://.*miguvideo\.com/request/sdk data-type=text data=" " status-code=200

^https://.*miguvideo\.com/task/v7/task-list/cmvideo/visitor data-type=text data=" " status-code=200

[Script]
咪咕视频VIP = type=http-request, pattern=^https?:\/\/(play|play-pre|v|v[0-9]?-sc|vmesh|app-sc|vms-sc|display(-sc)?|common-sc|program-sc|d[0-9]-sc|fs-sc|fsdv-sc|mp-user|recommend-dy|chat|chat-wx|public-deliver[0-9]?|public-operbiz[0-9]?|public-img)\.miguvideo\.com\/.+, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MiguTV/ZenmoFeiShi_migu_vip.js, requires-body=true, timeout=60

咪咕视频VIP = type=http-request, pattern=^https?:\/\/(passport|uem|push|jadeite|jadeiteapp|hound|feedback|rcsdk)\.migu\.cn\/.+, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/MiguTV/ZenmoFeiShi_migu_vip.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% *.miguvideo.com,*.migu.cn
