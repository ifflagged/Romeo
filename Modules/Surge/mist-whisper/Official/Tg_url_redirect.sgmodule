#!name=Telegram跳转第三方客户端
#!desc=Telegram外链直接跳转至第三方客户端，自行选择跳转至Swiftgram还是Turrit。
#!author=秦城二院彭医生[https://github.com/dcpengx],wish[https://github.com/mist-whisper]
#!category=功能增强
#!date=2025-03-26
#!arguments=jump:Swiftgram
#!arguments-desc=jump: 指定跳转客户端 - 选择跳转到哪个第三方tg (选项: Swiftgram, Turrit)

[Script]
telegram-redirect=type=http-response,pattern=(https:\/\/)?t\.me\/(.+),script-path=https://raw.githubusercontent.com/dcpengx/Loon/main/JavaScript/tg-redirect.js,requires-body=0,binary-body-mode=0,timeout=10,argument=jump="{{{jump}}}"

[MITM]
hostname=%APPEND% t.me
