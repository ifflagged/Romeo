#!name=航旅纵横去广告
#!desc=移除航旅纵横开屏广告和部分推广，需要卸载重装。
#!author=linuszlx[https://github.com/linuszlx], wish[https://github.com/mist-whisper]
#!category=去广告
#!date=2026-02-04 16:13:00

[Map Local]
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[URL Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject
#^https?:\/\/umerp\.umetrip\.com\/gateway\/api\/umetrip\/native reject
^https?:\/\/bkclient\.umetrip\.com\.cn\/gateway\/api\/umetrip\/native - reject

[Script]
移除航旅纵横首页广告=type=http-response,pattern=^https?:\/\/umerp\.umetrip\.com\/gateway\/api\/umetrip\/native,script-path=https://resource.wuyra.com/Script/Umetrip/Umetrip_remove_ads.js

[MITM]
hostname=%APPEND% umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com
