#!name=谷歌增强
#!desc=将Google搜索重定向至.com域名，如遇频繁跳转请禁用本模块。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md],wish[https://github.com/mist-whisper]
#!category=优化增强
#!date=2026-07-27 22:01:00

[URL Rewrite]
^https?:\/\/(www\.)?(?:g|google)\.cn https://www.google.com 302
^https?:\/\/translate\.google\.cn https://translate.google.com 302
^https?:\/\/(www\.)?google\.com\.hk\/search\?(.*) https://www.google.com/search?$2&gl=us 302
^https?:\/\/(www\.)?google\.com\.hk\/(.*) https://www.google.com/$2 302

[MITM]
hostname = %APPEND% *.google.cn,*.google.com.hk
