#!name=XZimu
#!desc=解锁XZimu会员。
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi]
#!category=解锁
#!date=2026-04-20 11:27:00

[Script]
XZimu会员 = type=http-response, pattern=^http:\/\/apps\.tltgame\.com\/api\/user\/updateStatus, script-path=https://resource.wuyra.com/Script/XZimu/XZimu.js, requires-body=true, timeout=60

XZimu会员 = type=http-request, pattern=^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post, script-path=https://resource.wuyra.com/Script/XZimu/XZimu.js, requires-body=true, timeout=60

XZimu会员 = type=http-response, pattern=^http:\/\/apps\.tltgame\.com\/api\/task\/offline\/post, script-path=https://resource.wuyra.com/Script/XZimu/XZimu.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% apps.tltgame.com
