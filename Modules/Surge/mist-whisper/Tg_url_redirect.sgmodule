#!name=Telegram跳转第三方客户端
#!desc=Telegram外链直接跳转至第三方客户端，自行选择跳转至Swiftgram还是Turrit。
#!author=秦城二院彭医生[https://github.com/dcpengx],wish[https://github.com/mist-whisper]
#!icon=icon not found
#!category=mist-whisper
#!tag=功能增强
#!system=ios
#!system_version=15
#!loon_version=3.4.0(962)
#!homepage=https://kelvinlab.wuyra.com
#!date=2025-03-26
#!arguments=jump:"Swiftgram"

[Script]
telegram-redirect = type=http-response, pattern=(https:\/\/)?t\.me\/(.+), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/mist-whisper/Tg_url_redirect/dcpengx_tg-redirect.js, timeout=10, argument=[{{{jump}}}]

[MITM]
hostname = %APPEND% t.me

