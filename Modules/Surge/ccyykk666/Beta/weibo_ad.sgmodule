#!name=微博轻享版去广告
#!desc=移除微博轻享版广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!icon=icon not found
#!category=ccyykk666
#!system=ios
#!date=2026-10-29
#!loon_version=3.5.1(983)

[Map Local]
^https:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/bootrealtime\.uve\.weibo\.com\/v2\/ad\/realtime$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.weibo\.cn\/2\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^#]*&)?a=(?:get_searching_info|get_coopen_ads)(?:&|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
微博响应净化 = type=http-response, pattern=(?i)^https:\/\/(?:api\.weibo\.cn\/2\/(?:comments\/build_comments|statuses\/(?:friends\/timeline|unread_hot_timeline|container_timeline_hot|container_timeline_topic|container_detail)|cardlist)(?:\?|$)|weibointl\.api\.weibo\.cn\/portal\.php\?(?:[^#]*&)?a=user_center(?:&|$)), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ccyykk666/weibo_ad/ccyykk666_weibo_ad_filter.js, requires-body=true, timeout=20

[MITM]
hostname = %APPEND% api.weibo.cn, weibointl.api.weibo.cn, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com

