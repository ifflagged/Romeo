#!name=bilibili国际版去广告
#!desc=移除bilibili国际版广告
#!author=ccyykk666[https://github.com/ccyykk666]
#!icon=icon not found
#!category=ccyykk666
#!system=ios
#!loon_version=3.5.1(978)
#!date=2026-09-12
#!arguments=FollowingTab:true,MessageTab:true
#!arguments-desc=FollowingTab: [底栏] 关注\n\nMessageTab: [底栏] 消息

[Map Local]
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show)(?:\?.*)?$ data-type=text data="{\"code\":0,\"message\":\"0\",\"ttl\":1,\"data\":null}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.bilibili.com

