#!name=Youtube (Music) Enhance
#!desc=适用于 Youtube & Youtube Music
#!icon=icon not found
#!category=Jacob

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.request = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.request.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

