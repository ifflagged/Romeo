#!name=Youtube
#!desc=移除广告
#!author=Maasea
#!icon=icon not found
#!category=Jacob

[Map Local]
^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/search, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/guide, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/account\/get_setting, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/next, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/reel\/reel_watch_sequence, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/youtube/Maasea_youtube.response.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

