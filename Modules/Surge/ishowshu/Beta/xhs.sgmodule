#!name=小红书
#!desc=移除广告
#!author=树先生, 奶思
#!icon=icon not found
#!category=Jacob
#!date=2026-09-11

[Rule]
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
DOMAIN,mediacloud.xiaohongshu.com,REJECT
DOMAIN,t2.xiaohongshu.com,REJECT
DOMAIN,spider-tracker.xiaohongshu.com,REJECT
DOMAIN,as.xiaohongshu.com,REJECT
DOMAIN,crash.xiaohongshu.com,REJECT
DOMAIN,fe.xiaohongshu.com,REJECT
DOMAIN,lng.xiaohongshu.com,REJECT

[Body Rewrite]
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\? 'del(.data.app_theme, .data.loading_img, .data.splash, .data.store)'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config '.data.ads_groups? |= map(.start_time = 3818332800 | .end_time = 3818419199 | .ads? |= map(.start_time = 3818332800 | .end_time = 3818419199))'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets 'del(.data.cooperate_binds, .data.generic, .data.note_next_step, .data.widget_list)'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/banner_list '.data = {}'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/hot_list '.data.items = []'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/hint\? '.data.hint_words = []'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending\? '.data.queries = [] | .data.hint_word = {}'
http-response-jq ^https?:\/\/(so|edith)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\? '.data.items? |= map(select(.model_type == "note"))'

[Map Local]
# 信息流
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/guide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 我的页面中间提示横幅
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/content\/navigator data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 广告资源请求
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/ads\/resource data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# ip获取
^https:\/\/gslb\.xiaohongshu\.com\/api\/httpdns\/v1\/domains data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gslb\.xiaohongshu\.com\/api\/gslb\/v1\/domainNew data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 广告请求
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/v1\/tag\/ads_engage data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/www\.xiaohongshu\.com\/api\/sns\/v1\/ads\/apple\/record data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# banner
^https:\/\/edith\.xiaohongshu\.com\/api\/im\/v2\/get_banner_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 用户指引
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/guide\/user_guide data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com, so.xiaohongshu.com, gslb.xiaohongshu.com, rec.xiaohongshu.com

