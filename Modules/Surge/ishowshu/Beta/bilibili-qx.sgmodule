#!name=哔哩哔哩
#!desc=B站去广告
#!author=kokoryh, 树先生
#!icon=icon not found
#!category=Jacob

[Rule]
DOMAIN,app.biliapi.net,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.com,REJECT

[Body Rewrite]
http-response-jq ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'

[Map Local]
#AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/ap[ip]\.bilibili\.com\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 首页视频信息流
bilibili-ad = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 首页顶部右边图标、导航栏列表、底部tab栏目
bilibili-ad = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 搜索页推荐
bilibili-ad = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 首页右上角活动小图标
bilibili-ad = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 我的页面简化
bilibili-ad = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 直播相关净化
bilibili-ad = type=http-response, pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

# 直播tab页面在选择标签后的banner
bilibili-ad = type=http-response, pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/second\/getList, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ishowshu/bilibili-qx/ishowshu_bilibili-ad.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com

