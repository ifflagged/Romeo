#!raw-url=https://raw.githubusercontent.com/zirawell/R-Store/main/Rule/QuanX/Adblock/All/rewrite/wechatAdRewrite.conf
#!tg-group=https://t.me/RStoreCom
#!date=2026-10-09 09:42:08

[URL Rewrite]
