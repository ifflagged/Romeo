[Rule]
DOMAIN,hc-ssp.sm.cn,REJECT,extended-matching,pre-matching
DOMAIN,apm.gotokeep.com,REJECT,extended-matching,pre-matching
DOMAIN,kad.gotokeep.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/api\.gotokeep\.com\/guide-webapp\/v\d\/popup\/getPopUp - reject
^https?:\/\/api\.gotokeep\.com\/kprime\/v\d\/popups\/primeGuide - reject
^https?:\/\/kad\.gotokeep\.com\/op-engine-webapp\/v\d\/ad - reject
^https?:\/\/api.gotokeep.com/cauchy/growth/init - reject
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/default\/keyword\/list - reject
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotword\/list - reject
^https?:\/\/api\.gotokeep\.com\/search\/v\d\/hotCourse\/list - reject
^https?:\/\/api\.gotokeep\.com\/op-engine-webapp\/v\d\/ad - reject
^https?:\/\/api\.gotokeep\.com\/ads - reject
^https?:\/\/api\.gotokeep\.com\/training\/box\/config - reject
^https?:\/\/api\.gotokeep\.com\/anno\/v\d\/upgrade\/check - reject

[Map Local]
^https?:\/\/static1\.keepcdn\.com\/ark_optimus\/202\d\/*\/*\/.*.(?>png|jpg) data-type=text data="" status-code=200

[Script]
keep = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/athena\/v\d\/people\/my$, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js, requires-body=true, max-size=0

keep = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/config\/v\d\/basic, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js, requires-body=true, max-size=0

keep = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/homepage\/v\d\/tab, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js, requires-body=true, max-size=0

keep = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/nuocha\/course\/v\d/\w+\/preview, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js, requires-body=true, max-size=0

keep = type=http-response, pattern=^https?:\/\/api\.gotokeep\.com\/sportpage\/sport\/v\d\/mysport, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/keep/zirawell_keep.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% static1.keepcdn.com, api.gotokeep.com, kad.gotokeep.com

