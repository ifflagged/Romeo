#!bundleId=com.hunantv.imgotv
#!category=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-05-09

[Rule]
DOMAIN,credits.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,credits2.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,credits3.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,dflow.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,encounter.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,floor.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,layer.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,vip.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,mob.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,rc-topic-api.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,rprain.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN,rc-topic-api.bz.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,imgaliyun.res.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pcvideoaliyun.titan.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,mobaliyun.res.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pcvideoyd.titan.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pcweb.v1.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,cmop.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,da.mgtv.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,log.mgtv.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/[\d\.]+:\d{5}\/\?cmd=indexes - reject

[Map Local]
^https?:\/\/[\d\.]+\/odin\/c\d\/(channel\/ads|skin\/config)\? data-type=json data="{}" status-code=200

^https?:\/\/damang\.api\.mgtv\.com\/station\/album\/red\/dot\? data-type=json data="{}" status-code=200

^https?:\/\/hb-boom\.api\.mgtv\.com\/release\/pullReleaseInfo data-type=json data="{}" status-code=200

^https?:\/\/mobile\.api\.mgtv\.com\/v\d\/mobile\/checkUpdate\? data-type=json data="{}" status-code=200

^https?:\/\/mobileso\.bz\.mgtv\.com\/spotlight\/search\/v\d\? data-type=json data="{}" status-code=200

[Script]
mgtv = type=http-response, pattern=^https?:\/\/me\.bz\.mgtv\.com\/v\d\/module\/list\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/mob-st\.bz\.mgtv\.com\/odin\/c\d\/channel\/index\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/dc2?\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/(index|vrsList)\/\w, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/config\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/mobile\.api\.mgtv\.com\/v\d+\/video\/info\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/mobile-thor\.api\.mgtv\.com\/v\d\/vod\/info\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

mgtv = type=http-response, pattern=^https?:\/\/mobileso\.bz\.mgtv\.com\/mobile\/recommend\/v\d\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/mgtv/zirawell_cntv.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% *.mgtv.com

