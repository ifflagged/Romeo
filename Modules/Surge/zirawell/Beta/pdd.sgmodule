[Rule]
DOMAIN,titan.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,apm.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,ta-a.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,ta.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th-a.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th-b.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,ta.yangkeduo.com,REJECT,extended-matching,pre-matching
DOMAIN,th.yangkeduo.com,REJECT,extended-matching,pre-matching
DOMAIN,meta.yangkeduo.com,REJECT,extended-matching,pre-matching
DOMAIN,meta.pinduoduo.com,REJECT,extended-matching,pre-matching
DOMAIN,m.pinduoduo.net,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject
^https?:\/\/mobile\.yangkeduo\.com\/layer\/app_upgrade_popup - reject
^https?:\/\/api\.pinduoduo\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\/ - reject
^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up - reject

[Map Local]
^https?:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/app_popup data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/flow\/hungary\/window\/global data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/search_hotquery data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/engels\/reviews\/require\/append data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/my_order_group data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/likes data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/personal data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/caterham\/v\d\/query\/new_chat_group data-type=json data="{}" status-code=200

^https?:\/\/api\.yangkeduo\.com\/api\/ant\/entry\/navigate data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/barrow\/query data-type=json data="{}" status-code=200

^https?:\/\/api\.pinduoduo\.com\/api\/pdd_live_moore_main_lego data-type=json data="{}" status-code=200

[Script]
pdd = type=http-response, pattern=^https?:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/pdd/zirawell_pdd.js, requires-body=true, max-size=0

pdd = type=http-response, pattern=^https?:\/\/api\.pinduoduo\.com\/api\/alexa\/\w+\/hub, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/pdd/zirawell_pdd.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, mobile.yangkeduo.com

