[Script]
哔哩哔哩漫画-Cookie = type=http-request, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibiliManga-CheckIn/zirawell_bilibiliManga.js

哔哩哔哩漫画-签到 = type=cron, cronexp=0 9 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/bilibiliManga-CheckIn/zirawell_bilibiliManga.js, wake-system=1

[MITM]
hostname = %APPEND% app.bilibili.com

