#!name=tflj
#!desc=tflj
#!icon=icon not found
#!category=Jacob

[Script]
tflj = type=http-response, pattern=^https?:\/\/tf\d+\.istrongcloud\.com\/member\/v[0-9.]+\/home, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tflj/zirawell_tflj.js, requires-body=true, max-size=0

tflj = type=http-response, pattern=^https?:\/\/tf\d+\.istrongcloud\.com\/data\/commonConfig\/typhoon-mp-config\/webModuleConfig, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/tflj/zirawell_tflj.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% tf*.istrongcloud.com

