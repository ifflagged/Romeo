#!name=vvebo
#!desc=vvebo
#!icon=icon not found
#!category=zirawell

[Script]
VVebo_Repair = type=http-request, pattern=^https?:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js, timeout=60

VVebo_Repair = type=http-request, pattern=^https?:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js, timeout=60

VVebo_Repair = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js, requires-body=true, max-size=-1, timeout=60

VVebo_Repair = type=http-response, pattern=^https?:\/\/api\.weibo\.cn\/2\/cardlist\?, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/vvebo/zirawell_VVebo_Repair.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.weibo.cn

