#!name=华住会 - HUAZHU
#!desc=华住会
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!category=zirawell
#!openUrl=https://apps.apple.com/app/id556808349
#!bundleId=com.htinns.iphone
#!category=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-07-28

[Rule]
DOMAIN,apm-api.huazhu.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?:\/\/appapi\.huazhu\.com:\d+\/client\/app\/getAppStartPage\/ - reject
^https?:\/\/hweb-manager\.huazhu\.com\/start\/getAppStartPage - reject

[Map Local]
^https?:\/\/hweb-hotel\.huazhu\.com\/home\/queryRecommond data-type=json data="{}" status-code=200

^https?:\/\/hweb-hotel\.huazhu\.com\/{1,2}home\/(?>queryNewNotice|querySelectHotel|queryHotelBrand|queryMall|huazhuWorld) data-type=text data="" status-code=200

^https?:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert data-type=json data="{}" status-code=200

^https?:\/\/hweb-manager\.huazhu\.com\/bundle\/upgrade\/check data-type=json data="{}" status-code=200

^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\/ data-type=json data="{}" status-code=200

[MITM]
hostname = %APPEND% appapi.huazhu.com, hweb-hotel.huazhu.com, hweb-manager.huazhu.com

