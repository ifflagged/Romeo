#!name=ctrip
#!desc=ctrip
#!icon=icon not found
#!category=zirawell

[Script]
携程旅行-Cookie = type=http-response, pattern=^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js

携程旅行-签到 = type=cron, cronexp=5 0 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js, wake-system=1

ctrip = type=http-response, pattern=^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?), script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/ctrip/zirawell_ctrip.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% m.ctrip.com

