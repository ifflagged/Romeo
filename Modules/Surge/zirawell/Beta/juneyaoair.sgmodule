#!name=吉祥航空 - JUNEYAOAIR
#!desc=吉祥航空-特价机票预订查询
#!author=zirawell[https://github.com/zirawell]
#!icon=icon not found
#!category=zirawell
#!openUrl=https://apps.apple.com/app/id639531062
#!bundleId=com.juneyaoair.distribution
#!category=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-10-21

[URL Rewrite]
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/(?>queryPopUpWinPic|getLoadPic|getRecommendProduct|creditCardAd) - reject

[Body Rewrite]
http-response ^https?:\/\/shopping\.juneyaoair\.com\/mobile\/shop\/mobile\/app "index_pop_wap_enable":true "index_pop_wap_enable":false

[Map Local]
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/version data-type=text data="" status-code=200

[Script]
juneyaoair = type=http-response, pattern=^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/getPictureList, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/zirawell/juneyaoair/zirawell_juneyaoair.js, requires-body=true, max-size=0

[MITM]
hostname = %APPEND% hoapp.juneyaoair.com, m.juneyaoair.com, shopping.juneyaoair.com

