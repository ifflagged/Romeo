#!name= iRingo: 📺 TV app
#!desc=全面自定义「TV app」功能
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.TV
#!homepage=https://NSRingo.github.io/guide/apple-tv
#!date=2025-04-17 03:19:05
#!version=3.4.4

[Rule]
DOMAIN,known-issues.apple.com,REJECT

[URL Rewrite]
^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com header
^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com header

[Script]
📺 TV.uts.request = type=http-request, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_request.bundle.js, requires-body=true

📺 TV.uts.response = type=http-response, pattern=^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(v1|v2|v3)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_response.bundle.js, requires-body=true

📺 TV.umc.request = type=http-request, pattern=^https?:\/\/umc-tempo-api\.apple\.com\/(v1|v2|v3)\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TV/NSRingo_request.bundle.js, requires-body=true

[MITM]
hostname = %APPEND% uts-api.itunes.apple.com, umc-tempo-api.apple.com, play-cdn.itunes.apple.com, play-edge-cdn.itunes.apple.com

