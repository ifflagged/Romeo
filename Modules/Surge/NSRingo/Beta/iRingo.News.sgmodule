#!name= iRingo: 📰 News
#!desc=1.自定义解锁News的地区\n2.Coming Soon…\n注：该模块不包含代理规则组，代理规则组需要匹配代理策略组为🇺🇸🇬🇧🇨🇦🇦🇺线路，使用过程中gateway.icloud.com应该走与News相同的代理线路。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.News
#!homepage=https://NSRingo.github.io/guide/apple-news
#!date=2024-12-10 04:32:39
#!version=3.2.1

[Script]
# 📰 News Configs
request.bundle = type=http-request, pattern=^https?:\/\/news(-todayconfig)?-edge\.apple\.com\/v1\/configs, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.News/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 📰 News Event
request.bundle = type=http-request, pattern=^https?:\/\/news(-sports)?-events\.apple\.com\/analyticseventsv2\/async, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.News/NSRingo_request.bundle.js, requires-body=true, max-size=-1, timeout=60

# 📰 News Search
request.bundle = type=http-request, pattern=^https?:\/\/news-client-search\.apple\.com\/v1\/search, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.News/NSRingo_request.bundle.js, timeout=60

[MITM]
hostname = %APPEND% news-edge.apple.com, news-todayconfig-edge.apple.com, news-events.apple.com, news-sports-events.apple.com, news-client.apple.com, news-client-search.apple.com

