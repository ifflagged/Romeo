#!name= iRingo: 🔍 Search
#!desc=iOS 17.6⬇️\n全面自定义「Siri 建议」功能。\n⚠️ 不含自定义「询问 Siri」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.Spotlight
#!homepage=https://NSRingo.github.io/guide/Siri/spotlight
#!date=2024-12-24 04:25:10
#!version=4.2.7

[Script]
# 🔍 Search Bag (iOS/macOS)
request.bundle = type=http-request, pattern=^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60

response.bundle = type=http-response, pattern=^https?:\/\/api2?\.smoot\.apple\.(com|cn)\/bag, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🔍 Siri Suggestions & Look Up Search (iOS/macOS)
request.bundle = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/search, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60

# 🔍 Search Infomation Card (macOS)
request.bundle = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/card, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60

# 🔍 Search Flight Search (iOS/macOS)
request.bundle = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.com\/flight, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.Search/NSRingo_request.bundle.js, timeout=60

[MITM]
hostname = %APPEND% api*.smoot.apple.com, api.smoot.apple.cn

