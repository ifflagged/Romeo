#!name= iRingo: ✈ TestFlight
#!desc=1.自定义TestFlight登录商店地区\n2.多账户保存及切换(需配置BoxJs使用)\n3.让通用应用在任意苹果处理器设备上可安装
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=icon not found
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.TestFlight
#!homepage=https://NSRingo.github.io/guide/test-flight
#!date=2024-12-24 08:53:51
#!version=3.4.0

[General]
skip-proxy = %APPEND% iosapps.itunes.apple.com

[Script]
✈ TestFlight.request = type=http-request, pattern=^https?:\/\/testflight\.apple\.com\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_request.bundle.js, requires-body=true

✈ TestFlight.response = type=http-response, pattern=^https?:\/\/testflight\.apple\.com\/, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/NSRingo/iRingo.TestFlight/NSRingo_response.bundle.js, requires-body=true

[MITM]
hostname = %APPEND% testflight.apple.com

