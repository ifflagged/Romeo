[Script]
hongze = type=http-request, pattern=^https:\/\/app\.hongze\.net\/mag\/user\/v1\/User\/getUserInfo, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/hongze/ZenmoFeiShi_hongze.js, timeout=60

洪泽论坛签到 = type=cron, cronexp=8 1 * * *, script-path=https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ZenmoFeiShi/hongze/ZenmoFeiShi_hongze.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% app.hongze.net

