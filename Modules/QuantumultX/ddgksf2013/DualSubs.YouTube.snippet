#!version = 1.6.0

#[rewrite_local]
^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$ url script-echo-response https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/NSNanoCat_api.js
^https:\/\/dualsubs\.github\.io\/api\/YouTube(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: 1.6.0 echo-response https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_DualSubs.YouTube.PreferencePanes.json
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$ url reject-dict

#[Script]
# YouTube
# 🍿️ DualSubs.YouTube.Player.request.json
^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ url script-request-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js
# 🍿️ DualSubs.YouTube.Player.response.json
^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js
# 🍿️ DualSubs.YouTube.Player.request.proto
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ url script-request-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js
# 🍿️ DualSubs.YouTube.Player.response.proto
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js
# 🍿️ DualSubs.YouTube.GetWatch.response.proto
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$ url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_response.bundle.js
# 🍿️ DualSubs.YouTube.TimedText.request
^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext url script-request-header https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js
# 🍿️ DualSubs.YouTube.Composite.TimedText.response
^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External) url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Composite.Subtitles.response.bundle.js
# 🍿️ DualSubs.YouTube.Translate.TimedText.response
^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js

# YouTube Music
# 🍿️ DualSubs.YouTubeMusic.Browse.request.json
^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ url script-request-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js
# 🍿️ DualSubs.YouTube.Browse.request.proto
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ url script-request-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_request.bundle.js
# 🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.json
^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js
# 🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.proto
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(.*)subtype=Translate url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/ddgksf2013/DualSubs.YouTube/DualSubs_Translate.response.bundle.js

