#[rewrite_local]
^https:\/\/dualsubs\.github\.io\/api\/Netflix(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: 0.6.0 echo-response https://github.com/DualSubs/Netflix/releases/download/v0.6.0/DualSubs.Netflix.PreferencePanes.json
# 🍿️ DualSubs.Netflix.Translate.Subtitles.response
^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+ url script-response-body https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js

#[mitm]
hostname = dualsubs.github.io, *.oca.nflxvideo.net
