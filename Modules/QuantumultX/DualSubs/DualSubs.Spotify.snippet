#!name = 🍿️ DualSubs: 🎵 Spotify
#!desc = Spotify 增强及双语歌词
#!openUrl = https://dualsubs.github.io/preferences/
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://DualSubs.github.io/guide/spotify
#!icon = https://github.com/DualSubs/Spotify/raw/main/src/assets/icon_rounded.png
#!category = 🍿️ DualSubs
#!date = 2026-10-16 01:55:01
#!version = 1.10.0

#[rewrite_local]
^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$ url script-echo-response https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/NSNanoCat_api.js
^https:\/\/dualsubs\.github\.io\/api\/Spotify(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: 1.10.0 echo-response https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_DualSubs.Spotify.PreferencePanes.json
# 🍿️ DualSubs.Spotify.Tracks.response
^https?:\/\/api\.spotify\.com\/v1\/tracks\? url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_response.bundle.js

# 🍿️ DualSubs.Spotify.Lyrics.request
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*) url script-request-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_request.bundle.js

# 🍿️ DualSubs.Spotify.Translate.Lyrics.response
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=Translate url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_Translate.response.bundle.js

# 🍿️ DualSubs.Spotify.External.Lyrics.response
^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)subtype=External url script-response-body https://github.com/ifflagged/Romeo/raw/main/Modules/JavaScript/DualSubs/DualSubs.Spotify/DualSubs_External.Lyrics.response.bundle.js

#[mitm]
hostname = dualsubs.github.io, api.spotify.com, spclient.wg.spotify.com, *-spclient.spotify.com
