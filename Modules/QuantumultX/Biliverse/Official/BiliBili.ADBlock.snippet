#!name = 📺 BiliBili: 🛡️ ADBlock
#!desc = 哔哩哔哩：去广告\n自定义去除APP内界面元素
#!openUrl = http://boxjs.com/#/app/BiliBili.ADBlock
#!author = ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!homepage = https://biliverse.github.io/guide/ad-block
#!icon = https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!category = 🪐 Biliverse
#!date = 2026-09-17 11:51:01
#!version = 0.6.27

#[rewrite_local]
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$ url script-echo-response https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/config.bundle.js
# Biliverse 本地设置
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words url reject-dict
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr url reject-dict
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist url reject-dict
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash url reject-dict
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash url reject-dict
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? url reject-dict
# 📺 BiliBili.ADBlock.request.grpc
^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url script-request-header https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js
# 📺 BiliBili.ADBlock.request.json
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\? url script-request-header https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js
^https?:\/\/(cm\.bilibili\.com\/cm\/api\/(conversion\/mobile\/v2|fees\/wise)|adtrack\.qianwen\.com\/v3\/ad\/(show\/)?bilibili|tkio-redirect\.solar-engine\.com\/receive\/turl\/) url script-request-header https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/request.bundle.js
# 📺 BiliBili.ADBlock.response.json
^https?:\/\/api\.live\.bilibili\.com\/xlive\/(app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/(index\/feed|room\/recList)) url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/api\.bili(bili\.com|api\.net)\/x\/(web-interface\/wbi\/index\/top\/feed\/rcmd|vip\/ads\/materials)\? url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?) url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/(relate\/)?story)?|search\/square) url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
# 📺 BiliBili.ADBlock.response.grpc
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view\.v1\.View\/(View|TFInfo|RelatesFeed|PlayerRelates|ViewProgress)|viewunite\.v1\.View\/(View|RelatesFeed|ViewProgress|PlayPause|ViewEndPage)|playerunite\.v1\.Player\/PlayViewUnite)$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)(Personal)?$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile) url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/(MainList|DetailList|ReplyInfo)$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v2\.Reply\/SubjectDescription$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js
^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$ url script-response-body https://github.com/Biliverse/ADBlock/releases/download/v0.6.27/response.bundle.js

#[mitm]
hostname = biliverse.github.io, manga.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, app.biliapi.com, api.bilibili.com, api.biliapi.net, grpc.biliapi.net, cm.bilibili.com, adtrack.qianwen.com, tkio-redirect.solar-engine.com
