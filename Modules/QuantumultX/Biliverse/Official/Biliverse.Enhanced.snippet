#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://biliverse.github.io/guide/enhanced
#!icon = https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!category = 🪐 Biliverse
#!date = 2026-10-12 08:54:50
#!version = 0.6.1

#[rewrite_local]
^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$ url echo-response text/html echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/home.html
^https:\/\/app\.bilibili\.com\/settings\/theme\.css(?:\?[^#]*)?$ url echo-response text/css echo-response https://biliverse.github.io/settings/theme.css
^https:\/\/app\.bilibili\.com\/settings\/home\.json(?:\?[^#]*)?$ url echo-response application/json echo-response https://biliverse.github.io/settings/home.json
^https:\/\/app\.bilibili\.com\/settings\/bridge\.mjs(?:\?[^#]*)?$ url echo-response text/javascript echo-response https://biliverse.github.io/settings/bridge.mjs
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$ url script-echo-response https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js
# Biliverse 本地设置
^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: 0.6.1 echo-response https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/Biliverse.Enhanced.PreferencePanes.json
# 📺 Biliverse.Enhanced.x.resource.show.tab.v2
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/response.bundle.js
# 📺 Biliverse.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$ url script-request-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/request.bundle.js
# 📺 Biliverse.Enhanced.show.v1.Mixture.RegionList.response.grpc
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$ url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/response.bundle.js
# 📺 Biliverse.Enhanced.x.v2.account.mine
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/response.bundle.js
# 📺 Biliverse.Enhanced.x.v2.region.index
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/response.bundle.js
# 📺 Biliverse.Enhanced.x.v2.channel.region.list
^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\? url script-response-body https://github.com/Biliverse/Enhanced/releases/download/v0.6.1/response.bundle.js

#[mitm]
hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net
